        READ_FILE["read_arch_file()"]
    end

    subgraph FileSystem[".vista/features/"]
        ARCH_JSON["_arch.json"]
        MMD_FILES[".mmd diagram files"]
        DOMAIN_MD["domain-requirements.md"]
    end

