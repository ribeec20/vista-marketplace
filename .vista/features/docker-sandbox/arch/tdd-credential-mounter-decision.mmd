flowchart TD
    %% TDD: Credential path resolution decision tree
    %% Each leaf = concrete host path + container target path
    %% Tests: one per leaf, plus boundary tests for OS detection

    OS_DETECT{"Detect host_os<br/>(platform.system())"}

    OS_DETECT -->|"Windows"| WIN["Windows Paths"]
    OS_DETECT -->|"Darwin"| MAC["macOS Paths"]
    OS_DETECT -->|"Linux"| LIN["Linux Paths"]

    %% ==================== WINDOWS ====================
    WIN --> WIN_CLAUDE{"claude_auth"}
    WIN --> WIN_SSH{"git_ssh"}
    WIN --> WIN_GITCFG{"gitconfig"}
    WIN --> WIN_GH{"github_cli"}
    WIN --> WIN_OC{"opencode"}

    WIN_CLAUDE --> WIN_CLAUDE_PATH["host: %USERPROFILE%\\.claude<br/>→ C:\\Users\\X\\.claude<br/>target: /home/user/.claude<br/>mode: ro"]
    WIN_SSH --> WIN_SSH_PATH["host: %USERPROFILE%\\.ssh<br/>→ C:\\Users\\X\\.ssh<br/>target: /home/user/.ssh<br/>mode: ro"]
    WIN_GITCFG --> WIN_GITCFG_PATH["host: %USERPROFILE%\\.gitconfig<br/>→ C:\\Users\\X\\.gitconfig<br/>target: /home/user/.gitconfig<br/>mode: ro<br/>(file, not directory)"]
    WIN_GH --> WIN_GH_PATH["host: %APPDATA%\\GitHub CLI<br/>→ C:\\Users\\X\\AppData\\Roaming\\GitHub CLI<br/>target: /home/user/.config/gh<br/>mode: ro"]
    WIN_OC --> WIN_OC_PATH["host: %APPDATA%\\opencode<br/>→ C:\\Users\\X\\AppData\\Roaming\\opencode<br/>target: /home/user/.config/opencode<br/>mode: ro"]

    %% ==================== macOS ====================
    MAC --> MAC_CLAUDE{"claude_auth"}
    MAC --> MAC_SSH{"git_ssh"}
    MAC --> MAC_GITCFG{"gitconfig"}
    MAC --> MAC_GH{"github_cli"}
    MAC --> MAC_OC{"opencode"}

    MAC_CLAUDE --> MAC_CLAUDE_PATH["host: ~/.claude<br/>→ /Users/X/.claude<br/>target: /home/user/.claude<br/>mode: ro"]
    MAC_SSH --> MAC_SSH_PATH["host: ~/.ssh<br/>→ /Users/X/.ssh<br/>target: /home/user/.ssh<br/>mode: ro"]
    MAC_GITCFG --> MAC_GITCFG_PATH["host: ~/.gitconfig<br/>→ /Users/X/.gitconfig<br/>target: /home/user/.gitconfig<br/>mode: ro<br/>(file, not directory)"]
    MAC_GH --> MAC_GH_PATH["host: ~/.config/gh<br/>→ /Users/X/.config/gh<br/>target: /home/user/.config/gh<br/>mode: ro"]
    MAC_OC --> MAC_OC_PATH["host: ~/.config/opencode<br/>→ /Users/X/.config/opencode<br/>target: /home/user/.config/opencode<br/>mode: ro"]

    %% ==================== LINUX ====================
    LIN --> LIN_CLAUDE{"claude_auth"}
    LIN --> LIN_SSH{"git_ssh"}
    LIN --> LIN_GITCFG{"gitconfig"}
    LIN --> LIN_GH{"github_cli"}
    LIN --> LIN_OC{"opencode"}

    LIN_CLAUDE --> LIN_CLAUDE_PATH["host: ~/.claude<br/>→ /home/X/.claude<br/>target: /home/user/.claude<br/>mode: ro"]
    LIN_SSH --> LIN_SSH_PATH["host: ~/.ssh<br/>→ /home/X/.ssh<br/>target: /home/user/.ssh<br/>mode: ro"]
    LIN_GITCFG --> LIN_GITCFG_PATH["host: ~/.gitconfig<br/>→ /home/X/.gitconfig<br/>target: /home/user/.gitconfig<br/>mode: ro<br/>(file, not directory)"]
    LIN_GH --> LIN_GH_PATH["host: ~/.config/gh<br/>→ /home/X/.config/gh<br/>target: /home/user/.config/gh<br/>mode: ro"]
    LIN_OC --> LIN_OC_PATH["host: ~/.config/opencode<br/>→ /home/X/.config/opencode<br/>target: /home/user/.config/opencode<br/>mode: ro"]

    %% Styling
    style OS_DETECT fill:#26c,color:#fff
    style WIN fill:#f90,color:#fff
    style MAC fill:#f90,color:#fff
    style LIN fill:#f90,color:#fff
    style WIN_CLAUDE_PATH fill:#4a4,color:#fff
    style WIN_SSH_PATH fill:#4a4,color:#fff
    style WIN_GITCFG_PATH fill:#4a4,color:#fff
    style WIN_GH_PATH fill:#4a4,color:#fff
    style WIN_OC_PATH fill:#4a4,color:#fff
    style MAC_CLAUDE_PATH fill:#4a4,color:#fff
    style MAC_SSH_PATH fill:#4a4,color:#fff
    style MAC_GITCFG_PATH fill:#4a4,color:#fff
    style MAC_GH_PATH fill:#4a4,color:#fff
    style MAC_OC_PATH fill:#4a4,color:#fff
    style LIN_CLAUDE_PATH fill:#4a4,color:#fff
    style LIN_SSH_PATH fill:#4a4,color:#fff
    style LIN_GITCFG_PATH fill:#4a4,color:#fff
