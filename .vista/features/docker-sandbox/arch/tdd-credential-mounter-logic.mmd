flowchart TD
    %% TDD: CredentialMounter.get_mounts() logic flow
    %% Input: host_os, credential_config
    %% Output: list[MountSpec] (only existing, enabled credentials)

    %% Inputs
    INPUT_OS["Input: host_os: str<br/>'windows' | 'darwin' | 'linux'"]
    INPUT_CFG["Input: credential_config: dict<br/>{name: {enabled, host_path_override}}"]
    INPUT_OS --> ITERATE
    INPUT_CFG --> ITERATE

    %% Credential registry (built-in defaults)
    REGISTRY["CREDENTIAL_REGISTRY = [<br/>  claude_auth, git_ssh,<br/>  gitconfig, github_cli,<br/>  opencode<br/>]"]
    REGISTRY --> ITERATE

    %% Main loop
    ITERATE["For each credential in REGISTRY"]
    ITERATE --> CHECK_ENABLED{credential.name<br/>in config AND<br/>enabled=true?}

    CHECK_ENABLED -->|No, disabled| SKIP_DISABLED["Skip: credential disabled<br/>log: 'Skipping {name}: disabled'"]
    CHECK_ENABLED -->|Yes, enabled| CHECK_OVERRIDE

    %% Check for host_path override
    CHECK_OVERRIDE{host_path_override<br/>set in config?}
    CHECK_OVERRIDE -->|Yes| USE_OVERRIDE["host_path = config.host_path_override"]
    CHECK_OVERRIDE -->|No| RESOLVE_DEFAULT["host_path = resolve_default_path(<br/>  credential.name, host_os)"]

    USE_OVERRIDE --> EXPAND_PATH
    RESOLVE_DEFAULT --> EXPAND_PATH

    %% Expand and validate path
    EXPAND_PATH["Expand ~ and env vars:<br/>os.path.expanduser()<br/>os.path.expandvars()"]
    EXPAND_PATH --> CHECK_EXISTS{host_path<br/>exists on disk?}

    CHECK_EXISTS -->|No| SKIP_MISSING["Skip gracefully:<br/>log warning: '{name} path not found:<br/>{host_path} — skipping mount'"]
    CHECK_EXISTS -->|Yes| CHECK_TYPE

    %% File vs directory mount
    CHECK_TYPE{Is path a<br/>directory?}
    CHECK_TYPE -->|Yes, directory| GEN_DIR_MOUNT["Generate MountSpec:<br/>  source=host_path<br/>  target=credential.container_path<br/>  type='bind'<br/>  mode='ro'"]
    CHECK_TYPE -->|No, file| GEN_FILE_MOUNT["Generate MountSpec:<br/>  source=host_path<br/>  target=credential.container_path<br/>  type='bind'<br/>  mode='ro'<br/>Note: .gitconfig is a file, not dir"]

    GEN_DIR_MOUNT --> APPEND
    GEN_FILE_MOUNT --> APPEND
    SKIP_DISABLED --> NEXT
    SKIP_MISSING --> NEXT

    APPEND["Append mount to results list"]
    APPEND --> NEXT

    NEXT{More credentials<br/>in registry?}
    NEXT -->|Yes| ITERATE
    NEXT -->|No| OUTPUT

    %% Output
    OUTPUT["Return: list[MountSpec]<br/>Only valid, enabled, existing mounts<br/>May be empty list (all skipped)"]

    %% Styling
    style INPUT_OS fill:#26c,color:#fff
    style INPUT_CFG fill:#26c,color:#fff
    style REGISTRY fill:#26c,color:#fff
    style OUTPUT fill:#4a4,color:#fff
    style SKIP_DISABLED fill:#f90,color:#fff
    style SKIP_MISSING fill:#f90,color:#fff
