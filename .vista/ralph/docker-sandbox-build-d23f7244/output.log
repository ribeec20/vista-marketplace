>→ /home/X/.gitconfig<br/>target: /home/user/.gitconfig<br/>mode: ro<br/>(file, not directory)\"]\n    LIN_GH --> LIN_GH_PATH[\"host: ~/.config/gh<br/>→ /home/X/.config/gh<br/>target: /home/user/.config/gh<br/>mode: ro\"]\n    LIN_OC --> LIN_OC_PATH[\"host: ~/.config/opencode<br/>→ /home/X/.config/opencode<br/>target: /home/user/.config/opencode<br/>mode: ro\"]\n\n    %% Styling\n    style OS_DETECT fill:#26c,color:#fff\n    style WIN fill:#f90,color:#fff\n    style MAC fill:#f90,color:#fff\n    style LIN fill:#f90,color:#fff\n    style WIN_CLAUDE_PATH fill:#4a4,color:#fff\n    style WIN_SSH_PATH fill:#4a4,color:#fff\n    style WIN_GITCFG_PATH fill:#4a4,color:#fff\n    style WIN_GH_PATH fill:#4a4,color:#fff\n    style WIN_OC_PATH fill:#4a4,color:#fff\n    style MAC_CLAUDE_PATH fill:#4a4,color:#fff\n    style MAC_SSH_PATH fill:#4a4,color:#fff\n    style MAC_GITCFG_PATH fill:#4a4,color:#fff\n    style MAC_GH_PATH fill:#4a4,color:#fff\n    style MAC_OC_PATH fill:#4a4,color:#fff\n    style LIN_CLAUDE_PATH fill:#4a4,color:#fff\n    style LIN_SSH_PATH fill:#4a4,color:#fff\n    style LIN_GITCFG_PATH fill:#4a4,color:#fff\n    style LIN_GH_PATH fill:#4a4,color:#fff\n    style LIN_OC_PATH fill:#4a4,color:#fff\n","numLines":71,"startLine":1,"totalLines":71}}}
