{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DyH8FQBoQvsYamjENEaRzK","type":"tool_result","content":"     1→\"\"\"Job lifecycle management for ralph MCP tools.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→import json\n     6→import os\n     7→import platform\n     8→import signal\n     9→import subprocess\n    10→from datetime import datetime, timezone\n    11→from pathlib import Path\n    12→from typing import Optional\n    13→from uuid import uuid4\n    14→\n    15→from portable.ralph import LOOP_SCRIPT_TEMPLATE\n    16→from server import config\n    17→from server.services.output_parser import parse_plaintext_activity, parse_stream_json_activity\n    18→from server.services.provider_service import Provider\n    19→\n    20→\n    21→class RalphService:\n    22→    \"\"\"Manage ralph loop jobs persisted to disk.\"\"\"\n    23→\n    24→    def __init__(self) -> None:\n    25→        self._ralph_dir_name = \"ralph\"\n    26→\n    27→    def create_job(\n    28→        self,\n    29→        project_root: Path,\n    30→        slug: str,\n    31→        mode: str,\n    32→        task_description: str,\n    33→        provider: Provider,\n    34→        model: str,\n    35→        iterations: int,\n    36→    ) -> dict:\n    37→        job_id = str(uuid4())\n    38→        job_dir = self._job_dir(project_root, slug, job_id)\n    39→        job_dir.mkdir(parents=True, exist_ok=True)\n    40→\n    41→        # Ensure each run starts from a clean runtime state. Reusing the same slug\n    42→        # should not inherit old progress/output markers from prior runs.\n    43→        self._clear_runtime_artifacts(job_dir)\n    44→\n    45→        task_file = job_dir / \"task.md\"\n    46→        task_file.write_text(task_description, encoding=\"utf-8\")\n    47→\n    48→        prompt_content = self._get_prompt_content(\n    49→            mode=mode,\n    50→            slug=slug,\n    51→            job_dir=job_dir,\n    52→            project_root=project_root,\n    53→        )\n    54→        if prompt_content is None:\n    55→            raise ValueError(f\"No prompt template found for mode: {mode}\")\n    56→\n    57→        prompt_file = job_dir / f\"PROMPT_{mode}.md\"\n    58→        prompt_file.write_text(prompt_content, encoding=\"utf-8\")\n    59→\n    60→        loop_script = job_dir / (\n    61→            \"loop.ps1\" if platform.system() == \"Windows\" else \"loop.sh\"\n    62→        )\n    63→        script_content = LOOP_SCRIPT_TEMPLATE.format(\n    64→            mode=mode,\n    65→            max_iterations=iterations,\n    66→            model=model,\n    67→            feature_name=slug,\n    68→            feature_dir_abs=str(job_dir.resolve()),\n    69→            project_root_abs=str(project_root.resolve()),\n    70→            provider_name=provider.display_name,\n    71→            invocation_block=provider.get_invocation(\n    72→                \"ps1\" if platform.system() == \"Windows\" else \"sh\"\n    73→            ),\n    74→        )\n    75→        loop_script.write_text(script_content, encoding=\"utf-8\")\n    76→        if platform.system() != \"Windows\":\n    77→            os.chmod(loop_script, 0o755)\n    78→\n    79→        output_log = job_dir / \"output.log\"\n    80→        output_handle = output_log.open(\"w\", encoding=\"utf-8\")\n    81→\n    82→        cmd = (\n    83→            [\"powershell\", \"-ExecutionPolicy\", \"Bypass\", \"-File\", str(loop_script)]\n    84→            if platform.system() == \"Windows\"\n    85→            else [\"bash\", str(loop_script)]\n    86→        )\n    87→        popen_kwargs = {\n    88→            \"stdin\": subprocess.DEVNULL,\n    89→            \"stdout\": output_handle,\n    90→            \"stderr\": subprocess.STDOUT,\n    91→            \"cwd\": str(project_root.resolve()),\n    92→            \"text\": True,\n    93→            \"encoding\": \"utf-8\",\n    94→            \"errors\": \"replace\",\n    95→        }\n    96→        if platform.system() == \"Windows\":\n    97→            popen_kwargs[\"creationflags\"] = (\n    98→                subprocess.CREATE_NO_WINDOW | subprocess.CREATE_NEW_PROCESS_GROUP\n    99→            )\n   100→\n   101→        proc = subprocess.Popen(cmd, **popen_kwargs)  # type: ignore[arg-type]\n   102→        output_handle.close()  # Parent no longer needs this; child inherited it\n   103→\n   104→        now = self._now()\n   105→        job = {\n   106→            \"job_id\": job_id,\n   107→            \"slug\": slug,\n   108→            \"mode\": mode,\n   109→            \"status\": \"running\",\n   110→            \"provider\": provider.name,\n   111→            \"model\": model,\n   112→            \"iterations\": iterations,\n   113→            \"current_iteration\": 0,\n   114→            \"pid\": proc.pid,\n   115→            \"created_at\": now,\n   116→            \"started_at\": now,\n   117→            \"completed_at\": None,\n   118→            \"error\": None,\n   119→        }\n   120→        self._save_job_json(job_dir, job)\n   121→        return job\n   122→\n   123→    def get_job_status(self, project_root: Path, job_id: str) -> Optional[dict]:\n   124→        job_dir = self._find_job_dir_by_id(project_root, job_id)\n   125→        if job_dir is None:\n   126→            return None\n   127→        job = self._load_job_json(job_dir)\n   128→        if job is None:\n   129→            return None\n   130→\n   131→        # Always parse output.log for dashboard display (tool calls, assistant text).\n   132→        # progress.txt is only for inter-loop agent context, not display.\n   133→        progress_tail, iteration = self._read_activity(job_dir, provider=job.get(\"provider\", \"\"))\n   134→        # Also check progress.txt for iteration tracking (may have markers output.log missed)\n   135→        _, progress_iteration = self._read_progress(job_dir)\n   136→        if progress_iteration is not None and (iteration is None or progress_iteration > iteration):\n   137→            iteration = progress_iteration\n   138→        if iteration is not None:\n   139→            job[\"current_iteration\"] = iteration\n   140→        job[\"progress_tail\"] = progress_tail\n   141→\n   142→        if job.get(\"status\") == \"running\":\n   143→            pid = job.get(\"pid\")\n   144→            if isinstance(pid, int) and not self._is_process_running(pid):\n   145→                if self._completed_successfully(job, progress_tail, iteration, job_dir):\n   146→                    job[\"status\"] = \"completed\"\n   147→                    job[\"error\"] = None\n   148→                else:\n   149→                    normalized = \"\\n\".join(progress_tail).lower()\n   150→                    has_markers = any(m in normalized for m in (\n   151→                        \"loop finished after\", \"all phases complete\",\n   152→                        \"reached max iterations\",\n   153→                    ))\n   154→                    job[\"status\"] = \"failed\"\n   155→                    if has_markers:\n   156→                        job[\"error\"] = \"No model output detected\"\n   157→                    else:\n   158→                        output_tail = self._read_output_tail(job_dir, last=20)\n   159→                        if output_tail:\n   160→                            job[\"error\"] = (\n   161→                                \"Process ended unexpectedly (PID not alive). \"\n   162→                                \"Last output:\\n\" + \"\\n\".join(output_tail)\n   163→                            )\n   164→                        else:\n   165→                            job[\"error\"] = \"Process ended unexpectedly (PID not alive)\"\n   166→                job[\"completed_at\"] = self._now()\n   167→                self._save_job_json(job_dir, job)\n   168→\n   169→        return job\n   170→\n   171→    def _completed_successfully(\n   172→        self,\n   173→        job: dict,\n   174→        progress_tail: list[str],\n   175→        iteration: Optional[int],\n   176→        job_dir: Path,\n   177→    ) -> bool:\n   178→        \"\"\"Infer normal completion from loop markers AND model activity evidence.\"\"\"\n   179→        normalized = \"\\n\".join(progress_tail).lower()\n   180→        completion_markers = (\n   181→            \"loop finished after\",\n   182→            \"all phases complete\",\n   183→            \"reached max iterations\",\n   184→        )\n   185→        if not any(marker in normalized for marker in completion_markers):\n   186→            return False\n   187→        return self._has_model_activity(job, job_dir)\n   188→\n   189→    def _has_model_activity(self, job: dict, job_dir: Path) -> bool:\n   190→        \"\"\"Check whether output.log contains evidence of actual model output.\"\"\"\n   191→        output_file = job_dir / \"output.log\"\n   192→        if not output_file.exists():\n   193→            return False\n   194→        try:\n   195→            text = output_file.read_text(encoding=\"utf-8\", errors=\"replace\")\n   196→        except OSError:\n   197→            return False\n   198→\n   199→        if job.get(\"provider\") == \"claude\":\n   200→            # Stream-json: look for assistant message type\n   201→            return '\"type\":\"assistant\"' in text.replace(\" \", \"\")\n   202→\n   203→        # OpenCode/other: any non-boilerplate line counts as activity\n   204→        boilerplate = (\n   205→            \"iteration\", \"started:\", \"loop finished\", \"reached max iterations\",\n   206→            \"all phases complete\", \"feature:\", \"provider:\", \"mode:\", \"model:\",\n   207→            \"branch:\", \"prompt:\", \"max:\", \"check:\",\n   208→            \"\\u2501\", \"========================\",\n   209→            \"failed to push\", \"git push\", \"creating remote branch\",\n   210→        )\n   211→        for line in text.splitlines():\n   212→            stripped = line.strip()\n   213→            if not stripped:\n   214→                continue\n   215→            if any(marker in stripped.lower() for marker in boilerplate):\n   216→                continue\n   217→            return True  # Any non-boilerplate line = model activity\n   218→        return False\n   219→\n   220→    def stop_job(self, project_root: Path, job_id: str) -> Optional[dict]:\n   221→        job_dir = self._find_job_dir_by_id(project_root, job_id)\n   222→        if job_dir is None:\n   223→            return None\n   224→        job = self._load_job_json(job_dir)\n   225→        if job is None:\n   226→            return None\n   227→\n   228→        pid = job.get(\"pid\")\n   229→        if isinstance(pid, int):\n   230→            is_running = self._is_process_running(pid)\n   231→            if is_running and not self._is_expected_job_process(pid, job_dir):\n   232→                job[\"status\"] = \"failed\"\n   233→                job[\"completed_at\"] = self._now()\n   234→                job[\"error\"] = (\n   235→                    \"Refused to stop process: PID belongs to a different process \"\n   236→                    \"(possible stale PID).\"\n   237→                )\n   238→                self._save_job_json(job_dir, job)\n   239→                return job\n   240→\n   241→            # Persist \"stopped\" BEFORE kill attempt — defensive against kill crashes\n   242→            job[\"status\"] = \"stopped\"\n   243→            job[\"completed_at\"] = self._now()\n   244→            self._save_job_json(job_dir, job)\n   245→\n   246→            if is_running:\n   247→                try:\n   248→                    os.kill(pid, signal.SIGTERM)\n   249→                except (ProcessLookupError, OSError):\n   250→                    pass\n   251→                if platform.system() != \"Windows\" and self._is_process_running(pid):\n   252→                    try:\n   253→                        os.kill(pid, signal.SIGKILL)\n   254→                    except (ProcessLookupError, OSError):\n   255→                        pass\n   256→        else:\n   257→            job[\"status\"] = \"stopped\"\n   258→            job[\"completed_at\"] = self._now()\n   259→            self._save_job_json(job_dir, job)\n   260→\n   261→        return job\n   262→\n   263→    def list_jobs(self, project_root: Path) -> list[dict]:\n   264→        jobs: list[dict] = []\n   265→        ralph_dir = project_root / \".vista\" / self._ralph_dir_name\n   266→        if not ralph_dir.exists():\n   267→            return jobs\n   268→        for slug_dir in ralph_dir.iterdir():\n   269→            if not slug_dir.is_dir():\n   270→                continue\n   271→            job = self._load_job_json(slug_dir)\n   272→            if job:\n   273→                jobs.append(job)\n   274→        jobs.sort(key=lambda j: j.get(\"created_at\", \"\"), reverse=True)\n   275→        return jobs\n   276→\n   277→    def _job_dir(self, project_root: Path, slug: str, job_id: str) -> Path:\n   278→        safe_slug = \"\".join(ch for ch in slug if ch.isalnum() or ch in {\"-\", \"_\"})\n   279→        if not safe_slug:\n   280→            safe_slug = \"job\"\n   281→        return project_root / \".vista\" / self._ralph_dir_name / f\"{safe_slug}-{job_id[:8]}\"\n   282→\n   283→    def _find_job_dir_by_id(self, project_root: Path, job_id: str) -> Optional[Path]:\n   284→        ralph_dir = project_root / \".vista\" / self._ralph_dir_name\n   285→        if not ralph_dir.exists():\n   286→            return None\n   287→        for slug_dir in ralph_dir.iterdir():\n   288→            if not slug_dir.is_dir():\n   289→                continue\n   290→            job = self._load_job_json(slug_dir)\n   291→            if job and job.get(\"job_id\") == job_id:\n   292→                return slug_dir\n   293→        return None\n   294→\n   295→    def _load_job_json(self, job_dir: Path) -> Optional[dict]:\n   296→        job_file = job_dir / \"job.json\"\n   297→        if not job_file.exists():\n   298→            return None\n   299→        try:\n   300→            return json.loads(job_file.read_text(encoding=\"utf-8\"))\n   301→        except (json.JSONDecodeError, OSError):\n   302→            return None\n   303→\n   304→    def _save_job_json(self, job_dir: Path, job: dict) -> None:\n   305→        job_file = job_dir / \"job.json\"\n   306→        job_file.write_text(json.dumps(job, indent=2), encoding=\"utf-8\")\n   307→\n   308→    def _get_prompt_content(\n   309→        self,\n   310→        mode: str,\n   311→        slug: str,\n   312→        job_dir: Path,\n   313→        project_root: Path,\n   314→    ) -> Optional[str]:\n   315→        template_file = config.TEMPLATES_DIR / f\"PROMPT_{mode}_adhoc.md\"\n   316→        if not template_file.exists():\n   317→            return None\n   318→        content = template_file.read_text(encoding=\"utf-8\")\n   319→        content = content.replace(\"{{FEATURE_NAME}}\", slug)\n   320→        content = content.replace(\"{{FEATURE_DIR}}\", str(job_dir).replace(\"\\\\\", \"/\"))\n   321→        content = content.replace(\"{{PROJECT_NAME}}\", project_root.name)\n   322→        return content\n   323→\n   324→    def _read_progress(self, job_dir: Path) -> tuple[list[str], Optional[int]]:\n   325→        progress_file = job_dir / \"progress.txt\"\n   326→        if not progress_file.exists():\n   327→            return [], None\n   328→        lines = progress_file.read_text(encoding=\"utf-8\").splitlines()\n   329→        tail = lines[-5:]\n   330→        iteration = None\n   331→        for line in reversed(lines):\n   332→            if \"ITERATION\" in line:\n   333→                parts = line.strip().split()\n   334→                for part in parts:\n   335→                    if part.isdigit():\n   336→                        iteration = int(part)\n   337→                        break\n   338→                if iteration is not None:\n   339→                    break\n   340→        return tail, iteration\n   341→\n   342→    def _read_activity(self, job_dir: Path, provider: str = \"\") -> tuple[list[str], Optional[int]]:\n   343→        \"\"\"Parse output.log for human-readable activity lines.\n   344→\n   345→        Dispatches to stream-json parser for Claude, plaintext parser for others.\n   346→        \"\"\"\n   347→        output_file = job_dir / \"output.log\"\n   348→        if not output_file.exists():\n   349→            return [], None\n   350→        try:\n   351→            text = output_file.read_text(encoding=\"utf-8\", errors=\"replace\")\n   352→        except OSError:\n   353→            return [], None\n   354→        lines = text.splitlines()\n   355→        # Only parse last 500 lines for efficiency on large logs\n   356→        if provider == \"claude\":\n   357→            activity, iteration = parse_stream_json_activity(lines[-500:])\n   358→        else:\n   359→            activity, iteration = parse_plaintext_activity(lines[-500:])\n   360→        # Return last 50 activity entries as the tail\n   361→        return activity[-50:], iteration\n   362→\n   363→    def _read_output_tail(self, job_dir: Path, last: int = 20) -> list[str]:\n   364→        output_file = job_dir / \"output.log\"\n   365→        if not output_file.exists():\n   366→            return []\n   367→        try:\n   368→            lines = output_file.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines()\n   369→            return lines[-last:]\n   370→        except OSError:\n   371→            return []\n   372→\n   373→    def _clear_runtime_artifacts(self, job_dir: Path) -> None:\n   374→        \"\"\"Delete per-run generated runtime files from previous executions.\"\"\"\n   375→        runtime_files = [\n   376→            job_dir / \"progress.txt\",\n   377→            job_dir / \"output.log\",\n   378→            job_dir / \"loop.ps1\",\n   379→            job_dir / \"loop.sh\",\n   380→        ]\n   381→        for file_path in runtime_files:\n   382→            try:\n   383→                if file_path.exists():\n   384→                    file_path.unlink()\n   385→            except OSError:\n   386→                # Non-fatal: file will be overwritten where possible.\n   387→                pass\n   388→\n   389→    def _is_process_running(self, pid: int) -> bool:\n   390→        if pid <= 0:\n   391→            return False\n   392→        if platform.system() == \"Windows\":\n   393→            try:\n   394→                import ctypes\n   395→\n   396→                # PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_SYNCHRONIZE\n   397→                handle = ctypes.windll.kernel32.OpenProcess(0x1000 | 0x00100000, False, pid)\n   398→                if not handle:\n   399→                    return False\n   400→\n   401→                # Get exit code - STILL_ACTIVE = 259\n   402→                exit_code = ctypes.c_ulong()\n   403→                result = ctypes.windll.kernel32.GetExitCodeProcess(handle, ctypes.byref(exit_code))\n   404→                ctypes.windll.kernel32.CloseHandle(handle)\n   405→\n   406→                if not result:\n   407→                    return False\n   408→\n   409→                # If exit code is STILL_ACTIVE (259), process is still running\n   410→                STILL_ACTIVE = 259\n   411→                return exit_code.value == STILL_ACTIVE\n   412→            except Exception:\n   413→                return False\n   414→        try:\n   415→            os.kill(pid, 0)\n   416→            return True\n   417→        except OSError:\n   418→            return False\n   419→\n   420→    def _is_expected_job_process(self, pid: int, job_dir: Path) -> bool:\n   421→        \"\"\"Best-effort check that PID still belongs to this Ralph job loop process.\"\"\"\n   422→        try:\n   423→            if platform.system() == \"Windows\":\n   424→                cmd = [\n   425→                    \"powershell\",\n   426→                    \"-NoProfile\",\n   427→                    \"-Command\",\n   428→                    (\n   429→                        f'$p = Get-CimInstance Win32_Process -Filter \"ProcessId={pid}\" '\n   430→                        '-ErrorAction SilentlyContinue; if ($p) { $p.CommandLine }'\n   431→                    ),\n   432→                ]\n   433→                proc = subprocess.run(cmd, capture_output=True, text=True, timeout=5)\n   434→                command_line = (proc.stdout or \"\").strip().lower()\n   435→                if not command_line:\n   436→                    return False\n   437→                loop_marker = str((job_dir / \"loop.ps1\").resolve()).lower().replace(\"/\", \"\\\\\")\n   438→                return \"loop.ps1\" in command_line and loop_marker in command_line\n   439→\n   440→            cmdline_path = Path(\"/proc\") / str(pid) / \"cmdline\"\n   441→            if not cmdline_path.exists():\n   442→                return False\n   443→            raw = cmdline_path.read_bytes().replace(b\"\\x00\", b\" \").decode(\"utf-8\", errors=\"ignore\").lower()\n   444→            loop_marker = str((job_dir / \"loop.sh\").resolve()).lower()\n   445→            return \"loop.sh\" in raw and loop_marker in raw\n   446→        except (OSError, subprocess.SubprocessError, ValueError):\n   447→            return False\n   448→\n   449→    def _now(self) -> str:\n   450→        return datetime.now(timezone.utc).isoformat()\n   451→\n   452→\n   453→ralph_service = RalphService()\n   454→"}]},"parent_tool_use_id":null,"session_id":"4b3360bf-9ca7-4816-8cf1-455a270dc126","uuid":"2e05dc3a-d404-4c57-88ea-679356c5d47c","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/services/ralph_service.py","content":"\"\"\"Job lifecycle management for ralph MCP tools.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport platform\nimport signal\nimport subprocess\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional\nfrom uuid import uuid4\n\nfrom portable.ralph import LOOP_SCRIPT_TEMPLATE\nfrom server import config\nfrom server.services.output_parser import parse_plaintext_activity, parse_stream_json_activity\nfrom server.services.provider_service import Provider\n\n\nclass RalphService:\n    \"\"\"Manage ralph loop jobs persisted to disk.\"\"\"\n\n    def __init__(self) -> None:\n        self._ralph_dir_name = \"ralph\"\n\n    def create_job(\n        self,\n        project_root: Path,\n        slug: str,\n        mode: str,\n        task_description: str,\n        provider: Provider,\n        model: str,\n        iterations: int,\n    ) -> dict:\n        job_id = str(uuid4())\n        job_dir = self._job_dir(project_root, slug, job_id)\n        job_dir.mkdir(parents=True, exist_ok=True)\n\n        # Ensure each run starts from a clean runtime state. Reusing the same slug\n        # should not inherit old progress/output markers from prior runs.\n        self._clear_runtime_artifacts(job_dir)\n\n        task_file = job_dir / \"task.md\"\n        task_file.write_text(task_description, encoding=\"utf-8\")\n\n        prompt_content = self._get_prompt_content(\n            mode=mode,\n            slug=slug,\n            job_dir=job_dir,\n            project_root=project_root,\n        )\n        if prompt_content is None:\n            raise ValueError(f\"No prompt template found for mode: {mode}\")\n\n        prompt_file = job_dir / f\"PROMPT_{mode}.md\"\n        prompt_file.write_text(prompt_content, encoding=\"utf-8\")\n\n        loop_script = job_dir / (\n            \"loop.ps1\" if platform.system() == \"Windows\" else \"loop.sh\"\n        )\n        script_content = LOOP_SCRIPT_TEMPLATE.format(\n            mode=mode,\n            max_iterations=iterations,\n            model=model,\n            feature_name=slug,\n            feature_dir_abs=str(job_dir.resolve()),\n            project_root_abs=str(project_root.resolve()),\n            provider_name=provider.display_name,\n            invocation_block=provider.get_invocation(\n                \"ps1\" if platform.system() == \"Windows\" else \"sh\"\n            ),\n        )\n        loop_script.write_text(script_content, encoding=\"utf-8\")\n        if platform.system() != \"Windows\":\n            os.chmod(loop_script, 0o755)\n\n        output_log = job_dir / \"output.log\"\n        output_handle = output_log.open(\"w\", encoding=\"utf-8\")\n\n        cmd = (\n            [\"powershell\", \"-ExecutionPolicy\", \"Bypass\", \"-File\", str(loop_script)]\n            if platform.system() == \"Windows\"\n            else [\"bash\", str(loop_script)]\n        )\n        popen_kwargs = {\n            \"stdin\": subprocess.DEVNULL,\n            \"stdout\": output_handle,\n            \"stderr\": subprocess.STDOUT,\n            \"cwd\": str(project_root.resolve()),\n            \"text\": True,\n            \"encoding\": \"utf-8\",\n            \"errors\": \"replace\",\n        }\n        if platform.system() == \"Windows\":\n            popen_kwargs[\"creationflags\"] = (\n                subprocess.CREATE_NO_WINDOW | subprocess.CREATE_NEW_PROCESS_GROUP\n            )\n\n        proc = subprocess.Popen(cmd, **popen_kwargs)  # type: ignore[arg-type]\n        output_handle.close()  # Parent no longer needs this; child inherited it\n\n        now = self._now()\n        job = {\n            \"job_id\": job_id,\n            \"slug\": slug,\n            \"mode\": mode,\n            \"status\": \"running\",\n            \"provider\": provider.name,\n            \"model\": model,\n            \"iterations\": iterations,\n            \"current_iteration\": 0,\n            \"pid\": proc.pid,\n            \"created_at\": now,\n            \"started_at\": now,\n            \"completed_at\": None,\n            \"error\": None,\n        }\n        self._save_job_json(job_dir, job)\n        return job\n\n    def get_job_status(self, project_root: Path, job_id: str) -> Optional[dict]:\n        job_dir = self._find_job_dir_by_id(project_root, job_id)\n        if job_dir is None:\n            return None\n        job = self._load_job_json(job_dir)\n        if job is None:\n            return None\n\n        # Always parse output.log for dashboard display (tool calls, assistant text).\n        # progress.txt is only for inter-loop agent context, not display.\n        progress_tail, iteration = self._read_activity(job_dir, provider=job.get(\"provider\", \"\"))\n        # Also check progress.txt for iteration tracking (may have markers output.log missed)\n        _, progress_iteration = self._read_progress(job_dir)\n        if progress_iteration is not None and (iteration is None or progress_iteration > iteration):\n            iteration = progress_iteration\n        if iteration is not None:\n            job[\"current_iteration\"] = iteration\n        job[\"progress_tail\"] = progress_tail\n\n        if job.get(\"status\") == \"running\":\n            pid = job.get(\"pid\")\n            if isinstance(pid, int) and not self._is_process_running(pid):\n                if self._completed_successfully(job, progress_tail, iteration, job_dir):\n                    job[\"status\"] = \"completed\"\n                    job[\"error\"] = None\n                else:\n                    normalized = \"\\n\".join(progress_tail).lower()\n                    has_markers = any(m in normalized for m in (\n                        \"loop finished after\", \"all phases complete\",\n                        \"reached max iterations\",\n                    ))\n                    job[\"status\"] = \"failed\"\n                    if has_markers:\n                        job[\"error\"] = \"No model output detected\"\n                    else:\n                        output_tail = self._read_output_tail(job_dir, last=20)\n                        if output_tail:\n                            job[\"error\"] = (\n                                \"Process ended unexpectedly (PID not alive). \"\n                                \"Last output:\\n\" + \"\\n\".join(output_tail)\n                            )\n                        else:\n                            job[\"error\"] = \"Process ended unexpectedly (PID not alive)\"\n                job[\"completed_at\"] = self._now()\n                self._save_job_json(job_dir, job)\n\n        return job\n\n    def _completed_successfully(\n        self,\n        job: dict,\n        progress_tail: list[str],\n        iteration: Optional[int],\n        job_dir: Path,\n    ) -> bool:\n        \"\"\"Infer normal completion from loop markers AND model activity evidence.\"\"\"\n        normalized = \"\\n\".join(progress_tail).lower()\n        completion_markers = (\n            \"loop finished after\",\n            \"all phases complete\",\n            \"reached max iterations\",\n        )\n        if not any(marker in normalized for marker in completion_markers):\n            return False\n        return self._has_model_activity(job, job_dir)\n\n    def _has_model_activity(self, job: dict, job_dir: Path) -> bool:\n        \"\"\"Check whether output.log contains evidence of actual model output.\"\"\"\n        output_file = job_dir / \"output.log\"\n        if not output_file.exists():\n            return False\n        try:\n            text = output_file.read_text(encoding=\"utf-8\", errors=\"replace\")\n        except OSError:\n            return False\n\n        if job.get(\"provider\") == \"claude\":\n            # Stream-json: look for assistant message type\n            return '\"type\":\"assistant\"' in text.replace(\" \", \"\")\n\n        # OpenCode/other: any non-boilerplate line counts as activity\n        boilerplate = (\n            \"iteration\", \"started:\", \"loop finished\", \"reached max iterations\",\n            \"all phases complete\", \"feature:\", \"provider:\", \"mode:\", \"model:\",\n            \"branch:\", \"prompt:\", \"max:\", \"check:\",\n            \"\\u2501\", \"========================\",\n            \"failed to push\", \"git push\", \"creating remote branch\",\n        )\n        for line in text.splitlines():\n            stripped = line.strip()\n            if not stripped:\n                continue\n            if any(marker in stripped.lower() for marker in boilerplate):\n                continue\n            return True  # Any non-boilerplate line = model activity\n        return False\n\n    def stop_job(self, project_root: Path, job_id: str) -> Optional[dict]:\n        job_dir = self._find_job_dir_by_id(project_root, job_id)\n        if job_dir is None:\n            return None\n        job = self._load_job_json(job_dir)\n        if job is None:\n            return None\n\n        pid = job.get(\"pid\")\n        if isinstance(pid, int):\n            is_running = self._is_process_running(pid)\n            if is_running and not self._is_expected_job_process(pid, job_dir):\n                job[\"status\"] = \"failed\"\n                job[\"completed_at\"] = self._now()\n                job[\"error\"] = (\n                    \"Refused to stop process: PID belongs to a different process \"\n                    \"(possible stale PID).\"\n                )\n                self._save_job_json(job_dir, job)\n                return job\n\n            # Persist \"stopped\" BEFORE kill attempt — defensive against kill crashes\n            job[\"status\"] = \"stopped\"\n            job[\"completed_at\"] = self._now()\n            self._save_job_json(job_dir, job)\n\n            if is_running:\n                try:\n                    os.kill(pid, signal.SIGTERM)\n                except (ProcessLookupError, OSError):\n                    pass\n                if platform.system() != \"Windows\" and self._is_process_running(pid):\n                    try:\n                        os.kill(pid, signal.SIGKILL)\n                    except (ProcessLookupError, OSError):\n                        pass\n        else:\n            job[\"status\"] = \"stopped\"\n            job[\"completed_at\"] = self._now()\n            self._save_job_json(job_dir, job)\n\n        return job\n\n    def list_jobs(self, project_root: Path) -> list[dict]:\n        jobs: list[dict] = []\n        ralph_dir = project_root / \".vista\" / self._ralph_dir_name\n        if not ralph_dir.exists():\n            return jobs\n        for slug_dir in ralph_dir.iterdir():\n            if not slug_dir.is_dir():\n                continue\n            job = self._load_job_json(slug_dir)\n            if job:\n                jobs.append(job)\n        jobs.sort(key=lambda j: j.get(\"created_at\", \"\"), reverse=True)\n        return jobs\n\n    def _job_dir(self, project_root: Path, slug: str, job_id: str) -> Path:\n        safe_slug = \"\".join(ch for ch in slug if ch.isalnum() or ch in {\"-\", \"_\"})\n        if not safe_slug:\n            safe_slug = \"job\"\n        return project_root / \".vista\" / self._ralph_dir_name / f\"{safe_slug}-{job_id[:8]}\"\n\n    def _find_job_dir_by_id(self, project_root: Path, job_id: str) -> Optional[Path]:\n        ralph_dir = project_root / \".vista\" / self._ralph_dir_name\n        if not ralph_dir.exists():\n            return None\n        for slug_dir in ralph_dir.iterdir():\n            if not slug_dir.is_dir():\n                continue\n            job = self._load_job_json(slug_dir)\n            if job and job.get(\"job_id\") == job_id:\n                return slug_dir\n        return None\n\n    def _load_job_json(self, job_dir: Path) -> Optional[dict]:\n        job_file = job_dir / \"job.json\"\n        if not job_file.exists():\n            return None\n        try:\n            return json.loads(job_file.read_text(encoding=\"utf-8\"))\n        except (json.JSONDecodeError, OSError):\n            return None\n\n    def _save_job_json(self, job_dir: Path, job: dict) -> None:\n        job_file = job_dir / \"job.json\"\n        job_file.write_text(json.dumps(job, indent=2), encoding=\"utf-8\")\n\n    def _get_prompt_content(\n        self,\n        mode: str,\n        slug: str,\n        job_dir: Path,\n        project_root: Path,\n    ) -> Optional[str]:\n        template_file = config.TEMPLATES_DIR / f\"PROMPT_{mode}_adhoc.md\"\n        if not template_file.exists():\n            return None\n        content = template_file.read_text(encoding=\"utf-8\")\n        content = content.replace(\"{{FEATURE_NAME}}\", slug)\n        content = content.replace(\"{{FEATURE_DIR}}\", str(job_dir).replace(\"\\\\\", \"/\"))\n        content = content.replace(\"{{PROJECT_NAME}}\", project_root.name)\n        return content\n\n    def _read_progress(self, job_dir: Path) -> tuple[list[str], Optional[int]]:\n        progress_file = job_dir / \"progress.txt\"\n        if not progress_file.exists():\n            return [], None\n        lines = progress_file.read_text(encoding=\"utf-8\").splitlines()\n        tail = lines[-5:]\n        iteration = None\n        for line in reversed(lines):\n            if \"ITERATION\" in line:\n                parts = line.strip().split()\n                for part in parts:\n                    if part.isdigit():\n                        iteration = int(part)\n                        break\n                if iteration is not None:\n                    break\n        return tail, iteration\n\n    def _read_activity(self, job_dir: Path, provider: str = \"\") -> tuple[list[str], Optional[int]]:\n        \"\"\"Parse output.log for human-readable activity lines.\n\n        Dispatches to stream-json parser for Claude, plaintext parser for others.\n        \"\"\"\n        output_file = job_dir / \"output.log\"\n        if not output_file.exists():\n            return [], None\n        try:\n            text = output_file.read_text(encoding=\"utf-8\", errors=\"replace\")\n        except OSError:\n            return [], None\n        lines = text.splitlines()\n        # Only parse last 500 lines for efficiency on large logs\n        if provider == \"claude\":\n            activity, iteration = parse_stream_json_activity(lines[-500:])\n        else:\n            activity, iteration = parse_plaintext_activity(lines[-500:])\n        # Return last 50 activity entries as the tail\n        return activity[-50:], iteration\n\n    def _read_output_tail(self, job_dir: Path, last: int = 20) -> list[str]:\n        output_file = job_dir / \"output.log\"\n        if not output_file.exists():\n            return []\n        try:\n            lines = output_file.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines()\n            return lines[-last:]\n        except OSError:\n            return []\n\n    def _clear_runtime_artifacts(self, job_dir: Path) -> None:\n        \"\"\"Delete per-run generated runtime files from previous executions.\"\"\"\n        runtime_files = [\n            job_dir / \"progress.txt\",\n            job_dir / \"output.log\",\n            job_dir / \"loop.ps1\",\n            job_dir / \"loop.sh\",\n        ]\n        for file_path in runtime_files:\n            try:\n                if file_path.exists():\n                    file_path.unlink()\n            except OSError:\n                # Non-fatal: file will be overwritten where possible.\n                pass\n\n    def _is_process_running(self, pid: int) -> bool:\n        if pid <= 0:\n            return False\n        if platform.system() == \"Windows\":\n            try:\n                import ctypes\n\n                # PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_SYNCHRONIZE\n                handle = ctypes.windll.kernel32.OpenProcess(0x1000 | 0x00100000, False, pid)\n                if not handle:\n                    return False\n\n                # Get exit code - STILL_ACTIVE = 259\n                exit_code = ctypes.c_ulong()\n                result = ctypes.windll.kernel32.GetExitCodeProcess(handle, ctypes.byref(exit_code))\n                ctypes.windll.kernel32.CloseHandle(handle)\n\n                if not result:\n                    return False\n\n                # If exit code is STILL_ACTIVE (259), process is still running\n                STILL_ACTIVE = 259\n                return exit_code.value == STILL_ACTIVE\n            except Exception:\n                return False\n        try:\n            os.kill(pid, 0)\n            return True\n        except OSError:\n            return False\n\n    def _is_expected_job_process(self, pid: int, job_dir: Path) -> bool:\n        \"\"\"Best-effort check that PID still belongs to this Ralph job loop process.\"\"\"\n        try:\n            if platform.system() == \"Windows\":\n                cmd = [\n                    \"powershell\",\n                    \"-NoProfile\",\n                    \"-Command\",\n                    (\n                        f'$p = Get-CimInstance Win32_Process -Filter \"ProcessId={pid}\" '\n                        '-ErrorAction SilentlyContinue; if ($p) { $p.CommandLine }'\n                    ),\n                ]\n                proc = subprocess.run(cmd, capture_output=True, text=True, timeout=5)\n                command_line = (proc.stdout or \"\").strip().lower()\n                if not command_line:\n                    return False\n                loop_marker = str((job_dir / \"loop.ps1\").resolve()).lower().replace(\"/\", \"\\\\\")\n                return \"loop.ps1\" in command_line and loop_marker in command_line\n\n            cmdline_path = Path(\"/proc\") / str(pid) / \"cmdline\"\n            if not cmdline_path.exists():\n                return False\n            raw = cmdline_path.read_bytes().replace(b\"\\x00\", b\" \").decode(\"utf-8\", errors=\"ignore\").lower()\n            loop_marker = str((job_dir / \"loop.sh\").resolve()).lower()\n            return \"loop.sh\" in raw and loop_marker in raw\n        except (OSError, subprocess.SubprocessError, ValueError):\n            return False\n\n    def _now(self) -> str:\n        return datetime.now(timezone.utc).isoformat()\n\n\nralph_service = RalphService()\n","numLines":454,"startLine":1,"totalLines":454}}}
