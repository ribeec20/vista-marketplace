{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YA2dy8EU5c21vUTtJMwi8E","type":"tool_result","content":"     1→#!/usr/bin/env python3\n     2→\"\"\"\n     3→Ralph Loop Runner - Configuration & Control Layer\n     4→\n     5→1. Ask user: feature, mode, iterations, model\n     6→2. Copy prompt template and loop script into feature directory\n     7→3. Run the loop script from feature directory\n     8→4. Clean up copied files when done\n     9→\"\"\"\n    10→\n    11→import os\n    12→import sys\n    13→import subprocess\n    14→from pathlib import Path\n    15→\n    16→# Paths\n    17→SCRIPT_DIR = Path(__file__).parent\n    18→PROJECT_ROOT = SCRIPT_DIR.parent\n    19→FEATURES_DIR = PROJECT_ROOT / \".vista\" / \"features\"\n    20→TEMPLATES_DIR = SCRIPT_DIR / \"templates\"\n    21→\n    22→# Allow importing from server.services when running standalone\n    23→sys.path.insert(0, str(PROJECT_ROOT))\n    24→from server.services.provider_service import (\n    25→    Provider,\n    26→    get_enabled_providers,\n    27→    get_provider_by_name,\n    28→)\n    29→\n    30→# Template loop script content - matches working loop.ps1\n    31→LOOP_SCRIPT_TEMPLATE = '''# Feature Loop - Auto-generated by ralph.py\n    32→# This file will be deleted after the loop completes\n    33→\n    34→param(\n    35→    [ValidateSet(\"plan\", \"build\")]\n    36→    [string]$Mode = \"{mode}\",\n    37→    [int]$MaxIterations = {max_iterations},\n    38→    [string]$Model = \"{model}\"\n    39→)\n    40→\n    41→# Absolute paths baked in by ralph.py - no relative resolution needed\n    42→$FeatureDir = \"{feature_dir_abs}\"\n    43→$ProjectRoot = \"{project_root_abs}\"\n    44→\n    45→# Set prompt file based on mode\n    46→$PromptFile = Join-Path $FeatureDir \"PROMPT_$Mode.md\"\n    47→$ProgressFile = Join-Path $FeatureDir \"progress.txt\"\n    48→$TaskFile = Join-Path $FeatureDir \"task.md\"\n    49→\n    50→# Get current branch (cwd is already $ProjectRoot)\n    51→$CurrentBranch = git branch --show-current\n    52→\n    53→Write-Host \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\" -ForegroundColor Cyan\n    54→Write-Host \"Feature:  {feature_name}\"\n    55→Write-Host \"Provider: {provider_name}\"\n    56→Write-Host \"Mode:     $Mode\"\n    57→Write-Host \"Model:    $Model\"\n    58→Write-Host \"Branch:  $CurrentBranch\"\n    59→Write-Host \"Prompt:  $PromptFile\"\n    60→if ($MaxIterations -gt 0) {{\n    61→    Write-Host \"Max:     $MaxIterations iterations\"\n    62→}} else {{\n    63→    Write-Host \"Max:     unlimited\"\n    64→}}\n    65→Write-Host \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\" -ForegroundColor Cyan\n    66→\n    67→# Verify prompt file exists\n    68→if (-not (Test-Path $PromptFile)) {{\n    69→    Write-Host \"Error: $PromptFile not found\" -ForegroundColor Red\n    70→    exit 1\n    71→}}\n    72→\n    73→$Iteration = 0\n    74→\n    75→while ($true) {{\n    76→    if ($MaxIterations -gt 0 -and $Iteration -ge $MaxIterations) {{\n    77→        Write-Host \"`nReached max iterations: $MaxIterations\" -ForegroundColor Yellow\n    78→        break\n    79→    }}\n    80→\n    81→    $Iteration++\n    82→    $Timestamp = Get-Date -Format \"yyyy-MM-dd HH:mm\"\n    83→\n    84→    Write-Host \"\"\n    85→    Write-Host \"======================== ITERATION $Iteration ========================\" -ForegroundColor Green\n    86→    Write-Host \"Started: $Timestamp\"\n    87→    Write-Host \"\"\n    88→\n    89→    # Compose prompt with optional task/progress context\n    90→    $PromptContent = Get-Content $PromptFile -Raw\n    91→    $TaskContent = Get-Content $TaskFile -Raw -ErrorAction SilentlyContinue\n    92→    $ProgressContent = Get-Content $ProgressFile -Raw -ErrorAction SilentlyContinue\n    93→    if ($TaskContent) {{\n    94→        $PromptContent = \"$PromptContent`n`n## Task`n$TaskContent\"\n    95→    }}\n    96→    if ($ProgressContent) {{\n    97→        $PromptContent = \"$PromptContent`n`n## Current Progress`n$ProgressContent\"\n    98→    }}\n    99→    {invocation_block}\n   100→    $AgentExitCode = $LASTEXITCODE\n   101→    if ($AgentExitCode -ne 0) {{\n   102→        Write-Host \"Agent invocation failed with exit code $AgentExitCode\" -ForegroundColor Red\n   103→        exit $AgentExitCode\n   104→    }}\n   105→\n   106→    # Push changes after each iteration\n   107→    git push origin $CurrentBranch\n   108→    if ($LASTEXITCODE -ne 0) {{\n   109→        Write-Host \"Failed to push. Creating remote branch...\" -ForegroundColor Yellow\n   110→        git push -u origin $CurrentBranch\n   111→    }}\n   112→\n   113→    Write-Host \"\"\n   114→    Write-Host \"[$(Get-Date -Format 'yyyy-MM-dd HH:mm')] ITERATION $Iteration complete\" -ForegroundColor Green\n   115→\n   116→    # Check if all phases complete (build mode only)\n   117→    if ($Mode -eq \"build\") {{\n   118→        $ProgressContent = Get-Content $ProgressFile -Raw -ErrorAction SilentlyContinue\n   119→        if ($ProgressContent -match \"ALL PHASES COMPLETE\") {{\n   120→            Write-Host \"`nAll phases complete! Stopping loop.\" -ForegroundColor Green\n   121→            break\n   122→        }}\n   123→    }}\n   124→}}\n   125→\n   126→Write-Host \"\"\n   127→Write-Host \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\" -ForegroundColor Cyan\n   128→Write-Host \"Loop finished after $Iteration iteration(s)\"\n   129→Write-Host \"Check: $ProgressFile\"\n   130→Write-Host \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\" -ForegroundColor Cyan\n   131→'''\n   132→\n   133→\n   134→\n   135→# Provider classes imported from server.services.provider_service above\n   136→\n   137→\n   138→# ---------------------------------------------------------------------------\n   139→\n   140→\n   141→def clear_screen():\n   142→    os.system('cls' if os.name == 'nt' else 'clear')\n   143→\n   144→\n   145→def print_header():\n   146→    print()\n   147→    print(\"=\" * 56)\n   148→    print(\"        RALPH LOOP RUNNER\")\n   149→    print(\"=\" * 56)\n   150→    print()\n   151→\n   152→\n   153→def get_features():\n   154→    \"\"\"Get list of feature directories.\"\"\"\n   155→    if not FEATURES_DIR.exists():\n   156→        return []\n   157→    return sorted([d.name for d in FEATURES_DIR.iterdir() if d.is_dir()])\n   158→\n   159→\n   160→def select_from_menu(title, options):\n   161→    \"\"\"Display menu and get user selection.\"\"\"\n   162→    print(f\"\\n{title}\")\n   163→    print(\"-\" * 40)\n   164→    for i, opt in enumerate(options, 1):\n   165→        print(f\"  {i}) {opt}\")\n   166→    print()\n   167→\n   168→    while True:\n   169→        try:\n   170→            choice = input(f\"Select [1-{len(options)}]: \").strip()\n   171→            num = int(choice)\n   172→            if 1 <= num <= len(options):\n   173→                return options[num - 1], num - 1\n   174→        except (ValueError, KeyboardInterrupt):\n   175→            pass\n   176→        print(\"Invalid choice, try again.\")\n   177→\n   178→\n   179→def get_prompt_content(mode: str, feature_name: str, feature_dir: Path) -> str:\n   180→    \"\"\"Get prompt content from template with variable substitution.\"\"\"\n   181→    filename = f\"PROMPT_{mode}.md\"\n   182→    template_path = TEMPLATES_DIR / filename\n   183→\n   184→    if not template_path.exists():\n   185→        return None\n   186→\n   187→    content = template_path.read_text(encoding='utf-8')\n   188→\n   189→    # Variable substitution\n   190→    content = content.replace(\"{{FEATURE_NAME}}\", feature_name)\n   191→    content = content.replace(\"{{FEATURE_DIR}}\", str(feature_dir).replace(\"\\\\\", \"/\"))\n   192→    content = content.replace(\"{{PROJECT_NAME}}\", PROJECT_ROOT.name)\n   193→\n   194→    return content\n   195→\n   196→\n   197→def run_loop(feature: str, mode: str, model: str, max_iterations: int,\n   198→             provider: Provider):\n   199→    \"\"\"Copy files, run loop, clean up.\"\"\"\n   200→    feature_dir = FEATURES_DIR / feature\n   201→\n   202→    # Files we'll create\n   203→    prompt_file = feature_dir / f\"PROMPT_{mode}.md\"\n   204→    loop_script = feature_dir / \"loop.ps1\"\n   205→\n   206→    # Track what we created for cleanup\n   207→    created_files = []\n   208→\n   209→    try:\n   210→        # Step 1: Copy/create prompt file if it doesn't exist\n   211→        if not prompt_file.exists():\n   212→            prompt_content = get_prompt_content(mode, feature, feature_dir)\n   213→            if not prompt_content:\n   214→                print(f\"\\nError: Template not found: {TEMPLATES_DIR / f'PROMPT_{mode}.md'}\")\n   215→                return\n   216→            prompt_file.write_text(prompt_content, encoding='utf-8')\n   217→            created_files.append(prompt_file)\n   218→            print(f\"  Created: {prompt_file.name}\")\n   219→        else:\n   220→            print(f\"  Using existing: {prompt_file.name}\")\n   221→\n   222→        # Step 2: Always regenerate loop script (provider/model may have changed)\n   223→        script_content = LOOP_SCRIPT_TEMPLATE.format(\n   224→            mode=mode,\n   225→            max_iterations=max_iterations,\n   226→            model=model,\n   227→            feature_name=feature,\n   228→            feature_dir_abs=str(feature_dir.resolve()),\n   229→            project_root_abs=str(PROJECT_ROOT.resolve()),\n   230→            provider_name=provider.display_name,\n   231→            invocation_block=provider.get_invocation(\"ps1\"),\n   232→        )\n   233→        loop_script.write_text(script_content, encoding='utf-8')\n   234→        created_files.append(loop_script)\n   235→        print(f\"  Created: {loop_script.name}\")\n   236→\n   237→        # Step 3: Run the loop script\n   238→        print()\n   239→        print(\"=\" * 56)\n   240→        print(\"  Starting loop...\")\n   241→        print(\"=\" * 56)\n   242→        print()\n   243→\n   244→        result = subprocess.run(\n   245→            [\"powershell\", \"-ExecutionPolicy\", \"Bypass\", \"-File\", str(loop_script)],\n   246→            cwd=str(PROJECT_ROOT.resolve()),  # Agent must start at project root\n   247→        )\n   248→\n   249→    except KeyboardInterrupt:\n   250→        print(\"\\n\\nInterrupted by user.\")\n   251→    except Exception as e:\n   252→        print(f\"\\nError: {e}\")\n   253→    finally:\n   254→        # Step 4: Clean up files we created\n   255→        if created_files:\n   256→            print()\n   257→            print(\"-\" * 40)\n   258→            print(\"Cleaning up temporary files...\")\n   259→            for f in created_files:\n   260→                try:\n   261→                    if f.exists():\n   262→                        f.unlink()\n   263→                        print(f\"  Deleted: {f.name}\")\n   264→                except Exception as e:\n   265→                    print(f\"  Failed to delete {f.name}: {e}\")\n   266→\n   267→\n   268→def main():\n   269→    clear_screen()\n   270→    print_header()\n   271→\n   272→    # Load provider settings (uses server.services.provider_service)\n   273→    providers = get_enabled_providers()\n   274→    if not providers:\n   275→        print(\"No providers enabled. Check settings.json\")\n   276→        sys.exit(1)\n   277→\n   278→    step = 1\n   279→\n   280→    # Step 1: Select feature\n   281→    features = get_features()\n   282→    if not features:\n   283→        print(f\"No features found in: {FEATURES_DIR}\")\n   284→        sys.exit(1)\n   285→\n   286→    feature, _ = select_from_menu(f\"Step {step}: Select Feature\", features)\n   287→    print(f\"  -> {feature}\")\n   288→    step += 1\n   289→\n   290→    # Step 2: Select provider (skip if only one)\n   291→    if len(providers) == 1:\n   292→        provider = providers[0]\n   293→        print(f\"\\n  Provider: {provider.display_name} (only enabled provider)\")\n   294→    else:\n   295→        provider_labels = [p.display_name for p in providers]\n   296→        label, idx = select_from_menu(f\"Step {step}: Select Provider\", provider_labels)\n   297→        provider = providers[idx]\n   298→        print(f\"  -> {provider.display_name}\")\n   299→        step += 1\n   300→\n   301→    # Step N: Select mode\n   302→    modes = [\"plan\", \"build\"]\n   303→    mode, _ = select_from_menu(f\"Step {step}: Select Mode\", modes)\n   304→    print(f\"  -> {mode}\")\n   305→    step += 1\n   306→\n   307→    # Step N+1: Select model (dynamic per provider)\n   308→    print(f\"\\n  Retrieving models for {provider.display_name}...\")\n   309→    models = provider.get_models()\n   310→    model, _ = select_from_menu(f\"Step {step}: Select Model\", models)\n   311→    print(f\"  -> {model}\")\n   312→    step += 1\n   313→\n   314→    # Step N+2: Select iterations\n   315→    iter_options = [\"Single (1)\", \"Limited (3)\", \"Limited (5)\", \"Limited (10)\", \"Unlimited\"]\n   316→    iter_choice, idx = select_from_menu(f\"Step {step}: Max Iterations\", iter_options)\n   317→    max_iter = [1, 3, 5, 10, 0][idx]\n   318→    print(f\"  -> {iter_choice}\")\n   319→\n   320→    # Confirm\n   321→    feature_dir = FEATURES_DIR / feature\n   322→    print()\n   323→    print(\"=\" * 56)\n   324→    print(f\"  Feature:     {feature}\")\n   325→    print(f\"  Provider:    {provider.display_name}\")\n   326→    print(f\"  Mode:        {mode}\")\n   327→    print(f\"  Model:       {model}\")\n   328→    print(f\"  Iterations:  {'unlimited' if max_iter == 0 else max_iter}\")\n   329→    print(f\"  Directory:   {feature_dir}\")\n   330→    print(\"=\" * 56)\n   331→    print()\n   332→\n   333→    confirm = input(\"Start loop? [Y/n]: \").strip().lower()\n   334→    if confirm and confirm != 'y':\n   335→        print(\"Cancelled.\")\n   336→        return\n   337→\n   338→    # Run the loop\n   339→    run_loop(feature, mode, model, max_iter, provider)\n   340→\n   341→\n   342→if __name__ == \"__main__\":\n   343→    try:\n   344→        main()\n   345→    except KeyboardInterrupt:\n   346→        print(\"\\n\\nExited.\")\n   347→        sys.exit(0)\n   348→"}]},"parent_tool_use_id":null,"session_id":"4b3360bf-9ca7-4816-8cf1-455a270dc126","uuid":"80f2f70e-7ce6-4391-a637-b4dc3caed55c","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/portable/ralph.py","content":"#!/usr/bin/env python3\n\"\"\"\nRalph Loop Runner - Configuration & Control Layer\n\n1. Ask user: feature, mode, iterations, model\n2. Copy prompt template and loop script into feature directory\n3. Run the loop script from feature directory\n4. Clean up copied files when done\n\"\"\"\n\nimport os\nimport sys\nimport subprocess\nfrom pathlib import Path\n\n# Paths\nSCRIPT_DIR = Path(__file__).parent\nPROJECT_ROOT = SCRIPT_DIR.parent\nFEATURES_DIR = PROJECT_ROOT / \".vista\" / \"features\"\nTEMPLATES_DIR = SCRIPT_DIR / \"templates\"\n\n# Allow importing from server.services when running standalone\nsys.path.insert(0, str(PROJECT_ROOT))\nfrom server.services.provider_service import (\n    Provider,\n    get_enabled_providers,\n    get_provider_by_name,\n)\n\n# Template loop script content - matches working loop.ps1\nLOOP_SCRIPT_TEMPLATE = '''# Feature Loop - Auto-generated by ralph.py\n# This file will be deleted after the loop completes\n\nparam(\n    [ValidateSet(\"plan\", \"build\")]\n    [string]$Mode = \"{mode}\",\n    [int]$MaxIterations = {max_iterations},\n    [string]$Model = \"{model}\"\n)\n\n# Absolute paths baked in by ralph.py - no relative resolution needed\n$FeatureDir = \"{feature_dir_abs}\"\n$ProjectRoot = \"{project_root_abs}\"\n\n# Set prompt file based on mode\n$PromptFile = Join-Path $FeatureDir \"PROMPT_$Mode.md\"\n$ProgressFile = Join-Path $FeatureDir \"progress.txt\"\n$TaskFile = Join-Path $FeatureDir \"task.md\"\n\n# Get current branch (cwd is already $ProjectRoot)\n$CurrentBranch = git branch --show-current\n\nWrite-Host \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\" -ForegroundColor Cyan\nWrite-Host \"Feature:  {feature_name}\"\nWrite-Host \"Provider: {provider_name}\"\nWrite-Host \"Mode:     $Mode\"\nWrite-Host \"Model:    $Model\"\nWrite-Host \"Branch:  $CurrentBranch\"\nWrite-Host \"Prompt:  $PromptFile\"\nif ($MaxIterations -gt 0) {{\n    Write-Host \"Max:     $MaxIterations iterations\"\n}} else {{\n    Write-Host \"Max:     unlimited\"\n}}\nWrite-Host \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\" -ForegroundColor Cyan\n\n# Verify prompt file exists\nif (-not (Test-Path $PromptFile)) {{\n    Write-Host \"Error: $PromptFile not found\" -ForegroundColor Red\n    exit 1\n}}\n\n$Iteration = 0\n\nwhile ($true) {{\n    if ($MaxIterations -gt 0 -and $Iteration -ge $MaxIterations) {{\n        Write-Host \"`nReached max iterations: $MaxIterations\" -ForegroundColor Yellow\n        break\n    }}\n\n    $Iteration++\n    $Timestamp = Get-Date -Format \"yyyy-MM-dd HH:mm\"\n\n    Write-Host \"\"\n    Write-Host \"======================== ITERATION $Iteration ========================\" -ForegroundColor Green\n    Write-Host \"Started: $Timestamp\"\n    Write-Host \"\"\n\n    # Compose prompt with optional task/progress context\n    $PromptContent = Get-Content $PromptFile -Raw\n    $TaskContent = Get-Content $TaskFile -Raw -ErrorAction SilentlyContinue\n    $ProgressContent = Get-Content $ProgressFile -Raw -ErrorAction SilentlyContinue\n    if ($TaskContent) {{\n        $PromptContent = \"$PromptContent`n`n## Task`n$TaskContent\"\n    }}\n    if ($ProgressContent) {{\n        $PromptContent = \"$PromptContent`n`n## Current Progress`n$ProgressContent\"\n    }}\n    {invocation_block}\n    $AgentExitCode = $LASTEXITCODE\n    if ($AgentExitCode -ne 0) {{\n        Write-Host \"Agent invocation failed with exit code $AgentExitCode\" -ForegroundColor Red\n        exit $AgentExitCode\n    }}\n\n    # Push changes after each iteration\n    git push origin $CurrentBranch\n    if ($LASTEXITCODE -ne 0) {{\n        Write-Host \"Failed to push. Creating remote branch...\" -ForegroundColor Yellow\n        git push -u origin $CurrentBranch\n    }}\n\n    Write-Host \"\"\n    Write-Host \"[$(Get-Date -Format 'yyyy-MM-dd HH:mm')] ITERATION $Iteration complete\" -ForegroundColor Green\n\n    # Check if all phases complete (build mode only)\n    if ($Mode -eq \"build\") {{\n        $ProgressContent = Get-Content $ProgressFile -Raw -ErrorAction SilentlyContinue\n        if ($ProgressContent -match \"ALL PHASES COMPLETE\") {{\n            Write-Host \"`nAll phases complete! Stopping loop.\" -ForegroundColor Green\n            break\n        }}\n    }}\n}}\n\nWrite-Host \"\"\nWrite-Host \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\" -ForegroundColor Cyan\nWrite-Host \"Loop finished after $Iteration iteration(s)\"\nWrite-Host \"Check: $ProgressFile\"\nWrite-Host \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\" -ForegroundColor Cyan\n'''\n\n\n\n# Provider classes imported from server.services.provider_service above\n\n\n# ---------------------------------------------------------------------------\n\n\ndef clear_screen():\n    os.system('cls' if os.name == 'nt' else 'clear')\n\n\ndef print_header():\n    print()\n    print(\"=\" * 56)\n    print(\"        RALPH LOOP RUNNER\")\n    print(\"=\" * 56)\n    print()\n\n\ndef get_features():\n    \"\"\"Get list of feature directories.\"\"\"\n    if not FEATURES_DIR.exists():\n        return []\n    return sorted([d.name for d in FEATURES_DIR.iterdir() if d.is_dir()])\n\n\ndef select_from_menu(title, options):\n    \"\"\"Display menu and get user selection.\"\"\"\n    print(f\"\\n{title}\")\n    print(\"-\" * 40)\n    for i, opt in enumerate(options, 1):\n        print(f\"  {i}) {opt}\")\n    print()\n\n    while True:\n        try:\n            choice = input(f\"Select [1-{len(options)}]: \").strip()\n            num = int(choice)\n            if 1 <= num <= len(options):\n                return options[num - 1], num - 1\n        except (ValueError, KeyboardInterrupt):\n            pass\n        print(\"Invalid choice, try again.\")\n\n\ndef get_prompt_content(mode: str, feature_name: str, feature_dir: Path) -> str:\n    \"\"\"Get prompt content from template with variable substitution.\"\"\"\n    filename = f\"PROMPT_{mode}.md\"\n    template_path = TEMPLATES_DIR / filename\n\n    if not template_path.exists():\n        return None\n\n    content = template_path.read_text(encoding='utf-8')\n\n    # Variable substitution\n    content = content.replace(\"{{FEATURE_NAME}}\", feature_name)\n    content = content.replace(\"{{FEATURE_DIR}}\", str(feature_dir).replace(\"\\\\\", \"/\"))\n    content = content.replace(\"{{PROJECT_NAME}}\", PROJECT_ROOT.name)\n\n    return content\n\n\ndef run_loop(feature: str, mode: str, model: str, max_iterations: int,\n             provider: Provider):\n    \"\"\"Copy files, run loop, clean up.\"\"\"\n    feature_dir = FEATURES_DIR / feature\n\n    # Files we'll create\n    prompt_file = feature_dir / f\"PROMPT_{mode}.md\"\n    loop_script = feature_dir / \"loop.ps1\"\n\n    # Track what we created for cleanup\n    created_files = []\n\n    try:\n        # Step 1: Copy/create prompt file if it doesn't exist\n        if not prompt_file.exists():\n            prompt_content = get_prompt_content(mode, feature, feature_dir)\n            if not prompt_content:\n                print(f\"\\nError: Template not found: {TEMPLATES_DIR / f'PROMPT_{mode}.md'}\")\n                return\n            prompt_file.write_text(prompt_content, encoding='utf-8')\n            created_files.append(prompt_file)\n            print(f\"  Created: {prompt_file.name}\")\n        else:\n            print(f\"  Using existing: {prompt_file.name}\")\n\n        # Step 2: Always regenerate loop script (provider/model may have changed)\n        script_content = LOOP_SCRIPT_TEMPLATE.format(\n            mode=mode,\n            max_iterations=max_iterations,\n            model=model,\n            feature_name=feature,\n            feature_dir_abs=str(feature_dir.resolve()),\n            project_root_abs=str(PROJECT_ROOT.resolve()),\n            provider_name=provider.display_name,\n            invocation_block=provider.get_invocation(\"ps1\"),\n        )\n        loop_script.write_text(script_content, encoding='utf-8')\n        created_files.append(loop_script)\n        print(f\"  Created: {loop_script.name}\")\n\n        # Step 3: Run the loop script\n        print()\n        print(\"=\" * 56)\n        print(\"  Starting loop...\")\n        print(\"=\" * 56)\n        print()\n\n        result = subprocess.run(\n            [\"powershell\", \"-ExecutionPolicy\", \"Bypass\", \"-File\", str(loop_script)],\n            cwd=str(PROJECT_ROOT.resolve()),  # Agent must start at project root\n        )\n\n    except KeyboardInterrupt:\n        print(\"\\n\\nInterrupted by user.\")\n    except Exception as e:\n        print(f\"\\nError: {e}\")\n    finally:\n        # Step 4: Clean up files we created\n        if created_files:\n            print()\n            print(\"-\" * 40)\n            print(\"Cleaning up temporary files...\")\n            for f in created_files:\n                try:\n                    if f.exists():\n                        f.unlink()\n                        print(f\"  Deleted: {f.name}\")\n                except Exception as e:\n                    print(f\"  Failed to delete {f.name}: {e}\")\n\n\ndef main():\n    clear_screen()\n    print_header()\n\n    # Load provider settings (uses server.services.provider_service)\n    providers = get_enabled_providers()\n    if not providers:\n        print(\"No providers enabled. Check settings.json\")\n        sys.exit(1)\n\n    step = 1\n\n    # Step 1: Select feature\n    features = get_features()\n    if not features:\n        print(f\"No features found in: {FEATURES_DIR}\")\n        sys.exit(1)\n\n    feature, _ = select_from_menu(f\"Step {step}: Select Feature\", features)\n    print(f\"  -> {feature}\")\n    step += 1\n\n    # Step 2: Select provider (skip if only one)\n    if len(providers) == 1:\n        provider = providers[0]\n        print(f\"\\n  Provider: {provider.display_name} (only enabled provider)\")\n    else:\n        provider_labels = [p.display_name for p in providers]\n        label, idx = select_from_menu(f\"Step {step}: Select Provider\", provider_labels)\n        provider = providers[idx]\n        print(f\"  -> {provider.display_name}\")\n        step += 1\n\n    # Step N: Select mode\n    modes = [\"plan\", \"build\"]\n    mode, _ = select_from_menu(f\"Step {step}: Select Mode\", modes)\n    print(f\"  -> {mode}\")\n    step += 1\n\n    # Step N+1: Select model (dynamic per provider)\n    print(f\"\\n  Retrieving models for {provider.display_name}...\")\n    models = provider.get_models()\n    model, _ = select_from_menu(f\"Step {step}: Select Model\", models)\n    print(f\"  -> {model}\")\n    step += 1\n\n    # Step N+2: Select iterations\n    iter_options = [\"Single (1)\", \"Limited (3)\", \"Limited (5)\", \"Limited (10)\", \"Unlimited\"]\n    iter_choice, idx = select_from_menu(f\"Step {step}: Max Iterations\", iter_options)\n    max_iter = [1, 3, 5, 10, 0][idx]\n    print(f\"  -> {iter_choice}\")\n\n    # Confirm\n    feature_dir = FEATURES_DIR / feature\n    print()\n    print(\"=\" * 56)\n    print(f\"  Feature:     {feature}\")\n    print(f\"  Provider:    {provider.display_name}\")\n    print(f\"  Mode:        {mode}\")\n    print(f\"  Model:       {model}\")\n    print(f\"  Iterations:  {'unlimited' if max_iter == 0 else max_iter}\")\n    print(f\"  Directory:   {feature_dir}\")\n    print(\"=\" * 56)\n    print()\n\n    confirm = input(\"Start loop? [Y/n]: \").strip().lower()\n    if confirm and confirm != 'y':\n        print(\"Cancelled.\")\n        return\n\n    # Run the loop\n    run_loop(feature, mode, model, max_iter, provider)\n\n\nif __name__ == \"__main__\":\n    try:\n        main()\n    except KeyboardInterrupt:\n        print(\"\\n\\nExited.\")\n        sys.exit(0)\n","numLines":348,"startLine":1,"totalLines":348}}}
