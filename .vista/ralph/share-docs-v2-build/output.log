{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pgnbo6PA3LVuXM64y3VE5n","type":"tool_result","content":"     1→\"\"\"Tests for export_service and export routes.\"\"\"\n     2→\n     3→import json\n     4→from pathlib import Path\n     5→\n     6→import pytest\n     7→\n     8→\n     9→def _setup_feature(\n    10→    project_path: Path,\n    11→    feature_name: str,\n    12→    diagrams=None,\n    13→    requirements=None,\n    14→    progress=None,\n    15→    agents_md=None,\n    16→    implementation_plan=None,\n    17→):\n    18→    \"\"\"Create a feature directory with optional arch manifest, diagrams, requirements, progress, agents, and plan.\"\"\"\n    19→    feature_dir = project_path / \".vista\" / \"features\" / feature_name\n    20→    feature_dir.mkdir(parents=True, exist_ok=True)\n    21→\n    22→    if diagrams is not None:\n    23→        arch_dir = feature_dir / \"arch\"\n    24→        arch_dir.mkdir(exist_ok=True)\n    25→        manifest = {\"feature\": feature_name, \"diagrams\": []}\n    26→        for d in diagrams:\n    27→            manifest[\"diagrams\"].append({\n    28→                \"name\": d[\"name\"],\n    29→                \"file\": d[\"file\"],\n    30→                \"type\": d.get(\"type\", \"mermaid\"),\n    31→                \"description\": d.get(\"description\", \"\"),\n    32→                \"category\": d.get(\"category\", \"architecture\"),\n    33→            })\n    34→            if \"content\" in d:\n    35→                (arch_dir / d[\"file\"]).write_text(d[\"content\"], encoding=\"utf-8\")\n    36→        (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n    37→\n    38→    if requirements is not None:\n    39→        (feature_dir / \"domain-requirements.md\").write_text(requirements, encoding=\"utf-8\")\n    40→\n    41→    if progress is not None:\n    42→        (feature_dir / \"progress.txt\").write_text(progress, encoding=\"utf-8\")\n    43→\n    44→    if agents_md is not None:\n    45→        (feature_dir / \"AGENTS.md\").write_text(agents_md, encoding=\"utf-8\")\n    46→\n    47→    if implementation_plan is not None:\n    48→        (feature_dir / \"IMPLEMENTATION_PLAN.md\").write_text(implementation_plan, encoding=\"utf-8\")\n    49→\n    50→\n    51→class TestProgressServiceReadDomainRequirements:\n    52→    def test_returns_content_when_file_exists(self, tmp_path):\n    53→        from server.services.progress_service import ProgressService\n    54→\n    55→        _setup_feature(tmp_path, \"my_feature\", requirements=\"# Requirements\\n- Req 1\")\n    56→        result = ProgressService.read_domain_requirements(str(tmp_path), \"my_feature\")\n    57→        assert result is not None\n    58→        assert \"Req 1\" in result\n    59→\n    60→    def test_returns_none_when_file_missing(self, tmp_path):\n    61→        from server.services.progress_service import ProgressService\n    62→\n    63→        feature_dir = tmp_path / \".vista\" / \"features\" / \"no_reqs\"\n    64→        feature_dir.mkdir(parents=True)\n    65→        result = ProgressService.read_domain_requirements(str(tmp_path), \"no_reqs\")\n    66→        assert result is None\n    67→\n    68→    def test_returns_none_when_file_empty(self, tmp_path):\n    69→        from server.services.progress_service import ProgressService\n    70→\n    71→        _setup_feature(tmp_path, \"empty_feature\", requirements=\"   \\n  \")\n    72→        result = ProgressService.read_domain_requirements(str(tmp_path), \"empty_feature\")\n    73→        assert result is None\n    74→\n    75→\n    76→class TestExportServiceGetExportableFeatures:\n    77→    def test_returns_features_with_diagrams(self, tmp_path):\n    78→        from server.services.export_service import ExportService\n    79→\n    80→        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n    81→            {\"name\": \"System Arch\", \"file\": \"system-arch.mmd\", \"content\": \"graph TD; A-->B\"},\n    82→        ])\n    83→        result = ExportService.get_exportable_features(str(tmp_path))\n    84→        assert len(result) == 1\n    85→        assert result[0][\"name\"] == \"feat_a\"\n    86→        assert len(result[0][\"diagrams\"]) == 1\n    87→        assert result[0][\"diagrams\"][0][\"file\"] == \"system-arch.mmd\"\n    88→\n    89→    def test_excludes_empty_features(self, tmp_path):\n    90→        from server.services.export_service import ExportService\n    91→\n    92→        # Feature with no diagrams and no requirements\n    93→        feature_dir = tmp_path / \".vista\" / \"features\" / \"empty_feat\"\n    94→        feature_dir.mkdir(parents=True)\n    95→        result = ExportService.get_exportable_features(str(tmp_path))\n    96→        assert len(result) == 0\n    97→\n    98→    def test_includes_requirements_only_feature(self, tmp_path):\n    99→        from server.services.export_service import ExportService\n   100→\n   101→        _setup_feature(tmp_path, \"reqs_only\", requirements=\"# Reqs\\n- Item 1\")\n   102→        result = ExportService.get_exportable_features(str(tmp_path))\n   103→        assert len(result) == 1\n   104→        assert result[0][\"name\"] == \"reqs_only\"\n   105→        assert result[0][\"has_requirements\"] is True\n   106→        assert len(result[0][\"diagrams\"]) == 0\n   107→\n   108→    def test_skips_underscore_prefixed_dirs(self, tmp_path):\n   109→        from server.services.export_service import ExportService\n   110→\n   111→        _setup_feature(tmp_path, \"_planning\", requirements=\"# Planning\\n- Internal\")\n   112→        result = ExportService.get_exportable_features(str(tmp_path))\n   113→        assert len(result) == 0\n   114→\n   115→    def test_returns_empty_when_no_features_dir(self, tmp_path):\n   116→        from server.services.export_service import ExportService\n   117→\n   118→        result = ExportService.get_exportable_features(str(tmp_path))\n   119→        assert result == []\n   120→\n   121→\n   122→class TestExportableFeaturesV2ContentTypes:\n   123→    \"\"\"Tests for Phase 1: progress, agents_md, and implementation_plan detection.\"\"\"\n   124→\n   125→    def test_exportable_features_includes_progress_only(self, tmp_path):\n   126→        from server.services.export_service import ExportService\n   127→\n   128→        _setup_feature(tmp_path, \"progress_feat\", progress=\"Phase: build\\nIteration 1\")\n   129→        result = ExportService.get_exportable_features(str(tmp_path))\n   130→        assert len(result) == 1\n   131→        assert result[0][\"name\"] == \"progress_feat\"\n   132→        assert result[0][\"has_progress\"] is True\n   133→        assert result[0][\"has_requirements\"] is False\n   134→\n   135→    def test_exportable_features_includes_plan_only(self, tmp_path):\n   136→        from server.services.export_service import ExportService\n   137→\n   138→        _setup_feature(tmp_path, \"plan_feat\", implementation_plan=\"# Plan\\n## Phase 1\")\n   139→        result = ExportService.get_exportable_features(str(tmp_path))\n   140→        assert len(result) == 1\n   141→        assert result[0][\"name\"] == \"plan_feat\"\n   142→        assert result[0][\"has_implementation_plan\"] is True\n   143→        assert result[0][\"has_requirements\"] is False\n   144→\n   145→    def test_exportable_features_reports_new_flags(self, tmp_path):\n   146→        from server.services.export_service import ExportService\n   147→\n   148→        _setup_feature(\n   149→            tmp_path, \"full_feat\",\n   150→            requirements=\"# Reqs\",\n   151→            progress=\"Phase: plan\",\n   152→            agents_md=\"# Agents\\n- Agent 1\",\n   153→            implementation_plan=\"# Plan\\n## Phase 1\",\n   154→        )\n   155→        result = ExportService.get_exportable_features(str(tmp_path))\n   156→        assert len(result) == 1\n   157→        feat = result[0]\n   158→        assert feat[\"has_requirements\"] is True\n   159→        assert feat[\"has_progress\"] is True\n   160→        assert feat[\"has_agents_md\"] is True\n   161→        assert feat[\"has_implementation_plan\"] is True\n   162→\n   163→    def test_generate_html_includes_progress(self, tmp_path):\n   164→        from server.services.export_service import ExportService\n   165→\n   166→        _setup_feature(tmp_path, \"feat_p\", progress=\"Iteration 1: did stuff\")\n   167→        html = ExportService.generate_export_html(\n   168→            project_name=\"Test\",\n   169→            project_path=str(tmp_path),\n   170→            selected_features=[{\"name\": \"feat_p\", \"diagrams\": []}],\n   171→        )\n   172→        assert \"Iteration 1: did stuff\" in html\n   173→        assert \"Progress Log\" in html\n   174→\n   175→    def test_generate_html_includes_plan(self, tmp_path):\n   176→        from server.services.export_service import ExportService\n   177→\n   178→        _setup_feature(tmp_path, \"feat_plan\", implementation_plan=\"# Phase 1\\nDo the thing\")\n   179→        html = ExportService.generate_export_html(\n   180→            project_name=\"Test\",\n   181→            project_path=str(tmp_path),\n   182→            selected_features=[{\"name\": \"feat_plan\", \"diagrams\": []}],\n   183→        )\n   184→        assert \"Phase 1\" in html\n   185→        assert \"Implementation Plan\" in html\n   186→\n   187→    def test_generate_html_includes_agents(self, tmp_path):\n   188→        from server.services.export_service import ExportService\n   189→\n   190→        _setup_feature(tmp_path, \"feat_agents\", agents_md=\"# Team\\n- Researcher\\n- Builder\")\n   191→        html = ExportService.generate_export_html(\n   192→            project_name=\"Test\",\n   193→            project_path=str(tmp_path),\n   194→            selected_features=[{\"name\": \"feat_agents\", \"diagrams\": []}],\n   195→        )\n   196→        assert \"Researcher\" in html\n   197→        assert \"Agents\" in html\n   198→\n   199→    def test_generate_html_respects_content_toggles(self, tmp_path):\n   200→        from server.services.export_service import ExportService\n   201→\n   202→        _setup_feature(\n   203→            tmp_path, \"feat_toggle\",\n   204→            requirements=\"# Reqs\",\n   205→            progress=\"Progress text\",\n   206→            agents_md=\"# Agents\",\n   207→            implementation_plan=\"# Plan\",\n   208→        )\n   209→        html = ExportService.generate_export_html(\n   210→            project_name=\"Test\",\n   211→            project_path=str(tmp_path),\n   212→            selected_features=[{\n   213→                \"name\": \"feat_toggle\",\n   214→                \"diagrams\": [],\n   215→                \"include_requirements\": False,\n   216→                \"include_progress\": False,\n   217→                \"include_agents\": False,\n   218→                \"include_implementation_plan\": True,\n   219→            }],\n   220→        )\n   221→        # Plan should be present\n   222→        assert \"Implementation Plan\" in html\n   223→        # Others should NOT be present (no content sections rendered)\n   224→        assert \"Domain Requirements\" not in html\n   225→        assert \"Progress Log\" not in html\n   226→        # \"Agents\" heading should not appear (but \"Agents\" in data might)\n   227→        assert \"agents-feat_toggle\" not in html\n   228→\n   229→\n   230→class TestExportServiceGenerateHtml:\n   231→    def test_basic_export(self, tmp_path):\n   232→        from server.services.export_service import ExportService\n   233→\n   234→        _setup_feature(tmp_path, \"my_feature\", diagrams=[\n   235→            {\"name\": \"Overview\", \"file\": \"overview.mmd\", \"content\": \"graph TD; A-->B\"},\n   236→        ], requirements=\"# Requirements\\n- Item 1\")\n   237→\n   238→        html = ExportService.generate_export_html(\n   239→            project_name=\"TestProject\",\n   240→            project_path=str(tmp_path),\n   241→            selected_features=[{\"name\": \"my_feature\", \"diagrams\": [\"overview.mmd\"]}],\n   242→        )\n   243→\n   244→        assert \"TestProject\" in html\n   245→        assert \"mermaid\" in html.lower()\n   246→        assert \"graph TD\" in html\n   247→        assert \"Requirements\" in html\n   248→\n   249→    def test_multiple_features(self, tmp_path):\n   250→        from server.services.export_service import ExportService\n   251→\n   252→        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n   253→            {\"name\": \"Arch A\", \"file\": \"arch-a.mmd\", \"content\": \"graph LR; A-->B\"},\n   254→        ])\n   255→        _setup_feature(tmp_path, \"feat_b\", diagrams=[\n   256→            {\"name\": \"Arch B\", \"file\": \"arch-b.mmd\", \"content\": \"graph LR; C-->D\"},\n   257→        ])\n   258→\n   259→        html = ExportService.generate_export_html(\n   260→            project_name=\"MultiProject\",\n   261→            project_path=str(tmp_path),\n   262→            selected_features=[\n   263→                {\"name\": \"feat_a\", \"diagrams\": [\"arch-a.mmd\"]},\n   264→                {\"name\": \"feat_b\", \"diagrams\": [\"arch-b.mmd\"]},\n   265→            ],\n   266→        )\n   267→\n   268→        assert \"feat_a\" in html\n   269→        assert \"feat_b\" in html\n   270→        # Navigation should be present for multiple features\n   271→        assert 'href=\"#feature-feat_a\"' in html\n   272→        assert 'href=\"#feature-feat_b\"' in html\n   273→\n   274→    def test_missing_diagram_file_skipped(self, tmp_path):\n   275→        from server.services.export_service import ExportService\n   276→\n   277→        _setup_feature(tmp_path, \"feat_c\", diagrams=[\n   278→            {\"name\": \"Exists\", \"file\": \"exists.mmd\", \"content\": \"graph TD; X-->Y\"},\n   279→            {\"name\": \"Missing\", \"file\": \"missing.mmd\"},  # no content = no file on disk\n   280→        ])\n   281→\n   282→        html = ExportService.generate_export_html(\n   283→            project_name=\"Test\",\n   284→            project_path=str(tmp_path),\n   285→            selected_features=[{\"name\": \"feat_c\", \"diagrams\": [\"exists.mmd\", \"missing.mmd\"]}],\n   286→        )\n   287→\n   288→        # Diagram content is embedded as JSON, so check for escaped version\n   289→        assert \"graph TD; X\" in html\n   290→        assert \"Exists\" in html\n   291→        # The missing diagram should be skipped gracefully\n   292→        assert \"Test\" in html\n   293→\n   294→    def test_missing_manifest_includes_requirements(self, tmp_path):\n   295→        from server.services.export_service import ExportService\n   296→\n   297→        # Feature with requirements but no _arch.json\n   298→        _setup_feature(tmp_path, \"reqs_feat\", requirements=\"# Domain Reqs\\n- Important thing\")\n   299→\n   300→        html = ExportService.generate_export_html(\n   301→            project_name=\"ReqsTest\",\n   302→            project_path=str(tmp_path),\n   303→            selected_features=[{\"name\": \"reqs_feat\", \"diagrams\": []}],\n   304→        )\n   305→\n   306→        assert \"Important thing\" in html\n   307→        assert \"ReqsTest\" in html\n   308→\n   309→    def test_empty_selection_returns_minimal_html(self, tmp_path):\n   310→        from server.services.export_service import ExportService\n   311→\n   312→        html = ExportService.generate_export_html(\n   313→            project_name=\"Empty\",\n   314→            project_path=str(tmp_path),\n   315→            selected_features=[],\n   316→        )\n   317→\n   318→        assert \"Empty\" in html\n   319→        assert \"<!DOCTYPE html>\" in html\n   320→\n   321→\n   322→class TestExportRoutes:\n   323→    @pytest.fixture\n   324→    def client(self, tmp_path):\n   325→        \"\"\"Create a test client with a registered project.\"\"\"\n   326→        from unittest.mock import patch, MagicMock\n   327→\n   328→        # Setup test feature\n   329→        _setup_feature(tmp_path, \"test_feature\", diagrams=[\n   330→            {\"name\": \"Test Diagram\", \"file\": \"test.mmd\", \"content\": \"graph TD; A-->B\"},\n   331→        ], requirements=\"# Test Requirements\")\n   332→\n   333→        mock_project = MagicMock()\n   334→        mock_project.id = \"test-123\"\n   335→        mock_project.name = \"TestProject\"\n   336→        mock_project.path = str(tmp_path)\n   337→\n   338→        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n   339→            mock_ps.get_by_id.return_value = mock_project\n   340→\n   341→            from fastapi.testclient import TestClient\n   342→            from fastapi import FastAPI\n   343→\n   344→            app = FastAPI()\n   345→            from server.routes.export import router\n   346→            app.include_router(router)\n   347→\n   348→            yield TestClient(app), mock_ps\n   349→\n   350→    def test_get_export_features(self, client):\n   351→        test_client, _ = client\n   352→        resp = test_client.get(\"/api/projects/test-123/export/features\")\n   353→        assert resp.status_code == 200\n   354→        data = resp.json()\n   355→        assert len(data) == 1\n   356→        assert data[0][\"name\"] == \"test_feature\"\n   357→        assert len(data[0][\"diagrams\"]) == 1\n   358→\n   359→    def test_post_export(self, client):\n   360→        test_client, _ = client\n   361→        resp = test_client.post(\"/api/projects/test-123/export\", json={\n   362→            \"features\": [{\"name\": \"test_feature\", \"diagrams\": [\"test.mmd\"]}]\n   363→        })\n   364→        assert resp.status_code == 200\n   365→        assert \"Content-Disposition\" in resp.headers\n   366→        assert \"TestProject\" in resp.headers[\"Content-Disposition\"]\n   367→        assert \"<!DOCTYPE html>\" in resp.text\n   368→\n   369→    def test_post_export_invalid_project(self, tmp_path):\n   370→        from unittest.mock import patch\n   371→        from fastapi.testclient import TestClient\n   372→        from fastapi import FastAPI\n   373→\n   374→        app = FastAPI()\n   375→        from server.routes.export import router\n   376→        app.include_router(router)\n   377→\n   378→        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n   379→            mock_ps.get_by_id.return_value = None\n   380→            test_client = TestClient(app)\n   381→            resp = test_client.post(\"/api/projects/nonexistent/export\", json={\n   382→                \"features\": [{\"name\": \"x\", \"diagrams\": []}]\n   383→            })\n   384→            assert resp.status_code == 404\n   385→"}]},"parent_tool_use_id":null,"session_id":"7816649e-26fc-4938-9512-2c8c95fbe878","uuid":"9abf3c5c-06cd-4955-8a72-5861007a1e24","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/tests/test_export_service.py","content":"\"\"\"Tests for export_service and export routes.\"\"\"\n\nimport json\nfrom pathlib import Path\n\nimport pytest\n\n\ndef _setup_feature(\n    project_path: Path,\n    feature_name: str,\n    diagrams=None,\n    requirements=None,\n    progress=None,\n    agents_md=None,\n    implementation_plan=None,\n):\n    \"\"\"Create a feature directory with optional arch manifest, diagrams, requirements, progress, agents, and plan.\"\"\"\n    feature_dir = project_path / \".vista\" / \"features\" / feature_name\n    feature_dir.mkdir(parents=True, exist_ok=True)\n\n    if diagrams is not None:\n        arch_dir = feature_dir / \"arch\"\n        arch_dir.mkdir(exist_ok=True)\n        manifest = {\"feature\": feature_name, \"diagrams\": []}\n        for d in diagrams:\n            manifest[\"diagrams\"].append({\n                \"name\": d[\"name\"],\n                \"file\": d[\"file\"],\n                \"type\": d.get(\"type\", \"mermaid\"),\n                \"description\": d.get(\"description\", \"\"),\n                \"category\": d.get(\"category\", \"architecture\"),\n            })\n            if \"content\" in d:\n                (arch_dir / d[\"file\"]).write_text(d[\"content\"], encoding=\"utf-8\")\n        (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n\n    if requirements is not None:\n        (feature_dir / \"domain-requirements.md\").write_text(requirements, encoding=\"utf-8\")\n\n    if progress is not None:\n        (feature_dir / \"progress.txt\").write_text(progress, encoding=\"utf-8\")\n\n    if agents_md is not None:\n        (feature_dir / \"AGENTS.md\").write_text(agents_md, encoding=\"utf-8\")\n\n    if implementation_plan is not None:\n        (feature_dir / \"IMPLEMENTATION_PLAN.md\").write_text(implementation_plan, encoding=\"utf-8\")\n\n\nclass TestProgressServiceReadDomainRequirements:\n    def test_returns_content_when_file_exists(self, tmp_path):\n        from server.services.progress_service import ProgressService\n\n        _setup_feature(tmp_path, \"my_feature\", requirements=\"# Requirements\\n- Req 1\")\n        result = ProgressService.read_domain_requirements(str(tmp_path), \"my_feature\")\n        assert result is not None\n        assert \"Req 1\" in result\n\n    def test_returns_none_when_file_missing(self, tmp_path):\n        from server.services.progress_service import ProgressService\n\n        feature_dir = tmp_path / \".vista\" / \"features\" / \"no_reqs\"\n        feature_dir.mkdir(parents=True)\n        result = ProgressService.read_domain_requirements(str(tmp_path), \"no_reqs\")\n        assert result is None\n\n    def test_returns_none_when_file_empty(self, tmp_path):\n        from server.services.progress_service import ProgressService\n\n        _setup_feature(tmp_path, \"empty_feature\", requirements=\"   \\n  \")\n        result = ProgressService.read_domain_requirements(str(tmp_path), \"empty_feature\")\n        assert result is None\n\n\nclass TestExportServiceGetExportableFeatures:\n    def test_returns_features_with_diagrams(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n            {\"name\": \"System Arch\", \"file\": \"system-arch.mmd\", \"content\": \"graph TD; A-->B\"},\n        ])\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        assert result[0][\"name\"] == \"feat_a\"\n        assert len(result[0][\"diagrams\"]) == 1\n        assert result[0][\"diagrams\"][0][\"file\"] == \"system-arch.mmd\"\n\n    def test_excludes_empty_features(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        # Feature with no diagrams and no requirements\n        feature_dir = tmp_path / \".vista\" / \"features\" / \"empty_feat\"\n        feature_dir.mkdir(parents=True)\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 0\n\n    def test_includes_requirements_only_feature(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"reqs_only\", requirements=\"# Reqs\\n- Item 1\")\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        assert result[0][\"name\"] == \"reqs_only\"\n        assert result[0][\"has_requirements\"] is True\n        assert len(result[0][\"diagrams\"]) == 0\n\n    def test_skips_underscore_prefixed_dirs(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"_planning\", requirements=\"# Planning\\n- Internal\")\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 0\n\n    def test_returns_empty_when_no_features_dir(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert result == []\n\n\nclass TestExportableFeaturesV2ContentTypes:\n    \"\"\"Tests for Phase 1: progress, agents_md, and implementation_plan detection.\"\"\"\n\n    def test_exportable_features_includes_progress_only(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"progress_feat\", progress=\"Phase: build\\nIteration 1\")\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        assert result[0][\"name\"] == \"progress_feat\"\n        assert result[0][\"has_progress\"] is True\n        assert result[0][\"has_requirements\"] is False\n\n    def test_exportable_features_includes_plan_only(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"plan_feat\", implementation_plan=\"# Plan\\n## Phase 1\")\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        assert result[0][\"name\"] == \"plan_feat\"\n        assert result[0][\"has_implementation_plan\"] is True\n        assert result[0][\"has_requirements\"] is False\n\n    def test_exportable_features_reports_new_flags(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(\n            tmp_path, \"full_feat\",\n            requirements=\"# Reqs\",\n            progress=\"Phase: plan\",\n            agents_md=\"# Agents\\n- Agent 1\",\n            implementation_plan=\"# Plan\\n## Phase 1\",\n        )\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        feat = result[0]\n        assert feat[\"has_requirements\"] is True\n        assert feat[\"has_progress\"] is True\n        assert feat[\"has_agents_md\"] is True\n        assert feat[\"has_implementation_plan\"] is True\n\n    def test_generate_html_includes_progress(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_p\", progress=\"Iteration 1: did stuff\")\n        html = ExportService.generate_export_html(\n            project_name=\"Test\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"feat_p\", \"diagrams\": []}],\n        )\n        assert \"Iteration 1: did stuff\" in html\n        assert \"Progress Log\" in html\n\n    def test_generate_html_includes_plan(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_plan\", implementation_plan=\"# Phase 1\\nDo the thing\")\n        html = ExportService.generate_export_html(\n            project_name=\"Test\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"feat_plan\", \"diagrams\": []}],\n        )\n        assert \"Phase 1\" in html\n        assert \"Implementation Plan\" in html\n\n    def test_generate_html_includes_agents(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_agents\", agents_md=\"# Team\\n- Researcher\\n- Builder\")\n        html = ExportService.generate_export_html(\n            project_name=\"Test\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"feat_agents\", \"diagrams\": []}],\n        )\n        assert \"Researcher\" in html\n        assert \"Agents\" in html\n\n    def test_generate_html_respects_content_toggles(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(\n            tmp_path, \"feat_toggle\",\n            requirements=\"# Reqs\",\n            progress=\"Progress text\",\n            agents_md=\"# Agents\",\n            implementation_plan=\"# Plan\",\n        )\n        html = ExportService.generate_export_html(\n            project_name=\"Test\",\n            project_path=str(tmp_path),\n            selected_features=[{\n                \"name\": \"feat_toggle\",\n                \"diagrams\": [],\n                \"include_requirements\": False,\n                \"include_progress\": False,\n                \"include_agents\": False,\n                \"include_implementation_plan\": True,\n            }],\n        )\n        # Plan should be present\n        assert \"Implementation Plan\" in html\n        # Others should NOT be present (no content sections rendered)\n        assert \"Domain Requirements\" not in html\n        assert \"Progress Log\" not in html\n        # \"Agents\" heading should not appear (but \"Agents\" in data might)\n        assert \"agents-feat_toggle\" not in html\n\n\nclass TestExportServiceGenerateHtml:\n    def test_basic_export(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"my_feature\", diagrams=[\n            {\"name\": \"Overview\", \"file\": \"overview.mmd\", \"content\": \"graph TD; A-->B\"},\n        ], requirements=\"# Requirements\\n- Item 1\")\n\n        html = ExportService.generate_export_html(\n            project_name=\"TestProject\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"my_feature\", \"diagrams\": [\"overview.mmd\"]}],\n        )\n\n        assert \"TestProject\" in html\n        assert \"mermaid\" in html.lower()\n        assert \"graph TD\" in html\n        assert \"Requirements\" in html\n\n    def test_multiple_features(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n            {\"name\": \"Arch A\", \"file\": \"arch-a.mmd\", \"content\": \"graph LR; A-->B\"},\n        ])\n        _setup_feature(tmp_path, \"feat_b\", diagrams=[\n            {\"name\": \"Arch B\", \"file\": \"arch-b.mmd\", \"content\": \"graph LR; C-->D\"},\n        ])\n\n        html = ExportService.generate_export_html(\n            project_name=\"MultiProject\",\n            project_path=str(tmp_path),\n            selected_features=[\n                {\"name\": \"feat_a\", \"diagrams\": [\"arch-a.mmd\"]},\n                {\"name\": \"feat_b\", \"diagrams\": [\"arch-b.mmd\"]},\n            ],\n        )\n\n        assert \"feat_a\" in html\n        assert \"feat_b\" in html\n        # Navigation should be present for multiple features\n        assert 'href=\"#feature-feat_a\"' in html\n        assert 'href=\"#feature-feat_b\"' in html\n\n    def test_missing_diagram_file_skipped(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_c\", diagrams=[\n            {\"name\": \"Exists\", \"file\": \"exists.mmd\", \"content\": \"graph TD; X-->Y\"},\n            {\"name\": \"Missing\", \"file\": \"missing.mmd\"},  # no content = no file on disk\n        ])\n\n        html = ExportService.generate_export_html(\n            project_name=\"Test\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"feat_c\", \"diagrams\": [\"exists.mmd\", \"missing.mmd\"]}],\n        )\n\n        # Diagram content is embedded as JSON, so check for escaped version\n        assert \"graph TD; X\" in html\n        assert \"Exists\" in html\n        # The missing diagram should be skipped gracefully\n        assert \"Test\" in html\n\n    def test_missing_manifest_includes_requirements(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        # Feature with requirements but no _arch.json\n        _setup_feature(tmp_path, \"reqs_feat\", requirements=\"# Domain Reqs\\n- Important thing\")\n\n        html = ExportService.generate_export_html(\n            project_name=\"ReqsTest\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"reqs_feat\", \"diagrams\": []}],\n        )\n\n        assert \"Important thing\" in html\n        assert \"ReqsTest\" in html\n\n    def test_empty_selection_returns_minimal_html(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        html = ExportService.generate_export_html(\n            project_name=\"Empty\",\n            project_path=str(tmp_path),\n            selected_features=[],\n        )\n\n        assert \"Empty\" in html\n        assert \"<!DOCTYPE html>\" in html\n\n\nclass TestExportRoutes:\n    @pytest.fixture\n    def client(self, tmp_path):\n        \"\"\"Create a test client with a registered project.\"\"\"\n        from unittest.mock import patch, MagicMock\n\n        # Setup test feature\n        _setup_feature(tmp_path, \"test_feature\", diagrams=[\n            {\"name\": \"Test Diagram\", \"file\": \"test.mmd\", \"content\": \"graph TD; A-->B\"},\n        ], requirements=\"# Test Requirements\")\n\n        mock_project = MagicMock()\n        mock_project.id = \"test-123\"\n        mock_project.name = \"TestProject\"\n        mock_project.path = str(tmp_path)\n\n        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n            mock_ps.get_by_id.return_value = mock_project\n\n            from fastapi.testclient import TestClient\n            from fastapi import FastAPI\n\n            app = FastAPI()\n            from server.routes.export import router\n            app.include_router(router)\n\n            yield TestClient(app), mock_ps\n\n    def test_get_export_features(self, client):\n        test_client, _ = client\n        resp = test_client.get(\"/api/projects/test-123/export/features\")\n        assert resp.status_code == 200\n        data = resp.json()\n        assert len(data) == 1\n        assert data[0][\"name\"] == \"test_feature\"\n        assert len(data[0][\"diagrams\"]) == 1\n\n    def test_post_export(self, client):\n        test_client, _ = client\n        resp = test_client.post(\"/api/projects/test-123/export\", json={\n            \"features\": [{\"name\": \"test_feature\", \"diagrams\": [\"test.mmd\"]}]\n        })\n        assert resp.status_code == 200\n        assert \"Content-Disposition\" in resp.headers\n        assert \"TestProject\" in resp.headers[\"Content-Disposition\"]\n        assert \"<!DOCTYPE html>\" in resp.text\n\n    def test_post_export_invalid_project(self, tmp_path):\n        from unittest.mock import patch\n        from fastapi.testclient import TestClient\n        from fastapi import FastAPI\n\n        app = FastAPI()\n        from server.routes.export import router\n        app.include_router(router)\n\n        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n            mock_ps.get_by_id.return_value = None\n            test_client = TestClient(app)\n            resp = test_client.post(\"/api/projects/nonexistent/export\", json={\n                \"features\": [{\"name\": \"x\", \"diagrams\": []}]\n            })\n            assert resp.status_code == 404\n","numLines":385,"startLine":1,"totalLines":385}}}
