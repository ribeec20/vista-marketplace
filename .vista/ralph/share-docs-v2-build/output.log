rue\n    include_progress: bool = True\n\n\nclass ExportRequest(BaseModel):\n    features: list[ExportFeatureSelection] = []\n    ralph_jobs: list[ExportRalphJobSelection] = []\n    offline: bool = False\n    default_theme: str = \"dark\"\n\n\n@router.get(\"/api/projects/{project_id}/export/features\")\nasync def get_export_features(project_id: str):\n    \"\"\"Return the feature tree for the export modal checklist.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n    return ExportService.get_exportable_features(project.path)\n\n\n@router.get(\"/api/projects/{project_id}/export/ralph-jobs\")\nasync def get_export_ralph_jobs(project_id: str):\n    \"\"\"Return Ralph jobs available for export.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n    return ExportService.get_exportable_ralph_jobs(project.path)\n\n\n@router.post(\"/api/projects/{project_id}/export\")\nasync def export_documentation(project_id: str, body: ExportRequest):\n    \"\"\"Generate and return the exported HTML documentation file.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    html = ExportService.generate_export_html(\n        project_name=project.name,\n        project_path=project.path,\n        selected_features=[f.model_dump() for f in body.features],\n        selected_ralph_jobs=[j.model_dump() for j in body.ralph_jobs],\n    )\n\n    filename = f\"{project.name}-docs-{datetime.now().strftime('%Y-%m-%d')}.html\"\n\n    return Response(\n        content=html,\n        media_type=\"text/html\",\n        headers={\"Content-Disposition\": f'attachment; filename=\"{filename}\"'},\n    )\n","structuredPatch":[{"oldStart":66,"oldLines":6,"newStart":66,"newLines":8,"lines":["         project_path=project.path,","         selected_features=[f.model_dump() for f in body.features],","         selected_ralph_jobs=[j.model_dump() for j in body.ralph_jobs],","+        offline=body.offline,","+        default_theme=body.default_theme,","     )"," ","     filename = f\"{project.name}-docs-{datetime.now().strftime('%Y-%m-%d')}.html\""]}],"userModified":false,"replaceAll":false}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01MVZLwnwb5CJhHdQw8vKah5","type":"message","role":"assistant","content":[{"type":"text","text":"Now the big update — the export.html template. This needs:\n1. Conditional inline vs CDN for dependencies\n2. Light/dark theme toggle with CSS custom properties\n3. Table of contents sidebar"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":369,"cache_read_input_tokens":90844,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":369},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"6996de78-f515-44c4-bca3-90f28086b3f0","uuid":"5761f91d-d752-4ede-8e18-966031b32166"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01MVZLwnwb5CJhHdQw8vKah5","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QQbJtHKmkhPXELThv5DEwn","name":"Write","input":{"file_path":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/views/export.html","content":"<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"{{ default_theme|default('dark') }}\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>{{ project_name }} - Documentation Export</title>\n    {% if offline|default(false) and vendor_deps|default({}) %}\n        {% if vendor_deps.tailwind_css %}\n        <style id=\"tailwind-inline\">{{ vendor_deps.tailwind_css }}</style>\n        {% endif %}\n        {% if vendor_deps.mermaid_js %}\n        <script>{{ vendor_deps.mermaid_js }}</script>\n        {% endif %}\n        {% if vendor_deps.marked_js %}\n        <script>{{ vendor_deps.marked_js }}</script>\n        {% endif %}\n    {% else %}\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/marked@15/marked.min.js\"></script>\n    {% endif %}\n    <style>\n        /* === Theme custom properties === */\n        :root, [data-theme=\"dark\"] {\n            --bg-primary: #111827;\n            --bg-secondary: #1f2937;\n            --bg-tertiary: #0f172a;\n            --bg-card: #1e293b;\n            --bg-card-hover: #334155;\n            --border-color: #374151;\n            --border-card: #334155;\n            --text-primary: #f3f4f6;\n            --text-secondary: #e2e8f0;\n            --text-muted: #9ca3af;\n            --text-dim: #6b7280;\n            --accent-green: #4ade80;\n            --accent-blue: #60a5fa;\n            --accent-orange: #fb923c;\n            --code-bg: #1e293b;\n            --code-color: #f472b6;\n            --pre-bg: #0f172a;\n            --blockquote-border: #475569;\n            --blockquote-color: #94a3b8;\n            --table-header-bg: #1e293b;\n            --mermaid-bg: #0f172a;\n        }\n        [data-theme=\"light\"] {\n            --bg-primary: #f9fafb;\n            --bg-secondary: #ffffff;\n            --bg-tertiary: #f3f4f6;\n            --bg-card: #ffffff;\n            --bg-card-hover: #f3f4f6;\n            --border-color: #d1d5db;\n            --border-card: #e5e7eb;\n            --text-primary: #111827;\n            --text-secondary: #1f2937;\n            --text-muted: #6b7280;\n            --text-dim: #9ca3af;\n            --accent-green: #16a34a;\n            --accent-blue: #2563eb;\n            --accent-orange: #ea580c;\n            --code-bg: #f3f4f6;\n            --code-color: #be185d;\n            --pre-bg: #f3f4f6;\n            --blockquote-border: #d1d5db;\n            --blockquote-color: #6b7280;\n            --table-header-bg: #f3f4f6;\n            --mermaid-bg: #ffffff;\n        }\n\n        body {\n            background: var(--bg-primary);\n            color: var(--text-primary);\n            transition: background-color 0.2s, color 0.2s;\n        }\n\n        /* --- TOC Sidebar --- */\n        .toc-sidebar {\n            position: fixed;\n            top: 0;\n            left: -280px;\n            width: 280px;\n            height: 100vh;\n            background: var(--bg-secondary);\n            border-right: 1px solid var(--border-color);\n            z-index: 40;\n            transition: left 0.25s ease;\n            overflow-y: auto;\n            padding: 1rem;\n        }\n        .toc-sidebar.open {\n            left: 0;\n        }\n        .toc-sidebar a {\n            display: block;\n            padding: 0.375rem 0.75rem;\n            font-size: 0.875rem;\n            color: var(--text-muted);\n            border-radius: 0.25rem;\n            text-decoration: none;\n            transition: background-color 0.15s, color 0.15s;\n        }\n        .toc-sidebar a:hover {\n            background: var(--bg-tertiary);\n            color: var(--text-primary);\n        }\n        .toc-sidebar a.active {\n            background: var(--bg-tertiary);\n            color: var(--accent-blue);\n            font-weight: 600;\n        }\n        .toc-overlay {\n            position: fixed;\n            inset: 0;\n            background: rgba(0,0,0,0.3);\n            z-index: 39;\n            display: none;\n        }\n        .toc-overlay.open {\n            display: block;\n        }\n\n        /* --- Header bar --- */\n        .export-header {\n            background: var(--bg-secondary);\n            border-bottom: 1px solid var(--border-color);\n        }\n        .export-nav {\n            background: color-mix(in srgb, var(--bg-secondary) 50%, transparent);\n            border-bottom: 1px solid var(--border-color);\n        }\n\n        /* --- Cards --- */\n        .content-card {\n            background: var(--bg-secondary);\n            border: 1px solid var(--border-color);\n            border-radius: 0.5rem;\n            padding: 1.5rem;\n        }\n\n        .diagram-card {\n            background: var(--bg-card);\n            border: 2px solid var(--border-card);\n            border-radius: 8px;\n            overflow: hidden;\n            transition: border-color 0.2s, box-shadow 0.2s;\n        }\n        .diagram-card:hover {\n            border-color: var(--bg-card-hover);\n            box-shadow: 0 0 0 1px var(--bg-card-hover);\n        }\n        .diagram-header {\n            padding: 10px 16px;\n            border-bottom: 1px solid var(--border-card);\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 8px;\n        }\n        .diagram-body {\n            position: relative;\n            overflow: hidden;\n            background: var(--mermaid-bg);\n            min-height: 200px;\n            max-height: 500px;\n        }\n        .diagram-viewport {\n            width: 100%;\n            height: 100%;\n            cursor: grab;\n            transform-origin: 0 0;\n            padding: 16px;\n        }\n        .diagram-viewport:active {\n            cursor: grabbing;\n        }\n        .diagram-viewport .mermaid svg {\n            max-width: none;\n        }\n        .diagram-viewport .mermaid svg .flowchart-link,\n        .diagram-viewport .mermaid svg .edge-pattern-dotted,\n        .diagram-viewport .mermaid svg path.path,\n        .diagram-viewport .mermaid svg path[class*=\"edge\"],\n        .diagram-viewport .mermaid svg line {\n            stroke-width: 2.5px !important;\n        }\n        .diagram-viewport .mermaid svg .edgeLabel,\n        .diagram-viewport .mermaid svg .nodeLabel,\n        .diagram-viewport .mermaid svg .label {\n            font-size: 14px !important;\n        }\n        .diagram-viewport .mermaid svg .edgeLabel {\n            font-size: 12px !important;\n        }\n        .diagram-viewport .mermaid svg marker path {\n            stroke-width: 1.5px !important;\n        }\n        .diagram-zoom-controls {\n            position: absolute;\n            bottom: 8px;\n            right: 8px;\n            display: flex;\n            gap: 4px;\n            z-index: 5;\n        }\n        .diagram-zoom-controls button {\n            width: 28px;\n            height: 28px;\n            border-radius: 4px;\n            background: var(--bg-card-hover);\n            color: var(--text-secondary);\n            border: 1px solid var(--border-card);\n            cursor: pointer;\n            font-size: 0.875rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            opacity: 0.7;\n            transition: opacity 0.2s;\n        }\n        .diagram-zoom-controls button:hover {\n            opacity: 1;\n        }\n        .badge {\n            font-size: 0.65rem;\n            padding: 2px 8px;\n            border-radius: 10px;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n        }\n        .badge-arch {\n            background: #1e3a5f;\n            color: #60a5fa;\n        }\n        .badge-tdd {\n            background: #422006;\n            color: #fbbf24;\n        }\n        .diagram-expand-btn {\n            width: 28px;\n            height: 28px;\n            border-radius: 4px;\n            background: transparent;\n            color: var(--text-muted);\n            border: 1px solid transparent;\n            cursor: pointer;\n            font-size: 1rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.15s;\n            flex-shrink: 0;\n        }\n        .diagram-expand-btn:hover {\n            background: var(--bg-card-hover);\n            color: var(--text-secondary);\n            border-color: var(--border-card);\n        }\n        /* Requirements prose styling */\n        .requirements-content h1,\n        .requirements-content h2,\n        .requirements-content h3,\n        .requirements-content h4 {\n            color: var(--text-secondary);\n            margin-top: 1.2em;\n            margin-bottom: 0.5em;\n            font-weight: 600;\n        }\n        .requirements-content h1 { font-size: 1.5rem; }\n        .requirements-content h2 { font-size: 1.25rem; }\n        .requirements-content h3 { font-size: 1.1rem; }\n        .requirements-content p {\n            color: var(--text-muted);\n            margin-bottom: 0.75em;\n            line-height: 1.6;\n        }\n        .requirements-content ul,\n        .requirements-content ol {\n            color: var(--text-muted);\n            margin-bottom: 0.75em;\n            padding-left: 1.5em;\n        }\n        .requirements-content li {\n            margin-bottom: 0.25em;\n        }\n        .requirements-content code {\n            background: var(--code-bg);\n            padding: 0.15em 0.4em;\n            border-radius: 4px;\n            font-size: 0.875em;\n            color: var(--code-color);\n        }\n        .requirements-content pre {\n            background: var(--pre-bg);\n            padding: 1em;\n            border-radius: 6px;\n            overflow-x: auto;\n            margin-bottom: 0.75em;\n        }\n        .requirements-content pre code {\n            background: transparent;\n            padding: 0;\n            color: var(--text-secondary);\n        }\n        .requirements-content table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 0.75em;\n        }\n        .requirements-content th,\n        .requirements-content td {\n            border: 1px solid var(--border-card);\n            padding: 0.5em 0.75em;\n            text-align: left;\n            color: var(--text-muted);\n        }\n        .requirements-content th {\n            background: var(--table-header-bg);\n            color: var(--text-secondary);\n            font-weight: 600;\n        }\n        .requirements-content strong {\n            color: var(--text-secondary);\n        }\n        .requirements-content a {\n            color: var(--accent-blue);\n        }\n        .requirements-content blockquote {\n            border-left: 3px solid var(--blockquote-border);\n            padding-left: 1em;\n            color: var(--blockquote-color);\n            margin-bottom: 0.75em;\n        }\n\n        /* --- Theme toggle button --- */\n        .theme-toggle {\n            width: 32px;\n            height: 32px;\n            border-radius: 6px;\n            background: var(--bg-tertiary);\n            border: 1px solid var(--border-color);\n            color: var(--text-muted);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1rem;\n            transition: all 0.15s;\n        }\n        .theme-toggle:hover {\n            color: var(--text-primary);\n            border-color: var(--text-muted);\n        }\n\n        /* --- TOC toggle button --- */\n        .toc-toggle {\n            width: 32px;\n            height: 32px;\n            border-radius: 6px;\n            background: var(--bg-tertiary);\n            border: 1px solid var(--border-color);\n            color: var(--text-muted);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1rem;\n            transition: all 0.15s;\n        }\n        .toc-toggle:hover {\n            color: var(--text-primary);\n            border-color: var(--text-muted);\n        }\n\n        /* Progress pre */\n        .progress-pre {\n            color: var(--text-muted);\n            white-space: pre-wrap;\n            line-height: 1.625;\n            font-size: 0.875rem;\n        }\n    </style>\n</head>\n<body class=\"min-h-screen\">\n    <!-- TOC Sidebar -->\n    <div id=\"toc-overlay\" class=\"toc-overlay\" onclick=\"toggleToc()\"></div>\n    <aside id=\"toc-sidebar\" class=\"toc-sidebar\">\n        <div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;\">\n            <span style=\"font-weight:600;font-size:0.875rem;color:var(--text-primary);\">Table of Contents</span>\n            <button onclick=\"toggleToc()\" style=\"background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:1.25rem;\">&times;</button>\n        </div>\n        <nav id=\"toc-nav\">\n            {% for feature in features %}\n            <a href=\"#feature-{{ feature.name }}\" onclick=\"tocClick(event)\"\n               style=\"text-transform:capitalize;\">{{ feature.name | replace('_', ' ') }}</a>\n            {% endfor %}\n            {% for job in ralph_jobs|default([]) %}\n            <a href=\"#ralph-{{ job.slug }}\" onclick=\"tocClick(event)\">\n                <span style=\"color:var(--accent-orange);font-size:0.75rem;\">ralph:</span> {{ job.slug | replace('-', ' ') }}\n            </a>\n            {% endfor %}\n        </nav>\n    </aside>\n\n    <!-- Header -->\n    <header class=\"export-header\" style=\"padding:1rem 1.5rem;\">\n        <div style=\"max-width:80rem;margin:0 auto;display:flex;align-items:center;justify-content:space-between;\">\n            <div style=\"display:flex;align-items:center;gap:0.75rem;\">\n                <span style=\"color:var(--accent-green);font-weight:600;font-size:1.125rem;\">Vista Dashboard</span>\n                <span style=\"color:var(--text-dim);\">&middot;</span>\n                <span style=\"font-size:1.25rem;font-weight:700;\">{{ project_name }}</span>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:0.5rem;\">\n                <span style=\"color:var(--text-muted);font-size:0.875rem;\">{{ export_date }}</span>\n                <button class=\"toc-toggle\" onclick=\"toggleToc()\" title=\"Table of Contents\">&#9776;</button>\n                <button class=\"theme-toggle\" onclick=\"toggleTheme()\" id=\"theme-btn\" title=\"Toggle theme\">&#9789;</button>\n            </div>\n        </div>\n    </header>\n\n    {% set all_sections = features|length + (ralph_jobs|default([])|length) %}\n    {% if all_sections > 1 %}\n    <nav class=\"export-nav\" style=\"padding:0.5rem 1.5rem;\">\n        <div style=\"max-width:80rem;margin:0 auto;display:flex;gap:1rem;flex-wrap:wrap;\">\n            {% for feature in features %}\n            <a href=\"#feature-{{ feature.name }}\"\n               style=\"font-size:0.875rem;color:var(--text-muted);text-decoration:none;text-transform:capitalize;transition:color 0.15s;\"\n               onmouseover=\"this.style.color='var(--text-secondary)'\" onmouseout=\"this.style.color='var(--text-muted)'\">\n                {{ feature.name | replace('_', ' ') }}\n            </a>\n            {% endfor %}\n            {% for job in ralph_jobs|default([]) %}\n            <a href=\"#ralph-{{ job.slug }}\"\n               style=\"font-size:0.875rem;color:var(--text-muted);text-decoration:none;transition:color 0.15s;\"\n               onmouseover=\"this.style.color='var(--text-secondary)'\" onmouseout=\"this.style.color='var(--text-muted)'\">\n                <span style=\"color:var(--accent-orange);opacity:0.7;font-size:0.75rem;margin-right:0.25rem;\">ralph:</span>{{ job.slug | replace('-', ' ') }}\n            </a>\n            {% endfor %}\n        </div>\n    </nav>\n    {% endif %}\n\n    <main style=\"max-width:80rem;margin:0 auto;padding:2rem 1.5rem;\">\n        {% for feature in features %}\n        {% set fi = loop.index0 %}\n        <section id=\"feature-{{ feature.name }}\" style=\"margin-bottom:3rem;\">\n            <h2 style=\"font-size:1.5rem;font-weight:700;margin-bottom:1.5rem;text-transform:capitalize;\">\n                {{ feature.name | replace('_', ' ') }}\n            </h2>\n\n            {% if feature.diagrams %}\n            <div style=\"display:flex;flex-direction:column;gap:1.5rem;margin-bottom:2rem;\">\n                {% for diagram in feature.diagrams %}\n                {% set did = fi ~ '-' ~ loop.index0 %}\n                <div class=\"diagram-card\" data-idx=\"{{ did }}\">\n                    <div class=\"diagram-header\">\n                        <div style=\"display:flex;align-items:center;gap:0.5rem;flex:1;min-width:0;\">\n                            <span style=\"font-weight:600;font-size:0.875rem;\">{{ diagram.name }}</span>\n                            <span class=\"badge {{ 'badge-tdd' if diagram.category == 'tdd' else 'badge-arch' }}\">\n                                {{ diagram.category or 'architecture' }}\n                            </span>\n                            {% if diagram.description %}\n                            <span style=\"color:var(--text-dim);font-size:0.75rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">\n                                {{ diagram.description }}\n                            </span>\n                            {% endif %}\n                        </div>\n                        <button onclick=\"expandDiagram(this)\" class=\"diagram-expand-btn\" title=\"Expand\">&#x26F6;</button>\n                    </div>\n                    <div class=\"diagram-body\">\n                        <div class=\"diagram-viewport\" id=\"viewport-{{ did }}\">\n                            <div class=\"mermaid-placeholder\" id=\"mermaid-{{ did }}\">\n                                Loading...\n                            </div>\n                        </div>\n                        <div class=\"diagram-zoom-controls\">\n                            <button onclick=\"zoomDiagram('{{ did }}', -0.2)\">&minus;</button>\n                            <button onclick=\"resetZoom('{{ did }}')\">1:1</button>\n                            <button onclick=\"zoomDiagram('{{ did }}', 0.2)\">+</button>\n                        </div>\n                    </div>\n                </div>\n                {% endfor %}\n            </div>\n            {% endif %}\n\n            {% if feature.requirements_md %}\n            <div class=\"content-card\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Domain Requirements</h3>\n                <div class=\"requirements-content\"\n                     id=\"requirements-{{ feature.name }}\">\n                </div>\n            </div>\n            {% endif %}\n\n            {% if feature.implementation_plan_md %}\n            <div class=\"content-card\" style=\"margin-top:1rem;\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Implementation Plan</h3>\n                <div class=\"requirements-content\"\n                     id=\"plan-{{ feature.name }}\">\n                </div>\n            </div>\n            {% endif %}\n\n            {% if feature.progress_md %}\n            <div class=\"content-card\" style=\"margin-top:1rem;\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Progress Log</h3>\n                <pre class=\"progress-pre\"\n                     id=\"progress-{{ feature.name }}\"></pre>\n            </div>\n            {% endif %}\n\n            {% if feature.agents_md %}\n            <div class=\"content-card\" style=\"margin-top:1rem;\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Agents</h3>\n                <div class=\"requirements-content\"\n                     id=\"agents-{{ feature.name }}\">\n                </div>\n            </div>\n            {% endif %}\n        </section>\n        {% endfor %}\n\n        {% for job in ralph_jobs|default([]) %}\n        <section id=\"ralph-{{ job.slug }}\" style=\"margin-bottom:3rem;\">\n            <div style=\"display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;\">\n                <span style=\"font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent-orange);background:rgba(124,45,18,0.3);padding:0.125rem 0.5rem;border-radius:0.25rem;\">Ralph Job</span>\n                <h2 style=\"font-size:1.5rem;font-weight:700;\">{{ job.slug | replace('-', ' ') }}</h2>\n            </div>\n\n            {% if job.task_md %}\n            <div class=\"content-card\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Task</h3>\n                <div class=\"requirements-content\"\n                     id=\"ralph-task-{{ job.slug }}\">\n                </div>\n            </div>\n            {% endif %}\n\n            {% if job.plan_md %}\n            <div class=\"content-card\" style=\"margin-top:1rem;\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Implementation Plan</h3>\n                <div class=\"requirements-content\"\n                     id=\"ralph-plan-{{ job.slug }}\">\n                </div>\n            </div>\n            {% endif %}\n\n            {% if job.progress_txt %}\n            <div class=\"content-card\" style=\"margin-top:1rem;\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Progress Log</h3>\n                <pre class=\"progress-pre\"\n                     id=\"ralph-progress-{{ job.slug }}\"></pre>\n            </div>\n            {% endif %}\n        </section>\n        {% endfor %}\n    </main>\n\n    <!-- Modal Overlay -->\n    <div id=\"diagram-modal\" style=\"position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:50;display:none;align-items:center;justify-content:center;\"\n         onclick=\"closeModal(event)\">\n        <div style=\"background:var(--bg-primary);border-radius:0.5rem;border:1px solid var(--border-color);width:95vw;height:90vh;display:flex;flex-direction:column;\"\n             onclick=\"event.stopPropagation()\">\n            <div style=\"display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;border-bottom:1px solid var(--border-color);\">\n                <span id=\"modal-title\" style=\"font-weight:600;\"></span>\n                <button onclick=\"closeModal()\" style=\"color:var(--text-muted);font-size:1.25rem;background:none;border:none;cursor:pointer;\">&times;</button>\n            </div>\n            <div style=\"flex:1;overflow:auto;padding:1rem;\" id=\"modal-content\"></div>\n        </div>\n    </div>\n\n    <!-- Data: embed diagram sources and requirements as JSON -->\n    <script id=\"export-data\" type=\"application/json\">\n        {{ export_data | tojson }}\n    </script>\n\n    <script>\n        // Parse embedded data\n        const EXPORT_DATA = JSON.parse(\n            document.getElementById('export-data').textContent\n        );\n\n        // --- Theme ---\n        function getTheme() {\n            return document.documentElement.getAttribute('data-theme') || 'dark';\n        }\n\n        function setTheme(theme) {\n            document.documentElement.setAttribute('data-theme', theme);\n            const btn = document.getElementById('theme-btn');\n            if (btn) btn.innerHTML = theme === 'dark' ? '&#9789;' : '&#9788;';\n        }\n\n        function toggleTheme() {\n            const current = getTheme();\n            const next = current === 'dark' ? 'light' : 'dark';\n            setTheme(next);\n            // Re-render mermaid with appropriate theme\n            reRenderMermaid(next);\n        }\n\n        // --- TOC ---\n        function toggleToc() {\n            const sidebar = document.getElementById('toc-sidebar');\n            const overlay = document.getElementById('toc-overlay');\n            sidebar.classList.toggle('open');\n            overlay.classList.toggle('open');\n        }\n\n        function tocClick(e) {\n            e.preventDefault();\n            const href = e.currentTarget.getAttribute('href');\n            const target = document.querySelector(href);\n            if (target) target.scrollIntoView({ behavior: 'smooth' });\n            toggleToc();\n        }\n\n        // --- Mermaid Init ---\n        function getMermaidTheme(theme) {\n            if (theme === 'light') {\n                return {\n                    theme: 'default',\n                    themeVariables: {\n                        darkMode: false,\n                        background: '#ffffff',\n                        primaryColor: '#dbeafe',\n                        primaryTextColor: '#111827',\n                        primaryBorderColor: '#93c5fd',\n                        lineColor: '#6b7280',\n                        secondaryColor: '#f3f4f6',\n                        tertiaryColor: '#f9fafb',\n                        fontSize: '14px',\n                    }\n                };\n            }\n            return {\n                theme: 'dark',\n                themeVariables: {\n                    darkMode: true,\n                    background: '#0f172a',\n                    primaryColor: '#1e3a5f',\n                    primaryTextColor: '#e2e8f0',\n                    primaryBorderColor: '#475569',\n                    lineColor: '#94a3b8',\n                    secondaryColor: '#1a2332',\n                    tertiaryColor: '#0f172a',\n                    fontSize: '14px',\n                }\n            };\n        }\n\n        const initialTheme = getTheme();\n        const mermaidConfig = getMermaidTheme(initialTheme);\n        mermaid.initialize({\n            startOnLoad: false,\n            ...mermaidConfig,\n        });\n\n        // Set initial theme icon\n        setTheme(initialTheme);\n\n        // --- Marked config ---\n        marked.setOptions({ breaks: true, gfm: true });\n\n        // --- Render all diagrams ---\n        let mermaidCounter = 0;\n\n        async function renderAllDiagrams() {\n            for (const item of EXPORT_DATA.diagrams) {\n                const el = document.getElementById(`mermaid-${item.id}`);\n                if (!el) continue;\n                try {\n                    const renderId = `mermaid-svg-export-${++mermaidCounter}`;\n                    const { svg } = await mermaid.render(renderId, item.content);\n                    el.innerHTML = svg;\n                    initViewport(item.id);\n                } catch (e) {\n                    el.innerHTML = `<pre style=\"color:#fbbf24;font-size:0.75rem;white-space:pre-wrap;\">Mermaid parse error:\\n${e.message || e}\\n\\n${escapeHtml(item.content)}</pre>`;\n                    initViewport(item.id);\n                }\n            }\n        }\n\n        async function reRenderMermaid(theme) {\n            const config = getMermaidTheme(theme);\n            mermaid.initialize({ startOnLoad: false, ...config });\n            for (const item of EXPORT_DATA.diagrams) {\n                const el = document.getElementById(`mermaid-${item.id}`);\n                if (!el) continue;\n                try {\n                    const renderId = `mermaid-svg-rerender-${++mermaidCounter}`;\n                    const { svg } = await mermaid.render(renderId, item.content);\n                    el.innerHTML = svg;\n                } catch (e) {\n                    // Keep existing render on error\n                }\n            }\n        }\n\n        // --- Render all markdown content ---\n        function renderAllMarkdown() {\n            // Requirements\n            for (const [name, md] of Object.entries(EXPORT_DATA.requirements || {})) {\n                if (!md) continue;\n                const el = document.getElementById(`requirements-${name}`);\n                if (el) el.innerHTML = marked.parse(md);\n            }\n            // Implementation plans\n            for (const [name, md] of Object.entries(EXPORT_DATA.implementation_plans || {})) {\n                if (!md) continue;\n                const el = document.getElementById(`plan-${name}`);\n                if (el) el.innerHTML = marked.parse(md);\n            }\n            // Agents\n            for (const [name, md] of Object.entries(EXPORT_DATA.agents || {})) {\n                if (!md) continue;\n                const el = document.getElementById(`agents-${name}`);\n                if (el) el.innerHTML = marked.parse(md);\n            }\n            // Progress (plain text, not markdown)\n            for (const [name, text] of Object.entries(EXPORT_DATA.progress || {})) {\n                if (!text) continue;\n                const el = document.getElementById(`progress-${name}`);\n                if (el) el.textContent = text;\n            }\n            // Ralph tasks\n            for (const [slug, md] of Object.entries(EXPORT_DATA.ralph_tasks || {})) {\n                if (!md) continue;\n                const el = document.getElementById(`ralph-task-${slug}`);\n                if (el) el.innerHTML = marked.parse(md);\n            }\n            // Ralph plans\n            for (const [slug, md] of Object.entries(EXPORT_DATA.ralph_plans || {})) {\n                if (!md) continue;\n                const el = document.getElementById(`ralph-plan-${slug}`);\n                if (el) el.innerHTML = marked.parse(md);\n            }\n            // Ralph progress (plain text)\n            for (const [slug, text] of Object.entries(EXPORT_DATA.ralph_progress || {})) {\n                if (!text) continue;\n                const el = document.getElementById(`ralph-progress-${slug}`);\n                if (el) el.textContent = text;\n            }\n        }\n\n        // --- Pan/zoom ---\n        const viewportState = {};\n\n        function initViewport(idx) {\n            const vp = document.getElementById(`viewport-${idx}`);\n            if (!vp) return;\n            viewportState[idx] = { scale: 1, panX: 0, panY: 0, dragging: false, startX: 0, startY: 0 };\n            vp.addEventListener('wheel', (e) => {\n                e.preventDefault();\n                const delta = e.deltaY > 0 ? -0.1 : 0.1;\n                zoomDiagram(idx, delta);\n            }, { passive: false });\n            vp.addEventListener('mousedown', (e) => {\n                if (e.button !== 0) return;\n                const st = viewportState[idx];\n                st.dragging = true;\n                st.startX = e.clientX - st.panX;\n                st.startY = e.clientY - st.panY;\n                vp.style.cursor = 'grabbing';\n            });\n            vp.addEventListener('mousemove', (e) => {\n                const st = viewportState[idx];\n                if (!st.dragging) return;\n                st.panX = e.clientX - st.startX;\n                st.panY = e.clientY - st.startY;\n                applyTransform(idx);\n            });\n            const stopDrag = () => {\n                const st = viewportState[idx];\n                if (st) st.dragging = false;\n                vp.style.cursor = 'grab';\n            };\n            vp.addEventListener('mouseup', stopDrag);\n            vp.addEventListener('mouseleave', stopDrag);\n        }\n\n        function applyTransform(idx) {\n            const vp = document.getElementById(`viewport-${idx}`);\n            const st = viewportState[idx];\n            if (!vp || !st) return;\n            vp.style.transform = `translate(${st.panX}px, ${st.panY}px) scale(${st.scale})`;\n        }\n\n        function zoomDiagram(idx, delta) {\n            const st = viewportState[idx];\n            if (!st) return;\n            st.scale = Math.max(0.3, Math.min(3, st.scale + delta));\n            applyTransform(idx);\n        }\n\n        function resetZoom(idx) {\n            const st = viewportState[idx];\n            if (!st) return;\n            st.scale = 1; st.panX = 0; st.panY = 0;\n            applyTransform(idx);\n        }\n\n        // --- Modal expand/close ---\n        function expandDiagram(btn) {\n            const card = btn.closest('.diagram-card');\n            const viewport = card.querySelector('.diagram-viewport');\n            const title = card.querySelector('.diagram-header .font-semibold') || card.querySelector('.diagram-header span');\n            const modal = document.getElementById('diagram-modal');\n            const modalTitle = document.getElementById('modal-title');\n            const modalContent = document.getElementById('modal-content');\n\n            modalTitle.textContent = title ? title.textContent : 'Diagram';\n            modalContent.innerHTML = viewport.innerHTML;\n            modal.style.display = 'flex';\n        }\n\n        function closeModal(event) {\n            if (event && event.target !== event.currentTarget) return;\n            const modal = document.getElementById('diagram-modal');\n            modal.style.display = 'none';\n        }\n\n        // Close modal on Escape\n        document.addEventListener('keydown', (e) => {\n            if (e.key === 'Escape') closeModal();\n        });\n\n        function escapeHtml(str) {\n            if (!str) return '';\n            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n        }\n\n        // --- Feature nav smooth scroll ---\n        document.querySelectorAll('nav a[href^=\"#\"]').forEach(a => {\n            a.addEventListener('click', (e) => {\n                e.preventDefault();\n                const target = document.querySelector(a.getAttribute('href'));\n                if (target) target.scrollIntoView({ behavior: 'smooth' });\n            });\n        });\n\n        // --- Init ---\n        renderAllDiagrams();\n        renderAllMarkdown();\n    </script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":369,"cache_read_input_tokens":90844,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":369},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"6996de78-f515-44c4-bca3-90f28086b3f0","uuid":"be15f152-deb7-4a12-a121-7451f4c84f69"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QQbJtHKmkhPXELThv5DEwn","type":"tool_result","content":"The file C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/views/export.html has been overwritten successfully."}]},"parent_tool_use_id":null,"session_id":"6996de78-f515-44c4-bca3-90f28086b3f0","uuid":"fc641e8a-a402-4e1e-a342-bae336542d55","tool_use_result":{"type":"update","filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/views/export.html","content":"<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"{{ default_theme|default('dark') }}\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>{{ project_name }} - Documentation Export</title>\n    {% if offline|default(false) and vendor_deps|default({}) %}\n        {% if vendor_deps.tailwind_css %}\n        <style id=\"tailwind-inline\">{{ vendor_deps.tailwind_css }}</style>\n        {% endif %}\n        {% if vendor_deps.mermaid_js %}\n        <script>{{ vendor_deps.mermaid_js }}</script>\n        {% endif %}\n        {% if vendor_deps.marked_js %}\n        <script>{{ vendor_deps.marked_js }}</script>\n        {% endif %}\n    {% else %}\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/marked@15/marked.min.js\"></script>\n    {% endif %}\n    <style>\n        /* === Theme custom properties === */\n        :root, [data-theme=\"dark\"] {\n            --bg-primary: #111827;\n            --bg-secondary: #1f2937;\n            --bg-tertiary: #0f172a;\n            --bg-card: #1e293b;\n            --bg-card-hover: #334155;\n            --border-color: #374151;\n            --border-card: #334155;\n            --text-primary: #f3f4f6;\n            --text-secondary: #e2e8f0;\n            --text-muted: #9ca3af;\n            --text-dim: #6b7280;\n            --accent-green: #4ade80;\n            --accent-blue: #60a5fa;\n            --accent-orange: #fb923c;\n            --code-bg: #1e293b;\n            --code-color: #f472b6;\n            --pre-bg: #0f172a;\n            --blockquote-border: #475569;\n            --blockquote-color: #94a3b8;\n            --table-header-bg: #1e293b;\n            --mermaid-bg: #0f172a;\n        }\n        [data-theme=\"light\"] {\n            --bg-primary: #f9fafb;\n            --bg-secondary: #ffffff;\n            --bg-tertiary: #f3f4f6;\n            --bg-card: #ffffff;\n            --bg-card-hover: #f3f4f6;\n            --border-color: #d1d5db;\n            --border-card: #e5e7eb;\n            --text-primary: #111827;\n            --text-secondary: #1f2937;\n            --text-muted: #6b7280;\n            --text-dim: #9ca3af;\n            --accent-green: #16a34a;\n            --accent-blue: #2563eb;\n            --accent-orange: #ea580c;\n            --code-bg: #f3f4f6;\n            --code-color: #be185d;\n            --pre-bg: #f3f4f6;\n            --blockquote-border: #d1d5db;\n            --blockquote-color: #6b7280;\n            --table-header-bg: #f3f4f6;\n            --mermaid-bg: #ffffff;\n        }\n\n        body {\n            background: var(--bg-primary);\n            color: var(--text-primary);\n            transition: background-color 0.2s, color 0.2s;\n        }\n\n        /* --- TOC Sidebar --- */\n        .toc-sidebar {\n            position: fixed;\n            top: 0;\n            left: -280px;\n            width: 280px;\n            height: 100vh;\n            background: var(--bg-secondary);\n            border-right: 1px solid var(--border-color);\n            z-index: 40;\n            transition: left 0.25s ease;\n            overflow-y: auto;\n            padding: 1rem;\n        }\n        .toc-sidebar.open {\n            left: 0;\n        }\n        .toc-sidebar a {\n            display: block;\n            padding: 0.375rem 0.75rem;\n            font-size: 0.875rem;\n            color: var(--text-muted);\n            border-radius: 0.25rem;\n            text-decoration: none;\n            transition: background-color 0.15s, color 0.15s;\n        }\n        .toc-sidebar a:hover {\n            background: var(--bg-tertiary);\n            color: var(--text-primary);\n        }\n        .toc-sidebar a.active {\n            background: var(--bg-tertiary);\n            color: var(--accent-blue);\n            font-weight: 600;\n        }\n        .toc-overlay {\n            position: fixed;\n            inset: 0;\n            background: rgba(0,0,0,0.3);\n            z-index: 39;\n            display: none;\n        }\n        .toc-overlay.open {\n            display: block;\n        }\n\n        /* --- Header bar --- */\n        .export-header {\n            background: var(--bg-secondary);\n            border-bottom: 1px solid var(--border-color);\n        }\n        .export-nav {\n            background: color-mix(in srgb, var(--bg-secondary) 50%, transparent);\n            border-bottom: 1px solid var(--border-color);\n        }\n\n        /* --- Cards --- */\n        .content-card {\n            background: var(--bg-secondary);\n            border: 1px solid var(--border-color);\n            border-radius: 0.5rem;\n            padding: 1.5rem;\n        }\n\n        .diagram-card {\n            background: var(--bg-card);\n            border: 2px solid var(--border-card);\n            border-radius: 8px;\n            overflow: hidden;\n            transition: border-color 0.2s, box-shadow 0.2s;\n        }\n        .diagram-card:hover {\n            border-color: var(--bg-card-hover);\n            box-shadow: 0 0 0 1px var(--bg-card-hover);\n        }\n        .diagram-header {\n            padding: 10px 16px;\n            border-bottom: 1px solid var(--border-card);\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 8px;\n        }\n        .diagram-body {\n            position: relative;\n            overflow: hidden;\n            background: var(--mermaid-bg);\n            min-height: 200px;\n            max-height: 500px;\n        }\n        .diagram-viewport {\n            width: 100%;\n            height: 100%;\n            cursor: grab;\n            transform-origin: 0 0;\n            padding: 16px;\n        }\n        .diagram-viewport:active {\n            cursor: grabbing;\n        }\n        .diagram-viewport .mermaid svg {\n            max-width: none;\n        }\n        .diagram-viewport .mermaid svg .flowchart-link,\n        .diagram-viewport .mermaid svg .edge-pattern-dotted,\n        .diagram-viewport .mermaid svg path.path,\n        .diagram-viewport .mermaid svg path[class*=\"edge\"],\n        .diagram-viewport .mermaid svg line {\n            stroke-width: 2.5px !important;\n        }\n        .diagram-viewport .mermaid svg .edgeLabel,\n        .diagram-viewport .mermaid svg .nodeLabel,\n        .diagram-viewport .mermaid svg .label {\n            font-size: 14px !important;\n        }\n        .diagram-viewport .mermaid svg .edgeLabel {\n            font-size: 12px !important;\n        }\n        .diagram-viewport .mermaid svg marker path {\n            stroke-width: 1.5px !important;\n        }\n        .diagram-zoom-controls {\n            position: absolute;\n            bottom: 8px;\n            right: 8px;\n            display: flex;\n            gap: 4px;\n            z-index: 5;\n        }\n        .diagram-zoom-controls button {\n            width: 28px;\n            height: 28px;\n            border-radius: 4px;\n            background: var(--bg-card-hover);\n            color: var(--text-secondary);\n            border: 1px solid var(--border-card);\n            cursor: pointer;\n            font-size: 0.875rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            opacity: 0.7;\n            transition: opacity 0.2s;\n        }\n        .diagram-zoom-controls button:hover {\n            opacity: 1;\n        }\n        .badge {\n            font-size: 0.65rem;\n            padding: 2px 8px;\n            border-radius: 10px;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n        }\n        .badge-arch {\n            background: #1e3a5f;\n            color: #60a5fa;\n        }\n        .badge-tdd {\n            background: #422006;\n            color: #fbbf24;\n        }\n        .diagram-expand-btn {\n            width: 28px;\n            height: 28px;\n            border-radius: 4px;\n            background: transparent;\n            color: var(--text-muted);\n            border: 1px solid transparent;\n            cursor: pointer;\n            font-size: 1rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.15s;\n            flex-shrink: 0;\n        }\n        .diagram-expand-btn:hover {\n            background: var(--bg-card-hover);\n            color: var(--text-secondary);\n            border-color: var(--border-card);\n        }\n        /* Requirements prose styling */\n        .requirements-content h1,\n        .requirements-content h2,\n        .requirements-content h3,\n        .requirements-content h4 {\n            color: var(--text-secondary);\n            margin-top: 1.2em;\n            margin-bottom: 0.5em;\n            font-weight: 600;\n        }\n        .requirements-content h1 { font-size: 1.5rem; }\n        .requirements-content h2 { font-size: 1.25rem; }\n        .requirements-content h3 { font-size: 1.1rem; }\n        .requirements-content p {\n            color: var(--text-muted);\n            margin-bottom: 0.75em;\n            line-height: 1.6;\n        }\n        .requirements-content ul,\n        .requirements-content ol {\n            color: var(--text-muted);\n            margin-bottom: 0.75em;\n            padding-left: 1.5em;\n        }\n        .requirements-content li {\n            margin-bottom: 0.25em;\n        }\n        .requirements-content code {\n            background: var(--code-bg);\n            padding: 0.15em 0.4em;\n            border-radius: 4px;\n            font-size: 0.875em;\n            color: var(--code-color);\n        }\n        .requirements-content pre {\n            background: var(--pre-bg);\n            padding: 1em;\n            border-radius: 6px;\n            overflow-x: auto;\n            margin-bottom: 0.75em;\n        }\n        .requirements-content pre code {\n            background: transparent;\n            padding: 0;\n            color: var(--text-secondary);\n        }\n        .requirements-content table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 0.75em;\n        }\n        .requirements-content th,\n        .requirements-content td {\n            border: 1px solid var(--border-card);\n            padding: 0.5em 0.75em;\n            text-align: left;\n            color: var(--text-muted);\n        }\n        .requirements-content th {\n            background: var(--table-header-bg);\n            color: var(--text-secondary);\n            font-weight: 600;\n        }\n        .requirements-content strong {\n            color: var(--text-secondary);\n        }\n        .requirements-content a {\n            color: var(--accent-blue);\n        }\n        .requirements-content blockquote {\n            border-left: 3px solid var(--blockquote-border);\n            padding-left: 1em;\n            color: var(--blockquote-color);\n            margin-bottom: 0.75em;\n        }\n\n        /* --- Theme toggle button --- */\n        .theme-toggle {\n            width: 32px;\n            height: 32px;\n            border-radius: 6px;\n            background: var(--bg-tertiary);\n            border: 1px solid var(--border-color);\n            color: var(--text-muted);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1rem;\n            transition: all 0.15s;\n        }\n        .theme-toggle:hover {\n            color: var(--text-primary);\n            border-color: var(--text-muted);\n        }\n\n        /* --- TOC toggle button --- */\n        .toc-toggle {\n            width: 32px;\n            height: 32px;\n            border-radius: 6px;\n            background: var(--bg-tertiary);\n            border: 1px solid var(--border-color);\n            color: var(--text-muted);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1rem;\n            transition: all 0.15s;\n        }\n        .toc-toggle:hover {\n            color: var(--text-primary);\n            border-color: var(--text-muted);\n        }\n\n        /* Progress pre */\n        .progress-pre {\n            color: var(--text-muted);\n            white-space: pre-wrap;\n            line-height: 1.625;\n            font-size: 0.875rem;\n        }\n    </style>\n</head>\n<body class=\"min-h-screen\">\n    <!-- TOC Sidebar -->\n    <div id=\"toc-overlay\" class=\"toc-overlay\" onclick=\"toggleToc()\"></div>\n    <aside id=\"toc-sidebar\" class=\"toc-sidebar\">\n        <div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;\">\n            <span style=\"font-weight:600;font-size:0.875rem;color:var(--text-primary);\">Table of Contents</span>\n            <button onclick=\"toggleToc()\" style=\"background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:1.25rem;\">&times;</button>\n        </div>\n        <nav id=\"toc-nav\">\n            {% for feature in features %}\n            <a href=\"#feature-{{ feature.name }}\" onclick=\"tocClick(event)\"\n               style=\"text-transform:capitalize;\">{{ feature.name | replace('_', ' ') }}</a>\n            {% endfor %}\n            {% for job in ralph_jobs|default([]) %}\n            <a href=\"#ralph-{{ job.slug }}\" onclick=\"tocClick(event)\">\n                <span style=\"color:var(--accent-orange);font-size:0.75rem;\">ralph:</span> {{ job.slug | replace('-', ' ') }}\n            </a>\n            {% endfor %}\n        </nav>\n    </aside>\n\n    <!-- Header -->\n    <header class=\"export-header\" style=\"padding:1rem 1.5rem;\">\n        <div style=\"max-width:80rem;margin:0 auto;display:flex;align-items:center;justify-content:space-between;\">\n            <div style=\"display:flex;align-items:center;gap:0.75rem;\">\n                <span style=\"color:var(--accent-green);font-weight:600;font-size:1.125rem;\">Vista Dashboard</span>\n                <span style=\"color:var(--text-dim);\">&middot;</span>\n                <span style=\"font-size:1.25rem;font-weight:700;\">{{ project_name }}</span>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:0.5rem;\">\n                <span style=\"color:var(--text-muted);font-size:0.875rem;\">{{ export_date }}</span>\n                <button class=\"toc-toggle\" onclick=\"toggleToc()\" title=\"Table of Contents\">&#9776;</button>\n                <button class=\"theme-toggle\" onclick=\"toggleTheme()\" id=\"theme-btn\" title=\"Toggle theme\">&#9789;</button>\n            </div>\n        </div>\n    </header>\n\n    {% set all_sections = features|length + (ralph_jobs|default([])|length) %}\n    {% if all_sections > 1 %}\n    <nav class=\"export-nav\" style=\"padding:0.5rem 1.5rem;\">\n        <div style=\"max-width:80rem;margin:0 auto;display:flex;gap:1rem;flex-wrap:wrap;\">\n            {% for feature in features %}\n            <a href=\"#feature-{{ feature.name }}\"\n               style=\"font-size:0.875rem;color:var(--text-muted);text-decoration:none;text-transform:capitalize;transition:color 0.15s;\"\n               onmouseover=\"this.style.color='var(--text-secondary)'\" onmouseout=\"this.style.color='var(--text-muted)'\">\n                {{ feature.name | replace('_', ' ') }}\n            </a>\n            {% endfor %}\n            {% for job in ralph_jobs|default([]) %}\n            <a href=\"#ralph-{{ job.slug }}\"\n               style=\"font-size:0.875rem;color:var(--text-muted);text-decoration:none;transition:color 0.15s;\"\n               onmouseover=\"this.style.color='var(--text-secondary)'\" onmouseout=\"this.style.color='var(--text-muted)'\">\n                <span style=\"color:var(--accent-orange);opacity:0.7;font-size:0.75rem;margin-right:0.25rem;\">ralph:</span>{{ job.slug | replace('-', ' ') }}\n            </a>\n            {% endfor %}\n        </div>\n    </nav>\n    {% endif %}\n\n    <main style=\"max-width:80rem;margin:0 auto;padding:2rem 1.5rem;\">\n        {% for feature in features %}\n        {% set fi = loop.index0 %}\n        <section id=\"feature-{{ feature.name }}\" style=\"margin-bottom:3rem;\">\n            <h2 style=\"font-size:1.5rem;font-weight:700;margin-bottom:1.5rem;text-transform:capitalize;\">\n                {{ feature.name | replace('_', ' ') }}\n            </h2>\n\n            {% if feature.diagrams %}\n            <div style=\"display:flex;flex-direction:column;gap:1.5rem;margin-bottom:2rem;\">\n                {% for diagram in feature.diagrams %}\n                {% set did = fi ~ '-' ~ loop.index0 %}\n                <div class=\"diagram-card\" data-idx=\"{{ did }}\">\n                    <div class=\"diagram-header\">\n                        <div style=\"display:flex;align-items:center;gap:0.5rem;flex:1;min-width:0;\">\n                            <span style=\"font-weight:600;font-size:0.875rem;\">{{ diagram.name }}</span>\n                            <span class=\"badge {{ 'badge-tdd' if diagram.category == 'tdd' else 'badge-arch' }}\">\n                                {{ diagram.category or 'architecture' }}\n                            </span>\n                            {% if diagram.description %}\n                            <span style=\"color:var(--text-dim);font-size:0.75rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">\n                                {{ diagram.description }}\n                            </span>\n                            {% endif %}\n                        </div>\n                        <button onclick=\"expandDiagram(this)\" class=\"diagram-expand-btn\" title=\"Expand\">&#x26F6;</button>\n                    </div>\n                    <div class=\"diagram-body\">\n                        <div class=\"diagram-viewport\" id=\"viewport-{{ did }}\">\n                            <div class=\"mermaid-placeholder\" id=\"mermaid-{{ did }}\">\n                                Loading...\n                            </div>\n                        </div>\n                        <div class=\"diagram-zoom-controls\">\n                            <button onclick=\"zoomDiagram('{{ did }}', -0.2)\">&minus;</button>\n                            <button onclick=\"resetZoom('{{ did }}')\">1:1</button>\n                            <button onclick=\"zoomDiagram('{{ did }}', 0.2)\">+</button>\n                        </div>\n                    </div>\n                </div>\n                {% endfor %}\n            </div>\n            {% endif %}\n\n            {% if feature.requirements_md %}\n            <div class=\"content-card\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Domain Requirements</h3>\n                <div class=\"requirements-content\"\n                     id=\"requirements-{{ feature.name }}\">\n                </div>\n            </div>\n            {% endif %}\n\n            {% if feature.implementation_plan_md %}\n            <div class=\"content-card\" style=\"margin-top:1rem;\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Implementation Plan</h3>\n                <div class=\"requirements-content\"\n                     id=\"plan-{{ feature.name }}\">\n                </div>\n            </div>\n            {% endif %}\n\n            {% if feature.progress_md %}\n            <div class=\"content-card\" style=\"margin-top:1rem;\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Progress Log</h3>\n                <pre class=\"progress-pre\"\n                     id=\"progress-{{ feature.name }}\"></pre>\n            </div>\n            {% endif %}\n\n            {% if feature.agents_md %}\n            <div class=\"content-card\" style=\"margin-top:1rem;\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Agents</h3>\n                <div class=\"requirements-content\"\n                     id=\"agents-{{ feature.name }}\">\n                </div>\n            </div>\n            {% endif %}\n        </section>\n        {% endfor %}\n\n        {% for job in ralph_jobs|default([]) %}\n        <section id=\"ralph-{{ job.slug }}\" style=\"margin-bottom:3rem;\">\n            <div style=\"display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;\">\n                <span style=\"font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent-orange);background:rgba(124,45,18,0.3);padding:0.125rem 0.5rem;border-radius:0.25rem;\">Ralph Job</span>\n                <h2 style=\"font-size:1.5rem;font-weight:700;\">{{ job.slug | replace('-', ' ') }}</h2>\n            </div>\n\n            {% if job.task_md %}\n            <div class=\"content-card\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Task</h3>\n                <div class=\"requirements-content\"\n                     id=\"ralph-task-{{ job.slug }}\">\n                </div>\n            </div>\n            {% endif %}\n\n            {% if job.plan_md %}\n            <div class=\"content-card\" style=\"margin-top:1rem;\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Implementation Plan</h3>\n                <div class=\"requirements-content\"\n                     id=\"ralph-plan-{{ job.slug }}\">\n                </div>\n            </div>\n            {% endif %}\n\n            {% if job.progress_txt %}\n            <div class=\"content-card\" style=\"margin-top:1rem;\">\n                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Progress Log</h3>\n                <pre class=\"progress-pre\"\n                     id=\"ralph-progress-{{ job.slug }}\"></pre>\n            </div>\n            {% endif %}\n        </section>\n        {% endfor %}\n    </main>\n\n    <!-- Modal Overlay -->\n    <div id=\"diagram-modal\" style=\"position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:50;display:none;align-items:center;justify-content:center;\"\n         onclick=\"closeModal(event)\">\n        <div style=\"background:var(--bg-primary);border-radius:0.5rem;border:1px solid var(--border-color);width:95vw;height:90vh;display:flex;flex-direction:column;\"\n             onclick=\"event.stopPropagation()\">\n            <div style=\"display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;border-bottom:1px solid var(--border-color);\">\n                <span id=\"modal-title\" style=\"font-weight:600;\"></span>\n                <button onclick=\"closeModal()\" style=\"color:var(--text-muted);font-size:1.25rem;background:none;border:none;cursor:pointer;\">&times;</button>\n            </div>\n            <div style=\"flex:1;overflow:auto;padding:1rem;\" id=\"modal-content\"></div>\n        </div>\n    </div>\n\n    <!-- Data: embed diagram sources and requirements as JSON -->\n    <script id=\"export-data\" type=\"application/json\">\n        {{ export_data | tojson }}\n    </script>\n\n    <script>\n        // Parse embedded data\n        const EXPORT_DATA = JSON.parse(\n            document.getElementById('export-data').textContent\n        );\n\n        // --- Theme ---\n        function getTheme() {\n            return document.documentElement.getAttribute('data-theme') || 'dark';\n        }\n\n        function setTheme(theme) {\n            document.documentElement.setAttribute('data-theme', theme);\n            const btn = document.getElementById('theme-btn');\n            if (btn) btn.innerHTML = theme === 'dark' ? '&#9789;' : '&#9788;';\n        }\n\n        function toggleTheme() {\n            const current = getTheme();\n            const next = current === 'dark' ? 'light' : 'dark';\n            setTheme(next);\n            // Re-render mermaid with appropriate theme\n            reRenderMermaid(next);\n        }\n\n        // --- TOC ---\n        function toggleToc() {\n            const sidebar = document.getElementById('toc-sidebar');\n            const overlay = document.getElementById('toc-overlay');\n            sidebar.classList.toggle('open');\n            overlay.classList.toggle('open');\n        }\n\n        function tocClick(e) {\n            e.preventDefault();\n            const href = e.currentTarget.getAttribute('href');\n            const target = document.querySelector(href);\n            if (target) target.scrollIntoView({ behavior: 'smooth' });\n            toggleToc();\n        }\n\n        // --- Mermaid Init ---\n        function getMermaidTheme(theme) {\n            if (theme === 'light') {\n                return {\n                    theme: 'default',\n                    themeVariables: {\n                        darkMode: false,\n                        background: '#ffffff',\n                        primaryColor: '#dbeafe',\n                        primaryTextColor: '#111827',\n                        primaryBorderColor: '#93c5fd',\n                        lineColor: '#6b7280',\n                        secondaryColor: '#f3f4f6',\n                        tertiaryColor: '#f9fafb',\n                        fontSize: '14px',\n                    }\n                };\n            }\n            return {\n                theme: 'dark',\n                themeVariables: {\n                    darkMode: true,\n                    background: '#0f172a',\n                    primaryColor: '#1e3a5f',\n                    primaryTextColor: '#e2e8f0',\n                    primaryBorderColor: '#475569',\n                    lineColor: '#94a3b8',\n                    secondaryColor: '#1a2332',\n                    tertiaryColor: '#0f172a',\n                    fontSize: '14px',\n                }\n            };\n        }\n\n        const initialTheme = getTheme();\n        const mermaidConfig = getMermaidTheme(initialTheme);\n        mermaid.initialize({\n            startOnLoad: false,\n            ...mermaidConfig,\n        });\n\n        // Set initial theme icon\n        setTheme(initialTheme);\n\n        // --- Marked config ---\n        marked.setOptions({ breaks: true, gfm: true });\n\n        // --- Render all diagrams ---\n        let mermaidCounter = 0;\n\n        async function renderAllDiagrams() {\n            for (const item of EXPORT_DATA.diagrams) {\n                const el = document.getElementById(`mermaid-${item.id}`);\n                if (!el) continue;\n                try {\n                    const renderId = `mermaid-svg-export-${++mermaidCounter}`;\n                    const { svg } = await mermaid.render(renderId, item.content);\n                    el.innerHTML = svg;\n                    initViewport(item.id);\n                } catch (e) {\n                    el.innerHTML = `<pre style=\"color:#fbbf24;font-size:0.75rem;white-space:pre-wrap;\">Mermaid parse error:\\n${e.message || e}\\n\\n${escapeHtml(item.content)}</pre>`;\n                    initViewport(item.id);\n                }\n            }\n        }\n\n        async function reRenderMermaid(theme) {\n            const config = getMermaidTheme(theme);\n            mermaid.initialize({ startOnLoad: false, ...config });\n            for (const item of EXPORT_DATA.diagrams) {\n                const el = document.getElementById(`mermaid-${item.id}`);\n                if (!el) continue;\n                try {\n                    const renderId = `mermaid-svg-rerender-${++mermaidCounter}`;\n                    const { svg } = await mermaid.render(renderId, item.content);\n                    el.innerHTML = svg;\n                } catch (e) {\n                    // Keep existing render on error\n                }\n            }\n        }\n\n        // --- Render all markdown content ---\n        function renderAllMarkdown() {\n            // Requirements\n            for (const [name, md] of Object.entries(EXPORT_DATA.requirements || {})) {\n                if (!md) continue;\n                const el = document.getElementById(`requirements-${name}`);\n                if (el) el.innerHTML = marked.parse(md);\n            }\n            // Implementation plans\n            for (const [name, md] of Object.entries(EXPORT_DATA.implementation_plans || {})) {\n                if (!md) continue;\n                const el = document.getElementById(`plan-${name}`);\n                if (el) el.innerHTML = marked.parse(md);\n            }\n            // Agents\n            for (const [name, md] of Object.entries(EXPORT_DATA.agents || {})) {\n                if (!md) continue;\n                const el = document.getElementById(`agents-${name}`);\n                if (el) el.innerHTML = marked.parse(md);\n            }\n            // Progress (plain text, not markdown)\n            for (const [name, text] of Object.entries(EXPORT_DATA.progress || {})) {\n                if (!text) continue;\n                const el = document.getElementById(`progress-${name}`);\n                if (el) el.textContent = text;\n            }\n            // Ralph tasks\n            for (const [slug, md] of Object.entries(EXPORT_DATA.ralph_tasks || {})) {\n                if (!md) continue;\n                const el = document.getElementById(`ralph-task-${slug}`);\n                if (el) el.innerHTML = marked.parse(md);\n            }\n            // Ralph plans\n            for (const [slug, md] of Object.entries(EXPORT_DATA.ralph_plans || {})) {\n                if (!md) continue;\n                const el = document.getElementById(`ralph-plan-${slug}`);\n                if (el) el.innerHTML = marked.parse(md);\n            }\n            // Ralph progress (plain text)\n            for (const [slug, text] of Object.entries(EXPORT_DATA.ralph_progress || {})) {\n                if (!text) continue;\n                const el = document.getElementById(`ralph-progress-${slug}`);\n                if (el) el.textContent = text;\n            }\n        }\n\n        // --- Pan/zoom ---\n        const viewportState = {};\n\n        function initViewport(idx) {\n            const vp = document.getElementById(`viewport-${idx}`);\n            if (!vp) return;\n            viewportState[idx] = { scale: 1, panX: 0, panY: 0, dragging: false, startX: 0, startY: 0 };\n            vp.addEventListener('wheel', (e) => {\n                e.preventDefault();\n                const delta = e.deltaY > 0 ? -0.1 : 0.1;\n                zoomDiagram(idx, delta);\n            }, { passive: false });\n            vp.addEventListener('mousedown', (e) => {\n                if (e.button !== 0) return;\n                const st = viewportState[idx];\n                st.dragging = true;\n                st.startX = e.clientX - st.panX;\n                st.startY = e.clientY - st.panY;\n                vp.style.cursor = 'grabbing';\n            });\n            vp.addEventListener('mousemove', (e) => {\n                const st = viewportState[idx];\n                if (!st.dragging) return;\n                st.panX = e.clientX - st.startX;\n                st.panY = e.clientY - st.startY;\n                applyTransform(idx);\n            });\n            const stopDrag = () => {\n                const st = viewportState[idx];\n                if (st) st.dragging = false;\n                vp.style.cursor = 'grab';\n            };\n            vp.addEventListener('mouseup', stopDrag);\n            vp.addEventListener('mouseleave', stopDrag);\n        }\n\n        function applyTransform(idx) {\n            const vp = document.getElementById(`viewport-${idx}`);\n            const st = viewportState[idx];\n            if (!vp || !st) return;\n            vp.style.transform = `translate(${st.panX}px, ${st.panY}px) scale(${st.scale})`;\n        }\n\n        function zoomDiagram(idx, delta) {\n            const st = viewportState[idx];\n            if (!st) return;\n            st.scale = Math.max(0.3, Math.min(3, st.scale + delta));\n            applyTransform(idx);\n        }\n\n        function resetZoom(idx) {\n            const st = viewportState[idx];\n            if (!st) return;\n            st.scale = 1; st.panX = 0; st.panY = 0;\n            applyTransform(idx);\n        }\n\n        // --- Modal expand/close ---\n        function expandDiagram(btn) {\n            const card = btn.closest('.diagram-card');\n            const viewport = card.querySelector('.diagram-viewport');\n            const title = card.querySelector('.diagram-header .font-semibold') || card.querySelector('.diagram-header span');\n            const modal = document.getElementById('diagram-modal');\n            const modalTitle = document.getElementById('modal-title');\n            const modalContent = document.getElementById('modal-content');\n\n            modalTitle.textContent = title ? title.textContent : 'Diagram';\n            modalContent.innerHTML = viewport.innerHTML;\n            modal.style.display = 'flex';\n        }\n\n        function closeModal(event) {\n            if (event && event.target !== event.currentTarget) return;\n            const modal = document.getElementById('diagram-modal');\n            modal.style.display = 'none';\n        }\n\n        // Close modal on Escape\n        document.addEventListener('keydown', (e) => {\n            if (e.key === 'Escape') closeModal();\n        });\n\n        function escapeHtml(str) {\n            if (!str) return '';\n            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n        }\n\n        // --- Feature nav smooth scroll ---\n        document.querySelectorAll('nav a[href^=\"#\"]').forEach(a => {\n            a.addEventListener('click', (e) => {\n                e.preventDefault();\n                const target = document.querySelector(a.getAttribute('href'));\n                if (target) target.scrollIntoView({ behavior: 'smooth' });\n            });\n        });\n\n        // --- Init ---\n        renderAllDiagrams();\n        renderAllMarkdown();\n    </script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":1,"oldLines":568,"newStart":1,"newLines":849,"lines":["-<!DOCTYPE html>\r","-<html lang=\"en\">\r","-<head>\r","-    <meta charset=\"UTF-8\">\r","-    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r","-    <title>{{ project_name }} - Documentation Export</title>\r","-    <script src=\"https://cdn.tailwindcss.com\"></script>\r","-    <script src=\"https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js\"></script>\r","-    <script src=\"https://cdn.jsdelivr.net/npm/marked@15/marked.min.js\"></script>\r","-    <style>\r","-        .diagram-card {\r","-            background: #1e293b;\r","-            border: 2px solid #334155;\r","-            border-radius: 8px;\r","-            overflow: hidden;\r","-            transition: border-color 0.2s, box-shadow 0.2s;\r","-        }\r","-        .diagram-card:hover {\r","-            border-color: #475569;\r","-            box-shadow: 0 0 0 1px #475569;\r","-        }\r","-        .diagram-header {\r","-            padding: 10px 16px;\r","-            border-bottom: 1px solid #334155;\r","-            display: flex;\r","-            align-items: center;\r","-            justify-content: space-between;\r","-            gap: 8px;\r","-        }\r","-        .diagram-body {\r","-            position: relative;\r","-            overflow: hidden;\r","-            background: #0f172a;\r","-            min-height: 200px;\r","-            max-height: 500px;\r","-        }\r","-        .diagram-viewport {\r","-            width: 100%;\r","-            height: 100%;\r","-            cursor: grab;\r","-            transform-origin: 0 0;\r","-            padding: 16px;\r","-        }\r","-        .diagram-viewport:active {\r","-            cursor: grabbing;\r","-        }\r","-        .diagram-viewport .mermaid svg {\r","-            max-width: none;\r","-        }\r","-        .diagram-viewport .mermaid svg .flowchart-link,\r","-        .diagram-viewport .mermaid svg .edge-pattern-dotted,\r","-        .diagram-viewport .mermaid svg path.path,\r","-        .diagram-viewport .mermaid svg path[class*=\"edge\"],\r","-        .diagram-viewport .mermaid svg line {\r","-            stroke-width: 2.5px !important;\r","-        }\r","-        .diagram-viewport .mermaid svg .edgeLabel,\r","-        .diagram-viewport .mermaid svg .nodeLabel,\r","-        .diagram-viewport .mermaid svg .label {\r","-            font-size: 14px !important;\r","-        }\r","-        .diagram-viewport .mermaid svg .edgeLabel {\r","-            font-size: 12px !important;\r","-        }\r","-        .diagram-viewport .mermaid svg marker path {\r","-            stroke-width: 1.5px !important;\r","-        }\r","-        .diagram-zoom-controls {\r","-            position: absolute;\r","-            bottom: 8px;\r","-            right: 8px;\r","-            display: flex;\r","-            gap: 4px;\r","-            z-index: 5;\r","-        }\r","-        .diagram-zoom-controls button {\r","-            width: 28px;\r","-            height: 28px;\r","-            border-radius: 4px;\r","-            background: #334155;\r","-            color: #e2e8f0;\r","-            border: 1px solid #475569;\r","-            cursor: pointer;\r","-            font-size: 0.875rem;\r","-            display: flex;\r","-            align-items: center;\r","-            justify-content: center;\r","-            opacity: 0.7;\r","-            transition: opacity 0.2s;\r","-        }\r","-        .diagram-zoom-controls button:hover {\r","-            opacity: 1;\r","-            background: #475569;\r","-        }\r","-        .badge {\r","-            font-size: 0.65rem;\r","-            padding: 2px 8px;\r","-            border-radius: 10px;\r","-            font-weight: 600;\r","-            text-transform: uppercase;\r","-            letter-spacing: 0.05em;\r","-        }\r","-        .badge-arch {\r","-            background: #1e3a5f;\r","-            color: #60a5fa;\r","-        }\r","-        .badge-tdd {\r","-            background: #422006;\r","-            color: #fbbf24;\r","-        }\r","-        .diagram-expand-btn {\r","-            width: 28px;\r","-            height: 28px;\r","-            border-radius: 4px;\r","-            background: transparent;\r","-            color: #94a3b8;\r","-            border: 1px solid transparent;\r","-            cursor: pointer;\r","-            font-size: 1rem;\r","-            display: flex;\r","-            align-items: center;\r","-            justify-content: center;\r","-            transition: all 0.15s;\r","-            flex-shrink: 0;\r","-        }\r","-        .diagram-expand-btn:hover {\r","-            background: #334155;\r","-            color: #e2e8f0;\r","-            border-color: #475569;\r","-        }\r","-        /* Requirements prose styling */\r","-        .requirements-content h1,\r","-        .requirements-content h2,\r","-        .requirements-content h3,\r","-        .requirements-content h4 {\r","-            color: #e2e8f0;\r","-            margin-top: 1.2em;\r","-            margin-bottom: 0.5em;\r","-            font-weight: 600;\r","-        }\r","-        .requirements-content h1 { font-size: 1.5rem; }\r","-        .requirements-content h2 { font-size: 1.25rem; }\r","-        .requirements-content h3 { font-size: 1.1rem; }\r","-        .requirements-content p {\r","-            color: #cbd5e1;\r","-            margin-bottom: 0.75em;\r","-            line-height: 1.6;\r","-        }\r","-        .requirements-content ul,\r","-        .requirements-content ol {\r","-            color: #cbd5e1;\r","-            margin-bottom: 0.75em;\r","-            padding-left: 1.5em;\r","-        }\r","-        .requirements-content li {\r","-            margin-bottom: 0.25em;\r","-        }\r","-        .requirements-content code {\r","-            background: #1e293b;\r","-            padding: 0.15em 0.4em;\r","-            border-radius: 4px;\r","-            font-size: 0.875em;\r","-            color: #f472b6;\r","-        }\r","-        .requirements-content pre {\r","-            background: #0f172a;\r","-            padding: 1em;\r","-            border-radius: 6px;\r","-            overflow-x: auto;\r","-            margin-bottom: 0.75em;\r","-        }\r","-        .requirements-content pre code {\r","-            background: transparent;\r","-            padding: 0;\r","-            color: #e2e8f0;\r","-        }\r","-        .requirements-content table {\r","-            width: 100%;\r","-            border-collapse: collapse;\r","-            margin-bottom: 0.75em;\r","-        }\r","-        .requirements-content th,\r","-        .requirements-content td {\r","-            border: 1px solid #334155;\r","-            padding: 0.5em 0.75em;\r","-            text-align: left;\r","-            color: #cbd5e1;\r","-        }\r","-        .requirements-content th {\r","-            background: #1e293b;\r","-            color: #e2e8f0;\r","-            font-weight: 600;\r","-        }\r","-        .requirements-content strong {\r","-            color: #e2e8f0;\r","-        }\r","-        .requirements-content a {\r","-            color: #60a5fa;\r","-        }\r","-        .requirements-content blockquote {\r","-            border-left: 3px solid #475569;\r","-            padding-left: 1em;\r","-            color: #94a3b8;\r","-            margin-bottom: 0.75em;\r","-        }\r","-    </style>\r","-</head>\r","-<body class=\"bg-gray-900 text-gray-100 min-h-screen\">\r","-    <!-- Header -->\r","-    <header class=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\r","-        <div class=\"max-w-7xl mx-auto flex items-center justify-between\">\r","-            <div class=\"flex items-center gap-3\">\r","-                <span class=\"text-green-400 font-semibold text-lg\">Vista Dashboard</span>\r","-                <span class=\"text-gray-600\">&middot;</span>\r","-                <span class=\"text-xl font-bold\">{{ project_name }}</span>\r","-            </div>\r","-            <span class=\"text-gray-400 text-sm\">Exported {{ export_date }}</span>\r","-        </div>\r","-    </header>\r","-\r","-    {% set all_sections = features|length + (ralph_jobs|default([])|length) %}\r","-    {% if all_sections > 1 %}\r","-    <nav class=\"bg-gray-800/50 border-b border-gray-700 px-6 py-2\">\r","-        <div class=\"max-w-7xl mx-auto flex gap-4 flex-wrap\">\r","-            {% for feature in features %}\r","-            <a href=\"#feature-{{ feature.name }}\"\r","-               class=\"text-sm text-gray-400 hover:text-gray-200 transition-colors capitalize\">\r","-                {{ feature.name | replace('_', ' ') }}\r","-            </a>\r","-            {% endfor %}\r","-            {% for job in ralph_jobs|default([]) %}\r","-            <a href=\"#ralph-{{ job.slug }}\"\r","-               class=\"text-sm text-gray-400 hover:text-gray-200 transition-colors\">\r","-                <span class=\"text-orange-400/70 text-xs mr-1\">ralph:</span>{{ job.slug | replace('-', ' ') }}\r","-            </a>\r","-            {% endfor %}\r","-        </div>\r","-    </nav>\r","-    {% endif %}\r","-\r","-    <main class=\"max-w-7xl mx-auto px-6 py-8\">\r","-        {% for feature in features %}\r","-        {% set fi = loop.index0 %}\r","-        <section id=\"feature-{{ feature.name }}\" class=\"mb-12\">\r","-            <h2 class=\"text-2xl font-bold mb-6 capitalize\">\r","-                {{ feature.name | replace('_', ' ') }}\r","-            </h2>\r","-\r","-            {% if feature.diagrams %}\r","-            <div class=\"space-y-6 mb-8\">\r","-                {% for diagram in feature.diagrams %}\r","-                {% set did = fi ~ '-' ~ loop.index0 %}\r","-                <div class=\"diagram-card\" data-idx=\"{{ did }}\">\r","-                    <div class=\"diagram-header\">\r","-                        <div class=\"flex items-center gap-2 flex-1 min-w-0\">\r","-                            <span class=\"font-semibold text-sm\">{{ diagram.name }}</span>\r","-                            <span class=\"badge {{ 'badge-tdd' if diagram.category == 'tdd' else 'badge-arch' }}\">\r","-                                {{ diagram.category or 'architecture' }}\r","-                            </span>\r","-                            {% if diagram.description %}\r","-                            <span class=\"text-gray-500 text-xs truncate hidden sm:inline\">\r","-                                {{ diagram.description }}\r","-                            </span>\r","-                            {% endif %}\r","-                        </div>\r","-                        <button onclick=\"expandDiagram(this)\" class=\"diagram-expand-btn\" title=\"Expand\">&#x26F6;</button>\r","-                    </div>\r","-                    <div class=\"diagram-body\">\r","-                        <div class=\"diagram-viewport\" id=\"viewport-{{ did }}\">\r","-                            <div class=\"mermaid-placeholder\" id=\"mermaid-{{ did }}\">\r","-                                Loading...\r","-                            </div>\r","-                        </div>\r","-                        <div class=\"diagram-zoom-controls\">\r","-                            <button onclick=\"zoomDiagram('{{ did }}', -0.2)\">&minus;</button>\r","-                            <button onclick=\"resetZoom('{{ did }}')\">1:1</button>\r","-                            <button onclick=\"zoomDiagram('{{ did }}', 0.2)\">+</button>\r","-                        </div>\r","-                    </div>\r","-                </div>\r","-                {% endfor %}\r","-            </div>\r","-            {% endif %}\r","-\r","-            {% if feature.requirements_md %}\r","-            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6\">\r","-                <h3 class=\"text-lg font-semibold mb-4\">Domain Requirements</h3>\r","-                <div class=\"requirements-content\"\r","-                     id=\"requirements-{{ feature.name }}\">\r","-                </div>\r","-            </div>\r","-            {% endif %}\r","-\r","-            {% if feature.implementation_plan_md %}\r","-            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mt-4\">\r","-                <h3 class=\"text-lg font-semibold mb-4\">Implementation Plan</h3>\r","-                <div class=\"requirements-content\"\r","-                     id=\"plan-{{ feature.name }}\">\r","-                </div>\r","-            </div>\r","-            {% endif %}\r","-\r","-            {% if feature.progress_md %}\r","-            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mt-4\">\r","-                <h3 class=\"text-lg font-semibold mb-4\">Progress Log</h3>\r","-                <pre class=\"text-sm text-gray-300 whitespace-pre-wrap leading-relaxed\"\r","-                     id=\"progress-{{ feature.name }}\"></pre>\r","-            </div>\r","-            {% endif %}\r","-\r","-            {% if feature.agents_md %}\r","-            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mt-4\">\r","-                <h3 class=\"text-lg font-semibold mb-4\">Agents</h3>\r","-                <div class=\"requirements-content\"\r","-                     id=\"agents-{{ feature.name }}\">\r","-                </div>\r","-            </div>\r","-            {% endif %}\r","-        </section>\r","-        {% endfor %}\r","-\r","-        {% for job in ralph_jobs|default([]) %}\r","-        <section id=\"ralph-{{ job.slug }}\" class=\"mb-12\">\r","-            <div class=\"flex items-center gap-3 mb-6\">\r","-                <span class=\"text-xs font-semibold uppercase tracking-wider text-orange-400 bg-orange-900/30 px-2 py-0.5 rounded\">Ralph Job</span>\r","-                <h2 class=\"text-2xl font-bold\">{{ job.slug | replace('-', ' ') }}</h2>\r","-            </div>\r","-\r","-            {% if job.task_md %}\r","-            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6\">\r","-                <h3 class=\"text-lg font-semibold mb-4\">Task</h3>\r","-                <div class=\"requirements-content\"\r","-                     id=\"ralph-task-{{ job.slug }}\">\r","-                </div>\r","-            </div>\r","-            {% endif %}\r","-\r","-            {% if job.plan_md %}\r","-            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mt-4\">\r","-                <h3 class=\"text-lg font-semibold mb-4\">Implementation Plan</h3>\r","-                <div class=\"requirements-content\"\r","-                     id=\"ralph-plan-{{ job.slug }}\">\r","-                </div>\r","-            </div>\r","-            {% endif %}\r","-\r","-            {% if job.progress_txt %}\r","-            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mt-4\">\r","-                <h3 class=\"text-lg font-semibold mb-4\">Progress Log</h3>\r","-                <pre class=\"text-sm text-gray-300 whitespace-pre-wrap leading-relaxed\"\r","-                     id=\"ralph-progress-{{ job.slug }}\"></pre>\r","-            </div>\r","-            {% endif %}\r","-        </section>\r","-        {% endfor %}\r","-    </main>\r","-\r","-    <!-- Modal Overlay -->\r","-    <div id=\"diagram-modal\" class=\"fixed inset-0 bg-black/80 z-50 hidden items-center justify-center\"\r","-         onclick=\"closeModal(event)\" style=\"display:none;\">\r","-        <div class=\"bg-gray-900 rounded-lg border border-gray-700 w-[95vw] h-[90vh] flex flex-col\"\r","-             onclick=\"event.stopPropagation()\">\r","-            <div class=\"flex items-center justify-between px-4 py-3 border-b border-gray-700\">\r","-                <span id=\"modal-title\" class=\"font-semibold\"></span>\r","-                <button onclick=\"closeModal()\" class=\"text-gray-400 hover:text-white text-xl\">&times;</button>\r","-            </div>\r","-            <div class=\"flex-1 overflow-auto p-4\" id=\"modal-content\"></div>\r","-        </div>\r","-    </div>\r","-\r","-    <!-- Data: embed diagram sources and requirements as JSON -->\r","-    <script id=\"export-data\" type=\"application/json\">\r","-        {{ export_data | tojson }}\r","-    </script>\r","-\r","-    <script>\r","-        // Parse embedded data\r","-        const EXPORT_DATA = JSON.parse(\r","-            document.getElementById('export-data').textContent\r","-        );\r","-\r","-        // --- Mermaid Init ---\r","-        mermaid.initialize({\r","-            startOnLoad: false,\r","-            theme: 'dark',\r","-            themeVariables: {\r","-                darkMode: true,\r","-                background: '#0f172a',\r","-                primaryColor: '#1e3a5f',\r","-                primaryTextColor: '#e2e8f0',\r","-                primaryBorderColor: '#475569',\r","-                lineColor: '#94a3b8',\r","-                secondaryColor: '#1a2332',\r","-                tertiaryColor: '#0f172a',\r","-                fontSize: '14px',\r","-            }\r","-        });\r","-\r","-        // --- Marked config ---\r","-        marked.setOptions({ breaks: true, gfm: true });\r","-\r","-        // --- Render all diagrams ---\r","-        let mermaidCounter = 0;\r","-\r","-        async function renderAllDiagrams() {\r","-            for (const item of EXPORT_DATA.diagrams) {\r","-                const el = document.getElementById(`mermaid-${item.id}`);\r","-                if (!el) continue;\r","-                try {\r","-                    const renderId = `mermaid-svg-export-${++mermaidCounter}`;\r","-                    const { svg } = await mermaid.render(renderId, item.content);\r","-                    el.innerHTML = svg;\r","-                    initViewport(item.id);\r","-                } catch (e) {\r","-                    el.innerHTML = `<pre class=\"text-yellow-400 text-xs whitespace-pre-wrap\">Mermaid parse error:\\n${e.message || e}\\n\\n${escapeHtml(item.content)}</pre>`;\r","-                    initViewport(item.id);\r","-                }\r","-            }\r","-        }\r","-\r","-        // --- Render all markdown content ---\r","-        function renderAllMarkdown() {\r","-            // Requirements\r","-            for (const [name, md] of Object.entries(EXPORT_DATA.requirements || {})) {\r","-                if (!md) continue;\r","-                const el = document.getElementById(`requirements-${name}`);\r","-                if (el) el.innerHTML = marked.parse(md);\r","-            }\r","-            // Implementation plans\r","-            for (const [name, md] of Object.entries(EXPORT_DATA.implementation_plans || {})) {\r","-                if (!md) continue;\r","-                const el = document.getElementById(`plan-${name}`);\r","-                if (el) el.innerHTML = marked.parse(md);\r","-            }\r","-            // Agents\r","-            for (const [name, md] of Object.entries(EXPORT_DATA.agents || {})) {\r","-                if (!md) continue;\r","-                const el = document.getElementById(`agents-${name}`);\r","-                if (el) el.innerHTML = marked.parse(md);\r","-            }\r","-            // Progress (plain text, not markdown)\r","-            for (const [name, text] of Object.entries(EXPORT_DATA.progress || {})) {\r","-                if (!text) continue;\r","-                const el = document.getElementById(`progress-${name}`);\r","-                if (el) el.textContent = text;\r","-            }\r","-            // Ralph tasks\r","-            for (const [slug, md] of Object.entries(EXPORT_DATA.ralph_tasks || {})) {\r","-                if (!md) continue;\r","-                const el = document.getElementById(`ralph-task-${slug}`);\r","-                if (el) el.innerHTML = marked.parse(md);\r","-            }\r","-            // Ralph plans\r","-            for (const [slug, md] of Object.entries(EXPORT_DATA.ralph_plans || {})) {\r","-                if (!md) continue;\r","-                const el = document.getElementById(`ralph-plan-${slug}`);\r","-                if (el) el.innerHTML = marked.parse(md);\r","-            }\r","-            // Ralph progress (plain text)\r","-            for (const [slug, text] of Object.entries(EXPORT_DATA.ralph_progress || {})) {\r","-                if (!text) continue;\r","-                const el = document.getElementById(`ralph-progress-${slug}`);\r","-                if (el) el.textContent = text;\r","-            }\r","-        }\r","-\r","-        // --- Pan/zoom ---\r","-        const viewportState = {};\r","-\r","-        function initViewport(idx) {\r","-            const vp = document.getElementById(`viewport-${idx}`);\r","-            if (!vp) return;\r","-            viewportState[idx] = { scale: 1, panX: 0, panY: 0, dragging: false, startX: 0, startY: 0 };\r","-            vp.addEventListener('wheel', (e) => {\r","-                e.preventDefault();\r","-                const delta = e.deltaY > 0 ? -0.1 : 0.1;\r","-                zoomDiagram(idx, delta);\r","-            }, { passive: false });\r","-            vp.addEventListener('mousedown', (e) => {\r","-                if (e.button !== 0) return;\r","-                const st = viewportState[idx];\r","-                st.dragging = true;\r","-                st.startX = e.clientX - st.panX;\r","-                st.startY = e.clientY - st.panY;\r","-                vp.style.cursor = 'grabbing';\r","-            });\r","-            vp.addEventListener('mousemove', (e) => {\r","-                const st = viewportState[idx];\r","-                if (!st.dragging) return;\r","-                st.panX = e.clientX - st.startX;\r","-                st.panY = e.clientY - st.startY;\r","-                applyTransform(idx);\r","-            });\r","-            const stopDrag = () => {\r","-                const st = viewportState[idx];\r","-                if (st) st.dragging = false;\r","-                vp.style.cursor = 'grab';\r","-            };\r","-            vp.addEventListener('mouseup', stopDrag);\r","-            vp.addEventListener('mouseleave', stopDrag);\r","-        }\r","-\r","-        function applyTransform(idx) {\r","-            const vp = document.getElementById(`viewport-${idx}`);\r","-            const st = viewportState[idx];\r","-            if (!vp || !st) return;\r","-            vp.style.transform = `translate(${st.panX}px, ${st.panY}px) scale(${st.scale})`;\r","-        }\r","-\r","-        function zoomDiagram(idx, delta) {\r","-            const st = viewportState[idx];\r","-            if (!st) return;\r","-            st.scale = Math.max(0.3, Math.min(3, st.scale + delta));\r","-            applyTransform(idx);\r","-        }\r","-\r","-        function resetZoom(idx) {\r","-            const st = viewportState[idx];\r","-            if (!st) return;\r","-            st.scale = 1; st.panX = 0; st.panY = 0;\r","-            applyTransform(idx);\r","-        }\r","-\r","-        // --- Modal expand/close ---\r","-        function expandDiagram(btn) {\r","-            const card = btn.closest('.diagram-card');\r","-            const viewport = card.querySelector('.diagram-viewport');\r","-            const title = card.querySelector('.diagram-header .font-semibold');\r","-            const modal = document.getElementById('diagram-modal');\r","-            const modalTitle = document.getElementById('modal-title');\r","-            const modalContent = document.getElementById('modal-content');\r","-\r","-            modalTitle.textContent = title ? title.textContent : 'Diagram';\r","-            modalContent.innerHTML = viewport.innerHTML;\r","-            modal.style.display = 'flex';\r","-        }\r","-\r","-        function closeModal(event) {\r","-            if (event && event.target !== event.currentTarget) return;\r","-            const modal = document.getElementById('diagram-modal');\r","-            modal.style.display = 'none';\r","-        }\r","-\r","-        // Close modal on Escape\r","-        document.addEventListener('keydown', (e) => {\r","-            if (e.key === 'Escape') closeModal();\r","-        });\r","-\r","-        function escapeHtml(str) {\r","-            if (!str) return '';\r","-            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\r","-        }\r","-\r","-        // --- Feature nav smooth scroll ---\r","-        document.querySelectorAll('nav a[href^=\"#\"]').forEach(a => {\r","-            a.addEventListener('click', (e) => {\r","-                e.preventDefault();\r","-                const target = document.querySelector(a.getAttribute('href'));\r","-                if (target) target.scrollIntoView({ behavior: 'smooth' });\r","-            });\r","-        });\r","-\r","-        // --- Init ---\r","-        renderAllDiagrams();\r","-        renderAllMarkdown();\r","-    </script>\r","-</body>\r","-</html>\r","+<!DOCTYPE html>","+<html lang=\"en\" data-theme=\"{{ default_theme|default('dark') }}\">","+<head>","+    <meta charset=\"UTF-8\">","+    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">","+    <title>{{ project_name }} - Documentation Export</title>","+    {% if offline|default(false) and vendor_deps|default({}) %}","+        {% if vendor_deps.tailwind_css %}","+        <style id=\"tailwind-inline\">{{ vendor_deps.tailwind_css }}</style>","+        {% endif %}","+        {% if vendor_deps.mermaid_js %}","+        <script>{{ vendor_deps.mermaid_js }}</script>","+        {% endif %}","+        {% if vendor_deps.marked_js %}","+        <script>{{ vendor_deps.marked_js }}</script>","+        {% endif %}","+    {% else %}","+    <script src=\"https://cdn.tailwindcss.com\"></script>","+    <script src=\"https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js\"></script>","+    <script src=\"https://cdn.jsdelivr.net/npm/marked@15/marked.min.js\"></script>","+    {% endif %}","+    <style>","+        /* === Theme custom properties === */","+        :root, [data-theme=\"dark\"] {","+            --bg-primary: #111827;","+            --bg-secondary: #1f2937;","+            --bg-tertiary: #0f172a;","+            --bg-card: #1e293b;","+            --bg-card-hover: #334155;","+            --border-color: #374151;","+            --border-card: #334155;","+            --text-primary: #f3f4f6;","+            --text-secondary: #e2e8f0;","+            --text-muted: #9ca3af;","+            --text-dim: #6b7280;","+            --accent-green: #4ade80;","+            --accent-blue: #60a5fa;","+            --accent-orange: #fb923c;","+            --code-bg: #1e293b;","+            --code-color: #f472b6;","+            --pre-bg: #0f172a;","+            --blockquote-border: #475569;","+            --blockquote-color: #94a3b8;","+            --table-header-bg: #1e293b;","+            --mermaid-bg: #0f172a;","+        }","+        [data-theme=\"light\"] {","+            --bg-primary: #f9fafb;","+            --bg-secondary: #ffffff;","+            --bg-tertiary: #f3f4f6;","+            --bg-card: #ffffff;","+            --bg-card-hover: #f3f4f6;","+            --border-color: #d1d5db;","+            --border-card: #e5e7eb;","+            --text-primary: #111827;","+            --text-secondary: #1f2937;","+            --text-muted: #6b7280;","+            --text-dim: #9ca3af;","+            --accent-green: #16a34a;","+            --accent-blue: #2563eb;","+            --accent-orange: #ea580c;","+            --code-bg: #f3f4f6;","+            --code-color: #be185d;","+            --pre-bg: #f3f4f6;","+            --blockquote-border: #d1d5db;","+            --blockquote-color: #6b7280;","+            --table-header-bg: #f3f4f6;","+            --mermaid-bg: #ffffff;","+        }","+","+        body {","+            background: var(--bg-primary);","+            color: var(--text-primary);","+            transition: background-color 0.2s, color 0.2s;","+        }","+","+        /* --- TOC Sidebar --- */","+        .toc-sidebar {","+            position: fixed;","+            top: 0;","+            left: -280px;","+            width: 280px;","+            height: 100vh;","+            background: var(--bg-secondary);","+            border-right: 1px solid var(--border-color);","+            z-index: 40;","+            transition: left 0.25s ease;","+            overflow-y: auto;","+            padding: 1rem;","+        }","+        .toc-sidebar.open {","+            left: 0;","+        }","+        .toc-sidebar a {","+            display: block;","+            padding: 0.375rem 0.75rem;","+            font-size: 0.875rem;","+            color: var(--text-muted);","+            border-radius: 0.25rem;","+            text-decoration: none;","+            transition: background-color 0.15s, color 0.15s;","+        }","+        .toc-sidebar a:hover {","+            background: var(--bg-tertiary);","+            color: var(--text-primary);","+        }","+        .toc-sidebar a.active {","+            background: var(--bg-tertiary);","+            color: var(--accent-blue);","+            font-weight: 600;","+        }","+        .toc-overlay {","+            position: fixed;","+            inset: 0;","+            background: rgba(0,0,0,0.3);","+            z-index: 39;","+            display: none;","+        }","+        .toc-overlay.open {","+            display: block;","+        }","+","+        /* --- Header bar --- */","+        .export-header {","+            background: var(--bg-secondary);","+            border-bottom: 1px solid var(--border-color);","+        }","+        .export-nav {","+            background: color-mix(in srgb, var(--bg-secondary) 50%, transparent);","+            border-bottom: 1px solid var(--border-color);","+        }","+","+        /* --- Cards --- */","+        .content-card {","+            background: var(--bg-secondary);","+            border: 1px solid var(--border-color);","+            border-radius: 0.5rem;","+            padding: 1.5rem;","+        }","+","+        .diagram-card {","+            background: var(--bg-card);","+            border: 2px solid var(--border-card);","+            border-radius: 8px;","+            overflow: hidden;","+            transition: border-color 0.2s, box-shadow 0.2s;","+        }","+        .diagram-card:hover {","+            border-color: var(--bg-card-hover);","+            box-shadow: 0 0 0 1px var(--bg-card-hover);","+        }","+        .diagram-header {","+            padding: 10px 16px;","+            border-bottom: 1px solid var(--border-card);","+            display: flex;","+            align-items: center;","+            justify-content: space-between;","+            gap: 8px;","+        }","+        .diagram-body {","+            position: relative;","+            overflow: hidden;","+            background: var(--mermaid-bg);","+            min-height: 200px;","+            max-height: 500px;","+        }","+        .diagram-viewport {","+            width: 100%;","+            height: 100%;","+            cursor: grab;","+            transform-origin: 0 0;","+            padding: 16px;","+        }","+        .diagram-viewport:active {","+            cursor: grabbing;","+        }","+        .diagram-viewport .mermaid svg {","+            max-width: none;","+        }","+        .diagram-viewport .mermaid svg .flowchart-link,","+        .diagram-viewport .mermaid svg .edge-pattern-dotted,","+        .diagram-viewport .mermaid svg path.path,","+        .diagram-viewport .mermaid svg path[class*=\"edge\"],","+        .diagram-viewport .mermaid svg line {","+            stroke-width: 2.5px !important;","+        }","+        .diagram-viewport .mermaid svg .edgeLabel,","+        .diagram-viewport .mermaid svg .nodeLabel,","+        .diagram-viewport .mermaid svg .label {","+            font-size: 14px !important;","+        }","+        .diagram-viewport .mermaid svg .edgeLabel {","+            font-size: 12px !important;","+        }","+        .diagram-viewport .mermaid svg marker path {","+            stroke-width: 1.5px !important;","+        }","+        .diagram-zoom-controls {","+            position: absolute;","+            bottom: 8px;","+            right: 8px;","+            display: flex;","+            gap: 4px;","+            z-index: 5;","+        }","+        .diagram-zoom-controls button {","+            width: 28px;","+            height: 28px;","+            border-radius: 4px;","+            background: var(--bg-card-hover);","+            color: var(--text-secondary);","+            border: 1px solid var(--border-card);","+            cursor: pointer;","+            font-size: 0.875rem;","+            display: flex;","+            align-items: center;","+            justify-content: center;","+            opacity: 0.7;","+            transition: opacity 0.2s;","+        }","+        .diagram-zoom-controls button:hover {","+            opacity: 1;","+        }","+        .badge {","+            font-size: 0.65rem;","+            padding: 2px 8px;","+            border-radius: 10px;","+            font-weight: 600;","+            text-transform: uppercase;","+            letter-spacing: 0.05em;","+        }","+        .badge-arch {","+            background: #1e3a5f;","+            color: #60a5fa;","+        }","+        .badge-tdd {","+            background: #422006;","+            color: #fbbf24;","+        }","+        .diagram-expand-btn {","+            width: 28px;","+            height: 28px;","+            border-radius: 4px;","+            background: transparent;","+            color: var(--text-muted);","+            border: 1px solid transparent;","+            cursor: pointer;","+            font-size: 1rem;","+            display: flex;","+            align-items: center;","+            justify-content: center;","+            transition: all 0.15s;","+            flex-shrink: 0;","+        }","+        .diagram-expand-btn:hover {","+            background: var(--bg-card-hover);","+            color: var(--text-secondary);","+            border-color: var(--border-card);","+        }","+        /* Requirements prose styling */","+        .requirements-content h1,","+        .requirements-content h2,","+        .requirements-content h3,","+        .requirements-content h4 {","+            color: var(--text-secondary);","+            margin-top: 1.2em;","+            margin-bottom: 0.5em;","+            font-weight: 600;","+        }","+        .requirements-content h1 { font-size: 1.5rem; }","+        .requirements-content h2 { font-size: 1.25rem; }","+        .requirements-content h3 { font-size: 1.1rem; }","+        .requirements-content p {","+            color: var(--text-muted);","+            margin-bottom: 0.75em;","+            line-height: 1.6;","+        }","+        .requirements-content ul,","+        .requirements-content ol {","+            color: var(--text-muted);","+            margin-bottom: 0.75em;","+            padding-left: 1.5em;","+        }","+        .requirements-content li {","+            margin-bottom: 0.25em;","+        }","+        .requirements-content code {","+            background: var(--code-bg);","+            padding: 0.15em 0.4em;","+            border-radius: 4px;","+            font-size: 0.875em;","+            color: var(--code-color);","+        }","+        .requirements-content pre {","+            background: var(--pre-bg);","+            padding: 1em;","+            border-radius: 6px;","+            overflow-x: auto;","+            margin-bottom: 0.75em;","+        }","+        .requirements-content pre code {","+            background: transparent;","+            padding: 0;","+            color: var(--text-secondary);","+        }","+        .requirements-content table {","+            width: 100%;","+            border-collapse: collapse;","+            margin-bottom: 0.75em;","+        }","+        .requirements-content th,","+        .requirements-content td {","+            border: 1px solid var(--border-card);","+            padding: 0.5em 0.75em;","+            text-align: left;","+            color: var(--text-muted);","+        }","+        .requirements-content th {","+            background: var(--table-header-bg);","+            color: var(--text-secondary);","+            font-weight: 600;","+        }","+        .requirements-content strong {","+            color: var(--text-secondary);","+        }","+        .requirements-content a {","+            color: var(--accent-blue);","+        }","+        .requirements-content blockquote {","+            border-left: 3px solid var(--blockquote-border);","+            padding-left: 1em;","+            color: var(--blockquote-color);","+            margin-bottom: 0.75em;","+        }","+","+        /* --- Theme toggle button --- */","+        .theme-toggle {","+            width: 32px;","+            height: 32px;","+            border-radius: 6px;","+            background: var(--bg-tertiary);","+            border: 1px solid var(--border-color);","+            color: var(--text-muted);","+            cursor: pointer;","+            display: flex;","+            align-items: center;","+            justify-content: center;","+            font-size: 1rem;","+            transition: all 0.15s;","+        }","+        .theme-toggle:hover {","+            color: var(--text-primary);","+            border-color: var(--text-muted);","+        }","+","+        /* --- TOC toggle button --- */","+        .toc-toggle {","+            width: 32px;","+            height: 32px;","+            border-radius: 6px;","+            background: var(--bg-tertiary);","+            border: 1px solid var(--border-color);","+            color: var(--text-muted);","+            cursor: pointer;","+            display: flex;","+            align-items: center;","+            justify-content: center;","+            font-size: 1rem;","+            transition: all 0.15s;","+        }","+        .toc-toggle:hover {","+            color: var(--text-primary);","+            border-color: var(--text-muted);","+        }","+","+        /* Progress pre */","+        .progress-pre {","+            color: var(--text-muted);","+            white-space: pre-wrap;","+            line-height: 1.625;","+            font-size: 0.875rem;","+        }","+    </style>","+</head>","+<body class=\"min-h-screen\">","+    <!-- TOC Sidebar -->","+    <div id=\"toc-overlay\" class=\"toc-overlay\" onclick=\"toggleToc()\"></div>","+    <aside id=\"toc-sidebar\" class=\"toc-sidebar\">","+        <div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;\">","+            <span style=\"font-weight:600;font-size:0.875rem;color:var(--text-primary);\">Table of Contents</span>","+            <button onclick=\"toggleToc()\" style=\"background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:1.25rem;\">&times;</button>","+        </div>","+        <nav id=\"toc-nav\">","+            {% for feature in features %}","+            <a href=\"#feature-{{ feature.name }}\" onclick=\"tocClick(event)\"","+               style=\"text-transform:capitalize;\">{{ feature.name | replace('_', ' ') }}</a>","+            {% endfor %}","+            {% for job in ralph_jobs|default([]) %}","+            <a href=\"#ralph-{{ job.slug }}\" onclick=\"tocClick(event)\">","+                <span style=\"color:var(--accent-orange);font-size:0.75rem;\">ralph:</span> {{ job.slug | replace('-', ' ') }}","+            </a>","+            {% endfor %}","+        </nav>","+    </aside>","+","+    <!-- Header -->","+    <header class=\"export-header\" style=\"padding:1rem 1.5rem;\">","+        <div style=\"max-width:80rem;margin:0 auto;display:flex;align-items:center;justify-content:space-between;\">","+            <div style=\"display:flex;align-items:center;gap:0.75rem;\">","+                <span style=\"color:var(--accent-green);font-weight:600;font-size:1.125rem;\">Vista Dashboard</span>","+                <span style=\"color:var(--text-dim);\">&middot;</span>","+                <span style=\"font-size:1.25rem;font-weight:700;\">{{ project_name }}</span>","+            </div>","+            <div style=\"display:flex;align-items:center;gap:0.5rem;\">","+                <span style=\"color:var(--text-muted);font-size:0.875rem;\">{{ export_date }}</span>","+                <button class=\"toc-toggle\" onclick=\"toggleToc()\" title=\"Table of Contents\">&#9776;</button>","+                <button class=\"theme-toggle\" onclick=\"toggleTheme()\" id=\"theme-btn\" title=\"Toggle theme\">&#9789;</button>","+            </div>","+        </div>","+    </header>","+","+    {% set all_sections = features|length + (ralph_jobs|default([])|length) %}","+    {% if all_sections > 1 %}","+    <nav class=\"export-nav\" style=\"padding:0.5rem 1.5rem;\">","+        <div style=\"max-width:80rem;margin:0 auto;display:flex;gap:1rem;flex-wrap:wrap;\">","+            {% for feature in features %}","+            <a href=\"#feature-{{ feature.name }}\"","+               style=\"font-size:0.875rem;color:var(--text-muted);text-decoration:none;text-transform:capitalize;transition:color 0.15s;\"","+               onmouseover=\"this.style.color='var(--text-secondary)'\" onmouseout=\"this.style.color='var(--text-muted)'\">","+                {{ feature.name | replace('_', ' ') }}","+            </a>","+            {% endfor %}","+            {% for job in ralph_jobs|default([]) %}","+            <a href=\"#ralph-{{ job.slug }}\"","+               style=\"font-size:0.875rem;color:var(--text-muted);text-decoration:none;transition:color 0.15s;\"","+               onmouseover=\"this.style.color='var(--text-secondary)'\" onmouseout=\"this.style.color='var(--text-muted)'\">","+                <span style=\"color:var(--accent-orange);opacity:0.7;font-size:0.75rem;margin-right:0.25rem;\">ralph:</span>{{ job.slug | replace('-', ' ') }}","+            </a>","+            {% endfor %}","+        </div>","+    </nav>","+    {% endif %}","+","+    <main style=\"max-width:80rem;margin:0 auto;padding:2rem 1.5rem;\">","+        {% for feature in features %}","+        {% set fi = loop.index0 %}","+        <section id=\"feature-{{ feature.name }}\" style=\"margin-bottom:3rem;\">","+            <h2 style=\"font-size:1.5rem;font-weight:700;margin-bottom:1.5rem;text-transform:capitalize;\">","+                {{ feature.name | replace('_', ' ') }}","+            </h2>","+","+            {% if feature.diagrams %}","+            <div style=\"display:flex;flex-direction:column;gap:1.5rem;margin-bottom:2rem;\">","+                {% for diagram in feature.diagrams %}","+                {% set did = fi ~ '-' ~ loop.index0 %}","+                <div class=\"diagram-card\" data-idx=\"{{ did }}\">","+                    <div class=\"diagram-header\">","+                        <div style=\"display:flex;align-items:center;gap:0.5rem;flex:1;min-width:0;\">","+                            <span style=\"font-weight:600;font-size:0.875rem;\">{{ diagram.name }}</span>","+                            <span class=\"badge {{ 'badge-tdd' if diagram.category == 'tdd' else 'badge-arch' }}\">","+                                {{ diagram.category or 'architecture' }}","+                            </span>","+                            {% if diagram.description %}","+                            <span style=\"color:var(--text-dim);font-size:0.75rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;\">","+                                {{ diagram.description }}","+                            </span>","+                            {% endif %}","+                        </div>","+                        <button onclick=\"expandDiagram(this)\" class=\"diagram-expand-btn\" title=\"Expand\">&#x26F6;</button>","+                    </div>","+                    <div class=\"diagram-body\">","+                        <div class=\"diagram-viewport\" id=\"viewport-{{ did }}\">","+                            <div class=\"mermaid-placeholder\" id=\"mermaid-{{ did }}\">","+                                Loading...","+                            </div>","+                        </div>","+                        <div class=\"diagram-zoom-controls\">","+                            <button onclick=\"zoomDiagram('{{ did }}', -0.2)\">&minus;</button>","+                            <button onclick=\"resetZoom('{{ did }}')\">1:1</button>","+                            <button onclick=\"zoomDiagram('{{ did }}', 0.2)\">+</button>","+                        </div>","+                    </div>","+                </div>","+                {% endfor %}","+            </div>","+            {% endif %}","+","+            {% if feature.requirements_md %}","+            <div class=\"content-card\">","+                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Domain Requirements</h3>","+                <div class=\"requirements-content\"","+                     id=\"requirements-{{ feature.name }}\">","+                </div>","+            </div>","+            {% endif %}","+","+            {% if feature.implementation_plan_md %}","+            <div class=\"content-card\" style=\"margin-top:1rem;\">","+                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Implementation Plan</h3>","+                <div class=\"requirements-content\"","+                     id=\"plan-{{ feature.name }}\">","+                </div>","+            </div>","+            {% endif %}","+","+            {% if feature.progress_md %}","+            <div class=\"content-card\" style=\"margin-top:1rem;\">","+                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Progress Log</h3>","+                <pre class=\"progress-pre\"","+                     id=\"progress-{{ feature.name }}\"></pre>","+            </div>","+            {% endif %}","+","+            {% if feature.agents_md %}","+            <div class=\"content-card\" style=\"margin-top:1rem;\">","+                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Agents</h3>","+                <div class=\"requirements-content\"","+                     id=\"agents-{{ feature.name }}\">","+                </div>","+            </div>","+            {% endif %}","+        </section>","+        {% endfor %}","+","+        {% for job in ralph_jobs|default([]) %}","+        <section id=\"ralph-{{ job.slug }}\" style=\"margin-bottom:3rem;\">","+            <div style=\"display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem;\">","+                <span style=\"font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent-orange);background:rgba(124,45,18,0.3);padding:0.125rem 0.5rem;border-radius:0.25rem;\">Ralph Job</span>","+                <h2 style=\"font-size:1.5rem;font-weight:700;\">{{ job.slug | replace('-', ' ') }}</h2>","+            </div>","+","+            {% if job.task_md %}","+            <div class=\"content-card\">","+                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Task</h3>","+                <div class=\"requirements-content\"","+                     id=\"ralph-task-{{ job.slug }}\">","+                </div>","+            </div>","+            {% endif %}","+","+            {% if job.plan_md %}","+            <div class=\"content-card\" style=\"margin-top:1rem;\">","+                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Implementation Plan</h3>","+                <div class=\"requirements-content\"","+                     id=\"ralph-plan-{{ job.slug }}\">","+                </div>","+            </div>","+            {% endif %}","+","+            {% if job.progress_txt %}","+            <div class=\"content-card\" style=\"margin-top:1rem;\">","+                <h3 style=\"font-size:1.125rem;font-weight:600;margin-bottom:1rem;\">Progress Log</h3>","+                <pre class=\"progress-pre\"","+                     id=\"ralph-progress-{{ job.slug }}\"></pre>","+            </div>","+            {% endif %}","+        </section>","+        {% endfor %}","+    </main>","+","+    <!-- Modal Overlay -->","+    <div id=\"diagram-modal\" style=\"position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:50;display:none;align-items:center;justify-content:center;\"","+         onclick=\"closeModal(event)\">","+        <div style=\"background:var(--bg-primary);border-radius:0.5rem;border:1px solid var(--border-color);width:95vw;height:90vh;display:flex;flex-direction:column;\"","+             onclick=\"event.stopPropagation()\">","+            <div style=\"display:flex;align-items:center;justify-content:space-between;padding:0.75rem 1rem;border-bottom:1px solid var(--border-color);\">","+                <span id=\"modal-title\" style=\"font-weight:600;\"></span>","+                <button onclick=\"closeModal()\" style=\"color:var(--text-muted);font-size:1.25rem;background:none;border:none;cursor:pointer;\">&times;</button>","+            </div>","+            <div style=\"flex:1;overflow:auto;padding:1rem;\" id=\"modal-content\"></div>","+        </div>","+    </div>","+","+    <!-- Data: embed diagram sources and requirements as JSON -->","+    <script id=\"export-data\" type=\"application/json\">","+        {{ export_data | tojson }}","+    </script>","+","+    <script>","+        // Parse embedded data","+        const EXPORT_DATA = JSON.parse(","+            document.getElementById('export-data').textContent","+        );","+","+        // --- Theme ---","+        function getTheme() {","+            return document.documentElement.getAttribute('data-theme') || 'dark';","+        }","+","+        function setTheme(theme) {","+            document.documentElement.setAttribute('data-theme', theme);","+            const btn = document.getElementById('theme-btn');","+            if (btn) btn.innerHTML = theme === 'dark' ? '&#9789;' : '&#9788;';","+        }","+","+        function toggleTheme() {","+            const current = getTheme();","+            const next = current === 'dark' ? 'light' : 'dark';","+            setTheme(next);","+            // Re-render mermaid with appropriate theme","+            reRenderMermaid(next);","+        }","+","+        // --- TOC ---","+        function toggleToc() {","+            const sidebar = document.getElementById('toc-sidebar');","+            const overlay = document.getElementById('toc-overlay');","+            sidebar.classList.toggle('open');","+            overlay.classList.toggle('open');","+        }","+","+        function tocClick(e) {","+            e.preventDefault();","+            const href = e.currentTarget.getAttribute('href');","+            const target = document.querySelector(href);","+            if (target) target.scrollIntoView({ behavior: 'smooth' });","+            toggleToc();","+        }","+","+        // --- Mermaid Init ---","+        function getMermaidTheme(theme) {","+            if (theme === 'light') {","+                return {","+                    theme: 'default',","+                    themeVariables: {","+                        darkMode: false,","+                        background: '#ffffff',","+                        primaryColor: '#dbeafe',","+                        primaryTextColor: '#111827',","+                        primaryBorderColor: '#93c5fd',","+                        lineColor: '#6b7280',","+                        secondaryColor: '#f3f4f6',","+                        tertiaryColor: '#f9fafb',","+                        fontSize: '14px',","+                    }","+                };","+            }","+            return {","+                theme: 'dark',","+                themeVariables: {","+                    darkMode: true,","+                    background: '#0f172a',","+                    primaryColor: '#1e3a5f',","+                    primaryTextColor: '#e2e8f0',","+                    primaryBorderColor: '#475569',","+                    lineColor: '#94a3b8',","+                    secondaryColor: '#1a2332',","+                    tertiaryColor: '#0f172a',","+                    fontSize: '14px',","+                }","+            };","+        }","+","+        const initialTheme = getTheme();","+        const mermaidConfig = getMermaidTheme(initialTheme);","+        mermaid.initialize({","+            startOnLoad: false,","+            ...mermaidConfig,","+        });","+","+        // Set initial theme icon","+        setTheme(initialTheme);","+","+        // --- Marked config ---","+        marked.setOptions({ breaks: true, gfm: true });","+","+        // --- Render all diagrams ---","+        let mermaidCounter = 0;","+","+        async function renderAllDiagrams() {","+            for (const item of EXPORT_DATA.diagrams) {","+                const el = document.getElementById(`mermaid-${item.id}`);","+                if (!el) continue;","+                try {","+                    const renderId = `mermaid-svg-export-${++mermaidCounter}`;","+                    const { svg } = await mermaid.render(renderId, item.content);","+                    el.innerHTML = svg;","+                    initViewport(item.id);","+                } catch (e) {","+                    el.innerHTML = `<pre style=\"color:#fbbf24;font-size:0.75rem;white-space:pre-wrap;\">Mermaid parse error:\\n${e.message || e}\\n\\n${escapeHtml(item.content)}</pre>`;","+                    initViewport(item.id);","+                }","+            }","+        }","+","+        async function reRenderMermaid(theme) {","+            const config = getMermaidTheme(theme);","+            mermaid.initialize({ startOnLoad: false, ...config });","+            for (const item of EXPORT_DATA.diagrams) {","+                const el = document.getElementById(`mermaid-${item.id}`);","+                if (!el) continue;","+                try {","+                    const renderId = `mermaid-svg-rerender-${++mermaidCounter}`;","+                    const { svg } = await mermaid.render(renderId, item.content);","+                    el.innerHTML = svg;","+                } catch (e) {","+                    // Keep existing render on error","+                }","+            }","+        }","+","+        // --- Render all markdown content ---","+        function renderAllMarkdown() {","+            // Requirements","+            for (const [name, md] of Object.entries(EXPORT_DATA.requirements || {})) {","+                if (!md) continue;","+                const el = document.getElementById(`requirements-${name}`);","+                if (el) el.innerHTML = marked.parse(md);","+            }","+            // Implementation plans","+            for (const [name, md] of Object.entries(EXPORT_DATA.implementation_plans || {})) {","+                if (!md) continue;","+                const el = document.getElementById(`plan-${name}`);","+                if (el) el.innerHTML = marked.parse(md);","+            }","+            // Agents","+            for (const [name, md] of Object.entries(EXPORT_DATA.agents || {})) {","+                if (!md) continue;","+                const el = document.getElementById(`agents-${name}`);","+                if (el) el.innerHTML = marked.parse(md);","+            }","+            // Progress (plain text, not markdown)","+            for (const [name, text] of Object.entries(EXPORT_DATA.progress || {})) {","+                if (!text) continue;","+                const el = document.getElementById(`progress-${name}`);","+                if (el) el.textContent = text;","+            }","+            // Ralph tasks","+            for (const [slug, md] of Object.entries(EXPORT_DATA.ralph_tasks || {})) {","+                if (!md) continue;","+                const el = document.getElementById(`ralph-task-${slug}`);","+                if (el) el.innerHTML = marked.parse(md);","+            }","+            // Ralph plans","+            for (const [slug, md] of Object.entries(EXPORT_DATA.ralph_plans || {})) {","+                if (!md) continue;","+                const el = document.getElementById(`ralph-plan-${slug}`);","+                if (el) el.innerHTML = marked.parse(md);","+            }","+            // Ralph progress (plain text)","+            for (const [slug, text] of Object.entries(EXPORT_DATA.ralph_progress || {})) {","+                if (!text) continue;","+                const el = document.getElementById(`ralph-progress-${slug}`);","+                if (el) el.textContent = text;","+            }","+        }","+","+        // --- Pan/zoom ---","+        const viewportState = {};","+","+        function initViewport(idx) {","+            const vp = document.getElementById(`viewport-${idx}`);","+            if (!vp) return;","+            viewportState[idx] = { scale: 1, panX: 0, panY: 0, dragging: false, startX: 0, startY: 0 };","+            vp.addEventListener('wheel', (e) => {","+                e.preventDefault();","+                const delta = e.deltaY > 0 ? -0.1 : 0.1;","+                zoomDiagram(idx, delta);","+            }, { passive: false });","+            vp.addEventListener('mousedown', (e) => {","+                if (e.button !== 0) return;","+                const st = viewportState[idx];","+                st.dragging = true;","+                st.startX = e.clientX - st.panX;","+                st.startY = e.clientY - st.panY;","+                vp.style.cursor = 'grabbing';","+            });","+            vp.addEventListener('mousemove', (e) => {","+                const st = viewportState[idx];","+                if (!st.dragging) return;","+                st.panX = e.clientX - st.startX;","+                st.panY = e.clientY - st.startY;","+                applyTransform(idx);","+            });","+            const stopDrag = () => {","+                const st = viewportState[idx];","+                if (st) st.dragging = false;","+                vp.style.cursor = 'grab';","+            };","+            vp.addEventListener('mouseup', stopDrag);","+            vp.addEventListener('mouseleave', stopDrag);","+        }","+","+        function applyTransform(idx) {","+            const vp = document.getElementById(`viewport-${idx}`);","+            const st = viewportState[idx];","+            if (!vp || !st) return;","+            vp.style.transform = `translate(${st.panX}px, ${st.panY}px) scale(${st.scale})`;","+        }","+","+        function zoomDiagram(idx, delta) {","+            const st = viewportState[idx];","+            if (!st) return;","+            st.scale = Math.max(0.3, Math.min(3, st.scale + delta));","+            applyTransform(idx);","+        }","+","+        function resetZoom(idx) {","+            const st = viewportState[idx];","+            if (!st) return;","+            st.scale = 1; st.panX = 0; st.panY = 0;","+            applyTransform(idx);","+        }","+","+        // --- Modal expand/close ---","+        function expandDiagram(btn) {","+            const card = btn.closest('.diagram-card');","+            const viewport = card.querySelector('.diagram-viewport');","+            const title = card.querySelector('.diagram-header .font-semibold') || card.querySelector('.diagram-header span');","+            const modal = document.getElementById('diagram-modal');","+            const modalTitle = document.getElementById('modal-title');","+            const modalContent = document.getElementById('modal-content');","+","+            modalTitle.textContent = title ? title.textContent : 'Diagram';","+            modalContent.innerHTML = viewport.innerHTML;","+            modal.style.display = 'flex';","+        }","+","+        function closeModal(event) {","+            if (event && event.target !== event.currentTarget) return;","+            const modal = document.getElementById('diagram-modal');","+            modal.style.display = 'none';","+        }","+","+        // Close modal on Escape","+        document.addEventListener('keydown', (e) => {","+            if (e.key === 'Escape') closeModal();","+        });","+","+        function escapeHtml(str) {","+            if (!str) return '';","+            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');","+        }","+","+        // --- Feature nav smooth scroll ---","+        document.querySelectorAll('nav a[href^=\"#\"]').forEach(a => {","+            a.addEventListener('click', (e) => {","+                e.preventDefault();","+                const target = document.querySelector(a.getAttribute('href'));","+                if (target) target.scrollIntoView({ behavior: 'smooth' });","+            });","+        });","+","+        // --- Init ---","+        renderAllDiagrams();","+        renderAllMarkdown();","+    </script>","+</body>","+</html>"]}],"originalFile":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>{{ project_name }} - Documentation Export</title>\r\n    <script src=\"https://cdn.tailwindcss.com\"></script>\r\n    <script src=\"https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js\"></script>\r\n    <script src=\"https://cdn.jsdelivr.net/npm/marked@15/marked.min.js\"></script>\r\n    <style>\r\n        .diagram-card {\r\n            background: #1e293b;\r\n            border: 2px solid #334155;\r\n            border-radius: 8px;\r\n            overflow: hidden;\r\n            transition: border-color 0.2s, box-shadow 0.2s;\r\n        }\r\n        .diagram-card:hover {\r\n            border-color: #475569;\r\n            box-shadow: 0 0 0 1px #475569;\r\n        }\r\n        .diagram-header {\r\n            padding: 10px 16px;\r\n            border-bottom: 1px solid #334155;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            gap: 8px;\r\n        }\r\n        .diagram-body {\r\n            position: relative;\r\n            overflow: hidden;\r\n            background: #0f172a;\r\n            min-height: 200px;\r\n            max-height: 500px;\r\n        }\r\n        .diagram-viewport {\r\n            width: 100%;\r\n            height: 100%;\r\n            cursor: grab;\r\n            transform-origin: 0 0;\r\n            padding: 16px;\r\n        }\r\n        .diagram-viewport:active {\r\n            cursor: grabbing;\r\n        }\r\n        .diagram-viewport .mermaid svg {\r\n            max-width: none;\r\n        }\r\n        .diagram-viewport .mermaid svg .flowchart-link,\r\n        .diagram-viewport .mermaid svg .edge-pattern-dotted,\r\n        .diagram-viewport .mermaid svg path.path,\r\n        .diagram-viewport .mermaid svg path[class*=\"edge\"],\r\n        .diagram-viewport .mermaid svg line {\r\n            stroke-width: 2.5px !important;\r\n        }\r\n        .diagram-viewport .mermaid svg .edgeLabel,\r\n        .diagram-viewport .mermaid svg .nodeLabel,\r\n        .diagram-viewport .mermaid svg .label {\r\n            font-size: 14px !important;\r\n        }\r\n        .diagram-viewport .mermaid svg .edgeLabel {\r\n            font-size: 12px !important;\r\n        }\r\n        .diagram-viewport .mermaid svg marker path {\r\n            stroke-width: 1.5px !important;\r\n        }\r\n        .diagram-zoom-controls {\r\n            position: absolute;\r\n            bottom: 8px;\r\n            right: 8px;\r\n            display: flex;\r\n            gap: 4px;\r\n            z-index: 5;\r\n        }\r\n        .diagram-zoom-controls button {\r\n            width: 28px;\r\n            height: 28px;\r\n            border-radius: 4px;\r\n            background: #334155;\r\n            color: #e2e8f0;\r\n            border: 1px solid #475569;\r\n            cursor: pointer;\r\n            font-size: 0.875rem;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            opacity: 0.7;\r\n            transition: opacity 0.2s;\r\n        }\r\n        .diagram-zoom-controls button:hover {\r\n            opacity: 1;\r\n            background: #475569;\r\n        }\r\n        .badge {\r\n            font-size: 0.65rem;\r\n            padding: 2px 8px;\r\n            border-radius: 10px;\r\n            font-weight: 600;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.05em;\r\n        }\r\n        .badge-arch {\r\n            background: #1e3a5f;\r\n            color: #60a5fa;\r\n        }\r\n        .badge-tdd {\r\n            background: #422006;\r\n            color: #fbbf24;\r\n        }\r\n        .diagram-expand-btn {\r\n            width: 28px;\r\n            height: 28px;\r\n            border-radius: 4px;\r\n            background: transparent;\r\n            color: #94a3b8;\r\n            border: 1px solid transparent;\r\n            cursor: pointer;\r\n            font-size: 1rem;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            transition: all 0.15s;\r\n            flex-shrink: 0;\r\n        }\r\n        .diagram-expand-btn:hover {\r\n            background: #334155;\r\n            color: #e2e8f0;\r\n            border-color: #475569;\r\n        }\r\n        /* Requirements prose styling */\r\n        .requirements-content h1,\r\n        .requirements-content h2,\r\n        .requirements-content h3,\r\n        .requirements-content h4 {\r\n            color: #e2e8f0;\r\n            margin-top: 1.2em;\r\n            margin-bottom: 0.5em;\r\n            font-weight: 600;\r\n        }\r\n        .requirements-content h1 { font-size: 1.5rem; }\r\n        .requirements-content h2 { font-size: 1.25rem; }\r\n        .requirements-content h3 { font-size: 1.1rem; }\r\n        .requirements-content p {\r\n            color: #cbd5e1;\r\n            margin-bottom: 0.75em;\r\n            line-height: 1.6;\r\n        }\r\n        .requirements-content ul,\r\n        .requirements-content ol {\r\n            color: #cbd5e1;\r\n            margin-bottom: 0.75em;\r\n            padding-left: 1.5em;\r\n        }\r\n        .requirements-content li {\r\n            margin-bottom: 0.25em;\r\n        }\r\n        .requirements-content code {\r\n            background: #1e293b;\r\n            padding: 0.15em 0.4em;\r\n            border-radius: 4px;\r\n            font-size: 0.875em;\r\n            color: #f472b6;\r\n        }\r\n        .requirements-content pre {\r\n            background: #0f172a;\r\n            padding: 1em;\r\n            border-radius: 6px;\r\n            overflow-x: auto;\r\n            margin-bottom: 0.75em;\r\n        }\r\n        .requirements-content pre code {\r\n            background: transparent;\r\n            padding: 0;\r\n            color: #e2e8f0;\r\n        }\r\n        .requirements-content table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin-bottom: 0.75em;\r\n        }\r\n        .requirements-content th,\r\n        .requirements-content td {\r\n            border: 1px solid #334155;\r\n            padding: 0.5em 0.75em;\r\n            text-align: left;\r\n            color: #cbd5e1;\r\n        }\r\n        .requirements-content th {\r\n            background: #1e293b;\r\n            color: #e2e8f0;\r\n            font-weight: 600;\r\n        }\r\n        .requirements-content strong {\r\n            color: #e2e8f0;\r\n        }\r\n        .requirements-content a {\r\n            color: #60a5fa;\r\n        }\r\n        .requirements-content blockquote {\r\n            border-left: 3px solid #475569;\r\n            padding-left: 1em;\r\n            color: #94a3b8;\r\n            margin-bottom: 0.75em;\r\n        }\r\n    </style>\r\n</head>\r\n<body class=\"bg-gray-900 text-gray-100 min-h-screen\">\r\n    <!-- Header -->\r\n    <header class=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\r\n        <div class=\"max-w-7xl mx-auto flex items-center justify-between\">\r\n            <div class=\"flex items-center gap-3\">\r\n                <span class=\"text-green-400 font-semibold text-lg\">Vista Dashboard</span>\r\n                <span class=\"text-gray-600\">&middot;</span>\r\n                <span class=\"text-xl font-bold\">{{ project_name }}</span>\r\n            </div>\r\n            <span class=\"text-gray-400 text-sm\">Exported {{ export_date }}</span>\r\n        </div>\r\n    </header>\r\n\r\n    {% set all_sections = features|length + (ralph_jobs|default([])|length) %}\r\n    {% if all_sections > 1 %}\r\n    <nav class=\"bg-gray-800/50 border-b border-gray-700 px-6 py-2\">\r\n        <div class=\"max-w-7xl mx-auto flex gap-4 flex-wrap\">\r\n            {% for feature in features %}\r\n            <a href=\"#feature-{{ feature.name }}\"\r\n               class=\"text-sm text-gray-400 hover:text-gray-200 transition-colors capitalize\">\r\n                {{ feature.name | replace('_', ' ') }}\r\n            </a>\r\n            {% endfor %}\r\n            {% for job in ralph_jobs|default([]) %}\r\n            <a href=\"#ralph-{{ job.slug }}\"\r\n               class=\"text-sm text-gray-400 hover:text-gray-200 transition-colors\">\r\n                <span class=\"text-orange-400/70 text-xs mr-1\">ralph:</span>{{ job.slug | replace('-', ' ') }}\r\n            </a>\r\n            {% endfor %}\r\n        </div>\r\n    </nav>\r\n    {% endif %}\r\n\r\n    <main class=\"max-w-7xl mx-auto px-6 py-8\">\r\n        {% for feature in features %}\r\n        {% set fi = loop.index0 %}\r\n        <section id=\"feature-{{ feature.name }}\" class=\"mb-12\">\r\n            <h2 class=\"text-2xl font-bold mb-6 capitalize\">\r\n                {{ feature.name | replace('_', ' ') }}\r\n            </h2>\r\n\r\n            {% if feature.diagrams %}\r\n            <div class=\"space-y-6 mb-8\">\r\n                {% for diagram in feature.diagrams %}\r\n                {% set did = fi ~ '-' ~ loop.index0 %}\r\n                <div class=\"diagram-card\" data-idx=\"{{ did }}\">\r\n                    <div class=\"diagram-header\">\r\n                        <div class=\"flex items-center gap-2 flex-1 min-w-0\">\r\n                            <span class=\"font-semibold text-sm\">{{ diagram.name }}</span>\r\n                            <span class=\"badge {{ 'badge-tdd' if diagram.category == 'tdd' else 'badge-arch' }}\">\r\n                                {{ diagram.category or 'architecture' }}\r\n                            </span>\r\n                            {% if diagram.description %}\r\n                            <span class=\"text-gray-500 text-xs truncate hidden sm:inline\">\r\n                                {{ diagram.description }}\r\n                            </span>\r\n                            {% endif %}\r\n                        </div>\r\n                        <button onclick=\"expandDiagram(this)\" class=\"diagram-expand-btn\" title=\"Expand\">&#x26F6;</button>\r\n                    </div>\r\n                    <div class=\"diagram-body\">\r\n                        <div class=\"diagram-viewport\" id=\"viewport-{{ did }}\">\r\n                            <div class=\"mermaid-placeholder\" id=\"mermaid-{{ did }}\">\r\n                                Loading...\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"diagram-zoom-controls\">\r\n                            <button onclick=\"zoomDiagram('{{ did }}', -0.2)\">&minus;</button>\r\n                            <button onclick=\"resetZoom('{{ did }}')\">1:1</button>\r\n                            <button onclick=\"zoomDiagram('{{ did }}', 0.2)\">+</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                {% endfor %}\r\n            </div>\r\n            {% endif %}\r\n\r\n            {% if feature.requirements_md %}\r\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6\">\r\n                <h3 class=\"text-lg font-semibold mb-4\">Domain Requirements</h3>\r\n                <div class=\"requirements-content\"\r\n                     id=\"requirements-{{ feature.name }}\">\r\n                </div>\r\n            </div>\r\n            {% endif %}\r\n\r\n            {% if feature.implementation_plan_md %}\r\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mt-4\">\r\n                <h3 class=\"text-lg font-semibold mb-4\">Implementation Plan</h3>\r\n                <div class=\"requirements-content\"\r\n                     id=\"plan-{{ feature.name }}\">\r\n                </div>\r\n            </div>\r\n            {% endif %}\r\n\r\n            {% if feature.progress_md %}\r\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mt-4\">\r\n                <h3 class=\"text-lg font-semibold mb-4\">Progress Log</h3>\r\n                <pre class=\"text-sm text-gray-300 whitespace-pre-wrap leading-relaxed\"\r\n                     id=\"progress-{{ feature.name }}\"></pre>\r\n            </div>\r\n            {% endif %}\r\n\r\n            {% if feature.agents_md %}\r\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mt-4\">\r\n                <h3 class=\"text-lg font-semibold mb-4\">Agents</h3>\r\n                <div class=\"requirements-content\"\r\n                     id=\"agents-{{ feature.name }}\">\r\n                </div>\r\n            </div>\r\n            {% endif %}\r\n        </section>\r\n        {% endfor %}\r\n\r\n        {% for job in ralph_jobs|default([]) %}\r\n        <section id=\"ralph-{{ job.slug }}\" class=\"mb-12\">\r\n            <div class=\"flex items-center gap-3 mb-6\">\r\n                <span class=\"text-xs font-semibold uppercase tracking-wider text-orange-400 bg-orange-900/30 px-2 py-0.5 rounded\">Ralph Job</span>\r\n                <h2 class=\"text-2xl font-bold\">{{ job.slug | replace('-', ' ') }}</h2>\r\n            </div>\r\n\r\n            {% if job.task_md %}\r\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6\">\r\n                <h3 class=\"text-lg font-semibold mb-4\">Task</h3>\r\n                <div class=\"requirements-content\"\r\n                     id=\"ralph-task-{{ job.slug }}\">\r\n                </div>\r\n            </div>\r\n            {% endif %}\r\n\r\n            {% if job.plan_md %}\r\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mt-4\">\r\n                <h3 class=\"text-lg font-semibold mb-4\">Implementation Plan</h3>\r\n                <div class=\"requirements-content\"\r\n                     id=\"ralph-plan-{{ job.slug }}\">\r\n                </div>\r\n            </div>\r\n            {% endif %}\r\n\r\n            {% if job.progress_txt %}\r\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mt-4\">\r\n                <h3 class=\"text-lg font-semibold mb-4\">Progress Log</h3>\r\n                <pre class=\"text-sm text-gray-300 whitespace-pre-wrap leading-relaxed\"\r\n                     id=\"ralph-progress-{{ job.slug }}\"></pre>\r\n            </div>\r\n            {% endif %}\r\n        </section>\r\n        {% endfor %}\r\n    </main>\r\n\r\n    <!-- Modal Overlay -->\r\n    <div id=\"diagram-modal\" class=\"fixed inset-0 bg-black/80 z-50 hidden items-center justify-center\"\r\n         onclick=\"closeModal(event)\" style=\"display:none;\">\r\n        <div class=\"bg-gray-900 rounded-lg border border-gray-700 w-[95vw] h-[90vh] flex flex-col\"\r\n             onclick=\"event.stopPropagation()\">\r\n            <div class=\"flex items-center justify-between px-4 py-3 border-b border-gray-700\">\r\n                <span id=\"modal-title\" class=\"font-semibold\"></span>\r\n                <button onclick=\"closeModal()\" class=\"text-gray-400 hover:text-white text-xl\">&times;</button>\r\n            </div>\r\n            <div class=\"flex-1 overflow-auto p-4\" id=\"modal-content\"></div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Data: embed diagram sources and requirements as JSON -->\r\n    <script id=\"export-data\" type=\"application/json\">\r\n        {{ export_data | tojson }}\r\n    </script>\r\n\r\n    <script>\r\n        // Parse embedded data\r\n        const EXPORT_DATA = JSON.parse(\r\n            document.getElementById('export-data').textContent\r\n        );\r\n\r\n        // --- Mermaid Init ---\r\n        mermaid.initialize({\r\n            startOnLoad: false,\r\n            theme: 'dark',\r\n            themeVariables: {\r\n                darkMode: true,\r\n                background: '#0f172a',\r\n                primaryColor: '#1e3a5f',\r\n                primaryTextColor: '#e2e8f0',\r\n                primaryBorderColor: '#475569',\r\n                lineColor: '#94a3b8',\r\n                secondaryColor: '#1a2332',\r\n                tertiaryColor: '#0f172a',\r\n                fontSize: '14px',\r\n            }\r\n        });\r\n\r\n        // --- Marked config ---\r\n        marked.setOptions({ breaks: true, gfm: true });\r\n\r\n        // --- Render all diagrams ---\r\n        let mermaidCounter = 0;\r\n\r\n        async function renderAllDiagrams() {\r\n            for (const item of EXPORT_DATA.diagrams) {\r\n                const el = document.getElementById(`mermaid-${item.id}`);\r\n                if (!el) continue;\r\n                try {\r\n                    const renderId = `mermaid-svg-export-${++mermaidCounter}`;\r\n                    const { svg } = await mermaid.render(renderId, item.content);\r\n                    el.innerHTML = svg;\r\n                    initViewport(item.id);\r\n                } catch (e) {\r\n                    el.innerHTML = `<pre class=\"text-yellow-400 text-xs whitespace-pre-wrap\">Mermaid parse error:\\n${e.message || e}\\n\\n${escapeHtml(item.content)}</pre>`;\r\n                    initViewport(item.id);\r\n                }\r\n            }\r\n        }\r\n\r\n        // --- Render all markdown content ---\r\n        function renderAllMarkdown() {\r\n            // Requirements\r\n            for (const [name, md] of Object.entries(EXPORT_DATA.requirements || {})) {\r\n                if (!md) continue;\r\n                const el = document.getElementById(`requirements-${name}`);\r\n                if (el) el.innerHTML = marked.parse(md);\r\n            }\r\n            // Implementation plans\r\n            for (const [name, md] of Object.entries(EXPORT_DATA.implementation_plans || {})) {\r\n                if (!md) continue;\r\n                const el = document.getElementById(`plan-${name}`);\r\n                if (el) el.innerHTML = marked.parse(md);\r\n            }\r\n            // Agents\r\n            for (const [name, md] of Object.entries(EXPORT_DATA.agents || {})) {\r\n                if (!md) continue;\r\n                const el = document.getElementById(`agents-${name}`);\r\n                if (el) el.innerHTML = marked.parse(md);\r\n            }\r\n            // Progress (plain text, not markdown)\r\n            for (const [name, text] of Object.entries(EXPORT_DATA.progress || {})) {\r\n                if (!text) continue;\r\n                const el = document.getElementById(`progress-${name}`);\r\n                if (el) el.textContent = text;\r\n            }\r\n            // Ralph tasks\r\n            for (const [slug, md] of Object.entries(EXPORT_DATA.ralph_tasks || {})) {\r\n                if (!md) continue;\r\n                const el = document.getElementById(`ralph-task-${slug}`);\r\n                if (el) el.innerHTML = marked.parse(md);\r\n            }\r\n            // Ralph plans\r\n            for (const [slug, md] of Object.entries(EXPORT_DATA.ralph_plans || {})) {\r\n                if (!md) continue;\r\n                const el = document.getElementById(`ralph-plan-${slug}`);\r\n                if (el) el.innerHTML = marked.parse(md);\r\n            }\r\n            // Ralph progress (plain text)\r\n            for (const [slug, text] of Object.entries(EXPORT_DATA.ralph_progress || {})) {\r\n                if (!text) continue;\r\n                const el = document.getElementById(`ralph-progress-${slug}`);\r\n                if (el) el.textContent = text;\r\n            }\r\n        }\r\n\r\n        // --- Pan/zoom ---\r\n        const viewportState = {};\r\n\r\n        function initViewport(idx) {\r\n            const vp = document.getElementById(`viewport-${idx}`);\r\n            if (!vp) return;\r\n            viewportState[idx] = { scale: 1, panX: 0, panY: 0, dragging: false, startX: 0, startY: 0 };\r\n            vp.addEventListener('wheel', (e) => {\r\n                e.preventDefault();\r\n                const delta = e.deltaY > 0 ? -0.1 : 0.1;\r\n                zoomDiagram(idx, delta);\r\n            }, { passive: false });\r\n            vp.addEventListener('mousedown', (e) => {\r\n                if (e.button !== 0) return;\r\n                const st = viewportState[idx];\r\n                st.dragging = true;\r\n                st.startX = e.clientX - st.panX;\r\n                st.startY = e.clientY - st.panY;\r\n                vp.style.cursor = 'grabbing';\r\n            });\r\n            vp.addEventListener('mousemove', (e) => {\r\n                const st = viewportState[idx];\r\n                if (!st.dragging) return;\r\n                st.panX = e.clientX - st.startX;\r\n                st.panY = e.clientY - st.startY;\r\n                applyTransform(idx);\r\n            });\r\n            const stopDrag = () => {\r\n                const st = viewportState[idx];\r\n                if (st) st.dragging = false;\r\n                vp.style.cursor = 'grab';\r\n            };\r\n            vp.addEventListener('mouseup', stopDrag);\r\n            vp.addEventListener('mouseleave', stopDrag);\r\n        }\r\n\r\n        function applyTransform(idx) {\r\n            const vp = document.getElementById(`viewport-${idx}`);\r\n            const st = viewportState[idx];\r\n            if (!vp || !st) return;\r\n            vp.style.transform = `translate(${st.panX}px, ${st.panY}px) scale(${st.scale})`;\r\n        }\r\n\r\n        function zoomDiagram(idx, delta) {\r\n            const st = viewportState[idx];\r\n            if (!st) return;\r\n            st.scale = Math.max(0.3, Math.min(3, st.scale + delta));\r\n            applyTransform(idx);\r\n        }\r\n\r\n        function resetZoom(idx) {\r\n            const st = viewportState[idx];\r\n            if (!st) return;\r\n            st.scale = 1; st.panX = 0; st.panY = 0;\r\n            applyTransform(idx);\r\n        }\r\n\r\n        // --- Modal expand/close ---\r\n        function expandDiagram(btn) {\r\n            const card = btn.closest('.diagram-card');\r\n            const viewport = card.querySelector('.diagram-viewport');\r\n            const title = card.querySelector('.diagram-header .font-semibold');\r\n            const modal = document.getElementById('diagram-modal');\r\n            const modalTitle = document.getElementById('modal-title');\r\n            const modalContent = document.getElementById('modal-content');\r\n\r\n            modalTitle.textContent = title ? title.textContent : 'Diagram';\r\n            modalContent.innerHTML = viewport.innerHTML;\r\n            modal.style.display = 'flex';\r\n        }\r\n\r\n        function closeModal(event) {\r\n            if (event && event.target !== event.currentTarget) return;\r\n            const modal = document.getElementById('diagram-modal');\r\n            modal.style.display = 'none';\r\n        }\r\n\r\n        // Close modal on Escape\r\n        document.addEventListener('keydown', (e) => {\r\n            if (e.key === 'Escape') closeModal();\r\n        });\r\n\r\n        function escapeHtml(str) {\r\n            if (!str) return '';\r\n            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\r\n        }\r\n\r\n        // --- Feature nav smooth scroll ---\r\n        document.querySelectorAll('nav a[href^=\"#\"]').forEach(a => {\r\n            a.addEventListener('click', (e) => {\r\n                e.preventDefault();\r\n                const target = document.querySelector(a.getAttribute('href'));\r\n                if (target) target.scrollIntoView({ behavior: 'smooth' });\r\n            });\r\n        });\r\n\r\n        // --- Init ---\r\n        renderAllDiagrams();\r\n        renderAllMarkdown();\r\n    </script>\r\n</body>\r\n</html>\r\n"}}
