{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0162pC1hYLpDphsd6WPzguZ4","type":"tool_result","content":"     1→\"\"\"Export routes for generating self-contained HTML documentation.\"\"\"\n     2→import logging\n     3→from datetime import datetime\n     4→\n     5→from fastapi import APIRouter, HTTPException\n     6→from fastapi.responses import Response\n     7→from pydantic import BaseModel\n     8→\n     9→from server.services.export_service import ExportService\n    10→from server.services.project_service import ProjectService\n    11→\n    12→logger = logging.getLogger(__name__)\n    13→router = APIRouter()\n    14→\n    15→\n    16→class ExportFeatureSelection(BaseModel):\n    17→    name: str\n    18→    diagrams: list[str] = []\n    19→    include_requirements: bool = True\n    20→    include_progress: bool = True\n    21→    include_agents: bool = True\n    22→    include_implementation_plan: bool = True\n    23→\n    24→\n    25→class ExportRequest(BaseModel):\n    26→    features: list[ExportFeatureSelection]\n    27→\n    28→\n    29→@router.get(\"/api/projects/{project_id}/export/features\")\n    30→async def get_export_features(project_id: str):\n    31→    \"\"\"Return the feature tree for the export modal checklist.\"\"\"\n    32→    project = ProjectService.get_by_id(project_id)\n    33→    if not project:\n    34→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    35→    return ExportService.get_exportable_features(project.path)\n    36→\n    37→\n    38→@router.post(\"/api/projects/{project_id}/export\")\n    39→async def export_documentation(project_id: str, body: ExportRequest):\n    40→    \"\"\"Generate and return the exported HTML documentation file.\"\"\"\n    41→    project = ProjectService.get_by_id(project_id)\n    42→    if not project:\n    43→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    44→\n    45→    html = ExportService.generate_export_html(\n    46→        project_name=project.name,\n    47→        project_path=project.path,\n    48→        selected_features=[f.model_dump() for f in body.features],\n    49→    )\n    50→\n    51→    filename = f\"{project.name}-docs-{datetime.now().strftime('%Y-%m-%d')}.html\"\n    52→\n    53→    return Response(\n    54→        content=html,\n    55→        media_type=\"text/html\",\n    56→        headers={\"Content-Disposition\": f'attachment; filename=\"{filename}\"'},\n    57→    )\n    58→"}]},"parent_tool_use_id":null,"session_id":"7816649e-26fc-4938-9512-2c8c95fbe878","uuid":"7c151a98-1916-4f07-acc4-80de31f959b7","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/routes/export.py","content":"\"\"\"Export routes for generating self-contained HTML documentation.\"\"\"\nimport logging\nfrom datetime import datetime\n\nfrom fastapi import APIRouter, HTTPException\nfrom fastapi.responses import Response\nfrom pydantic import BaseModel\n\nfrom server.services.export_service import ExportService\nfrom server.services.project_service import ProjectService\n\nlogger = logging.getLogger(__name__)\nrouter = APIRouter()\n\n\nclass ExportFeatureSelection(BaseModel):\n    name: str\n    diagrams: list[str] = []\n    include_requirements: bool = True\n    include_progress: bool = True\n    include_agents: bool = True\n    include_implementation_plan: bool = True\n\n\nclass ExportRequest(BaseModel):\n    features: list[ExportFeatureSelection]\n\n\n@router.get(\"/api/projects/{project_id}/export/features\")\nasync def get_export_features(project_id: str):\n    \"\"\"Return the feature tree for the export modal checklist.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n    return ExportService.get_exportable_features(project.path)\n\n\n@router.post(\"/api/projects/{project_id}/export\")\nasync def export_documentation(project_id: str, body: ExportRequest):\n    \"\"\"Generate and return the exported HTML documentation file.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    html = ExportService.generate_export_html(\n        project_name=project.name,\n        project_path=project.path,\n        selected_features=[f.model_dump() for f in body.features],\n    )\n\n    filename = f\"{project.name}-docs-{datetime.now().strftime('%Y-%m-%d')}.html\"\n\n    return Response(\n        content=html,\n        media_type=\"text/html\",\n        headers={\"Content-Disposition\": f'attachment; filename=\"{filename}\"'},\n    )\n","numLines":58,"startLine":1,"totalLines":58}}}
