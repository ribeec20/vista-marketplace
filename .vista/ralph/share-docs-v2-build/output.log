{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CtpYakkQC6WQ2kTESTksiS","type":"tool_result","content":"     1→\"\"\"Export routes for generating self-contained HTML documentation.\"\"\"\n     2→import logging\n     3→from datetime import datetime\n     4→\n     5→from fastapi import APIRouter, HTTPException\n     6→from fastapi.responses import Response\n     7→from pydantic import BaseModel\n     8→\n     9→from server.services.export_service import ExportService\n    10→from server.services.project_service import ProjectService\n    11→\n    12→logger = logging.getLogger(__name__)\n    13→router = APIRouter()\n    14→\n    15→\n    16→class ExportFeatureSelection(BaseModel):\n    17→    name: str\n    18→    diagrams: list[str] = []\n    19→    include_requirements: bool = True\n    20→    include_progress: bool = True\n    21→    include_agents: bool = True\n    22→    include_implementation_plan: bool = True\n    23→\n    24→\n    25→class ExportRalphJobSelection(BaseModel):\n    26→    slug: str\n    27→    include_task: bool = True\n    28→    include_plan: bool = True\n    29→    include_progress: bool = True\n    30→\n    31→\n    32→class ExportRequest(BaseModel):\n    33→    features: list[ExportFeatureSelection] = []\n    34→    ralph_jobs: list[ExportRalphJobSelection] = []\n    35→\n    36→\n    37→@router.get(\"/api/projects/{project_id}/export/features\")\n    38→async def get_export_features(project_id: str):\n    39→    \"\"\"Return the feature tree for the export modal checklist.\"\"\"\n    40→    project = ProjectService.get_by_id(project_id)\n    41→    if not project:\n    42→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    43→    return ExportService.get_exportable_features(project.path)\n    44→\n    45→\n    46→@router.get(\"/api/projects/{project_id}/export/ralph-jobs\")\n    47→async def get_export_ralph_jobs(project_id: str):\n    48→    \"\"\"Return Ralph jobs available for export.\"\"\"\n    49→    project = ProjectService.get_by_id(project_id)\n    50→    if not project:\n    51→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    52→    return ExportService.get_exportable_ralph_jobs(project.path)\n    53→\n    54→\n    55→@router.post(\"/api/projects/{project_id}/export\")\n    56→async def export_documentation(project_id: str, body: ExportRequest):\n    57→    \"\"\"Generate and return the exported HTML documentation file.\"\"\"\n    58→    project = ProjectService.get_by_id(project_id)\n    59→    if not project:\n    60→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    61→\n    62→    html = ExportService.generate_export_html(\n    63→        project_name=project.name,\n    64→        project_path=project.path,\n    65→        selected_features=[f.model_dump() for f in body.features],\n    66→        selected_ralph_jobs=[j.model_dump() for j in body.ralph_jobs],\n    67→    )\n    68→\n    69→    filename = f\"{project.name}-docs-{datetime.now().strftime('%Y-%m-%d')}.html\"\n    70→\n    71→    return Response(\n    72→        content=html,\n    73→        media_type=\"text/html\",\n    74→        headers={\"Content-Disposition\": f'attachment; filename=\"{filename}\"'},\n    75→    )\n    76→"}]},"parent_tool_use_id":null,"session_id":"6996de78-f515-44c4-bca3-90f28086b3f0","uuid":"611b116c-bd70-41a7-a3c3-ec23bca20875","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/routes/export.py","content":"\"\"\"Export routes for generating self-contained HTML documentation.\"\"\"\nimport logging\nfrom datetime import datetime\n\nfrom fastapi import APIRouter, HTTPException\nfrom fastapi.responses import Response\nfrom pydantic import BaseModel\n\nfrom server.services.export_service import ExportService\nfrom server.services.project_service import ProjectService\n\nlogger = logging.getLogger(__name__)\nrouter = APIRouter()\n\n\nclass ExportFeatureSelection(BaseModel):\n    name: str\n    diagrams: list[str] = []\n    include_requirements: bool = True\n    include_progress: bool = True\n    include_agents: bool = True\n    include_implementation_plan: bool = True\n\n\nclass ExportRalphJobSelection(BaseModel):\n    slug: str\n    include_task: bool = True\n    include_plan: bool = True\n    include_progress: bool = True\n\n\nclass ExportRequest(BaseModel):\n    features: list[ExportFeatureSelection] = []\n    ralph_jobs: list[ExportRalphJobSelection] = []\n\n\n@router.get(\"/api/projects/{project_id}/export/features\")\nasync def get_export_features(project_id: str):\n    \"\"\"Return the feature tree for the export modal checklist.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n    return ExportService.get_exportable_features(project.path)\n\n\n@router.get(\"/api/projects/{project_id}/export/ralph-jobs\")\nasync def get_export_ralph_jobs(project_id: str):\n    \"\"\"Return Ralph jobs available for export.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n    return ExportService.get_exportable_ralph_jobs(project.path)\n\n\n@router.post(\"/api/projects/{project_id}/export\")\nasync def export_documentation(project_id: str, body: ExportRequest):\n    \"\"\"Generate and return the exported HTML documentation file.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    html = ExportService.generate_export_html(\n        project_name=project.name,\n        project_path=project.path,\n        selected_features=[f.model_dump() for f in body.features],\n        selected_ralph_jobs=[j.model_dump() for j in body.ralph_jobs],\n    )\n\n    filename = f\"{project.name}-docs-{datetime.now().strftime('%Y-%m-%d')}.html\"\n\n    return Response(\n        content=html,\n        media_type=\"text/html\",\n        headers={\"Content-Disposition\": f'attachment; filename=\"{filename}\"'},\n    )\n","numLines":76,"startLine":1,"totalLines":76}}}
