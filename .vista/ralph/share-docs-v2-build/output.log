{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M6UcmCTq5y4S7MJ46nG1oq","type":"tool_result","content":"   400→    const resp = await fetch(`/api/projects/${projectId}`, {method: 'DELETE'});\n   401→    if (!resp.ok) {\n   402→        const data = await resp.json().catch(() => ({}));\n   403→        alert(data.detail || 'Failed to remove project');\n   404→        return;\n   405→    }\n   406→    window.location.href = '/';\n   407→}\n   408→\n   409→// =========================================================================\n   410→// Export Modal\n   411→// =========================================================================\n   412→\n   413→let exportFeatures = [];\n   414→\n   415→async function openExportModal() {\n   416→    const modal = document.getElementById('export-modal');\n   417→    const tree = document.getElementById('export-tree');\n   418→    modal.classList.remove('hidden');\n   419→    tree.innerHTML = '<div class=\"text-gray-500 text-center py-8\">Loading features...</div>';\n   420→\n   421→    try {\n   422→        const resp = await fetch(`/api/projects/${PROJECT_ID}/export/features`);\n   423→        if (!resp.ok) throw new Error('Failed to load features');\n   424→        exportFeatures = await resp.json();\n   425→\n   426→        if (exportFeatures.length === 0) {\n   427→            tree.innerHTML = '<div class=\"text-gray-500 text-center py-8\">No exportable features found</div>';\n   428→            return;\n   429→        }\n   430→        renderExportTree();\n   431→    } catch (err) {\n   432→        tree.innerHTML = `<div class=\"text-red-400 text-center py-8\">${escapeHtmlExport(err.message)}</div>`;\n   433→    }\n   434→}\n   435→\n   436→function closeExportModal() {\n   437→    document.getElementById('export-modal').classList.add('hidden');\n   438→}\n   439→\n   440→function renderExportTree() {\n   441→    const tree = document.getElementById('export-tree');\n   442→    tree.innerHTML = exportFeatures.map((feature, fi) => {\n   443→        const diagrams = feature.diagrams || [];\n   444→        return `\n   445→            <div class=\"mb-3\">\n   446→                <div class=\"flex items-center gap-2 mb-1\">\n   447→                    <button onclick=\"toggleFeatureExpand(${fi})\"\n   448→                            class=\"text-gray-400 hover:text-gray-200 text-xs w-5 text-center\"\n   449→                            id=\"expand-btn-${fi}\">\\u25B6</button>\n   450→                    <label class=\"flex items-center gap-2 cursor-pointer flex-1\">\n   451→                        <input type=\"checkbox\" class=\"feature-cb\" data-fi=\"${fi}\"\n   452→                               onchange=\"onFeatureToggle(${fi})\" checked>\n   453→                        <span class=\"text-sm font-medium\">${escapeHtmlExport(feature.name)}</span>\n   454→                        <span class=\"text-xs text-gray-500\">${diagrams.length} diagram${diagrams.length !== 1 ? 's' : ''}</span>\n   455→                        ${feature.has_requirements ? '<span class=\"text-xs text-green-600\">+ requirements</span>' : ''}\n   456→                    </label>\n   457→                </div>\n   458→                <div id=\"diagrams-${fi}\" class=\"ml-7 hidden space-y-1\">\n   459→                    ${diagrams.map((d, di) => `\n   460→                        <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n   461→                            <input type=\"checkbox\" class=\"diagram-cb\" data-fi=\"${fi}\" data-di=\"${di}\" checked\n   462→                                   onchange=\"onDiagramToggle(${fi})\">\n   463→                            <span class=\"text-xs text-gray-300\">${escapeHtmlExport(d.name)}</span>\n   464→                            <span class=\"text-xs text-gray-600 truncate\">${escapeHtmlExport(d.description || '')}</span>\n   465→                        </label>\n   466→                    `).join('')}\n   467→                </div>\n   468→            </div>\n   469→        `;\n   470→    }).join('');\n   471→    updateDownloadButton();\n   472→}\n   473→\n   474→function toggleFeatureExpand(fi) {\n   475→    const el = document.getElementById(`diagrams-${fi}`);\n   476→    const btn = document.getElementById(`expand-btn-${fi}`);\n   477→    if (el.classList.contains('hidden')) {\n   478→        el.classList.remove('hidden');\n   479→        btn.textContent = '\\u25BC';\n   480→    } else {\n   481→        el.classList.add('hidden');\n   482→        btn.textContent = '\\u25B6';\n   483→    }\n   484→}\n   485→\n   486→function onFeatureToggle(fi) {\n   487→    const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n   488→    const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]`);\n   489→    diagramCbs.forEach(cb => cb.checked = featureCb.checked);\n   490→    updateDownloadButton();\n   491→}\n   492→\n   493→function onDiagramToggle(fi) {\n   494→    const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n   495→    const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]`);\n   496→    const checked = [...diagramCbs].filter(cb => cb.checked).length;\n   497→    featureCb.checked = checked > 0;\n   498→    featureCb.indeterminate = checked > 0 && checked < diagramCbs.length;\n   499→    updateDownloadButton();\n   500→}\n   501→\n   502→function selectAllExport(select) {\n   503→    document.querySelectorAll('.feature-cb, .diagram-cb').forEach(cb => {\n   504→        cb.checked = select;\n   505→        cb.indeterminate = false;\n   506→    });\n   507→    updateDownloadButton();\n   508→}\n   509→\n   510→function updateDownloadButton() {\n   511→    const anySelected = document.querySelectorAll('.feature-cb:checked').length > 0;\n   512→    document.getElementById('export-download-btn').disabled = !anySelected;\n   513→}\n   514→\n   515→function collectSelectedFeatures() {\n   516→    return exportFeatures.map((feature, fi) => {\n   517→        const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n   518→        if (!featureCb.checked && !featureCb.indeterminate) return null;\n   519→\n   520→        const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]:checked`);\n   521→        const selectedDiagrams = [...diagramCbs].map(cb => {\n   522→            const di = parseInt(cb.dataset.di);\n   523→            return feature.diagrams[di].file;\n   524→        });\n   525→\n   526→        return { name: feature.name, diagrams: selectedDiagrams };\n   527→    }).filter(Boolean);\n   528→}\n   529→\n   530→async function startExport() {\n   531→    const btn = document.getElementById('export-download-btn');\n   532→    const origText = btn.textContent;\n   533→    btn.disabled = true;\n   534→    btn.textContent = 'Generating...';\n   535→\n   536→    const selected = collectSelectedFeatures();\n   537→\n   538→    try {\n   539→        const resp = await fetch(`/api/projects/${PROJECT_ID}/export`, {\n   540→            method: 'POST',\n   541→            headers: { 'Content-Type': 'application/json' },\n   542→            body: JSON.stringify({ features: selected }),\n   543→        });\n   544→\n   545→        if (!resp.ok) throw new Error('Export failed');\n   546→\n   547→        const blob = await resp.blob();\n   548→        const url = URL.createObjectURL(blob);\n   549→        const a = document.createElement('a');\n   550→        a.href = url;\n   551→        a.download = resp.headers.get('Content-Disposition')\n   552→            ?.match(/filename=\"(.+?)\"/)?.[1] || 'export.html';\n   553→        document.body.appendChild(a);\n   554→        a.click();\n   555→        a.remove();\n   556→        URL.revokeObjectURL(url);\n   557→\n   558→        closeExportModal();\n   559→    } catch (err) {\n   560→        alert('Export failed: ' + err.message);\n   561→    } finally {\n   562→        btn.disabled = false;\n   563→        btn.textContent = origText;\n   564→    }\n   565→}\n   566→\n   567→function escapeHtmlExport(str) {\n   568→    if (!str) return '';\n   569→    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n   570→}\n   571→</script>\n   572→{% endblock %}\n   573→"}]},"parent_tool_use_id":null,"session_id":"9de84d10-e2ff-4976-8ef7-e25fd15568bb","uuid":"c986061d-afa9-47d0-abef-cce8d796d836","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Grove\\OneDrive\\Documents\\PYTHON\\claude_plugins\\vista-expanded-visualization\\vista\\server\\views\\project.html","content":"    const resp = await fetch(`/api/projects/${projectId}`, {method: 'DELETE'});\n    if (!resp.ok) {\n        const data = await resp.json().catch(() => ({}));\n        alert(data.detail || 'Failed to remove project');\n        return;\n    }\n    window.location.href = '/';\n}\n\n// =========================================================================\n// Export Modal\n// =========================================================================\n\nlet exportFeatures = [];\n\nasync function openExportModal() {\n    const modal = document.getElementById('export-modal');\n    const tree = document.getElementById('export-tree');\n    modal.classList.remove('hidden');\n    tree.innerHTML = '<div class=\"text-gray-500 text-center py-8\">Loading features...</div>';\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/export/features`);\n        if (!resp.ok) throw new Error('Failed to load features');\n        exportFeatures = await resp.json();\n\n        if (exportFeatures.length === 0) {\n            tree.innerHTML = '<div class=\"text-gray-500 text-center py-8\">No exportable features found</div>';\n            return;\n        }\n        renderExportTree();\n    } catch (err) {\n        tree.innerHTML = `<div class=\"text-red-400 text-center py-8\">${escapeHtmlExport(err.message)}</div>`;\n    }\n}\n\nfunction closeExportModal() {\n    document.getElementById('export-modal').classList.add('hidden');\n}\n\nfunction renderExportTree() {\n    const tree = document.getElementById('export-tree');\n    tree.innerHTML = exportFeatures.map((feature, fi) => {\n        const diagrams = feature.diagrams || [];\n        return `\n            <div class=\"mb-3\">\n                <div class=\"flex items-center gap-2 mb-1\">\n                    <button onclick=\"toggleFeatureExpand(${fi})\"\n                            class=\"text-gray-400 hover:text-gray-200 text-xs w-5 text-center\"\n                            id=\"expand-btn-${fi}\">\\u25B6</button>\n                    <label class=\"flex items-center gap-2 cursor-pointer flex-1\">\n                        <input type=\"checkbox\" class=\"feature-cb\" data-fi=\"${fi}\"\n                               onchange=\"onFeatureToggle(${fi})\" checked>\n                        <span class=\"text-sm font-medium\">${escapeHtmlExport(feature.name)}</span>\n                        <span class=\"text-xs text-gray-500\">${diagrams.length} diagram${diagrams.length !== 1 ? 's' : ''}</span>\n                        ${feature.has_requirements ? '<span class=\"text-xs text-green-600\">+ requirements</span>' : ''}\n                    </label>\n                </div>\n                <div id=\"diagrams-${fi}\" class=\"ml-7 hidden space-y-1\">\n                    ${diagrams.map((d, di) => `\n                        <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n                            <input type=\"checkbox\" class=\"diagram-cb\" data-fi=\"${fi}\" data-di=\"${di}\" checked\n                                   onchange=\"onDiagramToggle(${fi})\">\n                            <span class=\"text-xs text-gray-300\">${escapeHtmlExport(d.name)}</span>\n                            <span class=\"text-xs text-gray-600 truncate\">${escapeHtmlExport(d.description || '')}</span>\n                        </label>\n                    `).join('')}\n                </div>\n            </div>\n        `;\n    }).join('');\n    updateDownloadButton();\n}\n\nfunction toggleFeatureExpand(fi) {\n    const el = document.getElementById(`diagrams-${fi}`);\n    const btn = document.getElementById(`expand-btn-${fi}`);\n    if (el.classList.contains('hidden')) {\n        el.classList.remove('hidden');\n        btn.textContent = '\\u25BC';\n    } else {\n        el.classList.add('hidden');\n        btn.textContent = '\\u25B6';\n    }\n}\n\nfunction onFeatureToggle(fi) {\n    const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n    const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]`);\n    diagramCbs.forEach(cb => cb.checked = featureCb.checked);\n    updateDownloadButton();\n}\n\nfunction onDiagramToggle(fi) {\n    const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n    const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]`);\n    const checked = [...diagramCbs].filter(cb => cb.checked).length;\n    featureCb.checked = checked > 0;\n    featureCb.indeterminate = checked > 0 && checked < diagramCbs.length;\n    updateDownloadButton();\n}\n\nfunction selectAllExport(select) {\n    document.querySelectorAll('.feature-cb, .diagram-cb').forEach(cb => {\n        cb.checked = select;\n        cb.indeterminate = false;\n    });\n    updateDownloadButton();\n}\n\nfunction updateDownloadButton() {\n    const anySelected = document.querySelectorAll('.feature-cb:checked').length > 0;\n    document.getElementById('export-download-btn').disabled = !anySelected;\n}\n\nfunction collectSelectedFeatures() {\n    return exportFeatures.map((feature, fi) => {\n        const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n        if (!featureCb.checked && !featureCb.indeterminate) return null;\n\n        const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]:checked`);\n        const selectedDiagrams = [...diagramCbs].map(cb => {\n            const di = parseInt(cb.dataset.di);\n            return feature.diagrams[di].file;\n        });\n\n        return { name: feature.name, diagrams: selectedDiagrams };\n    }).filter(Boolean);\n}\n\nasync function startExport() {\n    const btn = document.getElementById('export-download-btn');\n    const origText = btn.textContent;\n    btn.disabled = true;\n    btn.textContent = 'Generating...';\n\n    const selected = collectSelectedFeatures();\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/export`, {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ features: selected }),\n        });\n\n        if (!resp.ok) throw new Error('Export failed');\n\n        const blob = await resp.blob();\n        const url = URL.createObjectURL(blob);\n        const a = document.createElement('a');\n        a.href = url;\n        a.download = resp.headers.get('Content-Disposition')\n            ?.match(/filename=\"(.+?)\"/)?.[1] || 'export.html';\n        document.body.appendChild(a);\n        a.click();\n        a.remove();\n        URL.revokeObjectURL(url);\n\n        closeExportModal();\n    } catch (err) {\n        alert('Export failed: ' + err.message);\n    } finally {\n        btn.disabled = false;\n        btn.textContent = origText;\n    }\n}\n\nfunction escapeHtmlExport(str) {\n    if (!str) return '';\n    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n}\n</script>\n{% endblock %}\n","numLines":174,"startLine":400,"totalLines":573}}}
