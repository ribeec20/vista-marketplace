nter py-0.5\">","+                                <input type=\"checkbox\" class=\"ralph-content-cb\" data-ri=\"${ri}\" data-type=\"task\" checked>","+                                <span class=\"text-xs text-orange-400\">Task Description</span>","+                            </label>` : ''}","+                        ${job.has_plan ? `","+                            <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">","+                                <input type=\"checkbox\" class=\"ralph-content-cb\" data-ri=\"${ri}\" data-type=\"plan\" checked>","+                                <span class=\"text-xs text-blue-500\">Implementation Plan</span>","+                            </label>` : ''}","+                        ${job.has_progress ? `","+                            <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">","+                                <input type=\"checkbox\" class=\"ralph-content-cb\" data-ri=\"${ri}\" data-type=\"progress\" checked>","+                                <span class=\"text-xs text-yellow-500\">Progress Log</span>","+                            </label>` : ''}","+                    </div>","                 </div>","-            </div>","-        `;","-    }).join('');","+            `;","+        }).join('');","+    }","+","+    tree.innerHTML = html;","     updateDownloadButton();"," }"," ","+function toggleRalphExpand(ri) {","+    const el = document.getElementById(`ralph-items-${ri}`);","+    const btn = document.getElementById(`ralph-expand-btn-${ri}`);","+    if (el.classList.contains('hidden')) {","+        el.classList.remove('hidden');","+        btn.textContent = '\\u25BC';","+    } else {","+        el.classList.add('hidden');","+        btn.textContent = '\\u25B6';","+    }","+}","+"," function toggleFeatureExpand(fi) {","     const el = document.getElementById(`diagrams-${fi}`);","     const btn = document.getElementById(`expand-btn-${fi}`);"]}],"userModified":false,"replaceAll":false}}
