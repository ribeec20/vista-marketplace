→            <h3 class=\"font-semibold\">Export Documentation</h3>\n   220→            <button onclick=\"closeExportModal()\" class=\"text-gray-400 hover:text-white\">&times;</button>\n   221→        </div>\n   222→        <div class=\"flex-1 overflow-y-auto p-4\" id=\"export-tree\">\n   223→            <div class=\"text-gray-500 text-center py-8\">Loading features...</div>\n   224→        </div>\n   225→        <div class=\"px-4 py-3 border-t border-gray-700 flex items-center justify-between\">\n   226→            <div class=\"flex items-center gap-3\">\n   227→                <button onclick=\"selectAllExport(true)\" class=\"text-xs text-blue-400 hover:text-blue-300\">Select All</button>\n   228→                <button onclick=\"selectAllExport(false)\" class=\"text-xs text-gray-400 hover:text-gray-300\">Deselect All</button>\n   229→            </div>\n   230→            <button id=\"export-download-btn\" onclick=\"startExport()\" disabled\n   231→                    class=\"px-4 py-2 rounded bg-blue-600 hover:bg-blue-500 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed transition-colors\">\n   232→                Download\n   233→            </button>\n   234→        </div>\n   235→    </div>\n   236→</div>\n   237→{% endblock %}\n   238→\n   239→{% block scripts %}\n   240→<script>\n   241→const PROJECT_ID = '{{ project.id }}';\n   242→const LOOP_STATUS = '{{ loop_state.status }}';\n   243→\n   244→// Provider names from server (no models yet — those are fetched on-demand)\n   245→const PROVIDERS = {{ providers | tojson }};\n   246→\n   247→if (LOOP_STATUS === 'running' || LOOP_STATUS === 'starting') {\n   248→    connectSSE(PROJECT_ID);\n   249→}\n   250→\n   251→function showProjectTab(tab) {\n   252→    const overview = document.getElementById('tab-overview');\n   253→    const loops = document.getElementById('tab-loops');\n   254→    const overviewBtn = document.getElementById('tab-overview-btn');\n   255→    const loopsBtn = document.get