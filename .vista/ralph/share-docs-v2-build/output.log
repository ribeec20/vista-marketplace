{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wohy4usv3YWVdWwwX3r7j3","type":"tool_result","content":"     1→<!DOCTYPE html>\n     2→<html lang=\"en\">\n     3→<head>\n     4→    <meta charset=\"UTF-8\">\n     5→    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n     6→    <title>{{ project_name }} - Documentation Export</title>\n     7→    <script src=\"https://cdn.tailwindcss.com\"></script>\n     8→    <script src=\"https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js\"></script>\n     9→    <script src=\"https://cdn.jsdelivr.net/npm/marked@15/marked.min.js\"></script>\n    10→    <style>\n    11→        .diagram-card {\n    12→            background: #1e293b;\n    13→            border: 2px solid #334155;\n    14→            border-radius: 8px;\n    15→            overflow: hidden;\n    16→            transition: border-color 0.2s, box-shadow 0.2s;\n    17→        }\n    18→        .diagram-card:hover {\n    19→            border-color: #475569;\n    20→            box-shadow: 0 0 0 1px #475569;\n    21→        }\n    22→        .diagram-header {\n    23→            padding: 10px 16px;\n    24→            border-bottom: 1px solid #334155;\n    25→            display: flex;\n    26→            align-items: center;\n    27→            justify-content: space-between;\n    28→            gap: 8px;\n    29→        }\n    30→        .diagram-body {\n    31→            position: relative;\n    32→            overflow: hidden;\n    33→            background: #0f172a;\n    34→            min-height: 200px;\n    35→            max-height: 500px;\n    36→        }\n    37→        .diagram-viewport {\n    38→            width: 100%;\n    39→            height: 100%;\n    40→            cursor: grab;\n    41→            transform-origin: 0 0;\n    42→            padding: 16px;\n    43→        }\n    44→        .diagram-viewport:active {\n    45→            cursor: grabbing;\n    46→        }\n    47→        .diagram-viewport .mermaid svg {\n    48→            max-width: none;\n    49→        }\n    50→        .diagram-viewport .mermaid svg .flowchart-link,\n    51→        .diagram-viewport .mermaid svg .edge-pattern-dotted,\n    52→        .diagram-viewport .mermaid svg path.path,\n    53→        .diagram-viewport .mermaid svg path[class*=\"edge\"],\n    54→        .diagram-viewport .mermaid svg line {\n    55→            stroke-width: 2.5px !important;\n    56→        }\n    57→        .diagram-viewport .mermaid svg .edgeLabel,\n    58→        .diagram-viewport .mermaid svg .nodeLabel,\n    59→        .diagram-viewport .mermaid svg .label {\n    60→            font-size: 14px !important;\n    61→        }\n    62→        .diagram-viewport .mermaid svg .edgeLabel {\n    63→            font-size: 12px !important;\n    64→        }\n    65→        .diagram-viewport .mermaid svg marker path {\n    66→            stroke-width: 1.5px !important;\n    67→        }\n    68→        .diagram-zoom-controls {\n    69→            position: absolute;\n    70→            bottom: 8px;\n    71→            right: 8px;\n    72→            display: flex;\n    73→            gap: 4px;\n    74→            z-index: 5;\n    75→        }\n    76→        .diagram-zoom-controls button {\n    77→            width: 28px;\n    78→            height: 28px;\n    79→            border-radius: 4px;\n    80→            background: #334155;\n    81→            color: #e2e8f0;\n    82→            border: 1px solid #475569;\n    83→            cursor: pointer;\n    84→            font-size: 0.875rem;\n    85→            display: flex;\n    86→            align-items: center;\n    87→            justify-content: center;\n    88→            opacity: 0.7;\n    89→            transition: opacity 0.2s;\n    90→        }\n    91→        .diagram-zoom-controls button:hover {\n    92→            opacity: 1;\n    93→            background: #475569;\n    94→        }\n    95→        .badge {\n    96→            font-size: 0.65rem;\n    97→            padding: 2px 8px;\n    98→            border-radius: 10px;\n    99→            font-weight: 600;\n   100→            text-transform: uppercase;\n   101→            letter-spacing: 0.05em;\n   102→        }\n   103→        .badge-arch {\n   104→            background: #1e3a5f;\n   105→            color: #60a5fa;\n   106→        }\n   107→        .badge-tdd {\n   108→            background: #422006;\n   109→            color: #fbbf24;\n   110→        }\n   111→        .diagram-expand-btn {\n   112→            width: 28px;\n   113→            height: 28px;\n   114→            border-radius: 4px;\n   115→            background: transparent;\n   116→            color: #94a3b8;\n   117→            border: 1px solid transparent;\n   118→            cursor: pointer;\n   119→            font-size: 1rem;\n   120→            display: flex;\n   121→            align-items: center;\n   122→            justify-content: center;\n   123→            transition: all 0.15s;\n   124→            flex-shrink: 0;\n   125→        }\n   126→        .diagram-expand-btn:hover {\n   127→            background: #334155;\n   128→            color: #e2e8f0;\n   129→            border-color: #475569;\n   130→        }\n   131→        /* Requirements prose styling */\n   132→        .requirements-content h1,\n   133→        .requirements-content h2,\n   134→        .requirements-content h3,\n   135→        .requirements-content h4 {\n   136→            color: #e2e8f0;\n   137→            margin-top: 1.2em;\n   138→            margin-bottom: 0.5em;\n   139→            font-weight: 600;\n   140→        }\n   141→        .requirements-content h1 { font-size: 1.5rem; }\n   142→        .requirements-content h2 { font-size: 1.25rem; }\n   143→        .requirements-content h3 { font-size: 1.1rem; }\n   144→        .requirements-content p {\n   145→            color: #cbd5e1;\n   146→            margin-bottom: 0.75em;\n   147→            line-height: 1.6;\n   148→        }\n   149→        .requirements-content ul,\n   150→        .requirements-content ol {\n   151→            color: #cbd5e1;\n   152→            margin-bottom: 0.75em;\n   153→            padding-left: 1.5em;\n   154→        }\n   155→        .requirements-content li {\n   156→            margin-bottom: 0.25em;\n   157→        }\n   158→        .requirements-content code {\n   159→            background: #1e293b;\n   160→            padding: 0.15em 0.4em;\n   161→            border-radius: 4px;\n   162→            font-size: 0.875em;\n   163→            color: #f472b6;\n   164→        }\n   165→        .requirements-content pre {\n   166→            background: #0f172a;\n   167→            padding: 1em;\n   168→            border-radius: 6px;\n   169→            overflow-x: auto;\n   170→            margin-bottom: 0.75em;\n   171→        }\n   172→        .requirements-content pre code {\n   173→            background: transparent;\n   174→            padding: 0;\n   175→            color: #e2e8f0;\n   176→        }\n   177→        .requirements-content table {\n   178→            width: 100%;\n   179→            border-collapse: collapse;\n   180→            margin-bottom: 0.75em;\n   181→        }\n   182→        .requirements-content th,\n   183→        .requirements-content td {\n   184→            border: 1px solid #334155;\n   185→            padding: 0.5em 0.75em;\n   186→            text-align: left;\n   187→            color: #cbd5e1;\n   188→        }\n   189→        .requirements-content th {\n   190→            background: #1e293b;\n   191→            color: #e2e8f0;\n   192→            font-weight: 600;\n   193→        }\n   194→        .requirements-content strong {\n   195→            color: #e2e8f0;\n   196→        }\n   197→        .requirements-content a {\n   198→            color: #60a5fa;\n   199→        }\n   200→        .requirements-content blockquote {\n   201→            border-left: 3px solid #475569;\n   202→            padding-left: 1em;\n   203→            color: #94a3b8;\n   204→            margin-bottom: 0.75em;\n   205→        }\n   206→    </style>\n   207→</head>\n   208→<body class=\"bg-gray-900 text-gray-100 min-h-screen\">\n   209→    <!-- Header -->\n   210→    <header class=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\n   211→        <div class=\"max-w-7xl mx-auto flex items-center justify-between\">\n   212→            <div class=\"flex items-center gap-3\">\n   213→                <span class=\"text-green-400 font-semibold text-lg\">Vista Dashboard</span>\n   214→                <span class=\"text-gray-600\">&middot;</span>\n   215→                <span class=\"text-xl font-bold\">{{ project_name }}</span>\n   216→            </div>\n   217→            <span class=\"text-gray-400 text-sm\">Exported {{ export_date }}</span>\n   218→        </div>\n   219→    </header>\n   220→\n   221→    {% if features|length > 1 %}\n   222→    <nav class=\"bg-gray-800/50 border-b border-gray-700 px-6 py-2\">\n   223→        <div class=\"max-w-7xl mx-auto flex gap-4\">\n   224→            {% for feature in features %}\n   225→            <a href=\"#feature-{{ feature.name }}\"\n   226→               class=\"text-sm text-gray-400 hover:text-gray-200 transition-colors capitalize\">\n   227→                {{ feature.name | replace('_', ' ') }}\n   228→            </a>\n   229→            {% endfor %}\n   230→        </div>\n   231→    </nav>\n   232→    {% endif %}\n   233→\n   234→    <main class=\"max-w-7xl mx-auto px-6 py-8\">\n   235→        {% for feature in features %}\n   236→        {% set fi = loop.index0 %}\n   237→        <section id=\"feature-{{ feature.name }}\" class=\"mb-12\">\n   238→            <h2 class=\"text-2xl font-bold mb-6 capitalize\">\n   239→                {{ feature.name | replace('_', ' ') }}\n   240→            </h2>\n   241→\n   242→            {% if feature.diagrams %}\n   243→            <div class=\"space-y-6 mb-8\">\n   244→                {% for diagram in feature.diagrams %}\n   245→                {% set did = fi ~ '-' ~ loop.index0 %}\n   246→                <div class=\"diagram-card\" data-idx=\"{{ did }}\">\n   247→                    <div class=\"diagram-header\">\n   248→                        <div class=\"flex items-center gap-2 flex-1 min-w-0\">\n   249→                            <span class=\"font-semibold text-sm\">{{ diagram.name }}</span>\n   250→                            <span class=\"badge {{ 'badge-tdd' if diagram.category == 'tdd' else 'badge-arch' }}\">\n   251→                                {{ diagram.category or 'architecture' }}\n   252→                            </span>\n   253→                            {% if diagram.description %}\n   254→                            <span class=\"text-gray-500 text-xs truncate hidden sm:inline\">\n   255→                                {{ diagram.description }}\n   256→                            </span>\n   257→                            {% endif %}\n   258→                        </div>\n   259→                        <button onclick=\"expandDiagram(this)\" class=\"diagram-expand-btn\" title=\"Expand\">&#x26F6;</button>\n   260→                    </div>\n   261→                    <div class=\"diagram-body\">\n   262→                        <div class=\"diagram-viewport\" id=\"viewport-{{ did }}\">\n   263→                            <div class=\"mermaid-placeholder\" id=\"mermaid-{{ did }}\">\n   264→                                Loading...\n   265→                            </div>\n   266→                        </div>\n   267→                        <div class=\"diagram-zoom-controls\">\n   268→                            <button onclick=\"zoomDiagram('{{ did }}', -0.2)\">&minus;</button>\n   269→                            <button onclick=\"resetZoom('{{ did }}')\">1:1</button>\n   270→                            <button onclick=\"zoomDiagram('{{ did }}', 0.2)\">+</button>\n   271→                        </div>\n   272→                    </div>\n   273→                </div>\n   274→                {% endfor %}\n   275→            </div>\n   276→            {% endif %}\n   277→\n   278→            {% if feature.requirements_md %}\n   279→            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6\">\n   280→                <h3 class=\"text-lg font-semibold mb-4\">Domain Requirements</h3>\n   281→                <div class=\"requirements-content\"\n   282→                     id=\"requirements-{{ feature.name }}\">\n   283→                </div>\n   284→            </div>\n   285→            {% endif %}\n   286→        </section>\n   287→        {% endfor %}\n   288→    </main>\n   289→\n   290→    <!-- Modal Overlay -->\n   291→    <div id=\"diagram-modal\" class=\"fixed inset-0 bg-black/80 z-50 hidden items-center justify-center\"\n   292→         onclick=\"closeModal(event)\" style=\"display:none;\">\n   293→        <div class=\"bg-gray-900 rounded-lg border border-gray-700 w-[95vw] h-[90vh] flex flex-col\"\n   294→             onclick=\"event.stopPropagation()\">\n   295→            <div class=\"flex items-center justify-between px-4 py-3 border-b border-gray-700\">\n   296→                <span id=\"modal-title\" class=\"font-semibold\"></span>\n   297→                <button onclick=\"closeModal()\" class=\"text-gray-400 hover:text-white text-xl\">&times;</button>\n   298→            </div>\n   299→            <div class=\"flex-1 overflow-auto p-4\" id=\"modal-content\"></div>\n   300→        </div>\n   301→    </div>\n   302→\n   303→    <!-- Data: embed diagram sources and requirements as JSON -->\n   304→    <script id=\"export-data\" type=\"application/json\">\n   305→        {{ export_data | tojson }}\n   306→    </script>\n   307→\n   308→    <script>\n   309→        // Parse embedded data\n   310→        const EXPORT_DATA = JSON.parse(\n   311→            document.getElementById('export-data').textContent\n   312→        );\n   313→\n   314→        // --- Mermaid Init ---\n   315→        mermaid.initialize({\n   316→            startOnLoad: false,\n   317→            theme: 'dark',\n   318→            themeVariables: {\n   319→                darkMode: true,\n   320→                background: '#0f172a',\n   321→                primaryColor: '#1e3a5f',\n   322→                primaryTextColor: '#e2e8f0',\n   323→                primaryBorderColor: '#475569',\n   324→                lineColor: '#94a3b8',\n   325→                secondaryColor: '#1a2332',\n   326→                tertiaryColor: '#0f172a',\n   327→                fontSize: '14px',\n   328→            }\n   329→        });\n   330→\n   331→        // --- Marked config ---\n   332→        marked.setOptions({ breaks: true, gfm: true });\n   333→\n   334→        // --- Render all diagrams ---\n   335→        let mermaidCounter = 0;\n   336→\n   337→        async function renderAllDiagrams() {\n   338→            for (const item of EXPORT_DATA.diagrams) {\n   339→                const el = document.getElementById(`mermaid-${item.id}`);\n   340→                if (!el) continue;\n   341→                try {\n   342→                    const renderId = `mermaid-svg-export-${++mermaidCounter}`;\n   343→                    const { svg } = await mermaid.render(renderId, item.content);\n   344→                    el.innerHTML = svg;\n   345→                    initViewport(item.id);\n   346→                } catch (e) {\n   347→                    el.innerHTML = `<pre class=\"text-yellow-400 text-xs whitespace-pre-wrap\">Mermaid parse error:\\n${e.message || e}\\n\\n${escapeHtml(item.content)}</pre>`;\n   348→                    initViewport(item.id);\n   349→                }\n   350→            }\n   351→        }\n   352→\n   353→        // --- Render all requirements ---\n   354→        function renderAllRequirements() {\n   355→            for (const [featureName, markdown] of Object.entries(EXPORT_DATA.requirements)) {\n   356→                if (!markdown) continue;\n   357→                const el = document.getElementById(`requirements-${featureName}`);\n   358→                if (!el) continue;\n   359→                el.innerHTML = marked.parse(markdown);\n   360→            }\n   361→        }\n   362→\n   363→        // --- Pan/zoom ---\n   364→        const viewportState = {};\n   365→\n   366→        function initViewport(idx) {\n   367→            const vp = document.getElementById(`viewport-${idx}`);\n   368→            if (!vp) return;\n   369→            viewportState[idx] = { scale: 1, panX: 0, panY: 0, dragging: false, startX: 0, startY: 0 };\n   370→            vp.addEventListener('wheel', (e) => {\n   371→                e.preventDefault();\n   372→                const delta = e.deltaY > 0 ? -0.1 : 0.1;\n   373→                zoomDiagram(idx, delta);\n   374→            }, { passive: false });\n   375→            vp.addEventListener('mousedown', (e) => {\n   376→                if (e.button !== 0) return;\n   377→                const st = viewportState[idx];\n   378→                st.dragging = true;\n   379→                st.startX = e.clientX - st.panX;\n   380→                st.startY = e.clientY - st.panY;\n   381→                vp.style.cursor = 'grabbing';\n   382→            });\n   383→            vp.addEventListener('mousemove', (e) => {\n   384→                const st = viewportState[idx];\n   385→                if (!st.dragging) return;\n   386→                st.panX = e.clientX - st.startX;\n   387→                st.panY = e.clientY - st.startY;\n   388→                applyTransform(idx);\n   389→            });\n   390→            const stopDrag = () => {\n   391→                const st = viewportState[idx];\n   392→                if (st) st.dragging = false;\n   393→                vp.style.cursor = 'grab';\n   394→            };\n   395→            vp.addEventListener('mouseup', stopDrag);\n   396→            vp.addEventListener('mouseleave', stopDrag);\n   397→        }\n   398→\n   399→        function applyTransform(idx) {\n   400→            const vp = document.getElementById(`viewport-${idx}`);\n   401→            const st = viewportState[idx];\n   402→            if (!vp || !st) return;\n   403→            vp.style.transform = `translate(${st.panX}px, ${st.panY}px) scale(${st.scale})`;\n   404→        }\n   405→\n   406→        function zoomDiagram(idx, delta) {\n   407→            const st = viewportState[idx];\n   408→            if (!st) return;\n   409→            st.scale = Math.max(0.3, Math.min(3, st.scale + delta));\n   410→            applyTransform(idx);\n   411→        }\n   412→\n   413→        function resetZoom(idx) {\n   414→            const st = viewportState[idx];\n   415→            if (!st) return;\n   416→            st.scale = 1; st.panX = 0; st.panY = 0;\n   417→            applyTransform(idx);\n   418→        }\n   419→\n   420→        // --- Modal expand/close ---\n   421→        function expandDiagram(btn) {\n   422→            const card = btn.closest('.diagram-card');\n   423→            const viewport = card.querySelector('.diagram-viewport');\n   424→            const title = card.querySelector('.diagram-header .font-semibold');\n   425→            const modal = document.getElementById('diagram-modal');\n   426→            const modalTitle = document.getElementById('modal-title');\n   427→            const modalContent = document.getElementById('modal-content');\n   428→\n   429→            modalTitle.textContent = title ? title.textContent : 'Diagram';\n   430→            modalContent.innerHTML = viewport.innerHTML;\n   431→            modal.style.display = 'flex';\n   432→        }\n   433→\n   434→        function closeModal(event) {\n   435→            if (event && event.target !== event.currentTarget) return;\n   436→            const modal = document.getElementById('diagram-modal');\n   437→            modal.style.display = 'none';\n   438→        }\n   439→\n   440→        // Close modal on Escape\n   441→        document.addEventListener('keydown', (e) => {\n   442→            if (e.key === 'Escape') closeModal();\n   443→        });\n   444→\n   445→        function escapeHtml(str) {\n   446→            if (!str) return '';\n   447→            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n   448→        }\n   449→\n   450→        // --- Feature nav smooth scroll ---\n   451→        document.querySelectorAll('nav a[href^=\"#\"]').forEach(a => {\n   452→            a.addEventListener('click', (e) => {\n   453→                e.preventDefault();\n   454→                const target = document.querySelector(a.getAttribute('href'));\n   455→                if (target) target.scrollIntoView({ behavior: 'smooth' });\n   456→            });\n   457→        });\n   458→\n   459→        // --- Init ---\n   460→        renderAllDiagrams();\n   461→        renderAllRequirements();\n   462→    </script>\n   463→</body>\n   464→</html>\n   465→"}]},"parent_tool_use_id":null,"session_id":"9de84d10-e2ff-4976-8ef7-e25fd15568bb","uuid":"af2fd416-b021-4c4f-ba0a-c18ef8b49060","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Grove\\OneDrive\\Documents\\PYTHON\\claude_plugins\\vista-expanded-visualization\\vista\\server\\views\\export.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>{{ project_name }} - Documentation Export</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/marked@15/marked.min.js\"></script>\n    <style>\n        .diagram-card {\n            background: #1e293b;\n            border: 2px solid #334155;\n            border-radius: 8px;\n            overflow: hidden;\n            transition: border-color 0.2s, box-shadow 0.2s;\n        }\n        .diagram-card:hover {\n            border-color: #475569;\n            box-shadow: 0 0 0 1px #475569;\n        }\n        .diagram-header {\n            padding: 10px 16px;\n            border-bottom: 1px solid #334155;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 8px;\n        }\n        .diagram-body {\n            position: relative;\n            overflow: hidden;\n            background: #0f172a;\n            min-height: 200px;\n            max-height: 500px;\n        }\n        .diagram-viewport {\n            width: 100%;\n            height: 100%;\n            cursor: grab;\n            transform-origin: 0 0;\n            padding: 16px;\n        }\n        .diagram-viewport:active {\n            cursor: grabbing;\n        }\n        .diagram-viewport .mermaid svg {\n            max-width: none;\n        }\n        .diagram-viewport .mermaid svg .flowchart-link,\n        .diagram-viewport .mermaid svg .edge-pattern-dotted,\n        .diagram-viewport .mermaid svg path.path,\n        .diagram-viewport .mermaid svg path[class*=\"edge\"],\n        .diagram-viewport .mermaid svg line {\n            stroke-width: 2.5px !important;\n        }\n        .diagram-viewport .mermaid svg .edgeLabel,\n        .diagram-viewport .mermaid svg .nodeLabel,\n        .diagram-viewport .mermaid svg .label {\n            font-size: 14px !important;\n        }\n        .diagram-viewport .mermaid svg .edgeLabel {\n            font-size: 12px !important;\n        }\n        .diagram-viewport .mermaid svg marker path {\n            stroke-width: 1.5px !important;\n        }\n        .diagram-zoom-controls {\n            position: absolute;\n            bottom: 8px;\n            right: 8px;\n            display: flex;\n            gap: 4px;\n            z-index: 5;\n        }\n        .diagram-zoom-controls button {\n            width: 28px;\n            height: 28px;\n            border-radius: 4px;\n            background: #334155;\n            color: #e2e8f0;\n            border: 1px solid #475569;\n            cursor: pointer;\n            font-size: 0.875rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            opacity: 0.7;\n            transition: opacity 0.2s;\n        }\n        .diagram-zoom-controls button:hover {\n            opacity: 1;\n            background: #475569;\n        }\n        .badge {\n            font-size: 0.65rem;\n            padding: 2px 8px;\n            border-radius: 10px;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n        }\n        .badge-arch {\n            background: #1e3a5f;\n            color: #60a5fa;\n        }\n        .badge-tdd {\n            background: #422006;\n            color: #fbbf24;\n        }\n        .diagram-expand-btn {\n            width: 28px;\n            height: 28px;\n            border-radius: 4px;\n            background: transparent;\n            color: #94a3b8;\n            border: 1px solid transparent;\n            cursor: pointer;\n            font-size: 1rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.15s;\n            flex-shrink: 0;\n        }\n        .diagram-expand-btn:hover {\n            background: #334155;\n            color: #e2e8f0;\n            border-color: #475569;\n        }\n        /* Requirements prose styling */\n        .requirements-content h1,\n        .requirements-content h2,\n        .requirements-content h3,\n        .requirements-content h4 {\n            color: #e2e8f0;\n            margin-top: 1.2em;\n            margin-bottom: 0.5em;\n            font-weight: 600;\n        }\n        .requirements-content h1 { font-size: 1.5rem; }\n        .requirements-content h2 { font-size: 1.25rem; }\n        .requirements-content h3 { font-size: 1.1rem; }\n        .requirements-content p {\n            color: #cbd5e1;\n            margin-bottom: 0.75em;\n            line-height: 1.6;\n        }\n        .requirements-content ul,\n        .requirements-content ol {\n            color: #cbd5e1;\n            margin-bottom: 0.75em;\n            padding-left: 1.5em;\n        }\n        .requirements-content li {\n            margin-bottom: 0.25em;\n        }\n        .requirements-content code {\n            background: #1e293b;\n            padding: 0.15em 0.4em;\n            border-radius: 4px;\n            font-size: 0.875em;\n            color: #f472b6;\n        }\n        .requirements-content pre {\n            background: #0f172a;\n            padding: 1em;\n            border-radius: 6px;\n            overflow-x: auto;\n            margin-bottom: 0.75em;\n        }\n        .requirements-content pre code {\n            background: transparent;\n            padding: 0;\n            color: #e2e8f0;\n        }\n        .requirements-content table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 0.75em;\n        }\n        .requirements-content th,\n        .requirements-content td {\n            border: 1px solid #334155;\n            padding: 0.5em 0.75em;\n            text-align: left;\n            color: #cbd5e1;\n        }\n        .requirements-content th {\n            background: #1e293b;\n            color: #e2e8f0;\n            font-weight: 600;\n        }\n        .requirements-content strong {\n            color: #e2e8f0;\n        }\n        .requirements-content a {\n            color: #60a5fa;\n        }\n        .requirements-content blockquote {\n            border-left: 3px solid #475569;\n            padding-left: 1em;\n            color: #94a3b8;\n            margin-bottom: 0.75em;\n        }\n    </style>\n</head>\n<body class=\"bg-gray-900 text-gray-100 min-h-screen\">\n    <!-- Header -->\n    <header class=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\n        <div class=\"max-w-7xl mx-auto flex items-center justify-between\">\n            <div class=\"flex items-center gap-3\">\n                <span class=\"text-green-400 font-semibold text-lg\">Vista Dashboard</span>\n                <span class=\"text-gray-600\">&middot;</span>\n                <span class=\"text-xl font-bold\">{{ project_name }}</span>\n            </div>\n            <span class=\"text-gray-400 text-sm\">Exported {{ export_date }}</span>\n        </div>\n    </header>\n\n    {% if features|length > 1 %}\n    <nav class=\"bg-gray-800/50 border-b border-gray-700 px-6 py-2\">\n        <div class=\"max-w-7xl mx-auto flex gap-4\">\n            {% for feature in features %}\n            <a href=\"#feature-{{ feature.name }}\"\n               class=\"text-sm text-gray-400 hover:text-gray-200 transition-colors capitalize\">\n                {{ feature.name | replace('_', ' ') }}\n            </a>\n            {% endfor %}\n        </div>\n    </nav>\n    {% endif %}\n\n    <main class=\"max-w-7xl mx-auto px-6 py-8\">\n        {% for feature in features %}\n        {% set fi = loop.index0 %}\n        <section id=\"feature-{{ feature.name }}\" class=\"mb-12\">\n            <h2 class=\"text-2xl font-bold mb-6 capitalize\">\n                {{ feature.name | replace('_', ' ') }}\n            </h2>\n\n            {% if feature.diagrams %}\n            <div class=\"space-y-6 mb-8\">\n                {% for diagram in feature.diagrams %}\n                {% set did = fi ~ '-' ~ loop.index0 %}\n                <div class=\"diagram-card\" data-idx=\"{{ did }}\">\n                    <div class=\"diagram-header\">\n                        <div class=\"flex items-center gap-2 flex-1 min-w-0\">\n                            <span class=\"font-semibold text-sm\">{{ diagram.name }}</span>\n                            <span class=\"badge {{ 'badge-tdd' if diagram.category == 'tdd' else 'badge-arch' }}\">\n                                {{ diagram.category or 'architecture' }}\n                            </span>\n                            {% if diagram.description %}\n                            <span class=\"text-gray-500 text-xs truncate hidden sm:inline\">\n                                {{ diagram.description }}\n                            </span>\n                            {% endif %}\n                        </div>\n                        <button onclick=\"expandDiagram(this)\" class=\"diagram-expand-btn\" title=\"Expand\">&#x26F6;</button>\n                    </div>\n                    <div class=\"diagram-body\">\n                        <div class=\"diagram-viewport\" id=\"viewport-{{ did }}\">\n                            <div class=\"mermaid-placeholder\" id=\"mermaid-{{ did }}\">\n                                Loading...\n                            </div>\n                        </div>\n                        <div class=\"diagram-zoom-controls\">\n                            <button onclick=\"zoomDiagram('{{ did }}', -0.2)\">&minus;</button>\n                            <button onclick=\"resetZoom('{{ did }}')\">1:1</button>\n                            <button onclick=\"zoomDiagram('{{ did }}', 0.2)\">+</button>\n                        </div>\n                    </div>\n                </div>\n                {% endfor %}\n            </div>\n            {% endif %}\n\n            {% if feature.requirements_md %}\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6\">\n                <h3 class=\"text-lg font-semibold mb-4\">Domain Requirements</h3>\n                <div class=\"requirements-content\"\n                     id=\"requirements-{{ feature.name }}\">\n                </div>\n            </div>\n            {% endif %}\n        </section>\n        {% endfor %}\n    </main>\n\n    <!-- Modal Overlay -->\n    <div id=\"diagram-modal\" class=\"fixed inset-0 bg-black/80 z-50 hidden items-center justify-center\"\n         onclick=\"closeModal(event)\" style=\"display:none;\">\n        <div class=\"bg-gray-900 rounded-lg border border-gray-700 w-[95vw] h-[90vh] flex flex-col\"\n             onclick=\"event.stopPropagation()\">\n            <div class=\"flex items-center justify-between px-4 py-3 border-b border-gray-700\">\n                <span id=\"modal-title\" class=\"font-semibold\"></span>\n                <button onclick=\"closeModal()\" class=\"text-gray-400 hover:text-white text-xl\">&times;</button>\n            </div>\n            <div class=\"flex-1 overflow-auto p-4\" id=\"modal-content\"></div>\n        </div>\n    </div>\n\n    <!-- Data: embed diagram sources and requirements as JSON -->\n    <script id=\"export-data\" type=\"application/json\">\n        {{ export_data | tojson }}\n    </script>\n\n    <script>\n        // Parse embedded data\n        const EXPORT_DATA = JSON.parse(\n            document.getElementById('export-data').textContent\n        );\n\n        // --- Mermaid Init ---\n        mermaid.initialize({\n            startOnLoad: false,\n            theme: 'dark',\n            themeVariables: {\n                darkMode: true,\n                background: '#0f172a',\n                primaryColor: '#1e3a5f',\n                primaryTextColor: '#e2e8f0',\n                primaryBorderColor: '#475569',\n                lineColor: '#94a3b8',\n                secondaryColor: '#1a2332',\n                tertiaryColor: '#0f172a',\n                fontSize: '14px',\n            }\n        });\n\n        // --- Marked config ---\n        marked.setOptions({ breaks: true, gfm: true });\n\n        // --- Render all diagrams ---\n        let mermaidCounter = 0;\n\n        async function renderAllDiagrams() {\n            for (const item of EXPORT_DATA.diagrams) {\n                const el = document.getElementById(`mermaid-${item.id}`);\n                if (!el) continue;\n                try {\n                    const renderId = `mermaid-svg-export-${++mermaidCounter}`;\n                    const { svg } = await mermaid.render(renderId, item.content);\n                    el.innerHTML = svg;\n                    initViewport(item.id);\n                } catch (e) {\n                    el.innerHTML = `<pre class=\"text-yellow-400 text-xs whitespace-pre-wrap\">Mermaid parse error:\\n${e.message || e}\\n\\n${escapeHtml(item.content)}</pre>`;\n                    initViewport(item.id);\n                }\n            }\n        }\n\n        // --- Render all requirements ---\n        function renderAllRequirements() {\n            for (const [featureName, markdown] of Object.entries(EXPORT_DATA.requirements)) {\n                if (!markdown) continue;\n                const el = document.getElementById(`requirements-${featureName}`);\n                if (!el) continue;\n                el.innerHTML = marked.parse(markdown);\n            }\n        }\n\n        // --- Pan/zoom ---\n        const viewportState = {};\n\n        function initViewport(idx) {\n            const vp = document.getElementById(`viewport-${idx}`);\n            if (!vp) return;\n            viewportState[idx] = { scale: 1, panX: 0, panY: 0, dragging: false, startX: 0, startY: 0 };\n            vp.addEventListener('wheel', (e) => {\n                e.preventDefault();\n                const delta = e.deltaY > 0 ? -0.1 : 0.1;\n                zoomDiagram(idx, delta);\n            }, { passive: false });\n            vp.addEventListener('mousedown', (e) => {\n                if (e.button !== 0) return;\n                const st = viewportState[idx];\n                st.dragging = true;\n                st.startX = e.clientX - st.panX;\n                st.startY = e.clientY - st.panY;\n                vp.style.cursor = 'grabbing';\n            });\n            vp.addEventListener('mousemove', (e) => {\n                const st = viewportState[idx];\n                if (!st.dragging) return;\n                st.panX = e.clientX - st.startX;\n                st.panY = e.clientY - st.startY;\n                applyTransform(idx);\n            });\n            const stopDrag = () => {\n                const st = viewportState[idx];\n                if (st) st.dragging = false;\n                vp.style.cursor = 'grab';\n            };\n            vp.addEventListener('mouseup', stopDrag);\n            vp.addEventListener('mouseleave', stopDrag);\n        }\n\n        function applyTransform(idx) {\n            const vp = document.getElementById(`viewport-${idx}`);\n            const st = viewportState[idx];\n            if (!vp || !st) return;\n            vp.style.transform = `translate(${st.panX}px, ${st.panY}px) scale(${st.scale})`;\n        }\n\n        function zoomDiagram(idx, delta) {\n            const st = viewportState[idx];\n            if (!st) return;\n            st.scale = Math.max(0.3, Math.min(3, st.scale + delta));\n            applyTransform(idx);\n        }\n\n        function resetZoom(idx) {\n            const st = viewportState[idx];\n            if (!st) return;\n            st.scale = 1; st.panX = 0; st.panY = 0;\n            applyTransform(idx);\n        }\n\n        // --- Modal expand/close ---\n        function expandDiagram(btn) {\n            const card = btn.closest('.diagram-card');\n            const viewport = card.querySelector('.diagram-viewport');\n            const title = card.querySelector('.diagram-header .font-semibold');\n            const modal = document.getElementById('diagram-modal');\n            const modalTitle = document.getElementById('modal-title');\n            const modalContent = document.getElementById('modal-content');\n\n            modalTitle.textContent = title ? title.textContent : 'Diagram';\n            modalContent.innerHTML = viewport.innerHTML;\n            modal.style.display = 'flex';\n        }\n\n        function closeModal(event) {\n            if (event && event.target !== event.currentTarget) return;\n            const modal = document.getElementById('diagram-modal');\n            modal.style.display = 'none';\n        }\n\n        // Close modal on Escape\n        document.addEventListener('keydown', (e) => {\n            if (e.key === 'Escape') closeModal();\n        });\n\n        function escapeHtml(str) {\n            if (!str) return '';\n            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n        }\n\n        // --- Feature nav smooth scroll ---\n        document.querySelectorAll('nav a[href^=\"#\"]').forEach(a => {\n            a.addEventListener('click', (e) => {\n                e.preventDefault();\n                const target = document.querySelector(a.getAttribute('href'));\n                if (target) target.scrollIntoView({ behavior: 'smooth' });\n            });\n        });\n\n        // --- Init ---\n        renderAllDiagrams();\n        renderAllRequirements();\n    </script>\n</body>\n</html>\n","numLines":465,"startLine":1,"totalLines":465}}}
