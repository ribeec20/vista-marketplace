{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011vYFLcyTFgRixVDtoDFSAy","type":"tool_result","content":"     1→\"\"\"Tests for export_service and export routes.\"\"\"\n     2→\n     3→import json\n     4→from pathlib import Path\n     5→from unittest.mock import patch, MagicMock\n     6→\n     7→import pytest\n     8→\n     9→\n    10→def _setup_feature(\n    11→    project_path: Path,\n    12→    feature_name: str,\n    13→    diagrams=None,\n    14→    requirements=None,\n    15→    progress=None,\n    16→    agents_md=None,\n    17→    implementation_plan=None,\n    18→):\n    19→    \"\"\"Create a feature directory with optional arch manifest, diagrams, requirements, progress, agents, and plan.\"\"\"\n    20→    feature_dir = project_path / \".vista\" / \"features\" / feature_name\n    21→    feature_dir.mkdir(parents=True, exist_ok=True)\n    22→\n    23→    if diagrams is not None:\n    24→        arch_dir = feature_dir / \"arch\"\n    25→        arch_dir.mkdir(exist_ok=True)\n    26→        manifest = {\"feature\": feature_name, \"diagrams\": []}\n    27→        for d in diagrams:\n    28→            manifest[\"diagrams\"].append({\n    29→                \"name\": d[\"name\"],\n    30→                \"file\": d[\"file\"],\n    31→                \"type\": d.get(\"type\", \"mermaid\"),\n    32→                \"description\": d.get(\"description\", \"\"),\n    33→                \"category\": d.get(\"category\", \"architecture\"),\n    34→            })\n    35→            if \"content\" in d:\n    36→                (arch_dir / d[\"file\"]).write_text(d[\"content\"], encoding=\"utf-8\")\n    37→        (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n    38→\n    39→    if requirements is not None:\n    40→        (feature_dir / \"domain-requirements.md\").write_text(requirements, encoding=\"utf-8\")\n    41→\n    42→    if progress is not None:\n    43→        (feature_dir / \"progress.txt\").write_text(progress, encoding=\"utf-8\")\n    44→\n    45→    if agents_md is not None:\n    46→        (feature_dir / \"AGENTS.md\").write_text(agents_md, encoding=\"utf-8\")\n    47→\n    48→    if implementation_plan is not None:\n    49→        (feature_dir / \"IMPLEMENTATION_PLAN.md\").write_text(implementation_plan, encoding=\"utf-8\")\n    50→\n    51→\n    52→class TestProgressServiceReadDomainRequirements:\n    53→    def test_returns_content_when_file_exists(self, tmp_path):\n    54→        from server.services.progress_service import ProgressService\n    55→\n    56→        _setup_feature(tmp_path, \"my_feature\", requirements=\"# Requirements\\n- Req 1\")\n    57→        result = ProgressService.read_domain_requirements(str(tmp_path), \"my_feature\")\n    58→        assert result is not None\n    59→        assert \"Req 1\" in result\n    60→\n    61→    def test_returns_none_when_file_missing(self, tmp_path):\n    62→        from server.services.progress_service import ProgressService\n    63→\n    64→        feature_dir = tmp_path / \".vista\" / \"features\" / \"no_reqs\"\n    65→        feature_dir.mkdir(parents=True)\n    66→        result = ProgressService.read_domain_requirements(str(tmp_path), \"no_reqs\")\n    67→        assert result is None\n    68→\n    69→    def test_returns_none_when_file_empty(self, tmp_path):\n    70→        from server.services.progress_service import ProgressService\n    71→\n    72→        _setup_feature(tmp_path, \"empty_feature\", requirements=\"   \\n  \")\n    73→        result = ProgressService.read_domain_requirements(str(tmp_path), \"empty_feature\")\n    74→        assert result is None\n    75→\n    76→\n    77→class TestExportServiceGetExportableFeatures:\n    78→    def test_returns_features_with_diagrams(self, tmp_path):\n    79→        from server.services.export_service import ExportService\n    80→\n    81→        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n    82→            {\"name\": \"System Arch\", \"file\": \"system-arch.mmd\", \"content\": \"graph TD; A-->B\"},\n    83→        ])\n    84→        result = ExportService.get_exportable_features(str(tmp_path))\n    85→        assert len(result) == 1\n    86→        assert result[0][\"name\"] == \"feat_a\"\n    87→        assert len(result[0][\"diagrams\"]) == 1\n    88→        assert result[0][\"diagrams\"][0][\"file\"] == \"system-arch.mmd\"\n    89→\n    90→    def test_excludes_empty_features(self, tmp_path):\n    91→        from server.services.export_service import ExportService\n    92→\n    93→        # Feature with no diagrams and no requirements\n    94→        feature_dir = tmp_path / \".vista\" / \"features\" / \"empty_feat\"\n    95→        feature_dir.mkdir(parents=True)\n    96→        result = ExportService.get_exportable_features(str(tmp_path))\n    97→        assert len(result) == 0\n    98→\n    99→    def test_includes_requirements_only_feature(self, tmp_path):\n   100→        from server.services.export_service import ExportService\n   101→\n   102→        _setup_feature(tmp_path, \"reqs_only\", requirements=\"# Reqs\\n- Item 1\")\n   103→        result = ExportService.get_exportable_features(str(tmp_path))\n   104→        assert len(result) == 1\n   105→        assert result[0][\"name\"] == \"reqs_only\"\n   106→        assert result[0][\"has_requirements\"] is True\n   107→        assert len(result[0][\"diagrams\"]) == 0\n   108→\n   109→    def test_skips_underscore_prefixed_dirs(self, tmp_path):\n   110→        from server.services.export_service import ExportService\n   111→\n   112→        _setup_feature(tmp_path, \"_planning\", requirements=\"# Planning\\n- Internal\")\n   113→        result = ExportService.get_exportable_features(str(tmp_path))\n   114→        assert len(result) == 0\n   115→\n   116→    def test_returns_empty_when_no_features_dir(self, tmp_path):\n   117→        from server.services.export_service import ExportService\n   118→\n   119→        result = ExportService.get_exportable_features(str(tmp_path))\n   120→        assert result == []\n   121→\n   122→\n   123→class TestExportableFeaturesV2ContentTypes:\n   124→    \"\"\"Tests for Phase 1: progress, agents_md, and implementation_plan detection.\"\"\"\n   125→\n   126→    def test_exportable_features_includes_progress_only(self, tmp_path):\n   127→        from server.services.export_service import ExportService\n   128→\n   129→        _setup_feature(tmp_path, \"progress_feat\", progress=\"Phase: build\\nIteration 1\")\n   130→        result = ExportService.get_exportable_features(str(tmp_path))\n   131→        assert len(result) == 1\n   132→        assert result[0][\"name\"] == \"progress_feat\"\n   133→        assert result[0][\"has_progress\"] is True\n   134→        assert result[0][\"has_requirements\"] is False\n   135→\n   136→    def test_exportable_features_includes_plan_only(self, tmp_path):\n   137→        from server.services.export_service import ExportService\n   138→\n   139→        _setup_feature(tmp_path, \"plan_feat\", implementation_plan=\"# Plan\\n## Phase 1\")\n   140→        result = ExportService.get_exportable_features(str(tmp_path))\n   141→        assert len(result) == 1\n   142→        assert result[0][\"name\"] == \"plan_feat\"\n   143→        assert result[0][\"has_implementation_plan\"] is True\n   144→        assert result[0][\"has_requirements\"] is False\n   145→\n   146→    def test_exportable_features_reports_new_flags(self, tmp_path):\n   147→        from server.services.export_service import ExportService\n   148→\n   149→        _setup_feature(\n   150→            tmp_path, \"full_feat\",\n   151→            requirements=\"# Reqs\",\n   152→            progress=\"Phase: plan\",\n   153→            agents_md=\"# Agents\\n- Agent 1\",\n   154→            implementation_plan=\"# Plan\\n## Phase 1\",\n   155→        )\n   156→        result = ExportService.get_exportable_features(str(tmp_path))\n   157→        assert len(result) == 1\n   158→        feat = result[0]\n   159→        assert feat[\"has_requirements\"] is True\n   160→        assert feat[\"has_progress\"] is True\n   161→        assert feat[\"has_agents_md\"] is True\n   162→        assert feat[\"has_implementation_plan\"] is True\n   163→\n   164→    def test_generate_html_includes_progress(self, tmp_path):\n   165→        from server.services.export_service import ExportService\n   166→\n   167→        _setup_feature(tmp_path, \"feat_p\", progress=\"Iteration 1: did stuff\")\n   168→        html = ExportService.generate_export_html(\n   169→            project_name=\"Test\",\n   170→            project_path=str(tmp_path),\n   171→            selected_features=[{\"name\": \"feat_p\", \"diagrams\": []}],\n   172→        )\n   173→        assert \"Iteration 1: did stuff\" in html\n   174→        assert \"Progress Log\" in html\n   175→\n   176→    def test_generate_html_includes_plan(self, tmp_path):\n   177→        from server.services.export_service import ExportService\n   178→\n   179→        _setup_feature(tmp_path, \"feat_plan\", implementation_plan=\"# Phase 1\\nDo the thing\")\n   180→        html = ExportService.generate_export_html(\n   181→            project_name=\"Test\",\n   182→            project_path=str(tmp_path),\n   183→            selected_features=[{\"name\": \"feat_plan\", \"diagrams\": []}],\n   184→        )\n   185→        assert \"Phase 1\" in html\n   186→        assert \"Implementation Plan\" in html\n   187→\n   188→    def test_generate_html_includes_agents(self, tmp_path):\n   189→        from server.services.export_service import ExportService\n   190→\n   191→        _setup_feature(tmp_path, \"feat_agents\", agents_md=\"# Team\\n- Researcher\\n- Builder\")\n   192→        html = ExportService.generate_export_html(\n   193→            project_name=\"Test\",\n   194→            project_path=str(tmp_path),\n   195→            selected_features=[{\"name\": \"feat_agents\", \"diagrams\": []}],\n   196→        )\n   197→        assert \"Researcher\" in html\n   198→        assert \"Agents\" in html\n   199→\n   200→    def test_generate_html_respects_content_toggles(self, tmp_path):\n   201→        from server.services.export_service import ExportService\n   202→\n   203→        _setup_feature(\n   204→            tmp_path, \"feat_toggle\",\n   205→            requirements=\"# Reqs\",\n   206→            progress=\"Progress text\",\n   207→            agents_md=\"# Agents\",\n   208→            implementation_plan=\"# Plan\",\n   209→        )\n   210→        html = ExportService.generate_export_html(\n   211→            project_name=\"Test\",\n   212→            project_path=str(tmp_path),\n   213→            selected_features=[{\n   214→                \"name\": \"feat_toggle\",\n   215→                \"diagrams\": [],\n   216→                \"include_requirements\": False,\n   217→                \"include_progress\": False,\n   218→                \"include_agents\": False,\n   219→                \"include_implementation_plan\": True,\n   220→            }],\n   221→        )\n   222→        # Plan should be present\n   223→        assert \"Implementation Plan\" in html\n   224→        # Others should NOT be present (no content sections rendered)\n   225→        assert \"Domain Requirements\" not in html\n   226→        assert \"Progress Log\" not in html\n   227→        # \"Agents\" heading should not appear (but \"Agents\" in data might)\n   228→        assert \"agents-feat_toggle\" not in html\n   229→\n   230→\n   231→class TestExportServiceGenerateHtml:\n   232→    def test_basic_export(self, tmp_path):\n   233→        from server.services.export_service import ExportService\n   234→\n   235→        _setup_feature(tmp_path, \"my_feature\", diagrams=[\n   236→            {\"name\": \"Overview\", \"file\": \"overview.mmd\", \"content\": \"graph TD; A-->B\"},\n   237→        ], requirements=\"# Requirements\\n- Item 1\")\n   238→\n   239→        html = ExportService.generate_export_html(\n   240→            project_name=\"TestProject\",\n   241→            project_path=str(tmp_path),\n   242→            selected_features=[{\"name\": \"my_feature\", \"diagrams\": [\"overview.mmd\"]}],\n   243→        )\n   244→\n   245→        assert \"TestProject\" in html\n   246→        assert \"mermaid\" in html.lower()\n   247→        assert \"graph TD\" in html\n   248→        assert \"Requirements\" in html\n   249→\n   250→    def test_multiple_features(self, tmp_path):\n   251→        from server.services.export_service import ExportService\n   252→\n   253→        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n   254→            {\"name\": \"Arch A\", \"file\": \"arch-a.mmd\", \"content\": \"graph LR; A-->B\"},\n   255→        ])\n   256→        _setup_feature(tmp_path, \"feat_b\", diagrams=[\n   257→            {\"name\": \"Arch B\", \"file\": \"arch-b.mmd\", \"content\": \"graph LR; C-->D\"},\n   258→        ])\n   259→\n   260→        html = ExportService.generate_export_html(\n   261→            project_name=\"MultiProject\",\n   262→            project_path=str(tmp_path),\n   263→            selected_features=[\n   264→                {\"name\": \"feat_a\", \"diagrams\": [\"arch-a.mmd\"]},\n   265→                {\"name\": \"feat_b\", \"diagrams\": [\"arch-b.mmd\"]},\n   266→            ],\n   267→        )\n   268→\n   269→        assert \"feat_a\" in html\n   270→        assert \"feat_b\" in html\n   271→        # Navigation should be present for multiple features\n   272→        assert 'href=\"#feature-feat_a\"' in html\n   273→        assert 'href=\"#feature-feat_b\"' in html\n   274→\n   275→    def test_missing_diagram_file_skipped(self, tmp_path):\n   276→        from server.services.export_service import ExportService\n   277→\n   278→        _setup_feature(tmp_path, \"feat_c\", diagrams=[\n   279→            {\"name\": \"Exists\", \"file\": \"exists.mmd\", \"content\": \"graph TD; X-->Y\"},\n   280→            {\"name\": \"Missing\", \"file\": \"missing.mmd\"},  # no content = no file on disk\n   281→        ])\n   282→\n   283→        html = ExportService.generate_export_html(\n   284→            project_name=\"Test\",\n   285→            project_path=str(tmp_path),\n   286→            selected_features=[{\"name\": \"feat_c\", \"diagrams\": [\"exists.mmd\", \"missing.mmd\"]}],\n   287→        )\n   288→\n   289→        # Diagram content is embedded as JSON, so check for escaped version\n   290→        assert \"graph TD; X\" in html\n   291→        assert \"Exists\" in html\n   292→        # The missing diagram should be skipped gracefully\n   293→        assert \"Test\" in html\n   294→\n   295→    def test_missing_manifest_includes_requirements(self, tmp_path):\n   296→        from server.services.export_service import ExportService\n   297→\n   298→        # Feature with requirements but no _arch.json\n   299→        _setup_feature(tmp_path, \"reqs_feat\", requirements=\"# Domain Reqs\\n- Important thing\")\n   300→\n   301→        html = ExportService.generate_export_html(\n   302→            project_name=\"ReqsTest\",\n   303→            project_path=str(tmp_path),\n   304→            selected_features=[{\"name\": \"reqs_feat\", \"diagrams\": []}],\n   305→        )\n   306→\n   307→        assert \"Important thing\" in html\n   308→        assert \"ReqsTest\" in html\n   309→\n   310→    def test_empty_selection_returns_minimal_html(self, tmp_path):\n   311→        from server.services.export_service import ExportService\n   312→\n   313→        html = ExportService.generate_export_html(\n   314→            project_name=\"Empty\",\n   315→            project_path=str(tmp_path),\n   316→            selected_features=[],\n   317→        )\n   318→\n   319→        assert \"Empty\" in html\n   320→        assert \"<!DOCTYPE html>\" in html\n   321→\n   322→\n   323→class TestExportRoutes:\n   324→    @pytest.fixture\n   325→    def client(self, tmp_path):\n   326→        \"\"\"Create a test client with a registered project.\"\"\"\n   327→        from unittest.mock import patch, MagicMock\n   328→\n   329→        # Setup test feature\n   330→        _setup_feature(tmp_path, \"test_feature\", diagrams=[\n   331→            {\"name\": \"Test Diagram\", \"file\": \"test.mmd\", \"content\": \"graph TD; A-->B\"},\n   332→        ], requirements=\"# Test Requirements\")\n   333→\n   334→        mock_project = MagicMock()\n   335→        mock_project.id = \"test-123\"\n   336→        mock_project.name = \"TestProject\"\n   337→        mock_project.path = str(tmp_path)\n   338→\n   339→        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n   340→            mock_ps.get_by_id.return_value = mock_project\n   341→\n   342→            from fastapi.testclient import TestClient\n   343→            from fastapi import FastAPI\n   344→\n   345→            app = FastAPI()\n   346→            from server.routes.export import router\n   347→            app.include_router(router)\n   348→\n   349→            yield TestClient(app), mock_ps\n   350→\n   351→    def test_get_export_features(self, client):\n   352→        test_client, _ = client\n   353→        resp = test_client.get(\"/api/projects/test-123/export/features\")\n   354→        assert resp.status_code == 200\n   355→        data = resp.json()\n   356→        assert len(data) == 1\n   357→        assert data[0][\"name\"] == \"test_feature\"\n   358→        assert len(data[0][\"diagrams\"]) == 1\n   359→\n   360→    def test_post_export(self, client):\n   361→        test_client, _ = client\n   362→        resp = test_client.post(\"/api/projects/test-123/export\", json={\n   363→            \"features\": [{\"name\": \"test_feature\", \"diagrams\": [\"test.mmd\"]}]\n   364→        })\n   365→        assert resp.status_code == 200\n   366→        assert \"Content-Disposition\" in resp.headers\n   367→        assert \"TestProject\" in resp.headers[\"Content-Disposition\"]\n   368→        assert \"<!DOCTYPE html>\" in resp.text\n   369→\n   370→    def test_post_export_invalid_project(self, tmp_path):\n   371→        from unittest.mock import patch\n   372→        from fastapi.testclient import TestClient\n   373→        from fastapi import FastAPI\n   374→\n   375→        app = FastAPI()\n   376→        from server.routes.export import router\n   377→        app.include_router(router)\n   378→\n   379→        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n   380→            mock_ps.get_by_id.return_value = None\n   381→            test_client = TestClient(app)\n   382→            resp = test_client.post(\"/api/projects/nonexistent/export\", json={\n   383→                \"features\": [{\"name\": \"x\", \"diagrams\": []}]\n   384→            })\n   385→            assert resp.status_code == 404\n   386→\n   387→\n   388→def _setup_ralph_job(\n   389→    project_path: Path,\n   390→    slug: str,\n   391→    job_meta: dict | None = None,\n   392→    task: str | None = None,\n   393→    plan: str | None = None,\n   394→    progress: str | None = None,\n   395→):\n   396→    \"\"\"Create a Ralph job directory with optional artifacts.\"\"\"\n   397→    job_dir = project_path / \".vista\" / \"ralph\" / slug\n   398→    job_dir.mkdir(parents=True, exist_ok=True)\n   399→\n   400→    if job_meta is not None:\n   401→        (job_dir / \"job.json\").write_text(json.dumps(job_meta), encoding=\"utf-8\")\n   402→\n   403→    if task is not None:\n   404→        (job_dir / \"task.md\").write_text(task, encoding=\"utf-8\")\n   405→\n   406→    if plan is not None:\n   407→        (job_dir / \"IMPLEMENTATION_PLAN.md\").write_text(plan, encoding=\"utf-8\")\n   408→\n   409→    if progress is not None:\n   410→        (job_dir / \"progress.txt\").write_text(progress, encoding=\"utf-8\")\n   411→\n   412→\n   413→class TestExportableRalphJobs:\n   414→    \"\"\"Tests for Phase 2: Ralph job artifact discovery and export.\"\"\"\n   415→\n   416→    def test_returns_empty_when_no_ralph_dir(self, tmp_path):\n   417→        from server.services.export_service import ExportService\n   418→\n   419→        result = ExportService.get_exportable_ralph_jobs(str(tmp_path))\n   420→        assert result == []\n   421→\n   422→    def test_discovers_ralph_jobs_with_task(self, tmp_path):\n   423→        from server.services.export_service import ExportService\n   424→\n   425→        _setup_ralph_job(tmp_path, \"my-build-job\", task=\"Build the widget\")\n   426→        result = ExportService.get_exportable_ralph_jobs(str(tmp_path))\n   427→        assert len(result) == 1\n   428→        assert result[0][\"slug\"] == \"my-build-job\"\n   429→        assert result[0][\"has_task\"] is True\n   430→        assert result[0][\"has_plan\"] is False\n   431→        assert result[0][\"has_progress\"] is False\n   432→\n   433→    def test_discovers_ralph_jobs_with_all_artifacts(self, tmp_path):\n   434→        from server.services.export_service import ExportService\n   435→\n   436→        _setup_ralph_job(\n   437→            tmp_path, \"full-job\",\n   438→            job_meta={\"mode\": \"build\", \"status\": \"completed\"},\n   439→            task=\"Do the thing\",\n   440→            plan=\"# Phase 1\\nBuild it\",\n   441→            progress=\"Iteration 1: done\",\n   442→        )\n   443→        result = ExportService.get_exportable_ralph_jobs(str(tmp_path))\n   444→        assert len(result) == 1\n   445→        job = result[0]\n   446→        assert job[\"slug\"] == \"full-job\"\n   447→        assert job[\"mode\"] == \"build\"\n   448→        assert job[\"status\"] == \"completed\"\n   449→        assert job[\"has_task\"] is True\n   450→        assert job[\"has_plan\"] is True\n   451→        assert job[\"has_progress\"] is True\n   452→\n   453→    def test_skips_empty_ralph_dirs(self, tmp_path):\n   454→        from server.services.export_service import ExportService\n   455→\n   456→        # Create a ralph dir with no exportable files\n   457→        empty_dir = tmp_path / \".vista\" / \"ralph\" / \"empty-job\"\n   458→        empty_dir.mkdir(parents=True)\n   459→        (empty_dir / \"output.log\").write_text(\"log data\", encoding=\"utf-8\")\n   460→        result = ExportService.get_exportable_ralph_jobs(str(tmp_path))\n   461→        assert len(result) == 0\n   462→\n   463→    def test_read_ralph_artifact_returns_content(self, tmp_path):\n   464→        from server.services.export_service import ExportService\n   465→\n   466→        _setup_ralph_job(tmp_path, \"read-job\", task=\"My task content\")\n   467→        result = ExportService.read_ralph_artifact(str(tmp_path), \"read-job\", \"task.md\")\n   468→        assert result == \"My task content\"\n   469→\n   470→    def test_read_ralph_artifact_blocks_non_exportable(self, tmp_path):\n   471→        from server.services.export_service import ExportService\n   472→\n   473→        _setup_ralph_job(tmp_path, \"block-job\", task=\"task\")\n   474→        # output.log is not in the whitelist\n   475→        result = ExportService.read_ralph_artifact(str(tmp_path), \"block-job\", \"output.log\")\n   476→        assert result is None\n   477→\n   478→    def test_read_ralph_artifact_blocks_path_traversal(self, tmp_path):\n   479→        from server.services.export_service import ExportService\n   480→\n   481→        _setup_ralph_job(tmp_path, \"safe-job\", task=\"task\")\n   482→        result = ExportService.read_ralph_artifact(str(tmp_path), \"../../../etc\", \"task.md\")\n   483→        assert result is None\n   484→\n   485→    def test_generate_html_includes_ralph_jobs(self, tmp_path):\n   486→        from server.services.export_service import ExportService\n   487→\n   488→        _setup_ralph_job(\n   489→            tmp_path, \"html-job\",\n   490→            task=\"# Build Widget\\nMake the widget work\",\n   491→            plan=\"# Phase 1\\nStep 1: Do it\",\n   492→            progress=\"Iteration 1: completed step 1\",\n   493→        )\n   494→        html = ExportService.generate_export_html(\n   495→            project_name=\"RalphTest\",\n   496→            project_path=str(tmp_path),\n   497→            selected_features=[],\n   498→            selected_ralph_jobs=[{\"slug\": \"html-job\"}],\n   499→        )\n   500→        assert \"Build Widget\" in html\n   501→        assert \"Phase 1\" in html\n   502→        assert \"Iteration 1\" in html\n   503→        assert \"Ralph Job\" in html\n   504→\n   505→    def test_generate_html_respects_ralph_content_toggles(self, tmp_path):\n   506→        from server.services.export_service import ExportService\n   507→\n   508→        _setup_ralph_job(\n   509→            tmp_path, \"toggle-job\",\n   510→            task=\"Task content here\",\n   511→            plan=\"Plan content here\",\n   512→            progress=\"Progress content here\",\n   513→        )\n   514→        html = ExportService.generate_export_html(\n   515→            project_name=\"ToggleTest\",\n   516→            project_path=str(tmp_path),\n   517→            selected_features=[],\n   518→            selected_ralph_jobs=[{\n   519→                \"slug\": \"toggle-job\",\n   520→                \"include_task\": True,\n   521→                \"include_plan\": False,\n   522→                \"include_progress\": False,\n   523→            }],\n   524→        )\n   525→        assert \"Task content here\" in html\n   526→        assert \"ralph-plan-toggle-job\" not in html\n   527→        assert \"ralph-progress-toggle-job\" not in html\n   528→\n   529→    def test_generate_html_mixed_features_and_ralph(self, tmp_path):\n   530→        from server.services.export_service import ExportService\n   531→\n   532→        _setup_feature(tmp_path, \"my_feature\", requirements=\"# Reqs\\n- Item 1\")\n   533→        _setup_ralph_job(tmp_path, \"my-ralph\", task=\"Ralph task\")\n   534→\n   535→        html = ExportService.generate_export_html(\n   536→            project_name=\"MixedTest\",\n   537→            project_path=str(tmp_path),\n   538→            selected_features=[{\"name\": \"my_feature\", \"diagrams\": []}],\n   539→            selected_ralph_jobs=[{\"slug\": \"my-ralph\"}],\n   540→        )\n   541→        assert \"my_feature\" in html\n   542→        assert \"Ralph task\" in html\n   543→        assert \"Ralph Job\" in html\n   544→\n   545→\n   546→class TestExportRalphRoutes:\n   547→    @pytest.fixture\n   548→    def ralph_client(self, tmp_path):\n   549→        \"\"\"Create a test client with Ralph jobs.\"\"\"\n   550→        _setup_ralph_job(\n   551→            tmp_path, \"test-build\",\n   552→            job_meta={\"mode\": \"build\", \"status\": \"completed\"},\n   553→            task=\"Build the feature\",\n   554→            plan=\"# Plan\\n## Phase 1\",\n   555→            progress=\"Iteration 1: done\",\n   556→        )\n   557→\n   558→        mock_project = MagicMock()\n   559→        mock_project.id = \"test-456\"\n   560→        mock_project.name = \"RalphProject\"\n   561→        mock_project.path = str(tmp_path)\n   562→\n   563→        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n   564→            mock_ps.get_by_id.return_value = mock_project\n   565→\n   566→            from fastapi.testclient import TestClient\n   567→            from fastapi import FastAPI\n   568→\n   569→            app = FastAPI()\n   570→            from server.routes.export import router\n   571→            app.include_router(router)\n   572→\n   573→            yield TestClient(app), mock_ps\n   574→\n   575→    def test_get_ralph_jobs_endpoint(self, ralph_client):\n   576→        test_client, _ = ralph_client\n   577→        resp = test_client.get(\"/api/projects/test-456/export/ralph-jobs\")\n   578→        assert resp.status_code == 200\n   579→        data = resp.json()\n   580→        assert len(data) == 1\n   581→        assert data[0][\"slug\"] == \"test-build\"\n   582→        assert data[0][\"has_task\"] is True\n   583→        assert data[0][\"has_plan\"] is True\n   584→\n   585→    def test_export_with_ralph_jobs(self, ralph_client):\n   586→        test_client, _ = ralph_client\n   587→        resp = test_client.post(\"/api/projects/test-456/export\", json={\n   588→            \"features\": [],\n   589→            \"ralph_jobs\": [{\"slug\": \"test-build\"}],\n   590→        })\n   591→        assert resp.status_code == 200\n   592→        assert \"<!DOCTYPE html>\" in resp.text\n   593→        assert \"Build the feature\" in resp.text\n   594→"}]},"parent_tool_use_id":null,"session_id":"6996de78-f515-44c4-bca3-90f28086b3f0","uuid":"3f5a8476-b53f-4bf0-a5a8-38b63bc3165d","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/tests/test_export_service.py","content":"\"\"\"Tests for export_service and export routes.\"\"\"\n\nimport json\nfrom pathlib import Path\nfrom unittest.mock import patch, MagicMock\n\nimport pytest\n\n\ndef _setup_feature(\n    project_path: Path,\n    feature_name: str,\n    diagrams=None,\n    requirements=None,\n    progress=None,\n    agents_md=None,\n    implementation_plan=None,\n):\n    \"\"\"Create a feature directory with optional arch manifest, diagrams, requirements, progress, agents, and plan.\"\"\"\n    feature_dir = project_path / \".vista\" / \"features\" / feature_name\n    feature_dir.mkdir(parents=True, exist_ok=True)\n\n    if diagrams is not None:\n        arch_dir = feature_dir / \"arch\"\n        arch_dir.mkdir(exist_ok=True)\n        manifest = {\"feature\": feature_name, \"diagrams\": []}\n        for d in diagrams:\n            manifest[\"diagrams\"].append({\n                \"name\": d[\"name\"],\n                \"file\": d[\"file\"],\n                \"type\": d.get(\"type\", \"mermaid\"),\n                \"description\": d.get(\"description\", \"\"),\n                \"category\": d.get(\"category\", \"architecture\"),\n            })\n            if \"content\" in d:\n                (arch_dir / d[\"file\"]).write_text(d[\"content\"], encoding=\"utf-8\")\n        (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n\n    if requirements is not None:\n        (feature_dir / \"domain-requirements.md\").write_text(requirements, encoding=\"utf-8\")\n\n    if progress is not None:\n        (feature_dir / \"progress.txt\").write_text(progress, encoding=\"utf-8\")\n\n    if agents_md is not None:\n        (feature_dir / \"AGENTS.md\").write_text(agents_md, encoding=\"utf-8\")\n\n    if implementation_plan is not None:\n        (feature_dir / \"IMPLEMENTATION_PLAN.md\").write_text(implementation_plan, encoding=\"utf-8\")\n\n\nclass TestProgressServiceReadDomainRequirements:\n    def test_returns_content_when_file_exists(self, tmp_path):\n        from server.services.progress_service import ProgressService\n\n        _setup_feature(tmp_path, \"my_feature\", requirements=\"# Requirements\\n- Req 1\")\n        result = ProgressService.read_domain_requirements(str(tmp_path), \"my_feature\")\n        assert result is not None\n        assert \"Req 1\" in result\n\n    def test_returns_none_when_file_missing(self, tmp_path):\n        from server.services.progress_service import ProgressService\n\n        feature_dir = tmp_path / \".vista\" / \"features\" / \"no_reqs\"\n        feature_dir.mkdir(parents=True)\n        result = ProgressService.read_domain_requirements(str(tmp_path), \"no_reqs\")\n        assert result is None\n\n    def test_returns_none_when_file_empty(self, tmp_path):\n        from server.services.progress_service import ProgressService\n\n        _setup_feature(tmp_path, \"empty_feature\", requirements=\"   \\n  \")\n        result = ProgressService.read_domain_requirements(str(tmp_path), \"empty_feature\")\n        assert result is None\n\n\nclass TestExportServiceGetExportableFeatures:\n    def test_returns_features_with_diagrams(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n            {\"name\": \"System Arch\", \"file\": \"system-arch.mmd\", \"content\": \"graph TD; A-->B\"},\n        ])\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        assert result[0][\"name\"] == \"feat_a\"\n        assert len(result[0][\"diagrams\"]) == 1\n        assert result[0][\"diagrams\"][0][\"file\"] == \"system-arch.mmd\"\n\n    def test_excludes_empty_features(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        # Feature with no diagrams and no requirements\n        feature_dir = tmp_path / \".vista\" / \"features\" / \"empty_feat\"\n        feature_dir.mkdir(parents=True)\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 0\n\n    def test_includes_requirements_only_feature(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"reqs_only\", requirements=\"# Reqs\\n- Item 1\")\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        assert result[0][\"name\"] == \"reqs_only\"\n        assert result[0][\"has_requirements\"] is True\n        assert len(result[0][\"diagrams\"]) == 0\n\n    def test_skips_underscore_prefixed_dirs(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"_planning\", requirements=\"# Planning\\n- Internal\")\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 0\n\n    def test_returns_empty_when_no_features_dir(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert result == []\n\n\nclass TestExportableFeaturesV2ContentTypes:\n    \"\"\"Tests for Phase 1: progress, agents_md, and implementation_plan detection.\"\"\"\n\n    def test_exportable_features_includes_progress_only(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"progress_feat\", progress=\"Phase: build\\nIteration 1\")\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        assert result[0][\"name\"] == \"progress_feat\"\n        assert result[0][\"has_progress\"] is True\n        assert result[0][\"has_requirements\"] is False\n\n    def test_exportable_features_includes_plan_only(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"plan_feat\", implementation_plan=\"# Plan\\n## Phase 1\")\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        assert result[0][\"name\"] == \"plan_feat\"\n        assert result[0][\"has_implementation_plan\"] is True\n        assert result[0][\"has_requirements\"] is False\n\n    def test_exportable_features_reports_new_flags(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(\n            tmp_path, \"full_feat\",\n            requirements=\"# Reqs\",\n            progress=\"Phase: plan\",\n            agents_md=\"# Agents\\n- Agent 1\",\n            implementation_plan=\"# Plan\\n## Phase 1\",\n        )\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        feat = result[0]\n        assert feat[\"has_requirements\"] is True\n        assert feat[\"has_progress\"] is True\n        assert feat[\"has_agents_md\"] is True\n        assert feat[\"has_implementation_plan\"] is True\n\n    def test_generate_html_includes_progress(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_p\", progress=\"Iteration 1: did stuff\")\n        html = ExportService.generate_export_html(\n            project_name=\"Test\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"feat_p\", \"diagrams\": []}],\n        )\n        assert \"Iteration 1: did stuff\" in html\n        assert \"Progress Log\" in html\n\n    def test_generate_html_includes_plan(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_plan\", implementation_plan=\"# Phase 1\\nDo the thing\")\n        html = ExportService.generate_export_html(\n            project_name=\"Test\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"feat_plan\", \"diagrams\": []}],\n        )\n        assert \"Phase 1\" in html\n        assert \"Implementation Plan\" in html\n\n    def test_generate_html_includes_agents(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_agents\", agents_md=\"# Team\\n- Researcher\\n- Builder\")\n        html = ExportService.generate_export_html(\n            project_name=\"Test\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"feat_agents\", \"diagrams\": []}],\n        )\n        assert \"Researcher\" in html\n        assert \"Agents\" in html\n\n    def test_generate_html_respects_content_toggles(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(\n            tmp_path, \"feat_toggle\",\n            requirements=\"# Reqs\",\n            progress=\"Progress text\",\n            agents_md=\"# Agents\",\n            implementation_plan=\"# Plan\",\n        )\n        html = ExportService.generate_export_html(\n            project_name=\"Test\",\n            project_path=str(tmp_path),\n            selected_features=[{\n                \"name\": \"feat_toggle\",\n                \"diagrams\": [],\n                \"include_requirements\": False,\n                \"include_progress\": False,\n                \"include_agents\": False,\n                \"include_implementation_plan\": True,\n            }],\n        )\n        # Plan should be present\n        assert \"Implementation Plan\" in html\n        # Others should NOT be present (no content sections rendered)\n        assert \"Domain Requirements\" not in html\n        assert \"Progress Log\" not in html\n        # \"Agents\" heading should not appear (but \"Agents\" in data might)\n        assert \"agents-feat_toggle\" not in html\n\n\nclass TestExportServiceGenerateHtml:\n    def test_basic_export(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"my_feature\", diagrams=[\n            {\"name\": \"Overview\", \"file\": \"overview.mmd\", \"content\": \"graph TD; A-->B\"},\n        ], requirements=\"# Requirements\\n- Item 1\")\n\n        html = ExportService.generate_export_html(\n            project_name=\"TestProject\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"my_feature\", \"diagrams\": [\"overview.mmd\"]}],\n        )\n\n        assert \"TestProject\" in html\n        assert \"mermaid\" in html.lower()\n        assert \"graph TD\" in html\n        assert \"Requirements\" in html\n\n    def test_multiple_features(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n            {\"name\": \"Arch A\", \"file\": \"arch-a.mmd\", \"content\": \"graph LR; A-->B\"},\n        ])\n        _setup_feature(tmp_path, \"feat_b\", diagrams=[\n            {\"name\": \"Arch B\", \"file\": \"arch-b.mmd\", \"content\": \"graph LR; C-->D\"},\n        ])\n\n        html = ExportService.generate_export_html(\n            project_name=\"MultiProject\",\n            project_path=str(tmp_path),\n            selected_features=[\n                {\"name\": \"feat_a\", \"diagrams\": [\"arch-a.mmd\"]},\n                {\"name\": \"feat_b\", \"diagrams\": [\"arch-b.mmd\"]},\n            ],\n        )\n\n        assert \"feat_a\" in html\n        assert \"feat_b\" in html\n        # Navigation should be present for multiple features\n        assert 'href=\"#feature-feat_a\"' in html\n        assert 'href=\"#feature-feat_b\"' in html\n\n    def test_missing_diagram_file_skipped(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_c\", diagrams=[\n            {\"name\": \"Exists\", \"file\": \"exists.mmd\", \"content\": \"graph TD; X-->Y\"},\n            {\"name\": \"Missing\", \"file\": \"missing.mmd\"},  # no content = no file on disk\n        ])\n\n        html = ExportService.generate_export_html(\n            project_name=\"Test\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"feat_c\", \"diagrams\": [\"exists.mmd\", \"missing.mmd\"]}],\n        )\n\n        # Diagram content is embedded as JSON, so check for escaped version\n        assert \"graph TD; X\" in html\n        assert \"Exists\" in html\n        # The missing diagram should be skipped gracefully\n        assert \"Test\" in html\n\n    def test_missing_manifest_includes_requirements(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        # Feature with requirements but no _arch.json\n        _setup_feature(tmp_path, \"reqs_feat\", requirements=\"# Domain Reqs\\n- Important thing\")\n\n        html = ExportService.generate_export_html(\n            project_name=\"ReqsTest\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"reqs_feat\", \"diagrams\": []}],\n        )\n\n        assert \"Important thing\" in html\n        assert \"ReqsTest\" in html\n\n    def test_empty_selection_returns_minimal_html(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        html = ExportService.generate_export_html(\n            project_name=\"Empty\",\n            project_path=str(tmp_path),\n            selected_features=[],\n        )\n\n        assert \"Empty\" in html\n        assert \"<!DOCTYPE html>\" in html\n\n\nclass TestExportRoutes:\n    @pytest.fixture\n    def client(self, tmp_path):\n        \"\"\"Create a test client with a registered project.\"\"\"\n        from unittest.mock import patch, MagicMock\n\n        # Setup test feature\n        _setup_feature(tmp_path, \"test_feature\", diagrams=[\n            {\"name\": \"Test Diagram\", \"file\": \"test.mmd\", \"content\": \"graph TD; A-->B\"},\n        ], requirements=\"# Test Requirements\")\n\n        mock_project = MagicMock()\n        mock_project.id = \"test-123\"\n        mock_project.name = \"TestProject\"\n        mock_project.path = str(tmp_path)\n\n        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n            mock_ps.get_by_id.return_value = mock_project\n\n            from fastapi.testclient import TestClient\n            from fastapi import FastAPI\n\n            app = FastAPI()\n            from server.routes.export import router\n            app.include_router(router)\n\n            yield TestClient(app), mock_ps\n\n    def test_get_export_features(self, client):\n        test_client, _ = client\n        resp = test_client.get(\"/api/projects/test-123/export/features\")\n        assert resp.status_code == 200\n        data = resp.json()\n        assert len(data) == 1\n        assert data[0][\"name\"] == \"test_feature\"\n        assert len(data[0][\"diagrams\"]) == 1\n\n    def test_post_export(self, client):\n        test_client, _ = client\n        resp = test_client.post(\"/api/projects/test-123/export\", json={\n            \"features\": [{\"name\": \"test_feature\", \"diagrams\": [\"test.mmd\"]}]\n        })\n        assert resp.status_code == 200\n        assert \"Content-Disposition\" in resp.headers\n        assert \"TestProject\" in resp.headers[\"Content-Disposition\"]\n        assert \"<!DOCTYPE html>\" in resp.text\n\n    def test_post_export_invalid_project(self, tmp_path):\n        from unittest.mock import patch\n        from fastapi.testclient import TestClient\n        from fastapi import FastAPI\n\n        app = FastAPI()\n        from server.routes.export import router\n        app.include_router(router)\n\n        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n            mock_ps.get_by_id.return_value = None\n            test_client = TestClient(app)\n            resp = test_client.post(\"/api/projects/nonexistent/export\", json={\n                \"features\": [{\"name\": \"x\", \"diagrams\": []}]\n            })\n            assert resp.status_code == 404\n\n\ndef _setup_ralph_job(\n    project_path: Path,\n    slug: str,\n    job_meta: dict | None = None,\n    task: str | None = None,\n    plan: str | None = None,\n    progress: str | None = None,\n):\n    \"\"\"Create a Ralph job directory with optional artifacts.\"\"\"\n    job_dir = project_path / \".vista\" / \"ralph\" / slug\n    job_dir.mkdir(parents=True, exist_ok=True)\n\n    if job_meta is not None:\n        (job_dir / \"job.json\").write_text(json.dumps(job_meta), encoding=\"utf-8\")\n\n    if task is not None:\n        (job_dir / \"task.md\").write_text(task, encoding=\"utf-8\")\n\n    if plan is not None:\n        (job_dir / \"IMPLEMENTATION_PLAN.md\").write_text(plan, encoding=\"utf-8\")\n\n    if progress is not None:\n        (job_dir / \"progress.txt\").write_text(progress, encoding=\"utf-8\")\n\n\nclass TestExportableRalphJobs:\n    \"\"\"Tests for Phase 2: Ralph job artifact discovery and export.\"\"\"\n\n    def test_returns_empty_when_no_ralph_dir(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        result = ExportService.get_exportable_ralph_jobs(str(tmp_path))\n        assert result == []\n\n    def test_discovers_ralph_jobs_with_task(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_ralph_job(tmp_path, \"my-build-job\", task=\"Build the widget\")\n        result = ExportService.get_exportable_ralph_jobs(str(tmp_path))\n        assert len(result) == 1\n        assert result[0][\"slug\"] == \"my-build-job\"\n        assert result[0][\"has_task\"] is True\n        assert result[0][\"has_plan\"] is False\n        assert result[0][\"has_progress\"] is False\n\n    def test_discovers_ralph_jobs_with_all_artifacts(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_ralph_job(\n            tmp_path, \"full-job\",\n            job_meta={\"mode\": \"build\", \"status\": \"completed\"},\n            task=\"Do the thing\",\n            plan=\"# Phase 1\\nBuild it\",\n            progress=\"Iteration 1: done\",\n        )\n        result = ExportService.get_exportable_ralph_jobs(str(tmp_path))\n        assert len(result) == 1\n        job = result[0]\n        assert job[\"slug\"] == \"full-job\"\n        assert job[\"mode\"] == \"build\"\n        assert job[\"status\"] == \"completed\"\n        assert job[\"has_task\"] is True\n        assert job[\"has_plan\"] is True\n        assert job[\"has_progress\"] is True\n\n    def test_skips_empty_ralph_dirs(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        # Create a ralph dir with no exportable files\n        empty_dir = tmp_path / \".vista\" / \"ralph\" / \"empty-job\"\n        empty_dir.mkdir(parents=True)\n        (empty_dir / \"output.log\").write_text(\"log data\", encoding=\"utf-8\")\n        result = ExportService.get_exportable_ralph_jobs(str(tmp_path))\n        assert len(result) == 0\n\n    def test_read_ralph_artifact_returns_content(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_ralph_job(tmp_path, \"read-job\", task=\"My task content\")\n        result = ExportService.read_ralph_artifact(str(tmp_path), \"read-job\", \"task.md\")\n        assert result == \"My task content\"\n\n    def test_read_ralph_artifact_blocks_non_exportable(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_ralph_job(tmp_path, \"block-job\", task=\"task\")\n        # output.log is not in the whitelist\n        result = ExportService.read_ralph_artifact(str(tmp_path), \"block-job\", \"output.log\")\n        assert result is None\n\n    def test_read_ralph_artifact_blocks_path_traversal(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_ralph_job(tmp_path, \"safe-job\", task=\"task\")\n        result = ExportService.read_ralph_artifact(str(tmp_path), \"../../../etc\", \"task.md\")\n        assert result is None\n\n    def test_generate_html_includes_ralph_jobs(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_ralph_job(\n            tmp_path, \"html-job\",\n            task=\"# Build Widget\\nMake the widget work\",\n            plan=\"# Phase 1\\nStep 1: Do it\",\n            progress=\"Iteration 1: completed step 1\",\n        )\n        html = ExportService.generate_export_html(\n            project_name=\"RalphTest\",\n            project_path=str(tmp_path),\n            selected_features=[],\n            selected_ralph_jobs=[{\"slug\": \"html-job\"}],\n        )\n        assert \"Build Widget\" in html\n        assert \"Phase 1\" in html\n        assert \"Iteration 1\" in html\n        assert \"Ralph Job\" in html\n\n    def test_generate_html_respects_ralph_content_toggles(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_ralph_job(\n            tmp_path, \"toggle-job\",\n            task=\"Task content here\",\n            plan=\"Plan content here\",\n            progress=\"Progress content here\",\n        )\n        html = ExportService.generate_export_html(\n            project_name=\"ToggleTest\",\n            project_path=str(tmp_path),\n            selected_features=[],\n            selected_ralph_jobs=[{\n                \"slug\": \"toggle-job\",\n                \"include_task\": True,\n                \"include_plan\": False,\n                \"include_progress\": False,\n            }],\n        )\n        assert \"Task content here\" in html\n        assert \"ralph-plan-toggle-job\" not in html\n        assert \"ralph-progress-toggle-job\" not in html\n\n    def test_generate_html_mixed_features_and_ralph(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"my_feature\", requirements=\"# Reqs\\n- Item 1\")\n        _setup_ralph_job(tmp_path, \"my-ralph\", task=\"Ralph task\")\n\n        html = ExportService.generate_export_html(\n            project_name=\"MixedTest\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"my_feature\", \"diagrams\": []}],\n            selected_ralph_jobs=[{\"slug\": \"my-ralph\"}],\n        )\n        assert \"my_feature\" in html\n        assert \"Ralph task\" in html\n        assert \"Ralph Job\" in html\n\n\nclass TestExportRalphRoutes:\n    @pytest.fixture\n    def ralph_client(self, tmp_path):\n        \"\"\"Create a test client with Ralph jobs.\"\"\"\n        _setup_ralph_job(\n            tmp_path, \"test-build\",\n            job_meta={\"mode\": \"build\", \"status\": \"completed\"},\n            task=\"Build the feature\",\n            plan=\"# Plan\\n## Phase 1\",\n            progress=\"Iteration 1: done\",\n        )\n\n        mock_project = MagicMock()\n        mock_project.id = \"test-456\"\n        mock_project.name = \"RalphProject\"\n        mock_project.path = str(tmp_path)\n\n        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n            mock_ps.get_by_id.return_value = mock_project\n\n            from fastapi.testclient import TestClient\n            from fastapi import FastAPI\n\n            app = FastAPI()\n            from server.routes.export import router\n            app.include_router(router)\n\n            yield TestClient(app), mock_ps\n\n    def test_get_ralph_jobs_endpoint(self, ralph_client):\n        test_client, _ = ralph_client\n        resp = test_client.get(\"/api/projects/test-456/export/ralph-jobs\")\n        assert resp.status_code == 200\n        data = resp.json()\n        assert len(data) == 1\n        assert data[0][\"slug\"] == \"test-build\"\n        assert data[0][\"has_task\"] is True\n        assert data[0][\"has_plan\"] is True\n\n    def test_export_with_ralph_jobs(self, ralph_client):\n        test_client, _ = ralph_client\n        resp = test_client.post(\"/api/projects/test-456/export\", json={\n            \"features\": [],\n            \"ralph_jobs\": [{\"slug\": \"test-build\"}],\n        })\n        assert resp.status_code == 200\n        assert \"<!DOCTYPE html>\" in resp.text\n        assert \"Build the feature\" in resp.text\n","numLines":594,"startLine":1,"totalLines":594}}}
