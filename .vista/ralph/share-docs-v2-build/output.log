{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ebe9MR4nDQoeXuibffoKup","type":"tool_result","content":"     1→\"\"\"Export routes for generating self-contained HTML documentation.\"\"\"\n     2→import logging\n     3→from datetime import datetime\n     4→\n     5→from fastapi import APIRouter, HTTPException\n     6→from fastapi.responses import Response\n     7→from pydantic import BaseModel\n     8→\n     9→from server.services.export_service import ExportService\n    10→from server.services.project_service import ProjectService\n    11→\n    12→logger = logging.getLogger(__name__)\n    13→router = APIRouter()\n    14→\n    15→\n    16→class ExportFeatureSelection(BaseModel):\n    17→    name: str\n    18→    diagrams: list[str]\n    19→\n    20→\n    21→class ExportRequest(BaseModel):\n    22→    features: list[ExportFeatureSelection]\n    23→\n    24→\n    25→@router.get(\"/api/projects/{project_id}/export/features\")\n    26→async def get_export_features(project_id: str):\n    27→    \"\"\"Return the feature tree for the export modal checklist.\"\"\"\n    28→    project = ProjectService.get_by_id(project_id)\n    29→    if not project:\n    30→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    31→    return ExportService.get_exportable_features(project.path)\n    32→\n    33→\n    34→@router.post(\"/api/projects/{project_id}/export\")\n    35→async def export_documentation(project_id: str, body: ExportRequest):\n    36→    \"\"\"Generate and return the exported HTML documentation file.\"\"\"\n    37→    project = ProjectService.get_by_id(project_id)\n    38→    if not project:\n    39→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    40→\n    41→    html = ExportService.generate_export_html(\n    42→        project_name=project.name,\n    43→        project_path=project.path,\n    44→        selected_features=[f.model_dump() for f in body.features],\n    45→    )\n    46→\n    47→    filename = f\"{project.name}-docs-{datetime.now().strftime('%Y-%m-%d')}.html\"\n    48→\n    49→    return Response(\n    50→        content=html,\n    51→        media_type=\"text/html\",\n    52→        headers={\"Content-Disposition\": f'attachment; filename=\"{filename}\"'},\n    53→    )\n    54→"}]},"parent_tool_use_id":null,"session_id":"9de84d10-e2ff-4976-8ef7-e25fd15568bb","uuid":"c5b7d337-4cc2-4fea-bc0c-9fc0476d782c","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Grove\\OneDrive\\Documents\\PYTHON\\claude_plugins\\vista-expanded-visualization\\vista\\server\\routes\\export.py","content":"\"\"\"Export routes for generating self-contained HTML documentation.\"\"\"\nimport logging\nfrom datetime import datetime\n\nfrom fastapi import APIRouter, HTTPException\nfrom fastapi.responses import Response\nfrom pydantic import BaseModel\n\nfrom server.services.export_service import ExportService\nfrom server.services.project_service import ProjectService\n\nlogger = logging.getLogger(__name__)\nrouter = APIRouter()\n\n\nclass ExportFeatureSelection(BaseModel):\n    name: str\n    diagrams: list[str]\n\n\nclass ExportRequest(BaseModel):\n    features: list[ExportFeatureSelection]\n\n\n@router.get(\"/api/projects/{project_id}/export/features\")\nasync def get_export_features(project_id: str):\n    \"\"\"Return the feature tree for the export modal checklist.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n    return ExportService.get_exportable_features(project.path)\n\n\n@router.post(\"/api/projects/{project_id}/export\")\nasync def export_documentation(project_id: str, body: ExportRequest):\n    \"\"\"Generate and return the exported HTML documentation file.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    html = ExportService.generate_export_html(\n        project_name=project.name,\n        project_path=project.path,\n        selected_features=[f.model_dump() for f in body.features],\n    )\n\n    filename = f\"{project.name}-docs-{datetime.now().strftime('%Y-%m-%d')}.html\"\n\n    return Response(\n        content=html,\n        media_type=\"text/html\",\n        headers={\"Content-Disposition\": f'attachment; filename=\"{filename}\"'},\n    )\n","numLines":54,"startLine":1,"totalLines":54}}}
