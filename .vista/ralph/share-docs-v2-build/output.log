{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_012UP3zg4rgjTMXUGtKSpR5d","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Je63aco7AsW3NgAAoXpXL4","name":"Edit","input":{"replace_all":false,"file_path":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/views/project.html","old_string":"    const selected = collectSelectedFeatures();\n    const selectedRalph = collectSelectedRalphJobs();\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/export`, {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ features: selected, ralph_jobs: selectedRalph }),\n        });","new_string":"    const selected = collectSelectedFeatures();\n    const selectedRalph = collectSelectedRalphJobs();\n    const offline = document.getElementById('export-offline-cb')?.checked || false;\n    const defaultTheme = document.getElementById('export-theme-select')?.value || 'dark';\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/export`, {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ features: selected, ralph_jobs: selectedRalph, offline, default_theme: defaultTheme }),\n        });"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1061,"cache_read_input_tokens":100958,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1061},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"6996de78-f515-44c4-bca3-90f28086b3f0","uuid":"a8c0ab27-0718-4ae3-a07f-0dcfa5ed78c3"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Je63aco7AsW3NgAAoXpXL4","type":"tool_result","content":"The file C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/views/project.html has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"6996de78-f515-44c4-bca3-90f28086b3f0","uuid":"39f0a422-521a-438c-ba0d-4489c18dfdf6","tool_use_result":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/views/project.html","oldString":"    const selected = collectSelectedFeatures();\n    const selectedRalph = collectSelectedRalphJobs();\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/export`, {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ features: selected, ralph_jobs: selectedRalph }),\n        });","newString":"    const selected = collectSelectedFeatures();\n    const selectedRalph = collectSelectedRalphJobs();\n    const offline = document.getElementById('export-offline-cb')?.checked || false;\n    const defaultTheme = document.getElementById('export-theme-select')?.value || 'dark';\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/export`, {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ features: selected, ralph_jobs: selectedRalph, offline, default_theme: defaultTheme }),\n        });","originalFile":"{% extends \"_base.html\" %}\n\n{% block title %}{{ project.name }} - Ralph Loop{% endblock %}\n\n{% block content %}\n<div class=\"mb-8\">\n    <div class=\"flex flex-wrap items-center gap-3 mb-2\">\n        <a href=\"/\" class=\"text-gray-400 hover:text-gray-300\">&larr; Dashboard</a>\n        <span class=\"text-gray-600\">/</span>\n        <h1 class=\"text-3xl font-bold\">{{ project.name }}</h1>\n        <div class=\"ml-auto flex items-center gap-2\">\n            <button onclick=\"openExportModal()\"\n                    class=\"px-3 py-1.5 rounded border border-blue-600 text-blue-300 hover:bg-blue-900/30 text-sm transition-colors\">\n                Export Docs\n            </button>\n            <button onclick=\"removeProject('{{ project.id }}', '{{ project.name }}', '{{ loop_state.status }}')\"\n                    class=\"px-3 py-1.5 rounded border border-gray-600 text-gray-300 hover:border-red-600 hover:text-red-300 text-sm transition-colors\">\n                Remove Project\n            </button>\n        </div>\n    </div>\n    <p class=\"text-gray-400 text-sm\">{{ project.path }}</p>\n</div>\n\n<div class=\"mb-6 border-b border-gray-700\">\n    <div class=\"flex items-center gap-2\" role=\"tablist\">\n        <button id=\"tab-overview-btn\" onclick=\"showProjectTab('overview')\"\n                class=\"project-tab-btn px-4 py-2 text-sm rounded-t-md border border-b-0 border-gray-700 bg-gray-800 text-gray-200\">\n            Overview\n        </button>\n        <button id=\"tab-loops-btn\" onclick=\"showProjectTab('loops')\"\n                class=\"project-tab-btn px-4 py-2 text-sm rounded-t-md border border-b-0 border-gray-700 bg-gray-900 text-gray-400 hover:text-gray-200\">\n            Ralph Loops\n        </button>\n    </div>\n</div>\n\n<section id=\"tab-overview\" class=\"space-y-6\">\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n            <p class=\"text-xs text-gray-400 mb-1\">Features</p>\n            <p class=\"text-2xl font-semibold\">{{ features|length }}</p>\n        </div>\n        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n            <p class=\"text-xs text-gray-400 mb-1\">Loop Status</p>\n            <p class=\"text-2xl font-semibold capitalize\">{{ loop_state.status }}</p>\n        </div>\n        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n            <p class=\"text-xs text-gray-400 mb-1\">Docs Readiness</p>\n            <p class=\"text-2xl font-semibold\">{{ features | selectattr('has_implementation_plan') | list | length }}/{{ features|length }}</p>\n        </div>\n    </div>\n\n    <div class=\"bg-gray-800 rounded-lg border border-gray-700 overflow-hidden\">\n        <div class=\"px-4 py-3 border-b border-gray-700\">\n            <h2 class=\"text-base font-semibold\">Feature Documentation</h2>\n            <p class=\"text-xs text-gray-400 mt-1\">Overview of specs, plans, prompts, and architecture docs</p>\n        </div>\n\n        {% if features %}\n        <div class=\"divide-y divide-gray-700\">\n            {% for feature in features %}\n            <div class=\"px-4 py-3 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3\">\n                <div>\n                    <p class=\"font-medium text-gray-100\">{{ feature.name }}</p>\n                    <div class=\"flex flex-wrap items-center gap-2 mt-1 text-xs\">\n                        <span class=\"px-2 py-0.5 rounded border border-gray-600 text-gray-300\">Specs: {{ feature.spec_count }}</span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_implementation_plan %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            Impl Plan {% if feature.has_implementation_plan %}✓{% else %}—{% endif %}\n                        </span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_agents_md %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            AGENTS.md {% if feature.has_agents_md %}✓{% else %}—{% endif %}\n                        </span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_prompt_build or feature.has_prompt_plan %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            PROMPTs {% if feature.has_prompt_build or feature.has_prompt_plan %}✓{% else %}—{% endif %}\n                        </span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_arch_manifest %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            Arch {% if feature.has_arch_manifest %}{{ feature.arch_diagram_count }}{% else %}—{% endif %}\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2 text-xs\">\n                    <a href=\"/project/{{ project.id }}/plan/{{ feature.name }}\" class=\"px-2.5 py-1 rounded bg-blue-900/50 hover:bg-blue-900/70 text-blue-300 border border-blue-800\">Implementation Plan</a>\n                    {% if feature.has_arch_manifest %}\n                    <a href=\"/project/{{ project.id }}/arch/{{ feature.name }}\" class=\"px-2.5 py-1 rounded bg-green-900/40 hover:bg-green-900/60 text-green-300 border border-green-800\">Architecture</a>\n                    {% endif %}\n                </div>\n            </div>\n            {% endfor %}\n        </div>\n        {% else %}\n        <div class=\"px-4 py-8 text-gray-500 text-sm\">No features found in .vista/features/</div>\n        {% endif %}\n    </div>\n</section>\n\n<section id=\"tab-loops\" class=\"hidden\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div class=\"lg:col-span-1\">\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mb-6\">\n                <h2 class=\"text-lg font-semibold mb-4\">Loop Control</h2>\n\n                {% if loop_state.status in [\"running\", \"starting\"] %}\n                <div class=\"space-y-3 mb-4\">\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Status</span>\n                        <span class=\"text-green-400 font-medium\">{{ loop_state.status }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Feature</span>\n                        <span>{{ loop_state.feature_name }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Provider</span>\n                        <span>{{ loop_state.provider_display_name or loop_state.provider or 'Claude Code' }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Mode</span>\n                        <span>{{ loop_state.mode }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Model</span>\n                        <span>{{ loop_state.model }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Iteration</span>\n                        <span id=\"iteration-display\" class=\"text-green-400 font-mono\">{{ loop_state.iteration }}</span>\n                    </div>\n                </div>\n\n                <button onclick=\"stopLoop()\" class=\"w-full py-2 bg-red-800 hover:bg-red-700 rounded font-medium transition-colors\">\n                    Stop Loop\n                </button>\n\n                {% else %}\n                <form id=\"start-loop-form\" class=\"space-y-4\">\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Feature</label>\n                        <select id=\"feature-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\">\n                            {% for feature in features %}\n                            <option value=\"{{ feature.name }}\">{{ feature.name }}</option>\n                            {% endfor %}\n                            {% if not features %}\n                            <option value=\"\" disabled>No features found</option>\n                            {% endif %}\n                        </select>\n                    </div>\n\n                    {% if providers|length > 1 %}\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Provider</label>\n                        <select id=\"provider-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\" onchange=\"onProviderChange()\">\n                            {% for p in providers %}\n                            <option value=\"{{ p.name }}\">{{ p.display_name }}</option>\n                            {% endfor %}\n                        </select>\n                    </div>\n                    {% else %}\n                    <input type=\"hidden\" id=\"provider-select\" value=\"{{ providers[0].name if providers else 'claude' }}\">\n                    {% endif %}\n\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Mode</label>\n                        <div class=\"flex gap-2\">\n                            <label class=\"flex-1 cursor-pointer\">\n                                <input type=\"radio\" name=\"mode\" value=\"build\" checked class=\"hidden peer\">\n                                <span class=\"block text-center py-2 rounded border border-gray-600 peer-checked:border-green-500 peer-checked:bg-green-900/30 peer-checked:text-green-400 transition-colors\">Build</span>\n                            </label>\n                            <label class=\"flex-1 cursor-pointer\">\n                                <input type=\"radio\" name=\"mode\" value=\"plan\" class=\"hidden peer\">\n                                <span class=\"block text-center py-2 rounded border border-gray-600 peer-checked:border-blue-500 peer-checked:bg-blue-900/30 peer-checked:text-blue-400 transition-colors\">Plan</span>\n                            </label>\n                        </div>\n                    </div>\n\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Model</label>\n                        <select id=\"model-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\"></select>\n                    </div>\n\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Max Iterations (0 = unlimited)</label>\n                        <input type=\"number\" id=\"max-iterations\" value=\"0\" min=\"0\"\n                               class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\">\n                    </div>\n\n                    <button type=\"submit\" class=\"w-full py-2 bg-green-700 hover:bg-green-600 rounded font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-green-700\"\n                            {% if not features %}disabled{% endif %}>\n                        Start Loop\n                    </button>\n                </form>\n                {% endif %}\n\n                <div id=\"loop-error\" class=\"hidden mt-3 text-red-400 text-sm\"></div>\n            </div>\n        </div>\n\n        <div class=\"lg:col-span-2\">\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 overflow-hidden\">\n                <div class=\"flex items-center justify-between px-4 py-2 bg-gray-750 border-b border-gray-700\">\n                    <h2 class=\"text-sm font-semibold text-gray-300\">Terminal Output</h2>\n                    <div class=\"flex items-center gap-2\">\n                        <span id=\"status-badge\" class=\"text-xs text-gray-500\">{{ loop_state.status }}</span>\n                        <button onclick=\"clearTerminal()\" class=\"text-xs text-gray-500 hover:text-gray-300\">Clear</button>\n                    </div>\n                </div>\n                <div id=\"terminal\" class=\"terminal-output p-4 h-[600px] overflow-y-auto font-mono text-sm leading-relaxed\">\n                    <div class=\"text-gray-500\">Waiting for loop output...</div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<!-- Export Modal -->\n<div id=\"export-modal\" class=\"fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center\">\n    <div class=\"bg-gray-800 rounded-lg border border-gray-700 w-full max-w-lg max-h-[80vh] flex flex-col\">\n        <div class=\"px-4 py-3 border-b border-gray-700 flex items-center justify-between\">\n            <h3 class=\"font-semibold\">Export Documentation</h3>\n            <button onclick=\"closeExportModal()\" class=\"text-gray-400 hover:text-white\">&times;</button>\n        </div>\n        <div class=\"flex-1 overflow-y-auto p-4\" id=\"export-tree\">\n            <div class=\"text-gray-500 text-center py-8\">Loading features...</div>\n        </div>\n        <div class=\"px-4 py-3 border-t border-gray-700\">\n            <div class=\"flex items-center justify-between mb-2\">\n                <div class=\"flex items-center gap-3\">\n                    <button onclick=\"selectAllExport(true)\" class=\"text-xs text-blue-400 hover:text-blue-300\">Select All</button>\n                    <button onclick=\"selectAllExport(false)\" class=\"text-xs text-gray-400 hover:text-gray-300\">Deselect All</button>\n                </div>\n                <button id=\"export-download-btn\" onclick=\"startExport()\" disabled\n                        class=\"px-4 py-2 rounded bg-blue-600 hover:bg-blue-500 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed transition-colors\">\n                    Download\n                </button>\n            </div>\n            <div class=\"flex items-center gap-4 pt-2 border-t border-gray-700/50\">\n                <label class=\"flex items-center gap-1.5 cursor-pointer\">\n                    <input type=\"checkbox\" id=\"export-offline-cb\">\n                    <span class=\"text-xs text-gray-400\">Offline mode</span>\n                </label>\n                <label class=\"flex items-center gap-1.5\">\n                    <span class=\"text-xs text-gray-400\">Theme:</span>\n                    <select id=\"export-theme-select\" class=\"bg-gray-700 text-xs text-gray-200 rounded px-1.5 py-0.5 border border-gray-600\">\n                        <option value=\"dark\">Dark</option>\n                        <option value=\"light\">Light</option>\n                    </select>\n                </label>\n            </div>\n        </div>\n    </div>\n</div>\n{% endblock %}\n\n{% block scripts %}\n<script>\nconst PROJECT_ID = '{{ project.id }}';\nconst LOOP_STATUS = '{{ loop_state.status }}';\n\n// Provider names from server (no models yet — those are fetched on-demand)\nconst PROVIDERS = {{ providers | tojson }};\n\nif (LOOP_STATUS === 'running' || LOOP_STATUS === 'starting') {\n    connectSSE(PROJECT_ID);\n}\n\nfunction showProjectTab(tab) {\n    const overview = document.getElementById('tab-overview');\n    const loops = document.getElementById('tab-loops');\n    const overviewBtn = document.getElementById('tab-overview-btn');\n    const loopsBtn = document.getElementById('tab-loops-btn');\n\n    if (tab === 'loops') {\n        overview.classList.add('hidden');\n        loops.classList.remove('hidden');\n        overviewBtn.classList.replace('bg-gray-800', 'bg-gray-900');\n        overviewBtn.classList.replace('text-gray-200', 'text-gray-400');\n        loopsBtn.classList.replace('bg-gray-900', 'bg-gray-800');\n        loopsBtn.classList.replace('text-gray-400', 'text-gray-200');\n        window.location.hash = 'loops';\n        return;\n    }\n\n    loops.classList.add('hidden');\n    overview.classList.remove('hidden');\n    loopsBtn.classList.replace('bg-gray-800', 'bg-gray-900');\n    loopsBtn.classList.replace('text-gray-200', 'text-gray-400');\n    overviewBtn.classList.replace('bg-gray-900', 'bg-gray-800');\n    overviewBtn.classList.replace('text-gray-400', 'text-gray-200');\n    window.location.hash = 'overview';\n}\n\nif (window.location.hash === '#loops') {\n    showProjectTab('loops');\n} else {\n    showProjectTab('overview');\n}\n\n// --- Dynamic model loading ---\n\nlet _modelFetchId = 0;  // Guards against stale responses overwriting newer ones\n\nfunction renderModels(models) {\n    const select = document.getElementById('model-select');\n    if (!select) return;\n    select.innerHTML = '';\n    models.forEach((model) => {\n        const opt = document.createElement('option');\n        opt.value = model;\n        opt.textContent = model;\n        select.appendChild(opt);\n    });\n}\n\nfunction setStartEnabled(enabled) {\n    const btn = document.querySelector('#start-loop-form button[type=\"submit\"]');\n    if (btn) btn.disabled = !enabled;\n}\n\nfunction setModelLoading() {\n    const select = document.getElementById('model-select');\n    if (!select) return;\n    select.innerHTML = '<option disabled selected>Loading models...</option>';\n    setStartEnabled(false);\n}\n\nasync function fetchModels(providerName) {\n    const thisId = ++_modelFetchId;\n    setModelLoading();\n    try {\n        const resp = await fetch(`/api/providers/${providerName}/models`);\n        if (thisId !== _modelFetchId) return;  // Stale response, user switched provider\n        if (!resp.ok) throw new Error('Failed to fetch models');\n        const data = await resp.json();\n        if (thisId !== _modelFetchId) return;\n        if (data.error) {\n            // Server returned models but with an error (e.g. timeout)\n            const select = document.getElementById('model-select');\n            if (select) select.innerHTML = '<option disabled selected>Timed out - click retry</option>';\n            setStartEnabled(false);\n            return;\n        }\n        renderModels(data.models);\n        setStartEnabled(data.models.length > 0);\n    } catch (err) {\n        if (thisId !== _modelFetchId) return;\n        const select = document.getElementById('model-select');\n        if (select) select.innerHTML = '<option disabled selected>Failed to load - click retry</option>';\n        setStartEnabled(false);\n    }\n}\n\nfunction getSelectedProvider() {\n    const sel = document.getElementById('provider-select');\n    return sel ? sel.value : 'claude';\n}\n\nfunction onProviderChange() {\n    fetchModels(getSelectedProvider());\n}\n\nif (document.getElementById('start-loop-form') && PROVIDERS.length > 0) {\n    fetchModels(PROVIDERS[0].name);\n}\n\n// --- Form submission ---\n\ndocument.getElementById('start-loop-form')?.addEventListener('submit', async function(e) {\n    e.preventDefault();\n    const errorEl = document.getElementById('loop-error');\n    errorEl.classList.add('hidden');\n\n    const body = {\n        feature_name: document.getElementById('feature-select').value,\n        mode: document.querySelector('input[name=\"mode\"]:checked').value,\n        model: document.getElementById('model-select').value,\n        provider: getSelectedProvider(),\n        max_iterations: parseInt(document.getElementById('max-iterations').value) || 0,\n    };\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/loop/start`, {\n            method: 'POST',\n            headers: {'Content-Type': 'application/json'},\n            body: JSON.stringify(body)\n        });\n        if (!resp.ok) {\n            const data = await resp.json();\n            throw new Error(data.detail || 'Failed to start loop');\n        }\n        window.location.reload();\n    } catch(err) {\n        errorEl.textContent = err.message;\n        errorEl.classList.remove('hidden');\n    }\n});\n\nasync function stopLoop() {\n    // Close SSE first to prevent reconnection attempts during stop\n    if (currentEventSource) {\n        currentEventSource.close();\n        currentEventSource = null;\n    }\n    await fetch(`/api/projects/${PROJECT_ID}/loop/stop`, {method: 'POST'});\n    window.location.reload();\n}\n\nasync function removeProject(projectId, projectName, loopStatus) {\n    if (loopStatus === 'running' || loopStatus === 'starting') {\n        if (!confirm(`\"${projectName}\" has a running loop. Stop loop and remove from project list?\\n\\nFiles on disk will NOT be deleted.`)) return;\n        await stopLoop();\n        return;\n    }\n\n    if (!confirm(`Remove \"${projectName}\" from project list?\\n\\nFiles on disk will NOT be deleted.`)) return;\n    const resp = await fetch(`/api/projects/${projectId}`, {method: 'DELETE'});\n    if (!resp.ok) {\n        const data = await resp.json().catch(() => ({}));\n        alert(data.detail || 'Failed to remove project');\n        return;\n    }\n    window.location.href = '/';\n}\n\n// =========================================================================\n// Export Modal\n// =========================================================================\n\nlet exportFeatures = [];\nlet exportRalphJobs = [];\n\nasync function openExportModal() {\n    const modal = document.getElementById('export-modal');\n    const tree = document.getElementById('export-tree');\n    modal.classList.remove('hidden');\n    tree.innerHTML = '<div class=\"text-gray-500 text-center py-8\">Loading features...</div>';\n\n    try {\n        const [featResp, ralphResp] = await Promise.all([\n            fetch(`/api/projects/${PROJECT_ID}/export/features`),\n            fetch(`/api/projects/${PROJECT_ID}/export/ralph-jobs`),\n        ]);\n        if (!featResp.ok) throw new Error('Failed to load features');\n        exportFeatures = await featResp.json();\n        exportRalphJobs = ralphResp.ok ? await ralphResp.json() : [];\n\n        if (exportFeatures.length === 0 && exportRalphJobs.length === 0) {\n            tree.innerHTML = '<div class=\"text-gray-500 text-center py-8\">No exportable content found</div>';\n            return;\n        }\n        renderExportTree();\n    } catch (err) {\n        tree.innerHTML = `<div class=\"text-red-400 text-center py-8\">${escapeHtmlExport(err.message)}</div>`;\n    }\n}\n\nfunction closeExportModal() {\n    document.getElementById('export-modal').classList.add('hidden');\n}\n\nfunction renderExportTree() {\n    const tree = document.getElementById('export-tree');\n    let html = '';\n\n    // --- Features ---\n    if (exportFeatures.length > 0) {\n        html += exportFeatures.map((feature, fi) => {\n            const diagrams = feature.diagrams || [];\n            return `\n                <div class=\"mb-3\">\n                    <div class=\"flex items-center gap-2 mb-1\">\n                        <button onclick=\"toggleFeatureExpand(${fi})\"\n                                class=\"text-gray-400 hover:text-gray-200 text-xs w-5 text-center\"\n                                id=\"expand-btn-${fi}\">\\u25B6</button>\n                        <label class=\"flex items-center gap-2 cursor-pointer flex-1\">\n                            <input type=\"checkbox\" class=\"feature-cb\" data-fi=\"${fi}\"\n                                   onchange=\"onFeatureToggle(${fi})\" checked>\n                            <span class=\"text-sm font-medium\">${escapeHtmlExport(feature.name)}</span>\n                            <span class=\"text-xs text-gray-500\">${diagrams.length} diagram${diagrams.length !== 1 ? 's' : ''}</span>\n                            ${feature.has_requirements ? '<span class=\"text-xs text-green-600\">+ requirements</span>' : ''}\n                            ${feature.has_progress ? '<span class=\"text-xs text-yellow-600\">+ progress</span>' : ''}\n                            ${feature.has_agents_md ? '<span class=\"text-xs text-purple-600\">+ agents</span>' : ''}\n                            ${feature.has_implementation_plan ? '<span class=\"text-xs text-blue-600\">+ plan</span>' : ''}\n                        </label>\n                    </div>\n                    <div id=\"diagrams-${fi}\" class=\"ml-7 hidden space-y-1\">\n                        ${diagrams.map((d, di) => `\n                            <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n                                <input type=\"checkbox\" class=\"diagram-cb\" data-fi=\"${fi}\" data-di=\"${di}\" checked\n                                       onchange=\"onDiagramToggle(${fi})\">\n                                <span class=\"text-xs text-gray-300\">${escapeHtmlExport(d.name)}</span>\n                                <span class=\"text-xs text-gray-600 truncate\">${escapeHtmlExport(d.description || '')}</span>\n                            </label>\n                        `).join('')}\n                        ${feature.has_requirements ? `\n                            <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n                                <input type=\"checkbox\" class=\"content-cb\" data-fi=\"${fi}\" data-type=\"requirements\" checked>\n                                <span class=\"text-xs text-green-500\">Domain Requirements</span>\n                            </label>` : ''}\n                        ${feature.has_progress ? `\n                            <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n                                <input type=\"checkbox\" class=\"content-cb\" data-fi=\"${fi}\" data-type=\"progress\" checked>\n                                <span class=\"text-xs text-yellow-500\">Progress Log</span>\n                            </label>` : ''}\n                        ${feature.has_agents_md ? `\n                            <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n                                <input type=\"checkbox\" class=\"content-cb\" data-fi=\"${fi}\" data-type=\"agents\" checked>\n                                <span class=\"text-xs text-purple-500\">Agents</span>\n                            </label>` : ''}\n                        ${feature.has_implementation_plan ? `\n                            <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n                                <input type=\"checkbox\" class=\"content-cb\" data-fi=\"${fi}\" data-type=\"plan\" checked>\n                                <span class=\"text-xs text-blue-500\">Implementation Plan</span>\n                            </label>` : ''}\n                    </div>\n                </div>\n            `;\n        }).join('');\n    }\n\n    // --- Ralph Jobs ---\n    if (exportRalphJobs.length > 0) {\n        html += '<div class=\"border-t border-gray-700 mt-4 pt-3 mb-2\"><span class=\"text-xs font-semibold uppercase tracking-wider text-orange-400\">Ralph Jobs</span></div>';\n        html += exportRalphJobs.map((job, ri) => {\n            const statusColor = job.status === 'completed' ? 'text-green-500' : job.status === 'running' ? 'text-blue-500' : 'text-gray-500';\n            return `\n                <div class=\"mb-3\">\n                    <div class=\"flex items-center gap-2 mb-1\">\n                        <button onclick=\"toggleRalphExpand(${ri})\"\n                                class=\"text-gray-400 hover:text-gray-200 text-xs w-5 text-center\"\n                                id=\"ralph-expand-btn-${ri}\">\\u25B6</button>\n                        <label class=\"flex items-center gap-2 cursor-pointer flex-1\">\n                            <input type=\"checkbox\" class=\"ralph-cb\" data-ri=\"${ri}\"\n                                   onchange=\"updateDownloadButton()\" checked>\n                            <span class=\"text-sm font-medium\">${escapeHtmlExport(job.slug)}</span>\n                            ${job.mode ? `<span class=\"text-xs text-gray-500\">${escapeHtmlExport(job.mode)}</span>` : ''}\n                            ${job.status ? `<span class=\"text-xs ${statusColor}\">${escapeHtmlExport(job.status)}</span>` : ''}\n                        </label>\n                    </div>\n                    <div id=\"ralph-items-${ri}\" class=\"ml-7 hidden space-y-1\">\n                        ${job.has_task ? `\n                            <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n                                <input type=\"checkbox\" class=\"ralph-content-cb\" data-ri=\"${ri}\" data-type=\"task\" checked>\n                                <span class=\"text-xs text-orange-400\">Task Description</span>\n                            </label>` : ''}\n                        ${job.has_plan ? `\n                            <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n                                <input type=\"checkbox\" class=\"ralph-content-cb\" data-ri=\"${ri}\" data-type=\"plan\" checked>\n                                <span class=\"text-xs text-blue-500\">Implementation Plan</span>\n                            </label>` : ''}\n                        ${job.has_progress ? `\n                            <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n                                <input type=\"checkbox\" class=\"ralph-content-cb\" data-ri=\"${ri}\" data-type=\"progress\" checked>\n                                <span class=\"text-xs text-yellow-500\">Progress Log</span>\n                            </label>` : ''}\n                    </div>\n                </div>\n            `;\n        }).join('');\n    }\n\n    tree.innerHTML = html;\n    updateDownloadButton();\n}\n\nfunction toggleRalphExpand(ri) {\n    const el = document.getElementById(`ralph-items-${ri}`);\n    const btn = document.getElementById(`ralph-expand-btn-${ri}`);\n    if (el.classList.contains('hidden')) {\n        el.classList.remove('hidden');\n        btn.textContent = '\\u25BC';\n    } else {\n        el.classList.add('hidden');\n        btn.textContent = '\\u25B6';\n    }\n}\n\nfunction toggleFeatureExpand(fi) {\n    const el = document.getElementById(`diagrams-${fi}`);\n    const btn = document.getElementById(`expand-btn-${fi}`);\n    if (el.classList.contains('hidden')) {\n        el.classList.remove('hidden');\n        btn.textContent = '\\u25BC';\n    } else {\n        el.classList.add('hidden');\n        btn.textContent = '\\u25B6';\n    }\n}\n\nfunction onFeatureToggle(fi) {\n    const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n    const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]`);\n    diagramCbs.forEach(cb => cb.checked = featureCb.checked);\n    updateDownloadButton();\n}\n\nfunction onDiagramToggle(fi) {\n    const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n    const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]`);\n    const checked = [...diagramCbs].filter(cb => cb.checked).length;\n    featureCb.checked = checked > 0;\n    featureCb.indeterminate = checked > 0 && checked < diagramCbs.length;\n    updateDownloadButton();\n}\n\nfunction selectAllExport(select) {\n    document.querySelectorAll('.feature-cb, .diagram-cb, .content-cb, .ralph-cb, .ralph-content-cb').forEach(cb => {\n        cb.checked = select;\n        cb.indeterminate = false;\n    });\n    updateDownloadButton();\n}\n\nfunction updateDownloadButton() {\n    const anyFeature = document.querySelectorAll('.feature-cb:checked').length > 0;\n    const anyRalph = document.querySelectorAll('.ralph-cb:checked').length > 0;\n    document.getElementById('export-download-btn').disabled = !(anyFeature || anyRalph);\n}\n\nfunction collectSelectedFeatures() {\n    return exportFeatures.map((feature, fi) => {\n        const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n        if (!featureCb.checked && !featureCb.indeterminate) return null;\n\n        const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]:checked`);\n        const selectedDiagrams = [...diagramCbs].map(cb => {\n            const di = parseInt(cb.dataset.di);\n            return feature.diagrams[di].file;\n        });\n\n        const getContentToggle = (type) => {\n            const cb = document.querySelector(`.content-cb[data-fi=\"${fi}\"][data-type=\"${type}\"]`);\n            return cb ? cb.checked : true;\n        };\n\n        return {\n            name: feature.name,\n            diagrams: selectedDiagrams,\n            include_requirements: getContentToggle('requirements'),\n            include_progress: getContentToggle('progress'),\n            include_agents: getContentToggle('agents'),\n            include_implementation_plan: getContentToggle('plan'),\n        };\n    }).filter(Boolean);\n}\n\nfunction collectSelectedRalphJobs() {\n    return exportRalphJobs.map((job, ri) => {\n        const cb = document.querySelector(`.ralph-cb[data-ri=\"${ri}\"]`);\n        if (!cb || !cb.checked) return null;\n\n        const getToggle = (type) => {\n            const tcb = document.querySelector(`.ralph-content-cb[data-ri=\"${ri}\"][data-type=\"${type}\"]`);\n            return tcb ? tcb.checked : true;\n        };\n\n        return {\n            slug: job.slug,\n            include_task: getToggle('task'),\n            include_plan: getToggle('plan'),\n            include_progress: getToggle('progress'),\n        };\n    }).filter(Boolean);\n}\n\nasync function startExport() {\n    const btn = document.getElementById('export-download-btn');\n    const origText = btn.textContent;\n    btn.disabled = true;\n    btn.textContent = 'Generating...';\n\n    const selected = collectSelectedFeatures();\n    const selectedRalph = collectSelectedRalphJobs();\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/export`, {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ features: selected, ralph_jobs: selectedRalph }),\n        });\n\n        if (!resp.ok) throw new Error('Export failed');\n\n        const blob = await resp.blob();\n        const url = URL.createObjectURL(blob);\n        const a = document.createElement('a');\n        a.href = url;\n        a.download = resp.headers.get('Content-Disposition')\n            ?.match(/filename=\"(.+?)\"/)?.[1] || 'export.html';\n        document.body.appendChild(a);\n        a.click();\n        a.remove();\n        URL.revokeObjectURL(url);\n\n        closeExportModal();\n    } catch (err) {\n        alert('Export failed: ' + err.message);\n    } finally {\n        btn.disabled = false;\n        btn.textContent = origText;\n    }\n}\n\nfunction escapeHtmlExport(str) {\n    if (!str) return '';\n    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n}\n</script>\n{% endblock %}\n","structuredPatch":[{"oldStart":670,"oldLines":12,"newStart":670,"newLines":14,"lines":[" ","     const selected = collectSelectedFeatures();","     const selectedRalph = collectSelectedRalphJobs();","+    const offline = document.getElementById('export-offline-cb')?.checked || false;","+    const defaultTheme = document.getElementById('export-theme-select')?.value || 'dark';"," ","     try {","         const resp = await fetch(`/api/projects/${PROJECT_ID}/export`, {","             method: 'POST',","             headers: { 'Content-Type': 'application/json' },","-            body: JSON.stringify({ features: selected, ralph_jobs: selectedRalph }),","+            body: JSON.stringify({ features: selected, ralph_jobs: selectedRalph, offline, default_theme: defaultTheme }),","         });"," ","         if (!resp.ok) throw new Error('Export failed');"]}],"userModified":false,"replaceAll":false}}
