{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018aXLJKGX6DLdMx8BXCQKZn","type":"tool_result","content":"     1→\"\"\"Server configuration. All paths computed relative to plugin root.\"\"\"\n     2→\n     3→import json\n     4→import os\n     5→import platform\n     6→from pathlib import Path\n     7→\n     8→# Directory structure\n     9→PLUGIN_ROOT = Path(__file__).resolve().parent.parent  # plugin_1/\n    10→SERVER_DIR = Path(__file__).resolve().parent  # plugin_1/server/\n    11→PORTABLE_DIR = PLUGIN_ROOT / \"portable\"\n    12→TEMPLATES_DIR = PORTABLE_DIR / \"templates\"\n    13→DATA_DIR = Path.home() / \".vista\" / \"data\"\n    14→PROJECTS_FILE = DATA_DIR / \"projects.json\"\n    15→_LEGACY_DATA_DIR = SERVER_DIR / \"data\"  # pre-1.3.12: inside plugin install dir\n    16→VIEWS_DIR = SERVER_DIR / \"views\"\n    17→STATIC_DIR = VIEWS_DIR / \"static\"\n    18→\n    19→# Settings file\n    20→LEGACY_SETTINGS_FILE = PLUGIN_ROOT / \"settings.json\"\n    21→\n    22→\n    23→def _resolve_settings_file() -> Path:\n    24→    \"\"\"Return persistent settings path outside app install directory.\n    25→\n    26→    Users can override via ``VISTA_SETTINGS_FILE`` for advanced setups.\n    27→    \"\"\"\n    28→    override = os.environ.get(\"VISTA_SETTINGS_FILE\", \"\").strip()\n    29→    if override:\n    30→        return Path(override).expanduser().resolve()\n    31→\n    32→    return Path.home() / \".vista\" / \"settings.json\"\n    33→\n    34→\n    35→_DEFAULT_SETTINGS_FILE = _resolve_settings_file()\n    36→SETTINGS_FILE = _DEFAULT_SETTINGS_FILE\n    37→\n    38→_SERVER_DEFAULTS = {\n    39→    \"auto_start\": True,\n    40→    \"auto_open_browser\": True,\n    41→    \"host\": \"127.0.0.1\",\n    42→    \"port\": 3456,\n    43→}\n    44→\n    45→_RALPH_DEFAULTS = {\n    46→    \"defaults\": {\n    47→        \"provider\": \"claude\",\n    48→        \"model\": \"sonnet\",\n    49→        \"iterations\": 3,\n    50→    },\n    51→    \"summarizer\": {\n    52→        \"provider\": \"claude\",\n    53→        \"model\": \"haiku\",\n    54→    },\n    55→    \"providers\": {},\n    56→}\n    57→\n    58→_SANDBOX_DEFAULTS = {\n    59→    \"enabled\": False,\n    60→    \"image\": \"vista-ralph:latest\",\n    61→    \"network_enabled\": True,\n    62→    \"ttl_seconds\": 7200,\n    63→    \"credential_mounts\": {\n    64→        \"claude_auth\": {\"enabled\": True},\n    65→        \"git_ssh\": {\"enabled\": True},\n    66→        \"git_config\": {\"enabled\": True},\n    67→        \"gh_cli\": {\"enabled\": True},\n    68→        \"opencode\": {\"enabled\": True},\n    69→    },\n    70→}\n    71→\n    72→_TOOLS_DEFAULTS = {\n    73→    \"teams\": {\n    74→        \"claude_binary\": None,\n    75→        \"opencode_url\": None,\n    76→        \"opencode_auto_start\": True,\n    77→        \"opencode_port\": 4200,\n    78→    },\n    79→    \"ralph\": {},\n    80→}\n    81→\n    82→\n    83→def get_tools_settings() -> dict:\n    84→    \"\"\"Return merged tools settings with defaults applied.\"\"\"\n    85→    raw = load_settings().get(\"tools\", {})\n    86→    if not isinstance(raw, dict):\n    87→        raw = {}\n    88→    return _merge_dicts(_TOOLS_DEFAULTS, raw)\n    89→\n    90→\n    91→_DIAGRAM_DEFAULTS = {\n    92→    \"plantuml_server_url\": \"https://www.plantuml.com/plantuml\",\n    93→}\n    94→\n    95→\n    96→def get_diagram_settings() -> dict:\n    97→    \"\"\"Return merged diagram settings with defaults applied.\"\"\"\n    98→    raw = load_settings().get(\"diagrams\", {})\n    99→    if not isinstance(raw, dict):\n   100→        raw = {}\n   101→    return _merge_dicts(_DIAGRAM_DEFAULTS, raw)\n   102→\n   103→\n   104→_CHAT_DEFAULTS = {\n   105→    \"companion_port\": 3457,\n   106→    \"opencode_port\": 4096,\n   107→}\n   108→\n   109→\n   110→def get_chat_settings() -> dict:\n   111→    \"\"\"Return chat backend service configuration.\"\"\"\n   112→    raw = load_settings().get(\"chat\", {})\n   113→    if not isinstance(raw, dict):\n   114→        raw = {}\n   115→    return _merge_dicts(_CHAT_DEFAULTS, raw)\n   116→\n   117→\n   118→def load_settings() -> dict:\n   119→    \"\"\"Load settings.json from PLUGIN_ROOT, returning {} on failure.\"\"\"\n   120→    _migrate_legacy_settings_if_needed()\n   121→    if SETTINGS_FILE.exists():\n   122→        try:\n   123→            return json.loads(SETTINGS_FILE.read_text(encoding=\"utf-8\"))\n   124→        except (json.JSONDecodeError, OSError):\n   125→            pass\n   126→    return {}\n   127→\n   128→\n   129→def _migrate_legacy_settings_if_needed() -> None:\n   130→    \"\"\"Migrate settings from legacy plugin-local file to persistent location.\n   131→\n   132→    Migration runs only for the default persistent path, so tests and custom\n   133→    overrides that patch ``SETTINGS_FILE`` are unaffected.\n   134→    \"\"\"\n   135→    if SETTINGS_FILE != _DEFAULT_SETTINGS_FILE:\n   136→        return\n   137→    if SETTINGS_FILE == LEGACY_SETTINGS_FILE:\n   138→        return\n   139→    if SETTINGS_FILE.exists() or not LEGACY_SETTINGS_FILE.exists():\n   140→        return\n   141→\n   142→    try:\n   143→        SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n   144→        SETTINGS_FILE.write_text(\n   145→            LEGACY_SETTINGS_FILE.read_text(encoding=\"utf-8\"), encoding=\"utf-8\"\n   146→        )\n   147→    except OSError:\n   148→        # Non-fatal: app can still proceed with defaults.\n   149→        return\n   150→\n   151→\n   152→def _merge_dicts(base: dict, overlay: dict) -> dict:\n   153→    merged = dict(base)\n   154→    for key, value in overlay.items():\n   155→        if isinstance(value, dict) and isinstance(merged.get(key), dict):\n   156→            merged[key] = _merge_dicts(merged[key], value)\n   157→        else:\n   158→            merged[key] = value\n   159→    return merged\n   160→\n   161→\n   162→def get_ralph_settings() -> dict:\n   163→    \"\"\"Return merged ralph settings with defaults applied.\"\"\"\n   164→    raw = load_settings().get(\"ralph\", {})\n   165→    if not isinstance(raw, dict):\n   166→        raw = {}\n   167→    return _merge_dicts(_RALPH_DEFAULTS, raw)\n   168→\n   169→\n   170→def get_ralph_defaults() -> dict:\n   171→    \"\"\"Return default provider/model/iterations for ralph_start.\"\"\"\n   172→    settings = get_ralph_settings().get(\"defaults\", {})\n   173→    defaults = dict(_RALPH_DEFAULTS[\"defaults\"])\n   174→    defaults.update({k: v for k, v in settings.items() if v is not None})\n   175→    iterations = defaults.get(\"iterations\")\n   176→    if not isinstance(iterations, int) or iterations <= 0:\n   177→        defaults[\"iterations\"] = _RALPH_DEFAULTS[\"defaults\"][\"iterations\"]\n   178→    return defaults\n   179→\n   180→\n   181→def get_summarizer_config() -> dict:\n   182→    \"\"\"Return summarizer provider/model configuration.\"\"\"\n   183→    settings = get_ralph_settings().get(\"summarizer\", {})\n   184→    config = dict(_RALPH_DEFAULTS[\"summarizer\"])\n   185→    config.update({k: v for k, v in settings.items() if v})\n   186→    return config\n   187→\n   188→\n   189→def save_ralph_settings(ralph_config: dict) -> None:\n   190→    \"\"\"Write the ralph section back to settings.json, preserving other sections.\"\"\"\n   191→    _migrate_legacy_settings_if_needed()\n   192→    settings = load_settings()\n   193→    settings[\"ralph\"] = ralph_config\n   194→    SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n   195→    tmp_file = SETTINGS_FILE.with_suffix(\".json.tmp\")\n   196→    tmp_file.write_text(json.dumps(settings, indent=2), encoding=\"utf-8\")\n   197→    tmp_file.replace(SETTINGS_FILE)\n   198→\n   199→\n   200→def get_sandbox_settings() -> dict:\n   201→    \"\"\"Return merged sandbox settings with defaults applied.\"\"\"\n   202→    raw = get_ralph_settings().get(\"sandbox\", {})\n   203→    if not isinstance(raw, dict):\n   204→        raw = {}\n   205→    return _merge_dicts(_SANDBOX_DEFAULTS, raw)\n   206→\n   207→\n   208→def is_sandbox_enabled() -> bool:\n   209→    \"\"\"Check whether sandbox mode is enabled.\"\"\"\n   210→    return bool(get_sandbox_settings().get(\"enabled\", False))\n   211→\n   212→\n   213→def get_sandbox_credential_mounts() -> dict:\n   214→    \"\"\"Return the credential_mounts section of sandbox settings.\"\"\"\n   215→    return get_sandbox_settings().get(\"credential_mounts\", {})\n   216→\n   217→\n   218→def save_sandbox_settings(sandbox_config: dict) -> None:\n   219→    \"\"\"Write sandbox section under ralph settings, preserving other sections.\"\"\"\n   220→    ralph = get_ralph_settings()\n   221→    ralph[\"sandbox\"] = sandbox_config\n   222→    save_ralph_settings(ralph)\n   223→\n   224→\n   225→def validate_sandbox_settings(config_dict: dict) -> list[str]:\n   226→    \"\"\"Validate sandbox settings. Returns list of error strings (empty = valid).\"\"\"\n   227→    errors: list[str] = []\n   228→\n   229→    if \"enabled\" in config_dict and not isinstance(config_dict[\"enabled\"], bool):\n   230→        errors.append(\"'enabled' must be a boolean\")\n   231→\n   232→    if \"image\" in config_dict:\n   233→        if (\n   234→            not isinstance(config_dict[\"image\"], str)\n   235→            or not config_dict[\"image\"].strip()\n   236→        ):\n   237→            errors.append(\"'image' must be a non-empty string\")\n   238→\n   239→    if \"network_enabled\" in config_dict and not isinstance(\n   240→        config_dict[\"network_enabled\"], bool\n   241→    ):\n   242→        errors.append(\"'network_enabled' must be a boolean\")\n   243→\n   244→    if \"ttl_seconds\" in config_dict:\n   245→        ttl = config_dict[\"ttl_seconds\"]\n   246→        if not isinstance(ttl, int) or ttl <= 0:\n   247→            errors.append(\"'ttl_seconds' must be a positive integer\")\n   248→\n   249→    if \"credential_mounts\" in config_dict:\n   250→        creds = config_dict[\"credential_mounts\"]\n   251→        if not isinstance(creds, dict):\n   252→            errors.append(\"'credential_mounts' must be a dict\")\n   253→        else:\n   254→            for name, entry in creds.items():\n   255→                if not isinstance(entry, dict):\n   256→                    errors.append(f\"credential_mounts.{name} must be a dict\")\n   257→                elif \"enabled\" in entry and not isinstance(entry[\"enabled\"], bool):\n   258→                    errors.append(f\"credential_mounts.{name}.enabled must be a boolean\")\n   259→\n   260→    return errors\n   261→\n   262→\n   263→def get_server_settings() -> dict:\n   264→    \"\"\"Return merged server settings.  Priority: env vars > settings.json > defaults.\"\"\"\n   265→    settings = load_settings().get(\"server\", {})\n   266→    merged = {**_SERVER_DEFAULTS, **settings}\n   267→\n   268→    # Env var overrides (match existing RALPH_SERVER_* convention)\n   269→    pytest_test = os.environ.get(\"PYTEST_CURRENT_TEST\")\n   270→    allow_env_overrides = True\n   271→    if pytest_test and \"env_var\" not in pytest_test:\n   272→        allow_env_overrides = False\n   273→    if allow_env_overrides:\n   274→        if \"RALPH_SERVER_HOST\" in os.environ:\n   275→            merged[\"host\"] = os.environ[\"RALPH_SERVER_HOST\"]\n   276→        if \"RALPH_SERVER_PORT\" in os.environ:\n   277→            merged[\"port\"] = int(os.environ[\"RALPH_SERVER_PORT\"])\n   278→        if \"RALPH_SERVER_AUTO_START\" in os.environ:\n   279→            merged[\"auto_start\"] = os.environ[\"RALPH_SERVER_AUTO_START\"].lower() in (\n   280→                \"1\",\n   281→                \"true\",\n   282→                \"yes\",\n   283→            )\n   284→        if \"RALPH_SERVER_AUTO_OPEN\" in os.environ:\n   285→            merged[\"auto_open_browser\"] = os.environ[\n   286→                \"RALPH_SERVER_AUTO_OPEN\"\n   287→            ].lower() in (\n   288→                \"1\",\n   289→                \"true\",\n   290→                \"yes\",\n   291→            )\n   292→    if (\n   293→        \"PYTEST_CURRENT_TEST\" in os.environ\n   294→        and \"RALPH_SERVER_AUTO_OPEN\" not in os.environ\n   295→        and \"PYTEST_DISABLE_AUTO_OPEN\" in os.environ\n   296→        and \"env_var\" not in os.environ.get(\"PYTEST_CURRENT_TEST\", \"\")\n   297→    ):\n   298→        merged[\"auto_open_browser\"] = _SERVER_DEFAULTS[\"auto_open_browser\"]\n   299→\n   300→    return merged\n   301→\n   302→\n   303→def ensure_full_path() -> None:\n   304→    \"\"\"On Windows, merge the full system+user PATH from the registry.\n   305→\n   306→    Some launch contexts (e.g. git-bash, certain IDE sandboxes) have a\n   307→    stripped-down PATH missing entries like nodejs/ and npm/. The Windows\n   308→    registry holds the authoritative PATH. Merging it ensures subprocesses\n   309→    like ``claude`` and ``opencode`` can find their dependencies.\n   310→\n   311→    Safe to call multiple times; subsequent calls are no-ops.\n   312→    \"\"\"\n   313→    if platform.system() != \"Windows\":\n   314→        return\n   315→    try:\n   316→        import winreg\n   317→    except ImportError:\n   318→        return\n   319→\n   320→    registry_dirs: list[str] = []\n   321→    for hive, subkey in [\n   322→        (\n   323→            winreg.HKEY_LOCAL_MACHINE,\n   324→            r\"SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\",\n   325→        ),\n   326→        (winreg.HKEY_CURRENT_USER, r\"Environment\"),\n   327→    ]:\n   328→        try:\n   329→            key = winreg.OpenKey(hive, subkey)\n   330→            raw = winreg.QueryValueEx(key, \"Path\")[0]\n   331→            winreg.CloseKey(key)\n   332→            registry_dirs.extend(\n   333→                os.path.expandvars(d) for d in raw.split(\";\") if d.strip()\n   334→            )\n   335→        except OSError:\n   336→            continue\n   337→\n   338→    current = set(os.environ.get(\"PATH\", \"\").split(\";\"))\n   339→    new_dirs = [d for d in registry_dirs if d not in current and os.path.isdir(d)]\n   340→    if new_dirs:\n   341→        os.environ[\"PATH\"] = os.environ.get(\"PATH\", \"\") + \";\" + \";\".join(new_dirs)\n   342→\n   343→\n   344→# Module-level HOST / PORT for backward compatibility\n   345→_server = get_server_settings()\n   346→HOST = _server[\"host\"]\n   347→PORT = _server[\"port\"]\n   348→"}]},"parent_tool_use_id":null,"session_id":"6996de78-f515-44c4-bca3-90f28086b3f0","uuid":"6eaf9ac8-379a-4cab-ba92-1563b76765a3","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/config.py","content":"\"\"\"Server configuration. All paths computed relative to plugin root.\"\"\"\n\nimport json\nimport os\nimport platform\nfrom pathlib import Path\n\n# Directory structure\nPLUGIN_ROOT = Path(__file__).resolve().parent.parent  # plugin_1/\nSERVER_DIR = Path(__file__).resolve().parent  # plugin_1/server/\nPORTABLE_DIR = PLUGIN_ROOT / \"portable\"\nTEMPLATES_DIR = PORTABLE_DIR / \"templates\"\nDATA_DIR = Path.home() / \".vista\" / \"data\"\nPROJECTS_FILE = DATA_DIR / \"projects.json\"\n_LEGACY_DATA_DIR = SERVER_DIR / \"data\"  # pre-1.3.12: inside plugin install dir\nVIEWS_DIR = SERVER_DIR / \"views\"\nSTATIC_DIR = VIEWS_DIR / \"static\"\n\n# Settings file\nLEGACY_SETTINGS_FILE = PLUGIN_ROOT / \"settings.json\"\n\n\ndef _resolve_settings_file() -> Path:\n    \"\"\"Return persistent settings path outside app install directory.\n\n    Users can override via ``VISTA_SETTINGS_FILE`` for advanced setups.\n    \"\"\"\n    override = os.environ.get(\"VISTA_SETTINGS_FILE\", \"\").strip()\n    if override:\n        return Path(override).expanduser().resolve()\n\n    return Path.home() / \".vista\" / \"settings.json\"\n\n\n_DEFAULT_SETTINGS_FILE = _resolve_settings_file()\nSETTINGS_FILE = _DEFAULT_SETTINGS_FILE\n\n_SERVER_DEFAULTS = {\n    \"auto_start\": True,\n    \"auto_open_browser\": True,\n    \"host\": \"127.0.0.1\",\n    \"port\": 3456,\n}\n\n_RALPH_DEFAULTS = {\n    \"defaults\": {\n        \"provider\": \"claude\",\n        \"model\": \"sonnet\",\n        \"iterations\": 3,\n    },\n    \"summarizer\": {\n        \"provider\": \"claude\",\n        \"model\": \"haiku\",\n    },\n    \"providers\": {},\n}\n\n_SANDBOX_DEFAULTS = {\n    \"enabled\": False,\n    \"image\": \"vista-ralph:latest\",\n    \"network_enabled\": True,\n    \"ttl_seconds\": 7200,\n    \"credential_mounts\": {\n        \"claude_auth\": {\"enabled\": True},\n        \"git_ssh\": {\"enabled\": True},\n        \"git_config\": {\"enabled\": True},\n        \"gh_cli\": {\"enabled\": True},\n        \"opencode\": {\"enabled\": True},\n    },\n}\n\n_TOOLS_DEFAULTS = {\n    \"teams\": {\n        \"claude_binary\": None,\n        \"opencode_url\": None,\n        \"opencode_auto_start\": True,\n        \"opencode_port\": 4200,\n    },\n    \"ralph\": {},\n}\n\n\ndef get_tools_settings() -> dict:\n    \"\"\"Return merged tools settings with defaults applied.\"\"\"\n    raw = load_settings().get(\"tools\", {})\n    if not isinstance(raw, dict):\n        raw = {}\n    return _merge_dicts(_TOOLS_DEFAULTS, raw)\n\n\n_DIAGRAM_DEFAULTS = {\n    \"plantuml_server_url\": \"https://www.plantuml.com/plantuml\",\n}\n\n\ndef get_diagram_settings() -> dict:\n    \"\"\"Return merged diagram settings with defaults applied.\"\"\"\n    raw = load_settings().get(\"diagrams\", {})\n    if not isinstance(raw, dict):\n        raw = {}\n    return _merge_dicts(_DIAGRAM_DEFAULTS, raw)\n\n\n_CHAT_DEFAULTS = {\n    \"companion_port\": 3457,\n    \"opencode_port\": 4096,\n}\n\n\ndef get_chat_settings() -> dict:\n    \"\"\"Return chat backend service configuration.\"\"\"\n    raw = load_settings().get(\"chat\", {})\n    if not isinstance(raw, dict):\n        raw = {}\n    return _merge_dicts(_CHAT_DEFAULTS, raw)\n\n\ndef load_settings() -> dict:\n    \"\"\"Load settings.json from PLUGIN_ROOT, returning {} on failure.\"\"\"\n    _migrate_legacy_settings_if_needed()\n    if SETTINGS_FILE.exists():\n        try:\n            return json.loads(SETTINGS_FILE.read_text(encoding=\"utf-8\"))\n        except (json.JSONDecodeError, OSError):\n            pass\n    return {}\n\n\ndef _migrate_legacy_settings_if_needed() -> None:\n    \"\"\"Migrate settings from legacy plugin-local file to persistent location.\n\n    Migration runs only for the default persistent path, so tests and custom\n    overrides that patch ``SETTINGS_FILE`` are unaffected.\n    \"\"\"\n    if SETTINGS_FILE != _DEFAULT_SETTINGS_FILE:\n        return\n    if SETTINGS_FILE == LEGACY_SETTINGS_FILE:\n        return\n    if SETTINGS_FILE.exists() or not LEGACY_SETTINGS_FILE.exists():\n        return\n\n    try:\n        SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n        SETTINGS_FILE.write_text(\n            LEGACY_SETTINGS_FILE.read_text(encoding=\"utf-8\"), encoding=\"utf-8\"\n        )\n    except OSError:\n        # Non-fatal: app can still proceed with defaults.\n        return\n\n\ndef _merge_dicts(base: dict, overlay: dict) -> dict:\n    merged = dict(base)\n    for key, value in overlay.items():\n        if isinstance(value, dict) and isinstance(merged.get(key), dict):\n            merged[key] = _merge_dicts(merged[key], value)\n        else:\n            merged[key] = value\n    return merged\n\n\ndef get_ralph_settings() -> dict:\n    \"\"\"Return merged ralph settings with defaults applied.\"\"\"\n    raw = load_settings().get(\"ralph\", {})\n    if not isinstance(raw, dict):\n        raw = {}\n    return _merge_dicts(_RALPH_DEFAULTS, raw)\n\n\ndef get_ralph_defaults() -> dict:\n    \"\"\"Return default provider/model/iterations for ralph_start.\"\"\"\n    settings = get_ralph_settings().get(\"defaults\", {})\n    defaults = dict(_RALPH_DEFAULTS[\"defaults\"])\n    defaults.update({k: v for k, v in settings.items() if v is not None})\n    iterations = defaults.get(\"iterations\")\n    if not isinstance(iterations, int) or iterations <= 0:\n        defaults[\"iterations\"] = _RALPH_DEFAULTS[\"defaults\"][\"iterations\"]\n    return defaults\n\n\ndef get_summarizer_config() -> dict:\n    \"\"\"Return summarizer provider/model configuration.\"\"\"\n    settings = get_ralph_settings().get(\"summarizer\", {})\n    config = dict(_RALPH_DEFAULTS[\"summarizer\"])\n    config.update({k: v for k, v in settings.items() if v})\n    return config\n\n\ndef save_ralph_settings(ralph_config: dict) -> None:\n    \"\"\"Write the ralph section back to settings.json, preserving other sections.\"\"\"\n    _migrate_legacy_settings_if_needed()\n    settings = load_settings()\n    settings[\"ralph\"] = ralph_config\n    SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n    tmp_file = SETTINGS_FILE.with_suffix(\".json.tmp\")\n    tmp_file.write_text(json.dumps(settings, indent=2), encoding=\"utf-8\")\n    tmp_file.replace(SETTINGS_FILE)\n\n\ndef get_sandbox_settings() -> dict:\n    \"\"\"Return merged sandbox settings with defaults applied.\"\"\"\n    raw = get_ralph_settings().get(\"sandbox\", {})\n    if not isinstance(raw, dict):\n        raw = {}\n    return _merge_dicts(_SANDBOX_DEFAULTS, raw)\n\n\ndef is_sandbox_enabled() -> bool:\n    \"\"\"Check whether sandbox mode is enabled.\"\"\"\n    return bool(get_sandbox_settings().get(\"enabled\", False))\n\n\ndef get_sandbox_credential_mounts() -> dict:\n    \"\"\"Return the credential_mounts section of sandbox settings.\"\"\"\n    return get_sandbox_settings().get(\"credential_mounts\", {})\n\n\ndef save_sandbox_settings(sandbox_config: dict) -> None:\n    \"\"\"Write sandbox section under ralph settings, preserving other sections.\"\"\"\n    ralph = get_ralph_settings()\n    ralph[\"sandbox\"] = sandbox_config\n    save_ralph_settings(ralph)\n\n\ndef validate_sandbox_settings(config_dict: dict) -> list[str]:\n    \"\"\"Validate sandbox settings. Returns list of error strings (empty = valid).\"\"\"\n    errors: list[str] = []\n\n    if \"enabled\" in config_dict and not isinstance(config_dict[\"enabled\"], bool):\n        errors.append(\"'enabled' must be a boolean\")\n\n    if \"image\" in config_dict:\n        if (\n            not isinstance(config_dict[\"image\"], str)\n            or not config_dict[\"image\"].strip()\n        ):\n            errors.append(\"'image' must be a non-empty string\")\n\n    if \"network_enabled\" in config_dict and not isinstance(\n        config_dict[\"network_enabled\"], bool\n    ):\n        errors.append(\"'network_enabled' must be a boolean\")\n\n    if \"ttl_seconds\" in config_dict:\n        ttl = config_dict[\"ttl_seconds\"]\n        if not isinstance(ttl, int) or ttl <= 0:\n            errors.append(\"'ttl_seconds' must be a positive integer\")\n\n    if \"credential_mounts\" in config_dict:\n        creds = config_dict[\"credential_mounts\"]\n        if not isinstance(creds, dict):\n            errors.append(\"'credential_mounts' must be a dict\")\n        else:\n            for name, entry in creds.items():\n                if not isinstance(entry, dict):\n                    errors.append(f\"credential_mounts.{name} must be a dict\")\n                elif \"enabled\" in entry and not isinstance(entry[\"enabled\"], bool):\n                    errors.append(f\"credential_mounts.{name}.enabled must be a boolean\")\n\n    return errors\n\n\ndef get_server_settings() -> dict:\n    \"\"\"Return merged server settings.  Priority: env vars > settings.json > defaults.\"\"\"\n    settings = load_settings().get(\"server\", {})\n    merged = {**_SERVER_DEFAULTS, **settings}\n\n    # Env var overrides (match existing RALPH_SERVER_* convention)\n    pytest_test = os.environ.get(\"PYTEST_CURRENT_TEST\")\n    allow_env_overrides = True\n    if pytest_test and \"env_var\" not in pytest_test:\n        allow_env_overrides = False\n    if allow_env_overrides:\n        if \"RALPH_SERVER_HOST\" in os.environ:\n            merged[\"host\"] = os.environ[\"RALPH_SERVER_HOST\"]\n        if \"RALPH_SERVER_PORT\" in os.environ:\n            merged[\"port\"] = int(os.environ[\"RALPH_SERVER_PORT\"])\n        if \"RALPH_SERVER_AUTO_START\" in os.environ:\n            merged[\"auto_start\"] = os.environ[\"RALPH_SERVER_AUTO_START\"].lower() in (\n                \"1\",\n                \"true\",\n                \"yes\",\n            )\n        if \"RALPH_SERVER_AUTO_OPEN\" in os.environ:\n            merged[\"auto_open_browser\"] = os.environ[\n                \"RALPH_SERVER_AUTO_OPEN\"\n            ].lower() in (\n                \"1\",\n                \"true\",\n                \"yes\",\n            )\n    if (\n        \"PYTEST_CURRENT_TEST\" in os.environ\n        and \"RALPH_SERVER_AUTO_OPEN\" not in os.environ\n        and \"PYTEST_DISABLE_AUTO_OPEN\" in os.environ\n        and \"env_var\" not in os.environ.get(\"PYTEST_CURRENT_TEST\", \"\")\n    ):\n        merged[\"auto_open_browser\"] = _SERVER_DEFAULTS[\"auto_open_browser\"]\n\n    return merged\n\n\ndef ensure_full_path() -> None:\n    \"\"\"On Windows, merge the full system+user PATH from the registry.\n\n    Some launch contexts (e.g. git-bash, certain IDE sandboxes) have a\n    stripped-down PATH missing entries like nodejs/ and npm/. The Windows\n    registry holds the authoritative PATH. Merging it ensures subprocesses\n    like ``claude`` and ``opencode`` can find their dependencies.\n\n    Safe to call multiple times; subsequent calls are no-ops.\n    \"\"\"\n    if platform.system() != \"Windows\":\n        return\n    try:\n        import winreg\n    except ImportError:\n        return\n\n    registry_dirs: list[str] = []\n    for hive, subkey in [\n        (\n            winreg.HKEY_LOCAL_MACHINE,\n            r\"SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\",\n        ),\n        (winreg.HKEY_CURRENT_USER, r\"Environment\"),\n    ]:\n        try:\n            key = winreg.OpenKey(hive, subkey)\n            raw = winreg.QueryValueEx(key, \"Path\")[0]\n            winreg.CloseKey(key)\n            registry_dirs.extend(\n                os.path.expandvars(d) for d in raw.split(\";\") if d.strip()\n            )\n        except OSError:\n            continue\n\n    current = set(os.environ.get(\"PATH\", \"\").split(\";\"))\n    new_dirs = [d for d in registry_dirs if d not in current and os.path.isdir(d)]\n    if new_dirs:\n        os.environ[\"PATH\"] = os.environ.get(\"PATH\", \"\") + \";\" + \";\".join(new_dirs)\n\n\n# Module-level HOST / PORT for backward compatibility\n_server = get_server_settings()\nHOST = _server[\"host\"]\nPORT = _server[\"port\"]\n","numLines":348,"startLine":1,"totalLines":348}}}
