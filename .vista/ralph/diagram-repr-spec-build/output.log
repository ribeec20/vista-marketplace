card.onclick = () => toggleContext(filename, idx);\n    card.innerHTML = `\n        <div class=\"diagram-header\">\n            <div class=\"flex items-center gap-2 flex-1 min-w-0\">\n                <span class=\"font-semibold text-sm truncate\">${escapeHtml(newDiagram.name)}</span>\n                <span class=\"badge badge-arch\">architecture</span>\n                <span class=\"text-green-400 text-xs\">NEW</span>\n            </div>\n            <span class=\"attach-indicator off\" id=\"ctx-${idx}\">click to attach</span>\n        </div>\n        <div class=\"diagram-body\" onclick=\"event.stopPropagation()\">\n            <div class=\"diagram-viewport\" id=\"viewport-${idx}\">\n                <div class=\"mermaid\" id=\"mermaid-${idx}\">Loading...</div>\n            </div>\n            <div class=\"diagram-zoom-controls\">\n                <button onclick=\"zoomDiagram(${idx}, -0.2)\" title=\"Zoom out\">&minus;</button>\n                <button onclick=\"resetZoom(${idx})\" title=\"Reset zoom\">1:1</button>\n                <button onclick=\"zoomDiagram(${idx}, 0.2)\" title=\"Zoom in\">+</button>\n                <a class=\"diagram-expand-btn\"\n                   href=\"/project/${PROJECT_ID}/arch/${FEATURE_NAME}/diagram/${escapeHtml(filename)}\"\n                   target=\"_blank\"\n                   title=\"Open full-page view\">&#x26F6;</a>\n            </div>\n        </div>\n    `;\n    grid.appendChild(card);\n\n    const el = document.getElementById(`mermaid-${idx}`);\n    if (el) await renderDiagramContent(el, filename, content, idx, newDiagram.type);\n    initViewport(idx);\n\n    // Flash\n    card.classList.add('diagram-updating');\n    setTimeout(() => card.classList.remove('diagram-updating'), 1500);\n}","numLines":50,"startLine":2450,"totalLines":2561}}}
