{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EQH1iEY2S1sv3uc6LpSVqq","type":"tool_result","content":"     1→\"\"\"Tests for architecture diagram features and chat functionality.\"\"\"\n     2→\n     3→import json\n     4→from pathlib import Path\n     5→from unittest.mock import patch\n     6→\n     7→import pytest\n     8→from fastapi.testclient import TestClient\n     9→\n    10→\n    11→@pytest.fixture\n    12→def arch_project(tmp_path):\n    13→    \"\"\"Create a mock project with arch/ directory and sample diagrams.\"\"\"\n    14→    project_dir = tmp_path / \"arch_test_project\"\n    15→    project_dir.mkdir()\n    16→\n    17→    # Create feature with arch directory\n    18→    feature_dir = project_dir / \".vista\" / \"features\" / \"test-feature\"\n    19→    feature_dir.mkdir(parents=True)\n    20→\n    21→    arch_dir = feature_dir / \"arch\"\n    22→    arch_dir.mkdir()\n    23→\n    24→    # Create _arch.json manifest\n    25→    manifest = {\n    26→        \"feature\": \"test-feature\",\n    27→        \"diagrams\": [\n    28→            {\n    29→                \"name\": \"System Architecture\",\n    30→                \"file\": \"system-arch.mmd\",\n    31→                \"type\": \"mermaid\",\n    32→                \"diagramType\": \"flowchart\",\n    33→                \"description\": \"High-level system architecture\",\n    34→            },\n    35→            {\n    36→                \"name\": \"Data Flow\",\n    37→                \"file\": \"data-flow.mmd\",\n    38→                \"type\": \"mermaid\",\n    39→                \"diagramType\": \"sequence\",\n    40→                \"description\": \"Data flow between components\",\n    41→            },\n    42→            {\n    43→                \"name\": \"Entity Model\",\n    44→                \"file\": \"entity-model.drawio\",\n    45→                \"type\": \"drawio\",\n    46→                \"diagramType\": \"er\",\n    47→                \"description\": \"Entity relationship diagram\",\n    48→            },\n    49→        ],\n    50→    }\n    51→    (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n    52→\n    53→    # Create sample .mmd files\n    54→    (arch_dir / \"system-arch.mmd\").write_text(\n    55→        \"graph TD\\n    A[Client] --> B[Server]\\n    B --> C[Database]\", encoding=\"utf-8\"\n    56→    )\n    57→    (arch_dir / \"data-flow.mmd\").write_text(\n    58→        \"sequenceDiagram\\n    participant C as Client\\n    participant S as Server\\n    C->>S: Request\",\n    59→        encoding=\"utf-8\",\n    60→    )\n    61→\n    62→    # Create sample .drawio file (XML content)\n    63→    (arch_dir / \"entity-model.drawio\").write_text(\n    64→        '<mxfile><diagram><mxGraphModel><root><mxCell id=\"0\" /></root></mxGraphModel></diagram></mxfile>',\n    65→        encoding=\"utf-8\",\n    66→    )\n    67→\n    68→    return project_dir, feature_dir, arch_dir\n    69→\n    70→\n    71→@pytest.fixture\n    72→def api_env(tmp_path):\n    73→    \"\"\"Set up isolated API test environment.\"\"\"\n    74→    data_dir = tmp_path / \"data\"\n    75→    data_dir.mkdir()\n    76→    projects_file = data_dir / \"projects.json\"\n    77→    projects_file.write_text(\"[]\", encoding=\"utf-8\")\n    78→    views_dir = Path(__file__).resolve().parent.parent / \"server\" / \"views\"\n    79→    static_dir = views_dir / \"static\"\n    80→\n    81→    with (\n    82→        patch(\"server.config.DATA_DIR\", data_dir),\n    83→        patch(\"server.config.PROJECTS_FILE\", projects_file),\n    84→        patch(\"server.config.VIEWS_DIR\", views_dir),\n    85→        patch(\"server.config.STATIC_DIR\", static_dir),\n    86→        patch(\"server.services.project_service.DATA_DIR\", data_dir),\n    87→        patch(\"server.services.project_service.PROJECTS_FILE\", projects_file),\n    88→    ):\n    89→        from server.app import app\n    90→\n    91→        yield TestClient(app), tmp_path\n    92→\n    93→\n    94→class TestArchitectureAPI:\n    95→    \"\"\"Tests for architecture diagram API endpoints.\"\"\"\n    96→\n    97→    def test_get_arch_manifest_success(self, api_env, arch_project):\n    98→        \"\"\"GET /api/projects/{id}/features/{name}/arch returns manifest.\"\"\"\n    99→        client, tmp_path = api_env\n   100→        project_dir, _, _ = arch_project\n   101→\n   102→        # Register project\n   103→        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n   104→\n   105→        resp = client.get(f\"/api/projects/{reg['id']}/features/test-feature/arch\")\n   106→        assert resp.status_code == 200\n   107→        data = resp.json()\n   108→        assert data[\"feature\"] == \"test-feature\"\n   109→        assert len(data[\"diagrams\"]) == 3\n   110→        assert data[\"diagrams\"][0][\"name\"] == \"System Architecture\"\n   111→\n   112→    def test_get_arch_manifest_not_found(self, api_env):\n   113→        \"\"\"GET /api/projects/{id}/features/{name}/arch returns 404 when no manifest.\"\"\"\n   114→        client, tmp_path = api_env\n   115→        project_dir = tmp_path / \"no_arch_project\"\n   116→        project_dir.mkdir()\n   117→        feature_dir = project_dir / \".vista\" / \"features\" / \"no-arch-feature\"\n   118→        feature_dir.mkdir(parents=True)\n   119→\n   120→        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n   121→\n   122→        resp = client.get(f\"/api/projects/{reg['id']}/features/no-arch-feature/arch\")\n   123→        assert resp.status_code == 404\n   124→\n   125→    def test_get_arch_manifest_malformed_json(self, api_env):\n   126→        \"\"\"GET /api/projects/{id}/features/{name}/arch returns 404 for malformed JSON.\"\"\"\n   127→        client, tmp_path = api_env\n   128→        project_dir = tmp_path / \"bad_json_project\"\n   129→        project_dir.mkdir()\n   130→        arch_dir = project_dir / \".vista\" / \"features\" / \"bad-feature\" / \"arch\"\n   131→        arch_dir.mkdir(parents=True)\n   132→        (arch_dir / \"_arch.json\").write_text(\"not valid json\", encoding=\"utf-8\")\n   133→\n   134→        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n   135→\n   136→        resp = client.get(f\"/api/projects/{reg['id']}/features/bad-feature/arch\")\n   137→        assert resp.status_code == 404\n   138→\n   139→    def test_get_arch_file_mmd_success(self, api_env, arch_project):\n   140→        \"\"\"GET /api/projects/{id}/features/{name}/arch/{filename} returns .mmd content.\"\"\"\n   141→        client, tmp_path = api_env\n   142→        project_dir, _, _ = arch_project\n   143→\n   144→        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n   145→\n   146→        resp = client.get(\n   147→            f\"/api/projects/{reg['id']}/features/test-feature/arch/system-arch.mmd\"\n   148→        )\n   149→        assert resp.status_code == 200\n   150→        assert resp.headers[\"content-type\"] == \"text/plain; charset=utf-8\"\n   151→        assert \"graph TD\" in resp.text\n   152→        assert \"Client\" in resp.text\n   153→\n   154→    def test_get_arch_file_drawio_content_type(self, api_env, arch_project):\n   155→        \"\"\"GET /api/projects/{id}/features/{name}/arch/{filename} returns correct content-type for .drawio.\"\"\"\n   156→        client, tmp_path = api_env\n   157→        project_dir, _, _ = arch_project\n   158→\n   159→        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n   160→\n   161→        resp = client.get(\n   162→            f\"/api/projects/{reg['id']}/features/test-feature/arch/entity-model.drawio\"\n   163→        )\n   164→        assert resp.status_code == 200\n   165→        assert resp.headers[\"content-type\"] == \"application/xml\"\n   166→        assert \"<mxfile>\" in resp.text\n   167→\n   168→    def test_get_arch_file_path_traversal_dotdot(self, api_env, arch_project):\n   169→        \"\"\"GET /api/projects/{id}/features/{name}/arch/{filename} blocks .. path traversal.\"\"\"\n   170→        client, tmp_path = api_env\n   171→        project_dir, _, _ = arch_project\n   172→\n   173→        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n   174→\n   175→        resp = client.get(\n   176→            f\"/api/projects/{reg['id']}/features/test-feature/arch/../../../etc/passwd\"\n   177→        )\n   178→        assert resp.status_code == 404\n   179→\n   180→    def test_get_arch_file_path_traversal_absolute(self, api_env, arch_project):\n   181→        \"\"\"GET /api/projects/{id}/features/{name}/arch/{filename} blocks absolute path traversal.\"\"\"\n   182→        client, tmp_path = api_env\n   183→        project_dir, _, _ = arch_project\n   184→\n   185→        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n   186→\n   187→        resp = client.get(\n   188→            f\"/api/projects/{reg['id']}/features/test-feature/arch//etc/passwd\"\n   189→        )\n   190→        assert resp.status_code == 404\n   191→\n   192→    def test_get_arch_file_not_found(self, api_env, arch_project):\n   193→        \"\"\"GET /api/projects/{id}/features/{name}/arch/{filename} returns 404 for missing file.\"\"\"\n   194→        client, tmp_path = api_env\n   195→        project_dir, _, _ = arch_project\n   196→\n   197→        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n   198→\n   199→        resp = client.get(\n   200→            f\"/api/projects/{reg['id']}/features/test-feature/arch/nonexistent.mmd\"\n   201→        )\n   202→        assert resp.status_code == 404\n   203→\n   204→    def test_architecture_page_renders(self, api_env, arch_project):\n   205→        \"\"\"GET /project/{id}/arch/{feature_name} renders the architecture viewer page.\"\"\"\n   206→        client, tmp_path = api_env\n   207→        project_dir, _, _ = arch_project\n   208→\n   209→        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n   210→\n   211→        resp = client.get(f\"/project/{reg['id']}/arch/test-feature\")\n   212→        assert resp.status_code == 200\n   213→        assert \"Architecture\" in resp.text or \"test-feature\" in resp.text\n   214→\n   215→    def test_architecture_page_no_manifest(self, api_env):\n   216→        \"\"\"GET /project/{id}/arch/{feature_name} shows empty state when no manifest.\"\"\"\n   217→        client, tmp_path = api_env\n   218→        project_dir = tmp_path / \"empty_project\"\n   219→        project_dir.mkdir()\n   220→        feature_dir = project_dir / \".vista\" / \"features\" / \"empty-feature\"\n   221→        feature_dir.mkdir(parents=True)\n   222→\n   223→        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n   224→\n   225→        resp = client.get(f\"/project/{reg['id']}/arch/empty-feature\")\n   226→        assert resp.status_code == 200\n   227→\n   228→\n   229→class TestProgressServiceArch:\n   230→    \"\"\"Tests for ProgressService architecture methods.\"\"\"\n   231→\n   232→    def test_read_arch_manifest_valid(self, tmp_path):\n   233→        \"\"\"read_arch_manifest returns parsed JSON for valid manifest.\"\"\"\n   234→        from server.services.progress_service import ProgressService\n   235→\n   236→        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n   237→        arch_dir.mkdir(parents=True)\n   238→\n   239→        manifest = {\"feature\": \"test\", \"diagrams\": []}\n   240→        (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n   241→\n   242→        result = ProgressService.read_arch_manifest(str(tmp_path), \"test\")\n   243→        assert result == manifest\n   244→\n   245→    def test_read_arch_manifest_missing_file(self, tmp_path):\n   246→        \"\"\"read_arch_manifest returns None for missing manifest.\"\"\"\n   247→        from server.services.progress_service import ProgressService\n   248→\n   249→        result = ProgressService.read_arch_manifest(str(tmp_path), \"nonexistent\")\n   250→        assert result is None\n   251→\n   252→    def test_read_arch_manifest_invalid_json(self, tmp_path):\n   253→        \"\"\"read_arch_manifest returns None for invalid JSON.\"\"\"\n   254→        from server.services.progress_service import ProgressService\n   255→\n   256→        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n   257→        arch_dir.mkdir(parents=True)\n   258→        (arch_dir / \"_arch.json\").write_text(\"not json\", encoding=\"utf-8\")\n   259→\n   260→        result = ProgressService.read_arch_manifest(str(tmp_path), \"test\")\n   261→        assert result is None\n   262→\n   263→    def test_read_arch_file_valid_mmd(self, tmp_path):\n   264→        \"\"\"read_arch_file returns content for valid .mmd file.\"\"\"\n   265→        from server.services.progress_service import ProgressService\n   266→\n   267→        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n   268→        arch_dir.mkdir(parents=True)\n   269→        (arch_dir / \"diagram.mmd\").write_text(\"graph TD\\n    A-->B\", encoding=\"utf-8\")\n   270→\n   271→        result = ProgressService.read_arch_file(str(tmp_path), \"test\", \"diagram.mmd\")\n   272→        assert result == \"graph TD\\n    A-->B\"\n   273→\n   274→    def test_read_arch_file_valid_drawio(self, tmp_path):\n   275→        \"\"\"read_arch_file returns content for valid .drawio file.\"\"\"\n   276→        from server.services.progress_service import ProgressService\n   277→\n   278→        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n   279→        arch_dir.mkdir(parents=True)\n   280→        (arch_dir / \"diagram.drawio\").write_text(\"<xml></xml>\", encoding=\"utf-8\")\n   281→\n   282→        result = ProgressService.read_arch_file(str(tmp_path), \"test\", \"diagram.drawio\")\n   283→        assert result == \"<xml></xml>\"\n   284→\n   285→    def test_read_arch_file_path_traversal_dotdot(self, tmp_path):\n   286→        \"\"\"read_arch_file blocks .. path traversal attempts.\"\"\"\n   287→        from server.services.progress_service import ProgressService\n   288→\n   289→        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n   290→        arch_dir.mkdir(parents=True)\n   291→        (arch_dir / \"secret.txt\").write_text(\"secret\", encoding=\"utf-8\")\n   292→\n   293→        # Create file outside arch directory\n   294→        (tmp_path / \"outside.txt\").write_text(\"outside content\", encoding=\"utf-8\")\n   295→\n   296→        result = ProgressService.read_arch_file(str(tmp_path), \"test\", \"../outside.txt\")\n   297→        assert result is None\n   298→\n   299→    def test_read_arch_file_path_traversal_absolute(self, tmp_path):\n   300→        \"\"\"read_arch_file blocks absolute path traversal attempts.\"\"\"\n   301→        from server.services.progress_service import ProgressService\n   302→\n   303→        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n   304→        arch_dir.mkdir(parents=True)\n   305→\n   306→        result = ProgressService.read_arch_file(str(tmp_path), \"test\", \"/etc/passwd\")\n   307→        assert result is None\n   308→\n   309→    def test_read_arch_file_not_found(self, tmp_path):\n   310→        \"\"\"read_arch_file returns None for non-existent file.\"\"\"\n   311→        from server.services.progress_service import ProgressService\n   312→\n   313→        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n   314→        arch_dir.mkdir(parents=True)\n   315→\n   316→        result = ProgressService.read_arch_file(str(tmp_path), \"test\", \"missing.mmd\")\n   317→        assert result is None\n   318→\n   319→\n   320→class TestSchemaValidation:\n   321→    \"\"\"Tests for JSON schema validation.\"\"\"\n   322→\n   323→    def _get_template_path(self, filename: str) -> Path:\n   324→        \"\"\"Get path to a template file relative to test location.\"\"\"\n   325→        # Tests are in vista/tests/, templates are in vista/templates/\n   326→        return Path(__file__).parent.parent / \"templates\" / filename\n   327→\n   328→    def test_plan_schema_valid_minimal(self):\n   329→        \"\"\"plan-schema.json validates plan with only implementationPhases.\"\"\"\n   330→        import jsonschema\n   331→\n   332→        schema = json.loads(self._get_template_path(\"plan-schema.json\").read_text())\n   333→\n   334→        plan = {\n   335→            \"meta\": {\n   336→                \"feature\": \"test\",\n   337→                \"version\": 1,\n   338→                \"created\": \"2025-01-01T00:00:00Z\",\n   339→                \"lastModified\": \"2025-01-01T00:00:00Z\",\n   340→                \"status\": \"draft\",\n   341→                \"description\": \"Test feature\",\n   342→            },\n   343→            \"sections\": {\"implementationPhases\": {\"phases\": []}},\n   344→        }\n   345→\n   346→        # Should not raise\n   347→        jsonschema.validate(plan, schema)\n   348→\n   349→    def test_plan_schema_valid_with_architecture(self):\n   350→        \"\"\"plan-schema.json validates plan with architecture.ref.\"\"\"\n   351→        import jsonschema\n   352→\n   353→        schema = json.loads(self._get_template_path(\"plan-schema.json\").read_text())\n   354→\n   355→        plan = {\n   356→            \"meta\": {\n   357→                \"feature\": \"test\",\n   358→                \"version\": 1,\n   359→                \"created\": \"2025-01-01T00:00:00Z\",\n   360→                \"lastModified\": \"2025-01-01T00:00:00Z\",\n   361→                \"status\": \"draft\",\n   362→                \"description\": \"Test feature\",\n   363→            },\n   364→            \"sections\": {\n   365→                \"architecture\": {\"ref\": \"./arch/_arch.json\"},\n   366→                \"implementationPhases\": {\"phases\": []},\n   367→            },\n   368→        }\n   369→\n   370→        # Should not raise\n   371→        jsonschema.validate(plan, schema)\n   372→\n   373→    def test_plan_schema_rejects_missing_phases(self):\n   374→        \"\"\"plan-schema.json rejects plan missing implementationPhases.\"\"\"\n   375→        import jsonschema\n   376→\n   377→        schema = json.loads(self._get_template_path(\"plan-schema.json\").read_text())\n   378→\n   379→        plan = {\n   380→            \"meta\": {\n   381→                \"feature\": \"test\",\n   382→                \"version\": 1,\n   383→                \"created\": \"2025-01-01T00:00:00Z\",\n   384→                \"lastModified\": \"2025-01-01T00:00:00Z\",\n   385→                \"status\": \"draft\",\n   386→                \"description\": \"Test feature\",\n   387→            },\n   388→            \"sections\": {},\n   389→        }\n   390→\n   391→        with pytest.raises(jsonschema.ValidationError):\n   392→            jsonschema.validate(plan, schema)\n   393→\n   394→    def test_arch_schema_valid_manifest(self):\n   395→        \"\"\"arch-schema.json validates a valid manifest.\"\"\"\n   396→        import jsonschema\n   397→\n   398→        schema = json.loads(self._get_template_path(\"arch-schema.json\").read_text())\n   399→\n   400→        manifest = {\n   401→            \"feature\": \"test\",\n   402→            \"diagrams\": [\n   403→                {\n   404→                    \"name\": \"Test Diagram\",\n   405→                    \"file\": \"test.mmd\",\n   406→                    \"type\": \"mermaid\",\n   407→                    \"diagramType\": \"flowchart\",\n   408→                    \"description\": \"A test diagram\",\n   409→                }\n   410→            ],\n   411→        }\n   412→\n   413→        # Should not raise\n   414→        jsonschema.validate(manifest, schema)\n   415→\n   416→    def test_arch_schema_rejects_invalid_type(self):\n   417→        \"\"\"arch-schema.json rejects invalid diagram type.\"\"\"\n   418→        import jsonschema\n   419→\n   420→        schema = json.loads(self._get_template_path(\"arch-schema.json\").read_text())\n   421→\n   422→        manifest = {\n   423→            \"feature\": \"test\",\n   424→            \"diagrams\": [\n   425→                {\n   426→                    \"name\": \"Test Diagram\",\n   427→                    \"file\": \"test.mmd\",\n   428→                    \"type\": \"invalid_type\",\n   429→                    \"diagramType\": \"flowchart\",\n   430→                    \"description\": \"A test diagram\",\n   431→                }\n   432→            ],\n   433→        }\n   434→\n   435→        with pytest.raises(jsonschema.ValidationError):\n   436→            jsonschema.validate(manifest, schema)\n   437→\n   438→    def test_arch_schema_rejects_missing_fields(self):\n   439→        \"\"\"arch-schema.json rejects manifest with missing required fields.\"\"\"\n   440→        import jsonschema\n   441→\n   442→        schema = json.loads(self._get_template_path(\"arch-schema.json\").read_text())\n   443→\n   444→        manifest = {\n   445→            \"feature\": \"test\",\n   446→            \"diagrams\": [\n   447→                {\n   448→                    \"name\": \"Test Diagram\"\n   449→                    # Missing file, type, diagramType\n   450→                }\n   451→            ],\n   452→        }\n   453→\n   454→        with pytest.raises(jsonschema.ValidationError):\n   455→            jsonschema.validate(manifest, schema)\n   456→\n   457→\n   458→class TestProjectServiceArch:\n   459→    \"\"\"Tests for ProjectService architecture-related methods.\"\"\"\n   460→\n   461→    def test_scan_features_detailed_has_arch_manifest(self, tmp_path):\n   462→        \"\"\"scan_features_detailed includes has_arch_manifest field.\"\"\"\n   463→        from server.services.project_service import ProjectService\n   464→\n   465→        # Create feature with arch manifest\n   466→        arch_dir = tmp_path / \".vista\" / \"features\" / \"with-arch\" / \"arch\"\n   467→        arch_dir.mkdir(parents=True)\n   468→        manifest = {\n   469→            \"feature\": \"with-arch\",\n   470→            \"diagrams\": [\n   471→                {\n   472→                    \"name\": \"D\",\n   473→                    \"file\": \"d.mmd\",\n   474→                    \"type\": \"mermaid\",\n   475→                    \"diagramType\": \"flowchart\",\n   476→                    \"description\": \"\",\n   477→                }\n   478→            ],\n   479→        }\n   480→        (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n   481→        (arch_dir / \"d.mmd\").write_text(\"graph TD\", encoding=\"utf-8\")\n   482→\n   483→        # Create feature without arch\n   484→        no_arch_dir = tmp_path / \".vista\" / \"features\" / \"no-arch\"\n   485→        no_arch_dir.mkdir(parents=True)\n   486→\n   487→        features = ProjectService.scan_features_detailed(str(tmp_path))\n   488→\n   489→        # Find features by name\n   490→        with_arch = next(f for f in features if f[\"name\"] == \"with-arch\")\n   491→        without_arch = next(f for f in features if f[\"name\"] == \"no-arch\")\n   492→\n   493→        assert with_arch[\"has_arch_manifest\"] is True\n   494→        assert without_arch[\"has_arch_manifest\"] is False\n   495→\n   496→    def test_scan_features_detailed_arch_diagram_count(self, tmp_path):\n   497→        \"\"\"scan_features_detailed includes arch_diagram_count field.\"\"\"\n   498→        from server.services.project_service import ProjectService\n   499→\n   500→        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n   501→        arch_dir.mkdir(parents=True)\n   502→\n   503→        # Create actual diagram files (count is based on files, not manifest)\n   504→        (arch_dir / \"d1.mmd\").write_text(\"graph TD\\n    A-->B\", encoding=\"utf-8\")\n   505→        (arch_dir / \"d2.mmd\").write_text(\n   506→            \"sequenceDiagram\\n    A->>B: msg\", encoding=\"utf-8\"\n   507→        )\n   508→        (arch_dir / \"d3.drawio\").write_text(\"<mxfile></mxfile>\", encoding=\"utf-8\")\n   509→\n   510→        features = ProjectService.scan_features_detailed(str(tmp_path))\n   511→\n   512→        assert features[0][\"arch_diagram_count\"] == 3\n   513→\n   514→    def test_scan_features_detailed_no_arch(self, tmp_path):\n   515→        \"\"\"scan_features_detailed returns 0 count for feature without arch directory.\"\"\"\n   516→        from server.services.project_service import ProjectService\n   517→\n   518→        feature_dir = tmp_path / \".vista\" / \"features\" / \"test\"\n   519→        feature_dir.mkdir(parents=True)\n   520→\n   521→        features = ProjectService.scan_features_detailed(str(tmp_path))\n   522→\n   523→        assert features[0][\"has_arch_manifest\"] is False\n   524→        assert features[0][\"arch_diagram_count\"] == 0\n   525→\n   526→\n   527→class TestContextAssembler:\n   528→    \"\"\"Tests for ContextAssembler prompt helpers.\"\"\"\n   529→\n   530→    def test_build_prompt_includes_context(self):\n   531→        \"\"\"build_full_prompt includes diagram context before message.\"\"\"\n   532→        from server.services.context_assembler import ContextAssembler\n   533→\n   534→        prompt = ContextAssembler.build_full_prompt(\n   535→            message=\"What do you think?\", context=\"graph TD\\n    A-->B\", history=None\n   536→        )\n   537→\n   538→        assert \"DIAGRAM CONTEXT\" in prompt\n   539→        assert \"graph TD\" in prompt\n   540→        assert \"What do you think?\" in prompt\n   541→\n   542→    def test_build_prompt_ignores_history(self):\n   543→        \"\"\"build_full_prompt ignores history — providers maintain it natively.\"\"\"\n   544→        from server.services.context_assembler import ContextAssembler\n   545→\n   546→        history = [\n   547→            {\"role\": \"user\", \"content\": \"Hello\"},\n   548→            {\"role\": \"assistant\", \"content\": \"Hi there\"},\n   549→        ]\n   550→\n   551→        prompt = ContextAssembler.build_full_prompt(\n   552→            message=\"What's next?\", context=None, history=history\n   553→        )\n   554→\n   555→        # History should NOT be re-sent\n   556→        assert \"CONVERSATION HISTORY\" not in prompt\n   557→        assert \"Hi there\" not in prompt\n   558→        # Current message should be present\n   559→        assert \"What's next?\" in prompt\n   560→\n   561→    def test_build_prompt_works_with_empty_context_and_history(self):\n   562→        \"\"\"build_full_prompt works with no context or history.\"\"\"\n   563→        from server.services.context_assembler import ContextAssembler\n   564→\n   565→        prompt = ContextAssembler.build_full_prompt(\n   566→            message=\"Hello\", context=None, history=None\n   567→        )\n   568→\n   569→        assert \"Hello\" in prompt\n   570→"}]},"parent_tool_use_id":null,"session_id":"59ccf3de-4e5f-4501-a467-c73d833f9d6b","uuid":"70382b28-8d61-47e1-89f3-effcb39b74b4","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/tests/test_architecture.py","content":"\"\"\"Tests for architecture diagram features and chat functionality.\"\"\"\n\nimport json\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nimport pytest\nfrom fastapi.testclient import TestClient\n\n\n@pytest.fixture\ndef arch_project(tmp_path):\n    \"\"\"Create a mock project with arch/ directory and sample diagrams.\"\"\"\n    project_dir = tmp_path / \"arch_test_project\"\n    project_dir.mkdir()\n\n    # Create feature with arch directory\n    feature_dir = project_dir / \".vista\" / \"features\" / \"test-feature\"\n    feature_dir.mkdir(parents=True)\n\n    arch_dir = feature_dir / \"arch\"\n    arch_dir.mkdir()\n\n    # Create _arch.json manifest\n    manifest = {\n        \"feature\": \"test-feature\",\n        \"diagrams\": [\n            {\n                \"name\": \"System Architecture\",\n                \"file\": \"system-arch.mmd\",\n                \"type\": \"mermaid\",\n                \"diagramType\": \"flowchart\",\n                \"description\": \"High-level system architecture\",\n            },\n            {\n                \"name\": \"Data Flow\",\n                \"file\": \"data-flow.mmd\",\n                \"type\": \"mermaid\",\n                \"diagramType\": \"sequence\",\n                \"description\": \"Data flow between components\",\n            },\n            {\n                \"name\": \"Entity Model\",\n                \"file\": \"entity-model.drawio\",\n                \"type\": \"drawio\",\n                \"diagramType\": \"er\",\n                \"description\": \"Entity relationship diagram\",\n            },\n        ],\n    }\n    (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n\n    # Create sample .mmd files\n    (arch_dir / \"system-arch.mmd\").write_text(\n        \"graph TD\\n    A[Client] --> B[Server]\\n    B --> C[Database]\", encoding=\"utf-8\"\n    )\n    (arch_dir / \"data-flow.mmd\").write_text(\n        \"sequenceDiagram\\n    participant C as Client\\n    participant S as Server\\n    C->>S: Request\",\n        encoding=\"utf-8\",\n    )\n\n    # Create sample .drawio file (XML content)\n    (arch_dir / \"entity-model.drawio\").write_text(\n        '<mxfile><diagram><mxGraphModel><root><mxCell id=\"0\" /></root></mxGraphModel></diagram></mxfile>',\n        encoding=\"utf-8\",\n    )\n\n    return project_dir, feature_dir, arch_dir\n\n\n@pytest.fixture\ndef api_env(tmp_path):\n    \"\"\"Set up isolated API test environment.\"\"\"\n    data_dir = tmp_path / \"data\"\n    data_dir.mkdir()\n    projects_file = data_dir / \"projects.json\"\n    projects_file.write_text(\"[]\", encoding=\"utf-8\")\n    views_dir = Path(__file__).resolve().parent.parent / \"server\" / \"views\"\n    static_dir = views_dir / \"static\"\n\n    with (\n        patch(\"server.config.DATA_DIR\", data_dir),\n        patch(\"server.config.PROJECTS_FILE\", projects_file),\n        patch(\"server.config.VIEWS_DIR\", views_dir),\n        patch(\"server.config.STATIC_DIR\", static_dir),\n        patch(\"server.services.project_service.DATA_DIR\", data_dir),\n        patch(\"server.services.project_service.PROJECTS_FILE\", projects_file),\n    ):\n        from server.app import app\n\n        yield TestClient(app), tmp_path\n\n\nclass TestArchitectureAPI:\n    \"\"\"Tests for architecture diagram API endpoints.\"\"\"\n\n    def test_get_arch_manifest_success(self, api_env, arch_project):\n        \"\"\"GET /api/projects/{id}/features/{name}/arch returns manifest.\"\"\"\n        client, tmp_path = api_env\n        project_dir, _, _ = arch_project\n\n        # Register project\n        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n\n        resp = client.get(f\"/api/projects/{reg['id']}/features/test-feature/arch\")\n        assert resp.status_code == 200\n        data = resp.json()\n        assert data[\"feature\"] == \"test-feature\"\n        assert len(data[\"diagrams\"]) == 3\n        assert data[\"diagrams\"][0][\"name\"] == \"System Architecture\"\n\n    def test_get_arch_manifest_not_found(self, api_env):\n        \"\"\"GET /api/projects/{id}/features/{name}/arch returns 404 when no manifest.\"\"\"\n        client, tmp_path = api_env\n        project_dir = tmp_path / \"no_arch_project\"\n        project_dir.mkdir()\n        feature_dir = project_dir / \".vista\" / \"features\" / \"no-arch-feature\"\n        feature_dir.mkdir(parents=True)\n\n        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n\n        resp = client.get(f\"/api/projects/{reg['id']}/features/no-arch-feature/arch\")\n        assert resp.status_code == 404\n\n    def test_get_arch_manifest_malformed_json(self, api_env):\n        \"\"\"GET /api/projects/{id}/features/{name}/arch returns 404 for malformed JSON.\"\"\"\n        client, tmp_path = api_env\n        project_dir = tmp_path / \"bad_json_project\"\n        project_dir.mkdir()\n        arch_dir = project_dir / \".vista\" / \"features\" / \"bad-feature\" / \"arch\"\n        arch_dir.mkdir(parents=True)\n        (arch_dir / \"_arch.json\").write_text(\"not valid json\", encoding=\"utf-8\")\n\n        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n\n        resp = client.get(f\"/api/projects/{reg['id']}/features/bad-feature/arch\")\n        assert resp.status_code == 404\n\n    def test_get_arch_file_mmd_success(self, api_env, arch_project):\n        \"\"\"GET /api/projects/{id}/features/{name}/arch/{filename} returns .mmd content.\"\"\"\n        client, tmp_path = api_env\n        project_dir, _, _ = arch_project\n\n        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n\n        resp = client.get(\n            f\"/api/projects/{reg['id']}/features/test-feature/arch/system-arch.mmd\"\n        )\n        assert resp.status_code == 200\n        assert resp.headers[\"content-type\"] == \"text/plain; charset=utf-8\"\n        assert \"graph TD\" in resp.text\n        assert \"Client\" in resp.text\n\n    def test_get_arch_file_drawio_content_type(self, api_env, arch_project):\n        \"\"\"GET /api/projects/{id}/features/{name}/arch/{filename} returns correct content-type for .drawio.\"\"\"\n        client, tmp_path = api_env\n        project_dir, _, _ = arch_project\n\n        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n\n        resp = client.get(\n            f\"/api/projects/{reg['id']}/features/test-feature/arch/entity-model.drawio\"\n        )\n        assert resp.status_code == 200\n        assert resp.headers[\"content-type\"] == \"application/xml\"\n        assert \"<mxfile>\" in resp.text\n\n    def test_get_arch_file_path_traversal_dotdot(self, api_env, arch_project):\n        \"\"\"GET /api/projects/{id}/features/{name}/arch/{filename} blocks .. path traversal.\"\"\"\n        client, tmp_path = api_env\n        project_dir, _, _ = arch_project\n\n        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n\n        resp = client.get(\n            f\"/api/projects/{reg['id']}/features/test-feature/arch/../../../etc/passwd\"\n        )\n        assert resp.status_code == 404\n\n    def test_get_arch_file_path_traversal_absolute(self, api_env, arch_project):\n        \"\"\"GET /api/projects/{id}/features/{name}/arch/{filename} blocks absolute path traversal.\"\"\"\n        client, tmp_path = api_env\n        project_dir, _, _ = arch_project\n\n        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n\n        resp = client.get(\n            f\"/api/projects/{reg['id']}/features/test-feature/arch//etc/passwd\"\n        )\n        assert resp.status_code == 404\n\n    def test_get_arch_file_not_found(self, api_env, arch_project):\n        \"\"\"GET /api/projects/{id}/features/{name}/arch/{filename} returns 404 for missing file.\"\"\"\n        client, tmp_path = api_env\n        project_dir, _, _ = arch_project\n\n        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n\n        resp = client.get(\n            f\"/api/projects/{reg['id']}/features/test-feature/arch/nonexistent.mmd\"\n        )\n        assert resp.status_code == 404\n\n    def test_architecture_page_renders(self, api_env, arch_project):\n        \"\"\"GET /project/{id}/arch/{feature_name} renders the architecture viewer page.\"\"\"\n        client, tmp_path = api_env\n        project_dir, _, _ = arch_project\n\n        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n\n        resp = client.get(f\"/project/{reg['id']}/arch/test-feature\")\n        assert resp.status_code == 200\n        assert \"Architecture\" in resp.text or \"test-feature\" in resp.text\n\n    def test_architecture_page_no_manifest(self, api_env):\n        \"\"\"GET /project/{id}/arch/{feature_name} shows empty state when no manifest.\"\"\"\n        client, tmp_path = api_env\n        project_dir = tmp_path / \"empty_project\"\n        project_dir.mkdir()\n        feature_dir = project_dir / \".vista\" / \"features\" / \"empty-feature\"\n        feature_dir.mkdir(parents=True)\n\n        reg = client.post(\"/api/projects\", json={\"path\": str(project_dir)}).json()\n\n        resp = client.get(f\"/project/{reg['id']}/arch/empty-feature\")\n        assert resp.status_code == 200\n\n\nclass TestProgressServiceArch:\n    \"\"\"Tests for ProgressService architecture methods.\"\"\"\n\n    def test_read_arch_manifest_valid(self, tmp_path):\n        \"\"\"read_arch_manifest returns parsed JSON for valid manifest.\"\"\"\n        from server.services.progress_service import ProgressService\n\n        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n        arch_dir.mkdir(parents=True)\n\n        manifest = {\"feature\": \"test\", \"diagrams\": []}\n        (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n\n        result = ProgressService.read_arch_manifest(str(tmp_path), \"test\")\n        assert result == manifest\n\n    def test_read_arch_manifest_missing_file(self, tmp_path):\n        \"\"\"read_arch_manifest returns None for missing manifest.\"\"\"\n        from server.services.progress_service import ProgressService\n\n        result = ProgressService.read_arch_manifest(str(tmp_path), \"nonexistent\")\n        assert result is None\n\n    def test_read_arch_manifest_invalid_json(self, tmp_path):\n        \"\"\"read_arch_manifest returns None for invalid JSON.\"\"\"\n        from server.services.progress_service import ProgressService\n\n        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n        arch_dir.mkdir(parents=True)\n        (arch_dir / \"_arch.json\").write_text(\"not json\", encoding=\"utf-8\")\n\n        result = ProgressService.read_arch_manifest(str(tmp_path), \"test\")\n        assert result is None\n\n    def test_read_arch_file_valid_mmd(self, tmp_path):\n        \"\"\"read_arch_file returns content for valid .mmd file.\"\"\"\n        from server.services.progress_service import ProgressService\n\n        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n        arch_dir.mkdir(parents=True)\n        (arch_dir / \"diagram.mmd\").write_text(\"graph TD\\n    A-->B\", encoding=\"utf-8\")\n\n        result = ProgressService.read_arch_file(str(tmp_path), \"test\", \"diagram.mmd\")\n        assert result == \"graph TD\\n    A-->B\"\n\n    def test_read_arch_file_valid_drawio(self, tmp_path):\n        \"\"\"read_arch_file returns content for valid .drawio file.\"\"\"\n        from server.services.progress_service import ProgressService\n\n        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n        arch_dir.mkdir(parents=True)\n        (arch_dir / \"diagram.drawio\").write_text(\"<xml></xml>\", encoding=\"utf-8\")\n\n        result = ProgressService.read_arch_file(str(tmp_path), \"test\", \"diagram.drawio\")\n        assert result == \"<xml></xml>\"\n\n    def test_read_arch_file_path_traversal_dotdot(self, tmp_path):\n        \"\"\"read_arch_file blocks .. path traversal attempts.\"\"\"\n        from server.services.progress_service import ProgressService\n\n        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n        arch_dir.mkdir(parents=True)\n        (arch_dir / \"secret.txt\").write_text(\"secret\", encoding=\"utf-8\")\n\n        # Create file outside arch directory\n        (tmp_path / \"outside.txt\").write_text(\"outside content\", encoding=\"utf-8\")\n\n        result = ProgressService.read_arch_file(str(tmp_path), \"test\", \"../outside.txt\")\n        assert result is None\n\n    def test_read_arch_file_path_traversal_absolute(self, tmp_path):\n        \"\"\"read_arch_file blocks absolute path traversal attempts.\"\"\"\n        from server.services.progress_service import ProgressService\n\n        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n        arch_dir.mkdir(parents=True)\n\n        result = ProgressService.read_arch_file(str(tmp_path), \"test\", \"/etc/passwd\")\n        assert result is None\n\n    def test_read_arch_file_not_found(self, tmp_path):\n        \"\"\"read_arch_file returns None for non-existent file.\"\"\"\n        from server.services.progress_service import ProgressService\n\n        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n        arch_dir.mkdir(parents=True)\n\n        result = ProgressService.read_arch_file(str(tmp_path), \"test\", \"missing.mmd\")\n        assert result is None\n\n\nclass TestSchemaValidation:\n    \"\"\"Tests for JSON schema validation.\"\"\"\n\n    def _get_template_path(self, filename: str) -> Path:\n        \"\"\"Get path to a template file relative to test location.\"\"\"\n        # Tests are in vista/tests/, templates are in vista/templates/\n        return Path(__file__).parent.parent / \"templates\" / filename\n\n    def test_plan_schema_valid_minimal(self):\n        \"\"\"plan-schema.json validates plan with only implementationPhases.\"\"\"\n        import jsonschema\n\n        schema = json.loads(self._get_template_path(\"plan-schema.json\").read_text())\n\n        plan = {\n            \"meta\": {\n                \"feature\": \"test\",\n                \"version\": 1,\n                \"created\": \"2025-01-01T00:00:00Z\",\n                \"lastModified\": \"2025-01-01T00:00:00Z\",\n                \"status\": \"draft\",\n                \"description\": \"Test feature\",\n            },\n            \"sections\": {\"implementationPhases\": {\"phases\": []}},\n        }\n\n        # Should not raise\n        jsonschema.validate(plan, schema)\n\n    def test_plan_schema_valid_with_architecture(self):\n        \"\"\"plan-schema.json validates plan with architecture.ref.\"\"\"\n        import jsonschema\n\n        schema = json.loads(self._get_template_path(\"plan-schema.json\").read_text())\n\n        plan = {\n            \"meta\": {\n                \"feature\": \"test\",\n                \"version\": 1,\n                \"created\": \"2025-01-01T00:00:00Z\",\n                \"lastModified\": \"2025-01-01T00:00:00Z\",\n                \"status\": \"draft\",\n                \"description\": \"Test feature\",\n            },\n            \"sections\": {\n                \"architecture\": {\"ref\": \"./arch/_arch.json\"},\n                \"implementationPhases\": {\"phases\": []},\n            },\n        }\n\n        # Should not raise\n        jsonschema.validate(plan, schema)\n\n    def test_plan_schema_rejects_missing_phases(self):\n        \"\"\"plan-schema.json rejects plan missing implementationPhases.\"\"\"\n        import jsonschema\n\n        schema = json.loads(self._get_template_path(\"plan-schema.json\").read_text())\n\n        plan = {\n            \"meta\": {\n                \"feature\": \"test\",\n                \"version\": 1,\n                \"created\": \"2025-01-01T00:00:00Z\",\n                \"lastModified\": \"2025-01-01T00:00:00Z\",\n                \"status\": \"draft\",\n                \"description\": \"Test feature\",\n            },\n            \"sections\": {},\n        }\n\n        with pytest.raises(jsonschema.ValidationError):\n            jsonschema.validate(plan, schema)\n\n    def test_arch_schema_valid_manifest(self):\n        \"\"\"arch-schema.json validates a valid manifest.\"\"\"\n        import jsonschema\n\n        schema = json.loads(self._get_template_path(\"arch-schema.json\").read_text())\n\n        manifest = {\n            \"feature\": \"test\",\n            \"diagrams\": [\n                {\n                    \"name\": \"Test Diagram\",\n                    \"file\": \"test.mmd\",\n                    \"type\": \"mermaid\",\n                    \"diagramType\": \"flowchart\",\n                    \"description\": \"A test diagram\",\n                }\n            ],\n        }\n\n        # Should not raise\n        jsonschema.validate(manifest, schema)\n\n    def test_arch_schema_rejects_invalid_type(self):\n        \"\"\"arch-schema.json rejects invalid diagram type.\"\"\"\n        import jsonschema\n\n        schema = json.loads(self._get_template_path(\"arch-schema.json\").read_text())\n\n        manifest = {\n            \"feature\": \"test\",\n            \"diagrams\": [\n                {\n                    \"name\": \"Test Diagram\",\n                    \"file\": \"test.mmd\",\n                    \"type\": \"invalid_type\",\n                    \"diagramType\": \"flowchart\",\n                    \"description\": \"A test diagram\",\n                }\n            ],\n        }\n\n        with pytest.raises(jsonschema.ValidationError):\n            jsonschema.validate(manifest, schema)\n\n    def test_arch_schema_rejects_missing_fields(self):\n        \"\"\"arch-schema.json rejects manifest with missing required fields.\"\"\"\n        import jsonschema\n\n        schema = json.loads(self._get_template_path(\"arch-schema.json\").read_text())\n\n        manifest = {\n            \"feature\": \"test\",\n            \"diagrams\": [\n                {\n                    \"name\": \"Test Diagram\"\n                    # Missing file, type, diagramType\n                }\n            ],\n        }\n\n        with pytest.raises(jsonschema.ValidationError):\n            jsonschema.validate(manifest, schema)\n\n\nclass TestProjectServiceArch:\n    \"\"\"Tests for ProjectService architecture-related methods.\"\"\"\n\n    def test_scan_features_detailed_has_arch_manifest(self, tmp_path):\n        \"\"\"scan_features_detailed includes has_arch_manifest field.\"\"\"\n        from server.services.project_service import ProjectService\n\n        # Create feature with arch manifest\n        arch_dir = tmp_path / \".vista\" / \"features\" / \"with-arch\" / \"arch\"\n        arch_dir.mkdir(parents=True)\n        manifest = {\n            \"feature\": \"with-arch\",\n            \"diagrams\": [\n                {\n                    \"name\": \"D\",\n                    \"file\": \"d.mmd\",\n                    \"type\": \"mermaid\",\n                    \"diagramType\": \"flowchart\",\n                    \"description\": \"\",\n                }\n            ],\n        }\n        (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n        (arch_dir / \"d.mmd\").write_text(\"graph TD\", encoding=\"utf-8\")\n\n        # Create feature without arch\n        no_arch_dir = tmp_path / \".vista\" / \"features\" / \"no-arch\"\n        no_arch_dir.mkdir(parents=True)\n\n        features = ProjectService.scan_features_detailed(str(tmp_path))\n\n        # Find features by name\n        with_arch = next(f for f in features if f[\"name\"] == \"with-arch\")\n        without_arch = next(f for f in features if f[\"name\"] == \"no-arch\")\n\n        assert with_arch[\"has_arch_manifest\"] is True\n        assert without_arch[\"has_arch_manifest\"] is False\n\n    def test_scan_features_detailed_arch_diagram_count(self, tmp_path):\n        \"\"\"scan_features_detailed includes arch_diagram_count field.\"\"\"\n        from server.services.project_service import ProjectService\n\n        arch_dir = tmp_path / \".vista\" / \"features\" / \"test\" / \"arch\"\n        arch_dir.mkdir(parents=True)\n\n        # Create actual diagram files (count is based on files, not manifest)\n        (arch_dir / \"d1.mmd\").write_text(\"graph TD\\n    A-->B\", encoding=\"utf-8\")\n        (arch_dir / \"d2.mmd\").write_text(\n            \"sequenceDiagram\\n    A->>B: msg\", encoding=\"utf-8\"\n        )\n        (arch_dir / \"d3.drawio\").write_text(\"<mxfile></mxfile>\", encoding=\"utf-8\")\n\n        features = ProjectService.scan_features_detailed(str(tmp_path))\n\n        assert features[0][\"arch_diagram_count\"] == 3\n\n    def test_scan_features_detailed_no_arch(self, tmp_path):\n        \"\"\"scan_features_detailed returns 0 count for feature without arch directory.\"\"\"\n        from server.services.project_service import ProjectService\n\n        feature_dir = tmp_path / \".vista\" / \"features\" / \"test\"\n        feature_dir.mkdir(parents=True)\n\n        features = ProjectService.scan_features_detailed(str(tmp_path))\n\n        assert features[0][\"has_arch_manifest\"] is False\n        assert features[0][\"arch_diagram_count\"] == 0\n\n\nclass TestContextAssembler:\n    \"\"\"Tests for ContextAssembler prompt helpers.\"\"\"\n\n    def test_build_prompt_includes_context(self):\n        \"\"\"build_full_prompt includes diagram context before message.\"\"\"\n        from server.services.context_assembler import ContextAssembler\n\n        prompt = ContextAssembler.build_full_prompt(\n            message=\"What do you think?\", context=\"graph TD\\n    A-->B\", history=None\n        )\n\n        assert \"DIAGRAM CONTEXT\" in prompt\n        assert \"graph TD\" in prompt\n        assert \"What do you think?\" in prompt\n\n    def test_build_prompt_ignores_history(self):\n        \"\"\"build_full_prompt ignores history — providers maintain it natively.\"\"\"\n        from server.services.context_assembler import ContextAssembler\n\n        history = [\n            {\"role\": \"user\", \"content\": \"Hello\"},\n            {\"role\": \"assistant\", \"content\": \"Hi there\"},\n        ]\n\n        prompt = ContextAssembler.build_full_prompt(\n            message=\"What's next?\", context=None, history=history\n        )\n\n        # History should NOT be re-sent\n        assert \"CONVERSATION HISTORY\" not in prompt\n        assert \"Hi there\" not in prompt\n        # Current message should be present\n        assert \"What's next?\" in prompt\n\n    def test_build_prompt_works_with_empty_context_and_history(self):\n        \"\"\"build_full_prompt works with no context or history.\"\"\"\n        from server.services.context_assembler import ContextAssembler\n\n        prompt = ContextAssembler.build_full_prompt(\n            message=\"Hello\", context=None, history=None\n        )\n\n        assert \"Hello\" in prompt\n","numLines":570,"startLine":1,"totalLines":570}}}
