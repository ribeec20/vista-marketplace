{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NaRkfauiR3NhQSJPDtEPEB","type":"tool_result","content":"     1→\"\"\"Architecture diagram viewing and chat.\"\"\"\n     2→from fastapi import APIRouter, HTTPException, Request\n     3→from fastapi.responses import PlainTextResponse\n     4→from fastapi.templating import Jinja2Templates\n     5→\n     6→from server import config\n     7→from server.services.project_service import ProjectService\n     8→from server.services.progress_service import ProgressService\n     9→from server.services.provider_service import get_enabled_providers\n    10→\n    11→router = APIRouter(tags=[\"architecture\"])\n    12→templates = Jinja2Templates(directory=str(config.VIEWS_DIR))\n    13→\n    14→\n    15→@router.get(\"/api/projects/{project_id}/features/{feature_name}/arch\")\n    16→async def get_arch_manifest(project_id: str, feature_name: str):\n    17→    \"\"\"Return the _arch.json manifest for a feature.\"\"\"\n    18→    project = ProjectService.get_by_id(project_id)\n    19→    if not project:\n    20→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    21→\n    22→    manifest = ProgressService.read_arch_manifest(project.path, feature_name)\n    23→    if manifest is None:\n    24→        raise HTTPException(status_code=404, detail=\"No architecture manifest found\")\n    25→\n    26→    return manifest\n    27→\n    28→\n    29→@router.get(\"/api/projects/{project_id}/features/{feature_name}/arch/{filename}\")\n    30→async def get_arch_file(project_id: str, feature_name: str, filename: str):\n    31→    \"\"\"Return raw content of a diagram file from arch/.\"\"\"\n    32→    project = ProjectService.get_by_id(project_id)\n    33→    if not project:\n    34→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    35→\n    36→    content = ProgressService.read_arch_file(project.path, feature_name, filename)\n    37→    if content is None:\n    38→        raise HTTPException(status_code=404, detail=\"Diagram file not found\")\n    39→\n    40→    # Determine content type\n    41→    if filename.endswith(\".mmd\"):\n    42→        media_type = \"text/plain\"\n    43→    elif filename.endswith(\".drawio\"):\n    44→        media_type = \"application/xml\"\n    45→    else:\n    46→        media_type = \"text/plain\"\n    47→\n    48→    return PlainTextResponse(content=content, media_type=media_type)\n    49→\n    50→\n    51→@router.get(\"/project/{project_id}/arch/{feature_name}\")\n    52→async def architecture_viewer_page(request: Request, project_id: str, feature_name: str):\n    53→    \"\"\"Render architecture diagram viewer page.\"\"\"\n    54→    project = ProjectService.get_by_id(project_id)\n    55→    if not project:\n    56→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    57→\n    58→    manifest = ProgressService.read_arch_manifest(project.path, feature_name)\n    59→    providers = [p.to_summary_dict() for p in get_enabled_providers()]\n    60→\n    61→    return templates.TemplateResponse(request, \"architecture.html\", {\n    62→        \"project\": project.to_dict(),\n    63→        \"feature_name\": feature_name,\n    64→        \"manifest\": manifest,\n    65→        \"providers\": providers,\n    66→    })\n    67→\n    68→\n    69→@router.get(\"/project/{project_id}/arch/{feature_name}/diagram/{filename}\")\n    70→async def diagram_expand_page(\n    71→    request: Request, project_id: str, feature_name: str, filename: str\n    72→):\n    73→    \"\"\"Render a single diagram in a full-page view.\"\"\"\n    74→    project = ProjectService.get_by_id(project_id)\n    75→    if not project:\n    76→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    77→\n    78→    content = ProgressService.read_arch_file(project.path, feature_name, filename)\n    79→    if content is None:\n    80→        raise HTTPException(status_code=404, detail=\"Diagram file not found\")\n    81→\n    82→    diagram_name = filename.rsplit(\".\", 1)[0].replace(\"-\", \" \").replace(\"_\", \" \").title()\n    83→    providers = [p.to_summary_dict() for p in get_enabled_providers()]\n    84→\n    85→    return templates.TemplateResponse(request, \"diagram_expand.html\", {\n    86→        \"project\": project.to_dict(),\n    87→        \"feature_name\": feature_name,\n    88→        \"filename\": filename,\n    89→        \"diagram_name\": diagram_name,\n    90→        \"providers\": providers,\n    91→    })\n    92→"}]},"parent_tool_use_id":null,"session_id":"59ccf3de-4e5f-4501-a467-c73d833f9d6b","uuid":"cda56550-f836-4079-87c8-9447f6f17ea9","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/routes/architecture.py","content":"\"\"\"Architecture diagram viewing and chat.\"\"\"\nfrom fastapi import APIRouter, HTTPException, Request\nfrom fastapi.responses import PlainTextResponse\nfrom fastapi.templating import Jinja2Templates\n\nfrom server import config\nfrom server.services.project_service import ProjectService\nfrom server.services.progress_service import ProgressService\nfrom server.services.provider_service import get_enabled_providers\n\nrouter = APIRouter(tags=[\"architecture\"])\ntemplates = Jinja2Templates(directory=str(config.VIEWS_DIR))\n\n\n@router.get(\"/api/projects/{project_id}/features/{feature_name}/arch\")\nasync def get_arch_manifest(project_id: str, feature_name: str):\n    \"\"\"Return the _arch.json manifest for a feature.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    manifest = ProgressService.read_arch_manifest(project.path, feature_name)\n    if manifest is None:\n        raise HTTPException(status_code=404, detail=\"No architecture manifest found\")\n\n    return manifest\n\n\n@router.get(\"/api/projects/{project_id}/features/{feature_name}/arch/{filename}\")\nasync def get_arch_file(project_id: str, feature_name: str, filename: str):\n    \"\"\"Return raw content of a diagram file from arch/.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    content = ProgressService.read_arch_file(project.path, feature_name, filename)\n    if content is None:\n        raise HTTPException(status_code=404, detail=\"Diagram file not found\")\n\n    # Determine content type\n    if filename.endswith(\".mmd\"):\n        media_type = \"text/plain\"\n    elif filename.endswith(\".drawio\"):\n        media_type = \"application/xml\"\n    else:\n        media_type = \"text/plain\"\n\n    return PlainTextResponse(content=content, media_type=media_type)\n\n\n@router.get(\"/project/{project_id}/arch/{feature_name}\")\nasync def architecture_viewer_page(request: Request, project_id: str, feature_name: str):\n    \"\"\"Render architecture diagram viewer page.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    manifest = ProgressService.read_arch_manifest(project.path, feature_name)\n    providers = [p.to_summary_dict() for p in get_enabled_providers()]\n\n    return templates.TemplateResponse(request, \"architecture.html\", {\n        \"project\": project.to_dict(),\n        \"feature_name\": feature_name,\n        \"manifest\": manifest,\n        \"providers\": providers,\n    })\n\n\n@router.get(\"/project/{project_id}/arch/{feature_name}/diagram/{filename}\")\nasync def diagram_expand_page(\n    request: Request, project_id: str, feature_name: str, filename: str\n):\n    \"\"\"Render a single diagram in a full-page view.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    content = ProgressService.read_arch_file(project.path, feature_name, filename)\n    if content is None:\n        raise HTTPException(status_code=404, detail=\"Diagram file not found\")\n\n    diagram_name = filename.rsplit(\".\", 1)[0].replace(\"-\", \" \").replace(\"_\", \" \").title()\n    providers = [p.to_summary_dict() for p in get_enabled_providers()]\n\n    return templates.TemplateResponse(request, \"diagram_expand.html\", {\n        \"project\": project.to_dict(),\n        \"feature_name\": feature_name,\n        \"filename\": filename,\n        \"diagram_name\": diagram_name,\n        \"providers\": providers,\n    })\n","numLines":92,"startLine":1,"totalLines":92}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01GmSNbydwFB5Mpy9bAPdcfA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01P1om4STKpgQfNdURpbFiH4","name":"Read","input":{"file_path":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/services/diagram_watcher.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":16789,"cache_read_input_tokens":40543,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16789},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"59ccf3de-4e5f-4501-a467-c73d833f9d6b","uuid":"7f4c0ec9-cd7b-4991-b4f1-6bcdabd33ee4"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P1om4STKpgQfNdURpbFiH4","type":"tool_result","content":"     1→\"\"\"Diagram file watcher using watchdog filesystem events.\n     2→\n     3→Uses watchdog's Observer for instant filesystem event detection on Windows\n     4→(ReadDirectoryChangesW) with 100ms debounce to coalesce rapid file saves.\n     5→Broadcasts change events via async queues (same pub-sub pattern as loop_service).\n     6→\n     7→Auto-updates the _arch.json manifest when diagrams are added or removed.\n     8→\"\"\"\n     9→\n    10→import asyncio\n    11→import json\n    12→import logging\n    13→import threading\n    14→from pathlib import Path\n    15→from typing import Optional\n    16→\n    17→from watchdog.events import FileSystemEvent, FileSystemEventHandler\n    18→from watchdog.observers import Observer\n    19→\n    20→log = logging.getLogger(__name__)\n    21→\n    22→\n    23→class _DiagramEventHandler(FileSystemEventHandler):\n    24→    \"\"\"Handles filesystem events for .mmd/.drawio files.\"\"\"\n    25→\n    26→    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\n    27→\n    28→    def __init__(self, key: str, arch_dir: Path, watcher: \"DiagramWatcher\"):\n    29→        super().__init__()\n    30→        self.key = key\n    31→        self.arch_dir = arch_dir\n    32→        self.watcher = watcher\n    33→        self._lock = threading.Lock()\n    34→        self._pending: dict[str, tuple[str, str]] = {}  # path -> (event_type, filename)\n    35→        self._timer: Optional[threading.Timer] = None\n    36→\n    37→    def _is_diagram(self, path: str) -> bool:\n    38→        return Path(path).suffix in self.WATCH_EXTENSIONS\n    39→\n    40→    def on_created(self, event: FileSystemEvent) -> None:\n    41→        if not event.is_directory and self._is_diagram(event.src_path):\n    42→            self._debounced_notify(event.src_path, \"diagram_added\")\n    43→\n    44→    def on_modified(self, event: FileSystemEvent) -> None:\n    45→        if not event.is_directory and self._is_diagram(event.src_path):\n    46→            self._debounced_notify(event.src_path, \"diagram_changed\")\n    47→\n    48→    def on_deleted(self, event: FileSystemEvent) -> None:\n    49→        if not event.is_directory and self._is_diagram(event.src_path):\n    50→            self._debounced_notify(event.src_path, \"diagram_removed\")\n    51→\n    52→    def _debounced_notify(self, path: str, event_type: str, delay: float = 0.1):\n    53→        \"\"\"Debounce rapid events (100ms) to coalesce file saves.\"\"\"\n    54→        filename = Path(path).name\n    55→        with self._lock:\n    56→            self._pending[path] = (event_type, filename)\n    57→            if self._timer is not None:\n    58→                self._timer.cancel()\n    59→            self._timer = threading.Timer(delay, self._flush)\n    60→            self._timer.start()\n    61→\n    62→    def _flush(self) -> None:\n    63→        \"\"\"Flush all pending events.\"\"\"\n    64→        with self._lock:\n    65→            pending = dict(self._pending)\n    66→            self._pending.clear()\n    67→            self._timer = None\n    68→\n    69→        manifest_changed = False\n    70→        for path, (event_type, filename) in pending.items():\n    71→            if event_type == \"diagram_removed\":\n    72→                data = {\"file\": filename}\n    73→                manifest_changed = True\n    74→            else:\n    75→                content = _read_file(Path(path))\n    76→                data = {\"file\": filename, \"content\": content}\n    77→                if event_type == \"diagram_added\":\n    78→                    manifest_changed = True\n    79→\n    80→            self.watcher._schedule_broadcast(\n    81→                self.key, {\"event\": event_type, \"data\": data}\n    82→            )\n    83→\n    84→        if manifest_changed:\n    85→            self.watcher._schedule_manifest_update(self.key, self.arch_dir)\n    86→\n    87→    def cancel_timer(self) -> None:\n    88→        \"\"\"Cancel any pending debounce timer.\"\"\"\n    89→        with self._lock:\n    90→            if self._timer is not None:\n    91→                self._timer.cancel()\n    92→                self._timer = None\n    93→\n    94→\n    95→def _read_file(path: Path) -> str:\n    96→    try:\n    97→        return path.read_text(encoding=\"utf-8\")\n    98→    except Exception:\n    99→        return \"\"\n   100→\n   101→\n   102→def _detect_diagram_type(path: Path) -> str:\n   103→    \"\"\"Detect Mermaid diagram type from file content.\"\"\"\n   104→    try:\n   105→        content = path.read_text(encoding=\"utf-8\").strip()\n   106→        first_line = content.split(\"\\n\")[0].strip().lower() if content else \"\"\n   107→        for dtype in (\n   108→            \"graph\", \"flowchart\", \"sequencediagram\", \"sequence\",\n   109→            \"classdiagram\", \"class\", \"statediagram\", \"state\",\n   110→            \"erdiagram\", \"er\", \"gantt\", \"pie\", \"gitgraph\",\n   111→            \"c4context\", \"c4container\", \"c4component\", \"c4deployment\",\n   112→            \"mindmap\", \"timeline\",\n   113→        ):\n   114→            if dtype in first_line.replace(\" \", \"\").replace(\"-\", \"\"):\n   115→                return dtype\n   116→        return \"flowchart\"\n   117→    except Exception:\n   118→        return \"flowchart\"\n   119→\n   120→\n   121→class DiagramWatcher:\n   122→    \"\"\"Watches arch/ directories for file changes using watchdog and notifies subscribers.\"\"\"\n   123→\n   124→    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\n   125→\n   126→    def __init__(self):\n   127→        # Key: \"{project_id}:{feature_name}\" -> list of subscriber queues\n   128→        self._subscribers: dict[str, list[asyncio.Queue]] = {}\n   129→        # Key: same -> Observer instance\n   130→        self._observers: dict[str, Observer] = {}\n   131→        # Key: same -> event handler\n   132→        self._handlers: dict[str, _DiagramEventHandler] = {}\n   133→        # Key: same -> arch dir Path\n   134→        self._watch_dirs: dict[str, Path] = {}\n   135→        # Event loop reference for cross-thread scheduling\n   136→        self._loop: Optional[asyncio.AbstractEventLoop] = None\n   137→\n   138→    @staticmethod\n   139→    def _key(project_id: str, feature_name: str) -> str:\n   140→        return f\"{project_id}:{feature_name}\"\n   141→\n   142→    def subscribe(\n   143→        self, project_id: str, feature_name: str, arch_dir: Path\n   144→    ) -> asyncio.Queue:\n   145→        \"\"\"Register a subscriber for diagram changes. Starts watching if not already.\"\"\"\n   146→        key = self._key(project_id, feature_name)\n   147→\n   148→        # Capture the event loop for cross-thread scheduling\n   149→        try:\n   150→            self._loop = asyncio.get_running_loop()\n   151→        except RuntimeError:\n   152→            pass\n   153→\n   154→        if key not in self._subscribers:\n   155→            self._subscribers[key] = []\n   156→            self._watch_dirs[key] = arch_dir\n   157→            self._start_observer(key, arch_dir)\n   158→\n   159→        queue: asyncio.Queue = asyncio.Queue(maxsize=200)\n   160→        self._subscribers[key].append(queue)\n   161→        return queue\n   162→\n   163→    def unsubscribe(\n   164→        self, project_id: str, feature_name: str, queue: asyncio.Queue\n   165→    ) -> None:\n   166→        key = self._key(project_id, feature_name)\n   167→        if key in self._subscribers:\n   168→            self._subscribers[key] = [\n   169→                q for q in self._subscribers[key] if q is not queue\n   170→            ]\n   171→            if not self._subscribers[key]:\n   172→                del self._subscribers[key]\n   173→                self._watch_dirs.pop(key, None)\n   174→                self._stop_observer(key)\n   175→\n   176→    def _start_observer(self, key: str, arch_dir: Path) -> None:\n   177→        \"\"\"Start a watchdog Observer for the given arch directory.\"\"\"\n   178→        if not arch_dir.is_dir():\n   179→            log.warning(\"Diagram watch dir does not exist: %s\", arch_dir)\n   180→            return\n   181→\n   182→        handler = _DiagramEventHandler(key, arch_dir, self)\n   183→        observer = Observer()\n   184→        observer.schedule(handler, str(arch_dir), recursive=False)\n   185→        observer.daemon = True\n   186→        observer.start()\n   187→\n   188→        self._observers[key] = observer\n   189→        self._handlers[key] = handler\n   190→        log.info(\"Started watching diagrams: %s\", arch_dir)\n   191→\n   192→    def _stop_observer(self, key: str) -> None:\n   193→        \"\"\"Stop the watchdog Observer for the given key.\"\"\"\n   194→        handler = self._handlers.pop(key, None)\n   195→        if handler:\n   196→            handler.cancel_timer()\n   197→\n   198→        observer = self._observers.pop(key, None)\n   199→        if observer:\n   200→            observer.stop()\n   201→            observer.join(timeout=2)\n   202→            log.info(\"Stopped watching diagrams for key: %s\", key)\n   203→\n   204→    def _schedule_broadcast(self, key: str, message: dict) -> None:\n   205→        \"\"\"Thread-safe: schedule a broadcast onto the asyncio event loop.\"\"\"\n   206→        if self._loop and not self._loop.is_closed():\n   207→            self._loop.call_soon_threadsafe(\n   208→                asyncio.ensure_future,\n   209→                self._broadcast(key, message),\n   210→            )\n   211→\n   212→    def _schedule_manifest_update(self, key: str, arch_dir: Path) -> None:\n   213→        \"\"\"Thread-safe: schedule a manifest update onto the asyncio event loop.\"\"\"\n   214→        if self._loop and not self._loop.is_closed():\n   215→            self._loop.call_soon_threadsafe(\n   216→                self._update_manifest_sync, arch_dir,\n   217→            )\n   218→\n   219→    async def _broadcast(self, key: str, message: dict) -> None:\n   220→        if key not in self._subscribers:\n   221→            return\n   222→        dead_queues = []\n   223→        for queue in self._subscribers[key]:\n   224→            try:\n   225→                queue.put_nowait(message)\n   226→            except asyncio.QueueFull:\n   227→                dead_queues.append(queue)\n   228→        for q in dead_queues:\n   229→            if key in self._subscribers:\n   230→                self._subscribers[key].remove(q)\n   231→\n   232→    @staticmethod\n   233→    def _update_manifest_sync(arch_dir: Path) -> None:\n   234→        \"\"\"Scan arch dir for diagram files and regenerate _arch.json manifest.\"\"\"\n   235→        if not arch_dir.is_dir():\n   236→            return\n   237→        entries = []\n   238→        for f in sorted(arch_dir.iterdir()):\n   239→            if f.is_file() and f.suffix in DiagramWatcher.WATCH_EXTENSIONS:\n   240→                name = f.stem.replace(\"-\", \" \").replace(\"_\", \" \").title()\n   241→                diagram_type = _detect_diagram_type(f) if f.suffix == \".mmd\" else \"drawio\"\n   242→                entries.append({\n   243→                    \"name\": name,\n   244→                    \"file\": f.name,\n   245→                    \"type\": \"mermaid\" if f.suffix == \".mmd\" else \"drawio\",\n   246→                    \"diagramType\": diagram_type,\n   247→                })\n   248→        manifest_path = arch_dir / \"_arch.json\"\n   249→        feature_name = arch_dir.parent.name\n   250→        manifest = {\"feature\": feature_name, \"diagrams\": entries}\n   251→        try:\n   252→            manifest_path.write_text(\n   253→                json.dumps(manifest, indent=2), encoding=\"utf-8\"\n   254→            )\n   255→        except OSError as e:\n   256→            log.warning(\"Failed to update manifest: %s\", e)\n   257→\n   258→    async def stop(self) -> None:\n   259→        \"\"\"Stop all observers and clear all state.\"\"\"\n   260→        for key in list(self._observers.keys()):\n   261→            self._stop_observer(key)\n   262→        self._subscribers.clear()\n   263→        self._watch_dirs.clear()\n   264→\n   265→\n   266→# Singleton instance\n   267→diagram_watcher = DiagramWatcher()\n   268→"}]},"parent_tool_use_id":null,"session_id":"59ccf3de-4e5f-4501-a467-c73d833f9d6b","uuid":"87314434-869b-424b-aa59-d026d928bb72","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/services/diagram_watcher.py","content":"\"\"\"Diagram file watcher using watchdog filesystem events.\n\nUses watchdog's Observer for instant filesystem event detection on Windows\n(ReadDirectoryChangesW) with 100ms debounce to coalesce rapid file saves.\nBroadcasts change events via async queues (same pub-sub pattern as loop_service).\n\nAuto-updates the _arch.json manifest when diagrams are added or removed.\n\"\"\"\n\nimport asyncio\nimport json\nimport logging\nimport threading\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom watchdog.events import FileSystemEvent, FileSystemEventHandler\nfrom watchdog.observers import Observer\n\nlog = logging.getLogger(__name__)\n\n\nclass _DiagramEventHandler(FileSystemEventHandler):\n    \"\"\"Handles filesystem events for .mmd/.drawio files.\"\"\"\n\n    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\n\n    def __init__(self, key: str, arch_dir: Path, watcher: \"DiagramWatcher\"):\n        super().__init__()\n        self.key = key\n        self.arch_dir = arch_dir\n        self.watcher = watcher\n        self._lock = threading.Lock()\n        self._pending: dict[str, tuple[str, str]] = {}  # path -> (event_type, filename)\n        self._timer: Optional[threading.Timer] = None\n\n    def _is_diagram(self, path: str) -> bool:\n        return Path(path).suffix in self.WATCH_EXTENSIONS\n\n    def on_created(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_added\")\n\n    def on_modified(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_changed\")\n\n    def on_deleted(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_removed\")\n\n    def _debounced_notify(self, path: str, event_type: str, delay: float = 0.1):\n        \"\"\"Debounce rapid events (100ms) to coalesce file saves.\"\"\"\n        filename = Path(path).name\n        with self._lock:\n            self._pending[path] = (event_type, filename)\n            if self._timer is not None:\n                self._timer.cancel()\n            self._timer = threading.Timer(delay, self._flush)\n            self._timer.start()\n\n    def _flush(self) -> None:\n        \"\"\"Flush all pending events.\"\"\"\n        with self._lock:\n            pending = dict(self._pending)\n            self._pending.clear()\n            self._timer = None\n\n        manifest_changed = False\n        for path, (event_type, filename) in pending.items():\n            if event_type == \"diagram_removed\":\n                data = {\"file\": filename}\n                manifest_changed = True\n            else:\n                content = _read_file(Path(path))\n                data = {\"file\": filename, \"content\": content}\n                if event_type == \"diagram_added\":\n                    manifest_changed = True\n\n            self.watcher._schedule_broadcast(\n                self.key, {\"event\": event_type, \"data\": data}\n            )\n\n        if manifest_changed:\n            self.watcher._schedule_manifest_update(self.key, self.arch_dir)\n\n    def cancel_timer(self) -> None:\n        \"\"\"Cancel any pending debounce timer.\"\"\"\n        with self._lock:\n            if self._timer is not None:\n                self._timer.cancel()\n                self._timer = None\n\n\ndef _read_file(path: Path) -> str:\n    try:\n        return path.read_text(encoding=\"utf-8\")\n    except Exception:\n        return \"\"\n\n\ndef _detect_diagram_type(path: Path) -> str:\n    \"\"\"Detect Mermaid diagram type from file content.\"\"\"\n    try:\n        content = path.read_text(encoding=\"utf-8\").strip()\n        first_line = content.split(\"\\n\")[0].strip().lower() if content else \"\"\n        for dtype in (\n            \"graph\", \"flowchart\", \"sequencediagram\", \"sequence\",\n            \"classdiagram\", \"class\", \"statediagram\", \"state\",\n            \"erdiagram\", \"er\", \"gantt\", \"pie\", \"gitgraph\",\n            \"c4context\", \"c4container\", \"c4component\", \"c4deployment\",\n            \"mindmap\", \"timeline\",\n        ):\n            if dtype in first_line.replace(\" \", \"\").replace(\"-\", \"\"):\n                return dtype\n        return \"flowchart\"\n    except Exception:\n        return \"flowchart\"\n\n\nclass DiagramWatcher:\n    \"\"\"Watches arch/ directories for file changes using watchdog and notifies subscribers.\"\"\"\n\n    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\n\n    def __init__(self):\n        # Key: \"{project_id}:{feature_name}\" -> list of subscriber queues\n        self._subscribers: dict[str, list[asyncio.Queue]] = {}\n        # Key: same -> Observer instance\n        self._observers: dict[str, Observer] = {}\n        # Key: same -> event handler\n        self._handlers: dict[str, _DiagramEventHandler] = {}\n        # Key: same -> arch dir Path\n        self._watch_dirs: dict[str, Path] = {}\n        # Event loop reference for cross-thread scheduling\n        self._loop: Optional[asyncio.AbstractEventLoop] = None\n\n    @staticmethod\n    def _key(project_id: str, feature_name: str) -> str:\n        return f\"{project_id}:{feature_name}\"\n\n    def subscribe(\n        self, project_id: str, feature_name: str, arch_dir: Path\n    ) -> asyncio.Queue:\n        \"\"\"Register a subscriber for diagram changes. Starts watching if not already.\"\"\"\n        key = self._key(project_id, feature_name)\n\n        # Capture the event loop for cross-thread scheduling\n        try:\n            self._loop = asyncio.get_running_loop()\n        except RuntimeError:\n            pass\n\n        if key not in self._subscribers:\n            self._subscribers[key] = []\n            self._watch_dirs[key] = arch_dir\n            self._start_observer(key, arch_dir)\n\n        queue: asyncio.Queue = asyncio.Queue(maxsize=200)\n        self._subscribers[key].append(queue)\n        return queue\n\n    def unsubscribe(\n        self, project_id: str, feature_name: str, queue: asyncio.Queue\n    ) -> None:\n        key = self._key(project_id, feature_name)\n        if key in self._subscribers:\n            self._subscribers[key] = [\n                q for q in self._subscribers[key] if q is not queue\n            ]\n            if not self._subscribers[key]:\n                del self._subscribers[key]\n                self._watch_dirs.pop(key, None)\n                self._stop_observer(key)\n\n    def _start_observer(self, key: str, arch_dir: Path) -> None:\n        \"\"\"Start a watchdog Observer for the given arch directory.\"\"\"\n        if not arch_dir.is_dir():\n            log.warning(\"Diagram watch dir does not exist: %s\", arch_dir)\n            return\n\n        handler = _DiagramEventHandler(key, arch_dir, self)\n        observer = Observer()\n        observer.schedule(handler, str(arch_dir), recursive=False)\n        observer.daemon = True\n        observer.start()\n\n        self._observers[key] = observer\n        self._handlers[key] = handler\n        log.info(\"Started watching diagrams: %s\", arch_dir)\n\n    def _stop_observer(self, key: str) -> None:\n        \"\"\"Stop the watchdog Observer for the given key.\"\"\"\n        handler = self._handlers.pop(key, None)\n        if handler:\n            handler.cancel_timer()\n\n        observer = self._observers.pop(key, None)\n        if observer:\n            observer.stop()\n            observer.join(timeout=2)\n            log.info(\"Stopped watching diagrams for key: %s\", key)\n\n    def _schedule_broadcast(self, key: str, message: dict) -> None:\n        \"\"\"Thread-safe: schedule a broadcast onto the asyncio event loop.\"\"\"\n        if self._loop and not self._loop.is_closed():\n            self._loop.call_soon_threadsafe(\n                asyncio.ensure_future,\n                self._broadcast(key, message),\n            )\n\n    def _schedule_manifest_update(self, key: str, arch_dir: Path) -> None:\n        \"\"\"Thread-safe: schedule a manifest update onto the asyncio event loop.\"\"\"\n        if self._loop and not self._loop.is_closed():\n            self._loop.call_soon_threadsafe(\n                self._update_manifest_sync, arch_dir,\n            )\n\n    async def _broadcast(self, key: str, message: dict) -> None:\n        if key not in self._subscribers:\n            return\n        dead_queues = []\n        for queue in self._subscribers[key]:\n            try:\n                queue.put_nowait(message)\n            except asyncio.QueueFull:\n                dead_queues.append(queue)\n        for q in dead_queues:\n            if key in self._subscribers:\n                self._subscribers[key].remove(q)\n\n    @staticmethod\n    def _update_manifest_sync(arch_dir: Path) -> None:\n        \"\"\"Scan arch dir for diagram files and regenerate _arch.json manifest.\"\"\"\n        if not arch_dir.is_dir():\n            return\n        entries = []\n        for f in sorted(arch_dir.iterdir()):\n            if f.is_file() and f.suffix in DiagramWatcher.WATCH_EXTENSIONS:\n                name = f.stem.replace(\"-\", \" \").replace(\"_\", \" \").title()\n                diagram_type = _detect_diagram_type(f) if f.suffix == \".mmd\" else \"drawio\"\n                entries.append({\n                    \"name\": name,\n                    \"file\": f.name,\n                    \"type\": \"mermaid\" if f.suffix == \".mmd\" else \"drawio\",\n                    \"diagramType\": diagram_type,\n                })\n        manifest_path = arch_dir / \"_arch.json\"\n        feature_name = arch_dir.parent.name\n        manifest = {\"feature\": feature_name, \"diagrams\": entries}\n        try:\n            manifest_path.write_text(\n                json.dumps(manifest, indent=2), encoding=\"utf-8\"\n            )\n        except OSError as e:\n            log.warning(\"Failed to update manifest: %s\", e)\n\n    async def stop(self) -> None:\n        \"\"\"Stop all observers and clear all state.\"\"\"\n        for key in list(self._observers.keys()):\n            self._stop_observer(key)\n        self._subscribers.clear()\n        self._watch_dirs.clear()\n\n\n# Singleton instance\ndiagram_watcher = DiagramWatcher()\n","numLines":268,"startLine":1,"totalLines":268}}}
