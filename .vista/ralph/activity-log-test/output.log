vents\n    88→\n    89→        # Max iterations reached\n    90→        m = MAX_REACHED.search(line)\n    91→        if m:\n    92→            events.append(ParsedEvent(\"max_reached\", {\"max\": int(m.group(1))}))\n    93→            return events\n    94→\n    95→        # All phases complete\n    96→        if ALL_PHASES.search(line):\n    97→            events.append(ParsedEvent(\"all_phases_complete\", {}))\n    98→            return events\n    99→\n   100→        return events\n   101→\n   102→\n   103→def parse_stream_json_activity(\n   104→    lines: list[str],\n   105→) -> tuple[list[str], Optional[int]]:\n   106→    \"\"\"Parse stream-json output lines into human-readable activity entries.\n   107→\n   108→    Extracts assistant text, tool calls, and iteration markers from\n   109→    Claude's ``--output-format=stream-json`` output.\n   110→\n   111→    Returns ``(activity_lines, current_iteration)``.\n   112→    \"\"\"\n   113→    activity: list[str] = []\n   114→    current_iteration: Optional[int] = None\n   115→\n   116→    for raw in lines:\n   117→        line = raw.strip()\n   118→        if not line:\n   119→            continue\n   120→\n   121→        # Non-JSON iteration markers from the loop script\n   122→        m = ITERATION_PATTERN.search(line)\n   123→        if m:\n   124→            current_iteration = int(m.group(1))\n   125→            activity.append(line)\n   126→            continue\n   127→        m = ITERATION_COMPLETE.search(line)\n   128→        if m:\n   129→            current_iteration = int(m.group(1))\n   130→            activity.append(line)\n   131→            continue\n   132→        m = LOOP_FINISHED.search(line)\n   133→        if m:\n   134→            activity.append(line)\n   135→            continue\n   136→        m = MAX_REACHED.search(line)\n   137→        if m:\n   138→            activity.append(line)\n   139→            continue\n   140→        m = TIMESTAMP_PATTERN.search(line)\n   141→        if m:\n   142