{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014PmhMrr21HkXkvJVHCHLG6","type":"tool_result","content":"     1→\"\"\"Tests for ralph_service job management.\"\"\"\n     2→\n     3→import json\n     4→from pathlib import Path\n     5→from unittest.mock import MagicMock, patch\n     6→\n     7→import pytest\n     8→\n     9→\n    10→class DummyProvider:\n    11→    name = \"dummy\"\n    12→    display_name = \"Dummy Provider\"\n    13→\n    14→    def get_invocation(self, shell: str = \"ps1\") -> str:\n    15→        if shell == \"sh\":\n    16→            return 'echo \"ITERATION $ITERATION\" >> \"$PROGRESS_FILE\"'\n    17→        return 'Add-Content -Path $ProgressFile -Value \"ITERATION $Iteration\"'\n    18→\n    19→\n    20→def _write_job(job_dir: Path, job: dict) -> None:\n    21→    job_dir.mkdir(parents=True, exist_ok=True)\n    22→    (job_dir / \"job.json\").write_text(json.dumps(job), encoding=\"utf-8\")\n    23→\n    24→\n    25→class TestRalphServiceCreateJob:\n    26→    def test_create_job_creates_files(self, tmp_path):\n    27→        from server.services.ralph_service import RalphService\n    28→\n    29→        provider = DummyProvider()\n    30→        svc = RalphService()\n    31→\n    32→        templates_dir = tmp_path / \"templates\"\n    33→        templates_dir.mkdir()\n    34→        (templates_dir / \"PROMPT_plan_adhoc.md\").write_text(\n    35→            \"Plan {{FEATURE_NAME}} in {{PROJECT_NAME}} at {{FEATURE_DIR}}\",\n    36→            encoding=\"utf-8\",\n    37→        )\n    38→\n    39→        with (\n    40→            patch(\"server.services.ralph_service.config.TEMPLATES_DIR\", templates_dir),\n    41→            patch(\n    42→                \"server.services.ralph_service.platform.system\", return_value=\"Windows\"\n    43→            ),\n    44→            patch(\"server.services.ralph_service.subprocess.Popen\") as popen,\n    45→        ):\n    46→            proc = MagicMock()\n    47→            proc.pid = 1234\n    48→            popen.return_value = proc\n    49→\n    50→            job = svc.create_job(\n    51→                tmp_path,\n    52→                slug=\"alpha\",\n    53→                mode=\"plan\",\n    54→                task_description=\"Do the thing\",\n    55→                provider=provider,\n    56→                model=\"sonnet\",\n    57→                iterations=1,\n    58→            )\n    59→\n    60→        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n    61→        assert job_dir.exists()\n    62→        assert (job_dir / \"task.md\").exists()\n    63→        assert (job_dir / \"PROMPT_plan.md\").exists()\n    64→        assert (job_dir / \"loop.ps1\").exists()\n    65→        assert (job_dir / \"output.log\").exists()\n    66→        assert job[\"status\"] == \"running\"\n    67→\n    68→    def test_duplicate_slug_running_raises(self, tmp_path):\n    69→        from server.services.ralph_service import RalphService\n    70→\n    71→        provider = DummyProvider()\n    72→        svc = RalphService()\n    73→\n    74→        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n    75→        _write_job(job_dir, {\"job_id\": \"1\", \"status\": \"running\"})\n    76→\n    77→        with pytest.raises(ValueError, match=\"active job\"):\n    78→            svc.create_job(\n    79→                tmp_path,\n    80→                slug=\"alpha\",\n    81→                mode=\"plan\",\n    82→                task_description=\"Do the thing\",\n    83→                provider=provider,\n    84→                model=\"sonnet\",\n    85→                iterations=1,\n    86→            )\n    87→\n    88→    def test_duplicate_slug_completed_renames(self, tmp_path):\n    89→        from server.services.ralph_service import RalphService\n    90→\n    91→        provider = DummyProvider()\n    92→        svc = RalphService()\n    93→\n    94→        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n    95→        _write_job(job_dir, {\"job_id\": \"old\", \"status\": \"completed\"})\n    96→\n    97→        templates_dir = tmp_path / \"templates\"\n    98→        templates_dir.mkdir()\n    99→        (templates_dir / \"PROMPT_plan_adhoc.md\").write_text(\n   100→            \"Plan {{FEATURE_NAME}} in {{PROJECT_NAME}} at {{FEATURE_DIR}}\",\n   101→            encoding=\"utf-8\",\n   102→        )\n   103→\n   104→        with (\n   105→            patch(\"server.services.ralph_service.config.TEMPLATES_DIR\", templates_dir),\n   106→            patch(\n   107→                \"server.services.ralph_service.platform.system\", return_value=\"Windows\"\n   108→            ),\n   109→            patch(\"server.services.ralph_service.subprocess.Popen\") as popen,\n   110→        ):\n   111→            proc = MagicMock()\n   112→            proc.pid = 1234\n   113→            popen.return_value = proc\n   114→            svc.create_job(\n   115→                tmp_path,\n   116→                slug=\"alpha\",\n   117→                mode=\"plan\",\n   118→                task_description=\"Do the thing\",\n   119→                provider=provider,\n   120→                model=\"sonnet\",\n   121→                iterations=1,\n   122→            )\n   123→\n   124→        archived = list(job_dir.glob(\"job.old.json\"))\n   125→        assert archived\n   126→\n   127→\n   128→class TestRalphServiceStatus:\n   129→    def test_status_marks_failed_when_pid_dead(self, tmp_path):\n   130→        from server.services.ralph_service import RalphService\n   131→\n   132→        svc = RalphService()\n   133→        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n   134→        _write_job(\n   135→            job_dir,\n   136→            {\n   137→                \"job_id\": \"abc\",\n   138→                \"slug\": \"alpha\",\n   139→                \"status\": \"running\",\n   140→                \"pid\": 999,\n   141→                \"iterations\": 1,\n   142→                \"current_iteration\": 0,\n   143→            },\n   144→        )\n   145→\n   146→        with patch.object(svc, \"_is_process_running\", return_value=False):\n   147→            job = svc.get_job_status(tmp_path, \"abc\")\n   148→\n   149→        assert job[\"status\"] == \"failed\"\n   150→        assert \"pid\" in job.get(\"error\", \"\").lower()\n   151→\n   152→    def test_status_reads_progress_tail(self, tmp_path):\n   153→        from server.services.ralph_service import RalphService\n   154→\n   155→        svc = RalphService()\n   156→        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n   157→        _write_job(\n   158→            job_dir,\n   159→            {\n   160→                \"job_id\": \"abc\",\n   161→                \"slug\": \"alpha\",\n   162→                \"status\": \"running\",\n   163→                \"pid\": 999,\n   164→                \"iterations\": 3,\n   165→                \"current_iteration\": 0,\n   166→            },\n   167→        )\n   168→        progress_lines = [\n   169→            \"Start\",\n   170→            \"ITERATION 1\",\n   171→            \"Doing stuff\",\n   172→            \"ITERATION 2\",\n   173→            \"More\",\n   174→            \"ITERATION 3\",\n   175→        ]\n   176→        (job_dir / \"progress.txt\").write_text(\n   177→            \"\\n\".join(progress_lines), encoding=\"utf-8\"\n   178→        )\n   179→\n   180→        with patch.object(svc, \"_is_process_running\", return_value=True):\n   181→            job = svc.get_job_status(tmp_path, \"abc\")\n   182→\n   183→        assert job[\"current_iteration\"] == 3\n   184→        assert job[\"progress_tail\"] == progress_lines[-5:]\n   185→\n   186→\n   187→class TestRalphServiceStop:\n   188→    def test_stop_job_updates_status(self, tmp_path):\n   189→        from server.services.ralph_service import RalphService\n   190→\n   191→        svc = RalphService()\n   192→        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n   193→        _write_job(\n   194→            job_dir,\n   195→            {\n   196→                \"job_id\": \"abc\",\n   197→                \"slug\": \"alpha\",\n   198→                \"status\": \"running\",\n   199→                \"pid\": 555,\n   200→            },\n   201→        )\n   202→\n   203→        with (\n   204→            patch(\n   205→                \"server.services.ralph_service.platform.system\", return_value=\"Windows\"\n   206→            ),\n   207→            patch(\"server.services.ralph_service.subprocess.run\") as run,\n   208→        ):\n   209→            job = svc.stop_job(tmp_path, \"abc\")\n   210→\n   211→        assert job[\"status\"] == \"stopped\"\n   212→        run.assert_called_once()\n   213→\n   214→\n   215→class TestRalphServiceList:\n   216→    def test_list_jobs_sorted(self, tmp_path):\n   217→        from server.services.ralph_service import RalphService\n   218→\n   219→        svc = RalphService()\n   220→        job_a = tmp_path / \".vista\" / \"ralph\" / \"a\"\n   221→        job_b = tmp_path / \".vista\" / \"ralph\" / \"b\"\n   222→        _write_job(job_a, {\"job_id\": \"1\", \"created_at\": \"2026-01-01T00:00:00Z\"})\n   223→        _write_job(job_b, {\"job_id\": \"2\", \"created_at\": \"2026-02-01T00:00:00Z\"})\n   224→\n   225→        jobs = svc.list_jobs(tmp_path)\n   226→        assert [j[\"job_id\"] for j in jobs] == [\"2\", \"1\"]\n   227→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"9e5c2f83-4f26-4e8f-9b6d-8caae3164e7d","uuid":"5a0f71e4-e358-4ced-b608-747d8b3dc972","tool_use_result":{"type":"text","file":{"filePath":"vista/tests/test_ralph_service.py","content":"\"\"\"Tests for ralph_service job management.\"\"\"\n\nimport json\nfrom pathlib import Path\nfrom unittest.mock import MagicMock, patch\n\nimport pytest\n\n\nclass DummyProvider:\n    name = \"dummy\"\n    display_name = \"Dummy Provider\"\n\n    def get_invocation(self, shell: str = \"ps1\") -> str:\n        if shell == \"sh\":\n            return 'echo \"ITERATION $ITERATION\" >> \"$PROGRESS_FILE\"'\n        return 'Add-Content -Path $ProgressFile -Value \"ITERATION $Iteration\"'\n\n\ndef _write_job(job_dir: Path, job: dict) -> None:\n    job_dir.mkdir(parents=True, exist_ok=True)\n    (job_dir / \"job.json\").write_text(json.dumps(job), encoding=\"utf-8\")\n\n\nclass TestRalphServiceCreateJob:\n    def test_create_job_creates_files(self, tmp_path):\n        from server.services.ralph_service import RalphService\n\n        provider = DummyProvider()\n        svc = RalphService()\n\n        templates_dir = tmp_path / \"templates\"\n        templates_dir.mkdir()\n        (templates_dir / \"PROMPT_plan_adhoc.md\").write_text(\n            \"Plan {{FEATURE_NAME}} in {{PROJECT_NAME}} at {{FEATURE_DIR}}\",\n            encoding=\"utf-8\",\n        )\n\n        with (\n            patch(\"server.services.ralph_service.config.TEMPLATES_DIR\", templates_dir),\n            patch(\n                \"server.services.ralph_service.platform.system\", return_value=\"Windows\"\n            ),\n            patch(\"server.services.ralph_service.subprocess.Popen\") as popen,\n        ):\n            proc = MagicMock()\n            proc.pid = 1234\n            popen.return_value = proc\n\n            job = svc.create_job(\n                tmp_path,\n                slug=\"alpha\",\n                mode=\"plan\",\n                task_description=\"Do the thing\",\n                provider=provider,\n                model=\"sonnet\",\n                iterations=1,\n            )\n\n        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n        assert job_dir.exists()\n        assert (job_dir / \"task.md\").exists()\n        assert (job_dir / \"PROMPT_plan.md\").exists()\n        assert (job_dir / \"loop.ps1\").exists()\n        assert (job_dir / \"output.log\").exists()\n        assert job[\"status\"] == \"running\"\n\n    def test_duplicate_slug_running_raises(self, tmp_path):\n        from server.services.ralph_service import RalphService\n\n        provider = DummyProvider()\n        svc = RalphService()\n\n        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n        _write_job(job_dir, {\"job_id\": \"1\", \"status\": \"running\"})\n\n        with pytest.raises(ValueError, match=\"active job\"):\n            svc.create_job(\n                tmp_path,\n                slug=\"alpha\",\n                mode=\"plan\",\n                task_description=\"Do the thing\",\n                provider=provider,\n                model=\"sonnet\",\n                iterations=1,\n            )\n\n    def test_duplicate_slug_completed_renames(self, tmp_path):\n        from server.services.ralph_service import RalphService\n\n        provider = DummyProvider()\n        svc = RalphService()\n\n        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n        _write_job(job_dir, {\"job_id\": \"old\", \"status\": \"completed\"})\n\n        templates_dir = tmp_path / \"templates\"\n        templates_dir.mkdir()\n        (templates_dir / \"PROMPT_plan_adhoc.md\").write_text(\n            \"Plan {{FEATURE_NAME}} in {{PROJECT_NAME}} at {{FEATURE_DIR}}\",\n            encoding=\"utf-8\",\n        )\n\n        with (\n            patch(\"server.services.ralph_service.config.TEMPLATES_DIR\", templates_dir),\n            patch(\n                \"server.services.ralph_service.platform.system\", return_value=\"Windows\"\n            ),\n            patch(\"server.services.ralph_service.subprocess.Popen\") as popen,\n        ):\n            proc = MagicMock()\n            proc.pid = 1234\n            popen.return_value = proc\n            svc.create_job(\n                tmp_path,\n                slug=\"alpha\",\n                mode=\"plan\",\n                task_description=\"Do the thing\",\n                provider=provider,\n                model=\"sonnet\",\n                iterations=1,\n            )\n\n        archived = list(job_dir.glob(\"job.old.json\"))\n        assert archived\n\n\nclass TestRalphServiceStatus:\n    def test_status_marks_failed_when_pid_dead(self, tmp_path):\n        from server.services.ralph_service import RalphService\n\n        svc = RalphService()\n        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n        _write_job(\n            job_dir,\n            {\n                \"job_id\": \"abc\",\n                \"slug\": \"alpha\",\n                \"status\": \"running\",\n                \"pid\": 999,\n                \"iterations\": 1,\n                \"current_iteration\": 0,\n            },\n        )\n\n        with patch.object(svc, \"_is_process_running\", return_value=False):\n            job = svc.get_job_status(tmp_path, \"abc\")\n\n        assert job[\"status\"] == \"failed\"\n        assert \"pid\" in job.get(\"error\", \"\").lower()\n\n    def test_status_reads_progress_tail(self, tmp_path):\n        from server.services.ralph_service import RalphService\n\n        svc = RalphService()\n        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n        _write_job(\n            job_dir,\n            {\n                \"job_id\": \"abc\",\n                \"slug\": \"alpha\",\n                \"status\": \"running\",\n                \"pid\": 999,\n                \"iterations\": 3,\n                \"current_iteration\": 0,\n            },\n        )\n        progress_lines = [\n            \"Start\",\n            \"ITERATION 1\",\n            \"Doing stuff\",\n            \"ITERATION 2\",\n            \"More\",\n            \"ITERATION 3\",\n        ]\n        (job_dir / \"progress.txt\").write_text(\n            \"\\n\".join(progress_lines), encoding=\"utf-8\"\n        )\n\n        with patch.object(svc, \"_is_process_running\", return_value=True):\n            job = svc.get_job_status(tmp_path, \"abc\")\n\n        assert job[\"current_iteration\"] == 3\n        assert job[\"progress_tail\"] == progress_lines[-5:]\n\n\nclass TestRalphServiceStop:\n    def test_stop_job_updates_status(self, tmp_path):\n        from server.services.ralph_service import RalphService\n\n        svc = RalphService()\n        job_dir = tmp_path / \".vista\" / \"ralph\" / \"alpha\"\n        _write_job(\n            job_dir,\n            {\n                \"job_id\": \"abc\",\n                \"slug\": \"alpha\",\n                \"status\": \"running\",\n                \"pid\": 555,\n            },\n        )\n\n        with (\n            patch(\n                \"server.services.ralph_service.platform.system\", return_value=\"Windows\"\n            ),\n            patch(\"server.services.ralph_service.subprocess.run\") as run,\n        ):\n            job = svc.stop_job(tmp_path, \"abc\")\n\n        assert job[\"status\"] == \"stopped\"\n        run.assert_called_once()\n\n\nclass TestRalphServiceList:\n    def test_list_jobs_sorted(self, tmp_path):\n        from server.services.ralph_service import RalphService\n\n        svc = RalphService()\n        job_a = tmp_path / \".vista\" / \"ralph\" / \"a\"\n        job_b = tmp_path / \".vista\" / \"ralph\" / \"b\"\n        _write_job(job_a, {\"job_id\": \"1\", \"created_at\": \"2026-01-01T00:00:00Z\"})\n        _write_job(job_b, {\"job_id\": \"2\", \"created_at\": \"2026-02-01T00:00:00Z\"})\n\n        jobs = svc.list_jobs(tmp_path)\n        assert [j[\"job_id\"] for j in jobs] == [\"2\", \"1\"]\n","numLines":227,"startLine":1,"totalLines":227}}}
