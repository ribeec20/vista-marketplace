\\\", \\\\\\\"/T\\\\\\\", \\\\\\\"/F\\\\\\\", \\\\\\\"/PID\\\\\\\", str(pid)],\\\\n  > 159:                    capture_output=True,\\\\n  > 160:                    text=True,\\\\n  > 161:                )\\\\n  > 162:            else:\\\\n  > 163:                try:\\\\n  > 164:                    os.kill(pid, signal.SIGTERM)\\\\n  > 165:                except ProcessLookupError:\\\\n  > 166:                    pass\\\\n  > 167:                if self._is_process_running(pid):\\\\n  > 168:                    try:\\\\n  > 169:                        os.kill(pid, signal.SIGKILL)\\\\n  > 170:                    except ProcessLookupError:\\\\n  > 171:                        pass\\\\n  > 172:\\\\n  > 173:        job[\\\\\\\"status\\\\\\\"] = \\\\\\\"stopped\\\\\\\"\\\\n  > 174:        job[\\\\\\\"completed_at\\\\\\\"] = self._now()\\\\n  > 175:        self._save_job_json(job_dir, job)\\\\n  > 176:        return job\\\\n  > 177:\\\\n  > 178:    def list_jobs(self, project_root: Path) -> list[dict]:\\\\n  > 179:        jobs: list[dict] = []\\\\n  > 180:        ralph_dir = project_root / \\\\\\\".vista\\\\\\\" / self._ralph_dir_name\\\\n  > 181:        if not ralph_dir.exists():\\\\n  > 182:            return jobs\\\\n  > 183:        for slug_dir in ralph_dir.iterdir():\\\\n  > 184:            if not slug_dir.is_dir():\\\\n  > 185:                continue\\\\n  > 186:            job = self._load_job_json(slug_dir)\\\\n  > 187:            if job:\\\\n  > 188:                jobs.append(job)\\\\n  > 189:        jobs.sort(key=lambda j: j.get(\\\\\\\"created_at\\\\\\\", \\\\\\\"\\\\\\\"), reverse=True)\\\\n  > 190:        return jobs\\\\n  > 191:\\\\n  > 192:    def _job_dir(self, project_root: Path, slug: str) -> Path:\\\\n  > 193:        return project_root / \\\\\\\".vista\\\\\\\" / self._ralph_dir_name / slug\\\\n  > 194:\\\\n  > 195:    def _find_job_dir_by_id(self, project_root: Path, job_id: str) -> Optional[Path]:\\\\n  > 196:        ralph_dir = project_root / \\\\\\\"