{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gm6k3XDk5GxtiEEv2GKn2r","type":"tool_result","content":"     1→\"\"\"CRUD service for persistent chat sessions.\n     2→\n     3→Sessions are stored as JSON files under server/data/sessions/{project_id}/.\n     4→\"\"\"\n     5→\n     6→import json\n     7→from datetime import datetime, timezone\n     8→from pathlib import Path\n     9→from typing import Optional\n    10→\n    11→from server import config\n    12→from server.models.chat_session import ChatMessage, ChatSession\n    13→\n    14→SESSIONS_DIR = config.DATA_DIR / \"sessions\"\n    15→\n    16→\n    17→class ChatSessionService:\n    18→    \"\"\"Manages chat session persistence on disk.\"\"\"\n    19→\n    20→    @staticmethod\n    21→    def _session_dir(project_id: str) -> Path:\n    22→        return SESSIONS_DIR / project_id\n    23→\n    24→    @staticmethod\n    25→    def _session_file(project_id: str, session_id: str) -> Path:\n    26→        return SESSIONS_DIR / project_id / f\"{session_id}.json\"\n    27→\n    28→    @classmethod\n    29→    def create(\n    30→        cls,\n    31→        project_id: str,\n    32→        feature_name: str,\n    33→        provider: str,\n    34→        model: str,\n    35→        name: str = \"\",\n    36→    ) -> ChatSession:\n    37→        session = ChatSession(\n    38→            id=ChatSession.generate_id(),\n    39→            project_id=project_id,\n    40→            feature_name=feature_name,\n    41→            name=name or \"New Chat\",\n    42→            provider=provider,\n    43→            model=model,\n    44→        )\n    45→        cls._save(session)\n    46→        return session\n    47→\n    48→    @classmethod\n    49→    def list_sessions(\n    50→        cls, project_id: str, feature_name: Optional[str] = None\n    51→    ) -> list[dict]:\n    52→        \"\"\"Return summary dicts for sessions, optionally filtered by feature.\"\"\"\n    53→        d = cls._session_dir(project_id)\n    54→        if not d.exists():\n    55→            return []\n    56→        sessions = []\n    57→        for f in sorted(d.glob(\"*.json\"), key=lambda p: p.stat().st_mtime, reverse=True):\n    58→            try:\n    59→                session = cls._load(f)\n    60→                if feature_name and session.feature_name != feature_name:\n    61→                    continue\n    62→                sessions.append(session.to_summary_dict())\n    63→            except Exception:\n    64→                continue\n    65→        return sessions\n    66→\n    67→    @classmethod\n    68→    def get(cls, project_id: str, session_id: str) -> Optional[ChatSession]:\n    69→        f = cls._session_file(project_id, session_id)\n    70→        if not f.exists():\n    71→            return None\n    72→        return cls._load(f)\n    73→\n    74→    @classmethod\n    75→    def delete(cls, project_id: str, session_id: str) -> bool:\n    76→        f = cls._session_file(project_id, session_id)\n    77→        if not f.exists():\n    78→            return False\n    79→        f.unlink()\n    80→        return True\n    81→\n    82→    @classmethod\n    83→    def add_message(\n    84→        cls, project_id: str, session_id: str, role: str, content: str\n    85→    ) -> Optional[ChatSession]:\n    86→        session = cls.get(project_id, session_id)\n    87→        if session is None:\n    88→            return None\n    89→        msg = ChatMessage(role=role, content=content)\n    90→        session.messages.append(msg)\n    91→        session.updated_at = datetime.now(timezone.utc).isoformat()\n    92→        # Auto-name from first user message if still default\n    93→        if session.name == \"New Chat\" and role == \"user\" and len(session.messages) == 1:\n    94→            session.name = ChatSession.auto_name(content)\n    95→        cls._save(session)\n    96→        return session\n    97→\n    98→    @classmethod\n    99→    def update_name(cls, project_id: str, session_id: str, name: str) -> Optional[ChatSession]:\n   100→        session = cls.get(project_id, session_id)\n   101→        if session is None:\n   102→            return None\n   103→        session.name = name\n   104→        session.updated_at = datetime.now(timezone.utc).isoformat()\n   105→        cls._save(session)\n   106→        return session\n   107→\n   108→    @classmethod\n   109→    def save(cls, session: ChatSession) -> None:\n   110→        \"\"\"Public save — persist a session to disk.\"\"\"\n   111→        cls._save(session)\n   112→\n   113→    @classmethod\n   114→    def _save(cls, session: ChatSession) -> None:\n   115→        d = cls._session_dir(session.project_id)\n   116→        d.mkdir(parents=True, exist_ok=True)\n   117→        f = cls._session_file(session.project_id, session.id)\n   118→        f.write_text(json.dumps(session.to_dict(), indent=2), encoding=\"utf-8\")\n   119→\n   120→    @staticmethod\n   121→    def _load(path: Path) -> ChatSession:\n   122→        data = json.loads(path.read_text(encoding=\"utf-8\"))\n   123→        return ChatSession.from_dict(data)\n   124→"}]},"parent_tool_use_id":null,"session_id":"6fd2c7b7-e807-4a5f-ab88-3c7663fd206d","uuid":"a3a2c0c5-3925-41d9-84b0-e60858c1bb78","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/services/chat_session_service.py","content":"\"\"\"CRUD service for persistent chat sessions.\n\nSessions are stored as JSON files under server/data/sessions/{project_id}/.\n\"\"\"\n\nimport json\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom server import config\nfrom server.models.chat_session import ChatMessage, ChatSession\n\nSESSIONS_DIR = config.DATA_DIR / \"sessions\"\n\n\nclass ChatSessionService:\n    \"\"\"Manages chat session persistence on disk.\"\"\"\n\n    @staticmethod\n    def _session_dir(project_id: str) -> Path:\n        return SESSIONS_DIR / project_id\n\n    @staticmethod\n    def _session_file(project_id: str, session_id: str) -> Path:\n        return SESSIONS_DIR / project_id / f\"{session_id}.json\"\n\n    @classmethod\n    def create(\n        cls,\n        project_id: str,\n        feature_name: str,\n        provider: str,\n        model: str,\n        name: str = \"\",\n    ) -> ChatSession:\n        session = ChatSession(\n            id=ChatSession.generate_id(),\n            project_id=project_id,\n            feature_name=feature_name,\n            name=name or \"New Chat\",\n            provider=provider,\n            model=model,\n        )\n        cls._save(session)\n        return session\n\n    @classmethod\n    def list_sessions(\n        cls, project_id: str, feature_name: Optional[str] = None\n    ) -> list[dict]:\n        \"\"\"Return summary dicts for sessions, optionally filtered by feature.\"\"\"\n        d = cls._session_dir(project_id)\n        if not d.exists():\n            return []\n        sessions = []\n        for f in sorted(d.glob(\"*.json\"), key=lambda p: p.stat().st_mtime, reverse=True):\n            try:\n                session = cls._load(f)\n                if feature_name and session.feature_name != feature_name:\n                    continue\n                sessions.append(session.to_summary_dict())\n            except Exception:\n                continue\n        return sessions\n\n    @classmethod\n    def get(cls, project_id: str, session_id: str) -> Optional[ChatSession]:\n        f = cls._session_file(project_id, session_id)\n        if not f.exists():\n            return None\n        return cls._load(f)\n\n    @classmethod\n    def delete(cls, project_id: str, session_id: str) -> bool:\n        f = cls._session_file(project_id, session_id)\n        if not f.exists():\n            return False\n        f.unlink()\n        return True\n\n    @classmethod\n    def add_message(\n        cls, project_id: str, session_id: str, role: str, content: str\n    ) -> Optional[ChatSession]:\n        session = cls.get(project_id, session_id)\n        if session is None:\n            return None\n        msg = ChatMessage(role=role, content=content)\n        session.messages.append(msg)\n        session.updated_at = datetime.now(timezone.utc).isoformat()\n        # Auto-name from first user message if still default\n        if session.name == \"New Chat\" and role == \"user\" and len(session.messages) == 1:\n            session.name = ChatSession.auto_name(content)\n        cls._save(session)\n        return session\n\n    @classmethod\n    def update_name(cls, project_id: str, session_id: str, name: str) -> Optional[ChatSession]:\n        session = cls.get(project_id, session_id)\n        if session is None:\n            return None\n        session.name = name\n        session.updated_at = datetime.now(timezone.utc).isoformat()\n        cls._save(session)\n        return session\n\n    @classmethod\n    def save(cls, session: ChatSession) -> None:\n        \"\"\"Public save — persist a session to disk.\"\"\"\n        cls._save(session)\n\n    @classmethod\n    def _save(cls, session: ChatSession) -> None:\n        d = cls._session_dir(session.project_id)\n        d.mkdir(parents=True, exist_ok=True)\n        f = cls._session_file(session.project_id, session.id)\n        f.write_text(json.dumps(session.to_dict(), indent=2), encoding=\"utf-8\")\n\n    @staticmethod\n    def _load(path: Path) -> ChatSession:\n        data = json.loads(path.read_text(encoding=\"utf-8\"))\n        return ChatSession.from_dict(data)\n","numLines":124,"startLine":1,"totalLines":124}}}
