ata = JSON.parse(e.data);\n  1184→        finalizeStreamMessage(data.content);\n  1185→    });\n  1186→\n  1187→    eventSource.addEventListener('chat_error', (e) => {\n  1188→        const data = JSON.parse(e.data);\n  1189→        finishStreaming();\n  1190→        appendMessage('error', data.detail, false);\n  1191→    });\n  1192→\n  1193→    eventSource.addEventListener('diagram_changed', (e) => {\n  1194→        const data = JSON.parse(e.data);\n  1195→        updateDiagram(data.file, data.content);\n  1196→    });\n  1197→\n  1198→    eventSource.addEventListener('diagram_added', (e) => {\n  1199→        const data = JSON.parse(e.data);\n  1200→        addDiagramCard(data.file, data.content);\n  1201→    });\n  1202→\n  1203→    eventSource.addEventListener('diagram_removed', (e) => {\n  1204→        const data = JSON.parse(e.data);\n  1205→        removeDiagramCard(data.file);\n  1206→    });\n  1207→\n  1208→    eventSource.addEventListener('ping', () => {});\n  1209→\n  1210→    eventSource.onerror = () => {\n  1211→        // Auto-reconnect is handled by EventSource\n  1212→    };\n  1213→}\n  1214→\n  1215→function disconnectSSE() {\n  1216→    if (eventSource) {\n  1217→        eventSource.close();\n  1218→        eventSource = null;\n  1219→    }\n  1220→}\n  1221→\n  1222→// =========================================================================\n  1223→// Chat messaging\n  1224→// =========================================================================\n  1225→\n  1226→function appendMessage(role, content, scroll = true) {\n  1227→    const container = document.getElementById('chat-messages');\n  1228→    // Remove placeholder if present\n  1229→    const ph = document.getElementById('chat-placeholder');\n  1230→    if (ph) ph.remove();\n  1231→\n  1232→    const div = document.createElement('div');\n  1233→    div.className = `chat-msg ${role}`;\n  1234→    if (role === 'assistant') {\n  1235→        div.innerHTML = marked.parse(content);\n  1236→    } else {\n  1237→        div.textContent = content;\n  1238→    }\n  1239→    container.appendChild(div);\n  1240→    if (scroll) container.scrollTop = container.scrollHeight;\n  1241→    return div;\n  1242→}\n  1243→\n  1244→function showThinking() {\n  1245→    hideThinking();\n  1246→    const container = document.getElementById('chat-messages');\n  1247→    const el = document.createElement('div');\n  1248→    el.className = 'chat-thinking';\n  1249→    el.id = 'thinking-indicator';\n  1250→    const label = chatMode === 'persistent' ? 'Agent thinking...' : 'Thinking...';\n  1251→    el.innerHTML = `<span class=\"thinking-icon\">&#x2726;</span><span class=\"thinking-text\">${label}</span>`;\n  1252→    container.appendChild(el);\n  1253→    container.scrollTop = container.scrollHeight;\n  1254→}\n  1255→\n  1256→function hideThinking() {\n  1257→    const el = document.getElementById('thinking-indicator');\n  1258→    if (el) el.remove();\n  1259→}"}]},"parent_tool_use_id":null,"session_id":"615fcba1-13a5-40a3-839d-703775331047","uuid":"c9db69e3-6fea-4861-9a18-c79f51ace666","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/views/architecture.html","content":"        }\n        select.value = session.id;\n        await loadSession(session.id);\n    } catch (err) {\n        console.error('Failed to create session:', err);\n    }\n}\n\nasync function deleteCurrentSession() {\n    if (!currentSessionId) return;\n    if (!confirm('Delete this chat session?')) return;\n    try {\n        await fetch(`/api/projects/${PROJECT_ID}/chat/sessions/${currentSessionId}`, { method: 'DELETE' });\n        disconnectSSE();\n        currentSessionId = null;\n        setChatEnabled(false);\n        document.getElementById('chat-messages').innerHTML = '<div class=\"text-gray-500 text-sm text-center py-4\">Session deleted.</div>';\n        loadSessions();\n    } catch (err) {\n        console.error('Failed to delete session:', err);\n    }\n}\n\nfunction setChatEnabled(enabled) {\n    document.getElementById('chat-input').disabled = !enabled;\n    document.getElementById('chat-send-btn').disabled = !enabled;\n}\n\n// =========================================================================\n// SSE Connection (chat tokens + diagram changes)\n// =========================================================================\n\nfunction connectSSE(sessionId) {\n    disconnectSSE();\n    const url = `/api/projects/${PROJECT_ID}/chat/sessions/${sessionId}/stream`;\n    eventSource = new EventSource(url);\n\n    eventSource.addEventListener('token', (e) => {\n        const data = JSON.parse(e.data);\n        appendStreamToken(data.text);\n    });\n\n    eventSource.addEventListener('message_done', (e) => {\n        const data = JSON.parse(e.data);\n        finalizeStreamMessage(data.content);\n    });\n\n    eventSource.addEventListener('chat_error', (e) => {\n        const data = JSON.parse(e.data);\n        finishStreaming();\n        appendMessage('error', data.detail, false);\n    });\n\n    eventSource.addEventListener('diagram_changed', (e) => {\n        const data = JSON.parse(e.data);\n        updateDiagram(data.file, data.content);\n    });\n\n    eventSource.addEventListener('diagram_added', (e) => {\n        const data = JSON.parse(e.data);\n        addDiagramCard(data.file, data.content);\n    });\n\n    eventSource.addEventListener('diagram_removed', (e) => {\n        const data = JSON.parse(e.data);\n        removeDiagramCard(data.file);\n    });\n\n    eventSource.addEventListener('ping', () => {});\n\n    eventSource.onerror = () => {\n        // Auto-reconnect is handled by EventSource\n    };\n}\n\nfunction disconnectSSE() {\n    if (eventSource) {\n        eventSource.close();\n        eventSource = null;\n    }\n}\n\n// =========================================================================\n// Chat messaging\n// =========================================================================\n\nfunction appendMessage(role, content, scroll = true) {\n    const container = document.getElementById('chat-messages');\n    // Remove placeholder if present\n    const ph = document.getElementById('chat-placeholder');\n    if (ph) ph.remove();\n\n    const div = document.createElement('div');\n    div.className = `chat-msg ${role}`;\n    if (role === 'assistant') {\n        div.innerHTML = marked.parse(content);\n    } else {\n        div.textContent = content;\n    }\n    container.appendChild(div);\n    if (scroll) container.scrollTop = container.scrollHeight;\n    return div;\n}\n\nfunction showThinking() {\n    hideThinking();\n    const container = document.getElementById('chat-messages');\n    const el = document.createElement('div');\n    el.className = 'chat-thinking';\n    el.id = 'thinking-indicator';\n    const label = chatMode === 'persistent' ? 'Agent thinking...' : 'Thinking...';\n    el.innerHTML = `<span class=\"thinking-icon\">&#x2726;</span><span class=\"thinking-text\">${label}</span>`;\n    container.appendChild(el);\n    container.scrollTop = container.scrollHeight;\n}\n\nfunction hideThinking() {\n    const el = document.getElementById('thinking-indicator');\n    if (el) el.remove();\n}","numLines":120,"startLine":1140,"totalLines":1478}}}
