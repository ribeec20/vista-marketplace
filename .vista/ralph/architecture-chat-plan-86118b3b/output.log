{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LJaLzCwWY8D91ZMBKn1jTn","type":"tool_result","content":"     1→import { randomUUID } from \"node:crypto\";\n     2→import { execSync } from \"node:child_process\";\n     3→import { mkdirSync, existsSync, readFileSync, writeFileSync } from \"node:fs\";\n     4→import { join } from \"node:path\";\n     5→import type { Subprocess } from \"bun\";\n     6→import type { SessionStore } from \"./session-store.js\";\n     7→import type { BackendType } from \"./session-types.js\";\n     8→import { CodexAdapter } from \"./codex-adapter.js\";\n     9→\n    10→export interface SdkSessionInfo {\n    11→  sessionId: string;\n    12→  pid?: number;\n    13→  state: \"starting\" | \"connected\" | \"running\" | \"exited\";\n    14→  exitCode?: number | null;\n    15→  model?: string;\n    16→  permissionMode?: string;\n    17→  cwd: string;\n    18→  createdAt: number;\n    19→  /** The CLI's internal session ID (from system.init), used for --resume */\n    20→  cliSessionId?: string;\n    21→  archived?: boolean;\n    22→  /** Whether this session uses a git worktree */\n    23→  isWorktree?: boolean;\n    24→  /** The original repo root path */\n    25→  repoRoot?: string;\n    26→  /** Conceptual branch this session is working on (what user selected) */\n    27→  branch?: string;\n    28→  /** Actual git branch in the worktree (may differ for -wt-N branches) */\n    29→  actualBranch?: string;\n    30→  /** User-facing session name */\n    31→  name?: string;\n    32→  /** Which backend this session uses */\n    33→  backendType?: BackendType;\n    34→  /** Git branch from bridge state (enriched by REST API) */\n    35→  gitBranch?: string;\n    36→  /** Git ahead count (enriched by REST API) */\n    37→  gitAhead?: number;\n    38→  /** Git behind count (enriched by REST API) */\n    39→  gitBehind?: number;\n    40→  /** Total lines added (enriched by REST API) */\n    41→  totalLinesAdded?: number;\n    42→  /** Total lines removed (enriched by REST API) */\n    43→  totalLinesRemoved?: number;\n    44→  /** Whether internet/web search is enabled for Codex sessions */\n    45→  codexInternetAccess?: boolean;\n    46→  /** Sandbox mode selected for Codex sessions */\n    47→  codexSandbox?: \"workspace-write\" | \"danger-full-access\";\n    48→}\n    49→\n    50→export interface LaunchOptions {\n    51→  model?: string;\n    52→  permissionMode?: string;\n    53→  cwd?: string;\n    54→  claudeBinary?: string;\n    55→  codexBinary?: string;\n    56→  allowedTools?: string[];\n    57→  env?: Record<string, string>;\n    58→  backendType?: BackendType;\n    59→  /** Codex sandbox mode. */\n    60→  codexSandbox?: \"workspace-write\" | \"danger-full-access\";\n    61→  /** Whether Codex internet/web search should be enabled for this session. */\n    62→  codexInternetAccess?: boolean;\n    63→  /** Pre-resolved worktree info from the session creation flow */\n    64→  worktreeInfo?: {\n    65→    isWorktree: boolean;\n    66→    repoRoot: string;\n    67→    branch: string;\n    68→    actualBranch: string;\n    69→    worktreePath: string;\n    70→  };\n    71→}\n    72→\n    73→/**\n    74→ * Manages CLI backend processes (Claude Code via --sdk-url WebSocket,\n    75→ * or Codex via app-server stdio).\n    76→ */\n    77→export class CliLauncher {\n    78→  private sessions = new Map<string, SdkSessionInfo>();\n    79→  private processes = new Map<string, Subprocess>();\n    80→  private port: number;\n    81→  private store: SessionStore | null = null;\n    82→  private onCodexAdapter: ((sessionId: string, adapter: CodexAdapter) => void) | null = null;\n    83→\n    84→  constructor(port: number) {\n    85→    this.port = port;\n    86→  }\n    87→\n    88→  /** Register a callback for when a CodexAdapter is created (WsBridge needs to attach it). */\n    89→  onCodexAdapterCreated(cb: (sessionId: string, adapter: CodexAdapter) => void): void {\n    90→    this.onCodexAdapter = cb;\n    91→  }\n    92→\n    93→  /** Attach a persistent store for surviving server restarts. */\n    94→  setStore(store: SessionStore): void {\n    95→    this.store = store;\n    96→  }\n    97→\n    98→  /** Persist launcher state to disk. */\n    99→  private persistState(): void {\n   100→    if (!this.store) return;\n   101→    const data = Array.from(this.sessions.values());\n   102→    this.store.saveLauncher(data);\n   103→  }\n   104→\n   105→  /**\n   106→   * Restore sessions from disk and check which PIDs are still alive.\n   107→   * Returns the number of recovered sessions.\n   108→   */\n   109→  restoreFromDisk(): number {\n   110→    if (!this.store) return 0;\n   111→    const data = this.store.loadLauncher<SdkSessionInfo[]>();\n   112→    if (!data || !Array.isArray(data)) return 0;\n   113→\n   114→    let recovered = 0;\n   115→    for (const info of data) {\n   116→      if (this.sessions.has(info.sessionId)) continue;\n   117→\n   118→      // Check if the process is still alive\n   119→      if (info.pid && info.state !== \"exited\") {\n   120→        try {\n   121→          process.kill(info.pid, 0); // signal 0 = just check if alive\n   122→          info.state = \"starting\"; // WS not yet re-established, wait for CLI to reconnect\n   123→          this.sessions.set(info.sessionId, info);\n   124→          recovered++;\n   125→        } catch {\n   126→          // Process is dead\n   127→          info.state = \"exited\";\n   128→          info.exitCode = -1;\n   129→          this.sessions.set(info.sessionId, info);\n   130→        }\n   131→      } else {\n   132→        // Already exited or no PID\n   133→        this.sessions.set(info.sessionId, info);\n   134→      }\n   135→    }\n   136→    if (recovered > 0) {\n   137→      console.log(`[cli-launcher] Recovered ${recovered} live session(s) from disk`);\n   138→    }\n   139→    return recovered;\n   140→  }\n   141→\n   142→  /**\n   143→   * Launch a new CLI session (Claude Code or Codex).\n   144→   */\n   145→  launch(options: LaunchOptions = {}): SdkSessionInfo {\n   146→    const sessionId = randomUUID();\n   147→    const cwd = options.cwd || process.cwd();\n   148→    const backendType = options.backendType || \"claude\";\n   149→\n   150→    const info: SdkSessionInfo = {\n   151→      sessionId,\n   152→      state: \"starting\",\n   153→      model: options.model,\n   154→      permissionMode: options.permissionMode,\n   155→      cwd,\n   156→      createdAt: Date.now(),\n   157→      backendType,\n   158→    };\n   159→\n   160→    if (backendType === \"codex\") {\n   161→      info.codexInternetAccess = options.codexInternetAccess === true;\n   162→      info.codexSandbox = options.codexSandbox;\n   163→    }\n   164→\n   165→    // Store worktree metadata if provided\n   166→    if (options.worktreeInfo) {\n   167→      info.isWorktree = options.worktreeInfo.isWorktree;\n   168→      info.repoRoot = options.worktreeInfo.repoRoot;\n   169→      info.branch = options.worktreeInfo.branch;\n   170→      info.actualBranch = options.worktreeInfo.actualBranch;\n   171→    }\n   172→\n   173→    this.sessions.set(sessionId, info);\n   174→\n   175→    if (backendType === \"codex\") {\n   176→      this.spawnCodex(sessionId, info, options);\n   177→    } else {\n   178→      this.spawnCLI(sessionId, info, options);\n   179→    }\n   180→    return info;\n   181→  }\n   182→\n   183→  /**\n   184→   * Relaunch a CLI process for an existing session.\n   185→   * Kills the old process if still alive, then spawns a fresh CLI\n   186→   * that connects back to the same session in the WsBridge.\n   187→   */\n   188→  async relaunch(sessionId: string): Promise<boolean> {\n   189→    const info = this.sessions.get(sessionId);\n   190→    if (!info) return false;\n   191→\n   192→    // Kill old process if still alive\n   193→    const oldProc = this.processes.get(sessionId);\n   194→    if (oldProc) {\n   195→      try {\n   196→        oldProc.kill(\"SIGTERM\");\n   197→        await Promise.race([\n   198→          oldProc.exited,\n   199→          new Promise((r) => setTimeout(r, 2000)),\n   200→        ]);\n   201→      } catch {}\n   202→      this.processes.delete(sessionId);\n   203→    } else if (info.pid) {\n   204→      // Process from a previous server instance — kill by PID\n   205→      try { process.kill(info.pid, \"SIGTERM\"); } catch {}\n   206→    }\n   207→\n   208→    info.state = \"starting\";\n   209→\n   210→    if (info.backendType === \"codex\") {\n   211→      this.spawnCodex(sessionId, info, {\n   212→        model: info.model,\n   213→        permissionMode: info.permissionMode,\n   214→        cwd: info.cwd,\n   215→        codexSandbox: info.codexSandbox,\n   216→        codexInternetAccess: info.codexInternetAccess,\n   217→      });\n   218→    } else {\n   219→      this.spawnCLI(sessionId, info, {\n   220→        model: info.model,\n   221→        permissionMode: info.permissionMode,\n   222→        cwd: info.cwd,\n   223→        resumeSessionId: info.cliSessionId,\n   224→      });\n   225→    }\n   226→    return true;\n   227→  }\n   228→\n   229→  /**\n   230→   * Get all sessions in \"starting\" state (awaiting CLI WebSocket connection).\n   231→   */\n   232→  getStartingSessions(): SdkSessionInfo[] {\n   233→    return Array.from(this.sessions.values()).filter((s) => s.state === \"starting\");\n   234→  }\n   235→\n   236→  private spawnCLI(sessionId: string, info: SdkSessionInfo, options: LaunchOptions & { resumeSessionId?: string }): void {\n   237→    let binary = options.claudeBinary || \"claude\";\n   238→    if (!binary.startsWith(\"/\")) {\n   239→      try {\n   240→        binary = execSync(`which ${binary}`, { encoding: \"utf-8\" }).trim();\n   241→      } catch {\n   242→        // fall through, hope it's in PATH\n   243→      }\n   244→    }\n   245→\n   246→    const sdkUrl = `ws://localhost:${this.port}/ws/cli/${sessionId}`;\n   247→\n   248→    const args: string[] = [\n   249→      \"--sdk-url\", sdkUrl,\n   250→      \"--print\",\n   251→      \"--output-format\", \"stream-json\",\n   252→      \"--input-format\", \"stream-json\",\n   253→      \"--verbose\",\n   254→    ];\n   255→\n   256→    if (options.model) {\n   257→      args.push(\"--model\", options.model);\n   258→    }\n   259→    if (options.permissionMode) {\n   260→      args.push(\"--permission-mode\", options.permissionMode);\n   261→    }\n   262→    if (options.allowedTools) {\n   263→      for (const tool of options.allowedTools) {\n   264→        args.push(\"--allowedTools\", tool);\n   265→      }\n   266→    }\n   267→\n   268→    // Inject CLAUDE.md guardrails for worktree sessions\n   269→    if (info.isWorktree && info.branch) {\n   270→      this.injectWorktreeGuardrails(\n   271→        info.cwd,\n   272→        info.actualBranch || info.branch,\n   273→        info.repoRoot || \"\",\n   274→        info.actualBranch && info.actualBranch !== info.branch ? info.branch : undefined,\n   275→      );\n   276→    }\n   277→\n   278→    // Always pass -p \"\" for headless mode. When relaunching, also pass --resume\n   279→    // to restore the CLI's conversation context.\n   280→    if (options.resumeSessionId) {\n   281→      args.push(\"--resume\", options.resumeSessionId);\n   282→    }\n   283→    args.push(\"-p\", \"\");\n   284→\n   285→    const env: Record<string, string | undefined> = {\n   286→      ...process.env,\n   287→      CLAUDECODE: \"1\",\n   288→      ...options.env,\n   289→    };\n   290→\n   291→    console.log(`[cli-launcher] Spawning session ${sessionId}: ${binary} ${args.join(\" \")}`);\n   292→\n   293→    const proc = Bun.spawn([binary, ...args], {\n   294→      cwd: info.cwd,\n   295→      env,\n   296→      stdout: \"pipe\",\n   297→      stderr: \"pipe\",\n   298→    });\n   299→\n   300→    info.pid = proc.pid;\n   301→    this.processes.set(sessionId, proc);\n   302→\n   303→    // Stream stdout/stderr for debugging\n   304→    this.pipeOutput(sessionId, proc);\n   305→\n   306→    // Monitor process exit\n   307→    const spawnedAt = Date.now();\n   308→    proc.exited.then((exitCode) => {\n   309→      console.log(`[cli-launcher] Session ${sessionId} exited (code=${exitCode})`);\n   310→      const session = this.sessions.get(sessionId);\n   311→      if (session) {\n   312→        session.state = \"exited\";\n   313→        session.exitCode = exitCode;\n   314→\n   315→        // If the process exited almost immediately with --resume, the resume likely failed.\n   316→        // Clear cliSessionId so the next relaunch starts fresh.\n   317→        const uptime = Date.now() - spawnedAt;\n   318→        if (uptime < 5000 && options.resumeSessionId) {\n   319→          console.error(`[cli-launcher] Session ${sessionId} exited immediately after --resume (${uptime}ms). Clearing cliSessionId for fresh start.`);\n   320→          session.cliSessionId = undefined;\n   321→        }\n   322→      }\n   323→      this.processes.delete(sessionId);\n   324→      this.persistState();\n   325→    });\n   326→\n   327→    this.persistState();\n   328→  }\n   329→\n   330→  /**\n   331→   * Spawn a Codex app-server subprocess for a session.\n   332→   * Unlike Claude Code (which connects back via WebSocket), Codex uses stdio.\n   333→   */\n   334→  private spawnCodex(sessionId: string, info: SdkSessionInfo, options: LaunchOptions): void {\n   335→    let binary = options.codexBinary || \"codex\";\n   336→    if (!binary.startsWith(\"/\")) {\n   337→      try {\n   338→        binary = execSync(`which ${binary}`, { encoding: \"utf-8\" }).trim();\n   339→      } catch {\n   340→        // fall through, hope it's in PATH\n   341→      }\n   342→    }\n   343→\n   344→    const args: string[] = [\"app-server\"];\n   345→    const internetEnabled = options.codexInternetAccess === true;\n   346→    args.push(\"-c\", `tools.webSearch=${internetEnabled ? \"true\" : \"false\"}`);\n   347→\n   348→    const env: Record<string, string | undefined> = {\n   349→      ...process.env,\n   350→      ...options.env,\n   351→    };\n   352→\n   353→    console.log(`[cli-launcher] Spawning Codex session ${sessionId}: ${binary} ${args.join(\" \")}`);\n   354→\n   355→    const proc = Bun.spawn([binary, ...args], {\n   356→      cwd: info.cwd,\n   357→      env,\n   358→      stdin: \"pipe\",\n   359→      stdout: \"pipe\",\n   360→      stderr: \"pipe\",\n   361→    });\n   362→\n   363→    info.pid = proc.pid;\n   364→    this.processes.set(sessionId, proc);\n   365→\n   366→    // Pipe stderr for debugging (stdout is used for JSON-RPC)\n   367→    const stderr = proc.stderr;\n   368→    if (stderr && typeof stderr !== \"number\") {\n   369→      this.pipeStream(sessionId, stderr, \"stderr\");\n   370→    }\n   371→\n   372→    // Create the CodexAdapter which handles JSON-RPC and message translation\n   373→    // Pass the raw permission mode — the adapter maps it to Codex's approval policy\n   374→    const adapter = new CodexAdapter(proc, sessionId, {\n   375→      model: options.model,\n   376→      cwd: info.cwd,\n   377→      approvalMode: options.permissionMode,\n   378→      threadId: info.cliSessionId,\n   379→      sandbox: options.codexSandbox,\n   380→    });\n   381→\n   382→    // Handle init errors — mark session as exited so UI shows failure\n   383→    adapter.onInitError((error) => {\n   384→      console.error(`[cli-launcher] Codex session ${sessionId} init failed: ${error}`);\n   385→      const session = this.sessions.get(sessionId);\n   386→      if (session) {\n   387→        session.state = \"exited\";\n   388→        session.exitCode = 1;\n   389→      }\n   390→      this.persistState();\n   391→    });\n   392→\n   393→    // Notify the WsBridge to attach this adapter\n   394→    if (this.onCodexAdapter) {\n   395→      this.onCodexAdapter(sessionId, adapter);\n   396→    }\n   397→\n   398→    // Mark as connected immediately (no WS handshake needed for stdio)\n   399→    info.state = \"connected\";\n   400→\n   401→    // Monitor process exit\n   402→    const spawnedAt = Date.now();\n   403→    proc.exited.then((exitCode) => {\n   404→      console.log(`[cli-launcher] Codex session ${sessionId} exited (code=${exitCode})`);\n   405→      const session = this.sessions.get(sessionId);\n   406→      if (session) {\n   407→        session.state = \"exited\";\n   408→        session.exitCode = exitCode;\n   409→      }\n   410→      this.processes.delete(sessionId);\n   411→      this.persistState();\n   412→    });\n   413→\n   414→    this.persistState();\n   415→  }\n   416→\n   417→\n   418→  /**\n   419→   * Inject a CLAUDE.md file into the worktree with branch guardrails.\n   420→   * Only injects into actual worktree directories, never the main repo.\n   421→   */\n   422→  private injectWorktreeGuardrails(worktreePath: string, branch: string, repoRoot: string, parentBranch?: string): void {\n   423→    // Safety: never inject guardrails into the main repository itself\n   424→    if (worktreePath === repoRoot) {\n   425→      console.warn(`[cli-launcher] Skipping guardrails injection: worktree path is the main repo (${repoRoot})`);\n   426→      return;\n   427→    }\n   428→\n   429→    // Safety: only inject if the worktree directory actually exists (created by git worktree add)\n   430→    if (!existsSync(worktreePath)) {\n   431→      console.warn(`[cli-launcher] Skipping guardrails injection: worktree path does not exist (${worktreePath})`);\n   432→      return;\n   433→    }\n   434→\n   435→    const branchLabel = parentBranch\n   436→      ? `\\`${branch}\\` (created from \\`${parentBranch}\\`)`\n   437→      : `\\`${branch}\\``;\n   438→\n   439→    const MARKER_START = \"<!-- WORKTREE_GUARDRAILS_START -->\";\n   440→    const MARKER_END = \"<!-- WORKTREE_GUARDRAILS_END -->\";\n   441→    const guardrails = `${MARKER_START}\n   442→# Worktree Session — Branch Guardrails\n   443→\n   444→You are working on branch: ${branchLabel}\n   445→This is a git worktree. The main repository is at: \\`${repoRoot}\\`\n   446→\n   447→**Rules:**\n   448→1. DO NOT run \\`git checkout\\`, \\`git switch\\`, or any command that changes the current branch\n   449→2. All your work MUST stay on the \\`${branch}\\` branch\n   450→3. When committing, commit to \\`${branch}\\` only\n   451→4. If you need to reference code from another branch, use \\`git show other-branch:path/to/file\\`\n   452→${MARKER_END}`;\n   453→\n   454→    const claudeDir = join(worktreePath, \".claude\");\n   455→    const claudeMdPath = join(claudeDir, \"CLAUDE.md\");\n   456→\n   457→    try {\n   458→      mkdirSync(claudeDir, { recursive: true });\n   459→\n   460→      if (existsSync(claudeMdPath)) {\n   461→        const existing = readFileSync(claudeMdPath, \"utf-8\");\n   462→        // Replace existing guardrails section or append\n   463→        if (existing.includes(MARKER_START)) {\n   464→          const before = existing.substring(0, existing.indexOf(MARKER_START));\n   465→          const afterIdx = existing.indexOf(MARKER_END);\n   466→          const after = afterIdx >= 0 ? existing.substring(afterIdx + MARKER_END.length) : \"\";\n   467→          writeFileSync(claudeMdPath, before + guardrails + after, \"utf-8\");\n   468→        } else {\n   469→          writeFileSync(claudeMdPath, existing + \"\\n\\n\" + guardrails, \"utf-8\");\n   470→        }\n   471→      } else {\n   472→        writeFileSync(claudeMdPath, guardrails, \"utf-8\");\n   473→      }\n   474→      console.log(`[cli-launcher] Injected worktree guardrails for branch ${branch}`);\n   475→    } catch (e) {\n   476→      console.warn(`[cli-launcher] Failed to inject worktree guardrails:`, e);\n   477→    }\n   478→  }\n   479→\n   480→  /**\n   481→   * Mark a session as connected (called when CLI establishes WS connection).\n   482→   */\n   483→  markConnected(sessionId: string): void {\n   484→    const session = this.sessions.get(sessionId);\n   485→    if (session && (session.state === \"starting\" || session.state === \"connected\")) {\n   486→      session.state = \"connected\";\n   487→      console.log(`[cli-launcher] Session ${sessionId} connected via WebSocket`);\n   488→      this.persistState();\n   489→    }\n   490→  }\n   491→\n   492→  /**\n   493→   * Store the CLI's internal session ID (from system.init message).\n   494→   * This is needed for --resume on relaunch.\n   495→   */\n   496→  setCLISessionId(sessionId: string, cliSessionId: string): void {\n   497→    const session = this.sessions.get(sessionId);\n   498→    if (session) {\n   499→      session.cliSessionId = cliSessionId;\n   500→      this.persistState();\n   501→    }\n   502→  }\n   503→\n   504→  /**\n   505→   * Kill a session's CLI process.\n   506→   */\n   507→  async kill(sessionId: string): Promise<boolean> {\n   508→    const proc = this.processes.get(sessionId);\n   509→    if (!proc) return false;\n   510→\n   511→    proc.kill(\"SIGTERM\");\n   512→\n   513→    // Wait up to 5s for graceful exit, then force kill\n   514→    const exited = await Promise.race([\n   515→      proc.exited.then(() => true),\n   516→      new Promise<false>((resolve) => setTimeout(() => resolve(false), 5_000)),\n   517→    ]);\n   518→\n   519→    if (!exited) {\n   520→      console.log(`[cli-launcher] Force-killing session ${sessionId}`);\n   521→      proc.kill(\"SIGKILL\");\n   522→    }\n   523→\n   524→    const session = this.sessions.get(sessionId);\n   525→    if (session) {\n   526→      session.state = \"exited\";\n   527→      session.exitCode = -1;\n   528→    }\n   529→    this.processes.delete(sessionId);\n   530→    this.persistState();\n   531→    return true;\n   532→  }\n   533→\n   534→  /**\n   535→   * List all sessions (active + recently exited).\n   536→   */\n   537→  listSessions(): SdkSessionInfo[] {\n   538→    return Array.from(this.sessions.values());\n   539→  }\n   540→\n   541→  /**\n   542→   * Get a specific session.\n   543→   */\n   544→  getSession(sessionId: string): SdkSessionInfo | undefined {\n   545→    return this.sessions.get(sessionId);\n   546→  }\n   547→\n   548→  /**\n   549→   * Check if a session exists and is alive (not exited).\n   550→   */\n   551→  isAlive(sessionId: string): boolean {\n   552→    const session = this.sessions.get(sessionId);\n   553→    return !!session && session.state !== \"exited\";\n   554→  }\n   555→\n   556→  /**\n   557→   * Set the archived flag on a session.\n   558→   */\n   559→  setArchived(sessionId: string, archived: boolean): void {\n   560→    const info = this.sessions.get(sessionId);\n   561→    if (info) {\n   562→      info.archived = archived;\n   563→      this.persistState();\n   564→    }\n   565→  }\n   566→\n   567→  /**\n   568→   * Remove a session from the internal map (after kill or cleanup).\n   569→   */\n   570→  removeSession(sessionId: string) {\n   571→    this.sessions.delete(sessionId);\n   572→    this.processes.delete(sessionId);\n   573→    this.persistState();\n   574→  }\n   575→\n   576→  /**\n   577→   * Remove exited sessions from the list.\n   578→   */\n   579→  pruneExited(): number {\n   580→    let pruned = 0;\n   581→    for (const [id, session] of this.sessions) {\n   582→      if (session.state === \"exited\") {\n   583→        this.sessions.delete(id);\n   584→        pruned++;\n   585→      }\n   586→    }\n   587→    return pruned;\n   588→  }\n   589→\n   590→  /**\n   591→   * Kill all sessions.\n   592→   */\n   593→  async killAll(): Promise<void> {\n   594→    const ids = [...this.processes.keys()];\n   595→    await Promise.all(ids.map((id) => this.kill(id)));\n   596→  }\n   597→\n   598→  private async pipeStream(\n   599→    sessionId: string,\n   600→    stream: ReadableStream<Uint8Array> | null,\n   601→    label: \"stdout\" | \"stderr\",\n   602→  ): Promise<void> {\n   603→    if (!stream) return;\n   604→    const reader = stream.getReader();\n   605→    const decoder = new TextDecoder();\n   606→    const log = label === \"stdout\" ? console.log : console.error;\n   607→    try {\n   608→      while (true) {\n   609→        const { done, value } = await reader.read();\n   610→        if (done) break;\n   611→        const text = decoder.decode(value);\n   612→        if (text.trim()) {\n   613→          log(`[session:${sessionId}:${label}] ${text.trimEnd()}`);\n   614→        }\n   615→      }\n   616→    } catch {\n   617→      // stream closed\n   618→    }\n   619→  }\n   620→\n   621→  private pipeOutput(sessionId: string, proc: Subprocess): void {\n   622→    const stdout = proc.stdout;\n   623→    const stderr = proc.stderr;\n   624→    if (stdout && typeof stdout !== \"number\") {\n   625→      this.pipeStream(sessionId, stdout, \"stdout\");\n   626→    }\n   627→    if (stderr && typeof stderr !== \"number\") {\n   628→      this.pipeStream(sessionId, stderr, \"stderr\");\n   629→    }\n   630→  }\n   631→}\n   632→"}]},"parent_tool_use_id":null,"session_id":"6fd2c7b7-e807-4a5f-ab88-3c7663fd206d","uuid":"64c453e0-6f76-42c5-afdf-56a5611809c2","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/companion/web/server/cli-launcher.ts","content":"import { randomUUID } from \"node:crypto\";\nimport { execSync } from \"node:child_process\";\nimport { mkdirSync, existsSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport type { Subprocess } from \"bun\";\nimport type { SessionStore } from \"./session-store.js\";\nimport type { BackendType } from \"./session-types.js\";\nimport { CodexAdapter } from \"./codex-adapter.js\";\n\nexport interface SdkSessionInfo {\n  sessionId: string;\n  pid?: number;\n  state: \"starting\" | \"connected\" | \"running\" | \"exited\";\n  exitCode?: number | null;\n  model?: string;\n  permissionMode?: string;\n  cwd: string;\n  createdAt: number;\n  /** The CLI's internal session ID (from system.init), used for --resume */\n  cliSessionId?: string;\n  archived?: boolean;\n  /** Whether this session uses a git worktree */\n  isWorktree?: boolean;\n  /** The original repo root path */\n  repoRoot?: string;\n  /** Conceptual branch this session is working on (what user selected) */\n  branch?: string;\n  /** Actual git branch in the worktree (may differ for -wt-N branches) */\n  actualBranch?: string;\n  /** User-facing session name */\n  name?: string;\n  /** Which backend this session uses */\n  backendType?: BackendType;\n  /** Git branch from bridge state (enriched by REST API) */\n  gitBranch?: string;\n  /** Git ahead count (enriched by REST API) */\n  gitAhead?: number;\n  /** Git behind count (enriched by REST API) */\n  gitBehind?: number;\n  /** Total lines added (enriched by REST API) */\n  totalLinesAdded?: number;\n  /** Total lines removed (enriched by REST API) */\n  totalLinesRemoved?: number;\n  /** Whether internet/web search is enabled for Codex sessions */\n  codexInternetAccess?: boolean;\n  /** Sandbox mode selected for Codex sessions */\n  codexSandbox?: \"workspace-write\" | \"danger-full-access\";\n}\n\nexport interface LaunchOptions {\n  model?: string;\n  permissionMode?: string;\n  cwd?: string;\n  claudeBinary?: string;\n  codexBinary?: string;\n  allowedTools?: string[];\n  env?: Record<string, string>;\n  backendType?: BackendType;\n  /** Codex sandbox mode. */\n  codexSandbox?: \"workspace-write\" | \"danger-full-access\";\n  /** Whether Codex internet/web search should be enabled for this session. */\n  codexInternetAccess?: boolean;\n  /** Pre-resolved worktree info from the session creation flow */\n  worktreeInfo?: {\n    isWorktree: boolean;\n    repoRoot: string;\n    branch: string;\n    actualBranch: string;\n    worktreePath: string;\n  };\n}\n\n/**\n * Manages CLI backend processes (Claude Code via --sdk-url WebSocket,\n * or Codex via app-server stdio).\n */\nexport class CliLauncher {\n  private sessions = new Map<string, SdkSessionInfo>();\n  private processes = new Map<string, Subprocess>();\n  private port: number;\n  private store: SessionStore | null = null;\n  private onCodexAdapter: ((sessionId: string, adapter: CodexAdapter) => void) | null = null;\n\n  constructor(port: number) {\n    this.port = port;\n  }\n\n  /** Register a callback for when a CodexAdapter is created (WsBridge needs to attach it). */\n  onCodexAdapterCreated(cb: (sessionId: string, adapter: CodexAdapter) => void): void {\n    this.onCodexAdapter = cb;\n  }\n\n  /** Attach a persistent store for surviving server restarts. */\n  setStore(store: SessionStore): void {\n    this.store = store;\n  }\n\n  /** Persist launcher state to disk. */\n  private persistState(): void {\n    if (!this.store) return;\n    const data = Array.from(this.sessions.values());\n    this.store.saveLauncher(data);\n  }\n\n  /**\n   * Restore sessions from disk and check which PIDs are still alive.\n   * Returns the number of recovered sessions.\n   */\n  restoreFromDisk(): number {\n    if (!this.store) return 0;\n    const data = this.store.loadLauncher<SdkSessionInfo[]>();\n    if (!data || !Array.isArray(data)) return 0;\n\n    let recovered = 0;\n    for (const info of data) {\n      if (this.sessions.has(info.sessionId)) continue;\n\n      // Check if the process is still alive\n      if (info.pid && info.state !== \"exited\") {\n        try {\n          process.kill(info.pid, 0); // signal 0 = just check if alive\n          info.state = \"starting\"; // WS not yet re-established, wait for CLI to reconnect\n          this.sessions.set(info.sessionId, info);\n          recovered++;\n        } catch {\n          // Process is dead\n          info.state = \"exited\";\n          info.exitCode = -1;\n          this.sessions.set(info.sessionId, info);\n        }\n      } else {\n        // Already exited or no PID\n        this.sessions.set(info.sessionId, info);\n      }\n    }\n    if (recovered > 0) {\n      console.log(`[cli-launcher] Recovered ${recovered} live session(s) from disk`);\n    }\n    return recovered;\n  }\n\n  /**\n   * Launch a new CLI session (Claude Code or Codex).\n   */\n  launch(options: LaunchOptions = {}): SdkSessionInfo {\n    const sessionId = randomUUID();\n    const cwd = options.cwd || process.cwd();\n    const backendType = options.backendType || \"claude\";\n\n    const info: SdkSessionInfo = {\n      sessionId,\n      state: \"starting\",\n      model: options.model,\n      permissionMode: options.permissionMode,\n      cwd,\n      createdAt: Date.now(),\n      backendType,\n    };\n\n    if (backendType === \"codex\") {\n      info.codexInternetAccess = options.codexInternetAccess === true;\n      info.codexSandbox = options.codexSandbox;\n    }\n\n    // Store worktree metadata if provided\n    if (options.worktreeInfo) {\n      info.isWorktree = options.worktreeInfo.isWorktree;\n      info.repoRoot = options.worktreeInfo.repoRoot;\n      info.branch = options.worktreeInfo.branch;\n      info.actualBranch = options.worktreeInfo.actualBranch;\n    }\n\n    this.sessions.set(sessionId, info);\n\n    if (backendType === \"codex\") {\n      this.spawnCodex(sessionId, info, options);\n    } else {\n      this.spawnCLI(sessionId, info, options);\n    }\n    return info;\n  }\n\n  /**\n   * Relaunch a CLI process for an existing session.\n   * Kills the old process if still alive, then spawns a fresh CLI\n   * that connects back to the same session in the WsBridge.\n   */\n  async relaunch(sessionId: string): Promise<boolean> {\n    const info = this.sessions.get(sessionId);\n    if (!info) return false;\n\n    // Kill old process if still alive\n    const oldProc = this.processes.get(sessionId);\n    if (oldProc) {\n      try {\n        oldProc.kill(\"SIGTERM\");\n        await Promise.race([\n          oldProc.exited,\n          new Promise((r) => setTimeout(r, 2000)),\n        ]);\n      } catch {}\n      this.processes.delete(sessionId);\n    } else if (info.pid) {\n      // Process from a previous server instance — kill by PID\n      try { process.kill(info.pid, \"SIGTERM\"); } catch {}\n    }\n\n    info.state = \"starting\";\n\n    if (info.backendType === \"codex\") {\n      this.spawnCodex(sessionId, info, {\n        model: info.model,\n        permissionMode: info.permissionMode,\n        cwd: info.cwd,\n        codexSandbox: info.codexSandbox,\n        codexInternetAccess: info.codexInternetAccess,\n      });\n    } else {\n      this.spawnCLI(sessionId, info, {\n        model: info.model,\n        permissionMode: info.permissionMode,\n        cwd: info.cwd,\n        resumeSessionId: info.cliSessionId,\n      });\n    }\n    return true;\n  }\n\n  /**\n   * Get all sessions in \"starting\" state (awaiting CLI WebSocket connection).\n   */\n  getStartingSessions(): SdkSessionInfo[] {\n    return Array.from(this.sessions.values()).filter((s) => s.state === \"starting\");\n  }\n\n  private spawnCLI(sessionId: string, info: SdkSessionInfo, options: LaunchOptions & { resumeSessionId?: string }): void {\n    let binary = options.claudeBinary || \"claude\";\n    if (!binary.startsWith(\"/\")) {\n      try {\n        binary = execSync(`which ${binary}`, { encoding: \"utf-8\" }).trim();\n      } catch {\n        // fall through, hope it's in PATH\n      }\n    }\n\n    const sdkUrl = `ws://localhost:${this.port}/ws/cli/${sessionId}`;\n\n    const args: string[] = [\n      \"--sdk-url\", sdkUrl,\n      \"--print\",\n      \"--output-format\", \"stream-json\",\n      \"--input-format\", \"stream-json\",\n      \"--verbose\",\n    ];\n\n    if (options.model) {\n      args.push(\"--model\", options.model);\n    }\n    if (options.permissionMode) {\n      args.push(\"--permission-mode\", options.permissionMode);\n    }\n    if (options.allowedTools) {\n      for (const tool of options.allowedTools) {\n        args.push(\"--allowedTools\", tool);\n      }\n    }\n\n    // Inject CLAUDE.md guardrails for worktree sessions\n    if (info.isWorktree && info.branch) {\n      this.injectWorktreeGuardrails(\n        info.cwd,\n        info.actualBranch || info.branch,\n        info.repoRoot || \"\",\n        info.actualBranch && info.actualBranch !== info.branch ? info.branch : undefined,\n      );\n    }\n\n    // Always pass -p \"\" for headless mode. When relaunching, also pass --resume\n    // to restore the CLI's conversation context.\n    if (options.resumeSessionId) {\n      args.push(\"--resume\", options.resumeSessionId);\n    }\n    args.push(\"-p\", \"\");\n\n    const env: Record<string, string | undefined> = {\n      ...process.env,\n      CLAUDECODE: \"1\",\n      ...options.env,\n    };\n\n    console.log(`[cli-launcher] Spawning session ${sessionId}: ${binary} ${args.join(\" \")}`);\n\n    const proc = Bun.spawn([binary, ...args], {\n      cwd: info.cwd,\n      env,\n      stdout: \"pipe\",\n      stderr: \"pipe\",\n    });\n\n    info.pid = proc.pid;\n    this.processes.set(sessionId, proc);\n\n    // Stream stdout/stderr for debugging\n    this.pipeOutput(sessionId, proc);\n\n    // Monitor process exit\n    const spawnedAt = Date.now();\n    proc.exited.then((exitCode) => {\n      console.log(`[cli-launcher] Session ${sessionId} exited (code=${exitCode})`);\n      const session = this.sessions.get(sessionId);\n      if (session) {\n        session.state = \"exited\";\n        session.exitCode = exitCode;\n\n        // If the process exited almost immediately with --resume, the resume likely failed.\n        // Clear cliSessionId so the next relaunch starts fresh.\n        const uptime = Date.now() - spawnedAt;\n        if (uptime < 5000 && options.resumeSessionId) {\n          console.error(`[cli-launcher] Session ${sessionId} exited immediately after --resume (${uptime}ms). Clearing cliSessionId for fresh start.`);\n          session.cliSessionId = undefined;\n        }\n      }\n      this.processes.delete(sessionId);\n      this.persistState();\n    });\n\n    this.persistState();\n  }\n\n  /**\n   * Spawn a Codex app-server subprocess for a session.\n   * Unlike Claude Code (which connects back via WebSocket), Codex uses stdio.\n   */\n  private spawnCodex(sessionId: string, info: SdkSessionInfo, options: LaunchOptions): void {\n    let binary = options.codexBinary || \"codex\";\n    if (!binary.startsWith(\"/\")) {\n      try {\n        binary = execSync(`which ${binary}`, { encoding: \"utf-8\" }).trim();\n      } catch {\n        // fall through, hope it's in PATH\n      }\n    }\n\n    const args: string[] = [\"app-server\"];\n    const internetEnabled = options.codexInternetAccess === true;\n    args.push(\"-c\", `tools.webSearch=${internetEnabled ? \"true\" : \"false\"}`);\n\n    const env: Record<string, string | undefined> = {\n      ...process.env,\n      ...options.env,\n    };\n\n    console.log(`[cli-launcher] Spawning Codex session ${sessionId}: ${binary} ${args.join(\" \")}`);\n\n    const proc = Bun.spawn([binary, ...args], {\n      cwd: info.cwd,\n      env,\n      stdin: \"pipe\",\n      stdout: \"pipe\",\n      stderr: \"pipe\",\n    });\n\n    info.pid = proc.pid;\n    this.processes.set(sessionId, proc);\n\n    // Pipe stderr for debugging (stdout is used for JSON-RPC)\n    const stderr = proc.stderr;\n    if (stderr && typeof stderr !== \"number\") {\n      this.pipeStream(sessionId, stderr, \"stderr\");\n    }\n\n    // Create the CodexAdapter which handles JSON-RPC and message translation\n    // Pass the raw permission mode — the adapter maps it to Codex's approval policy\n    const adapter = new CodexAdapter(proc, sessionId, {\n      model: options.model,\n      cwd: info.cwd,\n      approvalMode: options.permissionMode,\n      threadId: info.cliSessionId,\n      sandbox: options.codexSandbox,\n    });\n\n    // Handle init errors — mark session as exited so UI shows failure\n    adapter.onInitError((error) => {\n      console.error(`[cli-launcher] Codex session ${sessionId} init failed: ${error}`);\n      const session = this.sessions.get(sessionId);\n      if (session) {\n        session.state = \"exited\";\n        session.exitCode = 1;\n      }\n      this.persistState();\n    });\n\n    // Notify the WsBridge to attach this adapter\n    if (this.onCodexAdapter) {\n      this.onCodexAdapter(sessionId, adapter);\n    }\n\n    // Mark as connected immediately (no WS handshake needed for stdio)\n    info.state = \"connected\";\n\n    // Monitor process exit\n    const spawnedAt = Date.now();\n    proc.exited.then((exitCode) => {\n      console.log(`[cli-launcher] Codex session ${sessionId} exited (code=${exitCode})`);\n      const session = this.sessions.get(sessionId);\n      if (session) {\n        session.state = \"exited\";\n        session.exitCode = exitCode;\n      }\n      this.processes.delete(sessionId);\n      this.persistState();\n    });\n\n    this.persistState();\n  }\n\n\n  /**\n   * Inject a CLAUDE.md file into the worktree with branch guardrails.\n   * Only injects into actual worktree directories, never the main repo.\n   */\n  private injectWorktreeGuardrails(worktreePath: string, branch: string, repoRoot: string, parentBranch?: string): void {\n    // Safety: never inject guardrails into the main repository itself\n    if (worktreePath === repoRoot) {\n      console.warn(`[cli-launcher] Skipping guardrails injection: worktree path is the main repo (${repoRoot})`);\n      return;\n    }\n\n    // Safety: only inject if the worktree directory actually exists (created by git worktree add)\n    if (!existsSync(worktreePath)) {\n      console.warn(`[cli-launcher] Skipping guardrails injection: worktree path does not exist (${worktreePath})`);\n      return;\n    }\n\n    const branchLabel = parentBranch\n      ? `\\`${branch}\\` (created from \\`${parentBranch}\\`)`\n      : `\\`${branch}\\``;\n\n    const MARKER_START = \"<!-- WORKTREE_GUARDRAILS_START -->\";\n    const MARKER_END = \"<!-- WORKTREE_GUARDRAILS_END -->\";\n    const guardrails = `${MARKER_START}\n# Worktree Session — Branch Guardrails\n\nYou are working on branch: ${branchLabel}\nThis is a git worktree. The main repository is at: \\`${repoRoot}\\`\n\n**Rules:**\n1. DO NOT run \\`git checkout\\`, \\`git switch\\`, or any command that changes the current branch\n2. All your work MUST stay on the \\`${branch}\\` branch\n3. When committing, commit to \\`${branch}\\` only\n4. If you need to reference code from another branch, use \\`git show other-branch:path/to/file\\`\n${MARKER_END}`;\n\n    const claudeDir = join(worktreePath, \".claude\");\n    const claudeMdPath = join(claudeDir, \"CLAUDE.md\");\n\n    try {\n      mkdirSync(claudeDir, { recursive: true });\n\n      if (existsSync(claudeMdPath)) {\n        const existing = readFileSync(claudeMdPath, \"utf-8\");\n        // Replace existing guardrails section or append\n        if (existing.includes(MARKER_START)) {\n          const before = existing.substring(0, existing.indexOf(MARKER_START));\n          const afterIdx = existing.indexOf(MARKER_END);\n          const after = afterIdx >= 0 ? existing.substring(afterIdx + MARKER_END.length) : \"\";\n          writeFileSync(claudeMdPath, before + guardrails + after, \"utf-8\");\n        } else {\n          writeFileSync(claudeMdPath, existing + \"\\n\\n\" + guardrails, \"utf-8\");\n        }\n      } else {\n        writeFileSync(claudeMdPath, guardrails, \"utf-8\");\n      }\n      console.log(`[cli-launcher] Injected worktree guardrails for branch ${branch}`);\n    } catch (e) {\n      console.warn(`[cli-launcher] Failed to inject worktree guardrails:`, e);\n    }\n  }\n\n  /**\n   * Mark a session as connected (called when CLI establishes WS connection).\n   */\n  markConnected(sessionId: string): void {\n    const session = this.sessions.get(sessionId);\n    if (session && (session.state === \"starting\" || session.state === \"connected\")) {\n      session.state = \"connected\";\n      console.log(`[cli-launcher] Session ${sessionId} connected via WebSocket`);\n      this.persistState();\n    }\n  }\n\n  /**\n   * Store the CLI's internal session ID (from system.init message).\n   * This is needed for --resume on relaunch.\n   */\n  setCLISessionId(sessionId: string, cliSessionId: string): void {\n    const session = this.sessions.get(sessionId);\n    if (session) {\n      session.cliSessionId = cliSessionId;\n      this.persistState();\n    }\n  }\n\n  /**\n   * Kill a session's CLI process.\n   */\n  async kill(sessionId: string): Promise<boolean> {\n    const proc = this.processes.get(sessionId);\n    if (!proc) return false;\n\n    proc.kill(\"SIGTERM\");\n\n    // Wait up to 5s for graceful exit, then force kill\n    const exited = await Promise.race([\n      proc.exited.then(() => true),\n      new Promise<false>((resolve) => setTimeout(() => resolve(false), 5_000)),\n    ]);\n\n    if (!exited) {\n      console.log(`[cli-launcher] Force-killing session ${sessionId}`);\n      proc.kill(\"SIGKILL\");\n    }\n\n    const session = this.sessions.get(sessionId);\n    if (session) {\n      session.state = \"exited\";\n      session.exitCode = -1;\n    }\n    this.processes.delete(sessionId);\n    this.persistState();\n    return true;\n  }\n\n  /**\n   * List all sessions (active + recently exited).\n   */\n  listSessions(): SdkSessionInfo[] {\n    return Array.from(this.sessions.values());\n  }\n\n  /**\n   * Get a specific session.\n   */\n  getSession(sessionId: string): SdkSessionInfo | undefined {\n    return this.sessions.get(sessionId);\n  }\n\n  /**\n   * Check if a session exists and is alive (not exited).\n   */\n  isAlive(sessionId: string): boolean {\n    const session = this.sessions.get(sessionId);\n    return !!session && session.state !== \"exited\";\n  }\n\n  /**\n   * Set the archived flag on a session.\n   */\n  setArchived(sessionId: string, archived: boolean): void {\n    const info = this.sessions.get(sessionId);\n    if (info) {\n      info.archived = archived;\n      this.persistState();\n    }\n  }\n\n  /**\n   * Remove a session from the internal map (after kill or cleanup).\n   */\n  removeSession(sessionId: string) {\n    this.sessions.delete(sessionId);\n    this.processes.delete(sessionId);\n    this.persistState();\n  }\n\n  /**\n   * Remove exited sessions from the list.\n   */\n  pruneExited(): number {\n    let pruned = 0;\n    for (const [id, session] of this.sessions) {\n      if (session.state === \"exited\") {\n        this.sessions.delete(id);\n        pruned++;\n      }\n    }\n    return pruned;\n  }\n\n  /**\n   * Kill all sessions.\n   */\n  async killAll(): Promise<void> {\n    const ids = [...this.processes.keys()];\n    await Promise.all(ids.map((id) => this.kill(id)));\n  }\n\n  private async pipeStream(\n    sessionId: string,\n    stream: ReadableStream<Uint8Array> | null,\n    label: \"stdout\" | \"stderr\",\n  ): Promise<void> {\n    if (!stream) return;\n    const reader = stream.getReader();\n    const decoder = new TextDecoder();\n    const log = label === \"stdout\" ? console.log : console.error;\n    try {\n      while (true) {\n        const { done, value } = await reader.read();\n        if (done) break;\n        const text = decoder.decode(value);\n        if (text.trim()) {\n          log(`[session:${sessionId}:${label}] ${text.trimEnd()}`);\n        }\n      }\n    } catch {\n      // stream closed\n    }\n  }\n\n  private pipeOutput(sessionId: string, proc: Subprocess): void {\n    const stdout = proc.stdout;\n    const stderr = proc.stderr;\n    if (stdout && typeof stdout !== \"number\") {\n      this.pipeStream(sessionId, stdout, \"stdout\");\n    }\n    if (stderr && typeof stderr !== \"number\") {\n      this.pipeStream(sessionId, stderr, \"stderr\");\n    }\n  }\n}\n","numLines":632,"startLine":1,"totalLines":632}}}
