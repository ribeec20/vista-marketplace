{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E8Z8oSHKvu7XMCvkwN6kf7","type":"tool_result","content":"     1→\"\"\"Keep-alive chat manager using teams infrastructure.\n     2→\n     3→Spawns a Claude CLI agent in a tmux pane with file-based messaging.\n     4→Singleton model: at most one persistent pane exists at any time.\n     5→\n     6→Note: We handle tmux spawning directly instead of using spawn_teammate()\n     7→because the MSYS2 tmux build doesn't support #{pane_id} format strings.\n     8→We use the -P flag alone which returns session:window.pane identifiers.\n     9→\"\"\"\n    10→\n    11→import asyncio\n    12→import logging\n    13→import os\n    14→import shutil\n    15→import subprocess\n    16→import time\n    17→from dataclasses import dataclass\n    18→from pathlib import Path\n    19→from typing import AsyncGenerator, Optional\n    20→\n    21→from claude_teams import messaging, teams\n    22→from claude_teams.models import InboxMessage, TeammateMember\n    23→from claude_teams.spawner import (\n    24→    assign_color,\n    25→    build_spawn_command,\n    26→    discover_harness_binary,\n    27→)\n    28→\n    29→log = logging.getLogger(__name__)\n    30→\n    31→TEAMS_DIR = Path.home() / \".claude\" / \"teams\"\n    32→TASKS_DIR = Path.home() / \".claude\" / \"tasks\"\n    33→\n    34→# MSYS2 default locations where tmux is commonly installed on Windows\n    35→_MSYS2_BIN_DIRS = [\n    36→    Path(\"C:/msys64/usr/bin\"),\n    37→    Path(\"/c/msys64/usr/bin\"),\n    38→]\n    39→\n    40→\n    41→def _ensure_tmux_on_path() -> None:\n    42→    \"\"\"Find tmux and add its directory to PATH if not already there.\"\"\"\n    43→    if shutil.which(\"tmux\"):\n    44→        return\n    45→    for bin_dir in _MSYS2_BIN_DIRS:\n    46→        tmux_exe = bin_dir / \"tmux.exe\"\n    47→        if tmux_exe.exists():\n    48→            bin_str = str(bin_dir)\n    49→            if bin_str not in os.environ.get(\"PATH\", \"\"):\n    50→                os.environ[\"PATH\"] = bin_str + os.pathsep + os.environ.get(\"PATH\", \"\")\n    51→                log.info(\"Added %s to PATH for tmux\", bin_str)\n    52→            return\n    53→    log.warning(\"tmux not found on PATH or in standard MSYS2 locations\")\n    54→\n    55→\n    56→_ensure_tmux_on_path()\n    57→\n    58→\n    59→def _tmux_kill_pane(pane_id: str) -> None:\n    60→    \"\"\"Kill a tmux pane by its identifier (session:window.pane or %N format).\"\"\"\n    61→    if not pane_id:\n    62→        return\n    63→    subprocess.run([\"tmux\", \"kill-pane\", \"-t\", pane_id], capture_output=True, timeout=5)\n    64→\n    65→\n    66→@dataclass\n    67→class _LiveSession:\n    68→    session_id: str\n    69→    team_name: str\n    70→    pane_id: str\n    71→\n    72→\n    73→class KeepAliveManager:\n    74→    \"\"\"Manages a singleton persistent Claude agent via tmux + file-based messaging.\"\"\"\n    75→\n    76→    def __init__(self) -> None:\n    77→        self._current: Optional[_LiveSession] = None\n    78→        self._disconnect_task: Optional[asyncio.Task] = None\n    79→        self.cleanup_orphans()\n    80→\n    81→    # ------------------------------------------------------------------\n    82→    # Public API\n    83→    # ------------------------------------------------------------------\n    84→\n    85→    def start(\n    86→        self,\n    87→        session_id: str,\n    88→        provider: str,\n    89→        model: str,\n    90→        system_prompt: str,\n    91→        cwd: str,\n    92→    ) -> str:\n    93→        \"\"\"Spawn a new persistent agent. Kills any existing one first.\n    94→\n    95→        Returns the team_name.\n    96→        \"\"\"\n    97→        # Singleton enforcement — kill old pane before spawning new\n    98→        if self._current is not None:\n    99→            self.stop()\n   100→\n   101→        team_name = f\"vista-chat-{session_id}\"\n   102→\n   103→        claude_binary = discover_harness_binary(\"claude\")\n   104→        if not claude_binary:\n   105→            raise RuntimeError(\"Claude CLI binary not found on PATH\")\n   106→\n   107→        # Ensure tmux server is running\n   108→        self._ensure_tmux_session()\n   109→\n   110→        # Create the team (dirs + config)\n   111→        teams.create_team(team_name, session_id)\n   112→\n   113→        # Ensure team-lead inbox exists so we can poll it later\n   114→        messaging.ensure_inbox(team_name, \"team-lead\")\n   115→\n   116→        try:\n   117→            pane_id = self._spawn_agent(\n   118→                team_name=team_name,\n   119→                name=\"architect\",\n   120→                prompt=system_prompt,\n   121→                claude_binary=claude_binary,\n   122→                lead_session_id=session_id,\n   123→                model=model,\n   124→                cwd=cwd,\n   125→            )\n   126→        except Exception:\n   127→            try:\n   128→                self._force_delete_team(team_name)\n   129→            except Exception:\n   130→                pass\n   131→            raise\n   132→\n   133→        self._current = _LiveSession(\n   134→            session_id=session_id,\n   135→            team_name=team_name,\n   136→            pane_id=pane_id,\n   137→        )\n   138→        log.info(\"Started keep-alive agent: team=%s pane=%s\", team_name, pane_id)\n   139→        return team_name\n   140→\n   141→    def send_message(\n   142→        self, session_id: str, message: str, context: Optional[str] = None\n   143→    ) -> None:\n   144→        \"\"\"Send a user message to the agent via inbox.\"\"\"\n   145→        if self._current is None or self._current.session_id != session_id:\n   146→            raise RuntimeError(f\"No active keep-alive session for {session_id}\")\n   147→\n   148→        parts: list[str] = []\n   149→        if context:\n   150→            parts.append(context)\n   151→        parts.append(message)\n   152→        text = \"\\n\".join(parts)\n   153→\n   154→        messaging.send_plain_message(\n   155→            team_name=self._current.team_name,\n   156→            from_name=\"team-lead\",\n   157→            to_name=\"architect\",\n   158→            text=text,\n   159→            summary=\"user message\",\n   160→        )\n   161→\n   162→    async def poll_response(\n   163→        self, session_id: str, timeout: float = 120\n   164→    ) -> AsyncGenerator[dict, None]:\n   165→        \"\"\"Poll agent inbox for a response. Yields stream events.\"\"\"\n   166→        live = self._current\n   167→        if live is None or live.session_id != session_id:\n   168→            yield {\"type\": \"error\", \"detail\": f\"No active keep-alive session for {session_id}\"}\n   169→            return\n   170→\n   171→        team_name = live.team_name\n   172→        pane_id = live.pane_id\n   173→        elapsed = 0.0\n   174→        poll_interval = 0.5\n   175→\n   176→        while elapsed < timeout:\n   177→            messages = messaging.read_inbox(\n   178→                team_name=team_name,\n   179→                agent_name=\"team-lead\",\n   180→                unread_only=True,\n   181→                mark_as_read=True,\n   182→            )\n   183→\n   184→            for msg in messages:\n   185→                if msg.from_ == \"architect\" and msg.text:\n   186→                    content = msg.text\n   187→                    yield {\"type\": \"token\", \"text\": content}\n   188→                    yield {\"type\": \"done\", \"content\": content}\n   189→                    return\n   190→\n   191→            await asyncio.sleep(poll_interval)\n   192→            elapsed += poll_interval\n   193→\n   194→            # Bail early if the pane died (use local ref to avoid race)\n   195→            if not self._is_pane_alive(pane_id):\n   196→                yield {\"type\": \"error\", \"detail\": \"Agent process terminated unexpectedly\"}\n   197→                return\n   198→\n   199→        yield {\"type\": \"error\", \"detail\": f\"Agent response timed out after {timeout}s\"}\n   200→\n   201→    def is_alive(self, session_id: str) -> bool:\n   202→        \"\"\"Check if the agent for this session is still running.\"\"\"\n   203→        if self._current is None or self._current.session_id != session_id:\n   204→            return False\n   205→        return self._is_pane_alive(self._current.pane_id)\n   206→\n   207→    def resume(self, session_id: str, team_name: str) -> bool:\n   208→        \"\"\"Attempt to reconnect to an existing team/pane.\n   209→\n   210→        Returns True if pane is alive and mapping restored.\n   211→        \"\"\"\n   212→        try:\n   213→            config = teams.read_config(team_name)\n   214→        except FileNotFoundError:\n   215→            return False\n   216→\n   217→        for member in config.members:\n   218→            if isinstance(member, TeammateMember) and member.name == \"architect\":\n   219→                if self._is_pane_alive(member.tmux_pane_id):\n   220→                    self._current = _LiveSession(\n   221→                        session_id=session_id,\n   222→                        team_name=team_name,\n   223→                        pane_id=member.tmux_pane_id,\n   224→                    )\n   225→                    log.info(\"Resumed keep-alive: team=%s pane=%s\", team_name, member.tmux_pane_id)\n   226→                    return True\n   227→                else:\n   228→                    self._force_delete_team(team_name)\n   229→                    return False\n   230→\n   231→        return False\n   232→\n   233→    def stop(self) -> None:\n   234→        \"\"\"Kill the current persistent pane and clean up.\"\"\"\n   235→        if self._current is None:\n   236→            return\n   237→\n   238→        self._cancel_disconnect_task()\n   239→\n   240→        pane_id = self._current.pane_id\n   241→        team_name = self._current.team_name\n   242→        self._current = None\n   243→\n   244→        _tmux_kill_pane(pane_id)\n   245→        self._force_delete_team(team_name)\n   246→        log.info(\"Stopped keep-alive: team=%s\", team_name)\n   247→\n   248→    def stop_all(self) -> None:\n   249→        \"\"\"Alias for stop() — kills the singleton pane. Called on server shutdown.\"\"\"\n   250→        self.stop()\n   251→\n   252→    def cleanup_orphans(self) -> None:\n   253→        \"\"\"Kill orphaned vista-chat-* teams from previous runs.\"\"\"\n   254→        if not TEAMS_DIR.exists():\n   255→            return\n   256→\n   257→        for team_dir in TEAMS_DIR.glob(\"vista-chat-*\"):\n   258→            team_name = team_dir.name\n   259→            try:\n   260→                config = teams.read_config(team_name)\n   261→                for member in config.members:\n   262→                    if isinstance(member, TeammateMember) and member.tmux_pane_id:\n   263→                        _tmux_kill_pane(member.tmux_pane_id)\n   264→            except Exception:\n   265→                pass\n   266→\n   267→            try:\n   268→                self._force_delete_team(team_name)\n   269→            except Exception:\n   270→                log.warning(\"Failed to clean up orphan: %s\", team_name, exc_info=True)\n   271→\n   272→    def schedule_disconnect_cleanup(\n   273→        self, session_id: str, grace_seconds: float = 10\n   274→    ) -> None:\n   275→        \"\"\"Start a timer that kills the pane after grace_seconds of SSE disconnect.\"\"\"\n   276→        if self._current is None or self._current.session_id != session_id:\n   277→            return\n   278→\n   279→        self._cancel_disconnect_task()\n   280→\n   281→        async def _delayed_stop() -> None:\n   282→            await asyncio.sleep(grace_seconds)\n   283→            self.stop()\n   284→            log.info(\"Disconnect grace period expired — pane killed\")\n   285→\n   286→        self._disconnect_task = asyncio.create_task(_delayed_stop())\n   287→\n   288→    def cancel_disconnect_cleanup(self, session_id: str) -> None:\n   289→        \"\"\"Cancel the pending disconnect cleanup (SSE reconnected in time).\"\"\"\n   290→        if self._current is None or self._current.session_id != session_id:\n   291→            return\n   292→        self._cancel_disconnect_task()\n   293→\n   294→    @property\n   295→    def current_team_name(self) -> Optional[str]:\n   296→        return self._current.team_name if self._current else None\n   297→\n   298→    @property\n   299→    def current_session_id(self) -> Optional[str]:\n   300→        return self._current.session_id if self._current else None\n   301→\n   302→    # ------------------------------------------------------------------\n   303→    # Private helpers\n   304→    # ------------------------------------------------------------------\n   305→\n   306→    def _cancel_disconnect_task(self) -> None:\n   307→        if self._disconnect_task is not None:\n   308→            self._disconnect_task.cancel()\n   309→            self._disconnect_task = None\n   310→\n   311→    @staticmethod\n   312→    def _get_tmux_pane_ids() -> set[str]:\n   313→        \"\"\"Get all current tmux pane unique IDs (%N format) by parsing list-panes.\"\"\"\n   314→        try:\n   315→            result = subprocess.run(\n   316→                [\"tmux\", \"list-panes\", \"-a\"],\n   317→                capture_output=True, text=True, timeout=5,\n   318→            )\n   319→            if result.returncode != 0:\n   320→                return set()\n   321→            # Each line ends with %N or %N (active)\n   322→            # e.g. \"vista-host:0.0: [80x24] [history 0/2000, 960 bytes] %0 (active)\"\n   323→            ids: set[str] = set()\n   324→            for line in result.stdout.strip().splitlines():\n   325→                for token in line.split():\n   326→                    if token.startswith(\"%\"):\n   327→                        # Strip trailing non-digit chars like \"(active)\"\n   328→                        ids.add(token)\n   329→                        break  # only one %N per line, and it's near the end\n   330→            return ids\n   331→        except (subprocess.TimeoutExpired, FileNotFoundError):\n   332→            return set()\n   333→\n   334→    @staticmethod\n   335→    def _spawn_agent(\n   336→        team_name: str,\n   337→        name: str,\n   338→        prompt: str,\n   339→        claude_binary: str,\n   340→        lead_session_id: str,\n   341→        model: str,\n   342→        cwd: str,\n   343→    ) -> str:\n   344→        \"\"\"Spawn a Claude agent in a tmux pane and return its stable pane ID.\n   345→\n   346→        Handles team member creation, inbox setup, and tmux spawning directly\n   347→        (bypasses spawn_teammate to avoid broken #{pane_id} format strings\n   348→        on MSYS2 tmux builds).\n   349→\n   350→        Returns the pane unique ID in %N format (stable across pane kills).\n   351→        \"\"\"\n   352→        color = assign_color(team_name)\n   353→        now_ms = int(time.time() * 1000)\n   354→\n   355→        member = TeammateMember(\n   356→            agent_id=f\"{name}@{team_name}\",\n   357→            name=name,\n   358→            agent_type=\"general-purpose\",\n   359→            model=model,\n   360→            prompt=prompt,\n   361→            color=color,\n   362→            plan_mode_required=False,\n   363→            joined_at=now_ms,\n   364→            tmux_pane_id=\"\",\n   365→            cwd=cwd,\n   366→            backend_type=\"claude\",\n   367→        )\n   368→\n   369→        member_added = False\n   370→        try:\n   371→            teams.add_member(team_name, member)\n   372→            member_added = True\n   373→\n   374→            # Set up inbox and send initial prompt\n   375→            messaging.ensure_inbox(team_name, name)\n   376→            initial_msg = InboxMessage(\n   377→                from_=\"team-lead\",\n   378→                text=prompt,\n   379→                timestamp=messaging.now_iso(),\n   380→                read=False,\n   381→            )\n   382→            messaging.append_message(team_name, name, initial_msg)\n   383→\n   384→            # Build Claude CLI command\n   385→            cmd = build_spawn_command(member, claude_binary, lead_session_id)\n   386→\n   387→            # Snapshot pane IDs before spawn\n   388→            before_ids = KeepAliveManager._get_tmux_pane_ids()\n   389→\n   390→            # Spawn in tmux — don't use -F (broken on MSYS2 tmux)\n   391→            subprocess.run(\n   392→                [\"tmux\", \"split-window\", \"-d\", cmd],\n   393→                capture_output=True,\n   394→                text=True,\n   395→                check=True,\n   396→                timeout=10,\n   397→            )\n   398→\n   399→            # Find the new pane by diffing before/after\n   400→            after_ids = KeepAliveManager._get_tmux_pane_ids()\n   401→            new_ids = after_ids - before_ids\n   402→            if not new_ids:\n   403→                raise RuntimeError(\"tmux split-window succeeded but no new pane found\")\n   404→            pane_id = new_ids.pop()\n   405→\n   406→            # Update member config with actual pane ID\n   407→            config = teams.read_config(team_name)\n   408→            for m in config.members:\n   409→                if isinstance(m, TeammateMember) and m.name == name:\n   410→                    m.tmux_pane_id = pane_id\n   411→                    break\n   412→            teams.write_config(team_name, config)\n   413→\n   414→            return pane_id\n   415→\n   416→        except Exception:\n   417→            if member_added:\n   418→                try:\n   419→                    teams.remove_member(team_name, name)\n   420→                except Exception:\n   421→                    pass\n   422→            raise\n   423→\n   424→    @staticmethod\n   425→    def _is_pane_alive(pane_id: str) -> bool:\n   426→        \"\"\"Check if a tmux pane is alive using its identifier.\"\"\"\n   427→        if not pane_id:\n   428→            return False\n   429→        try:\n   430→            # Works with both session:window.pane and %N formats\n   431→            result = subprocess.run(\n   432→                [\"tmux\", \"list-panes\", \"-t\", pane_id],\n   433→                capture_output=True, timeout=5,\n   434→            )\n   435→            return result.returncode == 0\n   436→        except (subprocess.TimeoutExpired, FileNotFoundError):\n   437→            return False\n   438→\n   439→    @staticmethod\n   440→    def _ensure_tmux_session() -> None:\n   441→        \"\"\"Create a detached tmux session if no tmux server is running.\"\"\"\n   442→        try:\n   443→            result = subprocess.run(\n   444→                [\"tmux\", \"list-sessions\"],\n   445→                capture_output=True, timeout=5,\n   446→            )\n   447→            if result.returncode == 0:\n   448→                return  # tmux server already running\n   449→        except (subprocess.TimeoutExpired, FileNotFoundError):\n   450→            pass\n   451→\n   452→        subprocess.run(\n   453→            [\"tmux\", \"new-session\", \"-d\", \"-s\", \"vista-host\"],\n   454→            capture_output=True, check=True, timeout=5,\n   455→        )\n   456→\n   457→    @staticmethod\n   458→    def _force_delete_team(team_name: str) -> None:\n   459→        \"\"\"Force-remove team and task directories.\"\"\"\n   460→        team_dir = TEAMS_DIR / team_name\n   461→        task_dir = TASKS_DIR / team_name\n   462→        if team_dir.exists():\n   463→            shutil.rmtree(team_dir, ignore_errors=True)\n   464→        if task_dir.exists():\n   465→            shutil.rmtree(task_dir, ignore_errors=True)\n   466→\n   467→\n   468→# Singleton instance\n   469→keepalive_manager = KeepAliveManager()\n   470→"}]},"parent_tool_use_id":null,"session_id":"6fd2c7b7-e807-4a5f-ab88-3c7663fd206d","uuid":"efc078b0-0cf7-4b3e-9127-73db801a4bb9","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/services/keepalive_manager.py","content":"\"\"\"Keep-alive chat manager using teams infrastructure.\n\nSpawns a Claude CLI agent in a tmux pane with file-based messaging.\nSingleton model: at most one persistent pane exists at any time.\n\nNote: We handle tmux spawning directly instead of using spawn_teammate()\nbecause the MSYS2 tmux build doesn't support #{pane_id} format strings.\nWe use the -P flag alone which returns session:window.pane identifiers.\n\"\"\"\n\nimport asyncio\nimport logging\nimport os\nimport shutil\nimport subprocess\nimport time\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import AsyncGenerator, Optional\n\nfrom claude_teams import messaging, teams\nfrom claude_teams.models import InboxMessage, TeammateMember\nfrom claude_teams.spawner import (\n    assign_color,\n    build_spawn_command,\n    discover_harness_binary,\n)\n\nlog = logging.getLogger(__name__)\n\nTEAMS_DIR = Path.home() / \".claude\" / \"teams\"\nTASKS_DIR = Path.home() / \".claude\" / \"tasks\"\n\n# MSYS2 default locations where tmux is commonly installed on Windows\n_MSYS2_BIN_DIRS = [\n    Path(\"C:/msys64/usr/bin\"),\n    Path(\"/c/msys64/usr/bin\"),\n]\n\n\ndef _ensure_tmux_on_path() -> None:\n    \"\"\"Find tmux and add its directory to PATH if not already there.\"\"\"\n    if shutil.which(\"tmux\"):\n        return\n    for bin_dir in _MSYS2_BIN_DIRS:\n        tmux_exe = bin_dir / \"tmux.exe\"\n        if tmux_exe.exists():\n            bin_str = str(bin_dir)\n            if bin_str not in os.environ.get(\"PATH\", \"\"):\n                os.environ[\"PATH\"] = bin_str + os.pathsep + os.environ.get(\"PATH\", \"\")\n                log.info(\"Added %s to PATH for tmux\", bin_str)\n            return\n    log.warning(\"tmux not found on PATH or in standard MSYS2 locations\")\n\n\n_ensure_tmux_on_path()\n\n\ndef _tmux_kill_pane(pane_id: str) -> None:\n    \"\"\"Kill a tmux pane by its identifier (session:window.pane or %N format).\"\"\"\n    if not pane_id:\n        return\n    subprocess.run([\"tmux\", \"kill-pane\", \"-t\", pane_id], capture_output=True, timeout=5)\n\n\n@dataclass\nclass _LiveSession:\n    session_id: str\n    team_name: str\n    pane_id: str\n\n\nclass KeepAliveManager:\n    \"\"\"Manages a singleton persistent Claude agent via tmux + file-based messaging.\"\"\"\n\n    def __init__(self) -> None:\n        self._current: Optional[_LiveSession] = None\n        self._disconnect_task: Optional[asyncio.Task] = None\n        self.cleanup_orphans()\n\n    # ------------------------------------------------------------------\n    # Public API\n    # ------------------------------------------------------------------\n\n    def start(\n        self,\n        session_id: str,\n        provider: str,\n        model: str,\n        system_prompt: str,\n        cwd: str,\n    ) -> str:\n        \"\"\"Spawn a new persistent agent. Kills any existing one first.\n\n        Returns the team_name.\n        \"\"\"\n        # Singleton enforcement — kill old pane before spawning new\n        if self._current is not None:\n            self.stop()\n\n        team_name = f\"vista-chat-{session_id}\"\n\n        claude_binary = discover_harness_binary(\"claude\")\n        if not claude_binary:\n            raise RuntimeError(\"Claude CLI binary not found on PATH\")\n\n        # Ensure tmux server is running\n        self._ensure_tmux_session()\n\n        # Create the team (dirs + config)\n        teams.create_team(team_name, session_id)\n\n        # Ensure team-lead inbox exists so we can poll it later\n        messaging.ensure_inbox(team_name, \"team-lead\")\n\n        try:\n            pane_id = self._spawn_agent(\n                team_name=team_name,\n                name=\"architect\",\n                prompt=system_prompt,\n                claude_binary=claude_binary,\n                lead_session_id=session_id,\n                model=model,\n                cwd=cwd,\n            )\n        except Exception:\n            try:\n                self._force_delete_team(team_name)\n            except Exception:\n                pass\n            raise\n\n        self._current = _LiveSession(\n            session_id=session_id,\n            team_name=team_name,\n            pane_id=pane_id,\n        )\n        log.info(\"Started keep-alive agent: team=%s pane=%s\", team_name, pane_id)\n        return team_name\n\n    def send_message(\n        self, session_id: str, message: str, context: Optional[str] = None\n    ) -> None:\n        \"\"\"Send a user message to the agent via inbox.\"\"\"\n        if self._current is None or self._current.session_id != session_id:\n            raise RuntimeError(f\"No active keep-alive session for {session_id}\")\n\n        parts: list[str] = []\n        if context:\n            parts.append(context)\n        parts.append(message)\n        text = \"\\n\".join(parts)\n\n        messaging.send_plain_message(\n            team_name=self._current.team_name,\n            from_name=\"team-lead\",\n            to_name=\"architect\",\n            text=text,\n            summary=\"user message\",\n        )\n\n    async def poll_response(\n        self, session_id: str, timeout: float = 120\n    ) -> AsyncGenerator[dict, None]:\n        \"\"\"Poll agent inbox for a response. Yields stream events.\"\"\"\n        live = self._current\n        if live is None or live.session_id != session_id:\n            yield {\"type\": \"error\", \"detail\": f\"No active keep-alive session for {session_id}\"}\n            return\n\n        team_name = live.team_name\n        pane_id = live.pane_id\n        elapsed = 0.0\n        poll_interval = 0.5\n\n        while elapsed < timeout:\n            messages = messaging.read_inbox(\n                team_name=team_name,\n                agent_name=\"team-lead\",\n                unread_only=True,\n                mark_as_read=True,\n            )\n\n            for msg in messages:\n                if msg.from_ == \"architect\" and msg.text:\n                    content = msg.text\n                    yield {\"type\": \"token\", \"text\": content}\n                    yield {\"type\": \"done\", \"content\": content}\n                    return\n\n            await asyncio.sleep(poll_interval)\n            elapsed += poll_interval\n\n            # Bail early if the pane died (use local ref to avoid race)\n            if not self._is_pane_alive(pane_id):\n                yield {\"type\": \"error\", \"detail\": \"Agent process terminated unexpectedly\"}\n                return\n\n        yield {\"type\": \"error\", \"detail\": f\"Agent response timed out after {timeout}s\"}\n\n    def is_alive(self, session_id: str) -> bool:\n        \"\"\"Check if the agent for this session is still running.\"\"\"\n        if self._current is None or self._current.session_id != session_id:\n            return False\n        return self._is_pane_alive(self._current.pane_id)\n\n    def resume(self, session_id: str, team_name: str) -> bool:\n        \"\"\"Attempt to reconnect to an existing team/pane.\n\n        Returns True if pane is alive and mapping restored.\n        \"\"\"\n        try:\n            config = teams.read_config(team_name)\n        except FileNotFoundError:\n            return False\n\n        for member in config.members:\n            if isinstance(member, TeammateMember) and member.name == \"architect\":\n                if self._is_pane_alive(member.tmux_pane_id):\n                    self._current = _LiveSession(\n                        session_id=session_id,\n                        team_name=team_name,\n                        pane_id=member.tmux_pane_id,\n                    )\n                    log.info(\"Resumed keep-alive: team=%s pane=%s\", team_name, member.tmux_pane_id)\n                    return True\n                else:\n                    self._force_delete_team(team_name)\n                    return False\n\n        return False\n\n    def stop(self) -> None:\n        \"\"\"Kill the current persistent pane and clean up.\"\"\"\n        if self._current is None:\n            return\n\n        self._cancel_disconnect_task()\n\n        pane_id = self._current.pane_id\n        team_name = self._current.team_name\n        self._current = None\n\n        _tmux_kill_pane(pane_id)\n        self._force_delete_team(team_name)\n        log.info(\"Stopped keep-alive: team=%s\", team_name)\n\n    def stop_all(self) -> None:\n        \"\"\"Alias for stop() — kills the singleton pane. Called on server shutdown.\"\"\"\n        self.stop()\n\n    def cleanup_orphans(self) -> None:\n        \"\"\"Kill orphaned vista-chat-* teams from previous runs.\"\"\"\n        if not TEAMS_DIR.exists():\n            return\n\n        for team_dir in TEAMS_DIR.glob(\"vista-chat-*\"):\n            team_name = team_dir.name\n            try:\n                config = teams.read_config(team_name)\n                for member in config.members:\n                    if isinstance(member, TeammateMember) and member.tmux_pane_id:\n                        _tmux_kill_pane(member.tmux_pane_id)\n            except Exception:\n                pass\n\n            try:\n                self._force_delete_team(team_name)\n            except Exception:\n                log.warning(\"Failed to clean up orphan: %s\", team_name, exc_info=True)\n\n    def schedule_disconnect_cleanup(\n        self, session_id: str, grace_seconds: float = 10\n    ) -> None:\n        \"\"\"Start a timer that kills the pane after grace_seconds of SSE disconnect.\"\"\"\n        if self._current is None or self._current.session_id != session_id:\n            return\n\n        self._cancel_disconnect_task()\n\n        async def _delayed_stop() -> None:\n            await asyncio.sleep(grace_seconds)\n            self.stop()\n            log.info(\"Disconnect grace period expired — pane killed\")\n\n        self._disconnect_task = asyncio.create_task(_delayed_stop())\n\n    def cancel_disconnect_cleanup(self, session_id: str) -> None:\n        \"\"\"Cancel the pending disconnect cleanup (SSE reconnected in time).\"\"\"\n        if self._current is None or self._current.session_id != session_id:\n            return\n        self._cancel_disconnect_task()\n\n    @property\n    def current_team_name(self) -> Optional[str]:\n        return self._current.team_name if self._current else None\n\n    @property\n    def current_session_id(self) -> Optional[str]:\n        return self._current.session_id if self._current else None\n\n    # ------------------------------------------------------------------\n    # Private helpers\n    # ------------------------------------------------------------------\n\n    def _cancel_disconnect_task(self) -> None:\n        if self._disconnect_task is not None:\n            self._disconnect_task.cancel()\n            self._disconnect_task = None\n\n    @staticmethod\n    def _get_tmux_pane_ids() -> set[str]:\n        \"\"\"Get all current tmux pane unique IDs (%N format) by parsing list-panes.\"\"\"\n        try:\n            result = subprocess.run(\n                [\"tmux\", \"list-panes\", \"-a\"],\n                capture_output=True, text=True, timeout=5,\n            )\n            if result.returncode != 0:\n                return set()\n            # Each line ends with %N or %N (active)\n            # e.g. \"vista-host:0.0: [80x24] [history 0/2000, 960 bytes] %0 (active)\"\n            ids: set[str] = set()\n            for line in result.stdout.strip().splitlines():\n                for token in line.split():\n                    if token.startswith(\"%\"):\n                        # Strip trailing non-digit chars like \"(active)\"\n                        ids.add(token)\n                        break  # only one %N per line, and it's near the end\n            return ids\n        except (subprocess.TimeoutExpired, FileNotFoundError):\n            return set()\n\n    @staticmethod\n    def _spawn_agent(\n        team_name: str,\n        name: str,\n        prompt: str,\n        claude_binary: str,\n        lead_session_id: str,\n        model: str,\n        cwd: str,\n    ) -> str:\n        \"\"\"Spawn a Claude agent in a tmux pane and return its stable pane ID.\n\n        Handles team member creation, inbox setup, and tmux spawning directly\n        (bypasses spawn_teammate to avoid broken #{pane_id} format strings\n        on MSYS2 tmux builds).\n\n        Returns the pane unique ID in %N format (stable across pane kills).\n        \"\"\"\n        color = assign_color(team_name)\n        now_ms = int(time.time() * 1000)\n\n        member = TeammateMember(\n            agent_id=f\"{name}@{team_name}\",\n            name=name,\n            agent_type=\"general-purpose\",\n            model=model,\n            prompt=prompt,\n            color=color,\n            plan_mode_required=False,\n            joined_at=now_ms,\n            tmux_pane_id=\"\",\n            cwd=cwd,\n            backend_type=\"claude\",\n        )\n\n        member_added = False\n        try:\n            teams.add_member(team_name, member)\n            member_added = True\n\n            # Set up inbox and send initial prompt\n            messaging.ensure_inbox(team_name, name)\n            initial_msg = InboxMessage(\n                from_=\"team-lead\",\n                text=prompt,\n                timestamp=messaging.now_iso(),\n                read=False,\n            )\n            messaging.append_message(team_name, name, initial_msg)\n\n            # Build Claude CLI command\n            cmd = build_spawn_command(member, claude_binary, lead_session_id)\n\n            # Snapshot pane IDs before spawn\n            before_ids = KeepAliveManager._get_tmux_pane_ids()\n\n            # Spawn in tmux — don't use -F (broken on MSYS2 tmux)\n            subprocess.run(\n                [\"tmux\", \"split-window\", \"-d\", cmd],\n                capture_output=True,\n                text=True,\n                check=True,\n                timeout=10,\n            )\n\n            # Find the new pane by diffing before/after\n            after_ids = KeepAliveManager._get_tmux_pane_ids()\n            new_ids = after_ids - before_ids\n            if not new_ids:\n                raise RuntimeError(\"tmux split-window succeeded but no new pane found\")\n            pane_id = new_ids.pop()\n\n            # Update member config with actual pane ID\n            config = teams.read_config(team_name)\n            for m in config.members:\n                if isinstance(m, TeammateMember) and m.name == name:\n                    m.tmux_pane_id = pane_id\n                    break\n            teams.write_config(team_name, config)\n\n            return pane_id\n\n        except Exception:\n            if member_added:\n                try:\n                    teams.remove_member(team_name, name)\n                except Exception:\n                    pass\n            raise\n\n    @staticmethod\n    def _is_pane_alive(pane_id: str) -> bool:\n        \"\"\"Check if a tmux pane is alive using its identifier.\"\"\"\n        if not pane_id:\n            return False\n        try:\n            # Works with both session:window.pane and %N formats\n            result = subprocess.run(\n                [\"tmux\", \"list-panes\", \"-t\", pane_id],\n                capture_output=True, timeout=5,\n            )\n            return result.returncode == 0\n        except (subprocess.TimeoutExpired, FileNotFoundError):\n            return False\n\n    @staticmethod\n    def _ensure_tmux_session() -> None:\n        \"\"\"Create a detached tmux session if no tmux server is running.\"\"\"\n        try:\n            result = subprocess.run(\n                [\"tmux\", \"list-sessions\"],\n                capture_output=True, timeout=5,\n            )\n            if result.returncode == 0:\n                return  # tmux server already running\n        except (subprocess.TimeoutExpired, FileNotFoundError):\n            pass\n\n        subprocess.run(\n            [\"tmux\", \"new-session\", \"-d\", \"-s\", \"vista-host\"],\n            capture_output=True, check=True, timeout=5,\n        )\n\n    @staticmethod\n    def _force_delete_team(team_name: str) -> None:\n        \"\"\"Force-remove team and task directories.\"\"\"\n        team_dir = TEAMS_DIR / team_name\n        task_dir = TASKS_DIR / team_name\n        if team_dir.exists():\n            shutil.rmtree(team_dir, ignore_errors=True)\n        if task_dir.exists():\n            shutil.rmtree(task_dir, ignore_errors=True)\n\n\n# Singleton instance\nkeepalive_manager = KeepAliveManager()\n","numLines":470,"startLine":1,"totalLines":470}}}
