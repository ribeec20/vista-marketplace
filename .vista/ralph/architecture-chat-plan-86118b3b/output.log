{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0196fYMd89z1uHeiKAvwEB7g","type":"tool_result","content":"     1→import { Hono } from \"hono\";\n     2→import { execSync } from \"node:child_process\";\n     3→import { readdir, readFile, writeFile, stat } from \"node:fs/promises\";\n     4→import { resolve, join, dirname } from \"node:path\";\n     5→import { homedir } from \"node:os\";\n     6→import { existsSync, readFileSync } from \"node:fs\";\n     7→import type { CliLauncher } from \"./cli-launcher.js\";\n     8→import type { WsBridge } from \"./ws-bridge.js\";\n     9→import type { SessionStore } from \"./session-store.js\";\n    10→import type { WorktreeTracker } from \"./worktree-tracker.js\";\n    11→import * as envManager from \"./env-manager.js\";\n    12→import * as gitUtils from \"./git-utils.js\";\n    13→import * as sessionNames from \"./session-names.js\";\n    14→import { containerManager, type ContainerConfig, type ContainerInfo } from \"./container-manager.js\";\n    15→import { DEFAULT_OPENROUTER_MODEL, getSettings, updateSettings } from \"./settings-manager.js\";\n    16→import { getUsageLimits } from \"./usage-limits.js\";\n    17→import {\n    18→  getUpdateState,\n    19→  checkForUpdate,\n    20→  isUpdateAvailable,\n    21→  setUpdateInProgress,\n    22→} from \"./update-checker.js\";\n    23→\n    24→function execCaptureStdout(\n    25→  command: string,\n    26→  options: { cwd: string; encoding: \"utf-8\"; timeout: number },\n    27→): string {\n    28→  try {\n    29→    return execSync(command, options);\n    30→  } catch (err: unknown) {\n    31→    const maybe = err as { stdout?: Buffer | string };\n    32→    if (typeof maybe.stdout === \"string\") return maybe.stdout;\n    33→    if (maybe.stdout && Buffer.isBuffer(maybe.stdout)) {\n    34→      return maybe.stdout.toString(\"utf-8\");\n    35→    }\n    36→    throw err;\n    37→  }\n    38→}\n    39→\n    40→export function createRoutes(\n    41→  launcher: CliLauncher,\n    42→  wsBridge: WsBridge,\n    43→  sessionStore: SessionStore,\n    44→  worktreeTracker: WorktreeTracker,\n    45→) {\n    46→  const api = new Hono();\n    47→\n    48→  // ─── SDK Sessions (--sdk-url) ─────────────────────────────────────\n    49→\n    50→  api.post(\"/sessions/create\", async (c) => {\n    51→    const body = await c.req.json().catch(() => ({}));\n    52→    try {\n    53→      const backend = body.backend ?? \"claude\";\n    54→      if (backend !== \"claude\" && backend !== \"codex\") {\n    55→        return c.json({ error: `Invalid backend: ${String(backend)}` }, 400);\n    56→      }\n    57→\n    58→      // Resolve environment variables from envSlug\n    59→      let envVars: Record<string, string> | undefined = body.env;\n    60→      if (body.envSlug) {\n    61→        const companionEnv = envManager.getEnv(body.envSlug);\n    62→        if (companionEnv) {\n    63→          console.log(\n    64→            `[routes] Injecting env \"${companionEnv.name}\" (${Object.keys(companionEnv.variables).length} vars):`,\n    65→            Object.keys(companionEnv.variables).join(\", \"),\n    66→          );\n    67→          envVars = { ...companionEnv.variables, ...body.env };\n    68→        } else {\n    69→          console.warn(\n    70→            `[routes] Environment \"${body.envSlug}\" not found, ignoring`,\n    71→          );\n    72→        }\n    73→      }\n    74→\n    75→      let cwd = body.cwd;\n    76→      let worktreeInfo:\n    77→        | {\n    78→            isWorktree: boolean;\n    79→            repoRoot: string;\n    80→            branch: string;\n    81→            actualBranch: string;\n    82→            worktreePath: string;\n    83→          }\n    84→        | undefined;\n    85→\n    86→      // If worktree is requested, set up a worktree for the selected branch\n    87→      if (body.useWorktree && body.branch && cwd) {\n    88→        const repoInfo = gitUtils.getRepoInfo(cwd);\n    89→        if (repoInfo) {\n    90→          const result = gitUtils.ensureWorktree(\n    91→            repoInfo.repoRoot,\n    92→            body.branch,\n    93→            {\n    94→              baseBranch: repoInfo.defaultBranch,\n    95→              createBranch: body.createBranch,\n    96→              forceNew: true,\n    97→            },\n    98→          );\n    99→          cwd = result.worktreePath;\n   100→          worktreeInfo = {\n   101→            isWorktree: true,\n   102→            repoRoot: repoInfo.repoRoot,\n   103→            branch: body.branch,\n   104→            actualBranch: result.actualBranch,\n   105→            worktreePath: result.worktreePath,\n   106→          };\n   107→        }\n   108→      } else if (body.branch && cwd) {\n   109→        // Non-worktree: checkout the selected branch in-place\n   110→        const repoInfo = gitUtils.getRepoInfo(cwd);\n   111→        if (repoInfo) {\n   112→          const fetchResult = gitUtils.gitFetch(repoInfo.repoRoot);\n   113→          if (!fetchResult.success) {\n   114→            throw new Error(`git fetch failed before session create: ${fetchResult.output}`);\n   115→          }\n   116→\n   117→          if (repoInfo.currentBranch !== body.branch) {\n   118→            gitUtils.checkoutBranch(repoInfo.repoRoot, body.branch);\n   119→          }\n   120→"}]},"parent_tool_use_id":null,"session_id":"615fcba1-13a5-40a3-839d-703775331047","uuid":"00819639-340e-4a14-87d3-afec19b06708","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/companion/web/server/routes.ts","content":"import { Hono } from \"hono\";\nimport { execSync } from \"node:child_process\";\nimport { readdir, readFile, writeFile, stat } from \"node:fs/promises\";\nimport { resolve, join, dirname } from \"node:path\";\nimport { homedir } from \"node:os\";\nimport { existsSync, readFileSync } from \"node:fs\";\nimport type { CliLauncher } from \"./cli-launcher.js\";\nimport type { WsBridge } from \"./ws-bridge.js\";\nimport type { SessionStore } from \"./session-store.js\";\nimport type { WorktreeTracker } from \"./worktree-tracker.js\";\nimport * as envManager from \"./env-manager.js\";\nimport * as gitUtils from \"./git-utils.js\";\nimport * as sessionNames from \"./session-names.js\";\nimport { containerManager, type ContainerConfig, type ContainerInfo } from \"./container-manager.js\";\nimport { DEFAULT_OPENROUTER_MODEL, getSettings, updateSettings } from \"./settings-manager.js\";\nimport { getUsageLimits } from \"./usage-limits.js\";\nimport {\n  getUpdateState,\n  checkForUpdate,\n  isUpdateAvailable,\n  setUpdateInProgress,\n} from \"./update-checker.js\";\n\nfunction execCaptureStdout(\n  command: string,\n  options: { cwd: string; encoding: \"utf-8\"; timeout: number },\n): string {\n  try {\n    return execSync(command, options);\n  } catch (err: unknown) {\n    const maybe = err as { stdout?: Buffer | string };\n    if (typeof maybe.stdout === \"string\") return maybe.stdout;\n    if (maybe.stdout && Buffer.isBuffer(maybe.stdout)) {\n      return maybe.stdout.toString(\"utf-8\");\n    }\n    throw err;\n  }\n}\n\nexport function createRoutes(\n  launcher: CliLauncher,\n  wsBridge: WsBridge,\n  sessionStore: SessionStore,\n  worktreeTracker: WorktreeTracker,\n) {\n  const api = new Hono();\n\n  // ─── SDK Sessions (--sdk-url) ─────────────────────────────────────\n\n  api.post(\"/sessions/create\", async (c) => {\n    const body = await c.req.json().catch(() => ({}));\n    try {\n      const backend = body.backend ?? \"claude\";\n      if (backend !== \"claude\" && backend !== \"codex\") {\n        return c.json({ error: `Invalid backend: ${String(backend)}` }, 400);\n      }\n\n      // Resolve environment variables from envSlug\n      let envVars: Record<string, string> | undefined = body.env;\n      if (body.envSlug) {\n        const companionEnv = envManager.getEnv(body.envSlug);\n        if (companionEnv) {\n          console.log(\n            `[routes] Injecting env \"${companionEnv.name}\" (${Object.keys(companionEnv.variables).length} vars):`,\n            Object.keys(companionEnv.variables).join(\", \"),\n          );\n          envVars = { ...companionEnv.variables, ...body.env };\n        } else {\n          console.warn(\n            `[routes] Environment \"${body.envSlug}\" not found, ignoring`,\n          );\n        }\n      }\n\n      let cwd = body.cwd;\n      let worktreeInfo:\n        | {\n            isWorktree: boolean;\n            repoRoot: string;\n            branch: string;\n            actualBranch: string;\n            worktreePath: string;\n          }\n        | undefined;\n\n      // If worktree is requested, set up a worktree for the selected branch\n      if (body.useWorktree && body.branch && cwd) {\n        const repoInfo = gitUtils.getRepoInfo(cwd);\n        if (repoInfo) {\n          const result = gitUtils.ensureWorktree(\n            repoInfo.repoRoot,\n            body.branch,\n            {\n              baseBranch: repoInfo.defaultBranch,\n              createBranch: body.createBranch,\n              forceNew: true,\n            },\n          );\n          cwd = result.worktreePath;\n          worktreeInfo = {\n            isWorktree: true,\n            repoRoot: repoInfo.repoRoot,\n            branch: body.branch,\n            actualBranch: result.actualBranch,\n            worktreePath: result.worktreePath,\n          };\n        }\n      } else if (body.branch && cwd) {\n        // Non-worktree: checkout the selected branch in-place\n        const repoInfo = gitUtils.getRepoInfo(cwd);\n        if (repoInfo) {\n          const fetchResult = gitUtils.gitFetch(repoInfo.repoRoot);\n          if (!fetchResult.success) {\n            throw new Error(`git fetch failed before session create: ${fetchResult.output}`);\n          }\n\n          if (repoInfo.currentBranch !== body.branch) {\n            gitUtils.checkoutBranch(repoInfo.repoRoot, body.branch);\n          }\n","numLines":120,"startLine":1,"totalLines":940}}}
