{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NpsnZxT6aE1pTG2VDjX8ot","type":"tool_result","content":"     1→\"\"\"Vista MCP Server - launches the FastAPI dashboard as a daemon thread.\n     2→\n     3→Claude Code starts this process via .mcp.json (stdio transport).\n     4→The web dashboard runs as a daemon thread inside the same process,\n     5→modeled on Serena's dashboard.py:run_in_thread() pattern.\n     6→\n     7→Uses fastmcp 3.x (same as claude-code-teams-mcp) for proper Context\n     8→injection, ToolError handling, and middleware support.\n     9→\"\"\"\n    10→\n    11→import asyncio\n    12→import json\n    13→import logging\n    14→import os\n    15→import socket\n    16→import subprocess\n    17→import sys\n    18→import threading\n    19→import time\n    20→import uuid\n    21→from datetime import datetime, timezone\n    22→from pathlib import Path\n    23→from types import SimpleNamespace\n    24→from typing import Any, Literal\n    25→\n    26→# Ensure vista/ is on sys.path so `from server.*` imports resolve\n    27→PLUGIN_ROOT = Path(__file__).resolve().parent\n    28→sys.path.insert(0, str(PLUGIN_ROOT))\n    29→sys.path.insert(0, str(PLUGIN_ROOT / \"vendor\"))\n    30→\n    31→from server.config import ensure_full_path, get_server_settings  # noqa: E402\n    32→\n    33→ensure_full_path()\n    34→\n    35→from fastmcp import Context, FastMCP  # noqa: E402\n    36→from fastmcp.exceptions import ToolError  # noqa: E402\n    37→from fastmcp.server.lifespan import lifespan  # noqa: E402\n    38→from fastmcp.server.middleware import Middleware  # noqa: E402\n    39→\n    40→from claude_teams import messaging, opencode_client, tasks, teams  # noqa: E402\n    41→from claude_teams.models import (  # noqa: E402\n    42→    SendMessageResult,\n    43→    ShutdownApproved,\n    44→    SpawnResult,\n    45→    TeammateMember,\n    46→)\n    47→from claude_teams.opencode_client import OpenCodeAPIError  # noqa: E402\n    48→from claude_teams.spawner import (  # noqa: E402\n    49→    discover_harness_binary,\n    50→    discover_opencode_models,\n    51→    kill_tmux_pane,\n    52→    spawn_teammate,\n    53→    use_tmux_windows,\n    54→)\n    55→\n    56→logger = logging.getLogger(__name__)\n    57→\n    58→# ---------------------------------------------------------------------------\n    59→# Harness / client detection (mirrors claude-code-teams-mcp)\n    60→# ---------------------------------------------------------------------------\n    61→KNOWN_CLIENTS: dict[str, str] = {\n    62→    \"claude-code\": \"claude\",\n    63→    \"claude\": \"claude\",\n    64→    \"opencode\": \"opencode\",\n    65→}\n    66→\n    67→_VALID_BACKENDS = frozenset(KNOWN_CLIENTS.values())\n    68→\n    69→# NOTE: Mutated by both app_lifespan and HarnessDetectionMiddleware.\n    70→# Safe under stdio (single session).\n    71→_lifespan_state: dict[str, Any] = {}\n    72→\n    73→# Reference to the spawn_teammate tool for dynamic description updates\n    74→_spawn_tool: Any = None\n    75→\n    76→\n    77→# ---------------------------------------------------------------------------\n    78→# Dashboard thread\n    79→# ---------------------------------------------------------------------------\n    80→def _find_free_port(preferred: int, host: str) -> int:\n    81→    port = preferred\n    82→    while port <= 65535:\n    83→        try:\n    84→            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:\n    85→                sock.bind((host, port))\n    86→                return port\n    87→        except OSError:\n    88→            port += 1\n    89→    raise RuntimeError(f\"No free ports found starting from {preferred}\")\n    90→\n    91→\n    92→def _run_uvicorn_in_thread(host: str, port: int) -> threading.Thread:\n    93→    import uvicorn\n    94→\n    95→    from server.app import app\n    96→\n    97→    config = uvicorn.Config(app, host=host, port=port, log_level=\"warning\")\n    98→    server = uvicorn.Server(config)\n    99→    thread = threading.Thread(target=server.run, daemon=True)\n   100→    thread.start()\n   101→    return thread\n   102→\n   103→\n   104→# ---------------------------------------------------------------------------\n   105→# Backend helpers\n   106→# ---------------------------------------------------------------------------\n   107→def _parse_backends_env(raw: str) -> list[str]:\n   108→    if not raw:\n   109→        return []\n   110→    return list(dict.fromkeys(\n   111→        b.strip() for b in raw.split(\",\")\n   112→        if b.strip() and b.strip() in _VALID_BACKENDS\n   113→    ))\n   114→\n   115→\n   116→def _start_opencode_serve(\n   117→    opencode_binary: str, preferred_port: int\n   118→) -> tuple[subprocess.Popen, str]:\n   119→    import urllib.request\n   120→\n   121→    port = _find_free_port(preferred_port, \"127.0.0.1\")\n   122→    proc = subprocess.Popen(\n   123→        [opencode_binary, \"serve\", \"--port\", str(port)],\n   124→        stdin=subprocess.DEVNULL,\n   125→        stdout=subprocess.DEVNULL,\n   126→        stderr=subprocess.DEVNULL,\n   127→    )\n   128→    url = f\"http://127.0.0.1:{port}\"\n   129→\n   130→    for _ in range(50):\n   131→        if proc.poll() is not None:\n   132→            raise RuntimeError(\n   133→                f\"opencode serve exited with code {proc.returncode}\"\n   134→            )\n   135→        try:\n   136→            urllib.request.urlopen(f\"{url}/agent\", timeout=1)\n   137→            return proc, url\n   138→        except Exception:\n   139→            time.sleep(0.2)\n   140→\n   141→    proc.terminate()\n   142→    raise RuntimeError(\n   143→        f\"opencode serve failed to respond on port {port} within 10s\"\n   144→    )\n   145→\n   146→\n   147→# ---------------------------------------------------------------------------\n   148→# Spawn tool description builder (mirrors reference)\n   149→# ---------------------------------------------------------------------------\n   150→_SPAWN_TOOL_BASE_DESCRIPTION = (\n   151→    \"Spawn a new teammate in a tmux {target}. The teammate receives its initial \"\n   152→    \"prompt via inbox and begins working autonomously. Names must be unique \"\n   153→    \"within the team.\"\n   154→)\n   155→\n   156→\n   157→def _build_spawn_description(\n   158→    claude_binary: str | None,\n   159→    opencode_binary: str | None,\n   160→    opencode_models: list[str],\n   161→    opencode_server_url: str | None = None,\n   162→    opencode_agents: list[dict] | None = None,\n   163→    enabled_backends: list[str] | None = None,\n   164→) -> str:\n   165→    tmux_target = \"window\" if use_tmux_windows() else \"pane\"\n   166→    parts = [_SPAWN_TOOL_BASE_DESCRIPTION.format(target=tmux_target)]\n   167→    backends = []\n   168→    show_claude = claude_binary is not None\n   169→    show_opencode = (\n   170→        opencode_binary is not None and opencode_server_url is not None\n   171→    )\n   172→    if enabled_backends is not None:\n   173→        show_claude = show_claude and \"claude\" in enabled_backends\n   174→        show_opencode = show_opencode and \"opencode\" in enabled_backends\n   175→    if show_claude:\n   176→        backends.append(\"'claude' (default, models: sonnet, opus, haiku)\")\n   177→    if show_opencode:\n   178→        model_list = (\n   179→            \", \".join(opencode_models) if opencode_models else \"none discovered\"\n   180→        )\n   181→        backends.append(f\"'opencode' (models: {model_list})\")\n   182→    if backends:\n   183→        parts.append(f\"Available backends: {'; '.join(backends)}.\")\n   184→    if show_opencode and opencode_agents:\n   185→        agent_lines = [\n   186→            f\"  - {a['name']}: {a['description']}\" for a in opencode_agents\n   187→        ]\n   188→        parts.append(\n   189→            \"Available opencode agents (pass as subagent_type when \"\n   190→            \"backend_type='opencode'):\\n\" + \"\\n\".join(agent_lines)\n   191→        )\n   192→    return \" \".join(parts)\n   193→\n   194→\n   195→def _update_spawn_tool(\n   196→    tool: Any, enabled: list[str], state: dict[str, Any]\n   197→) -> None:\n   198→    tool.parameters[\"properties\"][\"backend_type\"][\"enum\"] = list(enabled)\n   199→    if enabled:\n   200→        tool.parameters[\"properties\"][\"backend_type\"][\"default\"] = enabled[0]\n   201→    tool.description = _build_spawn_description(\n   202→        state.get(\"claude_binary\"),\n   203→        state.get(\"opencode_binary\"),\n   204→        state.get(\"opencode_models\", []),\n   205→        state.get(\"opencode_server_url\"),\n   206→        state.get(\"opencode_agents\"),\n   207→        enabled_backends=enabled,\n   208→    )\n   209→\n   210→\n   211→# ---------------------------------------------------------------------------\n   212→# Helpers shared by tool handlers\n   213→# ---------------------------------------------------------------------------\n   214→def _get_lifespan(ctx: Context) -> dict[str, Any]:\n   215→    return ctx.lifespan_context\n   216→\n   217→\n   218→def _find_teammate(team_name: str, name: str) -> TeammateMember | None:\n   219→    config = teams.read_config(team_name)\n   220→    for m in config.members:\n   221→        if isinstance(m, TeammateMember) and m.name == name:\n   222→            return m\n   223→    return None\n   224→\n   225→\n   226→def _push_to_opencode_session(\n   227→    server_url: str, member: TeammateMember, text: str\n   228→) -> None:\n   229→    if (\n   230→        member.backend_type != \"opencode\"\n   231→        or not member.opencode_session_id\n   232→        or not server_url\n   233→    ):\n   234→        return\n   235→    try:\n   236→        opencode_client.send_prompt_async(\n   237→            server_url, member.opencode_session_id, text\n   238→        )\n   239→    except OpenCodeAPIError:\n   240→        logger.warning(\n   241→            \"Failed to push message to opencode session %s\",\n   242→            member.opencode_session_id,\n   243→        )\n   244→\n   245→\n   246→def _cleanup_opencode_session(\n   247→    server_url: str | None, session_id: str | None\n   248→) -> None:\n   249→    if not server_url or not session_id:\n   250→        return\n   251→    try:\n   252→        opencode_client.abort_session(server_url, session_id)\n   253→    except OpenCodeAPIError:\n   254→        logger.warning(\"Failed to abort opencode session %s\", session_id)\n   255→    try:\n   256→        opencode_client.delete_session(server_url, session_id)\n   257→    except OpenCodeAPIError:\n   258→        logger.warning(\"Failed to delete opencode session %s\", session_id)\n   259→\n   260→\n   261→# ---------------------------------------------------------------------------\n   262→# Lifespan\n   263→# ---------------------------------------------------------------------------\n   264→@lifespan\n   265→async def app_lifespan(server):\n   266→    global _spawn_tool\n   267→\n   268→    # -- Start dashboard thread -----------------------------------------------\n   269→    settings = get_server_settings()\n   270→    host = settings[\"host\"]\n   271→    preferred_port = settings[\"port\"]\n   272→    port = _find_free_port(preferred_port, host)\n   273→    _run_uvicorn_in_thread(host, port)\n   274→\n   275→    dashboard_host = host if host != \"0.0.0.0\" else \"localhost\"\n   276→    url = f\"http://{dashboard_host}:{port}\"\n   277→    print(f\"Vista dashboard started at {url}\", file=sys.stderr)\n   278→\n   279→    if settings.get(\"auto_open_browser\", True):\n   280→        subprocess.Popen(\n   281→            [sys.executable, \"-c\", f\"import webbrowser; webbrowser.open({url!r})\"],\n   282→            stdin=subprocess.DEVNULL,\n   283→            stdout=subprocess.DEVNULL,\n   284→            stderr=subprocess.DEVNULL,\n   285→        )\n   286→\n   287→    # -- Discover backends (mirrors claude-code-teams-mcp) --------------------\n   288→    from server.config import get_tools_settings\n   289→\n   290→    tools_settings = get_tools_settings()\n   291→    teams_settings = tools_settings.get(\"teams\", {})\n   292→\n   293→    claude_binary = (\n   294→        teams_settings.get(\"claude_binary\")\n   295→        or discover_harness_binary(\"claude\")\n   296→    )\n   297→    opencode_binary = discover_harness_binary(\"opencode\")\n   298→    opencode_url = (\n   299→        teams_settings.get(\"opencode_url\")\n   300→        or os.environ.get(\"OPENCODE_SERVER_URL\")\n   301→    )\n   302→\n   303→    # Auto-start opencode serve if binary found but no URL configured\n   304→    opencode_process = None\n   305→    if (\n   306→        opencode_binary\n   307→        and not opencode_url\n   308→        and teams_settings.get(\"opencode_auto_start\", True)\n   309→    ):\n   310→        try:\n   311→            preferred_oc_port = teams_settings.get(\"opencode_port\", 4200)\n   312→            opencode_process, opencode_url = _start_opencode_serve(\n   313→                opencode_binary, preferred_oc_port\n   314→            )\n   315→            logger.info(\n   316→                \"Auto-started opencode serve at %s (pid %d)\",\n   317→                opencode_url, opencode_process.pid,\n   318→            )\n   319→        except Exception as e:\n   320→            logger.warning(\"Failed to auto-start opencode serve: %s\", e)\n   321→\n   322→    opencode_models: list[str] = []\n   323→    opencode_agents: list[dict] = []\n   324→    if opencode_binary:\n   325→        try:\n   326→            opencode_models = discover_opencode_models(opencode_binary)\n   327→        except Exception:\n   328→            pass\n   329→    if opencode_url:\n   330→        try:\n   331→            opencode_agents = opencode_client.list_agents(opencode_url)\n   332→        except Exception:\n   333→            logger.warning(\"Failed to fetch opencode agents from %s\", opencode_url)\n   334→\n   335→    enabled_backends = _parse_backends_env(\n   336→        os.environ.get(\"CLAUDE_TEAMS_BACKENDS\", \"\")\n   337→    )\n   338→    if \"opencode\" in enabled_backends and not opencode_url:\n   339→        enabled_backends.remove(\"opencode\")\n   340→\n   341→    session_id = str(uuid.uuid4())\n   342→\n   343→    _lifespan_state.clear()\n   344→    _lifespan_state.update({\n   345→        \"claude_binary\": claude_binary,\n   346→        \"opencode_binary\": opencode_binary,\n   347→        \"opencode_server_url\": opencode_url,\n   348→        \"opencode_agents\": opencode_agents,\n   349→        \"opencode_models\": opencode_models,\n   350→        \"enabled_backends\": enabled_backends,\n   351→        \"opencode_process\": opencode_process,\n   352→        \"session_id\": session_id,\n   353→        \"active_team\": None,\n   354→        \"client_name\": \"unknown\",\n   355→        \"client_version\": \"unknown\",\n   356→    })\n   357→\n   358→    # -- Update spawn_teammate tool description -------------------------------\n   359→    try:\n   360→        tool = await mcp.get_tool(\"spawn_teammate\")\n   361→        _spawn_tool = tool\n   362→        if enabled_backends:\n   363→            _update_spawn_tool(tool, enabled_backends, _lifespan_state)\n   364→    except Exception:\n   365→        pass\n   366→\n   367→    yield _lifespan_state\n   368→\n   369→    # -- Cleanup --------------------------------------------------------------\n   370→    if opencode_process and opencode_process.poll() is None:\n   371→        logger.info(\n   372→            \"Terminating auto-started opencode serve (pid %d)\",\n   373→            opencode_process.pid,\n   374→        )\n   375→        opencode_process.terminate()\n   376→        try:\n   377→            opencode_process.wait(timeout=5)\n   378→        except subprocess.TimeoutExpired:\n   379→            opencode_process.kill()\n   380→\n   381→    print(\"Vista MCP server shutting down\", file=sys.stderr)\n   382→\n   383→\n   384→# ---------------------------------------------------------------------------\n   385→# Middleware: auto-detect connected client and enable backends\n   386→# ---------------------------------------------------------------------------\n   387→class HarnessDetectionMiddleware(Middleware):\n   388→    async def on_initialize(self, context, call_next):\n   389→        _unknown = SimpleNamespace(name=\"unknown\", version=\"unknown\")\n   390→        client_info = context.message.params.clientInfo or _unknown\n   391→        client_name = client_info.name\n   392→        client_version = client_info.version\n   393→\n   394→        result = await call_next(context)\n   395→\n   396→        logger.info(\"MCP client connected: %s v%s\", client_name, client_version)\n   397→\n   398→        native_backend = KNOWN_CLIENTS.get(client_name)\n   399→        enabled = _lifespan_state.get(\"enabled_backends\", [])\n   400→\n   401→        if native_backend and native_backend not in enabled:\n   402→            if native_backend == \"claude\" or _lifespan_state.get(\n   403→                \"opencode_server_url\"\n   404→            ):\n   405→                enabled.append(native_backend)\n   406→\n   407→        if not enabled:\n   408→            if _lifespan_state.get(\"claude_binary\"):\n   409→                enabled.append(\"claude\")\n   410→            if _lifespan_state.get(\"opencode_binary\") and _lifespan_state.get(\n   411→                \"opencode_server_url\"\n   412→            ):\n   413→                enabled.append(\"opencode\")\n   414→\n   415→        _lifespan_state[\"enabled_backends\"] = enabled\n   416→        _lifespan_state[\"client_name\"] = client_name\n   417→        _lifespan_state[\"client_version\"] = client_version\n   418→\n   419→        if _spawn_tool:\n   420→            _update_spawn_tool(_spawn_tool, enabled, _lifespan_state)\n   421→\n   422→        return result\n   423→\n   424→\n   425→# ---------------------------------------------------------------------------\n   426→# FastMCP server\n   427→# ---------------------------------------------------------------------------\n   428→mcp = FastMCP(\n   429→    name=\"vista-dashboard\",\n   430→    instructions=(\n   431→        \"MCP server for the Vista development dashboard. \"\n   432→        \"Manages team creation, teammate spawning, messaging, task tracking, \"\n   433→        \"and ralph planning/build loops.\"\n   434→    ),\n   435→    lifespan=app_lifespan,\n   436→)\n   437→mcp.add_middleware(HarnessDetectionMiddleware())\n   438→\n   439→\n   440→# # ===========================================================================\n   441→# # Teams tools (13 tools — mirrors claude-code-teams-mcp reference)\n   442→# # ===========================================================================\n   443→\n   444→# @mcp.tool\n   445→# def team_create(\n   446→#     team_name: str,\n   447→#     ctx: Context,\n   448→#     description: str = \"\",\n   449→# ) -> dict:\n   450→#     \"\"\"Create a new agent team. Sets up config and task directories under ~/.claude/.\n   451→#     One team per server session. Names must be filesystem-safe\n   452→#     (letters, numbers, hyphens, underscores).\"\"\"\n   453→#     ls = _get_lifespan(ctx)\n   454→#     if ls.get(\"active_team\"):\n   455→#         raise ToolError(\n   456→#             f\"Session already has active team: {ls['active_team']}. \"\n   457→#             \"One team per session.\"\n   458→#         )\n   459→#     result = teams.create_team(\n   460→#         name=team_name,\n   461→#         session_id=ls[\"session_id\"],\n   462→#         description=description,\n   463→#     )\n   464→#     ls[\"active_team\"] = team_name\n   465→#     return result.model_dump()\n   466→\n   467→\n   468→# @mcp.tool\n   469→# def team_delete(team_name: str, ctx: Context) -> dict:\n   470→#     \"\"\"Delete a team and all its data. Fails if any teammates are still active.\n   471→#     Removes both team config and task directories.\"\"\"\n   472→#     try:\n   473→#         result = teams.delete_team(team_name)\n   474→#     except (RuntimeError, FileNotFoundError) as e:\n   475→#         raise ToolError(str(e))\n   476→#     _get_lifespan(ctx)[\"active_team\"] = None\n   477→#     return result.model_dump()\n   478→\n   479→\n   480→# @mcp.tool(name=\"spawn_teammate\")\n   481→# def spawn_teammate_tool(\n   482→#     team_name: str,\n   483→#     name: str,\n   484→#     prompt: str,\n   485→#     ctx: Context,\n   486→#     model: str = \"sonnet\",\n   487→#     subagent_type: str = \"general-purpose\",\n   488→#     plan_mode_required: bool = False,\n   489→#     backend_type: Literal[\"claude\", \"opencode\"] = \"claude\",\n   490→# ) -> dict:\n   491→#     \"\"\"Spawn a new teammate in tmux. Description is dynamically updated\n   492→#     at startup with available backends and models.\"\"\"\n   493→#     ls = _get_lifespan(ctx)\n   494→#     enabled = ls.get(\"enabled_backends\", [])\n   495→#     if enabled and backend_type not in enabled:\n   496→#         raise ToolError(\n   497→#             f\"Backend {backend_type!r} is not enabled. Enabled: {enabled}\"\n   498→#         )\n   499→\n   500→#     opencode_agent = None\n   501→#     if backend_type == \"opencode\":\n   502→#         known = {a[\"name\"] for a in ls.get(\"opencode_agents\", [])}\n   503→#         opencode_agent = subagent_type if subagent_type in known else \"build\"\n   504→\n   505→#     try:\n   506→#         member = spawn_teammate(\n   507→#             team_name=team_name,\n   508→#             name=name,\n   509→#             prompt=prompt,\n   510→#             claude_binary=ls[\"claude_binary\"],\n   511→#             lead_session_id=ls[\"session_id\"],\n   512→#             model=model,\n   513→#             subagent_type=subagent_type,\n   514→#             plan_mode_required=plan_mode_required,\n   515→#             backend_type=backend_type,\n   516→#             opencode_binary=ls[\"opencode_binary\"],\n   517→#             opencode_server_url=ls[\"opencode_server_url\"],\n   518→#             opencode_agent=opencode_agent,\n   519→#         )\n   520→#     except (ValueError, OpenCodeAPIError) as e:\n   521→#         raise ToolError(str(e))\n   522→\n   523→#     return SpawnResult(\n   524→#         agent_id=member.agent_id,\n   525→#         name=member.name,\n   526→#         team_name=team_name,\n   527→#     ).model_dump()\n   528→\n   529→\n   530→# @mcp.tool\n   531→# def send_message(\n   532→#     team_name: str,\n   533→#     type: Literal[\n   534→#         \"message\",\n   535→#         \"broadcast\",\n   536→#         \"shutdown_request\",\n   537→#         \"shutdown_response\",\n   538→#         \"plan_approval_response\",\n   539→#     ],\n   540→#     ctx: Context,\n   541→#     recipient: str = \"\",\n   542→#     content: str = \"\",\n   543→#     summary: str = \"\",\n   544→#     request_id: str = \"\",\n   545→#     approve: bool | None = None,\n   546→#     sender: str = \"team-lead\",\n   547→# ) -> dict:\n   548→#     \"\"\"Send a message to a teammate or respond to a protocol request.\n   549→#     Type 'message' sends a DM (requires recipient, summary).\n   550→#     Type 'broadcast' sends to all teammates (requires summary).\n   551→#     Type 'shutdown_request' asks a teammate to shut down (requires recipient).\n   552→#     Type 'shutdown_response' responds to a shutdown request (requires sender, request_id, approve).\n   553→#     Type 'plan_approval_response' approves/rejects a plan (requires recipient, request_id, approve).\"\"\"\n   554→#     oc_url = _get_lifespan(ctx).get(\"opencode_server_url\")\n   555→\n   556→#     try:\n   557→#         teams.read_config(team_name)\n   558→#     except FileNotFoundError:\n   559→#         raise ToolError(f\"Team {team_name!r} not found\")\n   560→\n   561→#     if type == \"message\":\n   562→#         if not content:\n   563→#             raise ToolError(\"Message content must not be empty\")\n   564→#         if not summary:\n   565→#             raise ToolError(\"Message summary must not be empty\")\n   566→#         if not recipient:\n   567→#             raise ToolError(\"Message recipient must not be empty\")\n   568→#         config = teams.read_config(team_name)\n   569→#         member_names = {m.name for m in config.members}\n   570→#         if sender not in member_names:\n   571→#             raise ToolError(\n   572→#                 f\"Sender {sender!r} is not a member of team {team_name!r}\"\n   573→#             )\n   574→#         if recipient not in member_names:\n   575→#             raise ToolError(\n   576→#                 f\"Recipient {recipient!r} is not a member of team {team_name!r}\"\n   577→#             )\n   578→#         if sender == recipient:\n   579→#             raise ToolError(\"Cannot send a message to yourself\")\n   580→#         if sender != \"team-lead\" and recipient != \"team-lead\":\n   581→#             raise ToolError(\n   582→#                 \"Teammates can only send direct messages to team-lead\"\n   583→#             )\n   584→\n   585→#         target_color = None\n   586→#         target_member = None\n   587→#         for m in config.members:\n   588→#             if m.name == recipient and isinstance(m, TeammateMember):\n   589→#                 target_color = m.color\n   590→#                 target_member = m\n   591→#                 break\n   592→#         messaging.send_plain_message(\n   593→#             team_name, sender, recipient, content,\n   594→#             summary=summary, color=target_color,\n   595→#         )\n   596→#         if target_member and oc_url:\n   597→#             _push_to_opencode_session(oc_url, target_member, content)\n   598→#         return SendMessageResult(\n   599→#             success=True,\n   600→#             message=f\"Message sent to {recipient}\",\n   601→#             routing={\n   602→#                 \"sender\": sender,\n   603→#                 \"target\": recipient,\n   604→#                 \"targetColor\": target_color,\n   605→#                 \"summary\": summary,\n   606→#                 \"content\": content,\n   607→#             },\n   608→#         ).model_dump(exclude_none=True)\n   609→\n   610→#     elif type == \"broadcast\":\n   611→#         if sender != \"team-lead\":\n   612→#             raise ToolError(\"Only team-lead can send broadcasts\")\n   613→#         if not summary:\n   614→#             raise ToolError(\"Broadcast summary must not be empty\")\n   615→#         config = teams.read_config(team_name)\n   616→#         count = 0\n   617→#         for m in config.members:\n   618→#             if isinstance(m, TeammateMember):\n   619→#                 messaging.send_plain_message(\n   620→#                     team_name, \"team-lead\", m.name, content,\n   621→#                     summary=summary, color=None,\n   622→#                 )\n   623→#                 if oc_url:\n   624→#                     _push_to_opencode_session(oc_url, m, content)\n   625→#                 count += 1\n   626→#         return SendMessageResult(\n   627→#             success=True,\n   628→#             message=f\"Broadcast sent to {count} teammate(s)\",\n   629→#         ).model_dump(exclude_none=True)\n   630→\n   631→#     elif type == \"shutdown_request\":\n   632→#         if not recipient:\n   633→#             raise ToolError(\"Shutdown request recipient must not be empty\")\n   634→#         if recipient == \"team-lead\":\n   635→#             raise ToolError(\"Cannot send shutdown request to team-lead\")\n   636→#         config = teams.read_config(team_name)\n   637→#         member_names = {m.name for m in config.members}\n   638→#         if recipient not in member_names:\n   639→#             raise ToolError(\n   640→#                 f\"Recipient {recipient!r} is not a member of team {team_name!r}\"\n   641→#             )\n   642→#         req_id = messaging.send_shutdown_request(\n   643→#             team_name, recipient, reason=content\n   644→#         )\n   645→#         target_member = _find_teammate(team_name, recipient)\n   646→#         if target_member and oc_url:\n   647→#             _push_to_opencode_session(\n   648→#                 oc_url, target_member,\n   649→#                 json.dumps({\n   650→#                     \"type\": \"shutdown_request\",\n   651→#                     \"requestId\": req_id,\n   652→#                     \"reason\": content,\n   653→#                 }),\n   654→#             )\n   655→#         return SendMessageResult(\n   656→#             success=True,\n   657→#             message=f\"Shutdown request sent to {recipient}\",\n   658→#             request_id=req_id,\n   659→#             target=recipient,\n   660→#         ).model_dump(exclude_none=True)\n   661→\n   662→#     elif type == \"shutdown_response\":\n   663→#         config = teams.read_config(team_name)\n   664→#         member = None\n   665→#         for m in config.members:\n   666→#             if isinstance(m, TeammateMember) and m.name == sender:\n   667→#                 member = m\n   668→#                 break\n   669→#         if member is None:\n   670→#             raise ToolError(\n   671→#                 f\"Sender {sender!r} is not a teammate in team {team_name!r}\"\n   672→#             )\n   673→#         if approve:\n   674→#             payload = ShutdownApproved(\n   675→#                 request_id=request_id,\n   676→#                 from_=sender,\n   677→#                 timestamp=messaging.now_iso(),\n   678→#                 pane_id=member.tmux_pane_id,\n   679→#                 backend_type=member.backend_type,\n   680→#                 session_id=member.opencode_session_id,\n   681→#             )\n   682→#             messaging.send_structured_message(\n   683→#                 team_name, sender, \"team-lead\", payload\n   684→#             )\n   685→#             return SendMessageResult(\n   686→#                 success=True,\n   687→#                 message=f\"Shutdown approved for request {request_id}\",\n   688→#             ).model_dump(exclude_none=True)\n   689→#         else:\n   690→#             messaging.send_plain_message(\n   691→#                 team_name, sender, \"team-lead\",\n   692→#                 content or \"Shutdown rejected\",\n   693→#                 summary=\"shutdown_rejected\",\n   694→#             )\n   695→#             return SendMessageResult(\n   696→#                 success=True,\n   697→#                 message=f\"Shutdown rejected for request {request_id}\",\n   698→#             ).model_dump(exclude_none=True)\n   699→\n   700→#     elif type == \"plan_approval_response\":\n   701→#         if not recipient:\n   702→#             raise ToolError(\"Plan approval recipient must not be empty\")\n   703→#         config = teams.read_config(team_name)\n   704→#         member_names = {m.name for m in config.members}\n   705→#         if recipient not in member_names:\n   706→#             raise ToolError(\n   707→#                 f\"Recipient {recipient!r} is not a member of team {team_name!r}\"\n   708→#             )\n   709→#         if approve:\n   710→#             messaging.send_plain_message(\n   711→#                 team_name, sender, recipient,\n   712→#                 '{\"type\":\"plan_approval\",\"approved\":true}',\n   713→#                 summary=\"plan_approved\",\n   714→#             )\n   715→#         else:\n   716→#             messaging.send_plain_message(\n   717→#                 team_name, sender, recipient,\n   718→#                 content or \"Plan rejected\",\n   719→#                 summary=\"plan_rejected\",\n   720→#             )\n   721→#         return SendMessageResult(\n   722→#             success=True,\n   723→#             message=f\"Plan {'approved' if approve else 'rejected'} for {recipient}\",\n   724→#         ).model_dump(exclude_none=True)\n   725→\n   726→#     raise ToolError(f\"Unknown message type: {type}\")\n   727→\n   728→\n   729→# @mcp.tool\n   730→# def task_create(\n   731→#     team_name: str,\n   732→#     subject: str,\n   733→#     description: str,\n   734→#     active_form: str = \"\",\n   735→#     metadata: dict | None = None,\n   736→# ) -> dict:\n   737→#     \"\"\"Create a new task for the team. Tasks get auto-incrementing IDs.\n   738→#     Optional metadata dict is stored alongside the task.\"\"\"\n   739→#     try:\n   740→#         task = tasks.create_task(\n   741→#             team_name, subject, description, active_form, metadata\n   742→#         )\n   743→#     except ValueError as e:\n   744→#         raise ToolError(str(e))\n   745→#     return task.model_dump(by_alias=True, exclude_none=True)\n   746→\n   747→\n   748→# @mcp.tool\n   749→# def task_update(\n   750→#     team_name: str,\n   751→#     task_id: str,\n   752→#     status: Literal[\"pending\", \"in_progress\", \"completed\", \"deleted\"] | None = None,\n   753→#     owner: str | None = None,\n   754→#     subject: str | None = None,\n   755→#     description: str | None = None,\n   756→#     active_form: str | None = None,\n   757→#     add_blocks: list[str] | None = None,\n   758→#     add_blocked_by: list[str] | None = None,\n   759→#     metadata: dict | None = None,\n   760→# ) -> dict:\n   761→#     \"\"\"Update a task's fields. Setting owner auto-notifies the assignee.\n   762→#     Setting status to 'deleted' removes the task file.\n   763→#     Metadata keys are merged (set a key to null to delete it).\"\"\"\n   764→#     if owner is not None:\n   765→#         try:\n   766→#             config = teams.read_config(team_name)\n   767→#         except FileNotFoundError:\n   768→#             raise ToolError(f\"Team {team_name!r} not found\")\n   769→#         member_names = {m.name for m in config.members}\n   770→#         if owner not in member_names:\n   771→#             raise ToolError(\n   772→#                 f\"Owner {owner!r} is not a member of team {team_name!r}\"\n   773→#             )\n   774→#     try:\n   775→#         task = tasks.update_task(\n   776→#             team_name, task_id,\n   777→#             status=status, owner=owner, subject=subject,\n   778→#             description=description, active_form=active_form,\n   779→#             add_blocks=add_blocks, add_blocked_by=add_blocked_by,\n   780→#             metadata=metadata,\n   781→#         )\n   782→#     except FileNotFoundError:\n   783→#         raise ToolError(f\"Task {task_id!r} not found in team {team_name!r}\")\n   784→#     except ValueError as e:\n   785→#         raise ToolError(str(e))\n   786→#     if owner is not None and task.owner is not None and task.status != \"deleted\":\n   787→#         messaging.send_task_assignment(team_name, task, assigned_by=\"team-lead\")\n   788→#     return task.model_dump(by_alias=True, exclude_none=True)\n   789→\n   790→\n   791→# @mcp.tool\n   792→# def task_list(team_name: str) -> list[dict]:\n   793→#     \"\"\"List all tasks for a team with their current status and assignments.\"\"\"\n   794→#     try:\n   795→#         result = tasks.list_tasks(team_name)\n   796→#     except ValueError as e:\n   797→#         raise ToolError(str(e))\n   798→#     return [t.model_dump(by_alias=True, exclude_none=True) for t in result]\n   799→\n   800→\n   801→# @mcp.tool\n   802→# def task_get(team_name: str, task_id: str) -> dict:\n   803→#     \"\"\"Get full details of a specific task by ID.\"\"\"\n   804→#     try:\n   805→#         task = tasks.get_task(team_name, task_id)\n   806→#     except FileNotFoundError:\n   807→#         raise ToolError(f\"Task {task_id!r} not found in team {team_name!r}\")\n   808→#     return task.model_dump(by_alias=True, exclude_none=True)\n   809→\n   810→\n   811→# @mcp.tool\n   812→# def read_inbox(\n   813→#     team_name: str,\n   814→#     agent_name: str,\n   815→#     unread_only: bool = False,\n   816→#     mark_as_read: bool = True,\n   817→# ) -> list[dict]:\n   818→#     \"\"\"Read messages from an agent's inbox. Returns all messages by default.\n   819→#     Set unread_only=True to get only unprocessed messages.\"\"\"\n   820→#     try:\n   821→#         config = teams.read_config(team_name)\n   822→#     except FileNotFoundError:\n   823→#         raise ToolError(f\"Team {team_name!r} not found\")\n   824→#     member_names = {m.name for m in config.members}\n   825→#     if agent_name not in member_names:\n   826→#         raise ToolError(\n   827→#             f\"Agent {agent_name!r} is not a member of team {team_name!r}\"\n   828→#         )\n   829→#     msgs = messaging.read_inbox(\n   830→#         team_name, agent_name,\n   831→#         unread_only=unread_only, mark_as_read=mark_as_read,\n   832→#     )\n   833→#     return [m.model_dump(by_alias=True, exclude_none=True) for m in msgs]\n   834→\n   835→\n   836→# @mcp.tool\n   837→# async def poll_inbox(\n   838→#     team_name: str,\n   839→#     agent_name: str,\n   840→#     timeout_ms: int = 30000,\n   841→# ) -> list[dict]:\n   842→#     \"\"\"Poll an agent's inbox for new unread messages, waiting up to timeout_ms.\n   843→#     Returns unread messages and marks them as read.\"\"\"\n   844→#     msgs = messaging.read_inbox(\n   845→#         team_name, agent_name, unread_only=True, mark_as_read=True\n   846→#     )\n   847→#     if msgs:\n   848→#         return [m.model_dump(by_alias=True, exclude_none=True) for m in msgs]\n   849→#     deadline = time.time() + timeout_ms / 1000.0\n   850→#     while time.time() < deadline:\n   851→#         await asyncio.sleep(0.5)\n   852→#         msgs = messaging.read_inbox(\n   853→#             team_name, agent_name,\n   854→#             unread_only=True, mark_as_read=True,\n   855→#         )\n   856→#         if msgs:\n   857→#             return [\n   858→#                 m.model_dump(by_alias=True, exclude_none=True) for m in msgs\n   859→#             ]\n   860→#     return []\n   861→\n   862→\n   863→# @mcp.tool\n   864→# def read_config(team_name: str) -> dict:\n   865→#     \"\"\"Read the current team configuration including all members.\"\"\"\n   866→#     try:\n   867→#         config = teams.read_config(team_name)\n   868→#     except FileNotFoundError:\n   869→#         raise ToolError(f\"Team {team_name!r} not found\")\n   870→#     return config.model_dump(by_alias=True)\n   871→\n   872→\n   873→# @mcp.tool\n   874→# def force_kill_teammate(\n   875→#     team_name: str, agent_name: str, ctx: Context\n   876→# ) -> dict:\n   877→#     \"\"\"Forcibly kill a teammate's tmux pane. Use when graceful shutdown\n   878→#     is not possible. Kills the pane, removes member from config,\n   879→#     and resets their tasks.\"\"\"\n   880→#     oc_url = _get_lifespan(ctx).get(\"opencode_server_url\")\n   881→#     config = teams.read_config(team_name)\n   882→#     member = None\n   883→#     for m in config.members:\n   884→#         if isinstance(m, TeammateMember) and m.name == agent_name:\n   885→#             member = m\n   886→#             break\n   887→#     if member is None:\n   888→#         raise ToolError(\n   889→#             f\"Teammate {agent_name!r} not found in team {team_name!r}\"\n   890→#         )\n   891→#     if member.backend_type == \"opencode\" and member.opencode_session_id:\n   892→#         _cleanup_opencode_session(oc_url, member.opencode_session_id)\n   893→#     if member.tmux_pane_id:\n   894→#         kill_tmux_pane(member.tmux_pane_id)\n   895→#     teams.remove_member(team_name, agent_name)\n   896→#     tasks.reset_owner_tasks(team_name, agent_name)\n   897→#     return {\"success\": True, \"message\": f\"{agent_name} has been stopped.\"}\n   898→\n   899→\n   900→# @mcp.tool\n   901→# def process_shutdown_approved(\n   902→#     team_name: str, agent_name: str, ctx: Context\n   903→# ) -> dict:\n   904→#     \"\"\"Process a teammate's shutdown by removing them from config and\n   905→#     resetting their tasks. Call after confirming shutdown_approved in the lead inbox.\"\"\"\n   906→#     if agent_name == \"team-lead\":\n   907→#         raise ToolError(\"Cannot process shutdown for team-lead\")\n   908→#     oc_url = _get_lifespan(ctx).get(\"opencode_server_url\")\n   909→#     member = _find_teammate(team_name, agent_name)\n   910→#     if member is None:\n   911→#         raise ToolError(\n   912→#             f\"Teammate {agent_name!r} not found in team {team_name!r}\"\n   913→#         )\n   914→#     if member.backend_type == \"opencode\" and member.opencode_session_id:\n   915→#         _cleanup_opencode_session(oc_url, member.opencode_session_id)\n   916→#     if member.tmux_pane_id:\n   917→#         kill_tmux_pane(member.tmux_pane_id)\n   918→#     teams.remove_member(team_name, agent_name)\n   919→#     tasks.reset_owner_tasks(team_name, agent_name)\n   920→#     return {\"success\": True, \"message\": f\"{agent_name} removed from team.\"}\n   921→\n   922→\n   923→# ===========================================================================\n   924→# Ralph tools (5 tools — planning/build loops)\n   925→# ===========================================================================\n   926→\n   927→@mcp.tool\n   928→def ralph_providers() -> dict:\n   929→    \"\"\"Discover available providers and models for ralph loops.\n   930→\n   931→    Returns a JSON object with:\n   932→    - providers: list of enabled providers with their available models,\n   933→      each model annotated with cost_tier, best_for_tags, and best_for_notes\n   934→      so you can choose the right model for the task\n   935→    - defaults: default provider, model, and iteration count\n   936→    - summarizer: configured summarizer provider and model\n   937→\n   938→    Call this before ralph_start to know which providers and models are available.\n   939→    Models are discovered LIVE from provider CLIs (same as the standalone ralph scripts).\n   940→    Use the cost_tier and best_for metadata to select the best model for your task.\n   941→    \"\"\"\n   942→    from server.config import get_ralph_defaults, get_summarizer_config\n   943→    from server.services.provider_service import get_ralph_providers\n   944→\n   945→    return {\n   946→        \"providers\": get_ralph_providers(),\n   947→        \"defaults\": get_ralph_defaults(),\n   948→        \"summarizer\": get_summarizer_config(),\n   949→    }\n   950→\n   951→\n   952→@mcp.tool\n   953→def ralph_start(\n   954→    slug: str,\n   955→    mode: str,\n   956→    task_description: str,\n   957→    provider: str | None = None,\n   958→    model: str | None = None,\n   959→    iterations: int | None = None,\n   960→    sandbox: bool = False,\n   961→) -> dict:\n   962→    \"\"\"Start a ralph loop as a background process.\n   963→\n   964→    Creates a working directory at .vista/ralph/{slug}/ and spawns a loop subprocess.\n   965→    Returns immediately with a job ID. Use ralph_status to poll progress.\n   966→\n   967→    :param slug: Short identifier for this job (lowercase, hyphens ok)\n   968→    :param mode: Loop mode - \"plan\" or \"build\"\n   969→    :param task_description: What the loop should accomplish (written to task.md)\n   970→    :param provider: Provider name (e.g. \"claude\", \"opencode\"). Uses default if omitted.\n   971→    :param model: Model name (e.g. \"opus\", \"sonnet\"). Uses default if omitted.\n   972→    :param iterations: Max loop iterations. Uses default if omitted.\n   973→    :param sandbox: Run in Docker sandbox container (default False).\n   974→    \"\"\"\n   975→    from server.config import get_ralph_defaults\n   976→    from server.services.provider_service import (\n   977→        get_provider_by_name,\n   978→        get_ralph_providers,\n   979→    )\n   980→    from server.services.ralph_service import ralph_service\n   981→\n   982→    defaults = get_ralph_defaults()\n   983→    provider = provider or defaults[\"provider\"]\n   984→    model = model or defaults[\"model\"]\n   985→    iterations = iterations or defaults[\"iterations\"]\n   986→\n   987→    if mode not in (\"plan\", \"build\"):\n   988→        raise ToolError(f\"Invalid mode: {mode}. Must be 'plan' or 'build'.\")\n   989→\n   990→    provider_obj = get_provider_by_name(provider)\n   991→    if not provider_obj:\n   992→        raise ToolError(f\"Provider not found: {provider}\")\n   993→\n   994→    available = {p.get(\"name\"): p for p in get_ralph_providers()}\n   995→    provider_entry = available.get(provider)\n   996→    if not provider_entry:\n   997→        raise ToolError(f\"Provider not available for ralph: {provider}\")\n   998→\n   999→    model_entries = provider_entry.get(\"models\", []) or []\n  1000→    available_models: list[str] = []\n  1001→    for entry in model_entries:\n  1002→        if isinstance(entry, dict):\n  1003→            if \"id\" in entry and entry[\"id\"]:\n  1004→                available_models.append(entry[\"id\"])\n  1005→            elif \"name\" in entry and entry[\"name\"]:\n  1006→                available_models.append(entry[\"name\"])\n  1007→        elif isinstance(entry, str):\n  1008→            available_models.append(entry)\n  1009→\n  1010→    if available_models and model not in available_models:\n  1011→        raise ToolError(\n  1012→            f\"Model not available for provider {provider}: {model}. \"\n  1013→            f\"Available models: {', '.join(available_models)}\"\n  1014→        )\n  1015→    if not available_models:\n  1016→        raise ToolError(f\"No models available for provider: {provider}\")\n  1017→\n  1018→    project_root = Path.cwd()\n  1019→    try:\n  1020→        job = ralph_service.create_job(\n  1021→            project_root, slug, mode, task_description,\n  1022→            provider_obj, model, iterations,\n  1023→            sandbox=sandbox,\n  1024→        )\n  1025→    except Exception as e:\n  1026→        raise ToolError(str(e))\n  1027→    working_dir = project_root / \".vista\" / \"ralph\" / job.get(\"slug\", slug)\n  1028→    result = dict(job)\n  1029→    result[\"working_dir\"] = str(working_dir)\n  1030→    return result\n  1031→\n  1032→\n  1033→@mcp.tool\n  1034→def ralph_status(job_id: str) -> dict:\n  1035→    \"\"\"Check the status and progress of a ralph job.\n  1036→\n  1037→    Returns lightweight status information. For a detailed AI-generated summary,\n  1038→    use ralph_summary instead.\n  1039→\n  1040→    :param job_id: The job ID returned by ralph_start\n  1041→    \"\"\"\n  1042→    from server.services.ralph_service import ralph_service\n  1043→\n  1044→    project_root = Path.cwd()\n  1045→    job = ralph_service.get_job_status(project_root, job_id)\n  1046→    if not job:\n  1047→        raise ToolError(f\"Job not found: {job_id}\")\n  1048→\n  1049→    elapsed_time = None\n  1050→    started_at = job.get(\"started_at\") or job.get(\"created_at\")\n  1051→    if isinstance(started_at, str):\n  1052→        try:\n  1053→            started_dt = datetime.fromisoformat(started_at)\n  1054→            elapsed_time = int(\n  1055→                (datetime.now(timezone.utc) - started_dt).total_seconds()\n  1056→            )\n  1057→        except ValueError:\n  1058→            elapsed_time = None\n  1059→\n  1060→    last_progress = job.get(\"progress_tail\") or []\n  1061→    return {\n  1062→        \"job_id\": job.get(\"job_id\"),\n  1063→        \"status\": job.get(\"status\"),\n  1064→        \"current_iteration\": job.get(\"current_iteration\", 0),\n  1065→        \"total_iterations\": job.get(\"iterations\", 0),\n  1066→        \"last_progress_lines\": last_progress,\n  1067→        \"elapsed_time\": elapsed_time,\n  1068→        \"progress_tail\": last_progress,\n  1069→        \"slug\": job.get(\"slug\"),\n  1070→        \"mode\": job.get(\"mode\"),\n  1071→        \"provider\": job.get(\"provider\"),\n  1072→        \"model\": job.get(\"model\"),\n  1073→        \"pid\": job.get(\"pid\"),\n  1074→        \"error\": job.get(\"error\"),\n  1075→    }\n  1076→\n  1077→\n  1078→@mcp.tool\n  1079→def ralph_summary(job_id: str) -> dict:\n  1080→    \"\"\"Get an AI-generated summary of a ralph job's artifacts.\n  1081→\n  1082→    Spawns a summarizer agent that reads the job's progress.txt,\n  1083→    IMPLEMENTATION_PLAN.md, and git log, then returns a structured summary.\n  1084→    Works for both running and completed jobs.\n  1085→\n  1086→    This is more expensive than ralph_status - use it when you need\n  1087→    a detailed understanding of what the loop accomplished or is working on.\n  1088→\n  1089→    :param job_id: The job ID returned by ralph_start\n  1090→    \"\"\"\n  1091→    from server.services.summarizer_service import summarizer_service\n  1092→\n  1093→    project_root = Path.cwd()\n  1094→    return summarizer_service.run_summarizer(project_root, job_id)\n  1095→\n  1096→\n  1097→@mcp.tool\n  1098→def ralph_stop(job_id: str) -> dict:\n  1099→    \"\"\"Stop a running ralph loop.\n  1100→\n  1101→    Sends a termination signal to the loop subprocess and updates the job status.\n  1102→\n  1103→    :param job_id: The job ID returned by ralph_start\n  1104→    \"\"\"\n  1105→    from server.services.ralph_service import ralph_service\n  1106→\n  1107→    project_root = Path.cwd()\n  1108→    job = ralph_service.stop_job(project_root, job_id)\n  1109→    if not job:\n  1110→        raise ToolError(f\"Job not found: {job_id}\")\n  1111→    return {\n  1112→        \"job_id\": job.get(\"job_id\"),\n  1113→        \"status\": job.get(\"status\"),\n  1114→        \"message\": \"Job stopped\",\n  1115→        \"slug\": job.get(\"slug\"),\n  1116→        \"provider\": job.get(\"provider\"),\n  1117→        \"model\": job.get(\"model\"),\n  1118→    }\n  1119→\n  1120→\n  1121→# ---------------------------------------------------------------------------\n  1122→# Entry point\n  1123→# ---------------------------------------------------------------------------\n  1124→if __name__ == \"__main__\":\n  1125→    mcp.run(transport=\"stdio\")\n  1126→"}]},"parent_tool_use_id":null,"session_id":"615fcba1-13a5-40a3-839d-703775331047","uuid":"4a677c2b-c97b-4bd0-a2fb-c44f97a31a4e","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/mcp_server.py","content":"\"\"\"Vista MCP Server - launches the FastAPI dashboard as a daemon thread.\n\nClaude Code starts this process via .mcp.json (stdio transport).\nThe web dashboard runs as a daemon thread inside the same process,\nmodeled on Serena's dashboard.py:run_in_thread() pattern.\n\nUses fastmcp 3.x (same as claude-code-teams-mcp) for proper Context\ninjection, ToolError handling, and middleware support.\n\"\"\"\n\nimport asyncio\nimport json\nimport logging\nimport os\nimport socket\nimport subprocess\nimport sys\nimport threading\nimport time\nimport uuid\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom types import SimpleNamespace\nfrom typing import Any, Literal\n\n# Ensure vista/ is on sys.path so `from server.*` imports resolve\nPLUGIN_ROOT = Path(__file__).resolve().parent\nsys.path.insert(0, str(PLUGIN_ROOT))\nsys.path.insert(0, str(PLUGIN_ROOT / \"vendor\"))\n\nfrom server.config import ensure_full_path, get_server_settings  # noqa: E402\n\nensure_full_path()\n\nfrom fastmcp import Context, FastMCP  # noqa: E402\nfrom fastmcp.exceptions import ToolError  # noqa: E402\nfrom fastmcp.server.lifespan import lifespan  # noqa: E402\nfrom fastmcp.server.middleware import Middleware  # noqa: E402\n\nfrom claude_teams import messaging, opencode_client, tasks, teams  # noqa: E402\nfrom claude_teams.models import (  # noqa: E402\n    SendMessageResult,\n    ShutdownApproved,\n    SpawnResult,\n    TeammateMember,\n)\nfrom claude_teams.opencode_client import OpenCodeAPIError  # noqa: E402\nfrom claude_teams.spawner import (  # noqa: E402\n    discover_harness_binary,\n    discover_opencode_models,\n    kill_tmux_pane,\n    spawn_teammate,\n    use_tmux_windows,\n)\n\nlogger = logging.getLogger(__name__)\n\n# ---------------------------------------------------------------------------\n# Harness / client detection (mirrors claude-code-teams-mcp)\n# ---------------------------------------------------------------------------\nKNOWN_CLIENTS: dict[str, str] = {\n    \"claude-code\": \"claude\",\n    \"claude\": \"claude\",\n    \"opencode\": \"opencode\",\n}\n\n_VALID_BACKENDS = frozenset(KNOWN_CLIENTS.values())\n\n# NOTE: Mutated by both app_lifespan and HarnessDetectionMiddleware.\n# Safe under stdio (single session).\n_lifespan_state: dict[str, Any] = {}\n\n# Reference to the spawn_teammate tool for dynamic description updates\n_spawn_tool: Any = None\n\n\n# ---------------------------------------------------------------------------\n# Dashboard thread\n# ---------------------------------------------------------------------------\ndef _find_free_port(preferred: int, host: str) -> int:\n    port = preferred\n    while port <= 65535:\n        try:\n            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:\n                sock.bind((host, port))\n                return port\n        except OSError:\n            port += 1\n    raise RuntimeError(f\"No free ports found starting from {preferred}\")\n\n\ndef _run_uvicorn_in_thread(host: str, port: int) -> threading.Thread:\n    import uvicorn\n\n    from server.app import app\n\n    config = uvicorn.Config(app, host=host, port=port, log_level=\"warning\")\n    server = uvicorn.Server(config)\n    thread = threading.Thread(target=server.run, daemon=True)\n    thread.start()\n    return thread\n\n\n# ---------------------------------------------------------------------------\n# Backend helpers\n# ---------------------------------------------------------------------------\ndef _parse_backends_env(raw: str) -> list[str]:\n    if not raw:\n        return []\n    return list(dict.fromkeys(\n        b.strip() for b in raw.split(\",\")\n        if b.strip() and b.strip() in _VALID_BACKENDS\n    ))\n\n\ndef _start_opencode_serve(\n    opencode_binary: str, preferred_port: int\n) -> tuple[subprocess.Popen, str]:\n    import urllib.request\n\n    port = _find_free_port(preferred_port, \"127.0.0.1\")\n    proc = subprocess.Popen(\n        [opencode_binary, \"serve\", \"--port\", str(port)],\n        stdin=subprocess.DEVNULL,\n        stdout=subprocess.DEVNULL,\n        stderr=subprocess.DEVNULL,\n    )\n    url = f\"http://127.0.0.1:{port}\"\n\n    for _ in range(50):\n        if proc.poll() is not None:\n            raise RuntimeError(\n                f\"opencode serve exited with code {proc.returncode}\"\n            )\n        try:\n            urllib.request.urlopen(f\"{url}/agent\", timeout=1)\n            return proc, url\n        except Exception:\n            time.sleep(0.2)\n\n    proc.terminate()\n    raise RuntimeError(\n        f\"opencode serve failed to respond on port {port} within 10s\"\n    )\n\n\n# ---------------------------------------------------------------------------\n# Spawn tool description builder (mirrors reference)\n# ---------------------------------------------------------------------------\n_SPAWN_TOOL_BASE_DESCRIPTION = (\n    \"Spawn a new teammate in a tmux {target}. The teammate receives its initial \"\n    \"prompt via inbox and begins working autonomously. Names must be unique \"\n    \"within the team.\"\n)\n\n\ndef _build_spawn_description(\n    claude_binary: str | None,\n    opencode_binary: str | None,\n    opencode_models: list[str],\n    opencode_server_url: str | None = None,\n    opencode_agents: list[dict] | None = None,\n    enabled_backends: list[str] | None = None,\n) -> str:\n    tmux_target = \"window\" if use_tmux_windows() else \"pane\"\n    parts = [_SPAWN_TOOL_BASE_DESCRIPTION.format(target=tmux_target)]\n    backends = []\n    show_claude = claude_binary is not None\n    show_opencode = (\n        opencode_binary is not None and opencode_server_url is not None\n    )\n    if enabled_backends is not None:\n        show_claude = show_claude and \"claude\" in enabled_backends\n        show_opencode = show_opencode and \"opencode\" in enabled_backends\n    if show_claude:\n        backends.append(\"'claude' (default, models: sonnet, opus, haiku)\")\n    if show_opencode:\n        model_list = (\n            \", \".join(opencode_models) if opencode_models else \"none discovered\"\n        )\n        backends.append(f\"'opencode' (models: {model_list})\")\n    if backends:\n        parts.append(f\"Available backends: {'; '.join(backends)}.\")\n    if show_opencode and opencode_agents:\n        agent_lines = [\n            f\"  - {a['name']}: {a['description']}\" for a in opencode_agents\n        ]\n        parts.append(\n            \"Available opencode agents (pass as subagent_type when \"\n            \"backend_type='opencode'):\\n\" + \"\\n\".join(agent_lines)\n        )\n    return \" \".join(parts)\n\n\ndef _update_spawn_tool(\n    tool: Any, enabled: list[str], state: dict[str, Any]\n) -> None:\n    tool.parameters[\"properties\"][\"backend_type\"][\"enum\"] = list(enabled)\n    if enabled:\n        tool.parameters[\"properties\"][\"backend_type\"][\"default\"] = enabled[0]\n    tool.description = _build_spawn_description(\n        state.get(\"claude_binary\"),\n        state.get(\"opencode_binary\"),\n        state.get(\"opencode_models\", []),\n        state.get(\"opencode_server_url\"),\n        state.get(\"opencode_agents\"),\n        enabled_backends=enabled,\n    )\n\n\n# ---------------------------------------------------------------------------\n# Helpers shared by tool handlers\n# ---------------------------------------------------------------------------\ndef _get_lifespan(ctx: Context) -> dict[str, Any]:\n    return ctx.lifespan_context\n\n\ndef _find_teammate(team_name: str, name: str) -> TeammateMember | None:\n    config = teams.read_config(team_name)\n    for m in config.members:\n        if isinstance(m, TeammateMember) and m.name == name:\n            return m\n    return None\n\n\ndef _push_to_opencode_session(\n    server_url: str, member: TeammateMember, text: str\n) -> None:\n    if (\n        member.backend_type != \"opencode\"\n        or not member.opencode_session_id\n        or not server_url\n    ):\n        return\n    try:\n        opencode_client.send_prompt_async(\n            server_url, member.opencode_session_id, text\n        )\n    except OpenCodeAPIError:\n        logger.warning(\n            \"Failed to push message to opencode session %s\",\n            member.opencode_session_id,\n        )\n\n\ndef _cleanup_opencode_session(\n    server_url: str | None, session_id: str | None\n) -> None:\n    if not server_url or not session_id:\n        return\n    try:\n        opencode_client.abort_session(server_url, session_id)\n    except OpenCodeAPIError:\n        logger.warning(\"Failed to abort opencode session %s\", session_id)\n    try:\n        opencode_client.delete_session(server_url, session_id)\n    except OpenCodeAPIError:\n        logger.warning(\"Failed to delete opencode session %s\", session_id)\n\n\n# ---------------------------------------------------------------------------\n# Lifespan\n# ---------------------------------------------------------------------------\n@lifespan\nasync def app_lifespan(server):\n    global _spawn_tool\n\n    # -- Start dashboard thread -----------------------------------------------\n    settings = get_server_settings()\n    host = settings[\"host\"]\n    preferred_port = settings[\"port\"]\n    port = _find_free_port(preferred_port, host)\n    _run_uvicorn_in_thread(host, port)\n\n    dashboard_host = host if host != \"0.0.0.0\" else \"localhost\"\n    url = f\"http://{dashboard_host}:{port}\"\n    print(f\"Vista dashboard started at {url}\", file=sys.stderr)\n\n    if settings.get(\"auto_open_browser\", True):\n        subprocess.Popen(\n            [sys.executable, \"-c\", f\"import webbrowser; webbrowser.open({url!r})\"],\n            stdin=subprocess.DEVNULL,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n        )\n\n    # -- Discover backends (mirrors claude-code-teams-mcp) --------------------\n    from server.config import get_tools_settings\n\n    tools_settings = get_tools_settings()\n    teams_settings = tools_settings.get(\"teams\", {})\n\n    claude_binary = (\n        teams_settings.get(\"claude_binary\")\n        or discover_harness_binary(\"claude\")\n    )\n    opencode_binary = discover_harness_binary(\"opencode\")\n    opencode_url = (\n        teams_settings.get(\"opencode_url\")\n        or os.environ.get(\"OPENCODE_SERVER_URL\")\n    )\n\n    # Auto-start opencode serve if binary found but no URL configured\n    opencode_process = None\n    if (\n        opencode_binary\n        and not opencode_url\n        and teams_settings.get(\"opencode_auto_start\", True)\n    ):\n        try:\n            preferred_oc_port = teams_settings.get(\"opencode_port\", 4200)\n            opencode_process, opencode_url = _start_opencode_serve(\n                opencode_binary, preferred_oc_port\n            )\n            logger.info(\n                \"Auto-started opencode serve at %s (pid %d)\",\n                opencode_url, opencode_process.pid,\n            )\n        except Exception as e:\n            logger.warning(\"Failed to auto-start opencode serve: %s\", e)\n\n    opencode_models: list[str] = []\n    opencode_agents: list[dict] = []\n    if opencode_binary:\n        try:\n            opencode_models = discover_opencode_models(opencode_binary)\n        except Exception:\n            pass\n    if opencode_url:\n        try:\n            opencode_agents = opencode_client.list_agents(opencode_url)\n        except Exception:\n            logger.warning(\"Failed to fetch opencode agents from %s\", opencode_url)\n\n    enabled_backends = _parse_backends_env(\n        os.environ.get(\"CLAUDE_TEAMS_BACKENDS\", \"\")\n    )\n    if \"opencode\" in enabled_backends and not opencode_url:\n        enabled_backends.remove(\"opencode\")\n\n    session_id = str(uuid.uuid4())\n\n    _lifespan_state.clear()\n    _lifespan_state.update({\n        \"claude_binary\": claude_binary,\n        \"opencode_binary\": opencode_binary,\n        \"opencode_server_url\": opencode_url,\n        \"opencode_agents\": opencode_agents,\n        \"opencode_models\": opencode_models,\n        \"enabled_backends\": enabled_backends,\n        \"opencode_process\": opencode_process,\n        \"session_id\": session_id,\n        \"active_team\": None,\n        \"client_name\": \"unknown\",\n        \"client_version\": \"unknown\",\n    })\n\n    # -- Update spawn_teammate tool description -------------------------------\n    try:\n        tool = await mcp.get_tool(\"spawn_teammate\")\n        _spawn_tool = tool\n        if enabled_backends:\n            _update_spawn_tool(tool, enabled_backends, _lifespan_state)\n    except Exception:\n        pass\n\n    yield _lifespan_state\n\n    # -- Cleanup --------------------------------------------------------------\n    if opencode_process and opencode_process.poll() is None:\n        logger.info(\n            \"Terminating auto-started opencode serve (pid %d)\",\n            opencode_process.pid,\n        )\n        opencode_process.terminate()\n        try:\n            opencode_process.wait(timeout=5)\n        except subprocess.TimeoutExpired:\n            opencode_process.kill()\n\n    print(\"Vista MCP server shutting down\", file=sys.stderr)\n\n\n# ---------------------------------------------------------------------------\n# Middleware: auto-detect connected client and enable backends\n# ---------------------------------------------------------------------------\nclass HarnessDetectionMiddleware(Middleware):\n    async def on_initialize(self, context, call_next):\n        _unknown = SimpleNamespace(name=\"unknown\", version=\"unknown\")\n        client_info = context.message.params.clientInfo or _unknown\n        client_name = client_info.name\n        client_version = client_info.version\n\n        result = await call_next(context)\n\n        logger.info(\"MCP client connected: %s v%s\", client_name, client_version)\n\n        native_backend = KNOWN_CLIENTS.get(client_name)\n        enabled = _lifespan_state.get(\"enabled_backends\", [])\n\n        if native_backend and native_backend not in enabled:\n            if native_backend == \"claude\" or _lifespan_state.get(\n                \"opencode_server_url\"\n            ):\n                enabled.append(native_backend)\n\n        if not enabled:\n            if _lifespan_state.get(\"claude_binary\"):\n                enabled.append(\"claude\")\n            if _lifespan_state.get(\"opencode_binary\") and _lifespan_state.get(\n                \"opencode_server_url\"\n            ):\n                enabled.append(\"opencode\")\n\n        _lifespan_state[\"enabled_backends\"] = enabled\n        _lifespan_state[\"client_name\"] = client_name\n        _lifespan_state[\"client_version\"] = client_version\n\n        if _spawn_tool:\n            _update_spawn_tool(_spawn_tool, enabled, _lifespan_state)\n\n        return result\n\n\n# ---------------------------------------------------------------------------\n# FastMCP server\n# ---------------------------------------------------------------------------\nmcp = FastMCP(\n    name=\"vista-dashboard\",\n    instructions=(\n        \"MCP server for the Vista development dashboard. \"\n        \"Manages team creation, teammate spawning, messaging, task tracking, \"\n        \"and ralph planning/build loops.\"\n    ),\n    lifespan=app_lifespan,\n)\nmcp.add_middleware(HarnessDetectionMiddleware())\n\n\n# # ===========================================================================\n# # Teams tools (13 tools — mirrors claude-code-teams-mcp reference)\n# # ===========================================================================\n\n# @mcp.tool\n# def team_create(\n#     team_name: str,\n#     ctx: Context,\n#     description: str = \"\",\n# ) -> dict:\n#     \"\"\"Create a new agent team. Sets up config and task directories under ~/.claude/.\n#     One team per server session. Names must be filesystem-safe\n#     (letters, numbers, hyphens, underscores).\"\"\"\n#     ls = _get_lifespan(ctx)\n#     if ls.get(\"active_team\"):\n#         raise ToolError(\n#             f\"Session already has active team: {ls['active_team']}. \"\n#             \"One team per session.\"\n#         )\n#     result = teams.create_team(\n#         name=team_name,\n#         session_id=ls[\"session_id\"],\n#         description=description,\n#     )\n#     ls[\"active_team\"] = team_name\n#     return result.model_dump()\n\n\n# @mcp.tool\n# def team_delete(team_name: str, ctx: Context) -> dict:\n#     \"\"\"Delete a team and all its data. Fails if any teammates are still active.\n#     Removes both team config and task directories.\"\"\"\n#     try:\n#         result = teams.delete_team(team_name)\n#     except (RuntimeError, FileNotFoundError) as e:\n#         raise ToolError(str(e))\n#     _get_lifespan(ctx)[\"active_team\"] = None\n#     return result.model_dump()\n\n\n# @mcp.tool(name=\"spawn_teammate\")\n# def spawn_teammate_tool(\n#     team_name: str,\n#     name: str,\n#     prompt: str,\n#     ctx: Context,\n#     model: str = \"sonnet\",\n#     subagent_type: str = \"general-purpose\",\n#     plan_mode_required: bool = False,\n#     backend_type: Literal[\"claude\", \"opencode\"] = \"claude\",\n# ) -> dict:\n#     \"\"\"Spawn a new teammate in tmux. Description is dynamically updated\n#     at startup with available backends and models.\"\"\"\n#     ls = _get_lifespan(ctx)\n#     enabled = ls.get(\"enabled_backends\", [])\n#     if enabled and backend_type not in enabled:\n#         raise ToolError(\n#             f\"Backend {backend_type!r} is not enabled. Enabled: {enabled}\"\n#         )\n\n#     opencode_agent = None\n#     if backend_type == \"opencode\":\n#         known = {a[\"name\"] for a in ls.get(\"opencode_agents\", [])}\n#         opencode_agent = subagent_type if subagent_type in known else \"build\"\n\n#     try:\n#         member = spawn_teammate(\n#             team_name=team_name,\n#             name=name,\n#             prompt=prompt,\n#             claude_binary=ls[\"claude_binary\"],\n#             lead_session_id=ls[\"session_id\"],\n#             model=model,\n#             subagent_type=subagent_type,\n#             plan_mode_required=plan_mode_required,\n#             backend_type=backend_type,\n#             opencode_binary=ls[\"opencode_binary\"],\n#             opencode_server_url=ls[\"opencode_server_url\"],\n#             opencode_agent=opencode_agent,\n#         )\n#     except (ValueError, OpenCodeAPIError) as e:\n#         raise ToolError(str(e))\n\n#     return SpawnResult(\n#         agent_id=member.agent_id,\n#         name=member.name,\n#         team_name=team_name,\n#     ).model_dump()\n\n\n# @mcp.tool\n# def send_message(\n#     team_name: str,\n#     type: Literal[\n#         \"message\",\n#         \"broadcast\",\n#         \"shutdown_request\",\n#         \"shutdown_response\",\n#         \"plan_approval_response\",\n#     ],\n#     ctx: Context,\n#     recipient: str = \"\",\n#     content: str = \"\",\n#     summary: str = \"\",\n#     request_id: str = \"\",\n#     approve: bool | None = None,\n#     sender: str = \"team-lead\",\n# ) -> dict:\n#     \"\"\"Send a message to a teammate or respond to a protocol request.\n#     Type 'message' sends a DM (requires recipient, summary).\n#     Type 'broadcast' sends to all teammates (requires summary).\n#     Type 'shutdown_request' asks a teammate to shut down (requires recipient).\n#     Type 'shutdown_response' responds to a shutdown request (requires sender, request_id, approve).\n#     Type 'plan_approval_response' approves/rejects a plan (requires recipient, request_id, approve).\"\"\"\n#     oc_url = _get_lifespan(ctx).get(\"opencode_server_url\")\n\n#     try:\n#         teams.read_config(team_name)\n#     except FileNotFoundError:\n#         raise ToolError(f\"Team {team_name!r} not found\")\n\n#     if type == \"message\":\n#         if not content:\n#             raise ToolError(\"Message content must not be empty\")\n#         if not summary:\n#             raise ToolError(\"Message summary must not be empty\")\n#         if not recipient:\n#             raise ToolError(\"Message recipient must not be empty\")\n#         config = teams.read_config(team_name)\n#         member_names = {m.name for m in config.members}\n#         if sender not in member_names:\n#             raise ToolError(\n#                 f\"Sender {sender!r} is not a member of team {team_name!r}\"\n#             )\n#         if recipient not in member_names:\n#             raise ToolError(\n#                 f\"Recipient {recipient!r} is not a member of team {team_name!r}\"\n#             )\n#         if sender == recipient:\n#             raise ToolError(\"Cannot send a message to yourself\")\n#         if sender != \"team-lead\" and recipient != \"team-lead\":\n#             raise ToolError(\n#                 \"Teammates can only send direct messages to team-lead\"\n#             )\n\n#         target_color = None\n#         target_member = None\n#         for m in config.members:\n#             if m.name == recipient and isinstance(m, TeammateMember):\n#                 target_color = m.color\n#                 target_member = m\n#                 break\n#         messaging.send_plain_message(\n#             team_name, sender, recipient, content,\n#             summary=summary, color=target_color,\n#         )\n#         if target_member and oc_url:\n#             _push_to_opencode_session(oc_url, target_member, content)\n#         return SendMessageResult(\n#             success=True,\n#             message=f\"Message sent to {recipient}\",\n#             routing={\n#                 \"sender\": sender,\n#                 \"target\": recipient,\n#                 \"targetColor\": target_color,\n#                 \"summary\": summary,\n#                 \"content\": content,\n#             },\n#         ).model_dump(exclude_none=True)\n\n#     elif type == \"broadcast\":\n#         if sender != \"team-lead\":\n#             raise ToolError(\"Only team-lead can send broadcasts\")\n#         if not summary:\n#             raise ToolError(\"Broadcast summary must not be empty\")\n#         config = teams.read_config(team_name)\n#         count = 0\n#         for m in config.members:\n#             if isinstance(m, TeammateMember):\n#                 messaging.send_plain_message(\n#                     team_name, \"team-lead\", m.name, content,\n#                     summary=summary, color=None,\n#                 )\n#                 if oc_url:\n#                     _push_to_opencode_session(oc_url, m, content)\n#                 count += 1\n#         return SendMessageResult(\n#             success=True,\n#             message=f\"Broadcast sent to {count} teammate(s)\",\n#         ).model_dump(exclude_none=True)\n\n#     elif type == \"shutdown_request\":\n#         if not recipient:\n#             raise ToolError(\"Shutdown request recipient must not be empty\")\n#         if recipient == \"team-lead\":\n#             raise ToolError(\"Cannot send shutdown request to team-lead\")\n#         config = teams.read_config(team_name)\n#         member_names = {m.name for m in config.members}\n#         if recipient not in member_names:\n#             raise ToolError(\n#                 f\"Recipient {recipient!r} is not a member of team {team_name!r}\"\n#             )\n#         req_id = messaging.send_shutdown_request(\n#             team_name, recipient, reason=content\n#         )\n#         target_member = _find_teammate(team_name, recipient)\n#         if target_member and oc_url:\n#             _push_to_opencode_session(\n#                 oc_url, target_member,\n#                 json.dumps({\n#                     \"type\": \"shutdown_request\",\n#                     \"requestId\": req_id,\n#                     \"reason\": content,\n#                 }),\n#             )\n#         return SendMessageResult(\n#             success=True,\n#             message=f\"Shutdown request sent to {recipient}\",\n#             request_id=req_id,\n#             target=recipient,\n#         ).model_dump(exclude_none=True)\n\n#     elif type == \"shutdown_response\":\n#         config = teams.read_config(team_name)\n#         member = None\n#         for m in config.members:\n#             if isinstance(m, TeammateMember) and m.name == sender:\n#                 member = m\n#                 break\n#         if member is None:\n#             raise ToolError(\n#                 f\"Sender {sender!r} is not a teammate in team {team_name!r}\"\n#             )\n#         if approve:\n#             payload = ShutdownApproved(\n#                 request_id=request_id,\n#                 from_=sender,\n#                 timestamp=messaging.now_iso(),\n#                 pane_id=member.tmux_pane_id,\n#                 backend_type=member.backend_type,\n#                 session_id=member.opencode_session_id,\n#             )\n#             messaging.send_structured_message(\n#                 team_name, sender, \"team-lead\", payload\n#             )\n#             return SendMessageResult(\n#                 success=True,\n#                 message=f\"Shutdown approved for request {request_id}\",\n#             ).model_dump(exclude_none=True)\n#         else:\n#             messaging.send_plain_message(\n#                 team_name, sender, \"team-lead\",\n#                 content or \"Shutdown rejected\",\n#                 summary=\"shutdown_rejected\",\n#             )\n#             return SendMessageResult(\n#                 success=True,\n#                 message=f\"Shutdown rejected for request {request_id}\",\n#             ).model_dump(exclude_none=True)\n\n#     elif type == \"plan_approval_response\":\n#         if not recipient:\n#             raise ToolError(\"Plan approval recipient must not be empty\")\n#         config = teams.read_config(team_name)\n#         member_names = {m.name for m in config.members}\n#         if recipient not in member_names:\n#             raise ToolError(\n#                 f\"Recipient {recipient!r} is not a member of team {team_name!r}\"\n#             )\n#         if approve:\n#             messaging.send_plain_message(\n#                 team_name, sender, recipient,\n#                 '{\"type\":\"plan_approval\",\"approved\":true}',\n#                 summary=\"plan_approved\",\n#             )\n#         else:\n#             messaging.send_plain_message(\n#                 team_name, sender, recipient,\n#                 content or \"Plan rejected\",\n#                 summary=\"plan_rejected\",\n#             )\n#         return SendMessageResult(\n#             success=True,\n#             message=f\"Plan {'approved' if approve else 'rejected'} for {recipient}\",\n#         ).model_dump(exclude_none=True)\n\n#     raise ToolError(f\"Unknown message type: {type}\")\n\n\n# @mcp.tool\n# def task_create(\n#     team_name: str,\n#     subject: str,\n#     description: str,\n#     active_form: str = \"\",\n#     metadata: dict | None = None,\n# ) -> dict:\n#     \"\"\"Create a new task for the team. Tasks get auto-incrementing IDs.\n#     Optional metadata dict is stored alongside the task.\"\"\"\n#     try:\n#         task = tasks.create_task(\n#             team_name, subject, description, active_form, metadata\n#         )\n#     except ValueError as e:\n#         raise ToolError(str(e))\n#     return task.model_dump(by_alias=True, exclude_none=True)\n\n\n# @mcp.tool\n# def task_update(\n#     team_name: str,\n#     task_id: str,\n#     status: Literal[\"pending\", \"in_progress\", \"completed\", \"deleted\"] | None = None,\n#     owner: str | None = None,\n#     subject: str | None = None,\n#     description: str | None = None,\n#     active_form: str | None = None,\n#     add_blocks: list[str] | None = None,\n#     add_blocked_by: list[str] | None = None,\n#     metadata: dict | None = None,\n# ) -> dict:\n#     \"\"\"Update a task's fields. Setting owner auto-notifies the assignee.\n#     Setting status to 'deleted' removes the task file.\n#     Metadata keys are merged (set a key to null to delete it).\"\"\"\n#     if owner is not None:\n#         try:\n#             config = teams.read_config(team_name)\n#         except FileNotFoundError:\n#             raise ToolError(f\"Team {team_name!r} not found\")\n#         member_names = {m.name for m in config.members}\n#         if owner not in member_names:\n#             raise ToolError(\n#                 f\"Owner {owner!r} is not a member of team {team_name!r}\"\n#             )\n#     try:\n#         task = tasks.update_task(\n#             team_name, task_id,\n#             status=status, owner=owner, subject=subject,\n#             description=description, active_form=active_form,\n#             add_blocks=add_blocks, add_blocked_by=add_blocked_by,\n#             metadata=metadata,\n#         )\n#     except FileNotFoundError:\n#         raise ToolError(f\"Task {task_id!r} not found in team {team_name!r}\")\n#     except ValueError as e:\n#         raise ToolError(str(e))\n#     if owner is not None and task.owner is not None and task.status != \"deleted\":\n#         messaging.send_task_assignment(team_name, task, assigned_by=\"team-lead\")\n#     return task.model_dump(by_alias=True, exclude_none=True)\n\n\n# @mcp.tool\n# def task_list(team_name: str) -> list[dict]:\n#     \"\"\"List all tasks for a team with their current status and assignments.\"\"\"\n#     try:\n#         result = tasks.list_tasks(team_name)\n#     except ValueError as e:\n#         raise ToolError(str(e))\n#     return [t.model_dump(by_alias=True, exclude_none=True) for t in result]\n\n\n# @mcp.tool\n# def task_get(team_name: str, task_id: str) -> dict:\n#     \"\"\"Get full details of a specific task by ID.\"\"\"\n#     try:\n#         task = tasks.get_task(team_name, task_id)\n#     except FileNotFoundError:\n#         raise ToolError(f\"Task {task_id!r} not found in team {team_name!r}\")\n#     return task.model_dump(by_alias=True, exclude_none=True)\n\n\n# @mcp.tool\n# def read_inbox(\n#     team_name: str,\n#     agent_name: str,\n#     unread_only: bool = False,\n#     mark_as_read: bool = True,\n# ) -> list[dict]:\n#     \"\"\"Read messages from an agent's inbox. Returns all messages by default.\n#     Set unread_only=True to get only unprocessed messages.\"\"\"\n#     try:\n#         config = teams.read_config(team_name)\n#     except FileNotFoundError:\n#         raise ToolError(f\"Team {team_name!r} not found\")\n#     member_names = {m.name for m in config.members}\n#     if agent_name not in member_names:\n#         raise ToolError(\n#             f\"Agent {agent_name!r} is not a member of team {team_name!r}\"\n#         )\n#     msgs = messaging.read_inbox(\n#         team_name, agent_name,\n#         unread_only=unread_only, mark_as_read=mark_as_read,\n#     )\n#     return [m.model_dump(by_alias=True, exclude_none=True) for m in msgs]\n\n\n# @mcp.tool\n# async def poll_inbox(\n#     team_name: str,\n#     agent_name: str,\n#     timeout_ms: int = 30000,\n# ) -> list[dict]:\n#     \"\"\"Poll an agent's inbox for new unread messages, waiting up to timeout_ms.\n#     Returns unread messages and marks them as read.\"\"\"\n#     msgs = messaging.read_inbox(\n#         team_name, agent_name, unread_only=True, mark_as_read=True\n#     )\n#     if msgs:\n#         return [m.model_dump(by_alias=True, exclude_none=True) for m in msgs]\n#     deadline = time.time() + timeout_ms / 1000.0\n#     while time.time() < deadline:\n#         await asyncio.sleep(0.5)\n#         msgs = messaging.read_inbox(\n#             team_name, agent_name,\n#             unread_only=True, mark_as_read=True,\n#         )\n#         if msgs:\n#             return [\n#                 m.model_dump(by_alias=True, exclude_none=True) for m in msgs\n#             ]\n#     return []\n\n\n# @mcp.tool\n# def read_config(team_name: str) -> dict:\n#     \"\"\"Read the current team configuration including all members.\"\"\"\n#     try:\n#         config = teams.read_config(team_name)\n#     except FileNotFoundError:\n#         raise ToolError(f\"Team {team_name!r} not found\")\n#     return config.model_dump(by_alias=True)\n\n\n# @mcp.tool\n# def force_kill_teammate(\n#     team_name: str, agent_name: str, ctx: Context\n# ) -> dict:\n#     \"\"\"Forcibly kill a teammate's tmux pane. Use when graceful shutdown\n#     is not possible. Kills the pane, removes member from config,\n#     and resets their tasks.\"\"\"\n#     oc_url = _get_lifespan(ctx).get(\"opencode_server_url\")\n#     config = teams.read_config(team_name)\n#     member = None\n#     for m in config.members:\n#         if isinstance(m, TeammateMember) and m.name == agent_name:\n#             member = m\n#             break\n#     if member is None:\n#         raise ToolError(\n#             f\"Teammate {agent_name!r} not found in team {team_name!r}\"\n#         )\n#     if member.backend_type == \"opencode\" and member.opencode_session_id:\n#         _cleanup_opencode_session(oc_url, member.opencode_session_id)\n#     if member.tmux_pane_id:\n#         kill_tmux_pane(member.tmux_pane_id)\n#     teams.remove_member(team_name, agent_name)\n#     tasks.reset_owner_tasks(team_name, agent_name)\n#     return {\"success\": True, \"message\": f\"{agent_name} has been stopped.\"}\n\n\n# @mcp.tool\n# def process_shutdown_approved(\n#     team_name: str, agent_name: str, ctx: Context\n# ) -> dict:\n#     \"\"\"Process a teammate's shutdown by removing them from config and\n#     resetting their tasks. Call after confirming shutdown_approved in the lead inbox.\"\"\"\n#     if agent_name == \"team-lead\":\n#         raise ToolError(\"Cannot process shutdown for team-lead\")\n#     oc_url = _get_lifespan(ctx).get(\"opencode_server_url\")\n#     member = _find_teammate(team_name, agent_name)\n#     if member is None:\n#         raise ToolError(\n#             f\"Teammate {agent_name!r} not found in team {team_name!r}\"\n#         )\n#     if member.backend_type == \"opencode\" and member.opencode_session_id:\n#         _cleanup_opencode_session(oc_url, member.opencode_session_id)\n#     if member.tmux_pane_id:\n#         kill_tmux_pane(member.tmux_pane_id)\n#     teams.remove_member(team_name, agent_name)\n#     tasks.reset_owner_tasks(team_name, agent_name)\n#     return {\"success\": True, \"message\": f\"{agent_name} removed from team.\"}\n\n\n# ===========================================================================\n# Ralph tools (5 tools — planning/build loops)\n# ===========================================================================\n\n@mcp.tool\ndef ralph_providers() -> dict:\n    \"\"\"Discover available providers and models for ralph loops.\n\n    Returns a JSON object with:\n    - providers: list of enabled providers with their available models,\n      each model annotated with cost_tier, best_for_tags, and best_for_notes\n      so you can choose the right model for the task\n    - defaults: default provider, model, and iteration count\n    - summarizer: configured summarizer provider and model\n\n    Call this before ralph_start to know which providers and models are available.\n    Models are discovered LIVE from provider CLIs (same as the standalone ralph scripts).\n    Use the cost_tier and best_for metadata to select the best model for your task.\n    \"\"\"\n    from server.config import get_ralph_defaults, get_summarizer_config\n    from server.services.provider_service import get_ralph_providers\n\n    return {\n        \"providers\": get_ralph_providers(),\n        \"defaults\": get_ralph_defaults(),\n        \"summarizer\": get_summarizer_config(),\n    }\n\n\n@mcp.tool\ndef ralph_start(\n    slug: str,\n    mode: str,\n    task_description: str,\n    provider: str | None = None,\n    model: str | None = None,\n    iterations: int | None = None,\n    sandbox: bool = False,\n) -> dict:\n    \"\"\"Start a ralph loop as a background process.\n\n    Creates a working directory at .vista/ralph/{slug}/ and spawns a loop subprocess.\n    Returns immediately with a job ID. Use ralph_status to poll progress.\n\n    :param slug: Short identifier for this job (lowercase, hyphens ok)\n    :param mode: Loop mode - \"plan\" or \"build\"\n    :param task_description: What the loop should accomplish (written to task.md)\n    :param provider: Provider name (e.g. \"claude\", \"opencode\"). Uses default if omitted.\n    :param model: Model name (e.g. \"opus\", \"sonnet\"). Uses default if omitted.\n    :param iterations: Max loop iterations. Uses default if omitted.\n    :param sandbox: Run in Docker sandbox container (default False).\n    \"\"\"\n    from server.config import get_ralph_defaults\n    from server.services.provider_service import (\n        get_provider_by_name,\n        get_ralph_providers,\n    )\n    from server.services.ralph_service import ralph_service\n\n    defaults = get_ralph_defaults()\n    provider = provider or defaults[\"provider\"]\n    model = model or defaults[\"model\"]\n    iterations = iterations or defaults[\"iterations\"]\n\n    if mode not in (\"plan\", \"build\"):\n        raise ToolError(f\"Invalid mode: {mode}. Must be 'plan' or 'build'.\")\n\n    provider_obj = get_provider_by_name(provider)\n    if not provider_obj:\n        raise ToolError(f\"Provider not found: {provider}\")\n\n    available = {p.get(\"name\"): p for p in get_ralph_providers()}\n    provider_entry = available.get(provider)\n    if not provider_entry:\n        raise ToolError(f\"Provider not available for ralph: {provider}\")\n\n    model_entries = provider_entry.get(\"models\", []) or []\n    available_models: list[str] = []\n    for entry in model_entries:\n        if isinstance(entry, dict):\n            if \"id\" in entry and entry[\"id\"]:\n                available_models.append(entry[\"id\"])\n            elif \"name\" in entry and entry[\"name\"]:\n                available_models.append(entry[\"name\"])\n        elif isinstance(entry, str):\n            available_models.append(entry)\n\n    if available_models and model not in available_models:\n        raise ToolError(\n            f\"Model not available for provider {provider}: {model}. \"\n            f\"Available models: {', '.join(available_models)}\"\n        )\n    if not available_models:\n        raise ToolError(f\"No models available for provider: {provider}\")\n\n    project_root = Path.cwd()\n    try:\n        job = ralph_service.create_job(\n            project_root, slug, mode, task_description,\n            provider_obj, model, iterations,\n            sandbox=sandbox,\n        )\n    except Exception as e:\n        raise ToolError(str(e))\n    working_dir = project_root / \".vista\" / \"ralph\" / job.get(\"slug\", slug)\n    result = dict(job)\n    result[\"working_dir\"] = str(working_dir)\n    return result\n\n\n@mcp.tool\ndef ralph_status(job_id: str) -> dict:\n    \"\"\"Check the status and progress of a ralph job.\n\n    Returns lightweight status information. For a detailed AI-generated summary,\n    use ralph_summary instead.\n\n    :param job_id: The job ID returned by ralph_start\n    \"\"\"\n    from server.services.ralph_service import ralph_service\n\n    project_root = Path.cwd()\n    job = ralph_service.get_job_status(project_root, job_id)\n    if not job:\n        raise ToolError(f\"Job not found: {job_id}\")\n\n    elapsed_time = None\n    started_at = job.get(\"started_at\") or job.get(\"created_at\")\n    if isinstance(started_at, str):\n        try:\n            started_dt = datetime.fromisoformat(started_at)\n            elapsed_time = int(\n                (datetime.now(timezone.utc) - started_dt).total_seconds()\n            )\n        except ValueError:\n            elapsed_time = None\n\n    last_progress = job.get(\"progress_tail\") or []\n    return {\n        \"job_id\": job.get(\"job_id\"),\n        \"status\": job.get(\"status\"),\n        \"current_iteration\": job.get(\"current_iteration\", 0),\n        \"total_iterations\": job.get(\"iterations\", 0),\n        \"last_progress_lines\": last_progress,\n        \"elapsed_time\": elapsed_time,\n        \"progress_tail\": last_progress,\n        \"slug\": job.get(\"slug\"),\n        \"mode\": job.get(\"mode\"),\n        \"provider\": job.get(\"provider\"),\n        \"model\": job.get(\"model\"),\n        \"pid\": job.get(\"pid\"),\n        \"error\": job.get(\"error\"),\n    }\n\n\n@mcp.tool\ndef ralph_summary(job_id: str) -> dict:\n    \"\"\"Get an AI-generated summary of a ralph job's artifacts.\n\n    Spawns a summarizer agent that reads the job's progress.txt,\n    IMPLEMENTATION_PLAN.md, and git log, then returns a structured summary.\n    Works for both running and completed jobs.\n\n    This is more expensive than ralph_status - use it when you need\n    a detailed understanding of what the loop accomplished or is working on.\n\n    :param job_id: The job ID returned by ralph_start\n    \"\"\"\n    from server.services.summarizer_service import summarizer_service\n\n    project_root = Path.cwd()\n    return summarizer_service.run_summarizer(project_root, job_id)\n\n\n@mcp.tool\ndef ralph_stop(job_id: str) -> dict:\n    \"\"\"Stop a running ralph loop.\n\n    Sends a termination signal to the loop subprocess and updates the job status.\n\n    :param job_id: The job ID returned by ralph_start\n    \"\"\"\n    from server.services.ralph_service import ralph_service\n\n    project_root = Path.cwd()\n    job = ralph_service.stop_job(project_root, job_id)\n    if not job:\n        raise ToolError(f\"Job not found: {job_id}\")\n    return {\n        \"job_id\": job.get(\"job_id\"),\n        \"status\": job.get(\"status\"),\n        \"message\": \"Job stopped\",\n        \"slug\": job.get(\"slug\"),\n        \"provider\": job.get(\"provider\"),\n        \"model\": job.get(\"model\"),\n    }\n\n\n# ---------------------------------------------------------------------------\n# Entry point\n# ---------------------------------------------------------------------------\nif __name__ == \"__main__\":\n    mcp.run(transport=\"stdio\")\n","numLines":1126,"startLine":1,"totalLines":1126}}}
