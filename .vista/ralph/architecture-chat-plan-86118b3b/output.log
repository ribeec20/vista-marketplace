{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011kQK88AkAaZV2gZ4MqSGYR","type":"tool_result","content":"     1→import { Hono } from \"hono\";\n     2→import { execSync } from \"node:child_process\";\n     3→import { readdir, readFile, writeFile, stat } from \"node:fs/promises\";\n     4→import { resolve, join, dirname } from \"node:path\";\n     5→import { homedir } from \"node:os\";\n     6→import { existsSync, readFileSync } from \"node:fs\";\n     7→import type { CliLauncher } from \"./cli-launcher.js\";\n     8→import type { WsBridge } from \"./ws-bridge.js\";\n     9→import type { SessionStore } from \"./session-store.js\";\n    10→import type { WorktreeTracker } from \"./worktree-tracker.js\";\n    11→import * as envManager from \"./env-manager.js\";\n    12→import * as gitUtils from \"./git-utils.js\";\n    13→import * as sessionNames from \"./session-names.js\";\n    14→import { containerManager, type ContainerConfig, type ContainerInfo } from \"./container-manager.js\";\n    15→import { DEFAULT_OPENROUTER_MODEL, getSettings, updateSettings } from \"./settings-manager.js\";\n    16→import { getUsageLimits } from \"./usage-limits.js\";\n    17→import {\n    18→  getUpdateState,\n    19→  checkForUpdate,\n    20→  isUpdateAvailable,\n    21→  setUpdateInProgress,\n    22→} from \"./update-checker.js\";\n    23→\n    24→function execCaptureStdout(\n    25→  command: string,\n    26→  options: { cwd: string; encoding: \"utf-8\"; timeout: number },\n    27→): string {\n    28→  try {\n    29→    return execSync(command, options);\n    30→  } catch (err: unknown) {\n    31→    const maybe = err as { stdout?: Buffer | string };\n    32→    if (typeof maybe.stdout === \"string\") return maybe.stdout;\n    33→    if (maybe.stdout && Buffer.isBuffer(maybe.stdout)) {\n    34→      return maybe.stdout.toString(\"utf-8\");\n    35→    }\n    36→    throw err;\n    37→  }\n    38→}\n    39→\n    40→export function createRoutes(\n    41→  launcher: CliLauncher,\n    42→  wsBridge: WsBridge,\n    43→  sessionStore: SessionStore,\n    44→  worktreeTracker: WorktreeTracker,\n    45→) {\n    46→  const api = new Hono();\n    47→\n    48→  // ─── SDK Sessions (--sdk-url) ─────────────────────────────────────\n    49→\n    50→  api.post(\"/sessions/create\", async (c) => {\n    51→    const body = await c.req.json().catch(() => ({}));\n    52→    try {\n    53→      const backend = body.backend ?? \"claude\";\n    54→      if (backend !== \"claude\" && backend !== \"codex\") {\n    55→        return c.json({ error: `Invalid backend: ${String(backend)}` }, 400);\n    56→      }\n    57→\n    58→      // Resolve environment variables from envSlug\n    59→      let envVars: Record<string, string> | undefined = body.env;\n    60→      if (body.envSlug) {\n    61→        const companionEnv = envManager.getEnv(body.envSlug);\n    62→        if (companionEnv) {\n    63→          console.log(\n    64→            `[routes] Injecting env \"${companionEnv.name}\" (${Object.keys(companionEnv.variables).length} vars):`,\n    65→            Object.keys(companionEnv.variables).join(\", \"),\n    66→          );\n    67→          envVars = { ...companionEnv.variables, ...body.env };\n    68→        } else {\n    69→          console.warn(\n    70→            `[routes] Environment \"${body.envSlug}\" not found, ignoring`,\n    71→          );\n    72→        }\n    73→      }\n    74→\n    75→      let cwd = body.cwd;\n    76→      let worktreeInfo:\n    77→        | {\n    78→            isWorktree: boolean;\n    79→            repoRoot: string;\n    80→            branch: string;\n    81→            actualBranch: string;\n    82→            worktreePath: string;\n    83→          }\n    84→        | undefined;\n    85→\n    86→      // If worktree is requested, set up a worktree for the selected branch\n    87→      if (body.useWorktree && body.branch && cwd) {\n    88→        const repoInfo = gitUtils.getRepoInfo(cwd);\n    89→        if (repoInfo) {\n    90→          const result = gitUtils.ensureWorktree(\n    91→            repoInfo.repoRoot,\n    92→            body.branch,\n    93→            {\n    94→              baseBranch: repoInfo.defaultBranch,\n    95→              createBranch: body.createBranch,\n    96→              forceNew: true,\n    97→            },\n    98→          );\n    99→          cwd = result.worktreePath;\n   100→          worktreeInfo = {\n   101→            isWorktree: true,\n   102→            repoRoot: repoInfo.repoRoot,\n   103→            branch: body.branch,\n   104→            actualBranch: result.actualBranch,\n   105→            worktreePath: result.worktreePath,\n   106→          };\n   107→        }\n   108→      } else if (body.branch && cwd) {\n   109→        // Non-worktree: checkout the selected branch in-place\n   110→        const repoInfo = gitUtils.getRepoInfo(cwd);\n   111→        if (repoInfo) {\n   112→          const fetchResult = gitUtils.gitFetch(repoInfo.repoRoot);\n   113→          if (!fetchResult.success) {\n   114→            throw new Error(`git fetch failed before session create: ${fetchResult.output}`);\n   115→          }\n   116→\n   117→          if (repoInfo.currentBranch !== body.branch) {\n   118→            gitUtils.checkoutBranch(repoInfo.repoRoot, body.branch);\n   119→          }\n   120→\n   121→          const pullResult = gitUtils.gitPull(repoInfo.repoRoot);\n   122→          if (!pullResult.success) {\n   123→            throw new Error(`git pull failed before session create: ${pullResult.output}`);\n   124→          }\n   125→        }\n   126→      }\n   127→\n   128→      // If container mode requested, create and start the container\n   129→      let containerInfo: ContainerInfo | undefined;\n   130→      if (body.container && backend === \"claude\") {\n   131→        const cConfig: ContainerConfig = {\n   132→          image: body.container.image || \"companion-dev:latest\",\n   133→          ports: Array.isArray(body.container.ports)\n   134→            ? body.container.ports.map(Number).filter((n: number) => n > 0)\n   135→            : [],\n   136→          volumes: body.container.volumes,\n   137→          env: body.container.env,\n   138→        };\n   139→        // Use cwd-based name since we don't have sessionId yet\n   140→        const containerId = crypto.randomUUID().slice(0, 8);\n   141→        containerInfo = containerManager.createContainer(containerId, cwd, cConfig);\n   142→      }\n   143→\n   144→      const session = launcher.launch({\n   145→        model: body.model,\n   146→        permissionMode: body.permissionMode,\n   147→        cwd,\n   148→        claudeBinary: body.claudeBinary,\n   149→        codexBinary: body.codexBinary,\n   150→        codexInternetAccess: backend === \"codex\" && body.codexInternetAccess === true,\n   151→        codexSandbox: backend === \"codex\" && body.codexInternetAccess === true\n   152→          ? \"danger-full-access\"\n   153→          : \"workspace-write\",\n   154→        allowedTools: body.allowedTools,\n   155→        env: envVars,\n   156→        backendType: backend,\n   157→        worktreeInfo,\n   158→      });\n   159→\n   160→      // Re-track container with real session ID\n   161→      if (containerInfo) {\n   162→        // The container was created with a temp ID; re-register under the real session ID\n   163→        containerManager.retrack(containerInfo.containerId, session.sessionId);\n   164→      }\n   165→\n   166→      // Track the worktree mapping\n   167→      if (worktreeInfo) {\n   168→        worktreeTracker.addMapping({\n   169→          sessionId: session.sessionId,\n   170→          repoRoot: worktreeInfo.repoRoot,\n   171→          branch: worktreeInfo.branch,\n   172→          actualBranch: worktreeInfo.actualBranch,\n   173→          worktreePath: worktreeInfo.worktreePath,\n   174→          createdAt: Date.now(),\n   175→        });\n   176→      }\n   177→\n   178→      return c.json(session);\n   179→    } catch (e: unknown) {\n   180→      const msg = e instanceof Error ? e.message : String(e);\n   181→      console.error(\"[routes] Failed to create session:\", msg);\n   182→      return c.json({ error: msg }, 500);\n   183→    }\n   184→  });\n   185→\n   186→  api.get(\"/sessions\", (c) => {\n   187→    const sessions = launcher.listSessions();\n   188→    const names = sessionNames.getAllNames();\n   189→    const bridgeStates = wsBridge.getAllSessions();\n   190→    const bridgeMap = new Map(bridgeStates.map((s) => [s.session_id, s]));\n   191→    const enriched = sessions.map((s) => {\n   192→      const bridge = bridgeMap.get(s.sessionId);\n   193→      return {\n   194→        ...s,\n   195→        name: names[s.sessionId] ?? s.name,\n   196→        gitBranch: bridge?.git_branch || \"\",\n   197→        gitAhead: bridge?.git_ahead || 0,\n   198→        gitBehind: bridge?.git_behind || 0,\n   199→        totalLinesAdded: bridge?.total_lines_added || 0,\n   200→        totalLinesRemoved: bridge?.total_lines_removed || 0,\n   201→      };\n   202→    });\n   203→    return c.json(enriched);\n   204→  });\n   205→\n   206→  api.get(\"/sessions/:id\", (c) => {\n   207→    const id = c.req.param(\"id\");\n   208→    const session = launcher.getSession(id);\n   209→    if (!session) return c.json({ error: \"Session not found\" }, 404);\n   210→    return c.json(session);\n   211→  });\n   212→\n   213→  api.patch(\"/sessions/:id/name\", async (c) => {\n   214→    const id = c.req.param(\"id\");\n   215→    const body = await c.req.json().catch(() => ({}));\n   216→    if (typeof body.name !== \"string\" || !body.name.trim()) {\n   217→      return c.json({ error: \"name is required\" }, 400);\n   218→    }\n   219→    const session = launcher.getSession(id);\n   220→    if (!session) return c.json({ error: \"Session not found\" }, 404);\n   221→    sessionNames.setName(id, body.name.trim());\n   222→    return c.json({ ok: true, name: body.name.trim() });\n   223→  });\n   224→\n   225→  api.post(\"/sessions/:id/kill\", async (c) => {\n   226→    const id = c.req.param(\"id\");\n   227→    const killed = await launcher.kill(id);\n   228→    if (!killed)\n   229→      return c.json({ error: \"Session not found or already exited\" }, 404);\n   230→\n   231→    // Clean up container if any\n   232→    containerManager.removeContainer(id);\n   233→\n   234→    return c.json({ ok: true });\n   235→  });\n   236→\n   237→  api.post(\"/sessions/:id/relaunch\", async (c) => {\n   238→    const id = c.req.param(\"id\");\n   239→    const ok = await launcher.relaunch(id);\n   240→    if (!ok) return c.json({ error: \"Session not found\" }, 404);\n   241→    return c.json({ ok: true });\n   242→  });\n   243→\n   244→  api.delete(\"/sessions/:id\", async (c) => {\n   245→    const id = c.req.param(\"id\");\n   246→    await launcher.kill(id);\n   247→\n   248→    // Clean up container if any\n   249→    containerManager.removeContainer(id);\n   250→\n   251→    // Clean up worktree if no other sessions use it (force: delete is destructive)\n   252→    const worktreeResult = cleanupWorktree(id, true);\n   253→\n   254→    launcher.removeSession(id);\n   255→    wsBridge.closeSession(id);\n   256→    return c.json({ ok: true, worktree: worktreeResult });\n   257→  });\n   258→\n   259→  api.post(\"/sessions/:id/archive\", async (c) => {\n   260→    const id = c.req.param(\"id\");\n   261→    const body = await c.req.json().catch(() => ({}));\n   262→    await launcher.kill(id);\n   263→\n   264→    // Clean up container if any\n   265→    containerManager.removeContainer(id);\n   266→\n   267→    // Clean up worktree if no other sessions use it\n   268→    const worktreeResult = cleanupWorktree(id, body.force);\n   269→\n   270→    launcher.setArchived(id, true);\n   271→    sessionStore.setArchived(id, true);\n   272→    return c.json({ ok: true, worktree: worktreeResult });\n   273→  });\n   274→\n   275→  api.post(\"/sessions/:id/unarchive\", (c) => {\n   276→    const id = c.req.param(\"id\");\n   277→    launcher.setArchived(id, false);\n   278→    sessionStore.setArchived(id, false);\n   279→    return c.json({ ok: true });\n   280→  });\n   281→\n   282→  // ─── Available backends ─────────────────────────────────────\n   283→\n   284→  api.get(\"/backends\", (c) => {\n   285→    const backends: Array<{ id: string; name: string; available: boolean }> = [];\n   286→\n   287→    // Check Claude Code\n   288→    let claudeAvailable = false;\n   289→    try {\n   290→      execSync(\"which claude\", { encoding: \"utf-8\", timeout: 3000 });\n   291→      claudeAvailable = true;\n   292→    } catch {}\n   293→    backends.push({ id: \"claude\", name: \"Claude Code\", available: claudeAvailable });\n   294→\n   295→    // Check Codex\n   296→    let codexAvailable = false;\n   297→    try {\n   298→      execSync(\"which codex\", { encoding: \"utf-8\", timeout: 3000 });\n   299→      codexAvailable = true;\n   300→    } catch {}\n   301→    backends.push({ id: \"codex\", name: \"Codex\", available: codexAvailable });\n   302→\n   303→    return c.json(backends);\n   304→  });\n   305→\n   306→  api.get(\"/backends/:id/models\", (c) => {\n   307→    const backendId = c.req.param(\"id\");\n   308→\n   309→    if (backendId === \"codex\") {\n   310→      // Read Codex model list from its local cache file\n   311→      const cachePath = join(homedir(), \".codex\", \"models_cache.json\");\n   312→      if (!existsSync(cachePath)) {\n   313→        return c.json({ error: \"Codex models cache not found. Run codex once to populate it.\" }, 404);\n   314→      }\n   315→      try {\n   316→        const raw = readFileSync(cachePath, \"utf-8\");\n   317→        const cache = JSON.parse(raw) as {\n   318→          models: Array<{\n   319→            slug: string;\n   320→            display_name?: string;\n   321→            description?: string;\n   322→            visibility?: string;\n   323→            priority?: number;\n   324→          }>;\n   325→        };\n   326→        // Only return visible models, sorted by priority\n   327→        const models = cache.models\n   328→          .filter((m) => m.visibility === \"list\")\n   329→          .sort((a, b) => (a.priority ?? 99) - (b.priority ?? 99))\n   330→          .map((m) => ({\n   331→            value: m.slug,\n   332→            label: m.display_name || m.slug,\n   333→            description: m.description || \"\",\n   334→          }));\n   335→        return c.json(models);\n   336→      } catch (e) {\n   337→        return c.json({ error: \"Failed to parse Codex models cache\" }, 500);\n   338→      }\n   339→    }\n   340→\n   341→    // Claude models are hardcoded on the frontend\n   342→    return c.json({ error: \"Use frontend defaults for this backend\" }, 404);\n   343→  });\n   344→\n   345→  // ─── Containers ─────────────────────────────────────────────────\n   346→\n   347→  api.get(\"/containers/status\", (c) => {\n   348→    const available = containerManager.checkDocker();\n   349→    const version = containerManager.getDockerVersion();\n   350→    return c.json({ available, version });\n   351→  });\n   352→\n   353→  api.get(\"/containers/images\", (c) => {\n   354→    const images = containerManager.listImages();\n   355→    return c.json(images);\n   356→  });\n   357→\n   358→  // ─── Filesystem browsing ─────────────────────────────────────\n   359→\n   360→  api.get(\"/fs/list\", async (c) => {\n   361→    const rawPath = c.req.query(\"path\") || homedir();\n   362→    const basePath = resolve(rawPath);\n   363→    try {\n   364→      const entries = await readdir(basePath, { withFileTypes: true });\n   365→      const dirs: { name: string; path: string }[] = [];\n   366→      for (const entry of entries) {\n   367→        if (entry.isDirectory() && !entry.name.startsWith(\".\")) {\n   368→          dirs.push({ name: entry.name, path: join(basePath, entry.name) });\n   369→        }\n   370→      }\n   371→      dirs.sort((a, b) => a.name.localeCompare(b.name));\n   372→      return c.json({ path: basePath, dirs, home: homedir() });\n   373→    } catch {\n   374→      return c.json(\n   375→        {\n   376→          error: \"Cannot read directory\",\n   377→          path: basePath,\n   378→          dirs: [],\n   379→          home: homedir(),\n   380→        },\n   381→        400,\n   382→      );\n   383→    }\n   384→  });\n   385→\n   386→  api.get(\"/fs/home\", (c) => {\n   387→    const home = homedir();\n   388→    const cwd = process.cwd();\n   389→    // Only report cwd if the user launched companion from a real project directory\n   390→    // (not from the package root or the home directory itself)\n   391→    const packageRoot = process.env.__COMPANION_PACKAGE_ROOT;\n   392→    const isProjectDir =\n   393→      cwd !== home &&\n   394→      (!packageRoot || !cwd.startsWith(packageRoot));\n   395→    return c.json({ home, cwd: isProjectDir ? cwd : home });\n   396→  });\n   397→\n   398→  // ─── Editor filesystem APIs ─────────────────────────────────────\n   399→\n   400→  /** Recursive directory tree for the editor file explorer */\n   401→  api.get(\"/fs/tree\", async (c) => {\n   402→    const rawPath = c.req.query(\"path\");\n   403→    if (!rawPath) return c.json({ error: \"path required\" }, 400);\n   404→    const basePath = resolve(rawPath);\n   405→\n   406→    interface TreeNode {\n   407→      name: string;\n   408→      path: string;\n   409→      type: \"file\" | \"directory\";\n   410→      children?: TreeNode[];\n   411→    }\n   412→\n   413→    async function buildTree(dir: string, depth: number): Promise<TreeNode[]> {\n   414→      if (depth > 10) return []; // Safety limit\n   415→      try {\n   416→        const entries = await readdir(dir, { withFileTypes: true });\n   417→        const nodes: TreeNode[] = [];\n   418→        for (const entry of entries) {\n   419→          if (entry.name.startsWith(\".\") || entry.name === \"node_modules\")\n   420→            continue;\n   421→          const fullPath = join(dir, entry.name);\n   422→          if (entry.isDirectory()) {\n   423→            const children = await buildTree(fullPath, depth + 1);\n   424→            nodes.push({\n   425→              name: entry.name,\n   426→              path: fullPath,\n   427→              type: \"directory\",\n   428→              children,\n   429→            });\n   430→          } else if (entry.isFile()) {\n   431→            nodes.push({ name: entry.name, path: fullPath, type: \"file\" });\n   432→          }\n   433→        }\n   434→        nodes.sort((a, b) => {\n   435→          if (a.type !== b.type) return a.type === \"directory\" ? -1 : 1;\n   436→          return a.name.localeCompare(b.name);\n   437→        });\n   438→        return nodes;\n   439→      } catch {\n   440→        return [];\n   441→      }\n   442→    }\n   443→\n   444→    const tree = await buildTree(basePath, 0);\n   445→    return c.json({ path: basePath, tree });\n   446→  });\n   447→\n   448→  /** Read a single file */\n   449→  api.get(\"/fs/read\", async (c) => {\n   450→    const filePath = c.req.query(\"path\");\n   451→    if (!filePath) return c.json({ error: \"path required\" }, 400);\n   452→    const absPath = resolve(filePath);\n   453→    try {\n   454→      const info = await stat(absPath);\n   455→      if (info.size > 2 * 1024 * 1024) {\n   456→        return c.json({ error: \"File too large (>2MB)\" }, 413);\n   457→      }\n   458→      const content = await readFile(absPath, \"utf-8\");\n   459→      return c.json({ path: absPath, content });\n   460→    } catch (e: unknown) {\n   461→      return c.json(\n   462→        { error: e instanceof Error ? e.message : \"Cannot read file\" },\n   463→        404,\n   464→      );\n   465→    }\n   466→  });\n   467→\n   468→  /** Write a single file */\n   469→  api.put(\"/fs/write\", async (c) => {\n   470→    const body = await c.req.json().catch(() => ({}));\n   471→    const { path: filePath, content } = body;\n   472→    if (!filePath || typeof content !== \"string\") {\n   473→      return c.json({ error: \"path and content required\" }, 400);\n   474→    }\n   475→    const absPath = resolve(filePath);\n   476→    try {\n   477→      await writeFile(absPath, content, \"utf-8\");\n   478→      return c.json({ ok: true, path: absPath });\n   479→    } catch (e: unknown) {\n   480→      return c.json(\n   481→        { error: e instanceof Error ? e.message : \"Cannot write file\" },\n   482→        500,\n   483→      );\n   484→    }\n   485→  });\n   486→\n   487→  /** Git diff for a single file (unified diff) */\n   488→  api.get(\"/fs/diff\", (c) => {\n   489→    const filePath = c.req.query(\"path\");\n   490→    if (!filePath) return c.json({ error: \"path required\" }, 400);\n   491→    const absPath = resolve(filePath);\n   492→    try {\n   493→      const repoRoot = execSync(\"git rev-parse --show-toplevel\", {\n   494→        cwd: dirname(absPath),\n   495→        encoding: \"utf-8\",\n   496→        timeout: 5000,\n   497→      }).trim();\n   498→      const relPath = execSync(`git -C \"${repoRoot}\" ls-files --full-name -- \"${absPath}\"`, {\n   499→        encoding: \"utf-8\",\n   500→        timeout: 5000,\n   501→      }).trim() || absPath;\n   502→\n   503→      let diff = execCaptureStdout(`git diff HEAD -- \"${relPath}\"`, {\n   504→        cwd: repoRoot,\n   505→        encoding: \"utf-8\",\n   506→        timeout: 5000,\n   507→      });\n   508→\n   509→      // For untracked files, HEAD diff is empty. Show full file as added.\n   510→      if (!diff.trim()) {\n   511→        const untracked = execSync(`git ls-files --others --exclude-standard -- \"${relPath}\"`, {\n   512→          cwd: repoRoot,\n   513→          encoding: \"utf-8\",\n   514→          timeout: 5000,\n   515→        }).trim();\n   516→        if (untracked) {\n   517→          diff = execCaptureStdout(`git diff --no-index -- /dev/null \"${absPath}\"`, {\n   518→            cwd: repoRoot,\n   519→            encoding: \"utf-8\",\n   520→            timeout: 5000,\n   521→          });\n   522→        }\n   523→      }\n   524→\n   525→      return c.json({ path: absPath, diff });\n   526→    } catch {\n   527→      return c.json({ path: absPath, diff: \"\" });\n   528→    }\n   529→  });\n   530→\n   531→  /** Find CLAUDE.md files for a project (root + .claude/) */\n   532→  api.get(\"/fs/claude-md\", async (c) => {\n   533→    const cwd = c.req.query(\"cwd\");\n   534→    if (!cwd) return c.json({ error: \"cwd required\" }, 400);\n   535→\n   536→    // Resolve to absolute path to prevent path traversal\n   537→    const resolvedCwd = resolve(cwd);\n   538→\n   539→    const candidates = [\n   540→      join(resolvedCwd, \"CLAUDE.md\"),\n   541→      join(resolvedCwd, \".claude\", \"CLAUDE.md\"),\n   542→    ];\n   543→\n   544→    const files: { path: string; content: string }[] = [];\n   545→    for (const p of candidates) {\n   546→      try {\n   547→        const content = await readFile(p, \"utf-8\");\n   548→        files.push({ path: p, content });\n   549→      } catch {\n   550→        // file doesn't exist — skip\n   551→      }\n   552→    }\n   553→\n   554→    return c.json({ cwd: resolvedCwd, files });\n   555→  });\n   556→\n   557→  /** Create or update a CLAUDE.md file */\n   558→  api.put(\"/fs/claude-md\", async (c) => {\n   559→    const body = await c.req.json().catch(() => ({}));\n   560→    const { path: filePath, content } = body;\n   561→    if (!filePath || typeof content !== \"string\") {\n   562→      return c.json({ error: \"path and content required\" }, 400);\n   563→    }\n   564→    // Only allow writing CLAUDE.md files\n   565→    const base = filePath.split(\"/\").pop();\n   566→    if (base !== \"CLAUDE.md\") {\n   567→      return c.json({ error: \"Can only write CLAUDE.md files\" }, 400);\n   568→    }\n   569→    const absPath = resolve(filePath);\n   570→    // Verify the resolved path ends with CLAUDE.md or .claude/CLAUDE.md\n   571→    if (!absPath.endsWith(\"/CLAUDE.md\") && !absPath.endsWith(\"/.claude/CLAUDE.md\")) {\n   572→      return c.json({ error: \"Invalid CLAUDE.md path\" }, 400);\n   573→    }\n   574→    try {\n   575→      // Ensure parent directory exists\n   576→      const { mkdir } = await import(\"node:fs/promises\");\n   577→      await mkdir(dirname(absPath), { recursive: true });\n   578→      await writeFile(absPath, content, \"utf-8\");\n   579→      return c.json({ ok: true, path: absPath });\n   580→    } catch (e: unknown) {\n   581→      return c.json(\n   582→        { error: e instanceof Error ? e.message : \"Cannot write file\" },\n   583→        500,\n   584→      );\n   585→    }\n   586→  });\n   587→\n   588→  // ─── Environments (~/.companion/envs/) ────────────────────────────\n   589→\n   590→  api.get(\"/envs\", (c) => {\n   591→    try {\n   592→      return c.json(envManager.listEnvs());\n   593→    } catch (e: unknown) {\n   594→      return c.json({ error: e instanceof Error ? e.message : String(e) }, 500);\n   595→    }\n   596→  });\n   597→\n   598→  api.get(\"/envs/:slug\", (c) => {\n   599→    const env = envManager.getEnv(c.req.param(\"slug\"));\n   600→    if (!env) return c.json({ error: \"Environment not found\" }, 404);\n   601→    return c.json(env);\n   602→  });\n   603→\n   604→  api.post(\"/envs\", async (c) => {\n   605→    const body = await c.req.json().catch(() => ({}));\n   606→    try {\n   607→      const env = envManager.createEnv(body.name, body.variables || {});\n   608→      return c.json(env, 201);\n   609→    } catch (e: unknown) {\n   610→      return c.json({ error: e instanceof Error ? e.message : String(e) }, 400);\n   611→    }\n   612→  });\n   613→\n   614→  api.put(\"/envs/:slug\", async (c) => {\n   615→    const slug = c.req.param(\"slug\");\n   616→    const body = await c.req.json().catch(() => ({}));\n   617→    try {\n   618→      const env = envManager.updateEnv(slug, {\n   619→        name: body.name,\n   620→        variables: body.variables,\n   621→      });\n   622→      if (!env) return c.json({ error: \"Environment not found\" }, 404);\n   623→      return c.json(env);\n   624→    } catch (e: unknown) {\n   625→      return c.json({ error: e instanceof Error ? e.message : String(e) }, 400);\n   626→    }\n   627→  });\n   628→\n   629→  api.delete(\"/envs/:slug\", (c) => {\n   630→    const deleted = envManager.deleteEnv(c.req.param(\"slug\"));\n   631→    if (!deleted) return c.json({ error: \"Environment not found\" }, 404);\n   632→    return c.json({ ok: true });\n   633→  });\n   634→\n   635→  // ─── Settings (~/.companion/settings.json) ────────────────────────\n   636→\n   637→  api.get(\"/settings\", (c) => {\n   638→    const settings = getSettings();\n   639→    return c.json({\n   640→      openrouterApiKeyConfigured: !!settings.openrouterApiKey.trim(),\n   641→      openrouterModel: settings.openrouterModel || DEFAULT_OPENROUTER_MODEL,\n   642→    });\n   643→  });\n   644→\n   645→  api.put(\"/settings\", async (c) => {\n   646→    const body = await c.req.json().catch(() => ({}));\n   647→    if (body.openrouterApiKey !== undefined && typeof body.openrouterApiKey !== \"string\") {\n   648→      return c.json({ error: \"openrouterApiKey must be a string\" }, 400);\n   649→    }\n   650→    if (body.openrouterModel !== undefined && typeof body.openrouterModel !== \"string\") {\n   651→      return c.json({ error: \"openrouterModel must be a string\" }, 400);\n   652→    }\n   653→    if (body.openrouterApiKey === undefined && body.openrouterModel === undefined) {\n   654→      return c.json({ error: \"At least one settings field is required\" }, 400);\n   655→    }\n   656→\n   657→    const settings = updateSettings({\n   658→      openrouterApiKey:\n   659→        typeof body.openrouterApiKey === \"string\"\n   660→          ? body.openrouterApiKey.trim()\n   661→          : undefined,\n   662→      openrouterModel:\n   663→        typeof body.openrouterModel === \"string\"\n   664→          ? (body.openrouterModel.trim() || DEFAULT_OPENROUTER_MODEL)\n   665→          : undefined,\n   666→    });\n   667→\n   668→    return c.json({\n   669→      openrouterApiKeyConfigured: !!settings.openrouterApiKey.trim(),\n   670→      openrouterModel: settings.openrouterModel || DEFAULT_OPENROUTER_MODEL,\n   671→    });\n   672→  });\n   673→\n   674→  // ─── Git operations ─────────────────────────────────────────────────\n   675→\n   676→  api.get(\"/git/repo-info\", (c) => {\n   677→    const path = c.req.query(\"path\");\n   678→    if (!path) return c.json({ error: \"path required\" }, 400);\n   679→    const info = gitUtils.getRepoInfo(path);\n   680→    if (!info) return c.json({ error: \"Not a git repository\" }, 400);\n   681→    return c.json(info);\n   682→  });\n   683→\n   684→  api.get(\"/git/branches\", (c) => {\n   685→    const repoRoot = c.req.query(\"repoRoot\");\n   686→    if (!repoRoot) return c.json({ error: \"repoRoot required\" }, 400);\n   687→    try {\n   688→      return c.json(gitUtils.listBranches(repoRoot));\n   689→    } catch (e: unknown) {\n   690→      return c.json({ error: e instanceof Error ? e.message : String(e) }, 500);\n   691→    }\n   692→  });\n   693→\n   694→  api.get(\"/git/worktrees\", (c) => {\n   695→    const repoRoot = c.req.query(\"repoRoot\");\n   696→    if (!repoRoot) return c.json({ error: \"repoRoot required\" }, 400);\n   697→    try {\n   698→      return c.json(gitUtils.listWorktrees(repoRoot));\n   699→    } catch (e: unknown) {\n   700→      return c.json({ error: e instanceof Error ? e.message : String(e) }, 500);\n   701→    }\n   702→  });\n   703→\n   704→  api.post(\"/git/worktree\", async (c) => {\n   705→    const body = await c.req.json().catch(() => ({}));\n   706→    const { repoRoot, branch, baseBranch, createBranch } = body;\n   707→    if (!repoRoot || !branch)\n   708→      return c.json({ error: \"repoRoot and branch required\" }, 400);\n   709→    try {\n   710→      const result = gitUtils.ensureWorktree(repoRoot, branch, {\n   711→        baseBranch,\n   712→        createBranch,\n   713→      });\n   714→      return c.json(result);\n   715→    } catch (e: unknown) {\n   716→      return c.json({ error: e instanceof Error ? e.message : String(e) }, 500);\n   717→    }\n   718→  });\n   719→\n   720→  api.delete(\"/git/worktree\", async (c) => {\n   721→    const body = await c.req.json().catch(() => ({}));\n   722→    const { repoRoot, worktreePath, force } = body;\n   723→    if (!repoRoot || !worktreePath)\n   724→      return c.json({ error: \"repoRoot and worktreePath required\" }, 400);\n   725→    const result = gitUtils.removeWorktree(repoRoot, worktreePath, { force });\n   726→    return c.json(result);\n   727→  });\n   728→\n   729→  api.post(\"/git/fetch\", async (c) => {\n   730→    const body = await c.req.json().catch(() => ({}));\n   731→    const { repoRoot } = body;\n   732→    if (!repoRoot) return c.json({ error: \"repoRoot required\" }, 400);\n   733→    return c.json(gitUtils.gitFetch(repoRoot));\n   734→  });\n   735→\n   736→  api.post(\"/git/pull\", async (c) => {\n   737→    const body = await c.req.json().catch(() => ({}));\n   738→    const { cwd } = body;\n   739→    if (!cwd) return c.json({ error: \"cwd required\" }, 400);\n   740→    const result = gitUtils.gitPull(cwd);\n   741→    // Return refreshed ahead/behind counts\n   742→    let git_ahead = 0,\n   743→      git_behind = 0;\n   744→    try {\n   745→      const counts = execSync(\n   746→        \"git rev-list --left-right --count @{upstream}...HEAD\",\n   747→        {\n   748→          cwd,\n   749→          encoding: \"utf-8\",\n   750→          timeout: 3000,\n   751→        },\n   752→      ).trim();\n   753→      const [behind, ahead] = counts.split(/\\s+/).map(Number);\n   754→      git_ahead = ahead || 0;\n   755→      git_behind = behind || 0;\n   756→    } catch {\n   757→      /* no upstream */\n   758→    }\n   759→    return c.json({ ...result, git_ahead, git_behind });\n   760→  });\n   761→\n   762→  // ─── GitHub PR Status ────────────────────────────────────────────────\n   763→\n   764→  api.get(\"/git/pr-status\", async (c) => {\n   765→    const cwd = c.req.query(\"cwd\");\n   766→    const branch = c.req.query(\"branch\");\n   767→    if (!cwd || !branch) return c.json({ error: \"cwd and branch required\" }, 400);\n   768→\n   769→    const { isGhAvailable, fetchPRInfo } = await import(\"./github-pr.js\");\n   770→    if (!isGhAvailable()) {\n   771→      return c.json({ available: false, pr: null });\n   772→    }\n   773→\n   774→    const pr = await fetchPRInfo(cwd, branch);\n   775→    return c.json({ available: true, pr });\n   776→  });\n   777→\n   778→  // ─── Usage Limits ─────────────────────────────────────────────────────\n   779→\n   780→  api.get(\"/usage-limits\", async (c) => {\n   781→    const limits = await getUsageLimits();\n   782→    return c.json(limits);\n   783→  });\n   784→\n   785→  api.get(\"/sessions/:id/usage-limits\", async (c) => {\n   786→    const sessionId = c.req.param(\"id\");\n   787→    const session = wsBridge.getSession(sessionId);\n   788→    const empty = { five_hour: null, seven_day: null, extra_usage: null };\n   789→\n   790→    if (session?.backendType === \"codex\") {\n   791→      const rl = wsBridge.getCodexRateLimits(sessionId);\n   792→      if (!rl) return c.json(empty);\n   793→      const mapLimit = (l: { usedPercent: number; windowDurationMins: number; resetsAt: number } | null) => {\n   794→        if (!l) return null;\n   795→        return {\n   796→          utilization: l.usedPercent,\n   797→          resets_at: l.resetsAt ? new Date(l.resetsAt * 1000).toISOString() : null,\n   798→        };\n   799→      };\n   800→      return c.json({\n   801→        five_hour: mapLimit(rl.primary),\n   802→        seven_day: mapLimit(rl.secondary),\n   803→        extra_usage: null,\n   804→      });\n   805→    }\n   806→\n   807→    // Claude sessions: use existing logic\n   808→    const limits = await getUsageLimits();\n   809→    return c.json(limits);\n   810→  });\n   811→\n   812→  // ─── Update checking ─────────────────────────────────────────────────\n   813→\n   814→  api.get(\"/update-check\", (c) => {\n   815→    const state = getUpdateState();\n   816→    return c.json({\n   817→      currentVersion: state.currentVersion,\n   818→      latestVersion: state.latestVersion,\n   819→      updateAvailable: isUpdateAvailable(),\n   820→      isServiceMode: state.isServiceMode,\n   821→      updateInProgress: state.updateInProgress,\n   822→      lastChecked: state.lastChecked,\n   823→    });\n   824→  });\n   825→\n   826→  api.post(\"/update-check\", async (c) => {\n   827→    await checkForUpdate();\n   828→    const state = getUpdateState();\n   829→    return c.json({\n   830→      currentVersion: state.currentVersion,\n   831→      latestVersion: state.latestVersion,\n   832→      updateAvailable: isUpdateAvailable(),\n   833→      isServiceMode: state.isServiceMode,\n   834→      updateInProgress: state.updateInProgress,\n   835→      lastChecked: state.lastChecked,\n   836→    });\n   837→  });\n   838→\n   839→  api.post(\"/update\", async (c) => {\n   840→    const state = getUpdateState();\n   841→    if (!state.isServiceMode) {\n   842→      return c.json(\n   843→        { error: \"Update & restart is only available in service mode\" },\n   844→        400,\n   845→      );\n   846→    }\n   847→    if (!isUpdateAvailable()) {\n   848→      return c.json({ error: \"No update available\" }, 400);\n   849→    }\n   850→    if (state.updateInProgress) {\n   851→      return c.json({ error: \"Update already in progress\" }, 409);\n   852→    }\n   853→\n   854→    setUpdateInProgress(true);\n   855→\n   856→    // Respond immediately, then perform update async\n   857→    setTimeout(async () => {\n   858→      try {\n   859→        console.log(\n   860→          `[update] Updating the-companion to ${state.latestVersion}...`,\n   861→        );\n   862→        const proc = Bun.spawn(\n   863→          [\"bun\", \"install\", \"-g\", `the-companion@${state.latestVersion}`],\n   864→          { stdout: \"pipe\", stderr: \"pipe\" },\n   865→        );\n   866→        const exitCode = await proc.exited;\n   867→        if (exitCode !== 0) {\n   868→          const stderr = await new Response(proc.stderr).text();\n   869→          console.error(\n   870→            `[update] bun install failed (code ${exitCode}):`,\n   871→            stderr,\n   872→          );\n   873→          setUpdateInProgress(false);\n   874→          return;\n   875→        }\n   876→        console.log(\n   877→          \"[update] Update successful, exiting for service restart...\",\n   878→        );\n   879→        // Exit with non-zero code so the service manager restarts us\n   880→        process.exit(42);\n   881→      } catch (err) {\n   882→        console.error(\"[update] Update failed:\", err);\n   883→        setUpdateInProgress(false);\n   884→      }\n   885→    }, 100);\n   886→\n   887→    return c.json({\n   888→      ok: true,\n   889→      message: \"Update started. Server will restart shortly.\",\n   890→    });\n   891→  });\n   892→\n   893→  // ─── Helper ─────────────────────────────────────────────────────────\n   894→\n   895→  function cleanupWorktree(\n   896→    sessionId: string,\n   897→    force?: boolean,\n   898→  ): { cleaned?: boolean; dirty?: boolean; path?: string } | undefined {\n   899→    const mapping = worktreeTracker.getBySession(sessionId);\n   900→    if (!mapping) return undefined;\n   901→\n   902→    // Check if any other sessions still use this worktree\n   903→    if (worktreeTracker.isWorktreeInUse(mapping.worktreePath, sessionId)) {\n   904→      worktreeTracker.removeBySession(sessionId);\n   905→      return { cleaned: false, path: mapping.worktreePath };\n   906→    }\n   907→\n   908→    // Auto-remove if clean, or force-remove if requested\n   909→    const dirty = gitUtils.isWorktreeDirty(mapping.worktreePath);\n   910→    if (dirty && !force) {\n   911→      console.log(\n   912→        `[routes] Worktree ${mapping.worktreePath} is dirty, not auto-removing`,\n   913→      );\n   914→      // Keep the mapping so the worktree remains trackable\n   915→      return { cleaned: false, dirty: true, path: mapping.worktreePath };\n   916→    }\n   917→\n   918→    // Delete the companion-managed branch if it differs from the conceptual branch\n   919→    const branchToDelete =\n   920→      mapping.actualBranch && mapping.actualBranch !== mapping.branch\n   921→        ? mapping.actualBranch\n   922→        : undefined;\n   923→    const result = gitUtils.removeWorktree(\n   924→      mapping.repoRoot,\n   925→      mapping.worktreePath,\n   926→      { force: dirty, branchToDelete },\n   927→    );\n   928→    if (result.removed) {\n   929→      // Only remove the mapping after successful cleanup\n   930→      worktreeTracker.removeBySession(sessionId);\n   931→      console.log(\n   932→        `[routes] ${dirty ? \"Force-removed dirty\" : \"Auto-removed clean\"} worktree ${mapping.worktreePath}`,\n   933→      );\n   934→    }\n   935→    return { cleaned: result.removed, path: mapping.worktreePath };\n   936→  }\n   937→\n   938→  return api;\n   939→}\n   940→"}]},"parent_tool_use_id":null,"session_id":"6fd2c7b7-e807-4a5f-ab88-3c7663fd206d","uuid":"32bb6e75-8214-4218-bd61-a67f34fa5c11","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/companion/web/server/routes.ts","content":"import { Hono } from \"hono\";\nimport { execSync } from \"node:child_process\";\nimport { readdir, readFile, writeFile, stat } from \"node:fs/promises\";\nimport { resolve, join, dirname } from \"node:path\";\nimport { homedir } from \"node:os\";\nimport { existsSync, readFileSync } from \"node:fs\";\nimport type { CliLauncher } from \"./cli-launcher.js\";\nimport type { WsBridge } from \"./ws-bridge.js\";\nimport type { SessionStore } from \"./session-store.js\";\nimport type { WorktreeTracker } from \"./worktree-tracker.js\";\nimport * as envManager from \"./env-manager.js\";\nimport * as gitUtils from \"./git-utils.js\";\nimport * as sessionNames from \"./session-names.js\";\nimport { containerManager, type ContainerConfig, type ContainerInfo } from \"./container-manager.js\";\nimport { DEFAULT_OPENROUTER_MODEL, getSettings, updateSettings } from \"./settings-manager.js\";\nimport { getUsageLimits } from \"./usage-limits.js\";\nimport {\n  getUpdateState,\n  checkForUpdate,\n  isUpdateAvailable,\n  setUpdateInProgress,\n} from \"./update-checker.js\";\n\nfunction execCaptureStdout(\n  command: string,\n  options: { cwd: string; encoding: \"utf-8\"; timeout: number },\n): string {\n  try {\n    return execSync(command, options);\n  } catch (err: unknown) {\n    const maybe = err as { stdout?: Buffer | string };\n    if (typeof maybe.stdout === \"string\") return maybe.stdout;\n    if (maybe.stdout && Buffer.isBuffer(maybe.stdout)) {\n      return maybe.stdout.toString(\"utf-8\");\n    }\n    throw err;\n  }\n}\n\nexport function createRoutes(\n  launcher: CliLauncher,\n  wsBridge: WsBridge,\n  sessionStore: SessionStore,\n  worktreeTracker: WorktreeTracker,\n) {\n  const api = new Hono();\n\n  // ─── SDK Sessions (--sdk-url) ─────────────────────────────────────\n\n  api.post(\"/sessions/create\", async (c) => {\n    const body = await c.req.json().catch(() => ({}));\n    try {\n      const backend = body.backend ?? \"claude\";\n      if (backend !== \"claude\" && backend !== \"codex\") {\n        return c.json({ error: `Invalid backend: ${String(backend)}` }, 400);\n      }\n\n      // Resolve environment variables from envSlug\n      let envVars: Record<string, string> | undefined = body.env;\n      if (body.envSlug) {\n        const companionEnv = envManager.getEnv(body.envSlug);\n        if (companionEnv) {\n          console.log(\n            `[routes] Injecting env \"${companionEnv.name}\" (${Object.keys(companionEnv.variables).length} vars):`,\n            Object.keys(companionEnv.variables).join(\", \"),\n          );\n          envVars = { ...companionEnv.variables, ...body.env };\n        } else {\n          console.warn(\n            `[routes] Environment \"${body.envSlug}\" not found, ignoring`,\n          );\n        }\n      }\n\n      let cwd = body.cwd;\n      let worktreeInfo:\n        | {\n            isWorktree: boolean;\n            repoRoot: string;\n            branch: string;\n            actualBranch: string;\n            worktreePath: string;\n          }\n        | undefined;\n\n      // If worktree is requested, set up a worktree for the selected branch\n      if (body.useWorktree && body.branch && cwd) {\n        const repoInfo = gitUtils.getRepoInfo(cwd);\n        if (repoInfo) {\n          const result = gitUtils.ensureWorktree(\n            repoInfo.repoRoot,\n            body.branch,\n            {\n              baseBranch: repoInfo.defaultBranch,\n              createBranch: body.createBranch,\n              forceNew: true,\n            },\n          );\n          cwd = result.worktreePath;\n          worktreeInfo = {\n            isWorktree: true,\n            repoRoot: repoInfo.repoRoot,\n            branch: body.branch,\n            actualBranch: result.actualBranch,\n            worktreePath: result.worktreePath,\n          };\n        }\n      } else if (body.branch && cwd) {\n        // Non-worktree: checkout the selected branch in-place\n        const repoInfo = gitUtils.getRepoInfo(cwd);\n        if (repoInfo) {\n          const fetchResult = gitUtils.gitFetch(repoInfo.repoRoot);\n          if (!fetchResult.success) {\n            throw new Error(`git fetch failed before session create: ${fetchResult.output}`);\n          }\n\n          if (repoInfo.currentBranch !== body.branch) {\n            gitUtils.checkoutBranch(repoInfo.repoRoot, body.branch);\n          }\n\n          const pullResult = gitUtils.gitPull(repoInfo.repoRoot);\n          if (!pullResult.success) {\n            throw new Error(`git pull failed before session create: ${pullResult.output}`);\n          }\n        }\n      }\n\n      // If container mode requested, create and start the container\n      let containerInfo: ContainerInfo | undefined;\n      if (body.container && backend === \"claude\") {\n        const cConfig: ContainerConfig = {\n          image: body.container.image || \"companion-dev:latest\",\n          ports: Array.isArray(body.container.ports)\n            ? body.container.ports.map(Number).filter((n: number) => n > 0)\n            : [],\n          volumes: body.container.volumes,\n          env: body.container.env,\n        };\n        // Use cwd-based name since we don't have sessionId yet\n        const containerId = crypto.randomUUID().slice(0, 8);\n        containerInfo = containerManager.createContainer(containerId, cwd, cConfig);\n      }\n\n      const session = launcher.launch({\n        model: body.model,\n        permissionMode: body.permissionMode,\n        cwd,\n        claudeBinary: body.claudeBinary,\n        codexBinary: body.codexBinary,\n        codexInternetAccess: backend === \"codex\" && body.codexInternetAccess === true,\n        codexSandbox: backend === \"codex\" && body.codexInternetAccess === true\n          ? \"danger-full-access\"\n          : \"workspace-write\",\n        allowedTools: body.allowedTools,\n        env: envVars,\n        backendType: backend,\n        worktreeInfo,\n      });\n\n      // Re-track container with real session ID\n      if (containerInfo) {\n        // The container was created with a temp ID; re-register under the real session ID\n        containerManager.retrack(containerInfo.containerId, session.sessionId);\n      }\n\n      // Track the worktree mapping\n      if (worktreeInfo) {\n        worktreeTracker.addMapping({\n          sessionId: session.sessionId,\n          repoRoot: worktreeInfo.repoRoot,\n          branch: worktreeInfo.branch,\n          actualBranch: worktreeInfo.actualBranch,\n          worktreePath: worktreeInfo.worktreePath,\n          createdAt: Date.now(),\n        });\n      }\n\n      return c.json(session);\n    } catch (e: unknown) {\n      const msg = e instanceof Error ? e.message : String(e);\n      console.error(\"[routes] Failed to create session:\", msg);\n      return c.json({ error: msg }, 500);\n    }\n  });\n\n  api.get(\"/sessions\", (c) => {\n    const sessions = launcher.listSessions();\n    const names = sessionNames.getAllNames();\n    const bridgeStates = wsBridge.getAllSessions();\n    const bridgeMap = new Map(bridgeStates.map((s) => [s.session_id, s]));\n    const enriched = sessions.map((s) => {\n      const bridge = bridgeMap.get(s.sessionId);\n      return {\n        ...s,\n        name: names[s.sessionId] ?? s.name,\n        gitBranch: bridge?.git_branch || \"\",\n        gitAhead: bridge?.git_ahead || 0,\n        gitBehind: bridge?.git_behind || 0,\n        totalLinesAdded: bridge?.total_lines_added || 0,\n        totalLinesRemoved: bridge?.total_lines_removed || 0,\n      };\n    });\n    return c.json(enriched);\n  });\n\n  api.get(\"/sessions/:id\", (c) => {\n    const id = c.req.param(\"id\");\n    const session = launcher.getSession(id);\n    if (!session) return c.json({ error: \"Session not found\" }, 404);\n    return c.json(session);\n  });\n\n  api.patch(\"/sessions/:id/name\", async (c) => {\n    const id = c.req.param(\"id\");\n    const body = await c.req.json().catch(() => ({}));\n    if (typeof body.name !== \"string\" || !body.name.trim()) {\n      return c.json({ error: \"name is required\" }, 400);\n    }\n    const session = launcher.getSession(id);\n    if (!session) return c.json({ error: \"Session not found\" }, 404);\n    sessionNames.setName(id, body.name.trim());\n    return c.json({ ok: true, name: body.name.trim() });\n  });\n\n  api.post(\"/sessions/:id/kill\", async (c) => {\n    const id = c.req.param(\"id\");\n    const killed = await launcher.kill(id);\n    if (!killed)\n      return c.json({ error: \"Session not found or already exited\" }, 404);\n\n    // Clean up container if any\n    containerManager.removeContainer(id);\n\n    return c.json({ ok: true });\n  });\n\n  api.post(\"/sessions/:id/relaunch\", async (c) => {\n    const id = c.req.param(\"id\");\n    const ok = await launcher.relaunch(id);\n    if (!ok) return c.json({ error: \"Session not found\" }, 404);\n    return c.json({ ok: true });\n  });\n\n  api.delete(\"/sessions/:id\", async (c) => {\n    const id = c.req.param(\"id\");\n    await launcher.kill(id);\n\n    // Clean up container if any\n    containerManager.removeContainer(id);\n\n    // Clean up worktree if no other sessions use it (force: delete is destructive)\n    const worktreeResult = cleanupWorktree(id, true);\n\n    launcher.removeSession(id);\n    wsBridge.closeSession(id);\n    return c.json({ ok: true, worktree: worktreeResult });\n  });\n\n  api.post(\"/sessions/:id/archive\", async (c) => {\n    const id = c.req.param(\"id\");\n    const body = await c.req.json().catch(() => ({}));\n    await launcher.kill(id);\n\n    // Clean up container if any\n    containerManager.removeContainer(id);\n\n    // Clean up worktree if no other sessions use it\n    const worktreeResult = cleanupWorktree(id, body.force);\n\n    launcher.setArchived(id, true);\n    sessionStore.setArchived(id, true);\n    return c.json({ ok: true, worktree: worktreeResult });\n  });\n\n  api.post(\"/sessions/:id/unarchive\", (c) => {\n    const id = c.req.param(\"id\");\n    launcher.setArchived(id, false);\n    sessionStore.setArchived(id, false);\n    return c.json({ ok: true });\n  });\n\n  // ─── Available backends ─────────────────────────────────────\n\n  api.get(\"/backends\", (c) => {\n    const backends: Array<{ id: string; name: string; available: boolean }> = [];\n\n    // Check Claude Code\n    let claudeAvailable = false;\n    try {\n      execSync(\"which claude\", { encoding: \"utf-8\", timeout: 3000 });\n      claudeAvailable = true;\n    } catch {}\n    backends.push({ id: \"claude\", name: \"Claude Code\", available: claudeAvailable });\n\n    // Check Codex\n    let codexAvailable = false;\n    try {\n      execSync(\"which codex\", { encoding: \"utf-8\", timeout: 3000 });\n      codexAvailable = true;\n    } catch {}\n    backends.push({ id: \"codex\", name: \"Codex\", available: codexAvailable });\n\n    return c.json(backends);\n  });\n\n  api.get(\"/backends/:id/models\", (c) => {\n    const backendId = c.req.param(\"id\");\n\n    if (backendId === \"codex\") {\n      // Read Codex model list from its local cache file\n      const cachePath = join(homedir(), \".codex\", \"models_cache.json\");\n      if (!existsSync(cachePath)) {\n        return c.json({ error: \"Codex models cache not found. Run codex once to populate it.\" }, 404);\n      }\n      try {\n        const raw = readFileSync(cachePath, \"utf-8\");\n        const cache = JSON.parse(raw) as {\n          models: Array<{\n            slug: string;\n            display_name?: string;\n            description?: string;\n            visibility?: string;\n            priority?: number;\n          }>;\n        };\n        // Only return visible models, sorted by priority\n        const models = cache.models\n          .filter((m) => m.visibility === \"list\")\n          .sort((a, b) => (a.priority ?? 99) - (b.priority ?? 99))\n          .map((m) => ({\n            value: m.slug,\n            label: m.display_name || m.slug,\n            description: m.description || \"\",\n          }));\n        return c.json(models);\n      } catch (e) {\n        return c.json({ error: \"Failed to parse Codex models cache\" }, 500);\n      }\n    }\n\n    // Claude models are hardcoded on the frontend\n    return c.json({ error: \"Use frontend defaults for this backend\" }, 404);\n  });\n\n  // ─── Containers ─────────────────────────────────────────────────\n\n  api.get(\"/containers/status\", (c) => {\n    const available = containerManager.checkDocker();\n    const version = containerManager.getDockerVersion();\n    return c.json({ available, version });\n  });\n\n  api.get(\"/containers/images\", (c) => {\n    const images = containerManager.listImages();\n    return c.json(images);\n  });\n\n  // ─── Filesystem browsing ─────────────────────────────────────\n\n  api.get(\"/fs/list\", async (c) => {\n    const rawPath = c.req.query(\"path\") || homedir();\n    const basePath = resolve(rawPath);\n    try {\n      const entries = await readdir(basePath, { withFileTypes: true });\n      const dirs: { name: string; path: string }[] = [];\n      for (const entry of entries) {\n        if (entry.isDirectory() && !entry.name.startsWith(\".\")) {\n          dirs.push({ name: entry.name, path: join(basePath, entry.name) });\n        }\n      }\n      dirs.sort((a, b) => a.name.localeCompare(b.name));\n      return c.json({ path: basePath, dirs, home: homedir() });\n    } catch {\n      return c.json(\n        {\n          error: \"Cannot read directory\",\n          path: basePath,\n          dirs: [],\n          home: homedir(),\n        },\n        400,\n      );\n    }\n  });\n\n  api.get(\"/fs/home\", (c) => {\n    const home = homedir();\n    const cwd = process.cwd();\n    // Only report cwd if the user launched companion from a real project directory\n    // (not from the package root or the home directory itself)\n    const packageRoot = process.env.__COMPANION_PACKAGE_ROOT;\n    const isProjectDir =\n      cwd !== home &&\n      (!packageRoot || !cwd.startsWith(packageRoot));\n    return c.json({ home, cwd: isProjectDir ? cwd : home });\n  });\n\n  // ─── Editor filesystem APIs ─────────────────────────────────────\n\n  /** Recursive directory tree for the editor file explorer */\n  api.get(\"/fs/tree\", async (c) => {\n    const rawPath = c.req.query(\"path\");\n    if (!rawPath) return c.json({ error: \"path required\" }, 400);\n    const basePath = resolve(rawPath);\n\n    interface TreeNode {\n      name: string;\n      path: string;\n      type: \"file\" | \"directory\";\n      children?: TreeNode[];\n    }\n\n    async function buildTree(dir: string, depth: number): Promise<TreeNode[]> {\n      if (depth > 10) return []; // Safety limit\n      try {\n        const entries = await readdir(dir, { withFileTypes: true });\n        const nodes: TreeNode[] = [];\n        for (const entry of entries) {\n          if (entry.name.startsWith(\".\") || entry.name === \"node_modules\")\n            continue;\n          const fullPath = join(dir, entry.name);\n          if (entry.isDirectory()) {\n            const children = await buildTree(fullPath, depth + 1);\n            nodes.push({\n              name: entry.name,\n              path: fullPath,\n              type: \"directory\",\n              children,\n            });\n          } else if (entry.isFile()) {\n            nodes.push({ name: entry.name, path: fullPath, type: \"file\" });\n          }\n        }\n        nodes.sort((a, b) => {\n          if (a.type !== b.type) return a.type === \"directory\" ? -1 : 1;\n          return a.name.localeCompare(b.name);\n        });\n        return nodes;\n      } catch {\n        return [];\n      }\n    }\n\n    const tree = await buildTree(basePath, 0);\n    return c.json({ path: basePath, tree });\n  });\n\n  /** Read a single file */\n  api.get(\"/fs/read\", async (c) => {\n    const filePath = c.req.query(\"path\");\n    if (!filePath) return c.json({ error: \"path required\" }, 400);\n    const absPath = resolve(filePath);\n    try {\n      const info = await stat(absPath);\n      if (info.size > 2 * 1024 * 1024) {\n        return c.json({ error: \"File too large (>2MB)\" }, 413);\n      }\n      const content = await readFile(absPath, \"utf-8\");\n      return c.json({ path: absPath, content });\n    } catch (e: unknown) {\n      return c.json(\n        { error: e instanceof Error ? e.message : \"Cannot read file\" },\n        404,\n      );\n    }\n  });\n\n  /** Write a single file */\n  api.put(\"/fs/write\", async (c) => {\n    const body = await c.req.json().catch(() => ({}));\n    const { path: filePath, content } = body;\n    if (!filePath || typeof content !== \"string\") {\n      return c.json({ error: \"path and content required\" }, 400);\n    }\n    const absPath = resolve(filePath);\n    try {\n      await writeFile(absPath, content, \"utf-8\");\n      return c.json({ ok: true, path: absPath });\n    } catch (e: unknown) {\n      return c.json(\n        { error: e instanceof Error ? e.message : \"Cannot write file\" },\n        500,\n      );\n    }\n  });\n\n  /** Git diff for a single file (unified diff) */\n  api.get(\"/fs/diff\", (c) => {\n    const filePath = c.req.query(\"path\");\n    if (!filePath) return c.json({ error: \"path required\" }, 400);\n    const absPath = resolve(filePath);\n    try {\n      const repoRoot = execSync(\"git rev-parse --show-toplevel\", {\n        cwd: dirname(absPath),\n        encoding: \"utf-8\",\n        timeout: 5000,\n      }).trim();\n      const relPath = execSync(`git -C \"${repoRoot}\" ls-files --full-name -- \"${absPath}\"`, {\n        encoding: \"utf-8\",\n        timeout: 5000,\n      }).trim() || absPath;\n\n      let diff = execCaptureStdout(`git diff HEAD -- \"${relPath}\"`, {\n        cwd: repoRoot,\n        encoding: \"utf-8\",\n        timeout: 5000,\n      });\n\n      // For untracked files, HEAD diff is empty. Show full file as added.\n      if (!diff.trim()) {\n        const untracked = execSync(`git ls-files --others --exclude-standard -- \"${relPath}\"`, {\n          cwd: repoRoot,\n          encoding: \"utf-8\",\n          timeout: 5000,\n        }).trim();\n        if (untracked) {\n          diff = execCaptureStdout(`git diff --no-index -- /dev/null \"${absPath}\"`, {\n            cwd: repoRoot,\n            encoding: \"utf-8\",\n            timeout: 5000,\n          });\n        }\n      }\n\n      return c.json({ path: absPath, diff });\n    } catch {\n      return c.json({ path: absPath, diff: \"\" });\n    }\n  });\n\n  /** Find CLAUDE.md files for a project (root + .claude/) */\n  api.get(\"/fs/claude-md\", async (c) => {\n    const cwd = c.req.query(\"cwd\");\n    if (!cwd) return c.json({ error: \"cwd required\" }, 400);\n\n    // Resolve to absolute path to prevent path traversal\n    const resolvedCwd = resolve(cwd);\n\n    const candidates = [\n      join(resolvedCwd, \"CLAUDE.md\"),\n      join(resolvedCwd, \".claude\", \"CLAUDE.md\"),\n    ];\n\n    const files: { path: string; content: string }[] = [];\n    for (const p of candidates) {\n      try {\n        const content = await readFile(p, \"utf-8\");\n        files.push({ path: p, content });\n      } catch {\n        // file doesn't exist — skip\n      }\n    }\n\n    return c.json({ cwd: resolvedCwd, files });\n  });\n\n  /** Create or update a CLAUDE.md file */\n  api.put(\"/fs/claude-md\", async (c) => {\n    const body = await c.req.json().catch(() => ({}));\n    const { path: filePath, content } = body;\n    if (!filePath || typeof content !== \"string\") {\n      return c.json({ error: \"path and content required\" }, 400);\n    }\n    // Only allow writing CLAUDE.md files\n    const base = filePath.split(\"/\").pop();\n    if (base !== \"CLAUDE.md\") {\n      return c.json({ error: \"Can only write CLAUDE.md files\" }, 400);\n    }\n    const absPath = resolve(filePath);\n    // Verify the resolved path ends with CLAUDE.md or .claude/CLAUDE.md\n    if (!absPath.endsWith(\"/CLAUDE.md\") && !absPath.endsWith(\"/.claude/CLAUDE.md\")) {\n      return c.json({ error: \"Invalid CLAUDE.md path\" }, 400);\n    }\n    try {\n      // Ensure parent directory exists\n      const { mkdir } = await import(\"node:fs/promises\");\n      await mkdir(dirname(absPath), { recursive: true });\n      await writeFile(absPath, content, \"utf-8\");\n      return c.json({ ok: true, path: absPath });\n    } catch (e: unknown) {\n      return c.json(\n        { error: e instanceof Error ? e.message : \"Cannot write file\" },\n        500,\n      );\n    }\n  });\n\n  // ─── Environments (~/.companion/envs/) ────────────────────────────\n\n  api.get(\"/envs\", (c) => {\n    try {\n      return c.json(envManager.listEnvs());\n    } catch (e: unknown) {\n      return c.json({ error: e instanceof Error ? e.message : String(e) }, 500);\n    }\n  });\n\n  api.get(\"/envs/:slug\", (c) => {\n    const env = envManager.getEnv(c.req.param(\"slug\"));\n    if (!env) return c.json({ error: \"Environment not found\" }, 404);\n    return c.json(env);\n  });\n\n  api.post(\"/envs\", async (c) => {\n    const body = await c.req.json().catch(() => ({}));\n    try {\n      const env = envManager.createEnv(body.name, body.variables || {});\n      return c.json(env, 201);\n    } catch (e: unknown) {\n      return c.json({ error: e instanceof Error ? e.message : String(e) }, 400);\n    }\n  });\n\n  api.put(\"/envs/:slug\", async (c) => {\n    const slug = c.req.param(\"slug\");\n    const body = await c.req.json().catch(() => ({}));\n    try {\n      const env = envManager.updateEnv(slug, {\n        name: body.name,\n        variables: body.variables,\n      });\n      if (!env) return c.json({ error: \"Environment not found\" }, 404);\n      return c.json(env);\n    } catch (e: unknown) {\n      return c.json({ error: e instanceof Error ? e.message : String(e) }, 400);\n    }\n  });\n\n  api.delete(\"/envs/:slug\", (c) => {\n    const deleted = envManager.deleteEnv(c.req.param(\"slug\"));\n    if (!deleted) return c.json({ error: \"Environment not found\" }, 404);\n    return c.json({ ok: true });\n  });\n\n  // ─── Settings (~/.companion/settings.json) ────────────────────────\n\n  api.get(\"/settings\", (c) => {\n    const settings = getSettings();\n    return c.json({\n      openrouterApiKeyConfigured: !!settings.openrouterApiKey.trim(),\n      openrouterModel: settings.openrouterModel || DEFAULT_OPENROUTER_MODEL,\n    });\n  });\n\n  api.put(\"/settings\", async (c) => {\n    const body = await c.req.json().catch(() => ({}));\n    if (body.openrouterApiKey !== undefined && typeof body.openrouterApiKey !== \"string\") {\n      return c.json({ error: \"openrouterApiKey must be a string\" }, 400);\n    }\n    if (body.openrouterModel !== undefined && typeof body.openrouterModel !== \"string\") {\n      return c.json({ error: \"openrouterModel must be a string\" }, 400);\n    }\n    if (body.openrouterApiKey === undefined && body.openrouterModel === undefined) {\n      return c.json({ error: \"At least one settings field is required\" }, 400);\n    }\n\n    const settings = updateSettings({\n      openrouterApiKey:\n        typeof body.openrouterApiKey === \"string\"\n          ? body.openrouterApiKey.trim()\n          : undefined,\n      openrouterModel:\n        typeof body.openrouterModel === \"string\"\n          ? (body.openrouterModel.trim() || DEFAULT_OPENROUTER_MODEL)\n          : undefined,\n    });\n\n    return c.json({\n      openrouterApiKeyConfigured: !!settings.openrouterApiKey.trim(),\n      openrouterModel: settings.openrouterModel || DEFAULT_OPENROUTER_MODEL,\n    });\n  });\n\n  // ─── Git operations ─────────────────────────────────────────────────\n\n  api.get(\"/git/repo-info\", (c) => {\n    const path = c.req.query(\"path\");\n    if (!path) return c.json({ error: \"path required\" }, 400);\n    const info = gitUtils.getRepoInfo(path);\n    if (!info) return c.json({ error: \"Not a git repository\" }, 400);\n    return c.json(info);\n  });\n\n  api.get(\"/git/branches\", (c) => {\n    const repoRoot = c.req.query(\"repoRoot\");\n    if (!repoRoot) return c.json({ error: \"repoRoot required\" }, 400);\n    try {\n      return c.json(gitUtils.listBranches(repoRoot));\n    } catch (e: unknown) {\n      return c.json({ error: e instanceof Error ? e.message : String(e) }, 500);\n    }\n  });\n\n  api.get(\"/git/worktrees\", (c) => {\n    const repoRoot = c.req.query(\"repoRoot\");\n    if (!repoRoot) return c.json({ error: \"repoRoot required\" }, 400);\n    try {\n      return c.json(gitUtils.listWorktrees(repoRoot));\n    } catch (e: unknown) {\n      return c.json({ error: e instanceof Error ? e.message : String(e) }, 500);\n    }\n  });\n\n  api.post(\"/git/worktree\", async (c) => {\n    const body = await c.req.json().catch(() => ({}));\n    const { repoRoot, branch, baseBranch, createBranch } = body;\n    if (!repoRoot || !branch)\n      return c.json({ error: \"repoRoot and branch required\" }, 400);\n    try {\n      const result = gitUtils.ensureWorktree(repoRoot, branch, {\n        baseBranch,\n        createBranch,\n      });\n      return c.json(result);\n    } catch (e: unknown) {\n      return c.json({ error: e instanceof Error ? e.message : String(e) }, 500);\n    }\n  });\n\n  api.delete(\"/git/worktree\", async (c) => {\n    const body = await c.req.json().catch(() => ({}));\n    const { repoRoot, worktreePath, force } = body;\n    if (!repoRoot || !worktreePath)\n      return c.json({ error: \"repoRoot and worktreePath required\" }, 400);\n    const result = gitUtils.removeWorktree(repoRoot, worktreePath, { force });\n    return c.json(result);\n  });\n\n  api.post(\"/git/fetch\", async (c) => {\n    const body = await c.req.json().catch(() => ({}));\n    const { repoRoot } = body;\n    if (!repoRoot) return c.json({ error: \"repoRoot required\" }, 400);\n    return c.json(gitUtils.gitFetch(repoRoot));\n  });\n\n  api.post(\"/git/pull\", async (c) => {\n    const body = await c.req.json().catch(() => ({}));\n    const { cwd } = body;\n    if (!cwd) return c.json({ error: \"cwd required\" }, 400);\n    const result = gitUtils.gitPull(cwd);\n    // Return refreshed ahead/behind counts\n    let git_ahead = 0,\n      git_behind = 0;\n    try {\n      const counts = execSync(\n        \"git rev-list --left-right --count @{upstream}...HEAD\",\n        {\n          cwd,\n          encoding: \"utf-8\",\n          timeout: 3000,\n        },\n      ).trim();\n      const [behind, ahead] = counts.split(/\\s+/).map(Number);\n      git_ahead = ahead || 0;\n      git_behind = behind || 0;\n    } catch {\n      /* no upstream */\n    }\n    return c.json({ ...result, git_ahead, git_behind });\n  });\n\n  // ─── GitHub PR Status ────────────────────────────────────────────────\n\n  api.get(\"/git/pr-status\", async (c) => {\n    const cwd = c.req.query(\"cwd\");\n    const branch = c.req.query(\"branch\");\n    if (!cwd || !branch) return c.json({ error: \"cwd and branch required\" }, 400);\n\n    const { isGhAvailable, fetchPRInfo } = await import(\"./github-pr.js\");\n    if (!isGhAvailable()) {\n      return c.json({ available: false, pr: null });\n    }\n\n    const pr = await fetchPRInfo(cwd, branch);\n    return c.json({ available: true, pr });\n  });\n\n  // ─── Usage Limits ─────────────────────────────────────────────────────\n\n  api.get(\"/usage-limits\", async (c) => {\n    const limits = await getUsageLimits();\n    return c.json(limits);\n  });\n\n  api.get(\"/sessions/:id/usage-limits\", async (c) => {\n    const sessionId = c.req.param(\"id\");\n    const session = wsBridge.getSession(sessionId);\n    const empty = { five_hour: null, seven_day: null, extra_usage: null };\n\n    if (session?.backendType === \"codex\") {\n      const rl = wsBridge.getCodexRateLimits(sessionId);\n      if (!rl) return c.json(empty);\n      const mapLimit = (l: { usedPercent: number; windowDurationMins: number; resetsAt: number } | null) => {\n        if (!l) return null;\n        return {\n          utilization: l.usedPercent,\n          resets_at: l.resetsAt ? new Date(l.resetsAt * 1000).toISOString() : null,\n        };\n      };\n      return c.json({\n        five_hour: mapLimit(rl.primary),\n        seven_day: mapLimit(rl.secondary),\n        extra_usage: null,\n      });\n    }\n\n    // Claude sessions: use existing logic\n    const limits = await getUsageLimits();\n    return c.json(limits);\n  });\n\n  // ─── Update checking ─────────────────────────────────────────────────\n\n  api.get(\"/update-check\", (c) => {\n    const state = getUpdateState();\n    return c.json({\n      currentVersion: state.currentVersion,\n      latestVersion: state.latestVersion,\n      updateAvailable: isUpdateAvailable(),\n      isServiceMode: state.isServiceMode,\n      updateInProgress: state.updateInProgress,\n      lastChecked: state.lastChecked,\n    });\n  });\n\n  api.post(\"/update-check\", async (c) => {\n    await checkForUpdate();\n    const state = getUpdateState();\n    return c.json({\n      currentVersion: state.currentVersion,\n      latestVersion: state.latestVersion,\n      updateAvailable: isUpdateAvailable(),\n      isServiceMode: state.isServiceMode,\n      updateInProgress: state.updateInProgress,\n      lastChecked: state.lastChecked,\n    });\n  });\n\n  api.post(\"/update\", async (c) => {\n    const state = getUpdateState();\n    if (!state.isServiceMode) {\n      return c.json(\n        { error: \"Update & restart is only available in service mode\" },\n        400,\n      );\n    }\n    if (!isUpdateAvailable()) {\n      return c.json({ error: \"No update available\" }, 400);\n    }\n    if (state.updateInProgress) {\n      return c.json({ error: \"Update already in progress\" }, 409);\n    }\n\n    setUpdateInProgress(true);\n\n    // Respond immediately, then perform update async\n    setTimeout(async () => {\n      try {\n        console.log(\n          `[update] Updating the-companion to ${state.latestVersion}...`,\n        );\n        const proc = Bun.spawn(\n          [\"bun\", \"install\", \"-g\", `the-companion@${state.latestVersion}`],\n          { stdout: \"pipe\", stderr: \"pipe\" },\n        );\n        const exitCode = await proc.exited;\n        if (exitCode !== 0) {\n          const stderr = await new Response(proc.stderr).text();\n          console.error(\n            `[update] bun install failed (code ${exitCode}):`,\n            stderr,\n          );\n          setUpdateInProgress(false);\n          return;\n        }\n        console.log(\n          \"[update] Update successful, exiting for service restart...\",\n        );\n        // Exit with non-zero code so the service manager restarts us\n        process.exit(42);\n      } catch (err) {\n        console.error(\"[update] Update failed:\", err);\n        setUpdateInProgress(false);\n      }\n    }, 100);\n\n    return c.json({\n      ok: true,\n      message: \"Update started. Server will restart shortly.\",\n    });\n  });\n\n  // ─── Helper ─────────────────────────────────────────────────────────\n\n  function cleanupWorktree(\n    sessionId: string,\n    force?: boolean,\n  ): { cleaned?: boolean; dirty?: boolean; path?: string } | undefined {\n    const mapping = worktreeTracker.getBySession(sessionId);\n    if (!mapping) return undefined;\n\n    // Check if any other sessions still use this worktree\n    if (worktreeTracker.isWorktreeInUse(mapping.worktreePath, sessionId)) {\n      worktreeTracker.removeBySession(sessionId);\n      return { cleaned: false, path: mapping.worktreePath };\n    }\n\n    // Auto-remove if clean, or force-remove if requested\n    const dirty = gitUtils.isWorktreeDirty(mapping.worktreePath);\n    if (dirty && !force) {\n      console.log(\n        `[routes] Worktree ${mapping.worktreePath} is dirty, not auto-removing`,\n      );\n      // Keep the mapping so the worktree remains trackable\n      return { cleaned: false, dirty: true, path: mapping.worktreePath };\n    }\n\n    // Delete the companion-managed branch if it differs from the conceptual branch\n    const branchToDelete =\n      mapping.actualBranch && mapping.actualBranch !== mapping.branch\n        ? mapping.actualBranch\n        : undefined;\n    const result = gitUtils.removeWorktree(\n      mapping.repoRoot,\n      mapping.worktreePath,\n      { force: dirty, branchToDelete },\n    );\n    if (result.removed) {\n      // Only remove the mapping after successful cleanup\n      worktreeTracker.removeBySession(sessionId);\n      console.log(\n        `[routes] ${dirty ? \"Force-removed dirty\" : \"Auto-removed clean\"} worktree ${mapping.worktreePath}`,\n      );\n    }\n    return { cleaned: result.removed, path: mapping.worktreePath };\n  }\n\n  return api;\n}\n","numLines":940,"startLine":1,"totalLines":940}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01Qt4Lj4GW47uyAXeMX4dAPv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XYwqizhu8ZuLmicDkkQQYW","name":"Read","input":{"file_path":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/companion/web/server/ws-bridge.ts"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1007,"cache_creation_input_tokens":430,"cache_read_input_tokens":105586,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":430},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"6fd2c7b7-e807-4a5f-ab88-3c7663fd206d","uuid":"7d252fb0-46eb-42dc-b3f1-04834147e48c"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XYwqizhu8ZuLmicDkkQQYW","type":"tool_result","content":"     1→import type { ServerWebSocket } from \"bun\";\n     2→import { randomUUID } from \"node:crypto\";\n     3→import { execSync } from \"node:child_process\";\n     4→import { resolve } from \"node:path\";\n     5→import type {\n     6→  CLIMessage,\n     7→  CLISystemInitMessage,\n     8→  CLISystemStatusMessage,\n     9→  CLIAssistantMessage,\n    10→  CLIResultMessage,\n    11→  CLIStreamEventMessage,\n    12→  CLIToolProgressMessage,\n    13→  CLIToolUseSummaryMessage,\n    14→  CLIControlRequestMessage,\n    15→  CLIAuthStatusMessage,\n    16→  BrowserOutgoingMessage,\n    17→  BrowserIncomingMessage,\n    18→  SessionState,\n    19→  PermissionRequest,\n    20→  BackendType,\n    21→} from \"./session-types.js\";\n    22→import type { SessionStore } from \"./session-store.js\";\n    23→import type { CodexAdapter } from \"./codex-adapter.js\";\n    24→\n    25→// ─── WebSocket data tags ──────────────────────────────────────────────────────\n    26→\n    27→interface CLISocketData {\n    28→  kind: \"cli\";\n    29→  sessionId: string;\n    30→}\n    31→\n    32→interface BrowserSocketData {\n    33→  kind: \"browser\";\n    34→  sessionId: string;\n    35→}\n    36→\n    37→export type SocketData = CLISocketData | BrowserSocketData;\n    38→\n    39→// ─── Session ──────────────────────────────────────────────────────────────────\n    40→\n    41→interface Session {\n    42→  id: string;\n    43→  backendType: BackendType;\n    44→  cliSocket: ServerWebSocket<SocketData> | null;\n    45→  codexAdapter: CodexAdapter | null;\n    46→  browserSockets: Set<ServerWebSocket<SocketData>>;\n    47→  state: SessionState;\n    48→  pendingPermissions: Map<string, PermissionRequest>;\n    49→  messageHistory: BrowserIncomingMessage[];\n    50→  /** Messages queued while waiting for CLI to connect */\n    51→  pendingMessages: string[];\n    52→}\n    53→\n    54→function makeDefaultState(sessionId: string, backendType: BackendType = \"claude\"): SessionState {\n    55→  return {\n    56→    session_id: sessionId,\n    57→    backend_type: backendType,\n    58→    model: \"\",\n    59→    cwd: \"\",\n    60→    tools: [],\n    61→    permissionMode: \"default\",\n    62→    claude_code_version: \"\",\n    63→    mcp_servers: [],\n    64→    agents: [],\n    65→    slash_commands: [],\n    66→    skills: [],\n    67→    total_cost_usd: 0,\n    68→    num_turns: 0,\n    69→    context_used_percent: 0,\n    70→    is_compacting: false,\n    71→    git_branch: \"\",\n    72→    is_worktree: false,\n    73→    repo_root: \"\",\n    74→    git_ahead: 0,\n    75→    git_behind: 0,\n    76→    total_lines_added: 0,\n    77→    total_lines_removed: 0,\n    78→  };\n    79→}\n    80→\n    81→// ─── Git info helper ─────────────────────────────────────────────────────────\n    82→\n    83→function resolveGitInfo(state: SessionState): void {\n    84→  if (!state.cwd) return;\n    85→  try {\n    86→    state.git_branch = execSync(\"git rev-parse --abbrev-ref HEAD\", {\n    87→      cwd: state.cwd, encoding: \"utf-8\", timeout: 3000,\n    88→    }).trim();\n    89→\n    90→    try {\n    91→      const gitDir = execSync(\"git rev-parse --git-dir\", {\n    92→        cwd: state.cwd, encoding: \"utf-8\", timeout: 3000,\n    93→      }).trim();\n    94→      state.is_worktree = gitDir.includes(\"/worktrees/\");\n    95→    } catch { /* ignore */ }\n    96→\n    97→    try {\n    98→      if (state.is_worktree) {\n    99→        // For worktrees, --show-toplevel returns the worktree dir, not the original repo.\n   100→        // Use --git-common-dir to find the shared .git dir, then derive the repo root.\n   101→        const commonDir = execSync(\"git rev-parse --git-common-dir\", {\n   102→          cwd: state.cwd, encoding: \"utf-8\", timeout: 3000,\n   103→        }).trim();\n   104→        state.repo_root = resolve(state.cwd, commonDir, \"..\");\n   105→      } else {\n   106→        state.repo_root = execSync(\"git rev-parse --show-toplevel\", {\n   107→          cwd: state.cwd, encoding: \"utf-8\", timeout: 3000,\n   108→        }).trim();\n   109→      }\n   110→    } catch { /* ignore */ }\n   111→\n   112→    try {\n   113→      const counts = execSync(\n   114→        \"git rev-list --left-right --count @{upstream}...HEAD\",\n   115→        { cwd: state.cwd, encoding: \"utf-8\", timeout: 3000 },\n   116→      ).trim();\n   117→      const [behind, ahead] = counts.split(/\\s+/).map(Number);\n   118→      state.git_ahead = ahead || 0;\n   119→      state.git_behind = behind || 0;\n   120→    } catch {\n   121→      state.git_ahead = 0;\n   122→      state.git_behind = 0;\n   123→    }\n   124→  } catch {\n   125→    // Not a git repo or git not available\n   126→  }\n   127→}\n   128→\n   129→// ─── Bridge ───────────────────────────────────────────────────────────────────\n   130→\n   131→export class WsBridge {\n   132→  private sessions = new Map<string, Session>();\n   133→  private store: SessionStore | null = null;\n   134→  private onCLISessionId: ((sessionId: string, cliSessionId: string) => void) | null = null;\n   135→  private onCLIRelaunchNeeded: ((sessionId: string) => void) | null = null;\n   136→  private onFirstTurnCompleted: ((sessionId: string, firstUserMessage: string) => void) | null = null;\n   137→  private autoNamingAttempted = new Set<string>();\n   138→  private userMsgCounter = 0;\n   139→\n   140→  /** Register a callback for when we learn the CLI's internal session ID. */\n   141→  onCLISessionIdReceived(cb: (sessionId: string, cliSessionId: string) => void): void {\n   142→    this.onCLISessionId = cb;\n   143→  }\n   144→\n   145→  /** Register a callback for when a browser connects but CLI is dead. */\n   146→  onCLIRelaunchNeededCallback(cb: (sessionId: string) => void): void {\n   147→    this.onCLIRelaunchNeeded = cb;\n   148→  }\n   149→\n   150→  /** Register a callback for when a session completes its first turn. */\n   151→  onFirstTurnCompletedCallback(cb: (sessionId: string, firstUserMessage: string) => void): void {\n   152→    this.onFirstTurnCompleted = cb;\n   153→  }\n   154→\n   155→  /** Attach a persistent store. Call restoreFromDisk() after. */\n   156→  setStore(store: SessionStore): void {\n   157→    this.store = store;\n   158→  }\n   159→\n   160→  /** Restore sessions from disk (call once at startup). */\n   161→  restoreFromDisk(): number {\n   162→    if (!this.store) return 0;\n   163→    const persisted = this.store.loadAll();\n   164→    let count = 0;\n   165→    for (const p of persisted) {\n   166→      if (this.sessions.has(p.id)) continue; // don't overwrite live sessions\n   167→      const session: Session = {\n   168→        id: p.id,\n   169→        backendType: p.state.backend_type || \"claude\",\n   170→        cliSocket: null,\n   171→        codexAdapter: null,\n   172→        browserSockets: new Set(),\n   173→        state: p.state,\n   174→        pendingPermissions: new Map(p.pendingPermissions || []),\n   175→        messageHistory: p.messageHistory || [],\n   176→        pendingMessages: p.pendingMessages || [],\n   177→      };\n   178→      session.state.backend_type = session.backendType;\n   179→      // Resolve git info for restored sessions (may have been persisted without it)\n   180→      resolveGitInfo(session.state);\n   181→      this.sessions.set(p.id, session);\n   182→      // Restored sessions with completed turns don't need auto-naming re-triggered\n   183→      if (session.state.num_turns > 0) {\n   184→        this.autoNamingAttempted.add(session.id);\n   185→      }\n   186→      count++;\n   187→    }\n   188→    if (count > 0) {\n   189→      console.log(`[ws-bridge] Restored ${count} session(s) from disk`);\n   190→    }\n   191→    return count;\n   192→  }\n   193→\n   194→  /** Persist a session to disk (debounced). */\n   195→  private persistSession(session: Session): void {\n   196→    if (!this.store) return;\n   197→    this.store.save({\n   198→      id: session.id,\n   199→      state: session.state,\n   200→      messageHistory: session.messageHistory,\n   201→      pendingMessages: session.pendingMessages,\n   202→      pendingPermissions: Array.from(session.pendingPermissions.entries()),\n   203→    });\n   204→  }\n   205→\n   206→  // ── Session management ──────────────────────────────────────────────────\n   207→\n   208→  getOrCreateSession(sessionId: string, backendType?: BackendType): Session {\n   209→    let session = this.sessions.get(sessionId);\n   210→    if (!session) {\n   211→      const type = backendType || \"claude\";\n   212→      session = {\n   213→        id: sessionId,\n   214→        backendType: type,\n   215→        cliSocket: null,\n   216→        codexAdapter: null,\n   217→        browserSockets: new Set(),\n   218→        state: makeDefaultState(sessionId, type),\n   219→        pendingPermissions: new Map(),\n   220→        messageHistory: [],\n   221→        pendingMessages: [],\n   222→      };\n   223→      this.sessions.set(sessionId, session);\n   224→    } else if (backendType) {\n   225→      // Only overwrite backendType when explicitly provided (e.g. attachCodexAdapter)\n   226→      // Prevents handleBrowserOpen from resetting codex→claude\n   227→      session.backendType = backendType;\n   228→      session.state.backend_type = backendType;\n   229→    }\n   230→    return session;\n   231→  }\n   232→\n   233→  getSession(sessionId: string): Session | undefined {\n   234→    return this.sessions.get(sessionId);\n   235→  }\n   236→\n   237→  getAllSessions(): SessionState[] {\n   238→    return Array.from(this.sessions.values()).map((s) => s.state);\n   239→  }\n   240→\n   241→  getCodexRateLimits(sessionId: string) {\n   242→    const session = this.sessions.get(sessionId);\n   243→    return session?.codexAdapter?.getRateLimits() ?? null;\n   244→  }\n   245→\n   246→  isCliConnected(sessionId: string): boolean {\n   247→    const session = this.sessions.get(sessionId);\n   248→    if (!session) return false;\n   249→    if (session.backendType === \"codex\") {\n   250→      return !!session.codexAdapter?.isConnected();\n   251→    }\n   252→    return !!session.cliSocket;\n   253→  }\n   254→\n   255→  removeSession(sessionId: string) {\n   256→    this.sessions.delete(sessionId);\n   257→    this.autoNamingAttempted.delete(sessionId);\n   258→    this.store?.remove(sessionId);\n   259→  }\n   260→\n   261→  /**\n   262→   * Close all sockets (CLI + browsers) for a session and remove it.\n   263→   */\n   264→  closeSession(sessionId: string) {\n   265→    const session = this.sessions.get(sessionId);\n   266→    if (!session) return;\n   267→\n   268→    // Close CLI socket (Claude)\n   269→    if (session.cliSocket) {\n   270→      try { session.cliSocket.close(); } catch {}\n   271→      session.cliSocket = null;\n   272→    }\n   273→\n   274→    // Disconnect Codex adapter\n   275→    if (session.codexAdapter) {\n   276→      session.codexAdapter.disconnect().catch(() => {});\n   277→      session.codexAdapter = null;\n   278→    }\n   279→\n   280→    // Close all browser sockets\n   281→    for (const ws of session.browserSockets) {\n   282→      try { ws.close(); } catch {}\n   283→    }\n   284→    session.browserSockets.clear();\n   285→\n   286→    this.sessions.delete(sessionId);\n   287→    this.autoNamingAttempted.delete(sessionId);\n   288→    this.store?.remove(sessionId);\n   289→  }\n   290→\n   291→  // ── Codex adapter attachment ────────────────────────────────────────────\n   292→\n   293→  /**\n   294→   * Attach a CodexAdapter to a session. The adapter handles all message\n   295→   * translation between the Codex app-server (stdio JSON-RPC) and the\n   296→   * browser WebSocket protocol.\n   297→   */\n   298→  attachCodexAdapter(sessionId: string, adapter: CodexAdapter): void {\n   299→    const session = this.getOrCreateSession(sessionId, \"codex\");\n   300→    session.backendType = \"codex\";\n   301→    session.state.backend_type = \"codex\";\n   302→    session.codexAdapter = adapter;\n   303→\n   304→    // Forward translated messages to browsers\n   305→    adapter.onBrowserMessage((msg) => {\n   306→      if (msg.type === \"session_init\") {\n   307→        session.state = { ...session.state, ...msg.session, backend_type: \"codex\" };\n   308→        resolveGitInfo(session.state);\n   309→        this.persistSession(session);\n   310→      } else if (msg.type === \"session_update\") {\n   311→        session.state = { ...session.state, ...msg.session, backend_type: \"codex\" };\n   312→        this.persistSession(session);\n   313→      } else if (msg.type === \"status_change\") {\n   314→        session.state.is_compacting = msg.status === \"compacting\";\n   315→        this.persistSession(session);\n   316→      }\n   317→\n   318→      // Store assistant/result messages in history for replay\n   319→      if (msg.type === \"assistant\") {\n   320→        session.messageHistory.push({ ...msg, timestamp: msg.timestamp || Date.now() });\n   321→        this.persistSession(session);\n   322→      } else if (msg.type === \"result\") {\n   323→        session.messageHistory.push(msg);\n   324→        this.persistSession(session);\n   325→      }\n   326→\n   327→      // Diagnostic: log tool_use assistant messages\n   328→      if (msg.type === \"assistant\") {\n   329→        const content = (msg as { message?: { content?: Array<{ type: string }> } }).message?.content;\n   330→        const hasToolUse = content?.some((b) => b.type === \"tool_use\");\n   331→        if (hasToolUse) {\n   332→          console.log(`[ws-bridge] Broadcasting tool_use assistant to ${session.browserSockets.size} browser(s) for session ${session.id}`);\n   333→        }\n   334→      }\n   335→\n   336→      // Handle permission requests\n   337→      if (msg.type === \"permission_request\") {\n   338→        session.pendingPermissions.set(msg.request.request_id, msg.request);\n   339→        this.persistSession(session);\n   340→      }\n   341→\n   342→      this.broadcastToBrowsers(session, msg);\n   343→\n   344→      // Trigger auto-naming after the first result\n   345→      if (\n   346→        msg.type === \"result\" &&\n   347→        !(msg.data as { is_error?: boolean }).is_error &&\n   348→        this.onFirstTurnCompleted &&\n   349→        !this.autoNamingAttempted.has(session.id)\n   350→      ) {\n   351→        this.autoNamingAttempted.add(session.id);\n   352→        const firstUserMsg = session.messageHistory.find((m) => m.type === \"user_message\");\n   353→        if (firstUserMsg && firstUserMsg.type === \"user_message\") {\n   354→          this.onFirstTurnCompleted(session.id, firstUserMsg.content);\n   355→        }\n   356→      }\n   357→    });\n   358→\n   359→    // Handle session metadata updates\n   360→    adapter.onSessionMeta((meta) => {\n   361→      if (meta.cliSessionId && this.onCLISessionId) {\n   362→        this.onCLISessionId(session.id, meta.cliSessionId);\n   363→      }\n   364→      if (meta.model) session.state.model = meta.model;\n   365→      if (meta.cwd) session.state.cwd = meta.cwd;\n   366→      session.state.backend_type = \"codex\";\n   367→      this.persistSession(session);\n   368→    });\n   369→\n   370→    // Handle disconnect\n   371→    adapter.onDisconnect(() => {\n   372→      for (const [reqId] of session.pendingPermissions) {\n   373→        this.broadcastToBrowsers(session, { type: \"permission_cancelled\", request_id: reqId });\n   374→      }\n   375→      session.pendingPermissions.clear();\n   376→      session.codexAdapter = null;\n   377→      this.persistSession(session);\n   378→      console.log(`[ws-bridge] Codex adapter disconnected for session ${sessionId}`);\n   379→      this.broadcastToBrowsers(session, { type: \"cli_disconnected\" });\n   380→    });\n   381→\n   382→    // Flush any messages queued while waiting for the adapter\n   383→    if (session.pendingMessages.length > 0) {\n   384→      console.log(`[ws-bridge] Flushing ${session.pendingMessages.length} queued message(s) to Codex adapter for session ${sessionId}`);\n   385→      const queued = session.pendingMessages.splice(0);\n   386→      for (const raw of queued) {\n   387→        try {\n   388→          const msg = JSON.parse(raw) as BrowserOutgoingMessage;\n   389→          adapter.sendBrowserMessage(msg);\n   390→        } catch {\n   391→          console.warn(`[ws-bridge] Failed to parse queued message for Codex: ${raw.substring(0, 100)}`);\n   392→        }\n   393→      }\n   394→    }\n   395→\n   396→    // Notify browsers that the backend is connected\n   397→    this.broadcastToBrowsers(session, { type: \"cli_connected\" });\n   398→    console.log(`[ws-bridge] Codex adapter attached for session ${sessionId}`);\n   399→  }\n   400→\n   401→  // ── CLI WebSocket handlers ──────────────────────────────────────────────\n   402→\n   403→  handleCLIOpen(ws: ServerWebSocket<SocketData>, sessionId: string) {\n   404→    const session = this.getOrCreateSession(sessionId);\n   405→    session.cliSocket = ws;\n   406→    console.log(`[ws-bridge] CLI connected for session ${sessionId}`);\n   407→    this.broadcastToBrowsers(session, { type: \"cli_connected\" });\n   408→\n   409→    // Flush any messages that were queued while waiting for CLI to connect\n   410→    if (session.pendingMessages.length > 0) {\n   411→      console.log(`[ws-bridge] Flushing ${session.pendingMessages.length} queued message(s) for session ${sessionId}`);\n   412→      for (const ndjson of session.pendingMessages) {\n   413→        this.sendToCLI(session, ndjson);\n   414→      }\n   415→      session.pendingMessages = [];\n   416→    }\n   417→  }\n   418→\n   419→  handleCLIMessage(ws: ServerWebSocket<SocketData>, raw: string | Buffer) {\n   420→    const data = typeof raw === \"string\" ? raw : raw.toString(\"utf-8\");\n   421→    const sessionId = (ws.data as CLISocketData).sessionId;\n   422→    const session = this.sessions.get(sessionId);\n   423→    if (!session) return;\n   424→\n   425→    // NDJSON: split on newlines, parse each line\n   426→    const lines = data.split(\"\\n\").filter((l) => l.trim());\n   427→    for (const line of lines) {\n   428→      let msg: CLIMessage;\n   429→      try {\n   430→        msg = JSON.parse(line);\n   431→      } catch {\n   432→        console.warn(`[ws-bridge] Failed to parse CLI message: ${line.substring(0, 200)}`);\n   433→        continue;\n   434→      }\n   435→      this.routeCLIMessage(session, msg);\n   436→    }\n   437→  }\n   438→\n   439→  handleCLIClose(ws: ServerWebSocket<SocketData>) {\n   440→    const sessionId = (ws.data as CLISocketData).sessionId;\n   441→    const session = this.sessions.get(sessionId);\n   442→    if (!session) return;\n   443→\n   444→    session.cliSocket = null;\n   445→    console.log(`[ws-bridge] CLI disconnected for session ${sessionId}`);\n   446→    this.broadcastToBrowsers(session, { type: \"cli_disconnected\" });\n   447→\n   448→    // Cancel any pending permission requests\n   449→    for (const [reqId] of session.pendingPermissions) {\n   450→      this.broadcastToBrowsers(session, { type: \"permission_cancelled\", request_id: reqId });\n   451→    }\n   452→    session.pendingPermissions.clear();\n   453→  }\n   454→\n   455→  // ── Browser WebSocket handlers ──────────────────────────────────────────\n   456→\n   457→  handleBrowserOpen(ws: ServerWebSocket<SocketData>, sessionId: string) {\n   458→    const session = this.getOrCreateSession(sessionId);\n   459→    session.browserSockets.add(ws);\n   460→    console.log(`[ws-bridge] Browser connected for session ${sessionId} (${session.browserSockets.size} browsers)`);\n   461→\n   462→    // Send current session state as snapshot\n   463→    const snapshot: BrowserIncomingMessage = {\n   464→      type: \"session_init\",\n   465→      session: session.state,\n   466→    };\n   467→    this.sendToBrowser(ws, snapshot);\n   468→\n   469→    // Replay message history so the browser can reconstruct the conversation\n   470→    if (session.messageHistory.length > 0) {\n   471→      this.sendToBrowser(ws, {\n   472→        type: \"message_history\",\n   473→        messages: session.messageHistory,\n   474→      });\n   475→    }\n   476→\n   477→    // Send any pending permission requests\n   478→    for (const perm of session.pendingPermissions.values()) {\n   479→      this.sendToBrowser(ws, { type: \"permission_request\", request: perm });\n   480→    }\n   481→\n   482→    // Notify if backend is not connected and request relaunch\n   483→    const backendConnected = session.backendType === \"codex\"\n   484→      // Treat an attached adapter as \"alive\" during init.\n   485→      // `isConnected()` flips true only after initialize/thread start, and\n   486→      // relaunching during that window can kill a healthy startup.\n   487→      ? !!session.codexAdapter\n   488→      : !!session.cliSocket;\n   489→\n   490→    if (!backendConnected) {\n   491→      this.sendToBrowser(ws, { type: \"cli_disconnected\" });\n   492→      if (this.onCLIRelaunchNeeded) {\n   493→        console.log(`[ws-bridge] Browser connected but backend is dead for session ${sessionId}, requesting relaunch`);\n   494→        this.onCLIRelaunchNeeded(sessionId);\n   495→      }\n   496→    }\n   497→  }\n   498→\n   499→  handleBrowserMessage(ws: ServerWebSocket<SocketData>, raw: string | Buffer) {\n   500→    const data = typeof raw === \"string\" ? raw : raw.toString(\"utf-8\");\n   501→    const sessionId = (ws.data as BrowserSocketData).sessionId;\n   502→    const session = this.sessions.get(sessionId);\n   503→    if (!session) return;\n   504→\n   505→    let msg: BrowserOutgoingMessage;\n   506→    try {\n   507→      msg = JSON.parse(data);\n   508→    } catch {\n   509→      console.warn(`[ws-bridge] Failed to parse browser message: ${data.substring(0, 200)}`);\n   510→      return;\n   511→    }\n   512→\n   513→    this.routeBrowserMessage(session, msg);\n   514→  }\n   515→\n   516→  handleBrowserClose(ws: ServerWebSocket<SocketData>) {\n   517→    const sessionId = (ws.data as BrowserSocketData).sessionId;\n   518→    const session = this.sessions.get(sessionId);\n   519→    if (!session) return;\n   520→\n   521→    session.browserSockets.delete(ws);\n   522→    console.log(`[ws-bridge] Browser disconnected for session ${sessionId} (${session.browserSockets.size} browsers)`);\n   523→  }\n   524→\n   525→  // ── CLI message routing ─────────────────────────────────────────────────\n   526→\n   527→  private routeCLIMessage(session: Session, msg: CLIMessage) {\n   528→    switch (msg.type) {\n   529→      case \"system\":\n   530→        this.handleSystemMessage(session, msg);\n   531→        break;\n   532→\n   533→      case \"assistant\":\n   534→        this.handleAssistantMessage(session, msg);\n   535→        break;\n   536→\n   537→      case \"result\":\n   538→        this.handleResultMessage(session, msg);\n   539→        break;\n   540→\n   541→      case \"stream_event\":\n   542→        this.handleStreamEvent(session, msg);\n   543→        break;\n   544→\n   545→      case \"control_request\":\n   546→        this.handleControlRequest(session, msg);\n   547→        break;\n   548→\n   549→      case \"tool_progress\":\n   550→        this.handleToolProgress(session, msg);\n   551→        break;\n   552→\n   553→      case \"tool_use_summary\":\n   554→        this.handleToolUseSummary(session, msg);\n   555→        break;\n   556→\n   557→      case \"auth_status\":\n   558→        this.handleAuthStatus(session, msg);\n   559→        break;\n   560→\n   561→      case \"keep_alive\":\n   562→        // Silently consume keepalives\n   563→        break;\n   564→\n   565→      default:\n   566→        // Forward unknown messages as-is for debugging\n   567→        break;\n   568→    }\n   569→  }\n   570→\n   571→  private handleSystemMessage(session: Session, msg: CLISystemInitMessage | CLISystemStatusMessage) {\n   572→    if (msg.subtype === \"init\") {\n   573→      // Keep the launcher-assigned session_id as the canonical ID.\n   574→      // The CLI may report its own internal session_id which differs\n   575→      // from the launcher UUID, causing duplicate entries in the sidebar.\n   576→\n   577→      // Store the CLI's internal session_id so we can --resume on relaunch\n   578→      if (msg.session_id && this.onCLISessionId) {\n   579→        this.onCLISessionId(session.id, msg.session_id);\n   580→      }\n   581→\n   582→      session.state.model = msg.model;\n   583→      session.state.cwd = msg.cwd;\n   584→      session.state.tools = msg.tools;\n   585→      session.state.permissionMode = msg.permissionMode;\n   586→      session.state.claude_code_version = msg.claude_code_version;\n   587→      session.state.mcp_servers = msg.mcp_servers;\n   588→      session.state.agents = msg.agents ?? [];\n   589→      session.state.slash_commands = msg.slash_commands ?? [];\n   590→      session.state.skills = msg.skills ?? [];\n   591→\n   592→      // Resolve git info from session cwd\n   593→      resolveGitInfo(session.state);\n   594→\n   595→      this.broadcastToBrowsers(session, {\n   596→        type: \"session_init\",\n   597→        session: session.state,\n   598→      });\n   599→      this.persistSession(session);\n   600→    } else if (msg.subtype === \"status\") {\n   601→      session.state.is_compacting = msg.status === \"compacting\";\n   602→\n   603→      if (msg.permissionMode) {\n   604→        session.state.permissionMode = msg.permissionMode;\n   605→      }\n   606→\n   607→      this.broadcastToBrowsers(session, {\n   608→        type: \"status_change\",\n   609→        status: msg.status ?? null,\n   610→      });\n   611→    }\n   612→    // Other system subtypes (compact_boundary, task_notification, etc.) can be forwarded as needed\n   613→  }\n   614→\n   615→  private handleAssistantMessage(session: Session, msg: CLIAssistantMessage) {\n   616→    const browserMsg: BrowserIncomingMessage = {\n   617→      type: \"assistant\",\n   618→      message: msg.message,\n   619→      parent_tool_use_id: msg.parent_tool_use_id,\n   620→      timestamp: Date.now(),\n   621→    };\n   622→    session.messageHistory.push(browserMsg);\n   623→    this.broadcastToBrowsers(session, browserMsg);\n   624→    this.persistSession(session);\n   625→  }\n   626→\n   627→  private handleResultMessage(session: Session, msg: CLIResultMessage) {\n   628→    // Update session cost/turns\n   629→    session.state.total_cost_usd = msg.total_cost_usd;\n   630→    session.state.num_turns = msg.num_turns;\n   631→\n   632→    // Update lines changed (CLI may send these in result)\n   633→    if (typeof msg.total_lines_added === \"number\") {\n   634→      session.state.total_lines_added = msg.total_lines_added;\n   635→    }\n   636→    if (typeof msg.total_lines_removed === \"number\") {\n   637→      session.state.total_lines_removed = msg.total_lines_removed;\n   638→    }\n   639→\n   640→    // Compute context usage from modelUsage\n   641→    if (msg.modelUsage) {\n   642→      for (const usage of Object.values(msg.modelUsage)) {\n   643→        if (usage.contextWindow > 0) {\n   644→          const pct = Math.round(\n   645→            ((usage.inputTokens + usage.outputTokens) / usage.contextWindow) * 100\n   646→          );\n   647→          session.state.context_used_percent = Math.max(0, Math.min(pct, 100));\n   648→        }\n   649→      }\n   650→    }\n   651→\n   652→    const browserMsg: BrowserIncomingMessage = {\n   653→      type: \"result\",\n   654→      data: msg,\n   655→    };\n   656→    session.messageHistory.push(browserMsg);\n   657→    this.broadcastToBrowsers(session, browserMsg);\n   658→    this.persistSession(session);\n   659→\n   660→    // Trigger auto-naming after the first successful result for this session.\n   661→    // Note: num_turns counts all internal tool-use turns, so it's typically > 1\n   662→    // even on the first user interaction. We track per-session instead.\n   663→    if (\n   664→      !msg.is_error &&\n   665→      this.onFirstTurnCompleted &&\n   666→      !this.autoNamingAttempted.has(session.id)\n   667→    ) {\n   668→      this.autoNamingAttempted.add(session.id);\n   669→      const firstUserMsg = session.messageHistory.find(\n   670→        (m) => m.type === \"user_message\",\n   671→      );\n   672→      if (firstUserMsg && firstUserMsg.type === \"user_message\") {\n   673→        this.onFirstTurnCompleted(session.id, firstUserMsg.content);\n   674→      }\n   675→    }\n   676→  }\n   677→\n   678→  private handleStreamEvent(session: Session, msg: CLIStreamEventMessage) {\n   679→    this.broadcastToBrowsers(session, {\n   680→      type: \"stream_event\",\n   681→      event: msg.event,\n   682→      parent_tool_use_id: msg.parent_tool_use_id,\n   683→    });\n   684→  }\n   685→\n   686→  private handleControlRequest(session: Session, msg: CLIControlRequestMessage) {\n   687→    if (msg.request.subtype === \"can_use_tool\") {\n   688→      const perm: PermissionRequest = {\n   689→        request_id: msg.request_id,\n   690→        tool_name: msg.request.tool_name,\n   691→        input: msg.request.input,\n   692→        permission_suggestions: msg.request.permission_suggestions,\n   693→        description: msg.request.description,\n   694→        tool_use_id: msg.request.tool_use_id,\n   695→        agent_id: msg.request.agent_id,\n   696→        timestamp: Date.now(),\n   697→      };\n   698→      session.pendingPermissions.set(msg.request_id, perm);\n   699→\n   700→      this.broadcastToBrowsers(session, {\n   701→        type: \"permission_request\",\n   702→        request: perm,\n   703→      });\n   704→      this.persistSession(session);\n   705→    }\n   706→  }\n   707→\n   708→  private handleToolProgress(session: Session, msg: CLIToolProgressMessage) {\n   709→    this.broadcastToBrowsers(session, {\n   710→      type: \"tool_progress\",\n   711→      tool_use_id: msg.tool_use_id,\n   712→      tool_name: msg.tool_name,\n   713→      elapsed_time_seconds: msg.elapsed_time_seconds,\n   714→    });\n   715→  }\n   716→\n   717→  private handleToolUseSummary(session: Session, msg: CLIToolUseSummaryMessage) {\n   718→    this.broadcastToBrowsers(session, {\n   719→      type: \"tool_use_summary\",\n   720→      summary: msg.summary,\n   721→      tool_use_ids: msg.preceding_tool_use_ids,\n   722→    });\n   723→  }\n   724→\n   725→  private handleAuthStatus(session: Session, msg: CLIAuthStatusMessage) {\n   726→    this.broadcastToBrowsers(session, {\n   727→      type: \"auth_status\",\n   728→      isAuthenticating: msg.isAuthenticating,\n   729→      output: msg.output,\n   730→      error: msg.error,\n   731→    });\n   732→  }\n   733→\n   734→  // ── Browser message routing ─────────────────────────────────────────────\n   735→\n   736→  private routeBrowserMessage(session: Session, msg: BrowserOutgoingMessage) {\n   737→    // For Codex sessions, delegate entirely to the adapter\n   738→    if (session.backendType === \"codex\") {\n   739→      // Store user messages in history for replay with stable ID for dedup on reconnect\n   740→      if (msg.type === \"user_message\") {\n   741→        const ts = Date.now();\n   742→        session.messageHistory.push({\n   743→          type: \"user_message\",\n   744→          content: msg.content,\n   745→          timestamp: ts,\n   746→          id: `user-${ts}-${this.userMsgCounter++}`,\n   747→        });\n   748→        this.persistSession(session);\n   749→      }\n   750→      if (msg.type === \"permission_response\") {\n   751→        session.pendingPermissions.delete(msg.request_id);\n   752→        this.persistSession(session);\n   753→      }\n   754→\n   755→      if (session.codexAdapter) {\n   756→        session.codexAdapter.sendBrowserMessage(msg);\n   757→      } else {\n   758→        // Adapter not yet attached — queue for when it's ready.\n   759→        // The adapter itself also queues during init, but this covers\n   760→        // the window between session creation and adapter attachment.\n   761→        console.log(`[ws-bridge] Codex adapter not yet attached for session ${session.id}, queuing ${msg.type}`);\n   762→        session.pendingMessages.push(JSON.stringify(msg));\n   763→      }\n   764→      return;\n   765→    }\n   766→\n   767→    // Claude Code path (existing logic)\n   768→    switch (msg.type) {\n   769→      case \"user_message\":\n   770→        this.handleUserMessage(session, msg);\n   771→        break;\n   772→\n   773→      case \"permission_response\":\n   774→        this.handlePermissionResponse(session, msg);\n   775→        break;\n   776→\n   777→      case \"interrupt\":\n   778→        this.handleInterrupt(session);\n   779→        break;\n   780→\n   781→      case \"set_model\":\n   782→        this.handleSetModel(session, msg.model);\n   783→        break;\n   784→\n   785→      case \"set_permission_mode\":\n   786→        this.handleSetPermissionMode(session, msg.mode);\n   787→        break;\n   788→    }\n   789→  }\n   790→\n   791→  private handleUserMessage(\n   792→    session: Session,\n   793→    msg: { type: \"user_message\"; content: string; session_id?: string; images?: { media_type: string; data: string }[] }\n   794→  ) {\n   795→    // Store user message in history for replay with stable ID for dedup on reconnect\n   796→    const ts = Date.now();\n   797→    session.messageHistory.push({\n   798→      type: \"user_message\",\n   799→      content: msg.content,\n   800→      timestamp: ts,\n   801→      id: `user-${ts}-${this.userMsgCounter++}`,\n   802→    });\n   803→\n   804→    // Build content: if images are present, use content block array; otherwise plain string\n   805→    let content: string | unknown[];\n   806→    if (msg.images?.length) {\n   807→      const blocks: unknown[] = [];\n   808→      for (const img of msg.images) {\n   809→        blocks.push({\n   810→          type: \"image\",\n   811→          source: { type: \"base64\", media_type: img.media_type, data: img.data },\n   812→        });\n   813→      }\n   814→      blocks.push({ type: \"text\", text: msg.content });\n   815→      content = blocks;\n   816→    } else {\n   817→      content = msg.content;\n   818→    }\n   819→\n   820→    const ndjson = JSON.stringify({\n   821→      type: \"user\",\n   822→      message: { role: \"user\", content },\n   823→      parent_tool_use_id: null,\n   824→      session_id: msg.session_id || session.state.session_id || \"\",\n   825→    });\n   826→    this.sendToCLI(session, ndjson);\n   827→    this.persistSession(session);\n   828→  }\n   829→\n   830→  private handlePermissionResponse(\n   831→    session: Session,\n   832→    msg: { type: \"permission_response\"; request_id: string; behavior: \"allow\" | \"deny\"; updated_input?: Record<string, unknown>; updated_permissions?: unknown[]; message?: string }\n   833→  ) {\n   834→    // Remove from pending\n   835→    const pending = session.pendingPermissions.get(msg.request_id);\n   836→    session.pendingPermissions.delete(msg.request_id);\n   837→\n   838→    if (msg.behavior === \"allow\") {\n   839→      const response: Record<string, unknown> = {\n   840→        behavior: \"allow\",\n   841→        updatedInput: msg.updated_input ?? pending?.input ?? {},\n   842→      };\n   843→      if (msg.updated_permissions?.length) {\n   844→        response.updatedPermissions = msg.updated_permissions;\n   845→      }\n   846→      const ndjson = JSON.stringify({\n   847→        type: \"control_response\",\n   848→        response: {\n   849→          subtype: \"success\",\n   850→          request_id: msg.request_id,\n   851→          response,\n   852→        },\n   853→      });\n   854→      this.sendToCLI(session, ndjson);\n   855→    } else {\n   856→      const ndjson = JSON.stringify({\n   857→        type: \"control_response\",\n   858→        response: {\n   859→          subtype: \"success\",\n   860→          request_id: msg.request_id,\n   861→          response: {\n   862→            behavior: \"deny\",\n   863→            message: msg.message || \"Denied by user\",\n   864→          },\n   865→        },\n   866→      });\n   867→      this.sendToCLI(session, ndjson);\n   868→    }\n   869→  }\n   870→\n   871→  private handleInterrupt(session: Session) {\n   872→    const ndjson = JSON.stringify({\n   873→      type: \"control_request\",\n   874→      request_id: randomUUID(),\n   875→      request: { subtype: \"interrupt\" },\n   876→    });\n   877→    this.sendToCLI(session, ndjson);\n   878→  }\n   879→\n   880→  private handleSetModel(session: Session, model: string) {\n   881→    const ndjson = JSON.stringify({\n   882→      type: \"control_request\",\n   883→      request_id: randomUUID(),\n   884→      request: { subtype: \"set_model\", model },\n   885→    });\n   886→    this.sendToCLI(session, ndjson);\n   887→  }\n   888→\n   889→  private handleSetPermissionMode(session: Session, mode: string) {\n   890→    const ndjson = JSON.stringify({\n   891→      type: \"control_request\",\n   892→      request_id: randomUUID(),\n   893→      request: { subtype: \"set_permission_mode\", mode },\n   894→    });\n   895→    this.sendToCLI(session, ndjson);\n   896→  }\n   897→\n   898→  // ── Transport helpers ───────────────────────────────────────────────────\n   899→\n   900→  private sendToCLI(session: Session, ndjson: string) {\n   901→    if (!session.cliSocket) {\n   902→      // Queue the message — CLI might still be starting up\n   903→      console.log(`[ws-bridge] CLI not yet connected for session ${session.id}, queuing message`);\n   904→      session.pendingMessages.push(ndjson);\n   905→      return;\n   906→    }\n   907→    try {\n   908→      // NDJSON requires a newline delimiter\n   909→      session.cliSocket.send(ndjson + \"\\n\");\n   910→    } catch (err) {\n   911→      console.error(`[ws-bridge] Failed to send to CLI for session ${session.id}:`, err);\n   912→    }\n   913→  }\n   914→\n   915→  /** Push a session name update to all connected browsers for a session. */\n   916→  broadcastNameUpdate(sessionId: string, name: string): void {\n   917→    const session = this.sessions.get(sessionId);\n   918→    if (!session) return;\n   919→    this.broadcastToBrowsers(session, { type: \"session_name_update\", name });\n   920→  }\n   921→\n   922→  private broadcastToBrowsers(session: Session, msg: BrowserIncomingMessage) {\n   923→    // Debug: warn when assistant messages are broadcast to 0 browsers (they may be lost)\n   924→    if (session.browserSockets.size === 0 && (msg.type === \"assistant\" || msg.type === \"stream_event\" || msg.type === \"result\")) {\n   925→      console.log(`[ws-bridge] ⚠ Broadcasting ${msg.type} to 0 browsers for session ${session.id} (stored in history: ${msg.type === \"assistant\" || msg.type === \"result\"})`);\n   926→    }\n   927→    const json = JSON.stringify(msg);\n   928→    for (const ws of session.browserSockets) {\n   929→      try {\n   930→        ws.send(json);\n   931→      } catch {\n   932→        session.browserSockets.delete(ws);\n   933→      }\n   934→    }\n   935→  }\n   936→\n   937→  private sendToBrowser(ws: ServerWebSocket<SocketData>, msg: BrowserIncomingMessage) {\n   938→    try {\n   939→      ws.send(JSON.stringify(msg));\n   940→    } catch {\n   941→      // Socket will be cleaned up on close\n   942→    }\n   943→  }\n   944→}\n   945→"}]},"parent_tool_use_id":null,"session_id":"6fd2c7b7-e807-4a5f-ab88-3c7663fd206d","uuid":"fb846b18-f5d4-4e8a-a075-fae540f75c6d","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/companion/web/server/ws-bridge.ts","content":"import type { ServerWebSocket } from \"bun\";\nimport { randomUUID } from \"node:crypto\";\nimport { execSync } from \"node:child_process\";\nimport { resolve } from \"node:path\";\nimport type {\n  CLIMessage,\n  CLISystemInitMessage,\n  CLISystemStatusMessage,\n  CLIAssistantMessage,\n  CLIResultMessage,\n  CLIStreamEventMessage,\n  CLIToolProgressMessage,\n  CLIToolUseSummaryMessage,\n  CLIControlRequestMessage,\n  CLIAuthStatusMessage,\n  BrowserOutgoingMessage,\n  BrowserIncomingMessage,\n  SessionState,\n  PermissionRequest,\n  BackendType,\n} from \"./session-types.js\";\nimport type { SessionStore } from \"./session-store.js\";\nimport type { CodexAdapter } from \"./codex-adapter.js\";\n\n// ─── WebSocket data tags ──────────────────────────────────────────────────────\n\ninterface CLISocketData {\n  kind: \"cli\";\n  sessionId: string;\n}\n\ninterface BrowserSocketData {\n  kind: \"browser\";\n  sessionId: string;\n}\n\nexport type SocketData = CLISocketData | BrowserSocketData;\n\n// ─── Session ──────────────────────────────────────────────────────────────────\n\ninterface Session {\n  id: string;\n  backendType: BackendType;\n  cliSocket: ServerWebSocket<SocketData> | null;\n  codexAdapter: CodexAdapter | null;\n  browserSockets: Set<ServerWebSocket<SocketData>>;\n  state: SessionState;\n  pendingPermissions: Map<string, PermissionRequest>;\n  messageHistory: BrowserIncomingMessage[];\n  /** Messages queued while waiting for CLI to connect */\n  pendingMessages: string[];\n}\n\nfunction makeDefaultState(sessionId: string, backendType: BackendType = \"claude\"): SessionState {\n  return {\n    session_id: sessionId,\n    backend_type: backendType,\n    model: \"\",\n    cwd: \"\",\n    tools: [],\n    permissionMode: \"default\",\n    claude_code_version: \"\",\n    mcp_servers: [],\n    agents: [],\n    slash_commands: [],\n    skills: [],\n    total_cost_usd: 0,\n    num_turns: 0,\n    context_used_percent: 0,\n    is_compacting: false,\n    git_branch: \"\",\n    is_worktree: false,\n    repo_root: \"\",\n    git_ahead: 0,\n    git_behind: 0,\n    total_lines_added: 0,\n    total_lines_removed: 0,\n  };\n}\n\n// ─── Git info helper ─────────────────────────────────────────────────────────\n\nfunction resolveGitInfo(state: SessionState): void {\n  if (!state.cwd) return;\n  try {\n    state.git_branch = execSync(\"git rev-parse --abbrev-ref HEAD\", {\n      cwd: state.cwd, encoding: \"utf-8\", timeout: 3000,\n    }).trim();\n\n    try {\n      const gitDir = execSync(\"git rev-parse --git-dir\", {\n        cwd: state.cwd, encoding: \"utf-8\", timeout: 3000,\n      }).trim();\n      state.is_worktree = gitDir.includes(\"/worktrees/\");\n    } catch { /* ignore */ }\n\n    try {\n      if (state.is_worktree) {\n        // For worktrees, --show-toplevel returns the worktree dir, not the original repo.\n        // Use --git-common-dir to find the shared .git dir, then derive the repo root.\n        const commonDir = execSync(\"git rev-parse --git-common-dir\", {\n          cwd: state.cwd, encoding: \"utf-8\", timeout: 3000,\n        }).trim();\n        state.repo_root = resolve(state.cwd, commonDir, \"..\");\n      } else {\n        state.repo_root = execSync(\"git rev-parse --show-toplevel\", {\n          cwd: state.cwd, encoding: \"utf-8\", timeout: 3000,\n        }).trim();\n      }\n    } catch { /* ignore */ }\n\n    try {\n      const counts = execSync(\n        \"git rev-list --left-right --count @{upstream}...HEAD\",\n        { cwd: state.cwd, encoding: \"utf-8\", timeout: 3000 },\n      ).trim();\n      const [behind, ahead] = counts.split(/\\s+/).map(Number);\n      state.git_ahead = ahead || 0;\n      state.git_behind = behind || 0;\n    } catch {\n      state.git_ahead = 0;\n      state.git_behind = 0;\n    }\n  } catch {\n    // Not a git repo or git not available\n  }\n}\n\n// ─── Bridge ───────────────────────────────────────────────────────────────────\n\nexport class WsBridge {\n  private sessions = new Map<string, Session>();\n  private store: SessionStore | null = null;\n  private onCLISessionId: ((sessionId: string, cliSessionId: string) => void) | null = null;\n  private onCLIRelaunchNeeded: ((sessionId: string) => void) | null = null;\n  private onFirstTurnCompleted: ((sessionId: string, firstUserMessage: string) => void) | null = null;\n  private autoNamingAttempted = new Set<string>();\n  private userMsgCounter = 0;\n\n  /** Register a callback for when we learn the CLI's internal session ID. */\n  onCLISessionIdReceived(cb: (sessionId: string, cliSessionId: string) => void): void {\n    this.onCLISessionId = cb;\n  }\n\n  /** Register a callback for when a browser connects but CLI is dead. */\n  onCLIRelaunchNeededCallback(cb: (sessionId: string) => void): void {\n    this.onCLIRelaunchNeeded = cb;\n  }\n\n  /** Register a callback for when a session completes its first turn. */\n  onFirstTurnCompletedCallback(cb: (sessionId: string, firstUserMessage: string) => void): void {\n    this.onFirstTurnCompleted = cb;\n  }\n\n  /** Attach a persistent store. Call restoreFromDisk() after. */\n  setStore(store: SessionStore): void {\n    this.store = store;\n  }\n\n  /** Restore sessions from disk (call once at startup). */\n  restoreFromDisk(): number {\n    if (!this.store) return 0;\n    const persisted = this.store.loadAll();\n    let count = 0;\n    for (const p of persisted) {\n      if (this.sessions.has(p.id)) continue; // don't overwrite live sessions\n      const session: Session = {\n        id: p.id,\n        backendType: p.state.backend_type || \"claude\",\n        cliSocket: null,\n        codexAdapter: null,\n        browserSockets: new Set(),\n        state: p.state,\n        pendingPermissions: new Map(p.pendingPermissions || []),\n        messageHistory: p.messageHistory || [],\n        pendingMessages: p.pendingMessages || [],\n      };\n      session.state.backend_type = session.backendType;\n      // Resolve git info for restored sessions (may have been persisted without it)\n      resolveGitInfo(session.state);\n      this.sessions.set(p.id, session);\n      // Restored sessions with completed turns don't need auto-naming re-triggered\n      if (session.state.num_turns > 0) {\n        this.autoNamingAttempted.add(session.id);\n      }\n      count++;\n    }\n    if (count > 0) {\n      console.log(`[ws-bridge] Restored ${count} session(s) from disk`);\n    }\n    return count;\n  }\n\n  /** Persist a session to disk (debounced). */\n  private persistSession(session: Session): void {\n    if (!this.store) return;\n    this.store.save({\n      id: session.id,\n      state: session.state,\n      messageHistory: session.messageHistory,\n      pendingMessages: session.pendingMessages,\n      pendingPermissions: Array.from(session.pendingPermissions.entries()),\n    });\n  }\n\n  // ── Session management ──────────────────────────────────────────────────\n\n  getOrCreateSession(sessionId: string, backendType?: BackendType): Session {\n    let session = this.sessions.get(sessionId);\n    if (!session) {\n      const type = backendType || \"claude\";\n      session = {\n        id: sessionId,\n        backendType: type,\n        cliSocket: null,\n        codexAdapter: null,\n        browserSockets: new Set(),\n        state: makeDefaultState(sessionId, type),\n        pendingPermissions: new Map(),\n        messageHistory: [],\n        pendingMessages: [],\n      };\n      this.sessions.set(sessionId, session);\n    } else if (backendType) {\n      // Only overwrite backendType when explicitly provided (e.g. attachCodexAdapter)\n      // Prevents handleBrowserOpen from resetting codex→claude\n      session.backendType = backendType;\n      session.state.backend_type = backendType;\n    }\n    return session;\n  }\n\n  getSession(sessionId: string): Session | undefined {\n    return this.sessions.get(sessionId);\n  }\n\n  getAllSessions(): SessionState[] {\n    return Array.from(this.sessions.values()).map((s) => s.state);\n  }\n\n  getCodexRateLimits(sessionId: string) {\n    const session = this.sessions.get(sessionId);\n    return session?.codexAdapter?.getRateLimits() ?? null;\n  }\n\n  isCliConnected(sessionId: string): boolean {\n    const session = this.sessions.get(sessionId);\n    if (!session) return false;\n    if (session.backendType === \"codex\") {\n      return !!session.codexAdapter?.isConnected();\n    }\n    return !!session.cliSocket;\n  }\n\n  removeSession(sessionId: string) {\n    this.sessions.delete(sessionId);\n    this.autoNamingAttempted.delete(sessionId);\n    this.store?.remove(sessionId);\n  }\n\n  /**\n   * Close all sockets (CLI + browsers) for a session and remove it.\n   */\n  closeSession(sessionId: string) {\n    const session = this.sessions.get(sessionId);\n    if (!session) return;\n\n    // Close CLI socket (Claude)\n    if (session.cliSocket) {\n      try { session.cliSocket.close(); } catch {}\n      session.cliSocket = null;\n    }\n\n    // Disconnect Codex adapter\n    if (session.codexAdapter) {\n      session.codexAdapter.disconnect().catch(() => {});\n      session.codexAdapter = null;\n    }\n\n    // Close all browser sockets\n    for (const ws of session.browserSockets) {\n      try { ws.close(); } catch {}\n    }\n    session.browserSockets.clear();\n\n    this.sessions.delete(sessionId);\n    this.autoNamingAttempted.delete(sessionId);\n    this.store?.remove(sessionId);\n  }\n\n  // ── Codex adapter attachment ────────────────────────────────────────────\n\n  /**\n   * Attach a CodexAdapter to a session. The adapter handles all message\n   * translation between the Codex app-server (stdio JSON-RPC) and the\n   * browser WebSocket protocol.\n   */\n  attachCodexAdapter(sessionId: string, adapter: CodexAdapter): void {\n    const session = this.getOrCreateSession(sessionId, \"codex\");\n    session.backendType = \"codex\";\n    session.state.backend_type = \"codex\";\n    session.codexAdapter = adapter;\n\n    // Forward translated messages to browsers\n    adapter.onBrowserMessage((msg) => {\n      if (msg.type === \"session_init\") {\n        session.state = { ...session.state, ...msg.session, backend_type: \"codex\" };\n        resolveGitInfo(session.state);\n        this.persistSession(session);\n      } else if (msg.type === \"session_update\") {\n        session.state = { ...session.state, ...msg.session, backend_type: \"codex\" };\n        this.persistSession(session);\n      } else if (msg.type === \"status_change\") {\n        session.state.is_compacting = msg.status === \"compacting\";\n        this.persistSession(session);\n      }\n\n      // Store assistant/result messages in history for replay\n      if (msg.type === \"assistant\") {\n        session.messageHistory.push({ ...msg, timestamp: msg.timestamp || Date.now() });\n        this.persistSession(session);\n      } else if (msg.type === \"result\") {\n        session.messageHistory.push(msg);\n        this.persistSession(session);\n      }\n\n      // Diagnostic: log tool_use assistant messages\n      if (msg.type === \"assistant\") {\n        const content = (msg as { message?: { content?: Array<{ type: string }> } }).message?.content;\n        const hasToolUse = content?.some((b) => b.type === \"tool_use\");\n        if (hasToolUse) {\n          console.log(`[ws-bridge] Broadcasting tool_use assistant to ${session.browserSockets.size} browser(s) for session ${session.id}`);\n        }\n      }\n\n      // Handle permission requests\n      if (msg.type === \"permission_request\") {\n        session.pendingPermissions.set(msg.request.request_id, msg.request);\n        this.persistSession(session);\n      }\n\n      this.broadcastToBrowsers(session, msg);\n\n      // Trigger auto-naming after the first result\n      if (\n        msg.type === \"result\" &&\n        !(msg.data as { is_error?: boolean }).is_error &&\n        this.onFirstTurnCompleted &&\n        !this.autoNamingAttempted.has(session.id)\n      ) {\n        this.autoNamingAttempted.add(session.id);\n        const firstUserMsg = session.messageHistory.find((m) => m.type === \"user_message\");\n        if (firstUserMsg && firstUserMsg.type === \"user_message\") {\n          this.onFirstTurnCompleted(session.id, firstUserMsg.content);\n        }\n      }\n    });\n\n    // Handle session metadata updates\n    adapter.onSessionMeta((meta) => {\n      if (meta.cliSessionId && this.onCLISessionId) {\n        this.onCLISessionId(session.id, meta.cliSessionId);\n      }\n      if (meta.model) session.state.model = meta.model;\n      if (meta.cwd) session.state.cwd = meta.cwd;\n      session.state.backend_type = \"codex\";\n      this.persistSession(session);\n    });\n\n    // Handle disconnect\n    adapter.onDisconnect(() => {\n      for (const [reqId] of session.pendingPermissions) {\n        this.broadcastToBrowsers(session, { type: \"permission_cancelled\", request_id: reqId });\n      }\n      session.pendingPermissions.clear();\n      session.codexAdapter = null;\n      this.persistSession(session);\n      console.log(`[ws-bridge] Codex adapter disconnected for session ${sessionId}`);\n      this.broadcastToBrowsers(session, { type: \"cli_disconnected\" });\n    });\n\n    // Flush any messages queued while waiting for the adapter\n    if (session.pendingMessages.length > 0) {\n      console.log(`[ws-bridge] Flushing ${session.pendingMessages.length} queued message(s) to Codex adapter for session ${sessionId}`);\n      const queued = session.pendingMessages.splice(0);\n      for (const raw of queued) {\n        try {\n          const msg = JSON.parse(raw) as BrowserOutgoingMessage;\n          adapter.sendBrowserMessage(msg);\n        } catch {\n          console.warn(`[ws-bridge] Failed to parse queued message for Codex: ${raw.substring(0, 100)}`);\n        }\n      }\n    }\n\n    // Notify browsers that the backend is connected\n    this.broadcastToBrowsers(session, { type: \"cli_connected\" });\n    console.log(`[ws-bridge] Codex adapter attached for session ${sessionId}`);\n  }\n\n  // ── CLI WebSocket handlers ──────────────────────────────────────────────\n\n  handleCLIOpen(ws: ServerWebSocket<SocketData>, sessionId: string) {\n    const session = this.getOrCreateSession(sessionId);\n    session.cliSocket = ws;\n    console.log(`[ws-bridge] CLI connected for session ${sessionId}`);\n    this.broadcastToBrowsers(session, { type: \"cli_connected\" });\n\n    // Flush any messages that were queued while waiting for CLI to connect\n    if (session.pendingMessages.length > 0) {\n      console.log(`[ws-bridge] Flushing ${session.pendingMessages.length} queued message(s) for session ${sessionId}`);\n      for (const ndjson of session.pendingMessages) {\n        this.sendToCLI(session, ndjson);\n      }\n      session.pendingMessages = [];\n    }\n  }\n\n  handleCLIMessage(ws: ServerWebSocket<SocketData>, raw: string | Buffer) {\n    const data = typeof raw === \"string\" ? raw : raw.toString(\"utf-8\");\n    const sessionId = (ws.data as CLISocketData).sessionId;\n    const session = this.sessions.get(sessionId);\n    if (!session) return;\n\n    // NDJSON: split on newlines, parse each line\n    const lines = data.split(\"\\n\").filter((l) => l.trim());\n    for (const line of lines) {\n      let msg: CLIMessage;\n      try {\n        msg = JSON.parse(line);\n      } catch {\n        console.warn(`[ws-bridge] Failed to parse CLI message: ${line.substring(0, 200)}`);\n        continue;\n      }\n      this.routeCLIMessage(session, msg);\n    }\n  }\n\n  handleCLIClose(ws: ServerWebSocket<SocketData>) {\n    const sessionId = (ws.data as CLISocketData).sessionId;\n    const session = this.sessions.get(sessionId);\n    if (!session) return;\n\n    session.cliSocket = null;\n    console.log(`[ws-bridge] CLI disconnected for session ${sessionId}`);\n    this.broadcastToBrowsers(session, { type: \"cli_disconnected\" });\n\n    // Cancel any pending permission requests\n    for (const [reqId] of session.pendingPermissions) {\n      this.broadcastToBrowsers(session, { type: \"permission_cancelled\", request_id: reqId });\n    }\n    session.pendingPermissions.clear();\n  }\n\n  // ── Browser WebSocket handlers ──────────────────────────────────────────\n\n  handleBrowserOpen(ws: ServerWebSocket<SocketData>, sessionId: string) {\n    const session = this.getOrCreateSession(sessionId);\n    session.browserSockets.add(ws);\n    console.log(`[ws-bridge] Browser connected for session ${sessionId} (${session.browserSockets.size} browsers)`);\n\n    // Send current session state as snapshot\n    const snapshot: BrowserIncomingMessage = {\n      type: \"session_init\",\n      session: session.state,\n    };\n    this.sendToBrowser(ws, snapshot);\n\n    // Replay message history so the browser can reconstruct the conversation\n    if (session.messageHistory.length > 0) {\n      this.sendToBrowser(ws, {\n        type: \"message_history\",\n        messages: session.messageHistory,\n      });\n    }\n\n    // Send any pending permission requests\n    for (const perm of session.pendingPermissions.values()) {\n      this.sendToBrowser(ws, { type: \"permission_request\", request: perm });\n    }\n\n    // Notify if backend is not connected and request relaunch\n    const backendConnected = session.backendType === \"codex\"\n      // Treat an attached adapter as \"alive\" during init.\n      // `isConnected()` flips true only after initialize/thread start, and\n      // relaunching during that window can kill a healthy startup.\n      ? !!session.codexAdapter\n      : !!session.cliSocket;\n\n    if (!backendConnected) {\n      this.sendToBrowser(ws, { type: \"cli_disconnected\" });\n      if (this.onCLIRelaunchNeeded) {\n        console.log(`[ws-bridge] Browser connected but backend is dead for session ${sessionId}, requesting relaunch`);\n        this.onCLIRelaunchNeeded(sessionId);\n      }\n    }\n  }\n\n  handleBrowserMessage(ws: ServerWebSocket<SocketData>, raw: string | Buffer) {\n    const data = typeof raw === \"string\" ? raw : raw.toString(\"utf-8\");\n    const sessionId = (ws.data as BrowserSocketData).sessionId;\n    const session = this.sessions.get(sessionId);\n    if (!session) return;\n\n    let msg: BrowserOutgoingMessage;\n    try {\n      msg = JSON.parse(data);\n    } catch {\n      console.warn(`[ws-bridge] Failed to parse browser message: ${data.substring(0, 200)}`);\n      return;\n    }\n\n    this.routeBrowserMessage(session, msg);\n  }\n\n  handleBrowserClose(ws: ServerWebSocket<SocketData>) {\n    const sessionId = (ws.data as BrowserSocketData).sessionId;\n    const session = this.sessions.get(sessionId);\n    if (!session) return;\n\n    session.browserSockets.delete(ws);\n    console.log(`[ws-bridge] Browser disconnected for session ${sessionId} (${session.browserSockets.size} browsers)`);\n  }\n\n  // ── CLI message routing ─────────────────────────────────────────────────\n\n  private routeCLIMessage(session: Session, msg: CLIMessage) {\n    switch (msg.type) {\n      case \"system\":\n        this.handleSystemMessage(session, msg);\n        break;\n\n      case \"assistant\":\n        this.handleAssistantMessage(session, msg);\n        break;\n\n      case \"result\":\n        this.handleResultMessage(session, msg);\n        break;\n\n      case \"stream_event\":\n        this.handleStreamEvent(session, msg);\n        break;\n\n      case \"control_request\":\n        this.handleControlRequest(session, msg);\n        break;\n\n      case \"tool_progress\":\n        this.handleToolProgress(session, msg);\n        break;\n\n      case \"tool_use_summary\":\n        this.handleToolUseSummary(session, msg);\n        break;\n\n      case \"auth_status\":\n        this.handleAuthStatus(session, msg);\n        break;\n\n      case \"keep_alive\":\n        // Silently consume keepalives\n        break;\n\n      default:\n        // Forward unknown messages as-is for debugging\n        break;\n    }\n  }\n\n  private handleSystemMessage(session: Session, msg: CLISystemInitMessage | CLISystemStatusMessage) {\n    if (msg.subtype === \"init\") {\n      // Keep the launcher-assigned session_id as the canonical ID.\n      // The CLI may report its own internal session_id which differs\n      // from the launcher UUID, causing duplicate entries in the sidebar.\n\n      // Store the CLI's internal session_id so we can --resume on relaunch\n      if (msg.session_id && this.onCLISessionId) {\n        this.onCLISessionId(session.id, msg.session_id);\n      }\n\n      session.state.model = msg.model;\n      session.state.cwd = msg.cwd;\n      session.state.tools = msg.tools;\n      session.state.permissionMode = msg.permissionMode;\n      session.state.claude_code_version = msg.claude_code_version;\n      session.state.mcp_servers = msg.mcp_servers;\n      session.state.agents = msg.agents ?? [];\n      session.state.slash_commands = msg.slash_commands ?? [];\n      session.state.skills = msg.skills ?? [];\n\n      // Resolve git info from session cwd\n      resolveGitInfo(session.state);\n\n      this.broadcastToBrowsers(session, {\n        type: \"session_init\",\n        session: session.state,\n      });\n      this.persistSession(session);\n    } else if (msg.subtype === \"status\") {\n      session.state.is_compacting = msg.status === \"compacting\";\n\n      if (msg.permissionMode) {\n        session.state.permissionMode = msg.permissionMode;\n      }\n\n      this.broadcastToBrowsers(session, {\n        type: \"status_change\",\n        status: msg.status ?? null,\n      });\n    }\n    // Other system subtypes (compact_boundary, task_notification, etc.) can be forwarded as needed\n  }\n\n  private handleAssistantMessage(session: Session, msg: CLIAssistantMessage) {\n    const browserMsg: BrowserIncomingMessage = {\n      type: \"assistant\",\n      message: msg.message,\n      parent_tool_use_id: msg.parent_tool_use_id,\n      timestamp: Date.now(),\n    };\n    session.messageHistory.push(browserMsg);\n    this.broadcastToBrowsers(session, browserMsg);\n    this.persistSession(session);\n  }\n\n  private handleResultMessage(session: Session, msg: CLIResultMessage) {\n    // Update session cost/turns\n    session.state.total_cost_usd = msg.total_cost_usd;\n    session.state.num_turns = msg.num_turns;\n\n    // Update lines changed (CLI may send these in result)\n    if (typeof msg.total_lines_added === \"number\") {\n      session.state.total_lines_added = msg.total_lines_added;\n    }\n    if (typeof msg.total_lines_removed === \"number\") {\n      session.state.total_lines_removed = msg.total_lines_removed;\n    }\n\n    // Compute context usage from modelUsage\n    if (msg.modelUsage) {\n      for (const usage of Object.values(msg.modelUsage)) {\n        if (usage.contextWindow > 0) {\n          const pct = Math.round(\n            ((usage.inputTokens + usage.outputTokens) / usage.contextWindow) * 100\n          );\n          session.state.context_used_percent = Math.max(0, Math.min(pct, 100));\n        }\n      }\n    }\n\n    const browserMsg: BrowserIncomingMessage = {\n      type: \"result\",\n      data: msg,\n    };\n    session.messageHistory.push(browserMsg);\n    this.broadcastToBrowsers(session, browserMsg);\n    this.persistSession(session);\n\n    // Trigger auto-naming after the first successful result for this session.\n    // Note: num_turns counts all internal tool-use turns, so it's typically > 1\n    // even on the first user interaction. We track per-session instead.\n    if (\n      !msg.is_error &&\n      this.onFirstTurnCompleted &&\n      !this.autoNamingAttempted.has(session.id)\n    ) {\n      this.autoNamingAttempted.add(session.id);\n      const firstUserMsg = session.messageHistory.find(\n        (m) => m.type === \"user_message\",\n      );\n      if (firstUserMsg && firstUserMsg.type === \"user_message\") {\n        this.onFirstTurnCompleted(session.id, firstUserMsg.content);\n      }\n    }\n  }\n\n  private handleStreamEvent(session: Session, msg: CLIStreamEventMessage) {\n    this.broadcastToBrowsers(session, {\n      type: \"stream_event\",\n      event: msg.event,\n      parent_tool_use_id: msg.parent_tool_use_id,\n    });\n  }\n\n  private handleControlRequest(session: Session, msg: CLIControlRequestMessage) {\n    if (msg.request.subtype === \"can_use_tool\") {\n      const perm: PermissionRequest = {\n        request_id: msg.request_id,\n        tool_name: msg.request.tool_name,\n        input: msg.request.input,\n        permission_suggestions: msg.request.permission_suggestions,\n        description: msg.request.description,\n        tool_use_id: msg.request.tool_use_id,\n        agent_id: msg.request.agent_id,\n        timestamp: Date.now(),\n      };\n      session.pendingPermissions.set(msg.request_id, perm);\n\n      this.broadcastToBrowsers(session, {\n        type: \"permission_request\",\n        request: perm,\n      });\n      this.persistSession(session);\n    }\n  }\n\n  private handleToolProgress(session: Session, msg: CLIToolProgressMessage) {\n    this.broadcastToBrowsers(session, {\n      type: \"tool_progress\",\n      tool_use_id: msg.tool_use_id,\n      tool_name: msg.tool_name,\n      elapsed_time_seconds: msg.elapsed_time_seconds,\n    });\n  }\n\n  private handleToolUseSummary(session: Session, msg: CLIToolUseSummaryMessage) {\n    this.broadcastToBrowsers(session, {\n      type: \"tool_use_summary\",\n      summary: msg.summary,\n      tool_use_ids: msg.preceding_tool_use_ids,\n    });\n  }\n\n  private handleAuthStatus(session: Session, msg: CLIAuthStatusMessage) {\n    this.broadcastToBrowsers(session, {\n      type: \"auth_status\",\n      isAuthenticating: msg.isAuthenticating,\n      output: msg.output,\n      error: msg.error,\n    });\n  }\n\n  // ── Browser message routing ─────────────────────────────────────────────\n\n  private routeBrowserMessage(session: Session, msg: BrowserOutgoingMessage) {\n    // For Codex sessions, delegate entirely to the adapter\n    if (session.backendType === \"codex\") {\n      // Store user messages in history for replay with stable ID for dedup on reconnect\n      if (msg.type === \"user_message\") {\n        const ts = Date.now();\n        session.messageHistory.push({\n          type: \"user_message\",\n          content: msg.content,\n          timestamp: ts,\n          id: `user-${ts}-${this.userMsgCounter++}`,\n        });\n        this.persistSession(session);\n      }\n      if (msg.type === \"permission_response\") {\n        session.pendingPermissions.delete(msg.request_id);\n        this.persistSession(session);\n      }\n\n      if (session.codexAdapter) {\n        session.codexAdapter.sendBrowserMessage(msg);\n      } else {\n        // Adapter not yet attached — queue for when it's ready.\n        // The adapter itself also queues during init, but this covers\n        // the window between session creation and adapter attachment.\n        console.log(`[ws-bridge] Codex adapter not yet attached for session ${session.id}, queuing ${msg.type}`);\n        session.pendingMessages.push(JSON.stringify(msg));\n      }\n      return;\n    }\n\n    // Claude Code path (existing logic)\n    switch (msg.type) {\n      case \"user_message\":\n        this.handleUserMessage(session, msg);\n        break;\n\n      case \"permission_response\":\n        this.handlePermissionResponse(session, msg);\n        break;\n\n      case \"interrupt\":\n        this.handleInterrupt(session);\n        break;\n\n      case \"set_model\":\n        this.handleSetModel(session, msg.model);\n        break;\n\n      case \"set_permission_mode\":\n        this.handleSetPermissionMode(session, msg.mode);\n        break;\n    }\n  }\n\n  private handleUserMessage(\n    session: Session,\n    msg: { type: \"user_message\"; content: string; session_id?: string; images?: { media_type: string; data: string }[] }\n  ) {\n    // Store user message in history for replay with stable ID for dedup on reconnect\n    const ts = Date.now();\n    session.messageHistory.push({\n      type: \"user_message\",\n      content: msg.content,\n      timestamp: ts,\n      id: `user-${ts}-${this.userMsgCounter++}`,\n    });\n\n    // Build content: if images are present, use content block array; otherwise plain string\n    let content: string | unknown[];\n    if (msg.images?.length) {\n      const blocks: unknown[] = [];\n      for (const img of msg.images) {\n        blocks.push({\n          type: \"image\",\n          source: { type: \"base64\", media_type: img.media_type, data: img.data },\n        });\n      }\n      blocks.push({ type: \"text\", text: msg.content });\n      content = blocks;\n    } else {\n      content = msg.content;\n    }\n\n    const ndjson = JSON.stringify({\n      type: \"user\",\n      message: { role: \"user\", content },\n      parent_tool_use_id: null,\n      session_id: msg.session_id || session.state.session_id || \"\",\n    });\n    this.sendToCLI(session, ndjson);\n    this.persistSession(session);\n  }\n\n  private handlePermissionResponse(\n    session: Session,\n    msg: { type: \"permission_response\"; request_id: string; behavior: \"allow\" | \"deny\"; updated_input?: Record<string, unknown>; updated_permissions?: unknown[]; message?: string }\n  ) {\n    // Remove from pending\n    const pending = session.pendingPermissions.get(msg.request_id);\n    session.pendingPermissions.delete(msg.request_id);\n\n    if (msg.behavior === \"allow\") {\n      const response: Record<string, unknown> = {\n        behavior: \"allow\",\n        updatedInput: msg.updated_input ?? pending?.input ?? {},\n      };\n      if (msg.updated_permissions?.length) {\n        response.updatedPermissions = msg.updated_permissions;\n      }\n      const ndjson = JSON.stringify({\n        type: \"control_response\",\n        response: {\n          subtype: \"success\",\n          request_id: msg.request_id,\n          response,\n        },\n      });\n      this.sendToCLI(session, ndjson);\n    } else {\n      const ndjson = JSON.stringify({\n        type: \"control_response\",\n        response: {\n          subtype: \"success\",\n          request_id: msg.request_id,\n          response: {\n            behavior: \"deny\",\n            message: msg.message || \"Denied by user\",\n          },\n        },\n      });\n      this.sendToCLI(session, ndjson);\n    }\n  }\n\n  private handleInterrupt(session: Session) {\n    const ndjson = JSON.stringify({\n      type: \"control_request\",\n      request_id: randomUUID(),\n      request: { subtype: \"interrupt\" },\n    });\n    this.sendToCLI(session, ndjson);\n  }\n\n  private handleSetModel(session: Session, model: string) {\n    const ndjson = JSON.stringify({\n      type: \"control_request\",\n      request_id: randomUUID(),\n      request: { subtype: \"set_model\", model },\n    });\n    this.sendToCLI(session, ndjson);\n  }\n\n  private handleSetPermissionMode(session: Session, mode: string) {\n    const ndjson = JSON.stringify({\n      type: \"control_request\",\n      request_id: randomUUID(),\n      request: { subtype: \"set_permission_mode\", mode },\n    });\n    this.sendToCLI(session, ndjson);\n  }\n\n  // ── Transport helpers ───────────────────────────────────────────────────\n\n  private sendToCLI(session: Session, ndjson: string) {\n    if (!session.cliSocket) {\n      // Queue the message — CLI might still be starting up\n      console.log(`[ws-bridge] CLI not yet connected for session ${session.id}, queuing message`);\n      session.pendingMessages.push(ndjson);\n      return;\n    }\n    try {\n      // NDJSON requires a newline delimiter\n      session.cliSocket.send(ndjson + \"\\n\");\n    } catch (err) {\n      console.error(`[ws-bridge] Failed to send to CLI for session ${session.id}:`, err);\n    }\n  }\n\n  /** Push a session name update to all connected browsers for a session. */\n  broadcastNameUpdate(sessionId: string, name: string): void {\n    const session = this.sessions.get(sessionId);\n    if (!session) return;\n    this.broadcastToBrowsers(session, { type: \"session_name_update\", name });\n  }\n\n  private broadcastToBrowsers(session: Session, msg: BrowserIncomingMessage) {\n    // Debug: warn when assistant messages are broadcast to 0 browsers (they may be lost)\n    if (session.browserSockets.size === 0 && (msg.type === \"assistant\" || msg.type === \"stream_event\" || msg.type === \"result\")) {\n      console.log(`[ws-bridge] ⚠ Broadcasting ${msg.type} to 0 browsers for session ${session.id} (stored in history: ${msg.type === \"assistant\" || msg.type === \"result\"})`);\n    }\n    const json = JSON.stringify(msg);\n    for (const ws of session.browserSockets) {\n      try {\n        ws.send(json);\n      } catch {\n        session.browserSockets.delete(ws);\n      }\n    }\n  }\n\n  private sendToBrowser(ws: ServerWebSocket<SocketData>, msg: BrowserIncomingMessage) {\n    try {\n      ws.send(JSON.stringify(msg));\n    } catch {\n      // Socket will be cleaned up on close\n    }\n  }\n}\n","numLines":945,"startLine":1,"totalLines":945}}}
