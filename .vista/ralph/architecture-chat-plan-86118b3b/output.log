{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0191y3TknQojwxRLNjLYdUaT","type":"tool_result","content":"     1→\"\"\"Architecture diagram viewing and chat.\"\"\"\n     2→from fastapi import APIRouter, HTTPException, Request\n     3→from fastapi.responses import PlainTextResponse\n     4→from fastapi.templating import Jinja2Templates\n     5→\n     6→from server import config\n     7→from server.services.project_service import ProjectService\n     8→from server.services.progress_service import ProgressService\n     9→from server.services.provider_service import get_enabled_providers\n    10→\n    11→router = APIRouter(tags=[\"architecture\"])\n    12→templates = Jinja2Templates(directory=str(config.VIEWS_DIR))\n    13→\n    14→\n    15→@router.get(\"/api/projects/{project_id}/features/{feature_name}/arch\")\n    16→async def get_arch_manifest(project_id: str, feature_name: str):\n    17→    \"\"\"Return the _arch.json manifest for a feature.\"\"\"\n    18→    project = ProjectService.get_by_id(project_id)\n    19→    if not project:\n    20→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    21→\n    22→    manifest = ProgressService.read_arch_manifest(project.path, feature_name)\n    23→    if manifest is None:\n    24→        raise HTTPException(status_code=404, detail=\"No architecture manifest found\")\n    25→\n    26→    return manifest\n    27→\n    28→\n    29→@router.get(\"/api/projects/{project_id}/features/{feature_name}/arch/{filename}\")\n    30→async def get_arch_file(project_id: str, feature_name: str, filename: str):\n    31→    \"\"\"Return raw content of a diagram file from arch/.\"\"\"\n    32→    project = ProjectService.get_by_id(project_id)\n    33→    if not project:\n    34→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    35→\n    36→    content = ProgressService.read_arch_file(project.path, feature_name, filename)\n    37→    if content is None:\n    38→        raise HTTPException(status_code=404, detail=\"Diagram file not found\")\n    39→\n    40→    # Determine content type\n    41→    if filename.endswith(\".mmd\"):\n    42→        media_type = \"text/plain\"\n    43→    elif filename.endswith(\".drawio\"):\n    44→        media_type = \"application/xml\"\n    45→    else:\n    46→        media_type = \"text/plain\"\n    47→\n    48→    return PlainTextResponse(content=content, media_type=media_type)\n    49→\n    50→\n    51→@router.get(\"/project/{project_id}/arch/{feature_name}\")\n    52→async def architecture_viewer_page(request: Request, project_id: str, feature_name: str):\n    53→    \"\"\"Render architecture diagram viewer page.\"\"\"\n    54→    project = ProjectService.get_by_id(project_id)\n    55→    if not project:\n    56→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    57→\n    58→    manifest = ProgressService.read_arch_manifest(project.path, feature_name)\n    59→    providers = [p.to_summary_dict() for p in get_enabled_providers()]\n    60→\n    61→    return templates.TemplateResponse(request, \"architecture.html\", {\n    62→        \"project\": project.to_dict(),\n    63→        \"feature_name\": feature_name,\n    64→        \"manifest\": manifest,\n    65→        \"providers\": providers,\n    66→    })\n    67→\n    68→\n    69→@router.get(\"/project/{project_id}/arch/{feature_name}/diagram/{filename}\")\n    70→async def diagram_expand_page(\n    71→    request: Request, project_id: str, feature_name: str, filename: str\n    72→):\n    73→    \"\"\"Render a single diagram in a full-page view.\"\"\"\n    74→    project = ProjectService.get_by_id(project_id)\n    75→    if not project:\n    76→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    77→\n    78→    content = ProgressService.read_arch_file(project.path, feature_name, filename)\n    79→    if content is None:\n    80→        raise HTTPException(status_code=404, detail=\"Diagram file not found\")\n    81→\n    82→    diagram_name = filename.rsplit(\".\", 1)[0].replace(\"-\", \" \").replace(\"_\", \" \").title()\n    83→\n    84→    return templates.TemplateResponse(request, \"diagram_expand.html\", {\n    85→        \"project\": project.to_dict(),\n    86→        \"feature_name\": feature_name,\n    87→        \"filename\": filename,\n    88→        \"diagram_name\": diagram_name,\n    89→    })\n    90→"}]},"parent_tool_use_id":null,"session_id":"615fcba1-13a5-40a3-839d-703775331047","uuid":"68ad48f3-0d34-4f11-93ad-eb14a08b1804","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/routes/architecture.py","content":"\"\"\"Architecture diagram viewing and chat.\"\"\"\nfrom fastapi import APIRouter, HTTPException, Request\nfrom fastapi.responses import PlainTextResponse\nfrom fastapi.templating import Jinja2Templates\n\nfrom server import config\nfrom server.services.project_service import ProjectService\nfrom server.services.progress_service import ProgressService\nfrom server.services.provider_service import get_enabled_providers\n\nrouter = APIRouter(tags=[\"architecture\"])\ntemplates = Jinja2Templates(directory=str(config.VIEWS_DIR))\n\n\n@router.get(\"/api/projects/{project_id}/features/{feature_name}/arch\")\nasync def get_arch_manifest(project_id: str, feature_name: str):\n    \"\"\"Return the _arch.json manifest for a feature.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    manifest = ProgressService.read_arch_manifest(project.path, feature_name)\n    if manifest is None:\n        raise HTTPException(status_code=404, detail=\"No architecture manifest found\")\n\n    return manifest\n\n\n@router.get(\"/api/projects/{project_id}/features/{feature_name}/arch/{filename}\")\nasync def get_arch_file(project_id: str, feature_name: str, filename: str):\n    \"\"\"Return raw content of a diagram file from arch/.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    content = ProgressService.read_arch_file(project.path, feature_name, filename)\n    if content is None:\n        raise HTTPException(status_code=404, detail=\"Diagram file not found\")\n\n    # Determine content type\n    if filename.endswith(\".mmd\"):\n        media_type = \"text/plain\"\n    elif filename.endswith(\".drawio\"):\n        media_type = \"application/xml\"\n    else:\n        media_type = \"text/plain\"\n\n    return PlainTextResponse(content=content, media_type=media_type)\n\n\n@router.get(\"/project/{project_id}/arch/{feature_name}\")\nasync def architecture_viewer_page(request: Request, project_id: str, feature_name: str):\n    \"\"\"Render architecture diagram viewer page.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    manifest = ProgressService.read_arch_manifest(project.path, feature_name)\n    providers = [p.to_summary_dict() for p in get_enabled_providers()]\n\n    return templates.TemplateResponse(request, \"architecture.html\", {\n        \"project\": project.to_dict(),\n        \"feature_name\": feature_name,\n        \"manifest\": manifest,\n        \"providers\": providers,\n    })\n\n\n@router.get(\"/project/{project_id}/arch/{feature_name}/diagram/{filename}\")\nasync def diagram_expand_page(\n    request: Request, project_id: str, feature_name: str, filename: str\n):\n    \"\"\"Render a single diagram in a full-page view.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    content = ProgressService.read_arch_file(project.path, feature_name, filename)\n    if content is None:\n        raise HTTPException(status_code=404, detail=\"Diagram file not found\")\n\n    diagram_name = filename.rsplit(\".\", 1)[0].replace(\"-\", \" \").replace(\"_\", \" \").title()\n\n    return templates.TemplateResponse(request, \"diagram_expand.html\", {\n        \"project\": project.to_dict(),\n        \"feature_name\": feature_name,\n        \"filename\": filename,\n        \"diagram_name\": diagram_name,\n    })\n","numLines":90,"startLine":1,"totalLines":90}}}
