{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014VP33tzDqWgy4rFDLfFquR","type":"tool_result","content":"     1→\"\"\"Chat service for AI diagram review via CLI providers.\n     2→\n     3→Provides both blocking and streaming invocation of CLI providers,\n     4→delegating command construction and output parsing to the Provider interface.\n     5→\"\"\"\n     6→\n     7→import asyncio\n     8→import subprocess\n     9→import threading\n    10→from collections.abc import AsyncGenerator\n    11→from typing import Optional\n    12→\n    13→from server.services.provider_service import (\n    14→    get_provider_by_name,\n    15→    _find_command,\n    16→    _IS_WINDOWS,\n    17→    Provider,\n    18→)\n    19→\n    20→\n    21→def _kill_proc(proc: subprocess.Popen) -> None:\n    22→    \"\"\"Kill a subprocess and its tree (Windows-safe).\"\"\"\n    23→    try:\n    24→        if _IS_WINDOWS:\n    25→            subprocess.run(\n    26→                [\"taskkill\", \"/T\", \"/F\", \"/PID\", str(proc.pid)],\n    27→                capture_output=True,\n    28→                timeout=5,\n    29→            )\n    30→        else:\n    31→            proc.kill()\n    32→        proc.wait(timeout=5)\n    33→    except Exception:\n    34→        pass\n    35→\n    36→\n    37→class ChatService:\n    38→    \"\"\"Service for handling chat interactions with AI providers.\"\"\"\n    39→\n    40→    def __init__(self):\n    41→        self._active_proc: subprocess.Popen | None = None\n    42→        self._lock = threading.Lock()\n    43→\n    44→    def cancel(self) -> bool:\n    45→        \"\"\"Cancel the currently running chat subprocess, if any.\"\"\"\n    46→        with self._lock:\n    47→            proc = self._active_proc\n    48→            if proc is None:\n    49→                return False\n    50→            _kill_proc(proc)\n    51→            self._active_proc = None\n    52→            return True\n    53→\n    54→    @staticmethod\n    55→    def build_prompt(\n    56→        message: str,\n    57→        context: Optional[str] = None,\n    58→        history: Optional[list[dict]] = None,\n    59→        arch_dir: Optional[str] = None,\n    60→        project_root: Optional[str] = None,\n    61→    ) -> str:\n    62→        \"\"\"Build a complete prompt from context, history, and user message.\"\"\"\n    63→        parts = []\n    64→\n    65→        if arch_dir and project_root:\n    66→            parts.append(\n    67→                \"You are an architecture documentation assistant.\\n\"\n    68→                f\"You can read files anywhere in the project for context: {project_root}\\n\"\n    69→                f\"You ONLY edit .mmd diagram files in the arch directory: {arch_dir}\\n\"\n    70→                \"Do NOT edit source code or any files outside the arch directory.\\n\"\n    71→                \"When asked to modify diagrams, edit the .mmd files directly.\\n\"\n    72→                \"Provide clear, concise feedback on the provided diagrams.\\n\"\n    73→                \"When discussing diagrams, be specific and reference node names and connections.\"\n    74→            )\n    75→        else:\n    76→            parts.append(\n    77→                \"You are an expert software architect reviewing architecture diagrams. \"\n    78→                \"Provide clear, concise feedback on the provided diagrams. \"\n    79→                \"When discussing code or diagrams, be specific and reference relevant parts.\"\n    80→            )\n    81→        parts.append(\"\")\n    82→\n    83→        if context:\n    84→            parts.append(\"--- DIAGRAM CONTEXT ---\")\n    85→            parts.append(context)\n    86→            parts.append(\"--- END CONTEXT ---\")\n    87→            parts.append(\"\")\n    88→\n    89→        if history:\n    90→            parts.append(\"--- CONVERSATION HISTORY ---\")\n    91→            for msg in history:\n    92→                role = msg.get(\"role\", \"user\")\n    93→                content = msg.get(\"content\", \"\")\n    94→                parts.append(f\"{role.upper()}: {content}\")\n    95→            parts.append(\"--- END HISTORY ---\")\n    96→            parts.append(\"\")\n    97→\n    98→        parts.append(f\"USER: {message}\")\n    99→        parts.append(\"\")\n   100→        parts.append(\"ASSISTANT:\")\n   101→\n   102→        return \"\\n\".join(parts)\n   103→\n   104→    def invoke_provider(\n   105→        self,\n   106→        provider_name: str,\n   107→        model: str,\n   108→        prompt: str,\n   109→        timeout: int = 90,\n   110→    ) -> tuple[bool, str]:\n   111→        \"\"\"Invoke a CLI provider with the given prompt (blocking).\n   112→\n   113→        This method is blocking and should be called via asyncio.to_thread().\n   114→        \"\"\"\n   115→        provider = get_provider_by_name(provider_name)\n   116→        if provider is None:\n   117→            return False, f\"Provider '{provider_name}' not found or not enabled\"\n   118→\n   119→        cmd = provider.get_chat_cmd(model, streaming=False, permissions=True)\n   120→        if cmd is None:\n   121→            cmd_path = _find_command(provider_name)\n   122→            if cmd_path is None:\n   123→                return False, f\"CLI command '{provider_name}' not found in PATH\"\n   124→            if provider_name == \"claude\":\n   125→                cmd = [cmd_path, \"-p\", \"--model\", model]\n   126→            elif provider_name == \"opencode\":\n   127→                cmd = [cmd_path, \"run\", \"--model\", model, prompt]\n   128→            else:\n   129→                return False, f\"Unknown provider: {provider_name}\"\n   130→\n   131→        kwargs: dict = dict(\n   132→            stdout=subprocess.PIPE,\n   133→            stderr=subprocess.PIPE,\n   134→            text=True,\n   135→            encoding=\"utf-8\",\n   136→            errors=\"replace\",\n   137→        )\n   138→\n   139→        if provider.stdin_pipe:\n   140→            kwargs[\"stdin\"] = subprocess.PIPE\n   141→        else:\n   142→            cmd = list(cmd) + [prompt]\n   143→            kwargs[\"stdin\"] = subprocess.DEVNULL\n   144→\n   145→        if _IS_WINDOWS:\n   146→            kwargs[\"creationflags\"] = subprocess.CREATE_NO_WINDOW\n   147→            if cmd[0].endswith((\".cmd\", \".bat\")):\n   148→                cmd = [\"cmd.exe\", \"/c\"] + cmd\n   149→\n   150→        proc = subprocess.Popen(cmd, **kwargs)\n   151→        with self._lock:\n   152→            self._active_proc = proc\n   153→\n   154→        try:\n   155→            if provider.stdin_pipe:\n   156→                stdout, stderr = proc.communicate(input=prompt, timeout=timeout)\n   157→            else:\n   158→                stdout, stderr = proc.communicate(timeout=timeout)\n   159→        except subprocess.TimeoutExpired:\n   160→            _kill_proc(proc)\n   161→            return False, f\"Request timed out after {timeout} seconds\"\n   162→        finally:\n   163→            with self._lock:\n   164→                self._active_proc = None\n   165→\n   166→        if proc.returncode != 0:\n   167→            error_msg = stderr.strip() if stderr else \"Unknown error\"\n   168→            if proc.returncode in (-9, 1) and not error_msg:\n   169→                return False, \"Request was cancelled\"\n   170→            return False, f\"CLI error (code {proc.returncode}): {error_msg}\"\n   171→\n   172→        return True, (stdout or \"\").strip()\n   173→\n   174→    async def invoke_provider_streaming(\n   175→        self,\n   176→        provider_name: str,\n   177→        model: str,\n   178→        prompt: str,\n   179→        cwd: Optional[str] = None,\n   180→    ) -> AsyncGenerator[dict, None]:\n   181→        \"\"\"Invoke a CLI provider and yield streaming events.\n   182→\n   183→        Yields dicts with \"type\" key: \"token\", \"done\", \"result\", or \"error\".\n   184→        For non-streaming providers, yields one \"token\" + \"done\" after completion.\n   185→        \"\"\"\n   186→        provider = get_provider_by_name(provider_name)\n   187→        if provider is None:\n   188→            yield {\"type\": \"error\", \"detail\": f\"Provider '{provider_name}' not found or not enabled\"}\n   189→            return\n   190→\n   191→        use_streaming = provider.supports_streaming\n   192→\n   193→        cmd = provider.get_chat_cmd(\n   194→            model,\n   195→            streaming=use_streaming,\n   196→            permissions=True,\n   197→        )\n   198→        if cmd is None:\n   199→            yield {\"type\": \"error\", \"detail\": f\"CLI command for '{provider_name}' not found in PATH\"}\n   200→            return\n   201→\n   202→        # Build subprocess kwargs\n   203→        kwargs: dict = dict(\n   204→            text=True,\n   205→            encoding=\"utf-8\",\n   206→            errors=\"replace\",\n   207→            bufsize=1,  # Line-buffered for streaming\n   208→        )\n   209→\n   210→        if provider.stdin_pipe:\n   211→            kwargs[\"stdin\"] = subprocess.PIPE\n   212→        else:\n   213→            cmd = list(cmd) + [prompt]\n   214→            kwargs[\"stdin\"] = subprocess.DEVNULL\n   215→\n   216→        if use_streaming:\n   217→            # Merge stderr into stdout so verbose output doesn't deadlock the pipe.\n   218→            # Non-JSON lines (verbose/error) are collected separately.\n   219→            kwargs[\"stdout\"] = subprocess.PIPE\n   220→            kwargs[\"stderr\"] = subprocess.STDOUT\n   221→        else:\n   222→            kwargs[\"stdout\"] = subprocess.PIPE\n   223→            kwargs[\"stderr\"] = subprocess.PIPE\n   224→\n   225→        if cwd:\n   226→            kwargs[\"cwd\"] = cwd\n   227→        if _IS_WINDOWS:\n   228→            kwargs[\"creationflags\"] = subprocess.CREATE_NO_WINDOW\n   229→            if cmd[0].endswith((\".cmd\", \".bat\")):\n   230→                cmd = [\"cmd.exe\", \"/c\"] + cmd\n   231→\n   232→        proc = subprocess.Popen(cmd, **kwargs)\n   233→\n   234→        # Write prompt to stdin and close it\n   235→        if provider.stdin_pipe:\n   236→            try:\n   237→                proc.stdin.write(prompt)\n   238→                proc.stdin.flush()\n   239→                proc.stdin.close()\n   240→            except Exception as e:\n   241→                yield {\"type\": \"error\", \"detail\": f\"Failed to write prompt to stdin: {e}\"}\n   242→                return\n   243→\n   244→        with self._lock:\n   245→            self._active_proc = proc\n   246→\n   247→        try:\n   248→            if use_streaming:\n   249→                loop = asyncio.get_running_loop()\n   250→                full_text: list[str] = []\n   251→                non_json_lines: list[str] = []\n   252→\n   253→                while True:\n   254→                    line = await loop.run_in_executor(None, proc.stdout.readline)\n   255→                    if not line:\n   256→                        break\n   257→                    line = line.rstrip(\"\\n\\r\")\n   258→                    if not line:\n   259→                        continue\n   260→\n   261→                    event = provider.parse_stream_event(line)\n   262→                    if event is not None:\n   263→                        if event[\"type\"] == \"token\":\n   264→                            full_text.append(event[\"text\"])\n   265→                        yield event\n   266→                    else:\n   267→                        # Non-JSON line (verbose output, errors, etc.)\n   268→                        non_json_lines.append(line)\n   269→\n   270→                await loop.run_in_executor(None, proc.wait)\n   271→\n   272→                if proc.returncode != 0:\n   273→                    context = \"\\n\".join(non_json_lines[-10:]) if non_json_lines else \"(no output)\"\n   274→                    yield {\"type\": \"error\", \"detail\": f\"CLI error (code {proc.returncode}):\\n{context}\"}\n   275→                else:\n   276→                    yield {\"type\": \"done\", \"content\": \"\".join(full_text)}\n   277→            else:\n   278→                # Non-streaming fallback: collect all output then yield at once\n   279→                loop = asyncio.get_running_loop()\n   280→                if provider.stdin_pipe:\n   281→                    stdout, stderr = await loop.run_in_executor(None, proc.communicate)\n   282→                else:\n   283→                    stdout, stderr = await loop.run_in_executor(None, proc.communicate)\n   284→\n   285→                if proc.returncode != 0:\n   286→                    error_msg = (stderr or \"\").strip() if stderr else \"(no stderr)\"\n   287→                    yield {\"type\": \"error\", \"detail\": f\"CLI error (code {proc.returncode}): {error_msg}\"}\n   288→                    return\n   289→\n   290→                response = (stdout or \"\").strip()\n   291→                yield {\"type\": \"token\", \"text\": response}\n   292→                yield {\"type\": \"done\", \"content\": response}\n   293→\n   294→        except asyncio.CancelledError:\n   295→            self.cancel()\n   296→        except Exception as e:\n   297→            yield {\"type\": \"error\", \"detail\": f\"Failed to invoke provider: {e}\"}\n   298→        finally:\n   299→            with self._lock:\n   300→                self._active_proc = None\n   301→\n   302→\n   303→# Singleton instance\n   304→chat_service = ChatService()\n   305→"}]},"parent_tool_use_id":null,"session_id":"615fcba1-13a5-40a3-839d-703775331047","uuid":"317c0762-03cf-43a3-a406-24459cf99c26","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/services/chat_service.py","content":"\"\"\"Chat service for AI diagram review via CLI providers.\n\nProvides both blocking and streaming invocation of CLI providers,\ndelegating command construction and output parsing to the Provider interface.\n\"\"\"\n\nimport asyncio\nimport subprocess\nimport threading\nfrom collections.abc import AsyncGenerator\nfrom typing import Optional\n\nfrom server.services.provider_service import (\n    get_provider_by_name,\n    _find_command,\n    _IS_WINDOWS,\n    Provider,\n)\n\n\ndef _kill_proc(proc: subprocess.Popen) -> None:\n    \"\"\"Kill a subprocess and its tree (Windows-safe).\"\"\"\n    try:\n        if _IS_WINDOWS:\n            subprocess.run(\n                [\"taskkill\", \"/T\", \"/F\", \"/PID\", str(proc.pid)],\n                capture_output=True,\n                timeout=5,\n            )\n        else:\n            proc.kill()\n        proc.wait(timeout=5)\n    except Exception:\n        pass\n\n\nclass ChatService:\n    \"\"\"Service for handling chat interactions with AI providers.\"\"\"\n\n    def __init__(self):\n        self._active_proc: subprocess.Popen | None = None\n        self._lock = threading.Lock()\n\n    def cancel(self) -> bool:\n        \"\"\"Cancel the currently running chat subprocess, if any.\"\"\"\n        with self._lock:\n            proc = self._active_proc\n            if proc is None:\n                return False\n            _kill_proc(proc)\n            self._active_proc = None\n            return True\n\n    @staticmethod\n    def build_prompt(\n        message: str,\n        context: Optional[str] = None,\n        history: Optional[list[dict]] = None,\n        arch_dir: Optional[str] = None,\n        project_root: Optional[str] = None,\n    ) -> str:\n        \"\"\"Build a complete prompt from context, history, and user message.\"\"\"\n        parts = []\n\n        if arch_dir and project_root:\n            parts.append(\n                \"You are an architecture documentation assistant.\\n\"\n                f\"You can read files anywhere in the project for context: {project_root}\\n\"\n                f\"You ONLY edit .mmd diagram files in the arch directory: {arch_dir}\\n\"\n                \"Do NOT edit source code or any files outside the arch directory.\\n\"\n                \"When asked to modify diagrams, edit the .mmd files directly.\\n\"\n                \"Provide clear, concise feedback on the provided diagrams.\\n\"\n                \"When discussing diagrams, be specific and reference node names and connections.\"\n            )\n        else:\n            parts.append(\n                \"You are an expert software architect reviewing architecture diagrams. \"\n                \"Provide clear, concise feedback on the provided diagrams. \"\n                \"When discussing code or diagrams, be specific and reference relevant parts.\"\n            )\n        parts.append(\"\")\n\n        if context:\n            parts.append(\"--- DIAGRAM CONTEXT ---\")\n            parts.append(context)\n            parts.append(\"--- END CONTEXT ---\")\n            parts.append(\"\")\n\n        if history:\n            parts.append(\"--- CONVERSATION HISTORY ---\")\n            for msg in history:\n                role = msg.get(\"role\", \"user\")\n                content = msg.get(\"content\", \"\")\n                parts.append(f\"{role.upper()}: {content}\")\n            parts.append(\"--- END HISTORY ---\")\n            parts.append(\"\")\n\n        parts.append(f\"USER: {message}\")\n        parts.append(\"\")\n        parts.append(\"ASSISTANT:\")\n\n        return \"\\n\".join(parts)\n\n    def invoke_provider(\n        self,\n        provider_name: str,\n        model: str,\n        prompt: str,\n        timeout: int = 90,\n    ) -> tuple[bool, str]:\n        \"\"\"Invoke a CLI provider with the given prompt (blocking).\n\n        This method is blocking and should be called via asyncio.to_thread().\n        \"\"\"\n        provider = get_provider_by_name(provider_name)\n        if provider is None:\n            return False, f\"Provider '{provider_name}' not found or not enabled\"\n\n        cmd = provider.get_chat_cmd(model, streaming=False, permissions=True)\n        if cmd is None:\n            cmd_path = _find_command(provider_name)\n            if cmd_path is None:\n                return False, f\"CLI command '{provider_name}' not found in PATH\"\n            if provider_name == \"claude\":\n                cmd = [cmd_path, \"-p\", \"--model\", model]\n            elif provider_name == \"opencode\":\n                cmd = [cmd_path, \"run\", \"--model\", model, prompt]\n            else:\n                return False, f\"Unknown provider: {provider_name}\"\n\n        kwargs: dict = dict(\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            text=True,\n            encoding=\"utf-8\",\n            errors=\"replace\",\n        )\n\n        if provider.stdin_pipe:\n            kwargs[\"stdin\"] = subprocess.PIPE\n        else:\n            cmd = list(cmd) + [prompt]\n            kwargs[\"stdin\"] = subprocess.DEVNULL\n\n        if _IS_WINDOWS:\n            kwargs[\"creationflags\"] = subprocess.CREATE_NO_WINDOW\n            if cmd[0].endswith((\".cmd\", \".bat\")):\n                cmd = [\"cmd.exe\", \"/c\"] + cmd\n\n        proc = subprocess.Popen(cmd, **kwargs)\n        with self._lock:\n            self._active_proc = proc\n\n        try:\n            if provider.stdin_pipe:\n                stdout, stderr = proc.communicate(input=prompt, timeout=timeout)\n            else:\n                stdout, stderr = proc.communicate(timeout=timeout)\n        except subprocess.TimeoutExpired:\n            _kill_proc(proc)\n            return False, f\"Request timed out after {timeout} seconds\"\n        finally:\n            with self._lock:\n                self._active_proc = None\n\n        if proc.returncode != 0:\n            error_msg = stderr.strip() if stderr else \"Unknown error\"\n            if proc.returncode in (-9, 1) and not error_msg:\n                return False, \"Request was cancelled\"\n            return False, f\"CLI error (code {proc.returncode}): {error_msg}\"\n\n        return True, (stdout or \"\").strip()\n\n    async def invoke_provider_streaming(\n        self,\n        provider_name: str,\n        model: str,\n        prompt: str,\n        cwd: Optional[str] = None,\n    ) -> AsyncGenerator[dict, None]:\n        \"\"\"Invoke a CLI provider and yield streaming events.\n\n        Yields dicts with \"type\" key: \"token\", \"done\", \"result\", or \"error\".\n        For non-streaming providers, yields one \"token\" + \"done\" after completion.\n        \"\"\"\n        provider = get_provider_by_name(provider_name)\n        if provider is None:\n            yield {\"type\": \"error\", \"detail\": f\"Provider '{provider_name}' not found or not enabled\"}\n            return\n\n        use_streaming = provider.supports_streaming\n\n        cmd = provider.get_chat_cmd(\n            model,\n            streaming=use_streaming,\n            permissions=True,\n        )\n        if cmd is None:\n            yield {\"type\": \"error\", \"detail\": f\"CLI command for '{provider_name}' not found in PATH\"}\n            return\n\n        # Build subprocess kwargs\n        kwargs: dict = dict(\n            text=True,\n            encoding=\"utf-8\",\n            errors=\"replace\",\n            bufsize=1,  # Line-buffered for streaming\n        )\n\n        if provider.stdin_pipe:\n            kwargs[\"stdin\"] = subprocess.PIPE\n        else:\n            cmd = list(cmd) + [prompt]\n            kwargs[\"stdin\"] = subprocess.DEVNULL\n\n        if use_streaming:\n            # Merge stderr into stdout so verbose output doesn't deadlock the pipe.\n            # Non-JSON lines (verbose/error) are collected separately.\n            kwargs[\"stdout\"] = subprocess.PIPE\n            kwargs[\"stderr\"] = subprocess.STDOUT\n        else:\n            kwargs[\"stdout\"] = subprocess.PIPE\n            kwargs[\"stderr\"] = subprocess.PIPE\n\n        if cwd:\n            kwargs[\"cwd\"] = cwd\n        if _IS_WINDOWS:\n            kwargs[\"creationflags\"] = subprocess.CREATE_NO_WINDOW\n            if cmd[0].endswith((\".cmd\", \".bat\")):\n                cmd = [\"cmd.exe\", \"/c\"] + cmd\n\n        proc = subprocess.Popen(cmd, **kwargs)\n\n        # Write prompt to stdin and close it\n        if provider.stdin_pipe:\n            try:\n                proc.stdin.write(prompt)\n                proc.stdin.flush()\n                proc.stdin.close()\n            except Exception as e:\n                yield {\"type\": \"error\", \"detail\": f\"Failed to write prompt to stdin: {e}\"}\n                return\n\n        with self._lock:\n            self._active_proc = proc\n\n        try:\n            if use_streaming:\n                loop = asyncio.get_running_loop()\n                full_text: list[str] = []\n                non_json_lines: list[str] = []\n\n                while True:\n                    line = await loop.run_in_executor(None, proc.stdout.readline)\n                    if not line:\n                        break\n                    line = line.rstrip(\"\\n\\r\")\n                    if not line:\n                        continue\n\n                    event = provider.parse_stream_event(line)\n                    if event is not None:\n                        if event[\"type\"] == \"token\":\n                            full_text.append(event[\"text\"])\n                        yield event\n                    else:\n                        # Non-JSON line (verbose output, errors, etc.)\n                        non_json_lines.append(line)\n\n                await loop.run_in_executor(None, proc.wait)\n\n                if proc.returncode != 0:\n                    context = \"\\n\".join(non_json_lines[-10:]) if non_json_lines else \"(no output)\"\n                    yield {\"type\": \"error\", \"detail\": f\"CLI error (code {proc.returncode}):\\n{context}\"}\n                else:\n                    yield {\"type\": \"done\", \"content\": \"\".join(full_text)}\n            else:\n                # Non-streaming fallback: collect all output then yield at once\n                loop = asyncio.get_running_loop()\n                if provider.stdin_pipe:\n                    stdout, stderr = await loop.run_in_executor(None, proc.communicate)\n                else:\n                    stdout, stderr = await loop.run_in_executor(None, proc.communicate)\n\n                if proc.returncode != 0:\n                    error_msg = (stderr or \"\").strip() if stderr else \"(no stderr)\"\n                    yield {\"type\": \"error\", \"detail\": f\"CLI error (code {proc.returncode}): {error_msg}\"}\n                    return\n\n                response = (stdout or \"\").strip()\n                yield {\"type\": \"token\", \"text\": response}\n                yield {\"type\": \"done\", \"content\": response}\n\n        except asyncio.CancelledError:\n            self.cancel()\n        except Exception as e:\n            yield {\"type\": \"error\", \"detail\": f\"Failed to invoke provider: {e}\"}\n        finally:\n            with self._lock:\n                self._active_proc = None\n\n\n# Singleton instance\nchat_service = ChatService()\n","numLines":305,"startLine":1,"totalLines":305}}}
