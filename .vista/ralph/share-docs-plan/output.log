{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DHpjYci8AESygqZQh586qh","type":"tool_result","content":"     1→{% extends \"_base.html\" %}\n     2→\n     3→{% block title %}{{ project.name }} - Ralph Loop{% endblock %}\n     4→\n     5→{% block content %}\n     6→<div class=\"mb-8\">\n     7→    <div class=\"flex flex-wrap items-center gap-3 mb-2\">\n     8→        <a href=\"/\" class=\"text-gray-400 hover:text-gray-300\">&larr; Dashboard</a>\n     9→        <span class=\"text-gray-600\">/</span>\n    10→        <h1 class=\"text-3xl font-bold\">{{ project.name }}</h1>\n    11→        <button onclick=\"removeProject('{{ project.id }}', '{{ project.name }}', '{{ loop_state.status }}')\"\n    12→                class=\"ml-auto px-3 py-1.5 rounded border border-gray-600 text-gray-300 hover:border-red-600 hover:text-red-300 text-sm transition-colors\">\n    13→            Remove Project\n    14→        </button>\n    15→    </div>\n    16→    <p class=\"text-gray-400 text-sm\">{{ project.path }}</p>\n    17→</div>\n    18→\n    19→<div class=\"mb-6 border-b border-gray-700\">\n    20→    <div class=\"flex items-center gap-2\" role=\"tablist\">\n    21→        <button id=\"tab-overview-btn\" onclick=\"showProjectTab('overview')\"\n    22→                class=\"project-tab-btn px-4 py-2 text-sm rounded-t-md border border-b-0 border-gray-700 bg-gray-800 text-gray-200\">\n    23→            Overview\n    24→        </button>\n    25→        <button id=\"tab-loops-btn\" onclick=\"showProjectTab('loops')\"\n    26→                class=\"project-tab-btn px-4 py-2 text-sm rounded-t-md border border-b-0 border-gray-700 bg-gray-900 text-gray-400 hover:text-gray-200\">\n    27→            Ralph Loops\n    28→        </button>\n    29→    </div>\n    30→</div>\n    31→\n    32→<section id=\"tab-overview\" class=\"space-y-6\">\n    33→    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n    34→        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n    35→            <p class=\"text-xs text-gray-400 mb-1\">Features</p>\n    36→            <p class=\"text-2xl font-semibold\">{{ features|length }}</p>\n    37→        </div>\n    38→        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n    39→            <p class=\"text-xs text-gray-400 mb-1\">Loop Status</p>\n    40→            <p class=\"text-2xl font-semibold capitalize\">{{ loop_state.status }}</p>\n    41→        </div>\n    42→        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n    43→            <p class=\"text-xs text-gray-400 mb-1\">Docs Readiness</p>\n    44→            <p class=\"text-2xl font-semibold\">{{ features | selectattr('has_implementation_plan') | list | length }}/{{ features|length }}</p>\n    45→        </div>\n    46→    </div>\n    47→\n    48→    <div class=\"bg-gray-800 rounded-lg border border-gray-700 overflow-hidden\">\n    49→        <div class=\"px-4 py-3 border-b border-gray-700\">\n    50→            <h2 class=\"text-base font-semibold\">Feature Documentation</h2>\n    51→            <p class=\"text-xs text-gray-400 mt-1\">Overview of specs, plans, prompts, and architecture docs</p>\n    52→        </div>\n    53→\n    54→        {% if features %}\n    55→        <div class=\"divide-y divide-gray-700\">\n    56→            {% for feature in features %}\n    57→            <div class=\"px-4 py-3 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3\">\n    58→                <div>\n    59→                    <p class=\"font-medium text-gray-100\">{{ feature.name }}</p>\n    60→                    <div class=\"flex flex-wrap items-center gap-2 mt-1 text-xs\">\n    61→                        <span class=\"px-2 py-0.5 rounded border border-gray-600 text-gray-300\">Specs: {{ feature.spec_count }}</span>\n    62→                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_implementation_plan %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n    63→                            Impl Plan {% if feature.has_implementation_plan %}✓{% else %}—{% endif %}\n    64→                        </span>\n    65→                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_agents_md %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n    66→                            AGENTS.md {% if feature.has_agents_md %}✓{% else %}—{% endif %}\n    67→                        </span>\n    68→                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_prompt_build or feature.has_prompt_plan %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n    69→                            PROMPTs {% if feature.has_prompt_build or feature.has_prompt_plan %}✓{% else %}—{% endif %}\n    70→                        </span>\n    71→                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_arch_manifest %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n    72→                            Arch {% if feature.has_arch_manifest %}{{ feature.arch_diagram_count }}{% else %}—{% endif %}\n    73→                        </span>\n    74→                    </div>\n    75→                </div>\n    76→                <div class=\"flex items-center gap-2 text-xs\">\n    77→                    <a href=\"/project/{{ project.id }}/plan/{{ feature.name }}\" class=\"px-2.5 py-1 rounded bg-blue-900/50 hover:bg-blue-900/70 text-blue-300 border border-blue-800\">Implementation Plan</a>\n    78→                    {% if feature.has_arch_manifest %}\n    79→                    <a href=\"/project/{{ project.id }}/arch/{{ feature.name }}\" class=\"px-2.5 py-1 rounded bg-green-900/40 hover:bg-green-900/60 text-green-300 border border-green-800\">Architecture</a>\n    80→                    {% endif %}\n    81→                </div>\n    82→            </div>\n    83→            {% endfor %}\n    84→        </div>\n    85→        {% else %}\n    86→        <div class=\"px-4 py-8 text-gray-500 text-sm\">No features found in .vista/features/</div>\n    87→        {% endif %}\n    88→    </div>\n    89→</section>\n    90→\n    91→<section id=\"tab-loops\" class=\"hidden\">\n    92→    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n    93→        <div class=\"lg:col-span-1\">\n    94→            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mb-6\">\n    95→                <h2 class=\"text-lg font-semibold mb-4\">Loop Control</h2>\n    96→\n    97→                {% if loop_state.status in [\"running\", \"starting\"] %}\n    98→                <div class=\"space-y-3 mb-4\">\n    99→                    <div class=\"flex justify-between text-sm\">\n   100→                        <span class=\"text-gray-400\">Status</span>\n   101→                        <span class=\"text-green-400 font-medium\">{{ loop_state.status }}</span>\n   102→                    </div>\n   103→                    <div class=\"flex justify-between text-sm\">\n   104→                        <span class=\"text-gray-400\">Feature</span>\n   105→                        <span>{{ loop_state.feature_name }}</span>\n   106→                    </div>\n   107→                    <div class=\"flex justify-between text-sm\">\n   108→                        <span class=\"text-gray-400\">Provider</span>\n   109→                        <span>{{ loop_state.provider_display_name or loop_state.provider or 'Claude Code' }}</span>\n   110→                    </div>\n   111→                    <div class=\"flex justify-between text-sm\">\n   112→                        <span class=\"text-gray-400\">Mode</span>\n   113→                        <span>{{ loop_state.mode }}</span>\n   114→                    </div>\n   115→                    <div class=\"flex justify-between text-sm\">\n   116→                        <span class=\"text-gray-400\">Model</span>\n   117→                        <span>{{ loop_state.model }}</span>\n   118→                    </div>\n   119→                    <div class=\"flex justify-between text-sm\">\n   120→                        <span class=\"text-gray-400\">Iteration</span>\n   121→                        <span id=\"iteration-display\" class=\"text-green-400 font-mono\">{{ loop_state.iteration }}</span>\n   122→                    </div>\n   123→                </div>\n   124→\n   125→                <button onclick=\"stopLoop()\" class=\"w-full py-2 bg-red-800 hover:bg-red-700 rounded font-medium transition-colors\">\n   126→                    Stop Loop\n   127→                </button>\n   128→\n   129→                {% else %}\n   130→                <form id=\"start-loop-form\" class=\"space-y-4\">\n   131→                    <div>\n   132→                        <label class=\"block text-sm text-gray-400 mb-1\">Feature</label>\n   133→                        <select id=\"feature-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\">\n   134→                            {% for feature in features %}\n   135→                            <option value=\"{{ feature.name }}\">{{ feature.name }}</option>\n   136→                            {% endfor %}\n   137→                            {% if not features %}\n   138→                            <option value=\"\" disabled>No features found</option>\n   139→                            {% endif %}\n   140→                        </select>\n   141→                    </div>\n   142→\n   143→                    {% if providers|length > 1 %}\n   144→                    <div>\n   145→                        <label class=\"block text-sm text-gray-400 mb-1\">Provider</label>\n   146→                        <select id=\"provider-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\" onchange=\"onProviderChange()\">\n   147→                            {% for p in providers %}\n   148→                            <option value=\"{{ p.name }}\">{{ p.display_name }}</option>\n   149→                            {% endfor %}\n   150→                        </select>\n   151→                    </div>\n   152→                    {% else %}\n   153→                    <input type=\"hidden\" id=\"provider-select\" value=\"{{ providers[0].name if providers else 'claude' }}\">\n   154→                    {% endif %}\n   155→\n   156→                    <div>\n   157→                        <label class=\"block text-sm text-gray-400 mb-1\">Mode</label>\n   158→                        <div class=\"flex gap-2\">\n   159→                            <label class=\"flex-1 cursor-pointer\">\n   160→                                <input type=\"radio\" name=\"mode\" value=\"build\" checked class=\"hidden peer\">\n   161→                                <span class=\"block text-center py-2 rounded border border-gray-600 peer-checked:border-green-500 peer-checked:bg-green-900/30 peer-checked:text-green-400 transition-colors\">Build</span>\n   162→                            </label>\n   163→                            <label class=\"flex-1 cursor-pointer\">\n   164→                                <input type=\"radio\" name=\"mode\" value=\"plan\" class=\"hidden peer\">\n   165→                                <span class=\"block text-center py-2 rounded border border-gray-600 peer-checked:border-blue-500 peer-checked:bg-blue-900/30 peer-checked:text-blue-400 transition-colors\">Plan</span>\n   166→                            </label>\n   167→                        </div>\n   168→                    </div>\n   169→\n   170→                    <div>\n   171→                        <label class=\"block text-sm text-gray-400 mb-1\">Model</label>\n   172→                        <select id=\"model-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\"></select>\n   173→                    </div>\n   174→\n   175→                    <div>\n   176→                        <label class=\"block text-sm text-gray-400 mb-1\">Max Iterations (0 = unlimited)</label>\n   177→                        <input type=\"number\" id=\"max-iterations\" value=\"0\" min=\"0\"\n   178→                               class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\">\n   179→                    </div>\n   180→\n   181→                    <button type=\"submit\" class=\"w-full py-2 bg-green-700 hover:bg-green-600 rounded font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-green-700\"\n   182→                            {% if not features %}disabled{% endif %}>\n   183→                        Start Loop\n   184→                    </button>\n   185→                </form>\n   186→                {% endif %}\n   187→\n   188→                <div id=\"loop-error\" class=\"hidden mt-3 text-red-400 text-sm\"></div>\n   189→            </div>\n   190→        </div>\n   191→\n   192→        <div class=\"lg:col-span-2\">\n   193→            <div class=\"bg-gray-800 rounded-lg border border-gray-700 overflow-hidden\">\n   194→                <div class=\"flex items-center justify-between px-4 py-2 bg-gray-750 border-b border-gray-700\">\n   195→                    <h2 class=\"text-sm font-semibold text-gray-300\">Terminal Output</h2>\n   196→                    <div class=\"flex items-center gap-2\">\n   197→                        <span id=\"status-badge\" class=\"text-xs text-gray-500\">{{ loop_state.status }}</span>\n   198→                        <button onclick=\"clearTerminal()\" class=\"text-xs text-gray-500 hover:text-gray-300\">Clear</button>\n   199→                    </div>\n   200→                </div>\n   201→                <div id=\"terminal\" class=\"terminal-output p-4 h-[600px] overflow-y-auto font-mono text-sm leading-relaxed\">\n   202→                    <div class=\"text-gray-500\">Waiting for loop output...</div>\n   203→                </div>\n   204→            </div>\n   205→        </div>\n   206→    </div>\n   207→</section>\n   208→{% endblock %}\n   209→\n   210→{% block scripts %}\n   211→<script>\n   212→const PROJECT_ID = '{{ project.id }}';\n   213→const LOOP_STATUS = '{{ loop_state.status }}';\n   214→\n   215→// Provider names from server (no models yet — those are fetched on-demand)\n   216→const PROVIDERS = {{ providers | tojson }};\n   217→\n   218→if (LOOP_STATUS === 'running' || LOOP_STATUS === 'starting') {\n   219→    connectSSE(PROJECT_ID);\n   220→}\n   221→\n   222→function showProjectTab(tab) {\n   223→    const overview = document.getElementById('tab-overview');\n   224→    const loops = document.getElementById('tab-loops');\n   225→    const overviewBtn = document.getElementById('tab-overview-btn');\n   226→    const loopsBtn = document.getElementById('tab-loops-btn');\n   227→\n   228→    if (tab === 'loops') {\n   229→        overview.classList.add('hidden');\n   230→        loops.classList.remove('hidden');\n   231→        overviewBtn.classList.replace('bg-gray-800', 'bg-gray-900');\n   232→        overviewBtn.classList.replace('text-gray-200', 'text-gray-400');\n   233→        loopsBtn.classList.replace('bg-gray-900', 'bg-gray-800');\n   234→        loopsBtn.classList.replace('text-gray-400', 'text-gray-200');\n   235→        window.location.hash = 'loops';\n   236→        return;\n   237→    }\n   238→\n   239→    loops.classList.add('hidden');\n   240→    overview.classList.remove('hidden');\n   241→    loopsBtn.classList.replace('bg-gray-800', 'bg-gray-900');\n   242→    loopsBtn.classList.replace('text-gray-200', 'text-gray-400');\n   243→    overviewBtn.classList.replace('bg-gray-900', 'bg-gray-800');\n   244→    overviewBtn.classList.replace('text-gray-400', 'text-gray-200');\n   245→    window.location.hash = 'overview';\n   246→}\n   247→\n   248→if (window.location.hash === '#loops') {\n   249→    showProjectTab('loops');\n   250→} else {\n   251→    showProjectTab('overview');\n   252→}\n   253→\n   254→// --- Dynamic model loading ---\n   255→\n   256→let _modelFetchId = 0;  // Guards against stale responses overwriting newer ones\n   257→\n   258→function renderModels(models) {\n   259→    const select = document.getElementById('model-select');\n   260→    if (!select) return;\n   261→    select.innerHTML = '';\n   262→    models.forEach((model) => {\n   263→        const opt = document.createElement('option');\n   264→        opt.value = model;\n   265→        opt.textContent = model;\n   266→        select.appendChild(opt);\n   267→    });\n   268→}\n   269→\n   270→function setStartEnabled(enabled) {\n   271→    const btn = document.querySelector('#start-loop-form button[type=\"submit\"]');\n   272→    if (btn) btn.disabled = !enabled;\n   273→}\n   274→\n   275→function setModelLoading() {\n   276→    const select = document.getElementById('model-select');\n   277→    if (!select) return;\n   278→    select.innerHTML = '<option disabled selected>Loading models...</option>';\n   279→    setStartEnabled(false);\n   280→}\n   281→\n   282→async function fetchModels(providerName) {\n   283→    const thisId = ++_modelFetchId;\n   284→    setModelLoading();\n   285→    try {\n   286→        const resp = await fetch(`/api/providers/${providerName}/models`);\n   287→        if (thisId !== _modelFetchId) return;  // Stale response, user switched provider\n   288→        if (!resp.ok) throw new Error('Failed to fetch models');\n   289→        const data = await resp.json();\n   290→        if (thisId !== _modelFetchId) return;\n   291→        if (data.error) {\n   292→            // Server returned models but with an error (e.g. timeout)\n   293→            const select = document.getElementById('model-select');\n   294→            if (select) select.innerHTML = '<option disabled selected>Timed out - click retry</option>';\n   295→            setStartEnabled(false);\n   296→            return;\n   297→        }\n   298→        renderModels(data.models);\n   299→        setStartEnabled(data.models.length > 0);\n   300→    } catch (err) {\n   301→        if (thisId !== _modelFetchId) return;\n   302→        const select = document.getElementById('model-select');\n   303→        if (select) select.innerHTML = '<option disabled selected>Failed to load - click retry</option>';\n   304→        setStartEnabled(false);\n   305→    }\n   306→}\n   307→\n   308→function getSelectedProvider() {\n   309→    const sel = document.getElementById('provider-select');\n   310→    return sel ? sel.value : 'claude';\n   311→}\n   312→\n   313→function onProviderChange() {\n   314→    fetchModels(getSelectedProvider());\n   315→}\n   316→\n   317→if (document.getElementById('start-loop-form') && PROVIDERS.length > 0) {\n   318→    fetchModels(PROVIDERS[0].name);\n   319→}\n   320→\n   321→// --- Form submission ---\n   322→\n   323→document.getElementById('start-loop-form')?.addEventListener('submit', async function(e) {\n   324→    e.preventDefault();\n   325→    const errorEl = document.getElementById('loop-error');\n   326→    errorEl.classList.add('hidden');\n   327→\n   328→    const body = {\n   329→        feature_name: document.getElementById('feature-select').value,\n   330→        mode: document.querySelector('input[name=\"mode\"]:checked').value,\n   331→        model: document.getElementById('model-select').value,\n   332→        provider: getSelectedProvider(),\n   333→        max_iterations: parseInt(document.getElementById('max-iterations').value) || 0,\n   334→    };\n   335→\n   336→    try {\n   337→        const resp = await fetch(`/api/projects/${PROJECT_ID}/loop/start`, {\n   338→            method: 'POST',\n   339→            headers: {'Content-Type': 'application/json'},\n   340→            body: JSON.stringify(body)\n   341→        });\n   342→        if (!resp.ok) {\n   343→            const data = await resp.json();\n   344→            throw new Error(data.detail || 'Failed to start loop');\n   345→        }\n   346→        window.location.reload();\n   347→    } catch(err) {\n   348→        errorEl.textContent = err.message;\n   349→        errorEl.classList.remove('hidden');\n   350→    }\n   351→});\n   352→\n   353→async function stopLoop() {\n   354→    // Close SSE first to prevent reconnection attempts during stop\n   355→    if (currentEventSource) {\n   356→        currentEventSource.close();\n   357→        currentEventSource = null;\n   358→    }\n   359→    await fetch(`/api/projects/${PROJECT_ID}/loop/stop`, {method: 'POST'});\n   360→    window.location.reload();\n   361→}\n   362→\n   363→async function removeProject(projectId, projectName, loopStatus) {\n   364→    if (loopStatus === 'running' || loopStatus === 'starting') {\n   365→        if (!confirm(`\"${projectName}\" has a running loop. Stop loop and remove from project list?\\n\\nFiles on disk will NOT be deleted.`)) return;\n   366→        await stopLoop();\n   367→        return;\n   368→    }\n   369→\n   370→    if (!confirm(`Remove \"${projectName}\" from project list?\\n\\nFiles on disk will NOT be deleted.`)) return;\n   371→    const resp = await fetch(`/api/projects/${projectId}`, {method: 'DELETE'});\n   372→    if (!resp.ok) {\n   373→        const data = await resp.json().catch(() => ({}));\n   374→        alert(data.detail || 'Failed to remove project');\n   375→        return;\n   376→    }\n   377→    window.location.href = '/';\n   378→}\n   379→</script>\n   380→{% endblock %}\n   381→"}]},"parent_tool_use_id":null,"session_id":"1992a3fe-50d4-4b84-929b-67d8dd2b0f2b","uuid":"3916214a-956f-4767-b565-257c0d9c0b05","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/views/project.html","content":"{% extends \"_base.html\" %}\n\n{% block title %}{{ project.name }} - Ralph Loop{% endblock %}\n\n{% block content %}\n<div class=\"mb-8\">\n    <div class=\"flex flex-wrap items-center gap-3 mb-2\">\n        <a href=\"/\" class=\"text-gray-400 hover:text-gray-300\">&larr; Dashboard</a>\n        <span class=\"text-gray-600\">/</span>\n        <h1 class=\"text-3xl font-bold\">{{ project.name }}</h1>\n        <button onclick=\"removeProject('{{ project.id }}', '{{ project.name }}', '{{ loop_state.status }}')\"\n                class=\"ml-auto px-3 py-1.5 rounded border border-gray-600 text-gray-300 hover:border-red-600 hover:text-red-300 text-sm transition-colors\">\n            Remove Project\n        </button>\n    </div>\n    <p class=\"text-gray-400 text-sm\">{{ project.path }}</p>\n</div>\n\n<div class=\"mb-6 border-b border-gray-700\">\n    <div class=\"flex items-center gap-2\" role=\"tablist\">\n        <button id=\"tab-overview-btn\" onclick=\"showProjectTab('overview')\"\n                class=\"project-tab-btn px-4 py-2 text-sm rounded-t-md border border-b-0 border-gray-700 bg-gray-800 text-gray-200\">\n            Overview\n        </button>\n        <button id=\"tab-loops-btn\" onclick=\"showProjectTab('loops')\"\n                class=\"project-tab-btn px-4 py-2 text-sm rounded-t-md border border-b-0 border-gray-700 bg-gray-900 text-gray-400 hover:text-gray-200\">\n            Ralph Loops\n        </button>\n    </div>\n</div>\n\n<section id=\"tab-overview\" class=\"space-y-6\">\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n            <p class=\"text-xs text-gray-400 mb-1\">Features</p>\n            <p class=\"text-2xl font-semibold\">{{ features|length }}</p>\n        </div>\n        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n            <p class=\"text-xs text-gray-400 mb-1\">Loop Status</p>\n            <p class=\"text-2xl font-semibold capitalize\">{{ loop_state.status }}</p>\n        </div>\n        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n            <p class=\"text-xs text-gray-400 mb-1\">Docs Readiness</p>\n            <p class=\"text-2xl font-semibold\">{{ features | selectattr('has_implementation_plan') | list | length }}/{{ features|length }}</p>\n        </div>\n    </div>\n\n    <div class=\"bg-gray-800 rounded-lg border border-gray-700 overflow-hidden\">\n        <div class=\"px-4 py-3 border-b border-gray-700\">\n            <h2 class=\"text-base font-semibold\">Feature Documentation</h2>\n            <p class=\"text-xs text-gray-400 mt-1\">Overview of specs, plans, prompts, and architecture docs</p>\n        </div>\n\n        {% if features %}\n        <div class=\"divide-y divide-gray-700\">\n            {% for feature in features %}\n            <div class=\"px-4 py-3 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3\">\n                <div>\n                    <p class=\"font-medium text-gray-100\">{{ feature.name }}</p>\n                    <div class=\"flex flex-wrap items-center gap-2 mt-1 text-xs\">\n                        <span class=\"px-2 py-0.5 rounded border border-gray-600 text-gray-300\">Specs: {{ feature.spec_count }}</span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_implementation_plan %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            Impl Plan {% if feature.has_implementation_plan %}✓{% else %}—{% endif %}\n                        </span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_agents_md %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            AGENTS.md {% if feature.has_agents_md %}✓{% else %}—{% endif %}\n                        </span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_prompt_build or feature.has_prompt_plan %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            PROMPTs {% if feature.has_prompt_build or feature.has_prompt_plan %}✓{% else %}—{% endif %}\n                        </span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_arch_manifest %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            Arch {% if feature.has_arch_manifest %}{{ feature.arch_diagram_count }}{% else %}—{% endif %}\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2 text-xs\">\n                    <a href=\"/project/{{ project.id }}/plan/{{ feature.name }}\" class=\"px-2.5 py-1 rounded bg-blue-900/50 hover:bg-blue-900/70 text-blue-300 border border-blue-800\">Implementation Plan</a>\n                    {% if feature.has_arch_manifest %}\n                    <a href=\"/project/{{ project.id }}/arch/{{ feature.name }}\" class=\"px-2.5 py-1 rounded bg-green-900/40 hover:bg-green-900/60 text-green-300 border border-green-800\">Architecture</a>\n                    {% endif %}\n                </div>\n            </div>\n            {% endfor %}\n        </div>\n        {% else %}\n        <div class=\"px-4 py-8 text-gray-500 text-sm\">No features found in .vista/features/</div>\n        {% endif %}\n    </div>\n</section>\n\n<section id=\"tab-loops\" class=\"hidden\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div class=\"lg:col-span-1\">\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mb-6\">\n                <h2 class=\"text-lg font-semibold mb-4\">Loop Control</h2>\n\n                {% if loop_state.status in [\"running\", \"starting\"] %}\n                <div class=\"space-y-3 mb-4\">\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Status</span>\n                        <span class=\"text-green-400 font-medium\">{{ loop_state.status }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Feature</span>\n                        <span>{{ loop_state.feature_name }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Provider</span>\n                        <span>{{ loop_state.provider_display_name or loop_state.provider or 'Claude Code' }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Mode</span>\n                        <span>{{ loop_state.mode }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Model</span>\n                        <span>{{ loop_state.model }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Iteration</span>\n                        <span id=\"iteration-display\" class=\"text-green-400 font-mono\">{{ loop_state.iteration }}</span>\n                    </div>\n                </div>\n\n                <button onclick=\"stopLoop()\" class=\"w-full py-2 bg-red-800 hover:bg-red-700 rounded font-medium transition-colors\">\n                    Stop Loop\n                </button>\n\n                {% else %}\n                <form id=\"start-loop-form\" class=\"space-y-4\">\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Feature</label>\n                        <select id=\"feature-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\">\n                            {% for feature in features %}\n                            <option value=\"{{ feature.name }}\">{{ feature.name }}</option>\n                            {% endfor %}\n                            {% if not features %}\n                            <option value=\"\" disabled>No features found</option>\n                            {% endif %}\n                        </select>\n                    </div>\n\n                    {% if providers|length > 1 %}\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Provider</label>\n                        <select id=\"provider-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\" onchange=\"onProviderChange()\">\n                            {% for p in providers %}\n                            <option value=\"{{ p.name }}\">{{ p.display_name }}</option>\n                            {% endfor %}\n                        </select>\n                    </div>\n                    {% else %}\n                    <input type=\"hidden\" id=\"provider-select\" value=\"{{ providers[0].name if providers else 'claude' }}\">\n                    {% endif %}\n\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Mode</label>\n                        <div class=\"flex gap-2\">\n                            <label class=\"flex-1 cursor-pointer\">\n                                <input type=\"radio\" name=\"mode\" value=\"build\" checked class=\"hidden peer\">\n                                <span class=\"block text-center py-2 rounded border border-gray-600 peer-checked:border-green-500 peer-checked:bg-green-900/30 peer-checked:text-green-400 transition-colors\">Build</span>\n                            </label>\n                            <label class=\"flex-1 cursor-pointer\">\n                                <input type=\"radio\" name=\"mode\" value=\"plan\" class=\"hidden peer\">\n                                <span class=\"block text-center py-2 rounded border border-gray-600 peer-checked:border-blue-500 peer-checked:bg-blue-900/30 peer-checked:text-blue-400 transition-colors\">Plan</span>\n                            </label>\n                        </div>\n                    </div>\n\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Model</label>\n                        <select id=\"model-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\"></select>\n                    </div>\n\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Max Iterations (0 = unlimited)</label>\n                        <input type=\"number\" id=\"max-iterations\" value=\"0\" min=\"0\"\n                               class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\">\n                    </div>\n\n                    <button type=\"submit\" class=\"w-full py-2 bg-green-700 hover:bg-green-600 rounded font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-green-700\"\n                            {% if not features %}disabled{% endif %}>\n                        Start Loop\n                    </button>\n                </form>\n                {% endif %}\n\n                <div id=\"loop-error\" class=\"hidden mt-3 text-red-400 text-sm\"></div>\n            </div>\n        </div>\n\n        <div class=\"lg:col-span-2\">\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 overflow-hidden\">\n                <div class=\"flex items-center justify-between px-4 py-2 bg-gray-750 border-b border-gray-700\">\n                    <h2 class=\"text-sm font-semibold text-gray-300\">Terminal Output</h2>\n                    <div class=\"flex items-center gap-2\">\n                        <span id=\"status-badge\" class=\"text-xs text-gray-500\">{{ loop_state.status }}</span>\n                        <button onclick=\"clearTerminal()\" class=\"text-xs text-gray-500 hover:text-gray-300\">Clear</button>\n                    </div>\n                </div>\n                <div id=\"terminal\" class=\"terminal-output p-4 h-[600px] overflow-y-auto font-mono text-sm leading-relaxed\">\n                    <div class=\"text-gray-500\">Waiting for loop output...</div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n{% endblock %}\n\n{% block scripts %}\n<script>\nconst PROJECT_ID = '{{ project.id }}';\nconst LOOP_STATUS = '{{ loop_state.status }}';\n\n// Provider names from server (no models yet — those are fetched on-demand)\nconst PROVIDERS = {{ providers | tojson }};\n\nif (LOOP_STATUS === 'running' || LOOP_STATUS === 'starting') {\n    connectSSE(PROJECT_ID);\n}\n\nfunction showProjectTab(tab) {\n    const overview = document.getElementById('tab-overview');\n    const loops = document.getElementById('tab-loops');\n    const overviewBtn = document.getElementById('tab-overview-btn');\n    const loopsBtn = document.getElementById('tab-loops-btn');\n\n    if (tab === 'loops') {\n        overview.classList.add('hidden');\n        loops.classList.remove('hidden');\n        overviewBtn.classList.replace('bg-gray-800', 'bg-gray-900');\n        overviewBtn.classList.replace('text-gray-200', 'text-gray-400');\n        loopsBtn.classList.replace('bg-gray-900', 'bg-gray-800');\n        loopsBtn.classList.replace('text-gray-400', 'text-gray-200');\n        window.location.hash = 'loops';\n        return;\n    }\n\n    loops.classList.add('hidden');\n    overview.classList.remove('hidden');\n    loopsBtn.classList.replace('bg-gray-800', 'bg-gray-900');\n    loopsBtn.classList.replace('text-gray-200', 'text-gray-400');\n    overviewBtn.classList.replace('bg-gray-900', 'bg-gray-800');\n    overviewBtn.classList.replace('text-gray-400', 'text-gray-200');\n    window.location.hash = 'overview';\n}\n\nif (window.location.hash === '#loops') {\n    showProjectTab('loops');\n} else {\n    showProjectTab('overview');\n}\n\n// --- Dynamic model loading ---\n\nlet _modelFetchId = 0;  // Guards against stale responses overwriting newer ones\n\nfunction renderModels(models) {\n    const select = document.getElementById('model-select');\n    if (!select) return;\n    select.innerHTML = '';\n    models.forEach((model) => {\n        const opt = document.createElement('option');\n        opt.value = model;\n        opt.textContent = model;\n        select.appendChild(opt);\n    });\n}\n\nfunction setStartEnabled(enabled) {\n    const btn = document.querySelector('#start-loop-form button[type=\"submit\"]');\n    if (btn) btn.disabled = !enabled;\n}\n\nfunction setModelLoading() {\n    const select = document.getElementById('model-select');\n    if (!select) return;\n    select.innerHTML = '<option disabled selected>Loading models...</option>';\n    setStartEnabled(false);\n}\n\nasync function fetchModels(providerName) {\n    const thisId = ++_modelFetchId;\n    setModelLoading();\n    try {\n        const resp = await fetch(`/api/providers/${providerName}/models`);\n        if (thisId !== _modelFetchId) return;  // Stale response, user switched provider\n        if (!resp.ok) throw new Error('Failed to fetch models');\n        const data = await resp.json();\n        if (thisId !== _modelFetchId) return;\n        if (data.error) {\n            // Server returned models but with an error (e.g. timeout)\n            const select = document.getElementById('model-select');\n            if (select) select.innerHTML = '<option disabled selected>Timed out - click retry</option>';\n            setStartEnabled(false);\n            return;\n        }\n        renderModels(data.models);\n        setStartEnabled(data.models.length > 0);\n    } catch (err) {\n        if (thisId !== _modelFetchId) return;\n        const select = document.getElementById('model-select');\n        if (select) select.innerHTML = '<option disabled selected>Failed to load - click retry</option>';\n        setStartEnabled(false);\n    }\n}\n\nfunction getSelectedProvider() {\n    const sel = document.getElementById('provider-select');\n    return sel ? sel.value : 'claude';\n}\n\nfunction onProviderChange() {\n    fetchModels(getSelectedProvider());\n}\n\nif (document.getElementById('start-loop-form') && PROVIDERS.length > 0) {\n    fetchModels(PROVIDERS[0].name);\n}\n\n// --- Form submission ---\n\ndocument.getElementById('start-loop-form')?.addEventListener('submit', async function(e) {\n    e.preventDefault();\n    const errorEl = document.getElementById('loop-error');\n    errorEl.classList.add('hidden');\n\n    const body = {\n        feature_name: document.getElementById('feature-select').value,\n        mode: document.querySelector('input[name=\"mode\"]:checked').value,\n        model: document.getElementById('model-select').value,\n        provider: getSelectedProvider(),\n        max_iterations: parseInt(document.getElementById('max-iterations').value) || 0,\n    };\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/loop/start`, {\n            method: 'POST',\n            headers: {'Content-Type': 'application/json'},\n            body: JSON.stringify(body)\n        });\n        if (!resp.ok) {\n            const data = await resp.json();\n            throw new Error(data.detail || 'Failed to start loop');\n        }\n        window.location.reload();\n    } catch(err) {\n        errorEl.textContent = err.message;\n        errorEl.classList.remove('hidden');\n    }\n});\n\nasync function stopLoop() {\n    // Close SSE first to prevent reconnection attempts during stop\n    if (currentEventSource) {\n        currentEventSource.close();\n        currentEventSource = null;\n    }\n    await fetch(`/api/projects/${PROJECT_ID}/loop/stop`, {method: 'POST'});\n    window.location.reload();\n}\n\nasync function removeProject(projectId, projectName, loopStatus) {\n    if (loopStatus === 'running' || loopStatus === 'starting') {\n        if (!confirm(`\"${projectName}\" has a running loop. Stop loop and remove from project list?\\n\\nFiles on disk will NOT be deleted.`)) return;\n        await stopLoop();\n        return;\n    }\n\n    if (!confirm(`Remove \"${projectName}\" from project list?\\n\\nFiles on disk will NOT be deleted.`)) return;\n    const resp = await fetch(`/api/projects/${projectId}`, {method: 'DELETE'});\n    if (!resp.ok) {\n        const data = await resp.json().catch(() => ({}));\n        alert(data.detail || 'Failed to remove project');\n        return;\n    }\n    window.location.href = '/';\n}\n</script>\n{% endblock %}\n","numLines":381,"startLine":1,"totalLines":381}}}
