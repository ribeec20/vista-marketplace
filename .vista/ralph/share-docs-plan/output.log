"arch\\\\\\\" / \\\\\\\"_arch.json\\\\\\\"\\\\n        if not arch_file.exists():\\\\n            return None\\\\n        try:\\\\n            data = json.loads(arch_file.read_text(encoding=\\\\\\\"utf-8\\\\\\\"))\\\\n            # Normalize legacy format: bare list -> dict with \\\\\\\"diagrams\\\\\\\" key\\\\n            if isinstance(data, list):\\\\n                data = {\\\\\\\"feature\\\\\\\": feature_name, \\\\\\\"diagrams\\\\\\\": data}\\\\n            return data\\\\n        except (json.JSONDecodeError, OSError):\\\\n            return None\\\", \\\"relative_path\\\": \\\"vista\\\\\\\\server\\\\\\\\services\\\\\\\\progress_service.py\\\"}]\"}","structuredContent":{"result":"[{\"name_path\": \"ProgressService/read_arch_manifest\", \"kind\": \"Method\", \"body_location\": {\"start_line\": 49, \"end_line\": 62}, \"body\": \"@staticmethod\\n    def read_arch_manifest(project_path: str, feature_name: str) -> Optional[dict]:\\n        \\\"\\\"\\\"Read arch/_arch.json manifest for a feature.\\\"\\\"\\\"\\n        arch_file = Path(project_path) / \\\".vista\\\" / \\\"features\\\" / feature_name / \\\"arch\\\" / \\\"_arch.json\\\"\\n        if not arch_file.exists():\\n            return None\\n        try:\\n            data = json.loads(arch_file.read_text(encoding=\\\"utf-8\\\"))\\n            # Normalize legacy format: bare list -> dict with \\\"diagrams\\\" key\\n            if isinstance(data, list):\\n                data = {\\\"feature\\\": feature_name, \\\"diagrams\\\": data}\\n            return data\\n        except (json.JSONDecodeError, OSError):\\n            return None\", \"relative_path\": \"vista\\\\server\\\\services\\\\progress_service.py\"}]"}}}
