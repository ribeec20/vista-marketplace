height: 500px;\n    53→    }\n    54→    .diagram-viewport {\n    55→        width: 100%;\n    56→        height: 100%;\n    57→        cursor: grab;\n    58→        transform-origin: 0 0;\n    59→        padding: 16px;\n    60→    }\n    61→    .diagram-viewport:active {\n    62→        cursor: grabbing;\n    63→    }\n    64→    .diagram-viewport .mermaid svg {\n    65→        max-width: none;\n    66→    }\n    67→    /* Make mermaid lines and text more visible */\n    68→    .diagram-viewport .mermaid svg .flowchart-link,\n    69→    .diagram-viewport .mermaid svg .edge-pattern-dotted,\n    70→    .diagram-viewport .mermaid svg path.path,\n    71→    .diagram-viewport .mermaid svg path[class*=\"edge\"],\n    72→    .diagram-viewport .mermaid svg line {\n    73→        stroke-width: 2.5px !important;\n    74→    }\n    75→    .diagram-viewport .mermaid svg .edgeLabel,\n    76→    .diagram-viewport .mermaid svg .nodeLabel,\n    77→    .diagram-viewport .mermaid svg .label {\n    78→        font-size: 14px !important;\n    79→    }\n    80→    .diagram-viewport .mermaid svg .edgeLabel {\n    81→        font-size: 12px !important;\n    82→    }\n    83→    .diagram-viewport .mermaid svg marker path {\n    84→        stroke-width: 1.5px !important;\n    85→    }\n    86→    .diagram-zoom-controls {\n    87→        position: absolute;\n    88→        bottom: 8px;\n    89→        right: 8px;\n    90→        display: flex;\n    91→        gap: 4px;\n    92→        z-index: 5;\n    93→    }\n    94→    .diagram-zoom-controls button {\n    95→        width: 28px;\n    96→        height: 28px;\n    97→        border-radius: 4px;\n    98→        background: #334155;\n    99→        color: #e2e8f0;\n   100→        border: 1px solid #475569;\n   101→        cursor: pointer;\n   102→        font-size: 0.875rem;\n   103→        display: flex;\n   104→        align-items: center;\n   105→        justify-content: center;\n   106→        opacity: 0.7;\n   107→        transition: opacity 0.2s;\n   108→    }\n   109→    .diagram-zoom-controls button:hover {\n   110→        opacity: 1;\n   111→        background: #475569;\n   112→    }\n   113→    .attach-indicator {\n   114→        font-size: 0.7rem;\n   115→        padding: 2px 8px;\n   116→        border-radius: 4px;\n   117→        font-weight: 500;\n   118→        transition: all 0.15s;\n   119→        white-space: nowrap;\n   120→    }\n   121→    .attach-indicator.off {\n   122→        background: #334155;\n   123→        color: #94a3b8;\n   124→    }\n   125→    .attach-indicator.on {\n   126→        background: #1e3a5f;\n   127→        color: #60a5fa;\n   128→    }\n   129→    .badge {\n   130→        font-size: 0.65rem;\n   131→        padding: 2px 8px;\n   132→        border-radius: 10px;\n   133→        font-weight: 600;\n   134→        text-transform: uppercase;\n   135→        letter-spacing: 0.05em;\n   136→    }\n   137→    .badge-arch {\n   138→        background: #1e3a5f;\n   139→        color: #60a5fa;\n   140→    }\n   141→    .badge-tdd {\n   142→        background: #422006;\n   143→        color: #fbbf24;\n   144→    }\n   145→    /* Floating Notion-style Chat Panel */\n   146→    .chat-panel {\n   147→        position: fixed;\n   148→        bottom: 24px;\n   149→        right: 24px;\n   150→        top: auto;\n   151→        width: 480px;\n   152→        min-width: 380px;\n   153→        height: 60vh;\n   154→        min-height: 400px;\n   155→        max-width: calc(100vw - 48px);\n   156→        max-height: calc(100vh - 100px);\n   157→        background: #1a1a1a;\n   158→        border: 1px solid #2d2d2d;\n   159→        border-radius: 16px;\n   160→        box-shadow: 0 12px 48px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.05);\n   161→        z-index: 50;\n   162→        display: none;\n   163→        flex-direction: column;\n   164→        overflow: hidden;\n   165→        resize: both;\n   166→    }\n   167→    .chat-panel.open {\n   168→        display: flex;\n