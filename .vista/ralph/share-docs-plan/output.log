list of diagrams or dict with \\\\\\\"diagrams\\\\\\\" key\\\\n        if isinstance(data, list):\\\\n            return len(data) > 0\\\\n        return bool(data.get(\\\\\\\"diagrams\\\\\\\"))\\\\n    except (json.JSONDecodeError, OSError):\\\\n        return False\\\", \\\"relative_path\\\": \\\"vista\\\\\\\\server\\\\\\\\services\\\\\\\\project_service.py\\\"}]\"}","structuredContent":{"result":"[{\"name_path\": \"_has_arch_manifest\", \"kind\": \"Function\", \"body_location\": {\"start_line\": 9, \"end_line\": 23}, \"body\": \"def _has_arch_manifest(feature_dir: Path) -> bool:\\n    \\\"\\\"\\\"Check if feature has an arch/_arch.json manifest.\\\"\\\"\\\"\\n    arch_file = feature_dir / \\\"arch\\\" / \\\"_arch.json\\\"\\n    if not arch_file.exists():\\n        return False\\n    try:\\n        data = json.loads(arch_file.read_text(encoding=\\\"utf-8\\\"))\\n        if not data:\\n            return False\\n        # Support both formats: list of diagrams or dict with \\\"diagrams\\\" key\\n        if isinstance(data, list):\\n            return len(data) > 0\\n        return bool(data.get(\\\"diagrams\\\"))\\n    except (json.JSONDecodeError, OSError):\\n        return False\", \"relative_path\": \"vista\\\\server\\\\services\\\\project_service.py\"}]"}}}
