: flex;\n   359→        align-items: center;\n   360→        gap: 6px;\n   361→        padding: 6px 12px;\n   362→        background: #2563eb;\n   363→        border: none;\n   364→        border-radius: 6px;\n   365→        color: white;\n   366→        font-size: 0.8125rem;\n   367→        cursor: pointer;\n   368→    }\n   369→    .session-new-btn:hover {\n   370→        background: #3b82f6;\n   371→    }\n   372→    .session-list {\n   373→        max-height: 200px;\n   374→        overflow-y: auto;\n   375→        padding: 4px;\n   376→    }\n   377→    .session-item {\n   378→        display: flex;\n   379→        align-items: center;\n   380→        justify-content: space-between;\n   381→        padding: 10px 12px;\n   382→        border-radius: 8px;\n   383→        cursor: pointer;\n   384→    }\n   385→    .session-item:hover {\n   386→        background: #2a2a2a;\n   387→    }\n   388→    .session-item.active {\n   389→        background: rgba(99, 102, 241, 0.1);\n   390→    }\n   391→    .session-item-info {\n   392→        display: flex;\n   393→        flex-direction: column;\n   394→        gap: 2px;\n   395→    }\n   396→    .session-item-name {\n   397→        font-size: 0.875rem;\n   398→        color: #d4d4d4;\n   399→        font-weight: 500;\n   400→    }\n   401→    .session-item-meta {\n   402→        font-size: 0.75rem;\n   403→        color: #737373;\n   404→    }\n   405→    .session-item-delete {\n   406→        width: 28px;\n   407→        height: 28px;\n   408→        border-radius: 6px;\n   409→        background: transparent;\n   410→        border: none;\n   411→        color: #737373;\n   412→        cursor: pointer;\n   413→        display: flex;\n   414→        align-items: center;\n   415→        justify-content: center;\n   416→        opacity: 0;\n   417→    }\n   418→    .session-item:hover .session-item-delete {\n   419→        opacity: 1;\n   420→    }\n   421→    .session-item-delete:hover {\n   422→        background: rgba(