"flex items-center gap-8 min-w-0\">\n                <a href=\"/\" class=\"text-xl font-semibold text-green-400 hover:text-green-300 whitespace-nowrap\">\n                    Vista Dashboard\n                </a>\n                <div class=\"flex items-center gap-5 text-sm\">\n                    <a href=\"/ralph/jobs\" class=\"text-gray-300 hover:text-white transition-colors\">Ralph Jobs</a>\n                    <a href=\"/ralph/settings\" class=\"text-gray-400 hover:text-gray-200 transition-colors\">Settings</a>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 relative\">\n                <button id=\"running-loops-toggle\"\n                        type=\"button\"\n                        class=\"hidden items-center gap-2 px-3 py-1.5 rounded-md border border-green-700/70 bg-green-900/30 hover:bg-green-900/50 text-sm text-green-300 transition-colors\"\n                        onclick=\"toggleRunningLoopsPopover()\">\n                    <span class=\"inline-block w-2 h-2 rounded-full bg-green-400 animate-pulse\"></span>\n                    <span id=\"running-loops-label\">0 loops</span>\n                </button>\n                <div id=\"running-loops-popover\"\n                     class=\"hidden absolute right-0 top-11 w-[30rem] max-w-[85vw] bg-gray-800 border border-gray-700 rounded-lg shadow-xl p-3\">\n                    <div class=\"flex items-center justify-between mb-2 px-1\">\n                        <h3 class=\"text-sm font-semibold text-gray-200\">Running Ralph Loops</h3>\n                        <button type=\"button\" class=\"text-xs text-gray-400 hover:text-gray-200\" onclick=\"refreshRunningLoops(true)\">Refresh</button>\n                    </div>\n                    <div id=\"running-loops-list\" class=\"space-y-2 max-h-[26rem] overflow-y-auto\">\n                        <div class=\"text-sm text-gray-500 px-1 py-2\">No active loops.</div>\n                    </div>\n                </div>","numLin