{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QYJ5BnhBQ75boSY4QRkrj9","type":"tool_result","content":"     1→\"\"\"Provider API endpoints.\"\"\"\n     2→import asyncio\n     3→\n     4→from fastapi import APIRouter, HTTPException\n     5→\n     6→from server.services.provider_service import get_enabled_providers, get_provider_by_name\n     7→\n     8→router = APIRouter(prefix=\"/api\", tags=[\"providers\"])\n     9→\n    10→\n    11→@router.get(\"/providers\")\n    12→async def list_providers():\n    13→    \"\"\"Return enabled providers (without models — use /models endpoint for those).\"\"\"\n    14→    providers = get_enabled_providers()\n    15→    return {\n    16→        \"providers\": [p.to_summary_dict() for p in providers],\n    17→    }\n    18→\n    19→\n    20→@router.get(\"/providers/{name}/models\")\n    21→async def get_provider_models(name: str):\n    22→    \"\"\"Discover models for a provider on-demand.\n    23→\n    24→    For OpenCode this runs `opencode models` CLI live.\n    25→    For Claude this returns the hardcoded list instantly.\n    26→    Runs in a thread to avoid blocking the event loop.\n    27→    \"\"\"\n    28→    provider = get_provider_by_name(name)\n    29→    if not provider:\n    30→        raise HTTPException(status_code=404, detail=f\"Provider '{name}' not found or not enabled\")\n    31→    try:\n    32→        models = await asyncio.wait_for(\n    33→            asyncio.to_thread(provider.get_models),\n    34→            timeout=20.0,\n    35→        )\n    36→    except asyncio.TimeoutError:\n    37→        return {\"provider\": name, \"models\": [], \"error\": \"Model loading timed out\"}\n    38→    return {\n    39→        \"provider\": name,\n    40→        \"models\": models,\n    41→    }\n    42→"}]},"parent_tool_use_id":"toolu_01SczPVD4G56yi1W94CTFVfY","session_id":"14b921d9-eeaf-453d-9533-337d6f497996","uuid":"07536dc1-9153-4e68-ad38-17473bb30764"}
