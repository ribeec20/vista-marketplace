{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VrhFZim59NqXukyYP3E4SH","type":"tool_result","content":"     1→\"\"\"Tests for ralph_service job management.\"\"\"\n     2→\n     3→import json\n     4→import signal\n     5→from pathlib import Path\n     6→from unittest.mock import MagicMock, patch\n     7→\n     8→import pytest\n     9→\n    10→\n    11→class DummyProvider:\n    12→    name = \"dummy\"\n    13→    display_name = \"Dummy Provider\"\n    14→\n    15→    def get_invocation(self, shell: str = \"ps1\") -> str:\n    16→        if shell == \"sh\":\n    17→            return 'echo \"ITERATION $ITERATION\" >> \"$PROGRESS_FILE\"'\n    18→        return 'Add-Content -Path $ProgressFile -Value \"ITERATION $Iteration\"'\n    19→\n    20→\n    21→def _write_job(job_dir: Path, job: dict) -> None:\n    22→    job_dir.mkdir(parents=True, exist_ok=True)\n    23→    (job_dir / \"job.json\").write_text(json.dumps(job), encoding=\"utf-8\")\n    24→\n    25→\n    26→class TestRalphServiceCreateJob:\n    27→    def test_create_job_creates_files(self, tmp_path):\n    28→        from server.services.ralph_service import RalphService\n    29→\n    30→        provider = DummyProvider()\n    31→        svc = RalphService()\n    32→\n    33→        templates_dir = tmp_path / \"templates\"\n    34→        templates_dir.mkdir()\n    35→        (templates_dir / \"PROMPT_plan_adhoc.md\").write_text(\n    36→            \"Plan {{FEATURE_NAME}} in {{PROJECT_NAME}} at {{FEATURE_DIR}}\",\n    37→            encoding=\"utf-8\",\n    38→        )\n    39→\n    40→        with (\n    41→            patch(\"server.services.ralph_service.config.TEMPLATES_DIR\", templates_dir),\n    42→            patch(\n    43→                \"server.services.ralph_service.platform.system\", return_value=\"Windows\"\n    44→            ),\n    45→            patch(\"server.services.ralph_service.subprocess.Popen\") as popen,\n    46→        ):\n    47→            proc = MagicMock()\n    48→            proc.pid = 1234\n    49→            popen.return_value = proc\n    50→\n    51→            job = svc.create_job(\n    52→                tmp_path,\n    53→                slug=\"alpha\",\n    54→                mode=\"plan\",\n    55→                task_description=\"Do the thing\",\n    56→                provider=provider,\n    57→                model=\"sonnet\",\n    58→                iterations=1,\n    59→            )\n    60→"}]},"parent_tool_use_id":null,"session_id":"6fe45d16-ab3a-4e41-9b98-035326f9b7c3","uuid":"44066a31-10dd-4b2c-9220-fa70b6d99525","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/tests/test_ralph_service.py","content":"\"\"\"Tests for ralph_service job management.\"\"\"\n\nimport json\nimport signal\nfrom pathlib import Path\nfrom unittest.mock import MagicMock, patch\n\nimport pytest\n\n\nclass DummyProvider:\n    name = \"dummy\"\n    display_name = \"Dummy Provider\"\n\n    def get_invocation(self, shell: str = \"ps1\") -> str:\n        if shell == \"sh\":\n            return 'echo \"ITERATION $ITERATION\" >> \"$PROGRESS_FILE\"'\n        return 'Add-Content -Path $ProgressFile -Value \"ITERATION $Iteration\"'\n\n\ndef _write_job(job_dir: Path, job: dict) -> None:\n    job_dir.mkdir(parents=True, exist_ok=True)\n    (job_dir / \"job.json\").write_text(json.dumps(job), encoding=\"utf-8\")\n\n\nclass TestRalphServiceCreateJob:\n    def test_create_job_creates_files(self, tmp_path):\n        from server.services.ralph_service import RalphService\n\n        provider = DummyProvider()\n        svc = RalphService()\n\n        templates_dir = tmp_path / \"templates\"\n        templates_dir.mkdir()\n        (templates_dir / \"PROMPT_plan_adhoc.md\").write_text(\n            \"Plan {{FEATURE_NAME}} in {{PROJECT_NAME}} at {{FEATURE_DIR}}\",\n            encoding=\"utf-8\",\n        )\n\n        with (\n            patch(\"server.services.ralph_service.config.TEMPLATES_DIR\", templates_dir),\n            patch(\n                \"server.services.ralph_service.platform.system\", return_value=\"Windows\"\n            ),\n            patch(\"server.services.ralph_service.subprocess.Popen\") as popen,\n        ):\n            proc = MagicMock()\n            proc.pid = 1234\n            popen.return_value = proc\n\n            job = svc.create_job(\n                tmp_path,\n                slug=\"alpha\",\n                mode=\"plan\",\n                task_description=\"Do the thing\",\n                provider=provider,\n                model=\"sonnet\",\n                iterations=1,\n            )\n","numLines":60,"startLine":1,"totalLines":761}}}
