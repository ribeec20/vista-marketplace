{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CNZrWShr5pLHpYcYrH2EhV","type":"tool_result","content":"     1→\"\"\"FastAPI web server entry point - Vista Dashboard.\"\"\"\n     2→\n     3→import json\n     4→from contextlib import asynccontextmanager\n     5→from pathlib import Path\n     6→\n     7→from fastapi import FastAPI, Request\n     8→from fastapi.staticfiles import StaticFiles\n     9→from fastapi.templating import Jinja2Templates\n    10→\n    11→from server import config\n    12→from server.services.project_service import ProjectService\n    13→from server.services.loop_service import loop_service\n    14→from server.services.diagram_watcher import diagram_watcher\n    15→from server.services.chat_service import chat_service\n    16→from server.services.keepalive_manager import keepalive_manager\n    17→from server.services.provider_service import get_enabled_providers\n    18→from server.services.output_parser import parse_stream_json_activity\n    19→from server.services.ralph_service import ralph_service\n    20→\n    21→\n    22→@asynccontextmanager\n    23→async def lifespan(app: FastAPI):\n    24→    \"\"\"Startup and shutdown lifecycle.\"\"\"\n    25→    config.ensure_full_path()\n    26→    config.DATA_DIR.mkdir(parents=True, exist_ok=True)\n    27→    (config.DATA_DIR / \"sessions\").mkdir(exist_ok=True)\n    28→    yield\n    29→    await loop_service.stop_all()\n    30→    await diagram_watcher.stop()\n    31→    keepalive_manager.stop_all()\n    32→\n    33→\n    34→app = FastAPI(title=\"Ralph Loop Dashboard\", version=\"1.3.6\", lifespan=lifespan)\n    35→\n    36→# Mount static files\n    37→config.STATIC_DIR.mkdir(parents=True, exist_ok=True)\n    38→app.mount(\"/static\", StaticFiles(directory=str(config.STATIC_DIR)), name=\"static\")\n    39→\n    40→# Templates\n    41→templates = Jinja2Templates(directory=str(config.VIEWS_DIR))\n    42→\n    43→# Include routers\n    44→from server.routes import (\n    45→    projects,\n    46→    loops,\n    47→    stream,\n    48→    plans,\n    49→    providers,\n    50→    shutdown,\n    51→    architecture,\n    52→    chat,\n    53→    chat_sessions,\n    54→    ralph,\n    55→    ralph_settings,\n    56→)\n    57→\n    58→app.include_router(projects.router)\n    59→app.include_router(loops.router)\n    60→app.include_router(stream.router)\n    61→app.include_router(plans.router)\n    62→app.include_router(providers.router)\n    63→app.include_router(shutdown.router)\n    64→app.include_router(architecture.router)\n    65→app.include_router(chat.router)\n    66→app.include_router(chat_sessions.router)\n    67→app.include_router(ralph.router)\n    68→app.include_router(ralph_settings.router)\n    69→\n    70→\n    71→@app.get(\"/api/health\")\n    72→async def health_check():\n    73→    \"\"\"Health check endpoint for monitoring and hooks.\"\"\"\n    74→    running_loops = {\n    75→        pid: state.to_dict()\n    76→        for pid, state in loop_service.get_all_states().items()\n    77→        if state.status in (\"running\", \"starting\")\n    78→    }\n    79→    return {\n    80→        \"status\": \"ok\",\n    81→        \"version\": app.version,\n    82→        \"running_loops\": len(running_loops),\n    83→    }\n    84→\n    85→\n    86→@app.get(\"/api/loops/running\")\n    87→async def running_loops_summary():\n    88→    \"\"\"Return compact summary of active loops for global app-bar status UI.\"\"\"\n    89→    project_map = {p.id: p for p in ProjectService.get_all()}\n    90→    summaries = []\n    91→    for project_id, state in loop_service.get_all_states().items():\n    92→        if state.status not in (\"running\", \"starting\"):\n    93→            continue\n    94→\n    95→        max_iters = state.max_iterations or 0\n    96→        progress = None\n    97→        if max_iters > 0:\n    98→            progress = min(100, int((state.iteration / max_iters) * 100))\n    99→\n   100→        project = project_map.get(project_id)\n   101→        recent_actions = list(state.recent_actions)[-3:]\n   102→        summaries.append(\n   103→            {\n   104→                \"kind\": \"project_loop\",\n   105→                \"project_id\": project_id,\n   106→                \"project_name\": project.name if project else project_id,\n   107→                \"status\": state.status,\n   108→                \"feature_name\": state.feature_name,\n   109→                \"mode\": state.mode,\n   110→                \"provider\": state.provider,\n   111→                \"provider_display_name\": state.provider_display_name,\n   112→                \"model\": state.model,\n   113→                \"iteration\": state.iteration,\n   114→                \"max_iterations\": max_iters,\n   115→                \"progress_percent\": progress,\n   116→                \"start_time\": state.start_time,\n   117→                \"recent_actions\": recent_actions,\n   118→            }\n   119→        )\n   120→\n   121→    # Also include running Ralph jobs started via ralph_start\n   122→    for project in project_map.values():\n   123→        project_root = Path(project.path)\n   124→        for job in ralph_service.list_jobs(project_root):\n   125→            if job.get(\"status\") != \"running\":\n   126→                continue\n   127→\n   128→            # Refresh status to avoid stale \"running\" jobs with dead PID\n   129→            refreshed = ralph_service.get_job_status(project_root, job.get(\"job_id\", \"\"))\n   130→            if not refreshed or refreshed.get(\"status\") != \"running\":\n   131→                continue\n   132→\n   133→            progress_tail = refreshed.get(\"progress_tail\") or []\n   134→            recent_actions = [\n   135→                {\n   136→                    \"time\": refreshed.get(\"completed_at\")\n   137→                    or refreshed.get(\"started_at\")\n   138→                    or refreshed.get(\"created_at\"),\n   139→                    \"type\": \"progress\",\n   140→                    \"message\": line,\n   141→                }\n   142→                for line in progress_tail[-3:]\n   143→            ]\n   144→\n   145→            max_iters = refreshed.get(\"iterations\") or 0\n   146→            current_iter = refreshed.get(\"current_iteration\") or 0\n   147→            progress = None\n   148→            if max_iters > 0:\n   149→                progress = min(100, int((current_iter / max_iters) * 100))\n   150→\n   151→            summaries.append(\n   152→                {\n   153→                    \"kind\": \"ralph_job\",\n   154→                    \"job_id\": refreshed.get(\"job_id\"),\n   155→                    \"project_id\": project.id,\n   156→                    \"project_name\": project.name,\n   157→                    \"status\": refreshed.get(\"status\"),\n   158→                    \"feature_name\": refreshed.get(\"slug\") or refreshed.get(\"job_id\"),\n   159→                    \"mode\": refreshed.get(\"mode\"),\n   160→                    \"provider\": refreshed.get(\"provider\"),\n   161→                    \"provider_display_name\": refreshed.get(\"provider\"),\n   162→                    \"model\": refreshed.get(\"model\"),\n   163→                    \"iteration\": current_iter,\n   164→                    \"max_iterations\": max_iters,\n   165→                    \"progress_percent\": progress,\n   166→                    \"start_time\": refreshed.get(\"started_at\") or refreshed.get(\"created_at\"),\n   167→                    \"recent_actions\": recent_actions,\n   168→                }\n   169→            )\n   170→\n   171→    summaries.sort(key=lambda item: item.get(\"start_time\") or \"\", reverse=True)\n   172→    return {\"count\": len(summaries), \"loops\": summaries}\n   173→\n   174→\n   175→@app.get(\"/\")\n   176→async def dashboard(request: Request):\n   177→    \"\"\"Main dashboard showing all registered projects.\"\"\"\n   178→    all_projects = ProjectService.get_all()\n   179→    states = loop_service.get_all_states()\n   180→\n   181→    # Enrich projects with loop state\n   182→    project_data = []\n   183→    for p in all_projects:\n   184→        state = states.get(p.id)\n   185→        project_data.append(\n   186→            {\n   187→                **p.to_dict(),\n   188→                \"loop_status\": state.status if state else \"idle\",\n   189→                \"loop_iteration\": state.iteration if state else 0,\n   190→                \"loop_feature\": state.feature_name if state else None,\n   191→                \"loop_mode\": state.mode if state else None,\n   192→            }\n   193→        )\n   194→\n   195→    return templates.TemplateResponse(\n   196→        request,\n   197→        \"dashboard.html\",\n   198→        {\n   199→            \"projects\": project_data,\n   200→        },\n   201→    )\n   202→\n   203→\n   204→@app.get(\"/project/{project_id}\")\n   205→async def project_detail(request: Request, project_id: str):\n   206→    \"\"\"Single project detail page with loop controls.\"\"\"\n   207→    project = ProjectService.get_by_id(project_id)\n   208→    if not project:\n   209→        return templates.TemplateResponse(\n   210→            request,\n   211→            \"dashboard.html\",\n   212→            {\n   213→                \"projects\": [],\n   214→                \"error\": \"Project not found\",\n   215→            },\n   216→        )\n   217→\n   218→    features = ProjectService.scan_features_detailed(project.path)\n   219→    state = loop_service.get_state(project_id)\n   220→    providers = [p.to_summary_dict() for p in get_enabled_providers()]\n   221→\n   222→    return templates.TemplateResponse(\n   223→        request,\n   224→        \"project.html\",\n   225→        {\n   226→            \"project\": project.to_dict(),\n   227→            \"features\": features,\n   228→            \"loop_state\": state.to_dict() if state else {\"status\": \"idle\"},\n   229→            \"providers\": providers,\n   230→        },\n   231→    )\n   232→\n   233→\n   234→@app.get(\"/ralph/jobs\")\n   235→async def ralph_jobs_page(request: Request):\n   236→    \"\"\"Ralph jobs list page.\"\"\"\n   237→    all_jobs = []\n   238→    for project in ProjectService.get_all():\n   239→        project_root = Path(project.path)\n   240→        jobs = ralph_service.list_jobs(project_root)\n   241→        for job in jobs:\n   242→            job[\"project_name\"] = project.name\n   243→            job[\"project_id\"] = project.id\n   244→        all_jobs.extend(jobs)\n   245→    all_jobs.sort(key=lambda j: j.get(\"created_at\", \"\"), reverse=True)\n   246→    has_running = any(j.get(\"status\") == \"running\" for j in all_jobs)\n   247→\n   248→    return templates.TemplateResponse(\n   249→        request,\n   250→        \"ralph_jobs.html\",\n   251→        {\"jobs\": all_jobs, \"has_running\": has_running},\n   252→    )\n   253→\n   254→\n   255→@app.get(\"/ralph/jobs/{job_id}\")\n   256→async def ralph_job_detail_page(request: Request, job_id: str):\n   257→    \"\"\"Ralph job detail page.\"\"\"\n   258→    job = None\n   259→    job_dir = None\n   260→    for project in ProjectService.get_all():\n   261→        project_root = Path(project.path)\n   262→        result = ralph_service.get_job_status(project_root, job_id)\n   263→        if result:\n   264→            job = result\n   265→            job[\"project_name\"] = project.name\n   266→            job[\"project_id\"] = project.id\n   267→            # Find job dir for artifacts\n   268→            ralph_dir = project_root / \".vista\" / \"ralph\"\n   269→            if ralph_dir.exists():\n   270→                for slug_dir in ralph_dir.iterdir():\n   271→                    if slug_dir.is_dir():\n   272→                        jf = slug_dir / \"job.json\"\n   273→                        if jf.exists():\n   274→                            try:\n   275→                                data = json.loads(jf.read_text(encoding=\"utf-8\"))\n   276→                                if data.get(\"job_id\") == job_id:\n   277→                                    job_dir = slug_dir\n   278→                                    break\n   279→                            except (json.JSONDecodeError, OSError):\n   280→                                continue\n   281→            break\n   282→\n   283→    if not job:\n   284→        return templates.TemplateResponse(\n   285→            request,\n   286→            \"ralph_jobs.html\",\n   287→            {\"jobs\": [], \"has_running\": False, \"error\": \"Job not found\"},\n   288→        )\n   289→\n   290→    # Read progress lines — prefer progress.txt, fall back to output.log parsing\n   291→    progress_lines = []\n   292→    if job_dir:\n   293→        progress_file = job_dir / \"progress.txt\"\n   294→        if progress_file.exists():\n   295→            lines = progress_file.read_text(encoding=\"utf-8\").splitlines()\n   296→            progress_lines = lines[-50:]\n   297→        else:\n   298→            output_file = job_dir / \"output.log\"\n   299→            if output_file.exists():\n   300→                try:\n   301→                    raw = output_file.read_text(\n   302→                        encoding=\"utf-8\", errors=\"replace\"\n   303→                    ).splitlines()\n   304→                    progress_lines, _iter = parse_stream_json_activity(raw[-500:])\n   305→                    progress_lines = progress_lines[-50:]\n   306→                except OSError:\n   307→                    pass\n   308→\n   309→    # List artifacts\n   310→    artifacts = []\n   311→    if job_dir:\n   312→        exclude = {\"job.json\", \"output.log\"}\n   313→        for f in sorted(job_dir.iterdir()):\n   314→            if f.is_file() and f.name not in exclude:\n   315→                artifacts.append({\"name\": f.name, \"size\": f.stat().st_size})\n   316→\n   317→    return templates.TemplateResponse(\n   318→        request,\n   319→        \"ralph_job_detail.html\",\n   320→        {\n   321→            \"job\": job,\n   322→            \"progress_lines\": progress_lines,\n   323→            \"artifacts\": artifacts,\n   324→        },\n   325→    )\n   326→\n   327→\n   328→@app.get(\"/ralph/settings\")\n   329→async def ralph_settings_page(request: Request):\n   330→    \"\"\"Ralph settings page.\"\"\"\n   331→    return templates.TemplateResponse(request, \"ralph_settings.html\", {})\n   332→"}]},"parent_tool_use_id":"toolu_01SczPVD4G56yi1W94CTFVfY","session_id":"14b921d9-eeaf-453d-9533-337d6f497996","uuid":"0a0e578f-d630-4c47-bda2-217b607e55f8"}
