{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PzKxbdCjopeNCHKMUxKKep","type":"tool_result","content":"     1→\"\"\"Ralph job API endpoints for the dashboard.\"\"\"\n     2→\n     3→import json\n     4→from pathlib import Path\n     5→\n     6→from fastapi import APIRouter, HTTPException\n     7→from fastapi.responses import PlainTextResponse\n     8→\n     9→from server.services.output_parser import parse_plaintext_activity, parse_stream_json_activity\n    10→from server.services.project_service import ProjectService\n    11→from server.services.ralph_service import ralph_service\n    12→\n    13→router = APIRouter(prefix=\"/api/ralph\", tags=[\"ralph\"])\n    14→\n    15→\n    16→def _find_job_context(job_id: str):\n    17→    \"\"\"Find a ralph job across all registered projects.\n    18→\n    19→    Returns (project, project_root, job_dir) or raises HTTPException(404).\n    20→    \"\"\"\n    21→    for project in ProjectService.get_all():\n    22→        project_root = Path(project.path)\n    23→        ralph_dir = project_root / \".vista\" / \"ralph\"\n    24→        if not ralph_dir.exists():\n    25→            continue\n    26→        for slug_dir in ralph_dir.iterdir():\n    27→            if not slug_dir.is_dir():\n    28→                continue\n    29→            job_file = slug_dir / \"job.json\"\n    30→            if not job_file.exists():\n    31→                continue\n    32→            try:\n    33→                data = json.loads(job_file.read_text(encoding=\"utf-8\"))\n    34→                if data.get(\"job_id\") == job_id:\n    35→                    return project, project_root, slug_dir\n    36→            except (json.JSONDecodeError, OSError):\n    37→                continue\n    38→    raise HTTPException(status_code=404, detail=f\"Job not found: {job_id}\")\n    39→\n    40→\n    41→@router.get(\"/jobs\")\n    42→async def list_ralph_jobs():\n    43→    \"\"\"List all ralph jobs across all registered projects.\"\"\"\n    44→    all_jobs = []\n    45→    for project in ProjectService.get_all():\n    46→        project_root = Path(project.path)\n    47→        jobs = ralph_service.list_jobs(project_root)\n    48→        for job in jobs:\n    49→            job[\"project_name\"] = project.name\n    50→            job[\"project_id\"] = project.id\n    51→        all_jobs.extend(jobs)\n    52→    all_jobs.sort(key=lambda j: j.get(\"created_at\", \"\"), reverse=True)\n    53→    return {\"jobs\": all_jobs}\n    54→\n    55→\n    56→@router.get(\"/jobs/{job_id}\")\n    57→async def get_ralph_job(job_id: str):\n    58→    \"\"\"Get a single ralph job with current status.\"\"\"\n    59→    project, project_root, _job_dir = _find_job_context(job_id)\n    60→    job = ralph_service.get_job_status(project_root, job_id)\n    61→    if not job:\n    62→        raise HTTPException(status_code=404, detail=f\"Job not found: {job_id}\")\n    63→    job[\"project_name\"] = project.name\n    64→    job[\"project_id\"] = project.id\n    65→    return job\n    66→\n    67→\n    68→@router.get(\"/jobs/{job_id}/progress\")\n    69→async def get_ralph_progress(job_id: str, last: int = 50):\n    70→    \"\"\"Get parsed agent activity from output.log.\"\"\"\n    71→    _project, _project_root, job_dir = _find_job_context(job_id)\n    72→    # Always parse output.log for dashboard display (progress.txt is inter-loop context only)\n    73→    output_file = job_dir / \"output.log\"\n    74→    if not output_file.exists():\n    75→        return {\"lines\": []}\n    76→    try:\n    77→        raw = output_file.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines()\n    78→    except OSError:\n    79→        return {\"lines\": []}\n    80→    # Read provider from job.json to choose the right parser\n    81→    provider = \"\"\n    82→    job_file = job_dir / \"job.json\"\n    83→    if job_file.exists():\n    84→        try:\n    85→            provider = json.loads(job_file.read_text(encoding=\"utf-8\")).get(\"provider\", \"\")\n    86→        except (json.JSONDecodeError, OSError):\n    87→            pass\n    88→    if provider == \"claude\":\n    89→        activity, _iteration = parse_stream_json_activity(raw[-500:])\n    90→    else:\n    91→        activity, _iteration = parse_plaintext_activity(raw[-500:])\n    92→    return {\"lines\": activity[-last:]}\n    93→\n    94→\n    95→@router.get(\"/jobs/{job_id}/output\")\n    96→async def get_ralph_output(job_id: str, last: int = 200):\n    97→    \"\"\"Get last N lines of output.log.\"\"\"\n    98→    _project, _project_root, job_dir = _find_job_context(job_id)\n    99→    output_file = job_dir / \"output.log\"\n   100→    if not output_file.exists():\n   101→        return {\"lines\": []}\n   102→    lines = output_file.read_text(encoding=\"utf-8\").splitlines()\n   103→    return {\"lines\": lines[-last:]}\n   104→\n   105→\n   106→@router.get(\"/jobs/{job_id}/artifacts\")\n   107→async def list_ralph_artifacts(job_id: str):\n   108→    \"\"\"List artifact files in job directory.\"\"\"\n   109→    _project, _project_root, job_dir = _find_job_context(job_id)\n   110→    # Exclude internal files, show everything else\n   111→    exclude = {\"job.json\", \"output.log\"}\n   112→    artifacts = []\n   113→    for f in sorted(job_dir.iterdir()):\n   114→        if f.is_file() and f.name not in exclude:\n   115→            artifacts.append({\n   116→                \"name\": f.name,\n   117→                \"size\": f.stat().st_size,\n   118→            })\n   119→    # Also include archived job.json files\n   120→    for f in sorted(job_dir.glob(\"job.*.json\")):\n   121→        artifacts.append({\n   122→            \"name\": f.name,\n   123→            \"size\": f.stat().st_size,\n   124→        })\n   125→    return {\"artifacts\": artifacts}\n   126→\n   127→\n   128→@router.get(\"/jobs/{job_id}/artifacts/{filename:path}\")\n   129→async def get_ralph_artifact(job_id: str, filename: str):\n   130→    \"\"\"Read contents of a specific artifact file.\"\"\"\n   131→    _project, _project_root, job_dir = _find_job_context(job_id)\n   132→    artifact = job_dir / filename\n   133→    # Security: ensure the resolved path is within the job directory\n   134→    try:\n   135→        artifact.resolve().relative_to(job_dir.resolve())\n   136→    except ValueError:\n   137→        raise HTTPException(status_code=400, detail=\"Invalid artifact path\")\n   138→    if not artifact.exists() or not artifact.is_file():\n   139→        raise HTTPException(status_code=404, detail=f\"Artifact not found: {filename}\")\n   140→    content = artifact.read_text(encoding=\"utf-8\", errors=\"replace\")\n   141→    return PlainTextResponse(content)\n   142→\n   143→\n   144→@router.post(\"/jobs/{job_id}/stop\")\n   145→async def stop_ralph_job(job_id: str):\n   146→    \"\"\"Stop a running ralph job.\"\"\"\n   147→    try:\n   148→        project, project_root, _job_dir = _find_job_context(job_id)\n   149→        job = ralph_service.stop_job(project_root, job_id)\n   150→        if not job:\n   151→            raise HTTPException(status_code=404, detail=f\"Job not found: {job_id}\")\n   152→        job[\"project_name\"] = project.name\n   153→        job[\"project_id\"] = project.id\n   154→        return job\n   155→    except HTTPException:\n   156→        raise\n   157→    except Exception as e:\n   158→        raise HTTPException(status_code=500, detail=f\"Failed to stop job: {e}\")\n   159→"}]},"parent_tool_use_id":null,"session_id":"14b921d9-eeaf-453d-9533-337d6f497996","uuid":"f8bf6d13-c9b2-4a41-b594-42689b25c9d9","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/routes/ralph.py","content":"\"\"\"Ralph job API endpoints for the dashboard.\"\"\"\n\nimport json\nfrom pathlib import Path\n\nfrom fastapi import APIRouter, HTTPException\nfrom fastapi.responses import PlainTextResponse\n\nfrom server.services.output_parser import parse_plaintext_activity, parse_stream_json_activity\nfrom server.services.project_service import ProjectService\nfrom server.services.ralph_service import ralph_service\n\nrouter = APIRouter(prefix=\"/api/ralph\", tags=[\"ralph\"])\n\n\ndef _find_job_context(job_id: str):\n    \"\"\"Find a ralph job across all registered projects.\n\n    Returns (project, project_root, job_dir) or raises HTTPException(404).\n    \"\"\"\n    for project in ProjectService.get_all():\n        project_root = Path(project.path)\n        ralph_dir = project_root / \".vista\" / \"ralph\"\n        if not ralph_dir.exists():\n            continue\n        for slug_dir in ralph_dir.iterdir():\n            if not slug_dir.is_dir():\n                continue\n            job_file = slug_dir / \"job.json\"\n            if not job_file.exists():\n                continue\n            try:\n                data = json.loads(job_file.read_text(encoding=\"utf-8\"))\n                if data.get(\"job_id\") == job_id:\n                    return project, project_root, slug_dir\n            except (json.JSONDecodeError, OSError):\n                continue\n    raise HTTPException(status_code=404, detail=f\"Job not found: {job_id}\")\n\n\n@router.get(\"/jobs\")\nasync def list_ralph_jobs():\n    \"\"\"List all ralph jobs across all registered projects.\"\"\"\n    all_jobs = []\n    for project in ProjectService.get_all():\n        project_root = Path(project.path)\n        jobs = ralph_service.list_jobs(project_root)\n        for job in jobs:\n            job[\"project_name\"] = project.name\n            job[\"project_id\"] = project.id\n        all_jobs.extend(jobs)\n    all_jobs.sort(key=lambda j: j.get(\"created_at\", \"\"), reverse=True)\n    return {\"jobs\": all_jobs}\n\n\n@router.get(\"/jobs/{job_id}\")\nasync def get_ralph_job(job_id: str):\n    \"\"\"Get a single ralph job with current status.\"\"\"\n    project, project_root, _job_dir = _find_job_context(job_id)\n    job = ralph_service.get_job_status(project_root, job_id)\n    if not job:\n        raise HTTPException(status_code=404, detail=f\"Job not found: {job_id}\")\n    job[\"project_name\"] = project.name\n    job[\"project_id\"] = project.id\n    return job\n\n\n@router.get(\"/jobs/{job_id}/progress\")\nasync def get_ralph_progress(job_id: str, last: int = 50):\n    \"\"\"Get parsed agent activity from output.log.\"\"\"\n    _project, _project_root, job_dir = _find_job_context(job_id)\n    # Always parse output.log for dashboard display (progress.txt is inter-loop context only)\n    output_file = job_dir / \"output.log\"\n    if not output_file.exists():\n        return {\"lines\": []}\n    try:\n        raw = output_file.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines()\n    except OSError:\n        return {\"lines\": []}\n    # Read provider from job.json to choose the right parser\n    provider = \"\"\n    job_file = job_dir / \"job.json\"\n    if job_file.exists():\n        try:\n            provider = json.loads(job_file.read_text(encoding=\"utf-8\")).get(\"provider\", \"\")\n        except (json.JSONDecodeError, OSError):\n            pass\n    if provider == \"claude\":\n        activity, _iteration = parse_stream_json_activity(raw[-500:])\n    else:\n        activity, _iteration = parse_plaintext_activity(raw[-500:])\n    return {\"lines\": activity[-last:]}\n\n\n@router.get(\"/jobs/{job_id}/output\")\nasync def get_ralph_output(job_id: str, last: int = 200):\n    \"\"\"Get last N lines of output.log.\"\"\"\n    _project, _project_root, job_dir = _find_job_context(job_id)\n    output_file = job_dir / \"output.log\"\n    if not output_file.exists():\n        return {\"lines\": []}\n    lines = output_file.read_text(encoding=\"utf-8\").splitlines()\n    return {\"lines\": lines[-last:]}\n\n\n@router.get(\"/jobs/{job_id}/artifacts\")\nasync def list_ralph_artifacts(job_id: str):\n    \"\"\"List artifact files in job directory.\"\"\"\n    _project, _project_root, job_dir = _find_job_context(job_id)\n    # Exclude internal files, show everything else\n    exclude = {\"job.json\", \"output.log\"}\n    artifacts = []\n    for f in sorted(job_dir.iterdir()):\n        if f.is_file() and f.name not in exclude:\n            artifacts.append({\n                \"name\": f.name,\n                \"size\": f.stat().st_size,\n            })\n    # Also include archived job.json files\n    for f in sorted(job_dir.glob(\"job.*.json\")):\n        artifacts.append({\n            \"name\": f.name,\n            \"size\": f.stat().st_size,\n        })\n    return {\"artifacts\": artifacts}\n\n\n@router.get(\"/jobs/{job_id}/artifacts/{filename:path}\")\nasync def get_ralph_artifact(job_id: str, filename: str):\n    \"\"\"Read contents of a specific artifact file.\"\"\"\n    _project, _project_root, job_dir = _find_job_context(job_id)\n    artifact = job_dir / filename\n    # Security: ensure the resolved path is within the job directory\n    try:\n        artifact.resolve().relative_to(job_dir.resolve())\n    except ValueError:\n        raise HTTPException(status_code=400, detail=\"Invalid artifact path\")\n    if not artifact.exists() or not artifact.is_file():\n        raise HTTPException(status_code=404, detail=f\"Artifact not found: {filename}\")\n    content = artifact.read_text(encoding=\"utf-8\", errors=\"replace\")\n    return PlainTextResponse(content)\n\n\n@router.post(\"/jobs/{job_id}/stop\")\nasync def stop_ralph_job(job_id: str):\n    \"\"\"Stop a running ralph job.\"\"\"\n    try:\n        project, project_root, _job_dir = _find_job_context(job_id)\n        job = ralph_service.stop_job(project_root, job_id)\n        if not job:\n            raise HTTPException(status_code=404, detail=f\"Job not found: {job_id}\")\n        job[\"project_name\"] = project.name\n        job[\"project_id\"] = project.id\n        return job\n    except HTTPException:\n        raise\n    except Exception as e:\n        raise HTTPException(status_code=500, detail=f\"Failed to stop job: {e}\")\n","numLines":159,"startLine":1,"totalLines":159}}}
