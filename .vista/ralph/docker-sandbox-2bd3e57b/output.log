{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NKu466hQYabroFy3P6UDNq","type":"tool_result","content":"     1→\"\"\"Server configuration. All paths computed relative to plugin root.\"\"\"\n     2→\n     3→import json\n     4→import os\n     5→import platform\n     6→from pathlib import Path\n     7→\n     8→# Directory structure\n     9→PLUGIN_ROOT = Path(__file__).resolve().parent.parent  # plugin_1/\n    10→SERVER_DIR = Path(__file__).resolve().parent  # plugin_1/server/\n    11→PORTABLE_DIR = PLUGIN_ROOT / \"portable\"\n    12→TEMPLATES_DIR = PORTABLE_DIR / \"templates\"\n    13→DATA_DIR = SERVER_DIR / \"data\"\n    14→PROJECTS_FILE = DATA_DIR / \"projects.json\"\n    15→VIEWS_DIR = SERVER_DIR / \"views\"\n    16→STATIC_DIR = VIEWS_DIR / \"static\"\n    17→\n    18→# Settings file\n    19→LEGACY_SETTINGS_FILE = PLUGIN_ROOT / \"settings.json\"\n    20→\n    21→\n    22→def _resolve_settings_file() -> Path:\n    23→    \"\"\"Return persistent settings path outside app install directory.\n    24→\n    25→    Users can override via ``VISTA_SETTINGS_FILE`` for advanced setups.\n    26→    \"\"\"\n    27→    override = os.environ.get(\"VISTA_SETTINGS_FILE\", \"\").strip()\n    28→    if override:\n    29→        return Path(override).expanduser().resolve()\n    30→\n    31→    return Path.home() / \".vista\" / \"settings.json\"\n    32→\n    33→\n    34→_DEFAULT_SETTINGS_FILE = _resolve_settings_file()\n    35→SETTINGS_FILE = _DEFAULT_SETTINGS_FILE\n    36→\n    37→_SERVER_DEFAULTS = {\n    38→    \"auto_start\": True,\n    39→    \"auto_open_browser\": True,\n    40→    \"host\": \"127.0.0.1\",\n    41→    \"port\": 3456,\n    42→}\n    43→\n    44→_RALPH_DEFAULTS = {\n    45→    \"defaults\": {\n    46→        \"provider\": \"claude\",\n    47→        \"model\": \"sonnet\",\n    48→        \"iterations\": 3,\n    49→    },\n    50→    \"summarizer\": {\n    51→        \"provider\": \"claude\",\n    52→        \"model\": \"haiku\",\n    53→    },\n    54→    \"providers\": {},\n    55→}\n    56→\n    57→_TOOLS_DEFAULTS = {\n    58→    \"teams\": {\n    59→        \"claude_binary\": None,\n    60→        \"opencode_url\": None,\n    61→        \"opencode_auto_start\": True,\n    62→        \"opencode_port\": 4200,\n    63→    },\n    64→    \"ralph\": {},\n    65→}\n    66→\n    67→\n    68→def get_tools_settings() -> dict:\n    69→    \"\"\"Return merged tools settings with defaults applied.\"\"\"\n    70→    raw = load_settings().get(\"tools\", {})\n    71→    if not isinstance(raw, dict):\n    72→        raw = {}\n    73→    return _merge_dicts(_TOOLS_DEFAULTS, raw)\n    74→\n    75→\n    76→def load_settings() -> dict:\n    77→    \"\"\"Load settings.json from PLUGIN_ROOT, returning {} on failure.\"\"\"\n    78→    _migrate_legacy_settings_if_needed()\n    79→    if SETTINGS_FILE.exists():\n    80→        try:\n    81→            return json.loads(SETTINGS_FILE.read_text(encoding=\"utf-8\"))\n    82→        except (json.JSONDecodeError, OSError):\n    83→            pass\n    84→    return {}\n    85→\n    86→\n    87→def _migrate_legacy_settings_if_needed() -> None:\n    88→    \"\"\"Migrate settings from legacy plugin-local file to persistent location.\n    89→\n    90→    Migration runs only for the default persistent path, so tests and custom\n    91→    overrides that patch ``SETTINGS_FILE`` are unaffected.\n    92→    \"\"\"\n    93→    if SETTINGS_FILE != _DEFAULT_SETTINGS_FILE:\n    94→        return\n    95→    if SETTINGS_FILE == LEGACY_SETTINGS_FILE:\n    96→        return\n    97→    if SETTINGS_FILE.exists() or not LEGACY_SETTINGS_FILE.exists():\n    98→        return\n    99→\n   100→    try:\n   101→        SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n   102→        SETTINGS_FILE.write_text(LEGACY_SETTINGS_FILE.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\n   103→    except OSError:\n   104→        # Non-fatal: app can still proceed with defaults.\n   105→        return\n   106→\n   107→\n   108→def _merge_dicts(base: dict, overlay: dict) -> dict:\n   109→    merged = dict(base)\n   110→    for key, value in overlay.items():\n   111→        if isinstance(value, dict) and isinstance(merged.get(key), dict):\n   112→            merged[key] = _merge_dicts(merged[key], value)\n   113→        else:\n   114→            merged[key] = value\n   115→    return merged\n   116→\n   117→\n   118→def get_ralph_settings() -> dict:\n   119→    \"\"\"Return merged ralph settings with defaults applied.\"\"\"\n   120→    raw = load_settings().get(\"ralph\", {})\n   121→    if not isinstance(raw, dict):\n   122→        raw = {}\n   123→    return _merge_dicts(_RALPH_DEFAULTS, raw)\n   124→\n   125→\n   126→def get_ralph_defaults() -> dict:\n   127→    \"\"\"Return default provider/model/iterations for ralph_start.\"\"\"\n   128→    settings = get_ralph_settings().get(\"defaults\", {})\n   129→    defaults = dict(_RALPH_DEFAULTS[\"defaults\"])\n   130→    defaults.update({k: v for k, v in settings.items() if v is not None})\n   131→    iterations = defaults.get(\"iterations\")\n   132→    if not isinstance(iterations, int) or iterations <= 0:\n   133→        defaults[\"iterations\"] = _RALPH_DEFAULTS[\"defaults\"][\"iterations\"]\n   134→    return defaults\n   135→\n   136→\n   137→def get_summarizer_config() -> dict:\n   138→    \"\"\"Return summarizer provider/model configuration.\"\"\"\n   139→    settings = get_ralph_settings().get(\"summarizer\", {})\n   140→    config = dict(_RALPH_DEFAULTS[\"summarizer\"])\n   141→    config.update({k: v for k, v in settings.items() if v})\n   142→    return config\n   143→\n   144→\n   145→def save_ralph_settings(ralph_config: dict) -> None:\n   146→    \"\"\"Write the ralph section back to settings.json, preserving other sections.\"\"\"\n   147→    _migrate_legacy_settings_if_needed()\n   148→    settings = load_settings()\n   149→    settings[\"ralph\"] = ralph_config\n   150→    SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n   151→    tmp_file = SETTINGS_FILE.with_suffix(\".json.tmp\")\n   152→    tmp_file.write_text(json.dumps(settings, indent=2), encoding=\"utf-8\")\n   153→    tmp_file.replace(SETTINGS_FILE)\n   154→\n   155→\n   156→def get_server_settings() -> dict:\n   157→    \"\"\"Return merged server settings.  Priority: env vars > settings.json > defaults.\"\"\"\n   158→    settings = load_settings().get(\"server\", {})\n   159→    merged = {**_SERVER_DEFAULTS, **settings}\n   160→\n   161→    # Env var overrides (match existing RALPH_SERVER_* convention)\n   162→    if \"RALPH_SERVER_HOST\" in os.environ:\n   163→        merged[\"host\"] = os.environ[\"RALPH_SERVER_HOST\"]\n   164→    if \"RALPH_SERVER_PORT\" in os.environ:\n   165→        merged[\"port\"] = int(os.environ[\"RALPH_SERVER_PORT\"])\n   166→    if \"RALPH_SERVER_AUTO_START\" in os.environ:\n   167→        merged[\"auto_start\"] = os.environ[\"RALPH_SERVER_AUTO_START\"].lower() in (\n   168→            \"1\",\n   169→            \"true\",\n   170→            \"yes\",\n   171→        )\n   172→    if \"RALPH_SERVER_AUTO_OPEN\" in os.environ:\n   173→        merged[\"auto_open_browser\"] = os.environ[\"RALPH_SERVER_AUTO_OPEN\"].lower() in (\n   174→            \"1\",\n   175→            \"true\",\n   176→            \"yes\",\n   177→        )\n   178→\n   179→    return merged\n   180→\n   181→\n   182→def ensure_full_path() -> None:\n   183→    \"\"\"On Windows, merge the full system+user PATH from the registry.\n   184→\n   185→    Some launch contexts (e.g. git-bash, certain IDE sandboxes) have a\n   186→    stripped-down PATH missing entries like nodejs/ and npm/. The Windows\n   187→    registry holds the authoritative PATH. Merging it ensures subprocesses\n   188→    like ``claude`` and ``opencode`` can find their dependencies.\n   189→\n   190→    Safe to call multiple times; subsequent calls are no-ops.\n   191→    \"\"\"\n   192→    if platform.system() != \"Windows\":\n   193→        return\n   194→    try:\n   195→        import winreg\n   196→    except ImportError:\n   197→        return\n   198→\n   199→    registry_dirs: list[str] = []\n   200→    for hive, subkey in [\n   201→        (\n   202→            winreg.HKEY_LOCAL_MACHINE,\n   203→            r\"SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\",\n   204→        ),\n   205→        (winreg.HKEY_CURRENT_USER, r\"Environment\"),\n   206→    ]:\n   207→        try:\n   208→            key = winreg.OpenKey(hive, subkey)\n   209→            raw = winreg.QueryValueEx(key, \"Path\")[0]\n   210→            winreg.CloseKey(key)\n   211→            registry_dirs.extend(\n   212→                os.path.expandvars(d) for d in raw.split(\";\") if d.strip()\n   213→            )\n   214→        except OSError:\n   215→            continue\n   216→\n   217→    current = set(os.environ.get(\"PATH\", \"\").split(\";\"))\n   218→    new_dirs = [d for d in registry_dirs if d not in current and os.path.isdir(d)]\n   219→    if new_dirs:\n   220→        os.environ[\"PATH\"] = os.environ.get(\"PATH\", \"\") + \";\" + \";\".join(new_dirs)\n   221→\n   222→\n   223→# Module-level HOST / PORT for backward compatibility\n   224→_server = get_server_settings()\n   225→HOST = _server[\"host\"]\n   226→PORT = _server[\"port\"]\n   227→"}]},"parent_tool_use_id":null,"session_id":"14b921d9-eeaf-453d-9533-337d6f497996","uuid":"1fd67c43-9b98-4291-b85c-6323a465a07d","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/config.py","content":"\"\"\"Server configuration. All paths computed relative to plugin root.\"\"\"\n\nimport json\nimport os\nimport platform\nfrom pathlib import Path\n\n# Directory structure\nPLUGIN_ROOT = Path(__file__).resolve().parent.parent  # plugin_1/\nSERVER_DIR = Path(__file__).resolve().parent  # plugin_1/server/\nPORTABLE_DIR = PLUGIN_ROOT / \"portable\"\nTEMPLATES_DIR = PORTABLE_DIR / \"templates\"\nDATA_DIR = SERVER_DIR / \"data\"\nPROJECTS_FILE = DATA_DIR / \"projects.json\"\nVIEWS_DIR = SERVER_DIR / \"views\"\nSTATIC_DIR = VIEWS_DIR / \"static\"\n\n# Settings file\nLEGACY_SETTINGS_FILE = PLUGIN_ROOT / \"settings.json\"\n\n\ndef _resolve_settings_file() -> Path:\n    \"\"\"Return persistent settings path outside app install directory.\n\n    Users can override via ``VISTA_SETTINGS_FILE`` for advanced setups.\n    \"\"\"\n    override = os.environ.get(\"VISTA_SETTINGS_FILE\", \"\").strip()\n    if override:\n        return Path(override).expanduser().resolve()\n\n    return Path.home() / \".vista\" / \"settings.json\"\n\n\n_DEFAULT_SETTINGS_FILE = _resolve_settings_file()\nSETTINGS_FILE = _DEFAULT_SETTINGS_FILE\n\n_SERVER_DEFAULTS = {\n    \"auto_start\": True,\n    \"auto_open_browser\": True,\n    \"host\": \"127.0.0.1\",\n    \"port\": 3456,\n}\n\n_RALPH_DEFAULTS = {\n    \"defaults\": {\n        \"provider\": \"claude\",\n        \"model\": \"sonnet\",\n        \"iterations\": 3,\n    },\n    \"summarizer\": {\n        \"provider\": \"claude\",\n        \"model\": \"haiku\",\n    },\n    \"providers\": {},\n}\n\n_TOOLS_DEFAULTS = {\n    \"teams\": {\n        \"claude_binary\": None,\n        \"opencode_url\": None,\n        \"opencode_auto_start\": True,\n        \"opencode_port\": 4200,\n    },\n    \"ralph\": {},\n}\n\n\ndef get_tools_settings() -> dict:\n    \"\"\"Return merged tools settings with defaults applied.\"\"\"\n    raw = load_settings().get(\"tools\", {})\n    if not isinstance(raw, dict):\n        raw = {}\n    return _merge_dicts(_TOOLS_DEFAULTS, raw)\n\n\ndef load_settings() -> dict:\n    \"\"\"Load settings.json from PLUGIN_ROOT, returning {} on failure.\"\"\"\n    _migrate_legacy_settings_if_needed()\n    if SETTINGS_FILE.exists():\n        try:\n            return json.loads(SETTINGS_FILE.read_text(encoding=\"utf-8\"))\n        except (json.JSONDecodeError, OSError):\n            pass\n    return {}\n\n\ndef _migrate_legacy_settings_if_needed() -> None:\n    \"\"\"Migrate settings from legacy plugin-local file to persistent location.\n\n    Migration runs only for the default persistent path, so tests and custom\n    overrides that patch ``SETTINGS_FILE`` are unaffected.\n    \"\"\"\n    if SETTINGS_FILE != _DEFAULT_SETTINGS_FILE:\n        return\n    if SETTINGS_FILE == LEGACY_SETTINGS_FILE:\n        return\n    if SETTINGS_FILE.exists() or not LEGACY_SETTINGS_FILE.exists():\n        return\n\n    try:\n        SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n        SETTINGS_FILE.write_text(LEGACY_SETTINGS_FILE.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\n    except OSError:\n        # Non-fatal: app can still proceed with defaults.\n        return\n\n\ndef _merge_dicts(base: dict, overlay: dict) -> dict:\n    merged = dict(base)\n    for key, value in overlay.items():\n        if isinstance(value, dict) and isinstance(merged.get(key), dict):\n            merged[key] = _merge_dicts(merged[key], value)\n        else:\n            merged[key] = value\n    return merged\n\n\ndef get_ralph_settings() -> dict:\n    \"\"\"Return merged ralph settings with defaults applied.\"\"\"\n    raw = load_settings().get(\"ralph\", {})\n    if not isinstance(raw, dict):\n        raw = {}\n    return _merge_dicts(_RALPH_DEFAULTS, raw)\n\n\ndef get_ralph_defaults() -> dict:\n    \"\"\"Return default provider/model/iterations for ralph_start.\"\"\"\n    settings = get_ralph_settings().get(\"defaults\", {})\n    defaults = dict(_RALPH_DEFAULTS[\"defaults\"])\n    defaults.update({k: v for k, v in settings.items() if v is not None})\n    iterations = defaults.get(\"iterations\")\n    if not isinstance(iterations, int) or iterations <= 0:\n        defaults[\"iterations\"] = _RALPH_DEFAULTS[\"defaults\"][\"iterations\"]\n    return defaults\n\n\ndef get_summarizer_config() -> dict:\n    \"\"\"Return summarizer provider/model configuration.\"\"\"\n    settings = get_ralph_settings().get(\"summarizer\", {})\n    config = dict(_RALPH_DEFAULTS[\"summarizer\"])\n    config.update({k: v for k, v in settings.items() if v})\n    return config\n\n\ndef save_ralph_settings(ralph_config: dict) -> None:\n    \"\"\"Write the ralph section back to settings.json, preserving other sections.\"\"\"\n    _migrate_legacy_settings_if_needed()\n    settings = load_settings()\n    settings[\"ralph\"] = ralph_config\n    SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n    tmp_file = SETTINGS_FILE.with_suffix(\".json.tmp\")\n    tmp_file.write_text(json.dumps(settings, indent=2), encoding=\"utf-8\")\n    tmp_file.replace(SETTINGS_FILE)\n\n\ndef get_server_settings() -> dict:\n    \"\"\"Return merged server settings.  Priority: env vars > settings.json > defaults.\"\"\"\n    settings = load_settings().get(\"server\", {})\n    merged = {**_SERVER_DEFAULTS, **settings}\n\n    # Env var overrides (match existing RALPH_SERVER_* convention)\n    if \"RALPH_SERVER_HOST\" in os.environ:\n        merged[\"host\"] = os.environ[\"RALPH_SERVER_HOST\"]\n    if \"RALPH_SERVER_PORT\" in os.environ:\n        merged[\"port\"] = int(os.environ[\"RALPH_SERVER_PORT\"])\n    if \"RALPH_SERVER_AUTO_START\" in os.environ:\n        merged[\"auto_start\"] = os.environ[\"RALPH_SERVER_AUTO_START\"].lower() in (\n            \"1\",\n            \"true\",\n            \"yes\",\n        )\n    if \"RALPH_SERVER_AUTO_OPEN\" in os.environ:\n        merged[\"auto_open_browser\"] = os.environ[\"RALPH_SERVER_AUTO_OPEN\"].lower() in (\n            \"1\",\n            \"true\",\n            \"yes\",\n        )\n\n    return merged\n\n\ndef ensure_full_path() -> None:\n    \"\"\"On Windows, merge the full system+user PATH from the registry.\n\n    Some launch contexts (e.g. git-bash, certain IDE sandboxes) have a\n    stripped-down PATH missing entries like nodejs/ and npm/. The Windows\n    registry holds the authoritative PATH. Merging it ensures subprocesses\n    like ``claude`` and ``opencode`` can find their dependencies.\n\n    Safe to call multiple times; subsequent calls are no-ops.\n    \"\"\"\n    if platform.system() != \"Windows\":\n        return\n    try:\n        import winreg\n    except ImportError:\n        return\n\n    registry_dirs: list[str] = []\n    for hive, subkey in [\n        (\n            winreg.HKEY_LOCAL_MACHINE,\n            r\"SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\",\n        ),\n        (winreg.HKEY_CURRENT_USER, r\"Environment\"),\n    ]:\n        try:\n            key = winreg.OpenKey(hive, subkey)\n            raw = winreg.QueryValueEx(key, \"Path\")[0]\n            winreg.CloseKey(key)\n            registry_dirs.extend(\n                os.path.expandvars(d) for d in raw.split(\";\") if d.strip()\n            )\n        except OSError:\n            continue\n\n    current = set(os.environ.get(\"PATH\", \"\").split(\";\"))\n    new_dirs = [d for d in registry_dirs if d not in current and os.path.isdir(d)]\n    if new_dirs:\n        os.environ[\"PATH\"] = os.environ.get(\"PATH\", \"\") + \";\" + \";\".join(new_dirs)\n\n\n# Module-level HOST / PORT for backward compatibility\n_server = get_server_settings()\nHOST = _server[\"host\"]\nPORT = _server[\"port\"]\n","numLines":227,"startLine":1,"totalLines":227}}}
