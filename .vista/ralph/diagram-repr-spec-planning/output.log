{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012eMtLmPY5SVvfHyQumBovZ","type":"tool_result","content":"     1→\"\"\"Diagram file watcher using watchdog filesystem events.\n     2→\n     3→Uses watchdog's Observer for instant filesystem event detection on Windows\n     4→(ReadDirectoryChangesW) with 100ms debounce to coalesce rapid file saves.\n     5→Broadcasts change events via async queues (same pub-sub pattern as loop_service).\n     6→\n     7→Auto-updates the _arch.json manifest when diagrams are added or removed.\n     8→\"\"\"\n     9→\n    10→import asyncio\n    11→import json\n    12→import logging\n    13→import threading\n    14→from pathlib import Path\n    15→from typing import Optional\n    16→\n    17→from watchdog.events import FileSystemEvent, FileSystemEventHandler\n    18→from watchdog.observers import Observer\n    19→\n    20→log = logging.getLogger(__name__)\n    21→\n    22→\n    23→class _DiagramEventHandler(FileSystemEventHandler):\n    24→    \"\"\"Handles filesystem events for .mmd/.drawio files.\"\"\"\n    25→\n    26→    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\n    27→\n    28→    def __init__(self, key: str, arch_dir: Path, watcher: \"DiagramWatcher\"):\n    29→        super().__init__()\n    30→        self.key = key\n    31→        self.arch_dir = arch_dir\n    32→        self.watcher = watcher\n    33→        self._lock = threading.Lock()\n    34→        self._pending: dict[str, tuple[str, str]] = {}  # path -> (event_type, filename)\n    35→        self._timer: Optional[threading.Timer] = None\n    36→\n    37→    def _is_diagram(self, path: str) -> bool:\n    38→        return Path(path).suffix in self.WATCH_EXTENSIONS\n    39→\n    40→    def on_created(self, event: FileSystemEvent) -> None:\n    41→        if not event.is_directory and self._is_diagram(event.src_path):\n    42→            self._debounced_notify(event.src_path, \"diagram_added\")\n    43→\n    44→    def on_modified(self, event: FileSystemEvent) -> None:\n    45→        if not event.is_directory and self._is_diagram(event.src_path):\n    46→            self._debounced_notify(event.src_path, \"diagram_changed\")\n    47→\n    48→    def on_deleted(self, event: FileSystemEvent) -> None:\n    49→        if not event.is_directory and self._is_diagram(event.src_path):\n    50→            self._debounced_notify(event.src_path, \"diagram_removed\")\n    51→\n    52→    def _debounced_notify(self, path: str, event_type: str, delay: float = 0.1):\n    53→        \"\"\"Debounce rapid events (100ms) to coalesce file saves.\"\"\"\n    54→        filename = Path(path).name\n    55→        with self._lock:\n    56→            self._pending[path] = (event_type, filename)\n    57→            if self._timer is not None:\n    58→                self._timer.cancel()\n    59→            self._timer = threading.Timer(delay, self._flush)\n    60→            self._timer.start()\n    61→\n    62→    def _flush(self) -> None:\n    63→        \"\"\"Flush all pending events.\"\"\"\n    64→        with self._lock:\n    65→            pending = dict(self._pending)\n    66→            self._pending.clear()\n    67→            self._timer = None\n    68→\n    69→        manifest_changed = False\n    70→        for path, (event_type, filename) in pending.items():\n    71→            if event_type == \"diagram_removed\":\n    72→                data = {\"file\": filename}\n    73→                manifest_changed = True\n    74→            else:\n    75→                content = _read_file(Path(path))\n    76→                data = {\"file\": filename, \"content\": content}\n    77→                if event_type == \"diagram_added\":\n    78→                    manifest_changed = True\n    79→\n    80→            self.watcher._schedule_broadcast(\n    81→                self.key, {\"event\": event_type, \"data\": data}\n    82→            )\n    83→\n    84→        if manifest_changed:\n    85→            self.watcher._schedule_manifest_update(self.key, self.arch_dir)\n    86→\n    87→    def cancel_timer(self) -> None:\n    88→        \"\"\"Cancel any pending debounce timer.\"\"\"\n    89→        with self._lock:\n    90→            if self._timer is not None:\n    91→                self._timer.cancel()\n    92→                self._timer = None\n    93→\n    94→\n    95→def _read_file(path: Path) -> str:\n    96→    try:\n    97→        return path.read_text(encoding=\"utf-8\")\n    98→    except Exception:\n    99→        return \"\"\n   100→\n   101→\n   102→def _detect_diagram_type(path: Path) -> str:\n   103→    \"\"\"Detect Mermaid diagram type from file content.\"\"\"\n   104→    try:\n   105→        content = path.read_text(encoding=\"utf-8\").strip()\n   106→        first_line = content.split(\"\\n\")[0].strip().lower() if content else \"\"\n   107→        for dtype in (\n   108→            \"graph\", \"flowchart\", \"sequencediagram\", \"sequence\",\n   109→            \"classdiagram\", \"class\", \"statediagram\", \"state\",\n   110→            \"erdiagram\", \"er\", \"gantt\", \"pie\", \"gitgraph\",\n   111→            \"c4context\", \"c4container\", \"c4component\", \"c4deployment\",\n   112→            \"mindmap\", \"timeline\",\n   113→        ):\n   114→            if dtype in first_line.replace(\" \", \"\").replace(\"-\", \"\"):\n   115→                return dtype\n   116→        return \"flowchart\"\n   117→    except Exception:\n   118→        return \"flowchart\"\n   119→\n   120→"}]},"parent_tool_use_id":null,"session_id":"5856037d-22b3-414c-9b3a-aae0b154d72e","uuid":"59c6f9d9-826e-4b80-ac34-8a0f1d8e24a7","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/services/diagram_watcher.py","content":"\"\"\"Diagram file watcher using watchdog filesystem events.\n\nUses watchdog's Observer for instant filesystem event detection on Windows\n(ReadDirectoryChangesW) with 100ms debounce to coalesce rapid file saves.\nBroadcasts change events via async queues (same pub-sub pattern as loop_service).\n\nAuto-updates the _arch.json manifest when diagrams are added or removed.\n\"\"\"\n\nimport asyncio\nimport json\nimport logging\nimport threading\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom watchdog.events import FileSystemEvent, FileSystemEventHandler\nfrom watchdog.observers import Observer\n\nlog = logging.getLogger(__name__)\n\n\nclass _DiagramEventHandler(FileSystemEventHandler):\n    \"\"\"Handles filesystem events for .mmd/.drawio files.\"\"\"\n\n    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\n\n    def __init__(self, key: str, arch_dir: Path, watcher: \"DiagramWatcher\"):\n        super().__init__()\n        self.key = key\n        self.arch_dir = arch_dir\n        self.watcher = watcher\n        self._lock = threading.Lock()\n        self._pending: dict[str, tuple[str, str]] = {}  # path -> (event_type, filename)\n        self._timer: Optional[threading.Timer] = None\n\n    def _is_diagram(self, path: str) -> bool:\n        return Path(path).suffix in self.WATCH_EXTENSIONS\n\n    def on_created(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_added\")\n\n    def on_modified(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_changed\")\n\n    def on_deleted(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_removed\")\n\n    def _debounced_notify(self, path: str, event_type: str, delay: float = 0.1):\n        \"\"\"Debounce rapid events (100ms) to coalesce file saves.\"\"\"\n        filename = Path(path).name\n        with self._lock:\n            self._pending[path] = (event_type, filename)\n            if self._timer is not None:\n                self._timer.cancel()\n            self._timer = threading.Timer(delay, self._flush)\n            self._timer.start()\n\n    def _flush(self) -> None:\n        \"\"\"Flush all pending events.\"\"\"\n        with self._lock:\n            pending = dict(self._pending)\n            self._pending.clear()\n            self._timer = None\n\n        manifest_changed = False\n        for path, (event_type, filename) in pending.items():\n            if event_type == \"diagram_removed\":\n                data = {\"file\": filename}\n                manifest_changed = True\n            else:\n                content = _read_file(Path(path))\n                data = {\"file\": filename, \"content\": content}\n                if event_type == \"diagram_added\":\n                    manifest_changed = True\n\n            self.watcher._schedule_broadcast(\n                self.key, {\"event\": event_type, \"data\": data}\n            )\n\n        if manifest_changed:\n            self.watcher._schedule_manifest_update(self.key, self.arch_dir)\n\n    def cancel_timer(self) -> None:\n        \"\"\"Cancel any pending debounce timer.\"\"\"\n        with self._lock:\n            if self._timer is not None:\n                self._timer.cancel()\n                self._timer = None\n\n\ndef _read_file(path: Path) -> str:\n    try:\n        return path.read_text(encoding=\"utf-8\")\n    except Exception:\n        return \"\"\n\n\ndef _detect_diagram_type(path: Path) -> str:\n    \"\"\"Detect Mermaid diagram type from file content.\"\"\"\n    try:\n        content = path.read_text(encoding=\"utf-8\").strip()\n        first_line = content.split(\"\\n\")[0].strip().lower() if content else \"\"\n        for dtype in (\n            \"graph\", \"flowchart\", \"sequencediagram\", \"sequence\",\n            \"classdiagram\", \"class\", \"statediagram\", \"state\",\n            \"erdiagram\", \"er\", \"gantt\", \"pie\", \"gitgraph\",\n            \"c4context\", \"c4container\", \"c4component\", \"c4deployment\",\n            \"mindmap\", \"timeline\",\n        ):\n            if dtype in first_line.replace(\" \", \"\").replace(\"-\", \"\"):\n                return dtype\n        return \"flowchart\"\n    except Exception:\n        return \"flowchart\"\n\n","numLines":120,"startLine":1,"totalLines":268}}}
