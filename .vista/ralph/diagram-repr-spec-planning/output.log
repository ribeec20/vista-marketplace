if (welcome) welcome.style.display = 'none';\n  2080→\n  2081→    const div = document.createElement('div');\n  2082→    div.className = `chat-msg ${role}`;\n  2083→    \n  2084→    if (role === 'assistant') {\n  2085→        div.innerHTML = `\n  2086→            <div class=\"msg-avatar\">\n  2087→                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  2088→                    <path d=\"M12 3c-4.5 0-8 3.5-8 8 0 2.5 1.5 4.5 3 6l-1 4 4-1c1.5.5 3 .5 4.5.5 4.5 0 8-3.5 8-8s-3.5-8-8-8z\"/>\n  2089→                </svg>\n  2090→            </div>\n  2091→            <div class=\"msg-content\">${marked.parse(content)}</div>\n  2092→        `;\n  2093→    } else if (role === 'user') {\n  2094→        div.innerHTML = `<div class=\"msg-bubble\">${escapeHtml(content)}</div>`;\n  2095→    } else if (role === 'error') {\n  2096→        div.innerHTML = `\n  2097→            <div class=\"msg-avatar\" style=\"background: #ef4444;\">\n  2098→                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  2099→                    <path d=\"M12 8v4M12 16h.01\"/>\n  2100→                </svg>\n  2101→            </div>\n  2102→            <div class=\"msg-content\">${escapeHtml(content)}</div>\n  2103→        `;\n  2104→    }\n  2105→    \n  2106→    container.appendChild(div);\n  2107→    if (scroll) container.scrollTop = container.scrollHeight;\n  2108→    return div;\n  2109→}\n  2110→\n  2111→function showThinking() {\n  2112→    hideThinking();\n  2113→    const container = document.getElementById('chat-messages');\n  2114→    const welcome = document.getElementById('chat-welcome');\n  2115→    if (welcome) welcome.style.display = 'none';\n  2116→    \n  2117→    const el = document.createElement('div');\n  2118→    el.className = 'chat-thinking';\n  2119→    el.id = 'thinking-indicator';\n  2120→    el.innerHTML = `\n  2121→        <div class=\"thinking-avatar\">\n  2122→            <svg view