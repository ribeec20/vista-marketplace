px;\n   650→    border-top: 1px solid #2d2d2d;\n   651→    background: #1a1a1a;\n   652→}\n   653→\n   654→.arch-chat-input-wrapper {\n   655→    background: #252525;\n   656→    border: 1px solid #2d2d2d;\n   657→    border-radius: 12px;\n   658→    padding: 12px;\n   659→    transition: border-color 0.15s ease, box-shadow 0.15s ease;\n   660→}\n   661→\n   662→.arch-chat-input-wrapper:focus-within {\n   663→    border-color: #404040;\n   664→    box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.1);\n   665→}\n   666→\n   667→.arch-chat-input-context {\n   668→    display: flex;\n   669→    align-items: center;\n   670→    gap: 8px;\n   671→    margin-bottom: 8px;\n   672→    padding-bottom: 8px;\n   673→    border-bottom: 1px solid #2d2d2d;\n   674→}\n   675→\n   676→.arch-chat-context-badge {\n   677→    display: inline-flex;\n   678→    align-items: center;\n   679→    gap: 6px;\n   680→    padding: 4px 10px;\n   681→    background: #2a2a2a;\n   682→    border-radius: 6px;\n   683→    font-size: 0.75rem;\n   684→    color: #a3a3a3;\n   685→}\n   686→\n   687→.arch-chat-context-badge svg {\n   688→    width: 12px;\n   689→    height: 12px;\n   690→}\n   691→\n   692→.arch-chat-input-area {\n   693→    display: flex;\n   694→    gap: 12px;\n   695→    align-items: flex-end;\n   696→}\n   697→\n   698→.arch-chat-input-area textarea {\n   699→    flex: 1;\n   700→    background: transparent;\n   701→    border: none;\n   702→    color: #f5f5f5;\n   703→    padding: 0;\n   704→    resize: none;\n   705→    font-size: 0.9375rem;\n   706→    line-height: 1.5;\n   707→    min-height: 24px;\n   708→    max-height: 120px;\n   709→    font-family: inherit;\n   710→}\n   711→\n   712→.arch-chat-input-area textarea::placeholder {\n   713→    color: #737373;\n   714→}\n   715→\n   716→.arch-chat-input-area textarea:focus {\n   717→    outline: none;\n   718→}\n   719→\n   720→.arch-chat-input-area textarea:disabled {\n   721→    opacity: 0.5;\n   722→    cursor: not-allowed;\n   723