cted(self, api_env):\r","-        \"\"\"PUT .mmd file returns 400.\"\"\"\r","-\r","-    def test_put_path_traversal_blocked(self, api_env):\r","-        \"\"\"PUT ../../evil.md returns 400.\"\"\"\r","-\r","-    def test_put_project_not_found(self, api_env):\r","-        \"\"\"PUT to nonexistent project returns 404.\"\"\"\r","-\r","-    def test_put_no_arch_directory(self, api_env):\r","-        \"\"\"PUT to feature without arch/ returns 400.\"\"\"\r","-```\r","-\r","-### 5.2 ProgressService Write Tests\r","-\r","-**File:** `vista/tests/test_architecture.py`\r","-\r","-```python\r","-class TestProgressServiceWrite:\r","-    def test_write_arch_file_md_success(self, tmp_path):\r","-        \"\"\"write_arch_file() writes .md content to arch/.\"\"\"\r","-\r","-    def test_write_arch_file_mmd_rejected(self, tmp_path):\r","-        \"\"\"write_arch_file() rejects .mmd files.\"\"\"\r","-\r","-    def test_write_arch_file_path_traversal(self, tmp_path):\r","-        \"\"\"write_arch_file() blocks ../evil path.\"\"\"\r","-\r","-    def test_write_arch_file_no_arch_dir(self, tmp_path):\r","-        \"\"\"write_arch_file() returns False when arch/ doesn't exist.\"\"\"\r","-```\r","-\r","-### 5.3 Schema Validation Tests\r","-\r","-**File:** `vista/tests/test_architecture.py`\r","-\r","-```python\r","-class TestExtendedSchemaValidation:\r","-    def test_arch_schema_accepts_plantuml_type(self):\r","-    def test_arch_schema_accepts_d2_type(self):\r","-    def test_arch_schema_accepts_graphviz_type(self):\r","-    def test_arch_schema_accepts_markdown_type(self):\r","-    def test_arch_schema_rejects_unknown_type(self):\r","-```\r","-\r","-### 5.4 Content-Type Tests\r","-\r","-```python\r","-class TestContentTypes:\r","-    def test_get_puml_returns_text_plain(self, api_env):\r","-    def test_get_d2_returns_text_plain(self, api_env):\r","-    def test_get_dot_returns_text_plain(self, api_env):\r","-    def test_get_md_returns_text_markdown(self, api_env):\r","-```\r","-\r","-##