   665→        margin-bottom: 0;\n   666→    }\n   667→    .msg-content pre {\n   668→        background: #252525;\n   669→        padding: 12px;\n   670→        border-radius: 8px;\n   671→        overflow-x: auto;\n   672→        margin: 12px 0;\n   673→        border: 1px solid #2d2d2d;\n   674→        white-space: pre-wrap;\n   675→        word-wrap: break-word;\n   676→    }\n   677→    .msg-content code {\n   678→        font-family: ui-monospace, monospace;\n   679→        font-size: 0.8125rem;\n   680→    }\n   681→    .msg-content :not(pre) > code {\n   682→        background: rgba(255,255,255,0.1);\n   683→        padding: 2px 6px;\n   684→        border-radius: 4px;\n   685→    }\n   686→    .msg-content ul, .msg-content ol {\n   687→        margin: 12px 0;\n   688→        padding-left: 24px;\n   689→    }\n   690→    .chat-thinking {\n   691→        display: flex;\n   692→        gap: 12px;\n   693→        align-items: flex-start;\n   694→        margin-bottom: 16px;\n   695→    }\n   696→    .thinking-content {\n   697→        display: flex;\n   698→        align-items: center;\n   699→        gap: 8px;\n   700→        padding: 12px 16px;\n   701→        background: #252525;\n   702→        border-radius: 12px;\n   703→        font-size: 0.9375rem;\n   704→        color: #a3a3a3;\n   705→        white-space: nowrap;\n   706→    }\n   707→    .thinking-dots {\n   708→        display: flex;\n   709→        gap: 4px;\n   710→    }\n   711→    .thinking-dot {\n   712→        width: 6px;\n   713→        height: 6px;\n   714→        border-radius: 50%;\n   715→        background: #6366f1;\n   716→        animation: dotBounce 1.4s ease-in-out infinite both;\n   717→    }\n   718→    .thinking-dot:nth-child(1) {\n   719→        animation-delay: -0.32s;\n   720→    }\n   721→    .thinking-dot:nth-child(2) {\n   722→        animation-delay: -0.16s;\n   723→    }\n   724→    @keyframes dotBounce {\n   725→        0%, 80%, 100% { transform: scale(0); }\n   726→        40% { transform: scale(1); }\n   727→    }\n   728→    /* Input */\n   729→    .chat-input-container {\n   730→        padding: 16px;\n   731→        border-top: 1px solid #2d2d2d;\n   732→        background: #1a1a1a;\n   733→    }\n   734→    .chat-input-wrapper {\n   735→        background: #252525;\n   736→        border: 1px solid #2d2d2d;\n   737→        border-radius: 12px;\n   738→        padding: 12px;\n   739→    }\n   740→    .chat-input-wrapper:focus-within {\n   741→        border-color: #404040;\n   742→        box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.1);\n   743→    }\n   744→    .chat-input-context {\n   745→        display: flex;\n   746→        align-items: center;\n   747→        gap: 6px;\n   748→        margin-bottom: 6px;\n   749→    }\n   750→    .chat-context-badge {\n   751→        display: inline-flex;\n   752→        align-items: center;\n   753→        gap: 4px;\n   754→        padding: 2px 8px;\n   755→        background: rgba(37, 99, 235, 0.15);\n   756→        border: 1px solid rgba(37, 99, 235, 0.25);\n   757→        border-radius: 4px;\n   758→        font-size: 0.6875rem;\n   759→        color: #60a5fa;\n   760→    }\n   761→    .chat-context-badge svg {\n   762→        width: 10px;\n   763→        height: 10px;\n   764→    }\n   765→    .chat-input-area {\n   766→        display: flex;\n   767→        gap: 12px;\n   768→        align-items: flex-end;\n   769→    }\n   770→    .chat-input-area textarea {\n   771→        flex: 1;\n   772→        background: transparent;\n   773→        border: none;\n   774→        color: #f5f5f5;\n   775→        padding: 0;\n   776→        resize: none;\n   777→        font-size: 0.9375rem;\n   778→        line-height: 1.5;\n   779→        min-height: 24px;\n   780→        max-height: 120px;\n   781→        font-family: inherit;\n   782→    }\n   783→    .chat-input-area textarea::placeholder {\n   784→        color: #737373;\n   785→    }\n   786→    .chat-input-area textarea:focus {\n   787→        outline: none;\n   788→    }\n   789→    .chat-input-actions {\n   790→        display: flex;\n   791→        align-items: center;\n   792→        gap: 8px;\n   793→    }\n   794→    .chat-input-btn {\n   795→        width: 32px;\n   796→        height: 32px;\n   797→        border-radius: 8px;\n   798→        background: transparent;\n   799→        border: none;\n   800→        color: #737373;\n   801→        cursor: pointer;\n   802→        display: flex;\n   803→        align-items: center;\n   804→        justify-content: center;\n   805→    }\n   806→    .chat-input-btn:hover {\n   807→        background: #2d2d2d;\n   808→        color: #a3a3a3;\n   809→    }\n   810→    .chat-send-btn {\n   811→        width: 32px;\n   812→        height: 32px;\n   813→        border-radius: 8px;\n   814→        background: #2563eb;\n   815→        border: none;\n   816→        color: white;\n   817→        cursor: pointer;\n   818→        display: flex;\n   819→        align-items: center;\n   820→        justify-content: center;\n   821→    }\n   822→    .chat-send-btn:hover {\n   823→        background: #3b82f6;\n   824→    }\n   825→    .chat-send-btn:disabled {\n   826→        opacity: 0.3;\n   827→        cursor: not-allowed;\n   828→    }\n   829→    .diagram-updating {\n   830→        animation: pulse-border 1s ease-in-out;\n   831→    }\n   832→    @keyframes pulse-border {\n   833→        0% { border-color: #22c55e; box-shadow: 0 0 0 2px rgba(34,197,94,0.3); }\n   834→        100% { border-color: #334155; box-shadow: none; }\n   835→    }\n   836→    .chat-thinking {\n   837→        display: flex;\n   838→        align-items: center;\n   839→        gap: 8px;\n   840→        padding: 10px 14px;\n   841→        margin-bottom: 12px;\n   842→        margin-right: 20%;\n   843→        border-radius: 6px;\n   844→        background: #1a2332;\n   845→        color: #94a3b8;\n   846→        font-size: 0.8rem;\n   847→    }\n   848→    .chat-thinking .thinking-icon {\n   849→        color: #f97316;\n   850→        font-size: 0.75rem;\n   851→        animation: thinking-pulse 1.5s ease-in-out infinite;\n   852→    }\n   853→    .chat-thinking .thinking-text {\n   854→        animation: thinking-fade 2s ease-in-out infinite;\n   855→    }\n   856→    @keyframes thinking-pulse {\n   857→        0%, 100% { opacity: 0.4; transform: scale(0.9); }\n   858→        50% { opacity: 1; transform: scale(1.1); }\n   859→    }\n   860→    @keyframes thinking-fade {\n   861→        0%, 100% { opacity: 0.5; }\n   862→        50% { opacity: 1; }\n   863→    }\n   864→    .chat-msg.user.sent-flash {\n   865→        animation: sent-confirm 0.4s ease-out;\n   866→    }\n   867→    @keyframes sent-confirm {\n   868→        0% { opacity: 0.5; transform: translateY(4px); }\n   869→        100% { opacity: 1; transform: translateY(0); }\n   870→    }\n   871→    .diagram-theme-toggle {\n   872→        position: relative;\n   873→        display: inline-flex;\n   874→        align-items: center;\n   875→        gap: 4px;\n   876→        background: #334155;\n   877→        border-radius: 6px;\n   878→        padding: 2px;\n   879→        cursor: pointer;\n   880→    }\n   881→    .diagram-theme-toggle button {\n   882→        background: transparent;\n   883→        border: none;\n   884→        color: #94a3b8;\n   885→        padding: 4px 8px;\n   886→        border-radius: 4px;\n   887→        font-size: 0.7rem;\n   888→        cursor: pointer;\n   889→        transition: all 0.2s;\n   890→    }\n   891→    .diagram-theme-toggle button.active {\n   892→        background: #1e293b;\n   893→        color: #e2e8f0;\n   894→        box-shadow: 0 1px 2px rgba(0,0,0,0.3);\n   895→    }\n   896→    .diagram-theme-toggle button:hover:not(.active) {\n   897→        color: #e2e8f0;\n   898→    }\n   899→    .theme-icon {\n   900→        font-size: 0.8rem;\n   901→    }\n   902→    /* Selected node highlight */\n   903→    .node-selected > rect,\n   904→    .node-selected > polygon,\n   905→    .node-selected > circle,\n   906→    .node-selected > ellipse {\n   907→        stroke: #f59e0b !important;\n   908→        stroke-width: 3px !important;\n   909→        filter: drop-shadow(0 0 4px rgba(245, 158, 11, 0.5));\n   910→    }\n   911→    .node-selected {\n   912→        cursor: pointer;\n   913→    }\n   914→    .selected-elements-bar {\n   915→        padding: 6px 16px;\n   916→        font-size: 0.75rem;\n   917→        color: #fbbf24;\n   918→        border-bottom: 1px solid #334155;\n   919→        display: flex;\n   920→        align-items: center;\n   921→        gap: 6px;\n   922→        flex-wrap: wrap;\n   923→    }\n   924→    .selected-elements-bar .sel-chip {\n   925→        background: #422006;\n   926→        color: #fbbf24;\n   927→        padding: 1px 8px;\n   928→        border-radius: 10px;\n   929→        font-size: 0.65rem;\n   930→        font-weight: 600;\n   931→    }\n   932→    .selected-elements-bar .sel-clear {\n   933→        background: none;\n   934→        border: 1px solid #854d0e;\n   935→        color: #fbbf24;\n   936→        padding: 1px 6px;\n   937→        border-radius: 4px;\n   938→        font-size: 0.6rem;\n   939→        cursor: pointer;\n   940→        margin-left: auto;\n   941→    }\n   942→    .selected-elements-bar .sel-clear:hover {\n   943→        background: #854d0e;\n   944→    }\n   945→    .diagram-expand-btn {\n   946→        width: 28px;\n   947→        height: 28px;\n   948→        border-radius: 4px;\n   949→        background: #334155;\n   950→        color: #e2e8f0;\n   951→        border: 1px solid #475569;\n   952→        cursor: pointer;\n   953→        font-size: 0.8rem;\n   954→        display: flex;\n   955→        align-items: center;\n   956→        justify-content: center;\n   957→        opacity: 0.7;\n   958→        transition: opacity 0.2s;\n   959→        text-decoration: none;\n   960→    }\n   961→    .diagram-expand-btn:hover {\n   962→        opacity: 1;\n   963→        background: #475569;\n   964→        color: #e2e8f0;\n   965→    }\n   966→</style>\n   967→{% endblock %}\n   968→\n   969→{% block content %}\n   970→<!-- Header -->\n   971→<div class=\"mb-6\">\n   972→    <div class=\"flex items-center gap-3 mb-2\">\n   973→        <a href=\"/\" class=\"text-gray-400 hover:text-gray-300\">&larr; Dashboard</a>\n   974→        <span class=\"text-gray-600\">/</span>\n   975→        <a href=\"/project/{{ project.id }}\" class=\"text-gray-400 hover:text-gray-300\">{{ project.name }}</a>\n   976→        <span class=\"text-gray-600\">/</span>\n   977→        <h1 class=\"text-2xl font-bold\">{{ feature_name }}</h1>\n   978→        <span class=\"text-gray-500 text-sm ml-2\">Architecture</span>\n   979→    </div>\n   980→    {% if manifest %}\n   981→    <p class=\"text-gray-400 text-sm\">\n   982→        {{ manifest.diagrams|length }} diagram{{ 's' if manifest.diagrams|length != 1 else '' }}\n   983→        {% set tdd_count = manifest.diagrams|selectattr('category', 'equalto', 'tdd')|list|length %}\n   984→        {% if tdd_count > 0 %}\n   985→        ({{ tdd_count }} TDD)\n   986→        {% endif %}\n   987→        &mdash; click a diagram to attach it to chat\n   988→    </p>\n   989→    {% endif %}\n   990→</div>\n   991→\n   992→{% if not manifest or not manifest.diagrams %}\n   993→<div class=\"bg-gray-800 rounded-lg border border-gray-700 p-8 text-center\">\n   994→    <p class=\"text-gray-400\">No architecture diagrams found.</p>\n   995→    <p class=\"text-gray-500 text-sm mt-2\">Run <code class=\"text-green-400\">/vista:plan {{ feature_name }}</code> to generate architecture diagrams.</p>\n   996→</div>\n   997→{% else %}\n   998→\n   999→<!-- Diagram Grid -->\n  1000→<div class=\"space-y-6\" id=\"diagram-grid\">\n  1001→    {% for diagram in manifest.diagrams %}\n  1002→    <div class=\"diagram-card {{ 'tdd' if diagram.category == 'tdd' else '' }}\"\n  1003→         data-diagram-file=\"{{ diagram.file }}\"\n  1004→         onclick=\"toggleContext('{{ diagram.file }}', {{ loop.index }})\">\n  1005→        <div class=\"diagram-header\">\n  1006→            <div class=\"flex items-center gap-2 flex-1 min-w-0\">\n  1007→                <span class=\"font-semibold text-sm truncate\">{{ diagram.name }}</span>\n  1008→                <span class=\"badge {{ 'badge-tdd' if diagram.category == 'tdd' else 'badge-arch' }}\">\n  1009→                    {{ diagram.category or 'architecture' }}\n  1010→                </span>\n  1011→                {% if diagram.description %}\n  1012→                <span class=\"text-gray-500 text-xs truncate hidden sm:inline\">{{ diagram.description }}</span>\n  1013→                {% endif %}\n  1014→            </div>\n  1015→            <div class=\"flex items-center gap-2\">\n  1016→                <div class=\"diagram-theme-toggle\" id=\"theme-toggle-{{ loop.index }}\" onclick=\"event.stopPropagation()\">\n  1017→                    <button class=\"active\" data-theme=\"dark\" onclick=\"setDiagramTheme({{ loop.index }}, 'dark')\">\n  1018→                        <span class=\"theme-icon\">&#9790;</span>\n  1019→                    </button>\n  1020→                    <button data-theme=\"light\" onclick=\"setDiagramTheme({{ loop.index }}, 'light')\">\n  1021→                        <span class=\"theme-icon\">&#9788;</span>\n  1022→                    </button>\n  1023→                </div>\n  1024→                <span class=\"attach-indicator off\" id=\"ctx-{{ loop.index }}\">click to attach</span>\n  1025→            </div>\n  1026→        </div>\n  1027→        <div class=\"diagram-body\" onclick=\"event.stopPropagation()\">\n  1028→            <div class=\"diagram-viewport\" id=\"viewport-{{ loop.index }}\">\n  1029→                <div class=\"mermaid\" id=\"mermaid-{{ loop.index }}\">\n  1030→                    Loading...\n  1031→                </div>\n  1032→            </div>\n  1033→            <div class=\"diagram-zoom-controls\">\n  1034→                <button onclick=\"zoomDiagram({{ loop.index }}, -0.2)\" title=\"Zoom out\">&minus;</button>\n  1035→                <button onclick=\"resetZoom({{ loop.index }})\" title=\"Reset zoom\">1:1</button>\n  1036→                <button onclick=\"zoomDiagram({{ loop.index }}, 0.2)\" title=\"Zoom in\">+</button>\n  1037→                <a class=\"diagram-expand-btn\"\n  1038→                   href=\"/project/{{ project.id }}/arch/{{ feature_name }}/diagram/{{ diagram.file }}\"\n  1039→                   target=\"_blank\"\n  1040→                   title=\"Open full-page view\">&#x26F6;</a>\n  1041→            </div>\n  1042→        </div>\n  1043→    </div>\n  1044→    {% endfor %}\n  1045→</div>\n  1046→{% endif %}\n  1047→\n  1048→<!-- Chat Toggle Button -->\n  1049→<button class=\"chat-toggle\" id=\"chat-fab\" onclick=\"toggleChat()\" title=\"Open AI Chat\">\n  1050→    &#x1f4ac;\n  1051→</button>\n  1052→\n  1053→<!-- Chat Panel -->\n  1054→<div class=\"chat-panel\" id=\"chat-panel\">\n  1055→    <!-- Header -->\n  1056→    <div class=\"chat-header\">\n  1057→        <div class=\"chat-header-left\">\n  1058→            <button class=\"chat-header-dropdown\" onclick=\"toggleSessionPopup()\">\n  1059→                <span id=\"current-session-name\">New AI chat</span>\n  1060→                <svg viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M4 6l4 4 4-4\"/></svg>\n  1061→            </button>\n  1062→        </div>\n  1063→        <div class=\"chat-header-actions\">\n  1064→            <div class=\"window-size-controls\">\n  1065→                <button class=\"size-btn\" onclick=\"setWindowHeight(40)\" title=\"40% height\">S</button>\n  1066→                <button class=\"size-btn active\" onclick=\"setWindowHeight(60)\" title=\"60% height\">M</button>\n  1067→                <button class=\"size-btn\" onclick=\"setWindowHeight(90)\" title=\"90% height\">L</button>\n  1068→            </div>\n  1069→            <button class=\"chat-header-btn lock-btn locked\" id=\"lock-btn\" onclick=\"toggleLock()\" title=\"Unlock window\">\n  1070→                <svg class=\"lock-icon\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"7\" width=\"10\" height=\"7\" rx=\"1\"/><path d=\"M5 7V5a3 3 0 0 1 6 0v2\"/></svg>\n  1071→                <svg class=\"unlock-icon\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"7\" width=\"10\" height=\"7\" rx=\"1\"/><path d=\"M5 7V5a3 3 0 0 1 6 0\"/></svg>\n  1072→            </button>\n  1073→            <button class=\"chat-header-btn\" onclick=\"createNewSession()\" title=\"New session\">\n  1074→                <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M8 3v10M3 8h10\"/></svg>\n  1075→            </button>\n  1076→            <button class=\"chat-header-btn\" onclick=\"toggleChat()\" title=\"Close\">\n  1077→                <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 4l8 8M12 4l-8 8\"/></svg>\n  1078→            </button>\n  1079→        </div>\n  1080→    </div>\n  1081→    \n  1082→    <!-- Session Popup -->\n  1083→    <div class=\"session-popup\" id=\"session-popup\">\n  1084→        <div class=\"session-popup-header\">\n  1085→            <span class=\"session-popup-title\">Chat Sessions</span>\n  1086→            <button class=\"session-new-btn\" onclick=\"createNewSession(); toggleSessionPopup();\">\n  1087→                <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M8 3v10M3 8h10\"/></svg>\n  1088→                New\n  1089→            </button>\n  1090→        </div>\n  1091→        <div class=\"session-list\" id=\"session-list\">\n  1092→            <!-- Sessions injected here -->\n  1093→        </div>\n  1094→    </div>\n  1095→\n  1096→    <!-- Provider / Model Config -->\n  1097→    <div class=\"chat-config-bar\">\n  1098→        {% if providers|length > 1 %}\n  1099→        <select id=\"chat-provider\" class=\"chat-config-select\" onchange=\"onProviderChange()\">\n  1100→            {% for p in providers %}\n  1101→            <option value=\"{{ p.name }}\">{{ p.display_name }}</option>\n  1102→            {% endfor %}\n  1103→        </select>\n  1104→        {% else %}\n  1105→        <input type=\"hidden\" id=\"chat-provider\" value=\"{{ providers[0].name if providers else 'claude' }}\">\n  1106→        {% endif %}\n  1107→        <select id=\"chat-model\" class=\"chat-config-select\">\n  1108→            <option disabled selected>Loading models...</option>\n  1109→        </select>\n  1110→    </div>\n  1111→\n  1112→    <!-- Service Status -->\n  1113→    <div class=\"service-status-bar\">\n  1114→        <div class=\"service-indicator\">\n  1115→            <span class=\"service-dot\" id=\"status-companion\"></span>\n  1116→            <span>Claude</span>\n  1117→        </div>\n  1118→        <div class=\"service-indicator\">\n  1119→            <span class=\"service-dot\" id=\"status-opencode\"></span>\n  1120→            <span>OpenCode</span>\n  1121→        </div>\n  1122→    </div>\n  1123→\n  1124→    <!-- Attached Context & Selected Elements - Combined compact bar -->\n  1125→    <div class=\"attached-context-bar\" id=\"attached-context\" style=\"display: none;\">\n  1126→        <span class=\"attached-context-label\">Attached:</span>\n  1127→        <div class=\"attached-context-list\" id=\"attached-list\"></div>\n  1128→    </div>\n  1129→\n  1130→    <div class=\"selected-elements-bar\" id=\"selected-elements-bar\" style=\"display: none;\">\n  1131→        <span class=\"selected-elements-label\">Focus:</span>\n  1132→        <div class=\"selected-elements-list\" id=\"selected-elements-list\"></div>\n  1133→        <button class=\"selected-clear-btn\" onclick=\"clearAllSelections()\">Clear</button>\n  1134→    </div>\n  1135→\n  1136→    <!-- Messages area -->\n  1137→    <div class=\"chat-messages\" id=\"chat-messages\">\n  1138→        <!-- Welcome State -->\n  1139→        <div class=\"chat-welcome\" id=\"chat-welcome\">\n  1140→            <div class=\"chat-welcome-avatar\">\n  1141→                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1142→                    <path d=\"M12 3c-4.5 0-8 3.5-8 8 0 2.5 1.5 4.5 3 6l-1 4 4-1c1.5.5 3 .5 4.5.5 4.5 0 8-3.5 8-8s-3.5-8-8-8z\"/>\n  1143→                    <path d=\"M12 8v4M12 16h.01\"/>\n  1144→                </svg>\n  1145→            </div>\n  1146→            <div class=\"chat-welcome-title\">How can I help you today?</div>\n  1147→            <div class=\"chat-suggestions\">\n  1148→                <div class=\"chat-suggestion\" onclick=\"setInput('Review the architecture diagrams for improvements')\">\n  1149→                    <svg class=\"chat-suggestion-icon\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1150→                        <path d=\"M8 1v14M1 8h14\"/>\n  1151→                    </svg>\n  1152→                    <span class=\"chat-suggestion-text\">Review architecture diagrams</span>\n  1153→                </div>\n  1154→                <div class=\"chat-suggestion\" onclick=\"setInput('Suggest improvements to the data flow')\">\n  1155→                    <svg class=\"chat-suggestion-icon\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1156→                        <path d=\"M2 8l4-4 4 4 4-4M2 12l4-4 4 4 4-4\"/>\n  1157→                    </svg>\n  1158→                    <span class=\"chat-suggestion-text\">Suggest data flow improvements</span>\n  1159→                </div>\n  1160→                <div class=\"chat-suggestion\" onclick=\"setInput('What are the key components in these diagrams?')\">\n  1161→                    <svg class=\"chat-suggestion-icon\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1162→                        <circle cx=\"8\" cy=\"8\" r=\"6\"/>\n  1163→                        <path d=\"M8 5v3l2 2\"/>\n  1164→                    </svg>\n  1165→                    <span class=\"chat-suggestion-text\">Explain key components</span>\n  1166→                </div>\n  1167→                <div class=\"chat-suggestion\" onclick=\"setInput('Are there any missing connections in the architecture?')\">\n  1168→                    <svg class=\"chat-suggestion-icon\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1169→                        <path d=\"M4 8h8M8 4v8\"/>\n  1170→                    </svg>\n  1171→                    <span class=\"chat-suggestion-text\">Find missing connections</span>\n  1172→                </div>\n  1173→            </div>\n  1174→        </div>\n  1175→    </div>\n  1176→\n  1177→    <!-- Input Container -->\n  1178→    <div class=\"chat-input-container\">\n  1179→        <div class=\"chat-input-wrapper\">\n  1180→            <div class=\"chat-input-context\" id=\"input-context\" style=\"display: none;\">\n  1181→                <span class=\"chat-context-badge\">\n  1182→                    <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n  1183→                        <path d=\"M2 4h12M2 8h12M2 12h12\"/>\n  1184→                    </svg>\n  1185→                    <span id=\"context-count\">0 diagrams attached</span>\n  1186→                </span>\n  1187→            </div>\n  1188→            <div class=\"chat-input-area\">\n  1189→                <textarea id=\"chat-input\" rows=\"1\" placeholder=\"Ask about the architecture...\" disabled></textarea>\n  1190→                <div class=\"chat-input-actions\">\n  1191→                    <button class=\"chat-input-btn\" id=\"cancel-btn\" onclick=\"cancelChat()\" style=\"display: none;\" title=\"Cancel\">\n  1192→                        <svg viewBox=\"0 0 16 16\" fill=\"currentColor\"><rect x=\"3\" y=\"3\" width=\"10\" height=\"10\" rx=\"2\"/></svg>\n  1193→                    </button>\n  1194→                    <button class=\"chat-send-btn\" id=\"chat-send-btn\" onclick=\"sendChat()\" disabled title=\"Send\">\n  1195→                        <svg viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M2 8l12-6v12L2 8z\"/></svg>\n  1196→                    </button>\n  1197→                </div>\n  1198→            </div>\n  1199→        </div>\n  1200→    </div>\n  1201→</div>\n  1202→{% endblock %}\n  1203→\n  1204→{% block scripts %}\n  1205→<script>\n  1206→const PROJECT_ID = '{{ project.id }}';\n  1207→const FEATURE_NAME = '{{ feature_name }}';\n  1208→const DIAGRAMS = {{ manifest.diagrams | tojson if manifest and manifest.diagrams else '[]' }};\n  1209→const PROVIDERS = {{ providers | tojson }};\n  1210→\n  1211→// --- State ---\n  1212→const attachedDiagrams = new Set();\n  1213→const selectedElements = new Map(); // Map<filename, Set<nodeId>>\n  1214→const diagramContents = {};\n  1215→const viewportState = {};\n  1216→let currentSessionId = null;\n  1217→let eventSource = null;\n  1218→let isStreaming = false;\n  1219→let streamingMsgEl = null;\n  1220→let streamingText = '';\n  1221→let mermaidCounter = DIAGRAMS.length + 100; // for dynamic re-renders\n  1222→\n  1223→// --- Mermaid init ---\n  1224→mermaid.initialize({\n  1225→    startOnLoad: false,\n  1226→    theme: 'dark',\n  1227→    themeVariables: {\n  1228→        darkMode: true,\n  1229→        background: '#0f172a',\n  1230→        primaryColor: '#1e3a5f',\n  1231→        primaryTextColor: '#e2e8f0',\n  1232→        primaryBorderColor: '#475569',\n  1233→        lineColor: '#94a3b8',\n  1234→        secondaryColor: '#1a2332',\n  1235→        tertiaryColor: '#0f172a',\n  1236→        fontSize: '14px',\n  1237→    }\n  1238→});\n  1239→\n  1240→const lightThemeVariables = {\n  1241→    background: '#ffffff',\n  1242→    primaryColor: '#dbeafe',\n  1243→    primaryTextColor: '#1e293b',\n  1244→    primaryBorderColor: '#94a3b8',\n  1245→    lineColor: '#475569',\n  1246→    secondaryColor: '#f8fafc',\n  1247→    tertiaryColor: '#f1f5f9',\n  1248→    fontSize: '14px',\n  1249→};\n  1250→\n  1251→const darkThemeVariables = {\n  1252→    darkMode: true,\n  1253→    background: '#0f172a',\n  1254→    primaryColor: '#1e3a5f',\n  1255→    primaryTextColor: '#e2e8f0',\n  1256→    primaryBorderColor: '#475569',\n  1257→    lineColor: '#94a3b8',\n  1258→    secondaryColor: '#1a2332',\n  1259→    tertiaryColor: '#0f172a',\n  1260→    fontSize: '14px',\n  1261→};\n  1262→\n  1263→// --- Marked config for assistant messages ---\n  1264→marked.setOptions({ breaks: true, gfm: true });\n  1265→\n  1266→// =========================================================================\n  1267→// Diagram loading & rendering\n  1268→// =========================================================================\n  1269→\n  1270→async function loadDiagrams() {\n  1271→    for (let i = 0; i < DIAGRAMS.length; i++) {\n  1272→        const diagram = DIAGRAMS[i];\n  1273→        const el = document.getElementById(`mermaid-${i + 1}`);\n  1274→        if (!el) continue;\n  1275→        try {\n  1276→            const resp = await fetch(`/api/projects/${PROJECT_ID}/features/${FEATURE_NAME}/arch/${diagram.file}`);\n  1277→            if (!resp.ok) throw new Error('Failed to load');\n  1278→            const content = await resp.text();\n  1279→            diagramContents[diagram.file] = content;\n  1280→            await renderDiagramContent(el, diagram.file, content, i + 1);\n  1281→            initViewport(i + 1);\n  1282→        } catch (err) {\n  1283→            el.innerHTML = `<span class=\"text-red-400 text-sm\">Failed to load ${diagram.file}</span>`;\n  1284→        }\n  1285→    }\n  1286→}\n  1287→\n  1288→async function renderDiagramContent(el, filename, content, idx) {\n  1289→    if (filename.endsWith('.mmd')) {\n  1290→        try {\n  1291→            const id = `mermaid-svg-${idx}-${++mermaidCounter}`;\n  1292→            const { svg } = await mermaid.render(id, content);\n  1293→            el.innerHTML = svg;\n  1294→            // Add click handlers on nodes for element selection\n  1295→            el.querySelectorAll('.node').forEach(node => {\n  1296→                node.style.cursor = 'pointer';\n  1297→                node.addEventListener('click', (e) => {\n  1298→                    e.stopPropagation();\n  1299→                    const nodeId = extractNodeId(node.id, node);\n  1300→                    if (nodeId) toggleElementSelection(filename, nodeId, node);\n  1301→                });\n  1302→            });\n  1303→            // Re-apply any existing selections\n  1304→            reapplySelections(el, filename);\n  1305→        } catch (e) {\n  1306→            el.innerHTML = `<pre class=\"text-yellow-400 text-xs whitespace-pre-wrap\">Mermaid parse error:\\n${e.message || e}\\n\\n${content}</pre>`;\n  1307→        }\n  1308→    } else {\n  1309→        el.innerHTML = `<pre class=\"text-gray-400 text-xs whitespace-pre-wrap\">${escapeHtml(content)}</pre>`;\n  1310→    }\n  1311→}\n  1312→\n  1313→function escapeHtml(str) {\n  1314→    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n  1315→}\n  1316→\n  1317→loadDiagrams();\n  1318→\n  1319→// =========================================================================\n  1320→// Pan & Zoom\n  1321→// =========================================================================\n  1322→\n  1323→function initViewport(idx) {\n  1324→    const vp = document.getElementById(`viewport-${idx}`);\n  1325→    if (!vp) return;\n  1326→    viewportState[idx] = { scale: 1, panX: 0, panY: 0, dragging: false, startX: 0, startY: 0 };\n  1327→    vp.addEventListener('wheel', (e) => {\n  1328→        e.preventDefault();\n  1329→        const delta = e.deltaY > 0 ? -0.1 : 0.1;\n  1330→        zoomDiagram(idx, delta);\n  1331→    }, { passive: false });\n  1332→    vp.addEventListener('mousedown', (e) => {\n  1333→        if (e.button !== 0) return;\n  1334→        const st = viewportState[idx];\n  1335→        st.dragging = true;\n  1336→        st.startX = e.clientX - st.panX;\n  1337→        st.startY = e.clientY - st.panY;\n  1338→        vp.style.cursor = 'grabbing';\n  1339→    });\n  1340→    vp.addEventListener('mousemove', (e) => {\n  1341→        const st = viewportState[idx];\n  1342→        if (!st.dragging) return;\n  1343→        st.panX = e.clientX - st.startX;\n  1344→        st.panY = e.clientY - st.startY;\n  1345→        applyTransform(idx);\n  1346→    });\n  1347→    const stopDrag = () => {\n  1348→        const st = viewportState[idx];\n  1349→        if (st) st.dragging = false;\n  1350→        vp.style.cursor = 'grab';\n  1351→    };\n  1352→    vp.addEventListener('mouseup', stopDrag);\n  1353→    vp.addEventListener('mouseleave', stopDrag);\n  1354→}\n  1355→\n  1356→function applyTransform(idx) {\n  1357→    const vp = document.getElementById(`viewport-${idx}`);\n  1358→    const st = viewportState[idx];\n  1359→    if (!vp || !st) return;\n  1360→    vp.style.transform = `translate(${st.panX}px, ${st.panY}px) scale(${st.scale})`;\n  1361→}\n  1362→\n  1363→function zoomDiagram(idx, delta) {\n  1364→    const st = viewportState[idx];\n  1365→    if (!st) return;\n  1366→    st.scale = Math.max(0.3, Math.min(3, st.scale + delta));\n  1367→    applyTransform(idx);\n  1368→}\n  1369→\n  1370→function resetZoom(idx) {\n  1371→    const st = viewportState[idx];\n  1372→    if (!st) return;\n  1373→    st.scale = 1; st.panX = 0; st.panY = 0;\n  1374→    applyTransform(idx);\n  1375→}\n  1376→\n  1377→// =========================================================================\n  1378→// Chat panel toggle\n  1379→// =========================================================================\n  1380→\n  1381→function toggleChat() {\n  1382→    const panel = document.getElementById('chat-panel');\n  1383→    const fab = document.getElementById('chat-fab');\n  1384→    panel.classList.toggle('open');\n  1385→    const isOpen = panel.classList.contains('open');\n  1386→    fab.classList.toggle('hidden-fab', isOpen);\n  1387→    if (isOpen && !currentSessionId) {\n  1388→        loadSessions();\n  1389→    }\n  1390→    if (isOpen && !panel.dataset.dragInitialized) {\n  1391→        initDragPanel();\n  1392→        panel.dataset.dragInitialized = 'true';\n  1393→    }\n  1394→}\n  1395→\n  1396→// =========================================================================\n  1397→// Draggable Panel\n  1398→// =========================================================================\n  1399→\n  1400→let isPanelLocked = true;\n  1401→let currentHeightPercentage = 60; // Default to 60%\n  1402→\n  1403→function initDragPanel() {\n  1404→    const panel = document.getElementById('chat-panel');\n  1405→    const header = panel.querySelector('.chat-header');\n  1406→    \n  1407→    let isDragging = false;\n  1408→    let startX, startY, initialLeft, initialTop;\n  1409→    \n  1410→    header.addEventListener('mousedown', function(e) {\n  1411→        // Don't drag if locked or clicking on buttons\n  1412→        if (isPanelLocked || e.target.closest('button') || e.target.closest('.chat-header-dropdown')) {\n  1413→            return;\n  1414→        }\n  1415→        \n  1416→        isDragging = true;\n  1417→        panel.classList.add('dragging');\n  1418→        \n  1419→        // Get mouse position relative to the panel\n  1420→        const rect = panel.getBoundingClientRect();\n  1421→        startX = e.clientX;\n  1422→        startY = e.clientY;\n  1423→        initialLeft = rect.left;\n  1424→        initialTop = rect.top;\n  1425→        \n  1426→        // Remove right/bottom positioning and set explicit left/top\n  1427→        panel.style.right = 'auto';\n  1428→        panel.style.bottom = 'auto';\n  1429→        panel.style.left = initialLeft + 'px';\n  1430→        panel.style.top = initialTop + 'px';\n  1431→        \n  1432→        e.preventDefault();\n  1433→    });\n  1434→    \n  1435→    document.addEventListener('mousemove', function(e) {\n  1436→        if (!isDragging) return;\n  1437→        \n  1438→        const deltaX = e.clientX - startX;\n  1439→        const deltaY = e.clientY - startY;\n  1440→        \n  1441→        let newLeft = initialLeft + deltaX;\n  1442→        let newTop = initialTop + deltaY;\n  1443→        \n  1444→        // Constrain to viewport\n  1445→        const panelRect = panel.getBoundingClientRect();\n  1446→        const maxLeft = window.innerWidth - panelRect.width;\n  1447→        const maxTop = window.innerHeight - panelRect.height;\n  1448→        \n  1449→        newLeft = Math.max(0, Math.min(newLeft, maxLeft));\n  1450→        newTop = Math.max(0, Math.min(newTop, maxTop));\n  1451→        \n  1452→        panel.style.left = newLeft + 'px';\n  1453→        panel.style.top = newTop + 'px';\n  1454→    });\n  1455→    \n  1456→    document.addEventListener('mouseup', function() {\n  1457→        if (isDragging) {\n  1458→            isDragging = false;\n  1459→            panel.classList.remove('dragging');\n  1460→        }\n  1461→    });\n  1462→}\n  1463→\n  1464→// =========================================================================\n  1465→// Window Resize Handler\n  1466→// =========================================================================\n  1467→\n  1468→window.addEventListener('resize', function() {\n  1469→    const panel = document.getElementById('chat-panel');\n  1470→    if (!panel || !panel.classList.contains('open')) return;\n  1471→    \n  1472→    const viewportWidth = window.innerWidth;\n  1473→    const viewportHeight = window.innerHeight;\n  1474→    const panelRect = panel.getBoundingClientRect();\n  1475→    \n  1476→    // Auto-scale height to maintain percentage of viewport\n  1477→    const newHeight = Math.floor((viewportHeight * currentHeightPercentage) / 100);\n  1478→    const minHeight = 400;\n  1479→    const maxHeight = viewportHeight - 100;\n  1480→    const finalHeight = Math.max(minHeight, Math.min(newHeight, maxHeight));\n  1481→    \n  1482→    panel.style.height = finalHeight + 'px';\n  1483→    panel.style.maxHeight = finalHeight + 'px';\n  1484→    \n  1485→    // Ensure panel doesn't exceed viewport width\n  1486→    const maxWidth = viewportWidth - 48;\n  1487→    if (parseInt(panel.style.width) > maxWidth) {\n  1488→        panel.style.width = maxWidth + 'px';\n  1489→    }\n  1490→    \n  1491→    if (isPanelLocked) {\n  1492→        // When locked, keep it at bottom-right\n  1493→        panel.style.left = 'auto';\n  1494→        panel.style.top = 'auto';\n  1495→        panel.style.right = '24px';\n  1496→        panel.style.bottom = '24px';\n  1497→    } else {\n  1498→        // When unlocked, ensure panel stays within viewport bounds\n  1499→        let currentLeft = parseInt(panel.style.left) || panelRect.left;\n  1500→        let currentTop = parseInt(panel.style.top) || panelRect.top;\n  1501→        \n  1502→        const maxLeft = viewportWidth - panelRect.width;\n  1503→        const maxTop = viewportHeight - panelRect.height;\n  1504→        \n  1505→        // Constrain to viewport\n  1506→        if (currentLeft < 0) currentLeft = 0;\n  1507→        if (currentTop < 0) currentTop = 0;\n  1508→        if (currentLeft > maxLeft) currentLeft = maxLeft;\n  1509→        if (currentTop > maxTop) currentTop = maxTop;\n  1510→        \n  1511→        panel.style.left = currentLeft + 'px';\n  1512→        panel.style.top = currentTop + 'px';\n  1513→        panel.style.right = 'auto';\n  1514→        panel.style.bottom = 'auto';\n  1515→    }\n  1516→});\n  1517→\n  1518→function toggleLock() {\n  1519→    const panel = document.getElementById('chat-panel');\n  1520→    const lockBtn = document.getElementById('lock-btn');\n  1521→    \n  1522→    isPanelLocked = !isPanelLocked;\n  1523→    \n  1524→    if (isPanelLocked) {\n  1525→        panel.classList.add('locked');\n  1526→        lockBtn.classList.add('locked');\n  1527→        lockBtn.title = 'Unlock window';\n  1528→        \n  1529→        // Snap back to bottom-right\n  1530→        panel.style.left = 'auto';\n  1531→        panel.style.top = 'auto';\n  1532→        panel.style.right = '24px';\n  1533→        panel.style.bottom = '24px';\n  1534→    } else {\n  1535→        panel.classList.remove('locked');\n  1536→        lockBtn.classList.remove('locked');\n  1537→        lockBtn.title = 'Lock window';\n  1538→    }\n  1539→}\n  1540→\n  1541→// =========================================================================\n  1542→// Window Size Controls\n  1543→// =========================================================================\n  1544→\n  1545→function setWindowHeight(percentage) {\n  1546→    currentHeightPercentage = percentage;\n  1547→    const panel = document.getElementById('chat-panel');\n  1548→    const viewportHeight = window.innerHeight;\n  1549→    const newHeight = Math.floor((viewportHeight * percentage) / 100);\n  1550→    \n  1551→    // Set minimum and maximum constraints\n  1552→    const minHeight = 400;\n  1553→    const maxHeight = viewportHeight - 100;\n  1554→    const finalHeight = Math.max(minHeight, Math.min(newHeight, maxHeight));\n  1555→    \n  1556→    panel.style.height = finalHeight + 'px';\n  1557→    panel.style.maxHeight = finalHeight + 'px';\n  1558→    panel.style.minHeight = 'auto';\n  1559→    \n  1560→    // If locked, ensure it stays positioned at bottom-right\n  1561→    if (isPanelLocked) {\n  1562→        panel.style.left = 'auto';\n  1563→        panel.style.top = 'auto';\n  1564→        panel.style.right = '24px';\n  1565→        panel.style.bottom = '24px';\n  1566→    }\n  1567→    \n  1568→    // Update active state of size buttons\n  1569→    document.querySelectorAll('.size-btn').forEach(btn => {\n  1570→        btn.classList.remove('active');\n  1571→        if (parseInt(btn.textContent) === percentage || \n  1572→            (btn.textContent === 'S' && percentage === 40) ||\n  1573→            (btn.textContent === 'M' && percentage === 60) ||\n  1574→            (btn.textContent === 'L' && percentage === 90)) {\n  1575→            btn.classList.add('active');\n  1576→        }\n  1577→    });\n  1578→}\n  1579→\n  1580→// =========================================================================\n  1581→// Attach/detach diagram context\n  1582→// =========================================================================\n  1583→\n  1584→function toggleContext(filename, idx) {\n  1585→    if (attachedDiagrams.has(filename)) {\n  1586→        attachedDiagrams.delete(filename);\n  1587→    } else {\n  1588→        attachedDiagrams.add(filename);\n  1589→    }\n  1590→    updateAttachedUI();\n  1591→}\n  1592→\n  1593→function updateAttachedUI() {\n  1594→    document.querySelectorAll('.diagram-card').forEach((card, i) => {\n  1595→        const file = DIAGRAMS[i]?.file;\n  1596→        const indicator = document.getElementById(`ctx-${i + 1}`);\n  1597→        if (file && attachedDiagrams.has(file)) {\n  1598→            card.classList.add('attached');\n  1599→            if (indicator) { indicator.className = 'attach-indicator on'; indicator.textContent = 'attached'; }\n  1600→        } else {\n  1601→            card.classList.remove('attached');\n  1602→            if (indicator) { indicator.className = 'attach-indicator off'; indicator.textContent = 'click to attach'; }\n  1603→        }\n  1604→    });\n  1605→    \n  1606→    // Update new attached context bar\n  1607→    const container = document.getElementById('attached-context');\n  1608→    const list = document.getElementById('attached-list');\n  1609→    const inputContext = document.getElementById('input-context');\n  1610→    const contextCount = document.getElementById('context-count');\n  1611→    \n  1612→    if (attachedDiagrams.size > 0) {\n  1613→        if (container) container.style.display = 'flex';\n  1614→        if (list) {\n  1615→            list.innerHTML = [...attachedDiagrams].map(f => \n  1616→                `<span class=\"attached-context-item\">${escapeHtml(f)}</span>`\n  1617→            ).join('');\n  1618→        }\n  1619→        if (inputContext) inputContext.style.display = 'flex';\n  1620→        if (contextCount) contextCount.textContent = `${attachedDiagrams.size} diagram${attachedDiagrams.size !== 1 ? 's' : ''} attached`;\n  1621→    } else {\n  1622→        if (container) container.style.display = 'none';\n  1623→        if (inputContext) inputContext.style.display = 'none';\n  1624→    }\n  1625→}\n  1626→\n  1627→// =========================================================================\n  1628→// Element selection (node click)\n  1629→// =========================================================================\n  1630→\n  1631→function extractNodeId(svgId, node) {\n  1632→    // Mermaid v11 flowchart nodes: \"flowchart-NodeId-0\" or \"flowchart-NodeId-123\"\n  1633→    const flowMatch = svgId.match(/^flowchart-(.+?)-\\d+$/);\n  1634→    if (flowMatch) return flowMatch[1];\n  1635→    // Other patterns: try splitting on hyphens and taking middle parts\n  1636→    const parts = svgId.split('-');\n  1637→    if (parts.length >= 2) return parts.slice(0, -1).join('-');\n  1638→    // Fallback: use text content of the node\n  1639→    const text = node.textContent?.trim();\n  1640→    return text || null;\n  1641→}\n  1642→\n  1643→function toggleElementSelection(filename, nodeId, svgElement) {\n  1644→    if (!selectedElements.has(filename)) {\n  1645→        selectedElements.set(filename, new Set());\n  1646→    }\n  1647→    const selected = selectedElements.get(filename);\n  1648→\n  1649→    if (selected.has(nodeId)) {\n  1650→        selected.delete(nodeId);\n  1651→        svgElement.classList.remove('node-selected');\n  1652→        // Clean up empty sets\n  1653→        if (selected.size === 0) selectedElements.delete(filename);\n  1654→    } else {\n  1655→        selected.add(nodeId);\n  1656→        svgElement.classList.add('node-selected');\n  1657→        // Auto-attach the diagram\n  1658→        if (!attachedDiagrams.has(filename)) {\n  1659→            attachedDiagrams.add(filename);\n  1660→            updateAttachedUI();\n  1661→        }\n  1662→    }\n  1663→    updateSelectedUI();\n  1664→}\n  1665→\n  1666→function getNodeConnections(filename, nodeId) {\n  1667→    const content = diagramContents[filename];\n  1668→    if (!content) return [];\n  1669→    const connections = [];\n  1670→    for (const line of content.split('\\n')) {\n  1671→        const trimmed = line.trim();\n  1672→        // Skip directive/config lines, only match lines containing the nodeId\n  1673→        if (trimmed && trimmed.includes(nodeId) && /[-=.]+>|[-=.]+\\|/.test(trimmed)) {\n  1674→            connections.push(trimmed);\n  1675→        }\n  1676→    }\n  1677→    return connections;\n  1678→}\n  1679→\n  1680→function reapplySelections(el, filename) {\n  1681→    const selected = selectedElements.get(filename);\n  1682→    if (!selected || selected.size === 0) return;\n  1683→    el.querySelectorAll('.node').forEach(node => {\n  1684→        const nodeId = extractNodeId(node.id, node);\n  1685→        if (nodeId && selected.has(nodeId)) {\n  1686→            node.classList.add('node-selected');\n  1687→        }\n  1688→    });\n  1689→}\n  1690→\n  1691→function updateSelectedUI() {\n  1692→    const bar = document.getElementById('selected-elements-bar');\n  1693→    const list = document.getElementById('selected-elements-list');\n  1694→    if (!bar || !list) return;\n  1695→\n  1696→    let totalSelected = 0;\n  1697→    let chips = '';\n  1698→    for (const [filename, nodes] of selectedElements) {\n  1699→        for (const nodeId of nodes) {\n  1700→            chips += `<span class=\"selected-chip\" title=\"${escapeHtml(filename)}\">${escapeHtml(nodeId)}</span>`;\n  1701→            totalSelected++;\n  1702→        }\n  1703→    }\n  1704→\n  1705→    if (totalSelected > 0) {\n  1706→        list.innerHTML = chips;\n  1707→        bar.style.display = 'flex';\n  1708→    } else {\n  1709→        bar.style.display = 'none';\n  1710→    }\n  1711→}\n  1712→\n  1713→function clearAllSelections() {\n  1714→    // Remove CSS classes from SVG nodes\n  1715→    for (const [filename, nodes] of selectedElements) {\n  1716→        const idx = DIAGRAMS.findIndex(d => d.file === filename);\n  1717→        if (idx === -1) continue;\n  1718→        const el = document.getElementById(`mermaid-${idx + 1}`);\n  1719→        if (el) {\n  1720→            el.querySelectorAll('.node-selected').forEach(n => n.classList.remove('node-selected'));\n  1721→        }\n  1722→    }\n  1723→    selectedElements.clear();\n  1724→    updateSelectedUI();\n  1725→}\n  1726→\n  1727→// =========================================================================\n  1728→// Provider & model loading\n  1729→// =========================================================================\n  1730→\n  1731→let _modelFetchId = 0;\n  1732→\n  1733→function renderModels(models) {\n  1734→    const select = document.getElementById('chat-model');\n  1735→    if (!select) return;\n  1736→    select.innerHTML = '';\n  1737→    models.forEach(m => {\n  1738→        const opt = document.createElement('option');\n  1739→        opt.value = m; opt.textContent = m;\n  1740→        select.appendChild(opt);\n  1741→    });\n  1742→}\n  1743→\n  1744→async function fetchModels(providerName) {\n  1745→    const thisId = ++_modelFetchId;\n  1746→    const select = document.getElementById('chat-model');\n  1747→    if (select) select.innerHTML = '<option disabled selected>Loading models...</option>';\n  1748→    try {\n  1749→        const resp = await fetch(`/api/providers/${providerName}/models`);\n  1750→        if (thisId !== _modelFetchId) return;\n  1751→        if (!resp.ok) throw new Error('Failed');\n  1752→        const data = await resp.json();\n  1753→        if (thisId !== _modelFetchId) return;\n  1754→        if (data.error) {\n  1755→            if (select) select.innerHTML = '<option disabled selected>Timed out</option>';\n  1756→            return;\n  1757→        }\n  1758→        renderModels(data.models);\n  1759→    } catch {\n  1760→        if (thisId !== _modelFetchId) return;\n  1761→        if (select) select.innerHTML = '<option disabled selected>Failed</option>';\n  1762→    }\n  1763→}\n  1764→\n  1765→function getSelectedProvider() {\n  1766→    const sel = document.getElementById('chat-provider');\n  1767→    return sel ? sel.value : 'claude';\n  1768→}\n  1769→\n  1770→function onProviderChange() {\n  1771→    fetchModels(getSelectedProvider());\n  1772→}\n  1773→\n  1774→if (PROVIDERS.length > 0) fetchModels(PROVIDERS[0].name);\n  1775→\n  1776→// =========================================================================\n  1777→// Service Health Polling\n  1778→// =========================================================================\n  1779→\n  1780→let _lastServiceHealth = {};\n  1781→\n  1782→async function pollServiceHealth() {\n  1783→    try {\n  1784→        const resp = await fetch('/api/services/health');\n  1785→        if (!resp.ok) return;\n  1786→        const data = await resp.json();\n  1787→        const services = data.services || [];\n  1788→        _lastServiceHealth = {};\n  1789→        services.forEach(svc => {\n  1790→            _lastServiceHealth[svc.name] = svc;\n  1791→            // Update new status dots\n  1792→            const dotId = svc.name === 'companion' ? 'status-companion' : `status-${svc.name}`;\n  1793→            const dot = document.getElementById(dotId);\n  1794→            if (dot) {\n  1795→                dot.classList.toggle('online', svc.status === 'running');\n  1796→            }\n  1797→        });\n  1798→        updateProviderAvailability(services);\n  1799→    } catch (e) {\n  1800→        // Silently fail\n  1801→    }\n  1802→}\n  1803→\n  1804→function updateProviderAvailability(services) {\n  1805→    const sel = document.getElementById('chat-provider');\n  1806→    if (!sel || !sel.options) return;\n  1807→    for (const opt of sel.options) {\n  1808→        const svcName = opt.value === 'claude' ? 'companion' : opt.value;\n  1809→        const svc = services.find(s => s.name === svcName);\n  1810→        if (svc && svc.status !== 'running') {\n  1811→            opt.disabled = true;\n  1812→            opt.textContent = opt.textContent.replace(/ \\(offline\\)$/, '') + ' (offline)';\n  1813→        } else {\n  1814→            opt.disabled = false;\n  1815→            opt.textContent = opt.textContent.replace(/ \\(offline\\)$/, '');\n  1816→        }\n  1817→    }\n  1818→}\n  1819→\n  1820→// Poll on load and every 10s\n  1821→pollServiceHealth();\n  1822→setInterval(pollServiceHealth, 10000);\n  1823→\n  1824→// =========================================================================\n  1825→// Session Management\n  1826→// =========================================================================\n  1827→\n  1828→let _allSessions = [];\n  1829→\n  1830→async function loadSessions() {\n  1831→    try {\n  1832→        const resp = await fetch(`/api/projects/${PROJECT_ID}/chat/sessions?feature=${FEATURE_NAME}`);\n  1833→        const sessions = await resp.json();\n  1834→        _allSessions = sessions;\n  1835→        renderSessionList();\n  1836→        \n  1837→        // Auto-select most recent if available and no current session\n  1838→        if (sessions.length > 0 && !currentSessionId) {\n  1839→            await loadSession(sessions[0].id);\n  1840→        }\n  1841→    } catch (err) {\n  1842→        console.error('Failed to load sessions:', err);\n  1843→    }\n  1844→}\n  1845→\n  1846→function renderSessionList() {\n  1847→    const list = document.getElementById('session-list');\n  1848→    if (!list) return;\n  1849→    \n  1850→    if (_allSessions.length === 0) {\n  1851→        list.innerHTML = '<div style=\"padding: 20px; text-align: center; color: #737373; font-size: 0.875rem;\">No sessions yet</div>';\n  1852→        return;\n  1853→    }\n  1854→    \n  1855→    list.innerHTML = _allSessions.map(s => {\n  1856→        const date = new Date(s.updated_at).toLocaleDateString();\n  1857→        const isActive = s.id === currentSessionId;\n  1858→        return `\n  1859→            <div class=\"session-item ${isActive ? 'active' : ''}\" onclick=\"selectSession('${s.id}')\">\n  1860→                <div class=\"session-item-info\">\n  1861→                    <div class=\"session-item-name\">${escapeHtml(s.name)}</div>\n  1862→                    <div class=\"session-item-meta\">${s.message_count} messages · ${date}</div>\n  1863→                </div>\n  1864→                <button class=\"session-item-delete\" onclick=\"event.stopPropagation(); deleteSession('${s.id}')\" title=\"Delete\">\n  1865→                    <svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 4l8 8M12 4l-8 8\"/></svg>\n  1866→                </button>\n  1867→            </div>\n  1868→        `;\n  1869→    }).join('');\n  1870→}\n  1871→\n  1872→function toggleSessionPopup() {\n  1873→    const popup = document.getElementById('session-popup');\n  1874→    popup.classList.toggle('open');\n  1875→}\n  1876→\n  1877→async function selectSession(sessionId) {\n  1878→    toggleSessionPopup();\n  1879→    if (sessionId === currentSessionId) return;\n  1880→    await loadSession(sessionId);\n  1881→}\n  1882→\n  1883→function setInput(text) {\n  1884→    const input = document.getElementById('chat-input');\n  1885→    if (input) {\n  1886→        input.value = text;\n  1887→        input.focus();\n  1888→    }\n  1889→}\n  1890→\n  1891→// Legacy function - sessions are now selected via popup\n  1892→async function onSessionChange(sessionId) {\n  1893→    if (!sessionId) {\n  1894→        if (currentSessionId) {\n  1895→            fetch(`/api/projects/${PROJECT_ID}/chat/sessions/${currentSessionId}/cancel`, { method: 'POST' }).catch(() => {});\n  1896→        }\n  1897→        disconnectSSE();\n  1898→        currentSessionId = null;\n  1899→        setChatEnabled(false);\n  1900→        return;\n  1901→    }\n  1902→    await loadSession(sessionId);\n  1903→}\n  1904→\n  1905→async function loadSession(sessionId) {\n  1906→    try {\n  1907→        if (currentSessionId && currentSessionId !== sessionId) {\n  1908→            fetch(`/api/projects/${PROJECT_ID}/chat/sessions/${currentSessionId}/cancel`, { method: 'POST' }).catch(() => {});\n  1909→        }\n  1910→\n  1911→        const resp = await fetch(`/api/projects/${PROJECT_ID}/chat/sessions/${sessionId}`);\n  1912→        if (!resp.ok) throw new Error('Session not found');\n  1913→        const session = await resp.json();\n  1914→\n  1915→        currentSessionId = sessionId;\n  1916→\n  1917→        // Update header with session name\n  1918→        const sessionNameEl = document.getElementById('current-session-name');\n  1919→        if (sessionNameEl) sessionNameEl.textContent = session.name;\n  1920→\n  1921→        // Sync provider/model dropdowns to match the session\n  1922→        if (session.provider) {\n  1923→            const providerEl = document.getElementById('chat-provider');\n  1924→            if (providerEl && providerEl.tagName === 'SELECT') {\n  1925→                providerEl.value = session.provider;\n  1926→            }\n  1927→            // Fetch models for this provider, then select the session's model\n  1928→            await fetchModels(session.provider);\n  1929→            if (session.model) {\n  1930→                const modelEl = document.getElementById('chat-model');\n  1931→                if (modelEl) modelEl.value = session.model;\n  1932→            }\n  1933→        }\n  1934→\n  1935→        // Render messages\n  1936→        const container = document.getElementById('chat-messages');\n  1937→        // Hide welcome state, show messages\n  1938→        const welcome = document.getElementById('chat-welcome');\n  1939→        if (welcome) welcome.style.display = 'none';\n  1940→        \n  1941→        container.innerHTML = '';\n  1942→        session.messages.forEach(m => {\n  1943→            appendMessage(m.role, m.content, false);\n  1944→        });\n  1945→\n  1946→        setChatEnabled(true);\n  1947→        connectSSE(sessionId);\n  1948→        renderSessionList(); // Update active state\n  1949→    } catch (err) {\n  1950→        console.error('Failed to load session:', err);\n  1951→    }\n  1952→}\n  1953→\n  1954→async function createNewSession() {\n  1955→    const provider = getSelectedProvider();\n  1956→    const model = document.getElementById('chat-model').value;\n  1957→    if (!model) { alert('Select a model first'); return; }\n  1958→\n  1959→    try {\n  1960→        const resp = await fetch(`/api/projects/${PROJECT_ID}/chat/sessions`, {\n  1961→            method: 'POST',\n  1962→            headers: { 'Content-Type': 'application/json' },\n  1963→            body: JSON.stringify({\n  1964→                feature_name: FEATURE_NAME,\n  1965→                provider: provider,\n  1966→                model: model,\n  1967→            }),\n  1968→        });\n  1969→        const session = await resp.json();\n  1970→\n  1971→        // Reload sessions and select the new one\n  1972→        await loadSessions();\n  1973→        await loadSession(session.id);\n  1974→    } catch (err) {\n  1975→        console.error('Failed to create session:', err);\n  1976→    }\n  1977→}\n  1978→\n  1979→async function deleteSession(sessionId) {\n  1980→    if (!confirm('Delete this chat session?')) return;\n  1981→    try {\n  1982→        await fetch(`/api/projects/${PROJECT_ID}/chat/sessions/${sessionId}`, { method: 'DELETE' });\n  1983→        \n  1984→        if (currentSessionId === sessionId) {\n  1985→            disconnectSSE();\n  1986→            currentSessionId = null;\n  1987→            setChatEnabled(false);\n  1988→            // Show welcome state again\n  1989→            const container = document.getElementById('chat-messages');\n  1990→            const welcome = document.getElementById('chat-welcome');\n  1991→            if (container) container.innerHTML = '';\n  1992→            if (welcome) welcome.style.display = 'flex';\n  1993→            // Update header\n  1994→            const sessionNameEl = document.getElementById('current-session-name');\n  1995→            if (sessionNameEl) sessionNameEl.textContent = 'New AI chat';\n  1996→        }\n  1997→        \n  1998→        await loadSessions();\n  1999→    } catch (err) {\n  2000→        console.error('Failed to delete session:', err);\n  2001→    }\n  2002→}\n  2003→\n  2004→// Legacy function for backwards compatibility\n  2005→async function deleteCurrentSession() {\n  2006→    if (!currentSessionId) return;\n  2007→    await deleteSession(currentSessionId);\n  2008→}\n  2009→\n  2010→function setChatEnabled(enabled) {\n  2011→    const input = document.getElementById('chat-input');\n  2012→    const sendBtn = document.getElementById('chat-send-btn');\n  2013→    if (input) input.disabled = !enabled;\n  2014→    if (sendBtn) sendBtn.disabled = !enabled;\n  2015→}\n  2016→\n  2017→// =========================================================================\n  2018→// SSE Connection (chat tokens + diagram changes)\n  2019→// =========================================================================\n  2020→\n  2021→function connectSSE(sessionId) {\n  2022→    disconnectSSE();\n  2023→    const url = `/api/projects/${PROJECT_ID}/chat/sessions/${sessionId}/stream`;\n  2024→    eventSource = new EventSource(url);\n  2025→\n  2026→    eventSource