sh(newDiagram);\n  2313→    diagramContents[filename] = content;\n  2314→\n  2315→    const grid = document.getElementById('diagram-grid');\n  2316→    if (!grid) return;\n  2317→\n  2318→    const idx = DIAGRAMS.length;\n  2319→    const card = document.createElement('div');\n  2320→    card.className = 'diagram-card';\n  2321→    card.dataset.diagramFile = filename;\n  2322→    card.onclick = () => toggleContext(filename, idx);\n  2323→    card.innerHTML = `\n  2324→        <div class=\"diagram-header\">\n  2325→            <div class=\"flex items-center gap-2 flex-1 min-w-0\">\n  2326→                <span class=\"font-semibold text-sm truncate\">${escapeHtml(newDiagram.name)}</span>\n  2327→                <span class=\"badge badge-arch\">architecture</span>\n  2328→                <span class=\"text-green-400 text-xs\">NEW</span>\n  2329→            </div>\n  2330→            <span class=\"attach-indicator off\" id=\"ctx-${idx}\">click to attach</span>\n  2331→        </div>\n  2332→        <div class=\"diagram-body\" onclick=\"event.stopPropagation()\">\n  2333→            <div class=\"diagram-viewport\" id=\"viewport-${idx}\">\n  2334→                <div class=\"mermaid\" id=\"mermaid-${idx}\">Loading...</div>\n  2335→            </div>\n  2336→            <div class=\"diagram-zoom-controls\">\n  2337→                <button onclick=\"zoomDiagram(${idx}, -0.2)\" title=\"Zoom out\">&minus;</button>\n  2338→                <button onclick=\"resetZoom(${idx})\" title=\"Reset zoom\">1:1</button>\n  2339→                <button onclick=\"zoomDiagram(${idx}, 0.2)\" title=\"Zoom in\">+</button>\n  2340→                <a class=\"diagram-expand-btn\"\n  2341→                   href=\"/project/${PROJECT_ID}/arch/${FEATURE_NAME}/diagram/${escapeHtml(filename)}\"\n  2342→                   target=\"_blank\"\n  2343→                   title=\"Open full-page view\">&#x26F6;</a>\n  2344→            </div>\n  2345→        </div>\n  2346→    `;\n  2347→    grid.appendChild(