{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0141UfmjoBVRnNSFQNiEN2ab","type":"tool_result","content":"     1→\"\"\"Tests for the watchdog-based diagram watcher.\"\"\"\n     2→\n     3→import asyncio\n     4→import json\n     5→from pathlib import Path\n     6→\n     7→import pytest\n     8→\n     9→from server.services.diagram_watcher import (\n    10→    DiagramWatcher,\n    11→    _detect_diagram_type,\n    12→    _read_file,\n    13→)\n    14→\n    15→\n    16→class TestDetectDiagramType:\n    17→    def test_flowchart(self, tmp_path):\n    18→        f = tmp_path / \"test.mmd\"\n    19→        f.write_text(\"flowchart LR\\n  A --> B\", encoding=\"utf-8\")\n    20→        assert _detect_diagram_type(f) == \"flowchart\"\n    21→\n    22→    def test_sequence_diagram(self, tmp_path):\n    23→        f = tmp_path / \"test.mmd\"\n    24→        f.write_text(\"sequenceDiagram\\n  Alice->>Bob: Hello\", encoding=\"utf-8\")\n    25→        assert _detect_diagram_type(f) == \"sequencediagram\"\n    26→\n    27→    def test_class_diagram(self, tmp_path):\n    28→        f = tmp_path / \"test.mmd\"\n    29→        f.write_text(\"classDiagram\\n  class Animal\", encoding=\"utf-8\")\n    30→        assert _detect_diagram_type(f) == \"classdiagram\"\n    31→\n    32→    def test_state_diagram(self, tmp_path):\n    33→        f = tmp_path / \"test.mmd\"\n    34→        f.write_text(\"stateDiagram-v2\\n  [*] --> Idle\", encoding=\"utf-8\")\n    35→        assert _detect_diagram_type(f) == \"statediagram\"\n    36→\n    37→    def test_gantt(self, tmp_path):\n    38→        f = tmp_path / \"test.mmd\"\n    39→        f.write_text(\"gantt\\n  title Project\", encoding=\"utf-8\")\n    40→        assert _detect_diagram_type(f) == \"gantt\"\n    41→\n    42→    def test_unknown_defaults_to_flowchart(self, tmp_path):\n    43→        f = tmp_path / \"test.mmd\"\n    44→        f.write_text(\"unknown content\", encoding=\"utf-8\")\n    45→        assert _detect_diagram_type(f) == \"flowchart\"\n    46→\n    47→    def test_empty_file(self, tmp_path):\n    48→        f = tmp_path / \"test.mmd\"\n    49→        f.write_text(\"\", encoding=\"utf-8\")\n    50→        assert _detect_diagram_type(f) == \"flowchart\"\n    51→\n    52→    def test_missing_file(self, tmp_path):\n    53→        f = tmp_path / \"nonexistent.mmd\"\n    54→        assert _detect_diagram_type(f) == \"flowchart\"\n    55→\n    56→\n    57→class TestReadFile:\n    58→    def test_reads_utf8(self, tmp_path):\n    59→        f = tmp_path / \"test.mmd\"\n    60→        f.write_text(\"flowchart LR\", encoding=\"utf-8\")\n    61→        assert _read_file(f) == \"flowchart LR\"\n    62→\n    63→    def test_missing_file_returns_empty(self, tmp_path):\n    64→        assert _read_file(tmp_path / \"nope.mmd\") == \"\"\n    65→\n    66→\n    67→class TestDiagramWatcher:\n    68→    def test_key_generation(self):\n    69→        assert DiagramWatcher._key(\"proj1\", \"feat1\") == \"proj1:feat1\"\n    70→\n    71→    def test_subscribe_creates_queue(self, tmp_path):\n    72→        watcher = DiagramWatcher()\n    73→        arch_dir = tmp_path / \"arch\"\n    74→        arch_dir.mkdir()\n    75→\n    76→        queue = watcher.subscribe(\"p1\", \"f1\", arch_dir)\n    77→        assert isinstance(queue, asyncio.Queue)\n    78→        assert \"p1:f1\" in watcher._subscribers\n    79→        assert len(watcher._subscribers[\"p1:f1\"]) == 1\n    80→\n    81→    def test_subscribe_starts_observer(self, tmp_path):\n    82→        watcher = DiagramWatcher()\n    83→        arch_dir = tmp_path / \"arch\"\n    84→        arch_dir.mkdir()\n    85→\n    86→        watcher.subscribe(\"p1\", \"f1\", arch_dir)\n    87→        assert \"p1:f1\" in watcher._observers\n    88→        assert watcher._observers[\"p1:f1\"].is_alive()\n    89→\n    90→        # Cleanup\n    91→        for key in list(watcher._observers.keys()):\n    92→            watcher._stop_observer(key)\n    93→\n    94→    def test_subscribe_no_dir(self, tmp_path):\n    95→        watcher = DiagramWatcher()\n    96→        arch_dir = tmp_path / \"nonexistent\"\n    97→\n    98→        queue = watcher.subscribe(\"p1\", \"f1\", arch_dir)\n    99→        assert isinstance(queue, asyncio.Queue)\n   100→        # Observer not started for nonexistent dir\n   101→        assert \"p1:f1\" not in watcher._observers\n   102→\n   103→    def test_multiple_subscribers(self, tmp_path):\n   104→        watcher = DiagramWatcher()\n   105→        arch_dir = tmp_path / \"arch\"\n   106→        arch_dir.mkdir()\n   107→\n   108→        q1 = watcher.subscribe(\"p1\", \"f1\", arch_dir)\n   109→        q2 = watcher.subscribe(\"p1\", \"f1\", arch_dir)\n   110→        assert len(watcher._subscribers[\"p1:f1\"]) == 2\n   111→\n   112→        for key in list(watcher._observers.keys()):\n   113→            watcher._stop_observer(key)\n   114→\n   115→    def test_unsubscribe_removes_queue(self, tmp_path):\n   116→        watcher = DiagramWatcher()\n   117→        arch_dir = tmp_path / \"arch\"\n   118→        arch_dir.mkdir()\n   119→\n   120→        q1 = watcher.subscribe(\"p1\", \"f1\", arch_dir)\n   121→        q2 = watcher.subscribe(\"p1\", \"f1\", arch_dir)\n   122→\n   123→        watcher.unsubscribe(\"p1\", \"f1\", q1)\n   124→        assert len(watcher._subscribers[\"p1:f1\"]) == 1\n   125→\n   126→        for key in list(watcher._observers.keys()):\n   127→            watcher._stop_observer(key)\n   128→\n   129→    def test_unsubscribe_last_stops_observer(self, tmp_path):\n   130→        watcher = DiagramWatcher()\n   131→        arch_dir = tmp_path / \"arch\"\n   132→        arch_dir.mkdir()\n   133→\n   134→        q = watcher.subscribe(\"p1\", \"f1\", arch_dir)\n   135→        assert \"p1:f1\" in watcher._observers\n   136→\n   137→        watcher.unsubscribe(\"p1\", \"f1\", q)\n   138→        assert \"p1:f1\" not in watcher._observers\n   139→        assert \"p1:f1\" not in watcher._subscribers\n   140→\n   141→    def test_unsubscribe_unknown_key(self):\n   142→        watcher = DiagramWatcher()\n   143→        q = asyncio.Queue()\n   144→        # Should not raise\n   145→        watcher.unsubscribe(\"unknown\", \"unknown\", q)\n   146→\n   147→\n   148→class TestManifestUpdate:\n   149→    def test_updates_arch_json(self, tmp_path):\n   150→        arch_dir = tmp_path / \"arch\"\n   151→        arch_dir.mkdir()\n   152→        (arch_dir / \"flow-diagram.mmd\").write_text(\"flowchart LR\\n  A-->B\", encoding=\"utf-8\")\n   153→        (arch_dir / \"seq-diagram.mmd\").write_text(\"sequenceDiagram\\n  A->>B: Hi\", encoding=\"utf-8\")\n   154→        (arch_dir / \"readme.txt\").write_text(\"ignore me\", encoding=\"utf-8\")\n   155→\n   156→        DiagramWatcher._update_manifest_sync(arch_dir)\n   157→\n   158→        manifest = json.loads((arch_dir / \"_arch.json\").read_text(encoding=\"utf-8\"))\n   159→        assert \"diagrams\" in manifest\n   160→        assert len(manifest[\"diagrams\"]) == 2\n   161→        names = {e[\"name\"] for e in manifest[\"diagrams\"]}\n   162→        assert \"Flow Diagram\" in names\n   163→        assert \"Seq Diagram\" in names\n   164→        for entry in manifest[\"diagrams\"]:\n   165→            assert entry[\"type\"] == \"mermaid\"\n   166→            assert \"diagramType\" in entry\n   167→\n   168→    def test_no_dir_does_nothing(self, tmp_path):\n   169→        arch_dir = tmp_path / \"nonexistent\"\n   170→        # Should not raise\n   171→        DiagramWatcher._update_manifest_sync(arch_dir)\n   172→\n   173→    def test_empty_dir(self, tmp_path):\n   174→        arch_dir = tmp_path / \"arch\"\n   175→        arch_dir.mkdir()\n   176→\n   177→        DiagramWatcher._update_manifest_sync(arch_dir)\n   178→\n   179→        manifest = json.loads((arch_dir / \"_arch.json\").read_text(encoding=\"utf-8\"))\n   180→        assert manifest[\"diagrams\"] == []\n   181→\n   182→    def test_drawio_type(self, tmp_path):\n   183→        arch_dir = tmp_path / \"arch\"\n   184→        arch_dir.mkdir()\n   185→        (arch_dir / \"my-diagram.drawio\").write_text(\"<xml>drawio</xml>\", encoding=\"utf-8\")\n   186→\n   187→        DiagramWatcher._update_manifest_sync(arch_dir)\n   188→\n   189→        manifest = json.loads((arch_dir / \"_arch.json\").read_text(encoding=\"utf-8\"))\n   190→        assert len(manifest[\"diagrams\"]) == 1\n   191→        assert manifest[\"diagrams\"][0][\"type\"] == \"drawio\"\n   192→        assert manifest[\"diagrams\"][0][\"diagramType\"] == \"drawio\"\n   193→\n   194→\n   195→@pytest.mark.asyncio\n   196→class TestBroadcast:\n   197→    async def test_broadcast_delivers_to_subscribers(self):\n   198→        watcher = DiagramWatcher()\n   199→        q1: asyncio.Queue = asyncio.Queue(maxsize=10)\n   200→        q2: asyncio.Queue = asyncio.Queue(maxsize=10)\n   201→        watcher._subscribers[\"test:key\"] = [q1, q2]\n   202→\n   203→        msg = {\"event\": \"diagram_changed\", \"data\": {\"file\": \"test.mmd\"}}\n   204→        await watcher._broadcast(\"test:key\", msg)\n   205→\n   206→        assert q1.qsize() == 1\n   207→        assert q2.qsize() == 1\n   208→        assert await q1.get() == msg\n   209→        assert await q2.get() == msg\n   210→\n   211→    async def test_broadcast_drops_full_queues(self):\n   212→        watcher = DiagramWatcher()\n   213→        q_ok: asyncio.Queue = asyncio.Queue(maxsize=10)\n   214→        q_full: asyncio.Queue = asyncio.Queue(maxsize=1)\n   215→        q_full.put_nowait({\"dummy\": True})  # fill it\n   216→\n   217→        watcher._subscribers[\"test:key\"] = [q_ok, q_full]\n   218→\n   219→        msg = {\"event\": \"diagram_changed\", \"data\": {\"file\": \"test.mmd\"}}\n   220→        await watcher._broadcast(\"test:key\", msg)\n   221→\n   222→        assert q_ok.qsize() == 1\n   223→        # Full queue should be removed\n   224→        assert len(watcher._subscribers[\"test:key\"]) == 1\n   225→\n   226→    async def test_broadcast_unknown_key(self):\n   227→        watcher = DiagramWatcher()\n   228→        # Should not raise\n   229→        await watcher._broadcast(\"nonexistent\", {\"event\": \"test\", \"data\": {}})\n   230→\n   231→\n   232→@pytest.mark.asyncio\n   233→class TestStopAll:\n   234→    async def test_stop_clears_state(self, tmp_path):\n   235→        watcher = DiagramWatcher()\n   236→        arch_dir = tmp_path / \"arch\"\n   237→        arch_dir.mkdir()\n   238→\n   239→        watcher.subscribe(\"p1\", \"f1\", arch_dir)\n   240→        assert len(watcher._observers) > 0\n   241→\n   242→        await watcher.stop()\n   243→\n   244→        assert len(watcher._observers) == 0\n   245→        assert len(watcher._subscribers) == 0\n   246→        assert len(watcher._watch_dirs) == 0\n   247→"}]},"parent_tool_use_id":"toolu_018MpjhRtb6LGGT9Fijxq2Pg","session_id":"e23a7aa2-5923-4855-9cc2-f80458cf6b25","uuid":"14691d9b-aa93-4f0c-95d3-1fa77b09a275"}
