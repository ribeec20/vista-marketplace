{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y1LmfjQLz1tvKbDGFX1H79","type":"tool_result","content":"     1→\"\"\"Ralph settings API endpoints.\"\"\"\n     2→\n     3→import asyncio\n     4→\n     5→from fastapi import APIRouter, HTTPException\n     6→from pydantic import BaseModel\n     7→\n     8→from server import config\n     9→from server.services.provider_service import get_ralph_providers\n    10→\n    11→router = APIRouter(prefix=\"/api/settings\", tags=[\"settings\"])\n    12→\n    13→VALID_COST_TIERS = {None, \"\", \"free\", \"cheap\", \"moderate\", \"expensive\"}\n    14→\n    15→\n    16→class RalphSettingsUpdate(BaseModel):\n    17→    \"\"\"Request body for updating ralph settings.\"\"\"\n    18→    defaults: dict | None = None\n    19→    summarizer: dict | None = None\n    20→    providers: dict | None = None\n    21→\n    22→\n    23→@router.get(\"/ralph\")\n    24→async def get_ralph_settings():\n    25→    \"\"\"Get current ralph settings merged with live model discovery.\"\"\"\n    26→    ralph_settings = config.get_ralph_settings()\n    27→    defaults = config.get_ralph_defaults()\n    28→    summarizer = config.get_summarizer_config()\n    29→\n    30→    # Live model discovery (may be slow - run in thread)\n    31→    try:\n    32→        providers = await asyncio.wait_for(\n    33→            asyncio.to_thread(get_ralph_providers),\n    34→            timeout=20.0,\n    35→        )\n    36→    except asyncio.TimeoutError:\n    37→        providers = []\n    38→\n    39→    return {\n    40→        \"defaults\": defaults,\n    41→        \"summarizer\": summarizer,\n    42→        \"providers\": providers,\n    43→        \"raw_settings\": ralph_settings,\n    44→    }\n    45→\n    46→\n    47→@router.put(\"/ralph\")\n    48→async def save_ralph_settings_endpoint(req: RalphSettingsUpdate):\n    49→    \"\"\"Save ralph settings back to settings.json.\"\"\"\n    50→    current = config.get_ralph_settings()\n    51→\n    52→    if req.defaults is not None:\n    53→        # Validate iterations\n    54→        iterations = req.defaults.get(\"iterations\")\n    55→        if iterations is not None and (not isinstance(iterations, int) or iterations <= 0):\n    56→            raise HTTPException(status_code=400, detail=\"iterations must be a positive integer\")\n    57→        current[\"defaults\"] = {**current.get(\"defaults\", {}), **req.defaults}\n    58→\n    59→    if req.summarizer is not None:\n    60→        current[\"summarizer\"] = {**current.get(\"summarizer\", {}), **req.summarizer}\n    61→\n    62→    if req.providers is not None:\n    63→        for pname, pcfg in req.providers.items():\n    64→            # Validate favorites\n    65→            favorites = pcfg.get(\"favorites\", [])\n    66→            if not isinstance(favorites, list):\n    67→                raise HTTPException(status_code=400, detail=f\"favorites must be a list for {pname}\")\n    68→            if len(favorites) > 3:\n    69→                raise HTTPException(status_code=400, detail=f\"Max 3 favorites per provider ({pname})\")\n    70→\n    71→            # Validate cost_tier values\n    72→            metadata = pcfg.get(\"model_metadata\", {})\n    73→            for model_name, meta in metadata.items():\n    74→                tier = meta.get(\"cost_tier\")\n    75→                if tier not in VALID_COST_TIERS:\n    76→                    raise HTTPException(\n    77→                        status_code=400,\n    78→                        detail=f\"Invalid cost_tier '{tier}' for {pname}/{model_name}. \"\n    79→                               f\"Valid: free, cheap, moderate, expensive\",\n    80→                    )\n    81→        current[\"providers\"] = req.providers\n    82→\n    83→    config.save_ralph_settings(current)\n    84→    return {\"ok\": True}\n    85→\n    86→\n    87→@router.get(\"/ralph/models\")\n    88→async def refresh_ralph_models():\n    89→    \"\"\"Refresh-only endpoint for live model discovery.\"\"\"\n    90→    try:\n    91→        providers = await asyncio.wait_for(\n    92→            asyncio.to_thread(get_ralph_providers),\n    93→            timeout=20.0,\n    94→        )\n    95→    except asyncio.TimeoutError:\n    96→        return {\"providers\": [], \"error\": \"Model discovery timed out\"}\n    97→    return {\"providers\": providers}\n    98→"}]},"parent_tool_use_id":null,"session_id":"e23a7aa2-5923-4855-9cc2-f80458cf6b25","uuid":"9416ac22-e174-4614-8442-068840ca7403","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/routes/ralph_settings.py","content":"\"\"\"Ralph settings API endpoints.\"\"\"\n\nimport asyncio\n\nfrom fastapi import APIRouter, HTTPException\nfrom pydantic import BaseModel\n\nfrom server import config\nfrom server.services.provider_service import get_ralph_providers\n\nrouter = APIRouter(prefix=\"/api/settings\", tags=[\"settings\"])\n\nVALID_COST_TIERS = {None, \"\", \"free\", \"cheap\", \"moderate\", \"expensive\"}\n\n\nclass RalphSettingsUpdate(BaseModel):\n    \"\"\"Request body for updating ralph settings.\"\"\"\n    defaults: dict | None = None\n    summarizer: dict | None = None\n    providers: dict | None = None\n\n\n@router.get(\"/ralph\")\nasync def get_ralph_settings():\n    \"\"\"Get current ralph settings merged with live model discovery.\"\"\"\n    ralph_settings = config.get_ralph_settings()\n    defaults = config.get_ralph_defaults()\n    summarizer = config.get_summarizer_config()\n\n    # Live model discovery (may be slow - run in thread)\n    try:\n        providers = await asyncio.wait_for(\n            asyncio.to_thread(get_ralph_providers),\n            timeout=20.0,\n        )\n    except asyncio.TimeoutError:\n        providers = []\n\n    return {\n        \"defaults\": defaults,\n        \"summarizer\": summarizer,\n        \"providers\": providers,\n        \"raw_settings\": ralph_settings,\n    }\n\n\n@router.put(\"/ralph\")\nasync def save_ralph_settings_endpoint(req: RalphSettingsUpdate):\n    \"\"\"Save ralph settings back to settings.json.\"\"\"\n    current = config.get_ralph_settings()\n\n    if req.defaults is not None:\n        # Validate iterations\n        iterations = req.defaults.get(\"iterations\")\n        if iterations is not None and (not isinstance(iterations, int) or iterations <= 0):\n            raise HTTPException(status_code=400, detail=\"iterations must be a positive integer\")\n        current[\"defaults\"] = {**current.get(\"defaults\", {}), **req.defaults}\n\n    if req.summarizer is not None:\n        current[\"summarizer\"] = {**current.get(\"summarizer\", {}), **req.summarizer}\n\n    if req.providers is not None:\n        for pname, pcfg in req.providers.items():\n            # Validate favorites\n            favorites = pcfg.get(\"favorites\", [])\n            if not isinstance(favorites, list):\n                raise HTTPException(status_code=400, detail=f\"favorites must be a list for {pname}\")\n            if len(favorites) > 3:\n                raise HTTPException(status_code=400, detail=f\"Max 3 favorites per provider ({pname})\")\n\n            # Validate cost_tier values\n            metadata = pcfg.get(\"model_metadata\", {})\n            for model_name, meta in metadata.items():\n                tier = meta.get(\"cost_tier\")\n                if tier not in VALID_COST_TIERS:\n                    raise HTTPException(\n                        status_code=400,\n                        detail=f\"Invalid cost_tier '{tier}' for {pname}/{model_name}. \"\n                               f\"Valid: free, cheap, moderate, expensive\",\n                    )\n        current[\"providers\"] = req.providers\n\n    config.save_ralph_settings(current)\n    return {\"ok\": True}\n\n\n@router.get(\"/ralph/models\")\nasync def refresh_ralph_models():\n    \"\"\"Refresh-only endpoint for live model discovery.\"\"\"\n    try:\n        providers = await asyncio.wait_for(\n            asyncio.to_thread(get_ralph_providers),\n            timeout=20.0,\n        )\n    except asyncio.TimeoutError:\n        return {\"providers\": [], \"error\": \"Model discovery timed out\"}\n    return {\"providers\": providers}\n","numLines":98,"startLine":1,"totalLines":98}}}
