and empty _arch.json scaffolding to feature setup script.\",\n    36→              \"files\": [\"vista/scripts/setup-feature.py\"]\n    37→            }\n    38→          ],\n    39→          \"acceptanceCriteria\": [\n    40→            \"setup-feature.py creates arch/ directory and _arch.json\",\n    41→            \"plan-schema.json validates plans without diagram sections\",\n    42→            \"arch-schema.json validates _arch.json manifests\"\n    43→          ]\n    44→        },\n    45→        {\n    46→          \"id\": \"phase-2\",\n    47→          \"name\": \"Server API for Architecture Files\",\n    48→          \"description\": \"Add FastAPI routes to serve arch manifest and individual diagram files with path validation.\",\n    49→          \"order\": 2,\n    50→          \"dependencies\": [\"phase-1\"],\n    51→          \"tasks\": [\n    52→            {\n    53→              \"name\": \"Create ArchitectureService\",\n    54→              \"description\": \"New service class with methods to read manifest, validate it, read diagram files, and prevent path traversal.\",\n    55→              \"files\": [\"vista/server/services/architecture_service.py\"]\n    56→            },\n    57→            {\n    58→              \"name\": \"Create architecture routes\",\n    59→              \"description\": \"GET /api/projects/{id}/features/{name}/arch (manifest) and GET /api/projects/{id}/features/{name}/arch/{filename} (file content).\",\n    60→              \"files\": [\"vista/server/routes/architecture.py\"]\n    61→            },\n    62→            {\n    63→              \"name\": \"Register routes in app.py\",\n    64→              \"description\": \"Include the new architecture router in the FastAPI app.\",\n    65→              \"files\": [\"vista/server/app.py\"]\n    66→            }\n    67→          ],\n    68→          \"acceptanceCriteria\": [\n    69→            \"GET /arch returns parsed _arch.json manifest\",\n    70→            \"GET /arch/{filename} returns raw file content with correct Content-Type\",\n    71→            \"Path traversal attempts return 400\",\n    72→            \"Missing files return 404\"\n    73→          ]\n    74→        },\n    75→        {\n    76→          \"id\": \"phase-3\",\n    77→          \"name\": \"Web App Diagram Rendering\",\n    78→          \"description\": \"Create the architecture page that loads manifest and renders diagrams using mermaid.js and Draw.io viewer.\",\n    79→          \"order\": 3,\n    80→          \"dependencies\": [\"phase-2\"],\n    81→          \"tasks\": [\n    82→            {\n    83→              \"name\": \"Create architecture page template\",\n    84→              \"description\": \"New Jinja2 template for the architecture diagrams page. Includes mermaid.js CDN script, diagram card containers, and loading skeletons.\",\n    85→              \"files\": [\"vista/server/views/architecture.html\"]\n    86→            },\n    87→            {\n    88→              \"name\": \"Create diagram rendering JavaScript\",\n    89→              \"description\": \"Client-side JS that reads manifest, fetches diagram files, dispatches to type-specific renderers. Renderer map: { mermaid: renderMermaid, drawio: renderDrawio }.\",\n    90→              \"files\": [\"vista/server/views/static/diagrams.js\"]\n    91→            },\n    92→            {\n    93→              \"name\": \"Add architecture page route\",\n    94→              \"description\": \"GET /project/{id}/arch/{feature_name} page route that serves the template.\",\n    95→              \"files\": [\"vista/server/routes/architecture.py\"]\n    96→            },\n    97→            {\n    98→              \"name\": \"Add diagram styles\",\n    99→              \"description\": \"CSS for diagram cards, loading skeletons, error placeholders, and responsive layout.\",\n   100→              \"files\": [\"vista/server/views/static/style.css\"]\n   101→            }\n   102→          ],\n   103→          \"acceptanceCriteria\": [\n   104→            \"Mermaid .mmd files render as SVG in browser\",\n   105→            \"Draw.io .drawio files render in embedded viewer\",\n   106→            \"Each card shows title and description from manifest\",\n   107→            \"Parse errors show inline with raw source\",\n   108→            \"Missing files show placeholder\",\n   109→            \"Page loads 5 diagrams in < 3s\"\n   110→          ]\n   111→        },\n   112→        {\n   113→          \"id\": \"phase-4\",\n   114→          \"name\": \"AI Chat Service & API\",\n   115→          \"description\": \"Build the server-side chat service that invokes CLI providers and streams responses via SSE.\",\n   116→          \"order\": 4,\n   117→          \"dependencies\": [\"phase-2\"],\n   118→          \"tasks\": [\n   119→            {\n   120→              \"name\": \"Create ChatService\",\n   121→              \"description\": \"Service that builds prompts from message + diagram context, invokes CLI subprocess, and yields stdout tokens as SSE events.\",\n   122→              \"files\": [\"vista/server/services/chat_service.py\"]\n   123→            },\n   124→            {\n   125→              \"name\": \"Create chat routes\",\n   126→              \"description\": \"POST /api/chat/send accepts { provider, model, message, attachments }, returns SSE stream of response tokens.\",\n   127→              \"files\": [\"vista/server/routes/chat.py\"]\n   128→            },\n   129→            {\n   130→              \"name\": \"Register chat routes in app.py\",\n   131→              \"description\": \"Include the new chat router in the FastAPI app.\",\n   132→              \"files\": [\"vista/server/app.py\"]\n   133→            }\n   134→          ],\n   135→          \"acceptanceCriteria\": [\n   136→            \"POST /api/chat/send accepts message with diagram context\",\n   137→            \"Server invokes selected CLI provider subprocess\",\n   138→         