t-welcome-title {\n   444→    font-size: 1.125rem;\n   445→    font-weight: 600;\n   446→    color: #f5f5f5;\n   447→    margin-bottom: 24px;\n   448→}\n   449→\n   450→.arch-chat-suggestions {\n   451→    width: 100%;\n   452→    max-width: 320px;\n   453→    display: flex;\n   454→    flex-direction: column;\n   455→    gap: 8px;\n   456→}\n   457→\n   458→.arch-chat-suggestion {\n   459→    display: flex;\n   460→    align-items: center;\n   461→    gap: 12px;\n   462→    padding: 12px 16px;\n   463→    background: #252525;\n   464→    border: 1px solid #2d2d2d;\n   465→    border-radius: 8px;\n   466→    cursor: pointer;\n   467→    transition: all 0.15s ease;\n   468→    text-align: left;\n   469→}\n   470→\n   471→.arch-chat-suggestion:hover {\n   472→    background: #2a2a2a;\n   473→    border-color: #3d3d3d;\n   474→}\n   475→\n   476→.arch-chat-suggestion-icon {\n   477→    width: 20px;\n   478→    height: 20px;\n   479→    color: #a3a3a3;\n   480→    flex-shrink: 0;\n   481→}\n   482→\n   483→.arch-chat-suggestion-text {\n   484→    font-size: 0.875rem;\n   485→    color: #d4d4d4;\n   486→}\n   487→\n   488→/* Message Bubbles */\n   489→.arch-chat-msg {\n   490→    margin-bottom: 16px;\n   491→    animation: archMessageSlideIn 0.2s ease-out;\n   492→}\n   493→\n   494→@keyframes archMessageSlideIn {\n   495→    from { opacity: 0; transform: translateY(8px); }\n   496→    to { opacity: 1; transform: translateY(0); }\n   497→}\n   498→\n   499→.arch-chat-msg.user {\n   500→    display: flex;\n   501→    justify-content: flex-end;\n   502→}\n   503→\n   504→.arch-chat-msg.user .arch-msg-bubble {\n   505→    background: #2563eb;\n   506→    color: white;\n   507→    padding: 10px 14px;\n   508→    border-radius: 16px 16px 4px 16px;\n   509→    max-width: 85%;\n   510→    font-size: 0.9375rem;\n   511→    line-height: 1.5;\n   512→}\n   513→\n   514→.arch-chat-msg.assistant {\n   515→    display: flex;\n   516→    gap: 12px;\n   517→    align-items: flex-start;