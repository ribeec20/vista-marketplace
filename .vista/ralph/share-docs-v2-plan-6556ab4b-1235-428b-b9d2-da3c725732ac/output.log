{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YA7P25Ux7Qiz32L6cENhnV","type":"tool_result","content":"     1→\"\"\"Data models for Docker sandbox functionality.\"\"\"\n     2→\n     3→from __future__ import annotations\n     4→\n     5→from dataclasses import dataclass, field\n     6→\n     7→\n     8→@dataclass\n     9→class MountSpec:\n    10→    \"\"\"A single bind mount specification.\"\"\"\n    11→    host_path: str\n    12→    container_path: str\n    13→    mode: str  # \"rw\" or \"ro\"\n    14→    mount_type: str = \"bind\"\n    15→\n    16→\n    17→@dataclass\n    18→class CredentialMount:\n    19→    \"\"\"Configuration for a credential mount entry.\"\"\"\n    20→    name: str  # \"claude_auth\", \"git_ssh\", etc.\n    21→    host_path: str\n    22→    container_path: str\n    23→    mode: str = \"ro\"\n    24→    is_directory: bool = True\n    25→\n    26→\n    27→@dataclass\n    28→class ContainerInfo:\n    29→    \"\"\"Runtime information about a managed Docker container.\"\"\"\n    30→    container_id: str\n    31→    name: str\n    32→    job_id: str\n    33→    provider: str\n    34→    status: str  # \"creating\", \"running\", \"stopping\", \"removed\", \"failed\"\n    35→    image: str = \"\"\n    36→    created_at: str = \"\"\n    37→    expires_at: str = \"\"\n    38→    error: str = \"\"\n    39→"}]},"parent_tool_use_id":"toolu_01X5SUDSo81xnyxdSE9f57dW","session_id":"99d2dbda-9327-4d38-9974-87ec95f217c6","uuid":"d563382e-6c21-44ef-9a4b-bf99b438d976"}
