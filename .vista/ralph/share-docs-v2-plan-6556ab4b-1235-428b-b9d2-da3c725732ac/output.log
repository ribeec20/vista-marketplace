plan_file.exists():\n    39→            return plan_file.read_text(encoding=\"utf-8\")\n    40→        return None\n    41→\n    42→    @staticmethod\n    43→    def read_agents_md(project_path: str, feature_name: str) -> Optional[str]:\n    44→        \"\"\"Read AGENTS.md if it exists.\"\"\"\n    45→        agents_file = Path(project_path) / \".vista\" / \"features\" / feature_name / \"AGENTS.md\"\n    46→        if agents_file.exists():\n    47→            return agents_file.read_text(encoding=\"utf-8\")\n    48→        return None\n    49→\n    50→    @staticmethod\n    51→    def read_arch_manifest(project_path: str, feature_name: str) -> Optional[dict]:\n    52→        \"\"\"Read arch/_arch.json manifest for a feature.\"\"\"\n    53→        arch_file = Path(project_path) / \".vista\" / \"features\" / feature_name / \"arch\" / \"_arch.json\"\n    54→        if not arch_file.exists():\n    55→            return None\n    56→        try:\n    57→            data = json.loads(arch_file.read_text(encoding=\"utf-8\"))\n    58→            # Normalize legacy format: bare list -> dict with \"diagrams\" key\n    59→            if isinstance(data, list):\n    60→                data = {\"feature\": feature_name, \"diagrams\": data}\n    61→            return data\n    62→        except (json.JSONDecodeError, OSError):\n    63→            return None\n    64→\n    65→    @staticmethod\n    66→    def read_domain_requirements(project_path: str, feature_name: str) -> Optional[str]:\n    67→        \"\"\"Read domain-requirements.md for a feature, returning raw markdown or None.\"\"\"\n    68→        req_file = Path(project_path) / \".vista\" / \"features\" / feature_name / \"domain-requirements.md\"\n    69→        if not req_file.exists():\n    70→            return None\n    71→        try:\n    72→            content = req_file.read_text(encoding=\"utf-8\")\n    73→            return content if content.strip() else None\n    74→        except OSError:\n    75→            return None\n    76→\n    77→    @staticmethod\n    78→    def read_arch_file(project_path: str, feature_name: str, filename: str) -> Optional[str]:\n    79→        \"\"\"Read a specific diagram file from arch/ with path traversal prevention.\"\"\"\n    80→        # Prevent path traversal\n    81→        safe_name = Path(filename).name\n    82→        if safe_name != filename or \"..\" in filename:\n    83→            return None\n    84→\n    85→        arch_dir = Path(project_path) / \".vista\" / \"features\" / feature_name / \"arch\"\n    86→        target = arch_dir / safe_name\n    87→\n    88→        # Ensure resolved path is within arch_dir\n    89→        try:\n    90→            target.resolve().relative_to(arch_dir.resolve())\n    91→        except ValueError:\n    92→            return None\n    93→\n    94→        if not target.exists():\n    95→            return None\n    96→\n    97→        return target.read_text(encoding=\"utf-8\")\n    98→\n    99→    @staticmethod\n   100→    def write_arch_file(project_path: str, feature_name: str, filename: str, content: str) -> bool:\n   101→        \"\"\"Write content to a diagram file in arch/ with path traversal prevention.\n   102→\n   103→        Only allows writing to files with extensions: .md\n   104→        Returns True on success, False on validation failure.\n   105→        \"\"\"\n   106→        WRITABLE_EXTENSIONS = {\".md\"}\n   107→\n   108→        safe_name = Path(filename).name\n   109→        if safe_name != filename or \"..\" in filename:\n   110→            return False\n   111→\n   112→        if Path(safe_name).suffix not in WRITABLE_EXTENSIONS:\n   113→            return False\n   114→\n   115→        arch_dir = Path(project_path) / \".vista\" / \"features\" / feature_name / \"arch\"\n   116→        target = arch_dir / safe_name\n   117→\n   118→        try:\n   119→            target.resolve().relative_to(arch_dir.resolve())\n   120→        except ValueError:\n   121→            return False\n   122→\n   123→        if not arch_dir.exists():\n   124→            return False\n   125→\n   126→        target.write_text(content, encoding=\"utf-8\")\n   127→        return True\n   128→"}]},"parent_tool_use_id":null,"session_id":"99d2dbda-9327-4d38-9974-87ec95f217c6","uuid":"d6205135-c730-4965-9c55-78ccbb521356","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/services/progress_service.py","content":"\"\"\"Read progress.txt, IMPLEMENTATION_PLAN.md, and architecture manifests from feature directories.\"\"\"\nimport json\nfrom pathlib import Path\nfrom typing import Optional\n\n\nclass ProgressService:\n\n    @staticmethod\n    def read_progress(project_path: str, feature_name: str) -> dict:\n        \"\"\"Read and parse progress.txt for a feature.\"\"\"\n        import re\n        feature_dir = Path(project_path) / \".vista\" / \"features\" / feature_name\n        progress_file = feature_dir / \"progress.txt\"\n\n        if not progress_file.exists():\n            return {\"exists\": False, \"content\": \"\", \"all_complete\": False}\n\n        content = progress_file.read_text(encoding=\"utf-8\")\n\n        # Extract phase info\n        phase_match = re.search(r\"Phase:\\s*(\\w+)\", content)\n        current_phase_match = re.search(r\"CurrentPhase:\\s*(\\d+)\", content)\n\n        return {\n            \"exists\": True,\n            \"content\": content,\n            \"phase\": phase_match.group(1) if phase_match else None,\n            \"current_phase\": int(current_phase_match.group(1)) if current_phase_match else None,\n            \"all_complete\": content.strip().startswith(\"ALL PHASES COMPLETE\")\n                           or \"ALL PHASES COMPLETE\" in content,\n        }\n\n    @staticmethod\n    def read_implementation_plan(project_path: str, feature_name: str) -> Optional[str]:\n        \"\"\"Read IMPLEMENTATION_PLAN.md if it exists.\"\"\"\n        plan_file = Path(project_path) / \".vista\" / \"features\" / feature_name / \"IMPLEMENTATION_PLAN.md\"\n        if plan_file.exists():\n            return plan_file.read_text(encoding=\"utf-8\")\n        return None\n\n    @staticmethod\n    def read_agents_md(project_path: str, feature_name: str) -> Optional[str]:\n        \"\"\"Read AGENTS.md if it exists.\"\"\"\n        agents_file = Path(project_path) / \".vista\" / \"features\" / feature_name / \"AGENTS.md\"\n        if agents_file.exists():\n            return agents_file.read_text(encoding=\"utf-8\")\n        return None\n\n    @staticmethod\n    def read_arch_manifest(project_path: str, feature_name: str) -> Optional[dict]:\n        \"\"\"Read arch/_arch.json manifest for a feature.\"\"\"\n        arch_file = Path(project_path) / \".vista\" / \"features\" / feature_name / \"arch\" / \"_arch.json\"\n        if not arch_file.exists():\n            return None\n        try:\n            data = json.loads(arch_file.read_text(encoding=\"utf-8\"))\n            # Normalize legacy format: bare list -> dict with \"diagrams\" key\n            if isinstance(data, list):\n                data = {\"feature\": feature_name, \"diagrams\": data}\n            return data\n        except (json.JSONDecodeError, OSError):\n            return None\n\n    @staticmethod\n    def read_domain_requirements(project_path: str, feature_name: str) -> Optional[str]:\n        \"\"\"Read domain-requirements.md for a feature, returning raw markdown or None.\"\"\"\n        req_file = Path(project_path) / \".vista\" / \"features\" / feature_name / \"domain-requirements.md\"\n        if not req_file.exists():\n            return None\n        try:\n            content = req_file.read_text(encoding=\"utf-8\")\n            return content if content.strip() else None\n        except OSError:\n            return None\n\n    @staticmethod\n    def read_arch_file(project_path: str, feature_name: str, filename: str) -> Optional[str]:\n        \"\"\"Read a specific diagram file from arch/ with path traversal prevention.\"\"\"\n        # Prevent path traversal\n        safe_name = Path(filename).name\n        if safe_name != filename or \"..\" in filename:\n            return None\n\n        arch_dir = Path(project_path) / \".vista\" / \"features\" / feature_name / \"arch\"\n        target = arch_dir / safe_name\n\n        # Ensure resolved path is within arch_dir\n        try:\n            target.resolve().relative_to(arch_dir.resolve())\n        except ValueError:\n            return None\n\n        if not target.exists():\n            return None\n\n        return target.read_text(encoding=\"utf-8\")\n\n    @staticmethod\n    def write_arch_file(project_path: str, feature_name: str, filename: str, content: str) -> bool:\n        \"\"\"Write content to a diagram file in arch/ with path traversal prevention.\n\n        Only allows writing to files with extensions: .md\n        Returns True on success, False on validation failure.\n        \"\"\"\n        WRITABLE_EXTENSIONS = {\".md\"}\n\n        safe_name = Path(filename).name\n        if safe_name != filename or \"..\" in filename:\n            return False\n\n        if Path(safe_name).suffix not in WRITABLE_EXTENSIONS:\n            return False\n\n        arch_dir = Path(project_path) / \".vista\" / \"features\" / feature_name / \"arch\"\n        target = arch_dir / safe_name\n\n        try:\n            target.resolve().relative_to(arch_dir.resolve())\n        except ValueError:\n            return False\n\n        if not arch_dir.exists():\n            return False\n\n        target.write_text(content, encoding=\"utf-8\")\n        return True\n","numLines":128,"startLine":1,"totalLines":128}}}
