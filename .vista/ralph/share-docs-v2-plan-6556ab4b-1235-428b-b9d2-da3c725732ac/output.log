{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0191JVEhPF9o3uCYhq6uNVSC","type":"tool_result","content":"     1→\"\"\"Export service for generating self-contained HTML documentation.\"\"\"\n     2→import logging\n     3→from datetime import datetime\n     4→from pathlib import Path\n     5→\n     6→import jinja2\n     7→\n     8→from server import config\n     9→from server.services.progress_service import ProgressService\n    10→\n    11→logger = logging.getLogger(__name__)\n    12→\n    13→\n    14→class ExportService:\n    15→    @staticmethod\n    16→    def get_exportable_features(project_path: str) -> list[dict]:\n    17→        \"\"\"Return features with their diagrams and requirements availability.\n    18→\n    19→        Scans .vista/features/ for features that have at least one diagram\n    20→        OR non-empty domain-requirements.md.\n    21→        \"\"\"\n    22→        features_dir = Path(project_path) / \".vista\" / \"features\"\n    23→        if not features_dir.exists():\n    24→            return []\n    25→\n    26→        results = []\n    27→        for d in sorted(features_dir.iterdir()):\n    28→            if not d.is_dir() or d.name.startswith(\"_\"):\n    29→                continue\n    30→\n    31→            manifest = ProgressService.read_arch_manifest(project_path, d.name)\n    32→            diagrams = manifest.get(\"diagrams\", []) if manifest else []\n    33→            has_requirements = ProgressService.read_domain_requirements(project_path, d.name) is not None\n    34→\n    35→            if not diagrams and not has_requirements:\n    36→                continue\n    37→\n    38→            results.append({\n    39→                \"name\": d.name,\n    40→                \"has_requirements\": has_requirements,\n    41→                \"diagrams\": [\n    42→                    {\n    43→                        \"name\": diag.get(\"name\", diag.get(\"file\", \"\")),\n    44→                        \"file\": diag[\"file\"],\n    45→                        \"type\": diag.get(\"type\", \"mermaid\"),\n    46→                        \"description\": diag.get(\"description\", \"\"),\n    47→                        \"category\": diag.get(\"category\", \"architecture\"),\n    48→                    }\n    49→                    for diag in diagrams\n    50→                    if \"file\" in diag\n    51→                ],\n    52→            })\n    53→        return results\n    54→\n    55→    @staticmethod\n    56→    def generate_export_html(\n    57→        project_name: str,\n    58→        project_path: str,\n    59→        selected_features: list[dict],\n    60→    ) -> str:\n    61→        \"\"\"Generate self-contained HTML export.\n    62→\n    63→        For each selected feature:\n    64→        1. Read _arch.json manifest\n    65→        2. Filter diagrams to only those selected\n    66→        3. Read .mmd content for each selected diagram\n    67→        4. Read domain-requirements.md\n    68→        5. Assemble into template context and render\n    69→\n    70→        Returns rendered HTML string.\n    71→        \"\"\"\n    72→        features_data = []\n    73→\n    74→        for selection in selected_features:\n    75→            feature_name = selection[\"name\"]\n    76→            selected_diagram_files = selection[\"diagrams\"]\n    77→\n    78→            manifest = ProgressService.read_arch_manifest(project_path, feature_name)\n    79→            all_diagrams = manifest.get(\"diagrams\", []) if manifest else []\n    80→\n    81→            diagram_data = []\n    82→            for diag in all_diagrams:\n    83→                if diag.get(\"file\") not in selected_diagram_files:\n    84→                    continue\n    85→                content = ProgressService.read_arch_file(\n    86→                    project_path, feature_name, diag[\"file\"]\n    87→                )\n    88→                if content is None:\n    89→                    logger.warning(\n    90→                        \"Skipping missing diagram %s/%s\", feature_name, diag[\"file\"]\n    91→                    )\n    92→                    continue\n    93→                diagram_data.append({\n    94→                    \"name\": diag.get(\"name\", diag[\"file\"]),\n    95→                    \"file\": diag[\"file\"],\n    96→                    \"description\": diag.get(\"description\", \"\"),\n    97→                    \"category\": diag.get(\"category\", \"architecture\"),\n    98→                    \"content\": content,\n    99→                })\n   100→\n   101→            requirements_md = ProgressService.read_domain_requirements(\n   102→                project_path, feature_name\n   103→            )\n   104→\n   105→            if not diagram_data and not requirements_md:\n   106→                continue\n   107→\n   108→            features_data.append({\n   109→                \"name\": feature_name,\n   110→                \"diagrams\": diagram_data,\n   111→                \"requirements_md\": requirements_md,\n   112→            })\n   113→\n   114→        # Build the export_data JSON blob for client-side rendering.\n   115→        # Diagram IDs match the template pattern: \"{feature_index}-{diagram_index}\"\n   116→        export_diagrams = []\n   117→        export_requirements = {}\n   118→        for fi, feature in enumerate(features_data):\n   119→            for di, diagram in enumerate(feature[\"diagrams\"]):\n   120→                export_diagrams.append({\n   121→                    \"id\": f\"{fi}-{di}\",\n   122→                    \"content\": diagram[\"content\"],\n   123→                    \"name\": diagram[\"name\"],\n   124→                })\n   125→            if feature.get(\"requirements_md\"):\n   126→                export_requirements[feature[\"name\"]] = feature[\"requirements_md\"]\n   127→\n   128→        export_data = {\n   129→            \"diagrams\": export_diagrams,\n   130→            \"requirements\": export_requirements,\n   131→        }\n   132→\n   133→        env = jinja2.Environment(\n   134→            loader=jinja2.FileSystemLoader(str(config.VIEWS_DIR)),\n   135→            autoescape=True,\n   136→        )\n   137→        template = env.get_template(\"export.html\")\n   138→\n   139→        return template.render(\n   140→            project_name=project_name,\n   141→            export_date=datetime.now().strftime(\"%Y-%m-%d\"),\n   142→            features=features_data,\n   143→            export_data=export_data,\n   144→        )\n   145→"}]},"parent_tool_use_id":null,"session_id":"99d2dbda-9327-4d38-9974-87ec95f217c6","uuid":"af9fa6c4-7682-4501-a57b-a6d20f694160","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/services/export_service.py","content":"\"\"\"Export service for generating self-contained HTML documentation.\"\"\"\nimport logging\nfrom datetime import datetime\nfrom pathlib import Path\n\nimport jinja2\n\nfrom server import config\nfrom server.services.progress_service import ProgressService\n\nlogger = logging.getLogger(__name__)\n\n\nclass ExportService:\n    @staticmethod\n    def get_exportable_features(project_path: str) -> list[dict]:\n        \"\"\"Return features with their diagrams and requirements availability.\n\n        Scans .vista/features/ for features that have at least one diagram\n        OR non-empty domain-requirements.md.\n        \"\"\"\n        features_dir = Path(project_path) / \".vista\" / \"features\"\n        if not features_dir.exists():\n            return []\n\n        results = []\n        for d in sorted(features_dir.iterdir()):\n            if not d.is_dir() or d.name.startswith(\"_\"):\n                continue\n\n            manifest = ProgressService.read_arch_manifest(project_path, d.name)\n            diagrams = manifest.get(\"diagrams\", []) if manifest else []\n            has_requirements = ProgressService.read_domain_requirements(project_path, d.name) is not None\n\n            if not diagrams and not has_requirements:\n                continue\n\n            results.append({\n                \"name\": d.name,\n                \"has_requirements\": has_requirements,\n                \"diagrams\": [\n                    {\n                        \"name\": diag.get(\"name\", diag.get(\"file\", \"\")),\n                        \"file\": diag[\"file\"],\n                        \"type\": diag.get(\"type\", \"mermaid\"),\n                        \"description\": diag.get(\"description\", \"\"),\n                        \"category\": diag.get(\"category\", \"architecture\"),\n                    }\n                    for diag in diagrams\n                    if \"file\" in diag\n                ],\n            })\n        return results\n\n    @staticmethod\n    def generate_export_html(\n        project_name: str,\n        project_path: str,\n        selected_features: list[dict],\n    ) -> str:\n        \"\"\"Generate self-contained HTML export.\n\n        For each selected feature:\n        1. Read _arch.json manifest\n        2. Filter diagrams to only those selected\n        3. Read .mmd content for each selected diagram\n        4. Read domain-requirements.md\n        5. Assemble into template context and render\n\n        Returns rendered HTML string.\n        \"\"\"\n        features_data = []\n\n        for selection in selected_features:\n            feature_name = selection[\"name\"]\n            selected_diagram_files = selection[\"diagrams\"]\n\n            manifest = ProgressService.read_arch_manifest(project_path, feature_name)\n            all_diagrams = manifest.get(\"diagrams\", []) if manifest else []\n\n            diagram_data = []\n            for diag in all_diagrams:\n                if diag.get(\"file\") not in selected_diagram_files:\n                    continue\n                content = ProgressService.read_arch_file(\n                    project_path, feature_name, diag[\"file\"]\n                )\n                if content is None:\n                    logger.warning(\n                        \"Skipping missing diagram %s/%s\", feature_name, diag[\"file\"]\n                    )\n                    continue\n                diagram_data.append({\n                    \"name\": diag.get(\"name\", diag[\"file\"]),\n                    \"file\": diag[\"file\"],\n                    \"description\": diag.get(\"description\", \"\"),\n                    \"category\": diag.get(\"category\", \"architecture\"),\n                    \"content\": content,\n                })\n\n            requirements_md = ProgressService.read_domain_requirements(\n                project_path, feature_name\n            )\n\n            if not diagram_data and not requirements_md:\n                continue\n\n            features_data.append({\n                \"name\": feature_name,\n                \"diagrams\": diagram_data,\n                \"requirements_md\": requirements_md,\n            })\n\n        # Build the export_data JSON blob for client-side rendering.\n        # Diagram IDs match the template pattern: \"{feature_index}-{diagram_index}\"\n        export_diagrams = []\n        export_requirements = {}\n        for fi, feature in enumerate(features_data):\n            for di, diagram in enumerate(feature[\"diagrams\"]):\n                export_diagrams.append({\n                    \"id\": f\"{fi}-{di}\",\n                    \"content\": diagram[\"content\"],\n                    \"name\": diagram[\"name\"],\n                })\n            if feature.get(\"requirements_md\"):\n                export_requirements[feature[\"name\"]] = feature[\"requirements_md\"]\n\n        export_data = {\n            \"diagrams\": export_diagrams,\n            \"requirements\": export_requirements,\n        }\n\n        env = jinja2.Environment(\n            loader=jinja2.FileSystemLoader(str(config.VIEWS_DIR)),\n            autoescape=True,\n        )\n        template = env.get_template(\"export.html\")\n\n        return template.render(\n            project_name=project_name,\n            export_date=datetime.now().strftime(\"%Y-%m-%d\"),\n            features=features_data,\n            export_data=export_data,\n        )\n","numLines":145,"startLine":1,"totalLines":145}}}
