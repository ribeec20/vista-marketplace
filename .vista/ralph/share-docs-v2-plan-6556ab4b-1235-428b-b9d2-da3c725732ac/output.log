{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016tNdhmmcBhpFPTECpLmGg9","type":"tool_result","content":"     1→\"\"\"Tests for export_service and export routes.\"\"\"\n     2→\n     3→import json\n     4→from pathlib import Path\n     5→\n     6→import pytest\n     7→\n     8→\n     9→def _setup_feature(project_path: Path, feature_name: str, diagrams=None, requirements=None):\n    10→    \"\"\"Create a feature directory with optional arch manifest, diagrams, and requirements.\"\"\"\n    11→    feature_dir = project_path / \".vista\" / \"features\" / feature_name\n    12→    feature_dir.mkdir(parents=True, exist_ok=True)\n    13→\n    14→    if diagrams is not None:\n    15→        arch_dir = feature_dir / \"arch\"\n    16→        arch_dir.mkdir(exist_ok=True)\n    17→        manifest = {\"feature\": feature_name, \"diagrams\": []}\n    18→        for d in diagrams:\n    19→            manifest[\"diagrams\"].append({\n    20→                \"name\": d[\"name\"],\n    21→                \"file\": d[\"file\"],\n    22→                \"type\": d.get(\"type\", \"mermaid\"),\n    23→                \"description\": d.get(\"description\", \"\"),\n    24→                \"category\": d.get(\"category\", \"architecture\"),\n    25→            })\n    26→            if \"content\" in d:\n    27→                (arch_dir / d[\"file\"]).write_text(d[\"content\"], encoding=\"utf-8\")\n    28→        (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n    29→\n    30→    if requirements is not None:\n    31→        (feature_dir / \"domain-requirements.md\").write_text(requirements, encoding=\"utf-8\")\n    32→\n    33→\n    34→class TestProgressServiceReadDomainRequirements:\n    35→    def test_returns_content_when_file_exists(self, tmp_path):\n    36→        from server.services.progress_service import ProgressService\n    37→\n    38→        _setup_feature(tmp_path, \"my_feature\", requirements=\"# Requirements\\n- Req 1\")\n    39→        result = ProgressService.read_domain_requirements(str(tmp_path), \"my_feature\")\n    40→        assert result is not None\n    41→        assert \"Req 1\" in result\n    42→\n    43→    def test_returns_none_when_file_missing(self, tmp_path):\n    44→        from server.services.progress_service import ProgressService\n    45→\n    46→        feature_dir = tmp_path / \".vista\" / \"features\" / \"no_reqs\"\n    47→        feature_dir.mkdir(parents=True)\n    48→        result = ProgressService.read_domain_requirements(str(tmp_path), \"no_reqs\")\n    49→        assert result is None\n    50→\n    51→    def test_returns_none_when_file_empty(self, tmp_path):\n    52→        from server.services.progress_service import ProgressService\n    53→\n    54→        _setup_feature(tmp_path, \"empty_feature\", requirements=\"   \\n  \")\n    55→        result = ProgressService.read_domain_requirements(str(tmp_path), \"empty_feature\")\n    56→        assert result is None\n    57→\n    58→\n    59→class TestExportServiceGetExportableFeatures:\n    60→    def test_returns_features_with_diagrams(self, tmp_path):\n    61→        from server.services.export_service import ExportService\n    62→\n    63→        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n    64→            {\"name\": \"System Arch\", \"file\": \"system-arch.mmd\", \"content\": \"graph TD; A-->B\"},\n    65→        ])\n    66→        result = ExportService.get_exportable_features(str(tmp_path))\n    67→        assert len(result) == 1\n    68→        assert result[0][\"name\"] == \"feat_a\"\n    69→        assert len(result[0][\"diagrams\"]) == 1\n    70→        assert result[0][\"diagrams\"][0][\"file\"] == \"system-arch.mmd\"\n    71→\n    72→    def test_excludes_empty_features(self, tmp_path):\n    73→        from server.services.export_service import ExportService\n    74→\n    75→        # Feature with no diagrams and no requirements\n    76→        feature_dir = tmp_path / \".vista\" / \"features\" / \"empty_feat\"\n    77→        feature_dir.mkdir(parents=True)\n    78→        result = ExportService.get_exportable_features(str(tmp_path))\n    79→        assert len(result) == 0\n    80→\n    81→    def test_includes_requirements_only_feature(self, tmp_path):\n    82→        from server.services.export_service import ExportService\n    83→\n    84→        _setup_feature(tmp_path, \"reqs_only\", requirements=\"# Reqs\\n- Item 1\")\n    85→        result = ExportService.get_exportable_features(str(tmp_path))\n    86→        assert len(result) == 1\n    87→        assert result[0][\"name\"] == \"reqs_only\"\n    88→        assert result[0][\"has_requirements\"] is True\n    89→        assert len(result[0][\"diagrams\"]) == 0\n    90→\n    91→    def test_skips_underscore_prefixed_dirs(self, tmp_path):\n    92→        from server.services.export_service import ExportService\n    93→\n    94→        _setup_feature(tmp_path, \"_planning\", requirements=\"# Planning\\n- Internal\")\n    95→        result = ExportService.get_exportable_features(str(tmp_path))\n    96→        assert len(result) == 0\n    97→\n    98→    def test_returns_empty_when_no_features_dir(self, tmp_path):\n    99→        from server.services.export_service import ExportService\n   100→\n   101→        result = ExportService.get_exportable_features(str(tmp_path))\n   102→        assert result == []\n   103→\n   104→\n   105→class TestExportServiceGenerateHtml:\n   106→    def test_basic_export(self, tmp_path):\n   107→        from server.services.export_service import ExportService\n   108→\n   109→        _setup_feature(tmp_path, \"my_feature\", diagrams=[\n   110→            {\"name\": \"Overview\", \"file\": \"overview.mmd\", \"content\": \"graph TD; A-->B\"},\n   111→        ], requirements=\"# Requirements\\n- Item 1\")\n   112→\n   113→        html = ExportService.generate_export_html(\n   114→            project_name=\"TestProject\",\n   115→            project_path=str(tmp_path),\n   116→            selected_features=[{\"name\": \"my_feature\", \"diagrams\": [\"overview.mmd\"]}],\n   117→        )\n   118→\n   119→        assert \"TestProject\" in html\n   120→        assert \"mermaid\" in html.lower()\n   121→        assert \"graph TD\" in html\n   122→        assert \"Requirements\" in html\n   123→\n   124→    def test_multiple_features(self, tmp_path):\n   125→        from server.services.export_service import ExportService\n   126→\n   127→        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n   128→            {\"name\": \"Arch A\", \"file\": \"arch-a.mmd\", \"content\": \"graph LR; A-->B\"},\n   129→        ])\n   130→        _setup_feature(tmp_path, \"feat_b\", diagrams=[\n   131→            {\"name\": \"Arch B\", \"file\": \"arch-b.mmd\", \"content\": \"graph LR; C-->D\"},\n   132→        ])\n   133→\n   134→        html = ExportService.generate_export_html(\n   135→            project_name=\"MultiProject\",\n   136→            project_path=str(tmp_path),\n   137→            selected_features=[\n   138→                {\"name\": \"feat_a\", \"diagrams\": [\"arch-a.mmd\"]},\n   139→                {\"name\": \"feat_b\", \"diagrams\": [\"arch-b.mmd\"]},\n   140→            ],\n   141→        )\n   142→\n   143→        assert \"feat_a\" in html\n   144→        assert \"feat_b\" in html\n   145→        # Navigation should be present for multiple features\n   146→        assert 'href=\"#feature-feat_a\"' in html\n   147→        assert 'href=\"#feature-feat_b\"' in html\n   148→\n   149→    def test_missing_diagram_file_skipped(self, tmp_path):\n   150→        from server.services.export_service import ExportService\n   151→\n   152→        _setup_feature(tmp_path, \"feat_c\", diagrams=[\n   153→            {\"name\": \"Exists\", \"file\": \"exists.mmd\", \"content\": \"graph TD; X-->Y\"},\n   154→            {\"name\": \"Missing\", \"file\": \"missing.mmd\"},  # no content = no file on disk\n   155→        ])\n   156→\n   157→        html = ExportService.generate_export_html(\n   158→            project_name=\"Test\",\n   159→            project_path=str(tmp_path),\n   160→            selected_features=[{\"name\": \"feat_c\", \"diagrams\": [\"exists.mmd\", \"missing.mmd\"]}],\n   161→        )\n   162→\n   163→        # Diagram content is embedded as JSON, so check for escaped version\n   164→        assert \"graph TD; X\" in html\n   165→        assert \"Exists\" in html\n   166→        # The missing diagram should be skipped gracefully\n   167→        assert \"Test\" in html\n   168→\n   169→    def test_missing_manifest_includes_requirements(self, tmp_path):\n   170→        from server.services.export_service import ExportService\n   171→\n   172→        # Feature with requirements but no _arch.json\n   173→        _setup_feature(tmp_path, \"reqs_feat\", requirements=\"# Domain Reqs\\n- Important thing\")\n   174→\n   175→        html = ExportService.generate_export_html(\n   176→            project_name=\"ReqsTest\",\n   177→            project_path=str(tmp_path),\n   178→            selected_features=[{\"name\": \"reqs_feat\", \"diagrams\": []}],\n   179→        )\n   180→\n   181→        assert \"Important thing\" in html\n   182→        assert \"ReqsTest\" in html\n   183→\n   184→    def test_empty_selection_returns_minimal_html(self, tmp_path):\n   185→        from server.services.export_service import ExportService\n   186→\n   187→        html = ExportService.generate_export_html(\n   188→            project_name=\"Empty\",\n   189→            project_path=str(tmp_path),\n   190→            selected_features=[],\n   191→        )\n   192→\n   193→        assert \"Empty\" in html\n   194→        assert \"<!DOCTYPE html>\" in html\n   195→\n   196→\n   197→class TestExportRoutes:\n   198→    @pytest.fixture\n   199→    def client(self, tmp_path):\n   200→        \"\"\"Create a test client with a registered project.\"\"\"\n   201→        from unittest.mock import patch, MagicMock\n   202→\n   203→        # Setup test feature\n   204→        _setup_feature(tmp_path, \"test_feature\", diagrams=[\n   205→            {\"name\": \"Test Diagram\", \"file\": \"test.mmd\", \"content\": \"graph TD; A-->B\"},\n   206→        ], requirements=\"# Test Requirements\")\n   207→\n   208→        mock_project = MagicMock()\n   209→        mock_project.id = \"test-123\"\n   210→        mock_project.name = \"TestProject\"\n   211→        mock_project.path = str(tmp_path)\n   212→\n   213→        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n   214→            mock_ps.get_by_id.return_value = mock_project\n   215→\n   216→            from fastapi.testclient import TestClient\n   217→            from fastapi import FastAPI\n   218→\n   219→            app = FastAPI()\n   220→            from server.routes.export import router\n   221→            app.include_router(router)\n   222→\n   223→            yield TestClient(app), mock_ps\n   224→\n   225→    def test_get_export_features(self, client):\n   226→        test_client, _ = client\n   227→        resp = test_client.get(\"/api/projects/test-123/export/features\")\n   228→        assert resp.status_code == 200\n   229→        data = resp.json()\n   230→        assert len(data) == 1\n   231→        assert data[0][\"name\"] == \"test_feature\"\n   232→        assert len(data[0][\"diagrams\"]) == 1\n   233→\n   234→    def test_post_export(self, client):\n   235→        test_client, _ = client\n   236→        resp = test_client.post(\"/api/projects/test-123/export\", json={\n   237→            \"features\": [{\"name\": \"test_feature\", \"diagrams\": [\"test.mmd\"]}]\n   238→        })\n   239→        assert resp.status_code == 200\n   240→        assert \"Content-Disposition\" in resp.headers\n   241→        assert \"TestProject\" in resp.headers[\"Content-Disposition\"]\n   242→        assert \"<!DOCTYPE html>\" in resp.text\n   243→\n   244→    def test_post_export_invalid_project(self, tmp_path):\n   245→        from unittest.mock import patch\n   246→        from fastapi.testclient import TestClient\n   247→        from fastapi import FastAPI\n   248→\n   249→        app = FastAPI()\n   250→        from server.routes.export import router\n   251→        app.include_router(router)\n   252→\n   253→        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n   254→            mock_ps.get_by_id.return_value = None\n   255→            test_client = TestClient(app)\n   256→            resp = test_client.post(\"/api/projects/nonexistent/export\", json={\n   257→                \"features\": [{\"name\": \"x\", \"diagrams\": []}]\n   258→            })\n   259→            assert resp.status_code == 404\n   260→"}]},"parent_tool_use_id":null,"session_id":"99d2dbda-9327-4d38-9974-87ec95f217c6","uuid":"1bf361f0-9c3c-46f4-91d4-198f14b6873a","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/tests/test_export_service.py","content":"\"\"\"Tests for export_service and export routes.\"\"\"\n\nimport json\nfrom pathlib import Path\n\nimport pytest\n\n\ndef _setup_feature(project_path: Path, feature_name: str, diagrams=None, requirements=None):\n    \"\"\"Create a feature directory with optional arch manifest, diagrams, and requirements.\"\"\"\n    feature_dir = project_path / \".vista\" / \"features\" / feature_name\n    feature_dir.mkdir(parents=True, exist_ok=True)\n\n    if diagrams is not None:\n        arch_dir = feature_dir / \"arch\"\n        arch_dir.mkdir(exist_ok=True)\n        manifest = {\"feature\": feature_name, \"diagrams\": []}\n        for d in diagrams:\n            manifest[\"diagrams\"].append({\n                \"name\": d[\"name\"],\n                \"file\": d[\"file\"],\n                \"type\": d.get(\"type\", \"mermaid\"),\n                \"description\": d.get(\"description\", \"\"),\n                \"category\": d.get(\"category\", \"architecture\"),\n            })\n            if \"content\" in d:\n                (arch_dir / d[\"file\"]).write_text(d[\"content\"], encoding=\"utf-8\")\n        (arch_dir / \"_arch.json\").write_text(json.dumps(manifest), encoding=\"utf-8\")\n\n    if requirements is not None:\n        (feature_dir / \"domain-requirements.md\").write_text(requirements, encoding=\"utf-8\")\n\n\nclass TestProgressServiceReadDomainRequirements:\n    def test_returns_content_when_file_exists(self, tmp_path):\n        from server.services.progress_service import ProgressService\n\n        _setup_feature(tmp_path, \"my_feature\", requirements=\"# Requirements\\n- Req 1\")\n        result = ProgressService.read_domain_requirements(str(tmp_path), \"my_feature\")\n        assert result is not None\n        assert \"Req 1\" in result\n\n    def test_returns_none_when_file_missing(self, tmp_path):\n        from server.services.progress_service import ProgressService\n\n        feature_dir = tmp_path / \".vista\" / \"features\" / \"no_reqs\"\n        feature_dir.mkdir(parents=True)\n        result = ProgressService.read_domain_requirements(str(tmp_path), \"no_reqs\")\n        assert result is None\n\n    def test_returns_none_when_file_empty(self, tmp_path):\n        from server.services.progress_service import ProgressService\n\n        _setup_feature(tmp_path, \"empty_feature\", requirements=\"   \\n  \")\n        result = ProgressService.read_domain_requirements(str(tmp_path), \"empty_feature\")\n        assert result is None\n\n\nclass TestExportServiceGetExportableFeatures:\n    def test_returns_features_with_diagrams(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n            {\"name\": \"System Arch\", \"file\": \"system-arch.mmd\", \"content\": \"graph TD; A-->B\"},\n        ])\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        assert result[0][\"name\"] == \"feat_a\"\n        assert len(result[0][\"diagrams\"]) == 1\n        assert result[0][\"diagrams\"][0][\"file\"] == \"system-arch.mmd\"\n\n    def test_excludes_empty_features(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        # Feature with no diagrams and no requirements\n        feature_dir = tmp_path / \".vista\" / \"features\" / \"empty_feat\"\n        feature_dir.mkdir(parents=True)\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 0\n\n    def test_includes_requirements_only_feature(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"reqs_only\", requirements=\"# Reqs\\n- Item 1\")\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 1\n        assert result[0][\"name\"] == \"reqs_only\"\n        assert result[0][\"has_requirements\"] is True\n        assert len(result[0][\"diagrams\"]) == 0\n\n    def test_skips_underscore_prefixed_dirs(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"_planning\", requirements=\"# Planning\\n- Internal\")\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert len(result) == 0\n\n    def test_returns_empty_when_no_features_dir(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        result = ExportService.get_exportable_features(str(tmp_path))\n        assert result == []\n\n\nclass TestExportServiceGenerateHtml:\n    def test_basic_export(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"my_feature\", diagrams=[\n            {\"name\": \"Overview\", \"file\": \"overview.mmd\", \"content\": \"graph TD; A-->B\"},\n        ], requirements=\"# Requirements\\n- Item 1\")\n\n        html = ExportService.generate_export_html(\n            project_name=\"TestProject\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"my_feature\", \"diagrams\": [\"overview.mmd\"]}],\n        )\n\n        assert \"TestProject\" in html\n        assert \"mermaid\" in html.lower()\n        assert \"graph TD\" in html\n        assert \"Requirements\" in html\n\n    def test_multiple_features(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_a\", diagrams=[\n            {\"name\": \"Arch A\", \"file\": \"arch-a.mmd\", \"content\": \"graph LR; A-->B\"},\n        ])\n        _setup_feature(tmp_path, \"feat_b\", diagrams=[\n            {\"name\": \"Arch B\", \"file\": \"arch-b.mmd\", \"content\": \"graph LR; C-->D\"},\n        ])\n\n        html = ExportService.generate_export_html(\n            project_name=\"MultiProject\",\n            project_path=str(tmp_path),\n            selected_features=[\n                {\"name\": \"feat_a\", \"diagrams\": [\"arch-a.mmd\"]},\n                {\"name\": \"feat_b\", \"diagrams\": [\"arch-b.mmd\"]},\n            ],\n        )\n\n        assert \"feat_a\" in html\n        assert \"feat_b\" in html\n        # Navigation should be present for multiple features\n        assert 'href=\"#feature-feat_a\"' in html\n        assert 'href=\"#feature-feat_b\"' in html\n\n    def test_missing_diagram_file_skipped(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        _setup_feature(tmp_path, \"feat_c\", diagrams=[\n            {\"name\": \"Exists\", \"file\": \"exists.mmd\", \"content\": \"graph TD; X-->Y\"},\n            {\"name\": \"Missing\", \"file\": \"missing.mmd\"},  # no content = no file on disk\n        ])\n\n        html = ExportService.generate_export_html(\n            project_name=\"Test\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"feat_c\", \"diagrams\": [\"exists.mmd\", \"missing.mmd\"]}],\n        )\n\n        # Diagram content is embedded as JSON, so check for escaped version\n        assert \"graph TD; X\" in html\n        assert \"Exists\" in html\n        # The missing diagram should be skipped gracefully\n        assert \"Test\" in html\n\n    def test_missing_manifest_includes_requirements(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        # Feature with requirements but no _arch.json\n        _setup_feature(tmp_path, \"reqs_feat\", requirements=\"# Domain Reqs\\n- Important thing\")\n\n        html = ExportService.generate_export_html(\n            project_name=\"ReqsTest\",\n            project_path=str(tmp_path),\n            selected_features=[{\"name\": \"reqs_feat\", \"diagrams\": []}],\n        )\n\n        assert \"Important thing\" in html\n        assert \"ReqsTest\" in html\n\n    def test_empty_selection_returns_minimal_html(self, tmp_path):\n        from server.services.export_service import ExportService\n\n        html = ExportService.generate_export_html(\n            project_name=\"Empty\",\n            project_path=str(tmp_path),\n            selected_features=[],\n        )\n\n        assert \"Empty\" in html\n        assert \"<!DOCTYPE html>\" in html\n\n\nclass TestExportRoutes:\n    @pytest.fixture\n    def client(self, tmp_path):\n        \"\"\"Create a test client with a registered project.\"\"\"\n        from unittest.mock import patch, MagicMock\n\n        # Setup test feature\n        _setup_feature(tmp_path, \"test_feature\", diagrams=[\n            {\"name\": \"Test Diagram\", \"file\": \"test.mmd\", \"content\": \"graph TD; A-->B\"},\n        ], requirements=\"# Test Requirements\")\n\n        mock_project = MagicMock()\n        mock_project.id = \"test-123\"\n        mock_project.name = \"TestProject\"\n        mock_project.path = str(tmp_path)\n\n        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n            mock_ps.get_by_id.return_value = mock_project\n\n            from fastapi.testclient import TestClient\n            from fastapi import FastAPI\n\n            app = FastAPI()\n            from server.routes.export import router\n            app.include_router(router)\n\n            yield TestClient(app), mock_ps\n\n    def test_get_export_features(self, client):\n        test_client, _ = client\n        resp = test_client.get(\"/api/projects/test-123/export/features\")\n        assert resp.status_code == 200\n        data = resp.json()\n        assert len(data) == 1\n        assert data[0][\"name\"] == \"test_feature\"\n        assert len(data[0][\"diagrams\"]) == 1\n\n    def test_post_export(self, client):\n        test_client, _ = client\n        resp = test_client.post(\"/api/projects/test-123/export\", json={\n            \"features\": [{\"name\": \"test_feature\", \"diagrams\": [\"test.mmd\"]}]\n        })\n        assert resp.status_code == 200\n        assert \"Content-Disposition\" in resp.headers\n        assert \"TestProject\" in resp.headers[\"Content-Disposition\"]\n        assert \"<!DOCTYPE html>\" in resp.text\n\n    def test_post_export_invalid_project(self, tmp_path):\n        from unittest.mock import patch\n        from fastapi.testclient import TestClient\n        from fastapi import FastAPI\n\n        app = FastAPI()\n        from server.routes.export import router\n        app.include_router(router)\n\n        with patch(\"server.routes.export.ProjectService\") as mock_ps:\n            mock_ps.get_by_id.return_value = None\n            test_client = TestClient(app)\n            resp = test_client.post(\"/api/projects/nonexistent/export\", json={\n                \"features\": [{\"name\": \"x\", \"diagrams\": []}]\n            })\n            assert resp.status_code == 404\n","numLines":260,"startLine":1,"totalLines":260}}}
