{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0187Xh48N6oNhX2rGY1GBZK7","type":"tool_result","content":"     1→{% extends \"_base.html\" %}\n     2→\n     3→{% block title %}{{ project.name }} - Ralph Loop{% endblock %}\n     4→\n     5→{% block content %}\n     6→<div class=\"mb-8\">\n     7→    <div class=\"flex flex-wrap items-center gap-3 mb-2\">\n     8→        <a href=\"/\" class=\"text-gray-400 hover:text-gray-300\">&larr; Dashboard</a>\n     9→        <span class=\"text-gray-600\">/</span>\n    10→        <h1 class=\"text-3xl font-bold\">{{ project.name }}</h1>\n    11→        <div class=\"ml-auto flex items-center gap-2\">\n    12→            <button onclick=\"openExportModal()\"\n    13→                    class=\"px-3 py-1.5 rounded border border-blue-600 text-blue-300 hover:bg-blue-900/30 text-sm transition-colors\">\n    14→                Export Docs\n    15→            </button>\n    16→            <button onclick=\"removeProject('{{ project.id }}', '{{ project.name }}', '{{ loop_state.status }}')\"\n    17→                    class=\"px-3 py-1.5 rounded border border-gray-600 text-gray-300 hover:border-red-600 hover:text-red-300 text-sm transition-colors\">\n    18→                Remove Project\n    19→            </button>\n    20→        </div>\n    21→    </div>\n    22→    <p class=\"text-gray-400 text-sm\">{{ project.path }}</p>\n    23→</div>\n    24→\n    25→<div class=\"mb-6 border-b border-gray-700\">\n    26→    <div class=\"flex items-center gap-2\" role=\"tablist\">\n    27→        <button id=\"tab-overview-btn\" onclick=\"showProjectTab('overview')\"\n    28→                class=\"project-tab-btn px-4 py-2 text-sm rounded-t-md border border-b-0 border-gray-700 bg-gray-800 text-gray-200\">\n    29→            Overview\n    30→        </button>\n    31→        <button id=\"tab-loops-btn\" onclick=\"showProjectTab('loops')\"\n    32→                class=\"project-tab-btn px-4 py-2 text-sm rounded-t-md border border-b-0 border-gray-700 bg-gray-900 text-gray-400 hover:text-gray-200\">\n    33→            Ralph Loops\n    34→        </button>\n    35→    </div>\n    36→</div>\n    37→\n    38→<section id=\"tab-overview\" class=\"space-y-6\">\n    39→    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n    40→        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n    41→            <p class=\"text-xs text-gray-400 mb-1\">Features</p>\n    42→            <p class=\"text-2xl font-semibold\">{{ features|length }}</p>\n    43→        </div>\n    44→        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n    45→            <p class=\"text-xs text-gray-400 mb-1\">Loop Status</p>\n    46→            <p class=\"text-2xl font-semibold capitalize\">{{ loop_state.status }}</p>\n    47→        </div>\n    48→        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n    49→            <p class=\"text-xs text-gray-400 mb-1\">Docs Readiness</p>\n    50→            <p class=\"text-2xl font-semibold\">{{ features | selectattr('has_implementation_plan') | list | length }}/{{ features|length }}</p>\n    51→        </div>\n    52→    </div>\n    53→\n    54→    <div class=\"bg-gray-800 rounded-lg border border-gray-700 overflow-hidden\">\n    55→        <div class=\"px-4 py-3 border-b border-gray-700\">\n    56→            <h2 class=\"text-base font-semibold\">Feature Documentation</h2>\n    57→            <p class=\"text-xs text-gray-400 mt-1\">Overview of specs, plans, prompts, and architecture docs</p>\n    58→        </div>\n    59→\n    60→        {% if features %}\n    61→        <div class=\"divide-y divide-gray-700\">\n    62→            {% for feature in features %}\n    63→            <div class=\"px-4 py-3 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3\">\n    64→                <div>\n    65→                    <p class=\"font-medium text-gray-100\">{{ feature.name }}</p>\n    66→                    <div class=\"flex flex-wrap items-center gap-2 mt-1 text-xs\">\n    67→                        <span class=\"px-2 py-0.5 rounded border border-gray-600 text-gray-300\">Specs: {{ feature.spec_count }}</span>\n    68→                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_implementation_plan %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n    69→                            Impl Plan {% if feature.has_implementation_plan %}✓{% else %}—{% endif %}\n    70→                        </span>\n    71→                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_agents_md %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n    72→                            AGENTS.md {% if feature.has_agents_md %}✓{% else %}—{% endif %}\n    73→                        </span>\n    74→                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_prompt_build or feature.has_prompt_plan %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n    75→                            PROMPTs {% if feature.has_prompt_build or feature.has_prompt_plan %}✓{% else %}—{% endif %}\n    76→                        </span>\n    77→                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_arch_manifest %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n    78→                            Arch {% if feature.has_arch_manifest %}{{ feature.arch_diagram_count }}{% else %}—{% endif %}\n    79→                        </span>\n    80→                    </div>\n    81→                </div>\n    82→                <div class=\"flex items-center gap-2 text-xs\">\n    83→                    <a href=\"/project/{{ project.id }}/plan/{{ feature.name }}\" class=\"px-2.5 py-1 rounded bg-blue-900/50 hover:bg-blue-900/70 text-blue-300 border border-blue-800\">Implementation Plan</a>\n    84→                    {% if feature.has_arch_manifest %}\n    85→                    <a href=\"/project/{{ project.id }}/arch/{{ feature.name }}\" class=\"px-2.5 py-1 rounded bg-green-900/40 hover:bg-green-900/60 text-green-300 border border-green-800\">Architecture</a>\n    86→                    {% endif %}\n    87→                </div>\n    88→            </div>\n    89→            {% endfor %}\n    90→        </div>\n    91→        {% else %}\n    92→        <div class=\"px-4 py-8 text-gray-500 text-sm\">No features found in .vista/features/</div>\n    93→        {% endif %}\n    94→    </div>\n    95→</section>\n    96→\n    97→<section id=\"tab-loops\" class=\"hidden\">\n    98→    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n    99→        <div class=\"lg:col-span-1\">\n   100→            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mb-6\">\n   101→                <h2 class=\"text-lg font-semibold mb-4\">Loop Control</h2>\n   102→\n   103→                {% if loop_state.status in [\"running\", \"starting\"] %}\n   104→                <div class=\"space-y-3 mb-4\">\n   105→                    <div class=\"flex justify-between text-sm\">\n   106→                        <span class=\"text-gray-400\">Status</span>\n   107→                        <span class=\"text-green-400 font-medium\">{{ loop_state.status }}</span>\n   108→                    </div>\n   109→                    <div class=\"flex justify-between text-sm\">\n   110→                        <span class=\"text-gray-400\">Feature</span>\n   111→                        <span>{{ loop_state.feature_name }}</span>\n   112→                    </div>\n   113→                    <div class=\"flex justify-between text-sm\">\n   114→                        <span class=\"text-gray-400\">Provider</span>\n   115→                        <span>{{ loop_state.provider_display_name or loop_state.provider or 'Claude Code' }}</span>\n   116→                    </div>\n   117→                    <div class=\"flex justify-between text-sm\">\n   118→                        <span class=\"text-gray-400\">Mode</span>\n   119→                        <span>{{ loop_state.mode }}</span>\n   120→                    </div>\n   121→                    <div class=\"flex justify-between text-sm\">\n   122→                        <span class=\"text-gray-400\">Model</span>\n   123→                        <span>{{ loop_state.model }}</span>\n   124→                    </div>\n   125→                    <div class=\"flex justify-between text-sm\">\n   126→                        <span class=\"text-gray-400\">Iteration</span>\n   127→                        <span id=\"iteration-display\" class=\"text-green-400 font-mono\">{{ loop_state.iteration }}</span>\n   128→                    </div>\n   129→                </div>\n   130→\n   131→                <button onclick=\"stopLoop()\" class=\"w-full py-2 bg-red-800 hover:bg-red-700 rounded font-medium transition-colors\">\n   132→                    Stop Loop\n   133→                </button>\n   134→\n   135→                {% else %}\n   136→                <form id=\"start-loop-form\" class=\"space-y-4\">\n   137→                    <div>\n   138→                        <label class=\"block text-sm text-gray-400 mb-1\">Feature</label>\n   139→                        <select id=\"feature-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\">\n   140→                            {% for feature in features %}\n   141→                            <option value=\"{{ feature.name }}\">{{ feature.name }}</option>\n   142→                            {% endfor %}\n   143→                            {% if not features %}\n   144→                            <option value=\"\" disabled>No features found</option>\n   145→                            {% endif %}\n   146→                        </select>\n   147→                    </div>\n   148→\n   149→                    {% if providers|length > 1 %}\n   150→                    <div>\n   151→                        <label class=\"block text-sm text-gray-400 mb-1\">Provider</label>\n   152→                        <select id=\"provider-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\" onchange=\"onProviderChange()\">\n   153→                            {% for p in providers %}\n   154→                            <option value=\"{{ p.name }}\">{{ p.display_name }}</option>\n   155→                            {% endfor %}\n   156→                        </select>\n   157→                    </div>\n   158→                    {% else %}\n   159→                    <input type=\"hidden\" id=\"provider-select\" value=\"{{ providers[0].name if providers else 'claude' }}\">\n   160→                    {% endif %}\n   161→\n   162→                    <div>\n   163→                        <label class=\"block text-sm text-gray-400 mb-1\">Mode</label>\n   164→                        <div class=\"flex gap-2\">\n   165→                            <label class=\"flex-1 cursor-pointer\">\n   166→                                <input type=\"radio\" name=\"mode\" value=\"build\" checked class=\"hidden peer\">\n   167→                                <span class=\"block text-center py-2 rounded border border-gray-600 peer-checked:border-green-500 peer-checked:bg-green-900/30 peer-checked:text-green-400 transition-colors\">Build</span>\n   168→                            </label>\n   169→                            <label class=\"flex-1 cursor-pointer\">\n   170→                                <input type=\"radio\" name=\"mode\" value=\"plan\" class=\"hidden peer\">\n   171→                                <span class=\"block text-center py-2 rounded border border-gray-600 peer-checked:border-blue-500 peer-checked:bg-blue-900/30 peer-checked:text-blue-400 transition-colors\">Plan</span>\n   172→                            </label>\n   173→                        </div>\n   174→                    </div>\n   175→\n   176→                    <div>\n   177→                        <label class=\"block text-sm text-gray-400 mb-1\">Model</label>\n   178→                        <select id=\"model-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\"></select>\n   179→                    </div>\n   180→\n   181→                    <div>\n   182→                        <label class=\"block text-sm text-gray-400 mb-1\">Max Iterations (0 = unlimited)</label>\n   183→                        <input type=\"number\" id=\"max-iterations\" value=\"0\" min=\"0\"\n   184→                               class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\">\n   185→                    </div>\n   186→\n   187→                    <button type=\"submit\" class=\"w-full py-2 bg-green-700 hover:bg-green-600 rounded font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-green-700\"\n   188→                            {% if not features %}disabled{% endif %}>\n   189→                        Start Loop\n   190→                    </button>\n   191→                </form>\n   192→                {% endif %}\n   193→\n   194→                <div id=\"loop-error\" class=\"hidden mt-3 text-red-400 text-sm\"></div>\n   195→            </div>\n   196→        </div>\n   197→\n   198→        <div class=\"lg:col-span-2\">\n   199→            <div class=\"bg-gray-800 rounded-lg border border-gray-700 overflow-hidden\">\n   200→                <div class=\"flex items-center justify-between px-4 py-2 bg-gray-750 border-b border-gray-700\">\n   201→                    <h2 class=\"text-sm font-semibold text-gray-300\">Terminal Output</h2>\n   202→                    <div class=\"flex items-center gap-2\">\n   203→                        <span id=\"status-badge\" class=\"text-xs text-gray-500\">{{ loop_state.status }}</span>\n   204→                        <button onclick=\"clearTerminal()\" class=\"text-xs text-gray-500 hover:text-gray-300\">Clear</button>\n   205→                    </div>\n   206→                </div>\n   207→                <div id=\"terminal\" class=\"terminal-output p-4 h-[600px] overflow-y-auto font-mono text-sm leading-relaxed\">\n   208→                    <div class=\"text-gray-500\">Waiting for loop output...</div>\n   209→                </div>\n   210→            </div>\n   211→        </div>\n   212→    </div>\n   213→</section>\n   214→\n   215→<!-- Export Modal -->\n   216→<div id=\"export-modal\" class=\"fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center\">\n   217→    <div class=\"bg-gray-800 rounded-lg border border-gray-700 w-full max-w-lg max-h-[80vh] flex flex-col\">\n   218→        <div class=\"px-4 py-3 border-b border-gray-700 flex items-center justify-between\">\n   219→            <h3 class=\"font-semibold\">Export Documentation</h3>\n   220→            <button onclick=\"closeExportModal()\" class=\"text-gray-400 hover:text-white\">&times;</button>\n   221→        </div>\n   222→        <div class=\"flex-1 overflow-y-auto p-4\" id=\"export-tree\">\n   223→            <div class=\"text-gray-500 text-center py-8\">Loading features...</div>\n   224→        </div>\n   225→        <div class=\"px-4 py-3 border-t border-gray-700 flex items-center justify-between\">\n   226→            <div class=\"flex items-center gap-3\">\n   227→                <button onclick=\"selectAllExport(true)\" class=\"text-xs text-blue-400 hover:text-blue-300\">Select All</button>\n   228→                <button onclick=\"selectAllExport(false)\" class=\"text-xs text-gray-400 hover:text-gray-300\">Deselect All</button>\n   229→            </div>\n   230→            <button id=\"export-download-btn\" onclick=\"startExport()\" disabled\n   231→                    class=\"px-4 py-2 rounded bg-blue-600 hover:bg-blue-500 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed transition-colors\">\n   232→                Download\n   233→            </button>\n   234→        </div>\n   235→    </div>\n   236→</div>\n   237→{% endblock %}\n   238→\n   239→{% block scripts %}\n   240→<script>\n   241→const PROJECT_ID = '{{ project.id }}';\n   242→const LOOP_STATUS = '{{ loop_state.status }}';\n   243→\n   244→// Provider names from server (no models yet — those are fetched on-demand)\n   245→const PROVIDERS = {{ providers | tojson }};\n   246→\n   247→if (LOOP_STATUS === 'running' || LOOP_STATUS === 'starting') {\n   248→    connectSSE(PROJECT_ID);\n   249→}\n   250→\n   251→function showProjectTab(tab) {\n   252→    const overview = document.getElementById('tab-overview');\n   253→    const loops = document.getElementById('tab-loops');\n   254→    const overviewBtn = document.getElementById('tab-overview-btn');\n   255→    const loopsBtn = document.getElementById('tab-loops-btn');\n   256→\n   257→    if (tab === 'loops') {\n   258→        overview.classList.add('hidden');\n   259→        loops.classList.remove('hidden');\n   260→        overviewBtn.classList.replace('bg-gray-800', 'bg-gray-900');\n   261→        overviewBtn.classList.replace('text-gray-200', 'text-gray-400');\n   262→        loopsBtn.classList.replace('bg-gray-900', 'bg-gray-800');\n   263→        loopsBtn.classList.replace('text-gray-400', 'text-gray-200');\n   264→        window.location.hash = 'loops';\n   265→        return;\n   266→    }\n   267→\n   268→    loops.classList.add('hidden');\n   269→    overview.classList.remove('hidden');\n   270→    loopsBtn.classList.replace('bg-gray-800', 'bg-gray-900');\n   271→    loopsBtn.classList.replace('text-gray-200', 'text-gray-400');\n   272→    overviewBtn.classList.replace('bg-gray-900', 'bg-gray-800');\n   273→    overviewBtn.classList.replace('text-gray-400', 'text-gray-200');\n   274→    window.location.hash = 'overview';\n   275→}\n   276→\n   277→if (window.location.hash === '#loops') {\n   278→    showProjectTab('loops');\n   279→} else {\n   280→    showProjectTab('overview');\n   281→}\n   282→\n   283→// --- Dynamic model loading ---\n   284→\n   285→let _modelFetchId = 0;  // Guards against stale responses overwriting newer ones\n   286→\n   287→function renderModels(models) {\n   288→    const select = document.getElementById('model-select');\n   289→    if (!select) return;\n   290→    select.innerHTML = '';\n   291→    models.forEach((model) => {\n   292→        const opt = document.createElement('option');\n   293→        opt.value = model;\n   294→        opt.textContent = model;\n   295→        select.appendChild(opt);\n   296→    });\n   297→}\n   298→\n   299→function setStartEnabled(enabled) {\n   300→    const btn = document.querySelector('#start-loop-form button[type=\"submit\"]');\n   301→    if (btn) btn.disabled = !enabled;\n   302→}\n   303→\n   304→function setModelLoading() {\n   305→    const select = document.getElementById('model-select');\n   306→    if (!select) return;\n   307→    select.innerHTML = '<option disabled selected>Loading models...</option>';\n   308→    setStartEnabled(false);\n   309→}\n   310→\n   311→async function fetchModels(providerName) {\n   312→    const thisId = ++_modelFetchId;\n   313→    setModelLoading();\n   314→    try {\n   315→        const resp = await fetch(`/api/providers/${providerName}/models`);\n   316→        if (thisId !== _modelFetchId) return;  // Stale response, user switched provider\n   317→        if (!resp.ok) throw new Error('Failed to fetch models');\n   318→        const data = await resp.json();\n   319→        if (thisId !== _modelFetchId) return;\n   320→        if (data.error) {\n   321→            // Server returned models but with an error (e.g. timeout)\n   322→            const select = document.getElementById('model-select');\n   323→            if (select) select.innerHTML = '<option disabled selected>Timed out - click retry</option>';\n   324→            setStartEnabled(false);\n   325→            return;\n   326→        }\n   327→        renderModels(data.models);\n   328→        setStartEnabled(data.models.length > 0);\n   329→    } catch (err) {\n   330→        if (thisId !== _modelFetchId) return;\n   331→        const select = document.getElementById('model-select');\n   332→        if (select) select.innerHTML = '<option disabled selected>Failed to load - click retry</option>';\n   333→        setStartEnabled(false);\n   334→    }\n   335→}\n   336→\n   337→function getSelectedProvider() {\n   338→    const sel = document.getElementById('provider-select');\n   339→    return sel ? sel.value : 'claude';\n   340→}\n   341→\n   342→function onProviderChange() {\n   343→    fetchModels(getSelectedProvider());\n   344→}\n   345→\n   346→if (document.getElementById('start-loop-form') && PROVIDERS.length > 0) {\n   347→    fetchModels(PROVIDERS[0].name);\n   348→}\n   349→\n   350→// --- Form submission ---\n   351→\n   352→document.getElementById('start-loop-form')?.addEventListener('submit', async function(e) {\n   353→    e.preventDefault();\n   354→    const errorEl = document.getElementById('loop-error');\n   355→    errorEl.classList.add('hidden');\n   356→\n   357→    const body = {\n   358→        feature_name: document.getElementById('feature-select').value,\n   359→        mode: document.querySelector('input[name=\"mode\"]:checked').value,\n   360→        model: document.getElementById('model-select').value,\n   361→        provider: getSelectedProvider(),\n   362→        max_iterations: parseInt(document.getElementById('max-iterations').value) || 0,\n   363→    };\n   364→\n   365→    try {\n   366→        const resp = await fetch(`/api/projects/${PROJECT_ID}/loop/start`, {\n   367→            method: 'POST',\n   368→            headers: {'Content-Type': 'application/json'},\n   369→            body: JSON.stringify(body)\n   370→        });\n   371→        if (!resp.ok) {\n   372→            const data = await resp.json();\n   373→            throw new Error(data.detail || 'Failed to start loop');\n   374→        }\n   375→        window.location.reload();\n   376→    } catch(err) {\n   377→        errorEl.textContent = err.message;\n   378→        errorEl.classList.remove('hidden');\n   379→    }\n   380→});\n   381→\n   382→async function stopLoop() {\n   383→    // Close SSE first to prevent reconnection attempts during stop\n   384→    if (currentEventSource) {\n   385→        currentEventSource.close();\n   386→        currentEventSource = null;\n   387→    }\n   388→    await fetch(`/api/projects/${PROJECT_ID}/loop/stop`, {method: 'POST'});\n   389→    window.location.reload();\n   390→}\n   391→\n   392→async function removeProject(projectId, projectName, loopStatus) {\n   393→    if (loopStatus === 'running' || loopStatus === 'starting') {\n   394→        if (!confirm(`\"${projectName}\" has a running loop. Stop loop and remove from project list?\\n\\nFiles on disk will NOT be deleted.`)) return;\n   395→        await stopLoop();\n   396→        return;\n   397→    }\n   398→\n   399→    if (!confirm(`Remove \"${projectName}\" from project list?\\n\\nFiles on disk will NOT be deleted.`)) return;\n   400→    const resp = await fetch(`/api/projects/${projectId}`, {method: 'DELETE'});\n   401→    if (!resp.ok) {\n   402→        const data = await resp.json().catch(() => ({}));\n   403→        alert(data.detail || 'Failed to remove project');\n   404→        return;\n   405→    }\n   406→    window.location.href = '/';\n   407→}\n   408→\n   409→// =========================================================================\n   410→// Export Modal\n   411→// =========================================================================\n   412→\n   413→let exportFeatures = [];\n   414→\n   415→async function openExportModal() {\n   416→    const modal = document.getElementById('export-modal');\n   417→    const tree = document.getElementById('export-tree');\n   418→    modal.classList.remove('hidden');\n   419→    tree.innerHTML = '<div class=\"text-gray-500 text-center py-8\">Loading features...</div>';\n   420→\n   421→    try {\n   422→        const resp = await fetch(`/api/projects/${PROJECT_ID}/export/features`);\n   423→        if (!resp.ok) throw new Error('Failed to load features');\n   424→        exportFeatures = await resp.json();\n   425→\n   426→        if (exportFeatures.length === 0) {\n   427→            tree.innerHTML = '<div class=\"text-gray-500 text-center py-8\">No exportable features found</div>';\n   428→            return;\n   429→        }\n   430→        renderExportTree();\n   431→    } catch (err) {\n   432→        tree.innerHTML = `<div class=\"text-red-400 text-center py-8\">${escapeHtmlExport(err.message)}</div>`;\n   433→    }\n   434→}\n   435→\n   436→function closeExportModal() {\n   437→    document.getElementById('export-modal').classList.add('hidden');\n   438→}\n   439→\n   440→function renderExportTree() {\n   441→    const tree = document.getElementById('export-tree');\n   442→    tree.innerHTML = exportFeatures.map((feature, fi) => {\n   443→        const diagrams = feature.diagrams || [];\n   444→        return `\n   445→            <div class=\"mb-3\">\n   446→                <div class=\"flex items-center gap-2 mb-1\">\n   447→                    <button onclick=\"toggleFeatureExpand(${fi})\"\n   448→                            class=\"text-gray-400 hover:text-gray-200 text-xs w-5 text-center\"\n   449→                            id=\"expand-btn-${fi}\">\\u25B6</button>\n   450→                    <label class=\"flex items-center gap-2 cursor-pointer flex-1\">\n   451→                        <input type=\"checkbox\" class=\"feature-cb\" data-fi=\"${fi}\"\n   452→                               onchange=\"onFeatureToggle(${fi})\" checked>\n   453→                        <span class=\"text-sm font-medium\">${escapeHtmlExport(feature.name)}</span>\n   454→                        <span class=\"text-xs text-gray-500\">${diagrams.length} diagram${diagrams.length !== 1 ? 's' : ''}</span>\n   455→                        ${feature.has_requirements ? '<span class=\"text-xs text-green-600\">+ requirements</span>' : ''}\n   456→                    </label>\n   457→                </div>\n   458→                <div id=\"diagrams-${fi}\" class=\"ml-7 hidden space-y-1\">\n   459→                    ${diagrams.map((d, di) => `\n   460→                        <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n   461→                            <input type=\"checkbox\" class=\"diagram-cb\" data-fi=\"${fi}\" data-di=\"${di}\" checked\n   462→                                   onchange=\"onDiagramToggle(${fi})\">\n   463→                            <span class=\"text-xs text-gray-300\">${escapeHtmlExport(d.name)}</span>\n   464→                            <span class=\"text-xs text-gray-600 truncate\">${escapeHtmlExport(d.description || '')}</span>\n   465→                        </label>\n   466→                    `).join('')}\n   467→                </div>\n   468→            </div>\n   469→        `;\n   470→    }).join('');\n   471→    updateDownloadButton();\n   472→}\n   473→\n   474→function toggleFeatureExpand(fi) {\n   475→    const el = document.getElementById(`diagrams-${fi}`);\n   476→    const btn = document.getElementById(`expand-btn-${fi}`);\n   477→    if (el.classList.contains('hidden')) {\n   478→        el.classList.remove('hidden');\n   479→        btn.textContent = '\\u25BC';\n   480→    } else {\n   481→        el.classList.add('hidden');\n   482→        btn.textContent = '\\u25B6';\n   483→    }\n   484→}\n   485→\n   486→function onFeatureToggle(fi) {\n   487→    const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n   488→    const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]`);\n   489→    diagramCbs.forEach(cb => cb.checked = featureCb.checked);\n   490→    updateDownloadButton();\n   491→}\n   492→\n   493→function onDiagramToggle(fi) {\n   494→    const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n   495→    const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]`);\n   496→    const checked = [...diagramCbs].filter(cb => cb.checked).length;\n   497→    featureCb.checked = checked > 0;\n   498→    featureCb.indeterminate = checked > 0 && checked < diagramCbs.length;\n   499→    updateDownloadButton();\n   500→}\n   501→\n   502→function selectAllExport(select) {\n   503→    document.querySelectorAll('.feature-cb, .diagram-cb').forEach(cb => {\n   504→        cb.checked = select;\n   505→        cb.indeterminate = false;\n   506→    });\n   507→    updateDownloadButton();\n   508→}\n   509→\n   510→function updateDownloadButton() {\n   511→    const anySelected = document.querySelectorAll('.feature-cb:checked').length > 0;\n   512→    document.getElementById('export-download-btn').disabled = !anySelected;\n   513→}\n   514→\n   515→function collectSelectedFeatures() {\n   516→    return exportFeatures.map((feature, fi) => {\n   517→        const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n   518→        if (!featureCb.checked && !featureCb.indeterminate) return null;\n   519→\n   520→        const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]:checked`);\n   521→        const selectedDiagrams = [...diagramCbs].map(cb => {\n   522→            const di = parseInt(cb.dataset.di);\n   523→            return feature.diagrams[di].file;\n   524→        });\n   525→\n   526→        return { name: feature.name, diagrams: selectedDiagrams };\n   527→    }).filter(Boolean);\n   528→}\n   529→\n   530→async function startExport() {\n   531→    const btn = document.getElementById('export-download-btn');\n   532→    const origText = btn.textContent;\n   533→    btn.disabled = true;\n   534→    btn.textContent = 'Generating...';\n   535→\n   536→    const selected = collectSelectedFeatures();\n   537→\n   538→    try {\n   539→        const resp = await fetch(`/api/projects/${PROJECT_ID}/export`, {\n   540→            method: 'POST',\n   541→            headers: { 'Content-Type': 'application/json' },\n   542→            body: JSON.stringify({ features: selected }),\n   543→        });\n   544→\n   545→        if (!resp.ok) throw new Error('Export failed');\n   546→\n   547→        const blob = await resp.blob();\n   548→        const url = URL.createObjectURL(blob);\n   549→        const a = document.createElement('a');\n   550→        a.href = url;\n   551→        a.download = resp.headers.get('Content-Disposition')\n   552→            ?.match(/filename=\"(.+?)\"/)?.[1] || 'export.html';\n   553→        document.body.appendChild(a);\n   554→        a.click();\n   555→        a.remove();\n   556→        URL.revokeObjectURL(url);\n   557→\n   558→        closeExportModal();\n   559→    } catch (err) {\n   560→        alert('Export failed: ' + err.message);\n   561→    } finally {\n   562→        btn.disabled = false;\n   563→        btn.textContent = origText;\n   564→    }\n   565→}\n   566→\n   567→function escapeHtmlExport(str) {\n   568→    if (!str) return '';\n   569→    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n   570→}\n   571→</script>\n   572→{% endblock %}\n   573→"}]},"parent_tool_use_id":null,"session_id":"99d2dbda-9327-4d38-9974-87ec95f217c6","uuid":"750981b8-3419-4b96-ba50-7edc9946fe0c","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista-expanded-visualization/vista/server/views/project.html","content":"{% extends \"_base.html\" %}\n\n{% block title %}{{ project.name }} - Ralph Loop{% endblock %}\n\n{% block content %}\n<div class=\"mb-8\">\n    <div class=\"flex flex-wrap items-center gap-3 mb-2\">\n        <a href=\"/\" class=\"text-gray-400 hover:text-gray-300\">&larr; Dashboard</a>\n        <span class=\"text-gray-600\">/</span>\n        <h1 class=\"text-3xl font-bold\">{{ project.name }}</h1>\n        <div class=\"ml-auto flex items-center gap-2\">\n            <button onclick=\"openExportModal()\"\n                    class=\"px-3 py-1.5 rounded border border-blue-600 text-blue-300 hover:bg-blue-900/30 text-sm transition-colors\">\n                Export Docs\n            </button>\n            <button onclick=\"removeProject('{{ project.id }}', '{{ project.name }}', '{{ loop_state.status }}')\"\n                    class=\"px-3 py-1.5 rounded border border-gray-600 text-gray-300 hover:border-red-600 hover:text-red-300 text-sm transition-colors\">\n                Remove Project\n            </button>\n        </div>\n    </div>\n    <p class=\"text-gray-400 text-sm\">{{ project.path }}</p>\n</div>\n\n<div class=\"mb-6 border-b border-gray-700\">\n    <div class=\"flex items-center gap-2\" role=\"tablist\">\n        <button id=\"tab-overview-btn\" onclick=\"showProjectTab('overview')\"\n                class=\"project-tab-btn px-4 py-2 text-sm rounded-t-md border border-b-0 border-gray-700 bg-gray-800 text-gray-200\">\n            Overview\n        </button>\n        <button id=\"tab-loops-btn\" onclick=\"showProjectTab('loops')\"\n                class=\"project-tab-btn px-4 py-2 text-sm rounded-t-md border border-b-0 border-gray-700 bg-gray-900 text-gray-400 hover:text-gray-200\">\n            Ralph Loops\n        </button>\n    </div>\n</div>\n\n<section id=\"tab-overview\" class=\"space-y-6\">\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n            <p class=\"text-xs text-gray-400 mb-1\">Features</p>\n            <p class=\"text-2xl font-semibold\">{{ features|length }}</p>\n        </div>\n        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n            <p class=\"text-xs text-gray-400 mb-1\">Loop Status</p>\n            <p class=\"text-2xl font-semibold capitalize\">{{ loop_state.status }}</p>\n        </div>\n        <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-4\">\n            <p class=\"text-xs text-gray-400 mb-1\">Docs Readiness</p>\n            <p class=\"text-2xl font-semibold\">{{ features | selectattr('has_implementation_plan') | list | length }}/{{ features|length }}</p>\n        </div>\n    </div>\n\n    <div class=\"bg-gray-800 rounded-lg border border-gray-700 overflow-hidden\">\n        <div class=\"px-4 py-3 border-b border-gray-700\">\n            <h2 class=\"text-base font-semibold\">Feature Documentation</h2>\n            <p class=\"text-xs text-gray-400 mt-1\">Overview of specs, plans, prompts, and architecture docs</p>\n        </div>\n\n        {% if features %}\n        <div class=\"divide-y divide-gray-700\">\n            {% for feature in features %}\n            <div class=\"px-4 py-3 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3\">\n                <div>\n                    <p class=\"font-medium text-gray-100\">{{ feature.name }}</p>\n                    <div class=\"flex flex-wrap items-center gap-2 mt-1 text-xs\">\n                        <span class=\"px-2 py-0.5 rounded border border-gray-600 text-gray-300\">Specs: {{ feature.spec_count }}</span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_implementation_plan %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            Impl Plan {% if feature.has_implementation_plan %}✓{% else %}—{% endif %}\n                        </span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_agents_md %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            AGENTS.md {% if feature.has_agents_md %}✓{% else %}—{% endif %}\n                        </span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_prompt_build or feature.has_prompt_plan %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            PROMPTs {% if feature.has_prompt_build or feature.has_prompt_plan %}✓{% else %}—{% endif %}\n                        </span>\n                        <span class=\"px-2 py-0.5 rounded border {% if feature.has_arch_manifest %}border-green-700 text-green-300{% else %}border-gray-600 text-gray-400{% endif %}\">\n                            Arch {% if feature.has_arch_manifest %}{{ feature.arch_diagram_count }}{% else %}—{% endif %}\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2 text-xs\">\n                    <a href=\"/project/{{ project.id }}/plan/{{ feature.name }}\" class=\"px-2.5 py-1 rounded bg-blue-900/50 hover:bg-blue-900/70 text-blue-300 border border-blue-800\">Implementation Plan</a>\n                    {% if feature.has_arch_manifest %}\n                    <a href=\"/project/{{ project.id }}/arch/{{ feature.name }}\" class=\"px-2.5 py-1 rounded bg-green-900/40 hover:bg-green-900/60 text-green-300 border border-green-800\">Architecture</a>\n                    {% endif %}\n                </div>\n            </div>\n            {% endfor %}\n        </div>\n        {% else %}\n        <div class=\"px-4 py-8 text-gray-500 text-sm\">No features found in .vista/features/</div>\n        {% endif %}\n    </div>\n</section>\n\n<section id=\"tab-loops\" class=\"hidden\">\n    <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div class=\"lg:col-span-1\">\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6 mb-6\">\n                <h2 class=\"text-lg font-semibold mb-4\">Loop Control</h2>\n\n                {% if loop_state.status in [\"running\", \"starting\"] %}\n                <div class=\"space-y-3 mb-4\">\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Status</span>\n                        <span class=\"text-green-400 font-medium\">{{ loop_state.status }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Feature</span>\n                        <span>{{ loop_state.feature_name }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Provider</span>\n                        <span>{{ loop_state.provider_display_name or loop_state.provider or 'Claude Code' }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Mode</span>\n                        <span>{{ loop_state.mode }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Model</span>\n                        <span>{{ loop_state.model }}</span>\n                    </div>\n                    <div class=\"flex justify-between text-sm\">\n                        <span class=\"text-gray-400\">Iteration</span>\n                        <span id=\"iteration-display\" class=\"text-green-400 font-mono\">{{ loop_state.iteration }}</span>\n                    </div>\n                </div>\n\n                <button onclick=\"stopLoop()\" class=\"w-full py-2 bg-red-800 hover:bg-red-700 rounded font-medium transition-colors\">\n                    Stop Loop\n                </button>\n\n                {% else %}\n                <form id=\"start-loop-form\" class=\"space-y-4\">\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Feature</label>\n                        <select id=\"feature-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\">\n                            {% for feature in features %}\n                            <option value=\"{{ feature.name }}\">{{ feature.name }}</option>\n                            {% endfor %}\n                            {% if not features %}\n                            <option value=\"\" disabled>No features found</option>\n                            {% endif %}\n                        </select>\n                    </div>\n\n                    {% if providers|length > 1 %}\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Provider</label>\n                        <select id=\"provider-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\" onchange=\"onProviderChange()\">\n                            {% for p in providers %}\n                            <option value=\"{{ p.name }}\">{{ p.display_name }}</option>\n                            {% endfor %}\n                        </select>\n                    </div>\n                    {% else %}\n                    <input type=\"hidden\" id=\"provider-select\" value=\"{{ providers[0].name if providers else 'claude' }}\">\n                    {% endif %}\n\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Mode</label>\n                        <div class=\"flex gap-2\">\n                            <label class=\"flex-1 cursor-pointer\">\n                                <input type=\"radio\" name=\"mode\" value=\"build\" checked class=\"hidden peer\">\n                                <span class=\"block text-center py-2 rounded border border-gray-600 peer-checked:border-green-500 peer-checked:bg-green-900/30 peer-checked:text-green-400 transition-colors\">Build</span>\n                            </label>\n                            <label class=\"flex-1 cursor-pointer\">\n                                <input type=\"radio\" name=\"mode\" value=\"plan\" class=\"hidden peer\">\n                                <span class=\"block text-center py-2 rounded border border-gray-600 peer-checked:border-blue-500 peer-checked:bg-blue-900/30 peer-checked:text-blue-400 transition-colors\">Plan</span>\n                            </label>\n                        </div>\n                    </div>\n\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Model</label>\n                        <select id=\"model-select\" class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\"></select>\n                    </div>\n\n                    <div>\n                        <label class=\"block text-sm text-gray-400 mb-1\">Max Iterations (0 = unlimited)</label>\n                        <input type=\"number\" id=\"max-iterations\" value=\"0\" min=\"0\"\n                               class=\"w-full bg-gray-700 border border-gray-600 rounded px-3 py-2 text-gray-100\">\n                    </div>\n\n                    <button type=\"submit\" class=\"w-full py-2 bg-green-700 hover:bg-green-600 rounded font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-green-700\"\n                            {% if not features %}disabled{% endif %}>\n                        Start Loop\n                    </button>\n                </form>\n                {% endif %}\n\n                <div id=\"loop-error\" class=\"hidden mt-3 text-red-400 text-sm\"></div>\n            </div>\n        </div>\n\n        <div class=\"lg:col-span-2\">\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 overflow-hidden\">\n                <div class=\"flex items-center justify-between px-4 py-2 bg-gray-750 border-b border-gray-700\">\n                    <h2 class=\"text-sm font-semibold text-gray-300\">Terminal Output</h2>\n                    <div class=\"flex items-center gap-2\">\n                        <span id=\"status-badge\" class=\"text-xs text-gray-500\">{{ loop_state.status }}</span>\n                        <button onclick=\"clearTerminal()\" class=\"text-xs text-gray-500 hover:text-gray-300\">Clear</button>\n                    </div>\n                </div>\n                <div id=\"terminal\" class=\"terminal-output p-4 h-[600px] overflow-y-auto font-mono text-sm leading-relaxed\">\n                    <div class=\"text-gray-500\">Waiting for loop output...</div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<!-- Export Modal -->\n<div id=\"export-modal\" class=\"fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center\">\n    <div class=\"bg-gray-800 rounded-lg border border-gray-700 w-full max-w-lg max-h-[80vh] flex flex-col\">\n        <div class=\"px-4 py-3 border-b border-gray-700 flex items-center justify-between\">\n            <h3 class=\"font-semibold\">Export Documentation</h3>\n            <button onclick=\"closeExportModal()\" class=\"text-gray-400 hover:text-white\">&times;</button>\n        </div>\n        <div class=\"flex-1 overflow-y-auto p-4\" id=\"export-tree\">\n            <div class=\"text-gray-500 text-center py-8\">Loading features...</div>\n        </div>\n        <div class=\"px-4 py-3 border-t border-gray-700 flex items-center justify-between\">\n            <div class=\"flex items-center gap-3\">\n                <button onclick=\"selectAllExport(true)\" class=\"text-xs text-blue-400 hover:text-blue-300\">Select All</button>\n                <button onclick=\"selectAllExport(false)\" class=\"text-xs text-gray-400 hover:text-gray-300\">Deselect All</button>\n            </div>\n            <button id=\"export-download-btn\" onclick=\"startExport()\" disabled\n                    class=\"px-4 py-2 rounded bg-blue-600 hover:bg-blue-500 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed transition-colors\">\n                Download\n            </button>\n        </div>\n    </div>\n</div>\n{% endblock %}\n\n{% block scripts %}\n<script>\nconst PROJECT_ID = '{{ project.id }}';\nconst LOOP_STATUS = '{{ loop_state.status }}';\n\n// Provider names from server (no models yet — those are fetched on-demand)\nconst PROVIDERS = {{ providers | tojson }};\n\nif (LOOP_STATUS === 'running' || LOOP_STATUS === 'starting') {\n    connectSSE(PROJECT_ID);\n}\n\nfunction showProjectTab(tab) {\n    const overview = document.getElementById('tab-overview');\n    const loops = document.getElementById('tab-loops');\n    const overviewBtn = document.getElementById('tab-overview-btn');\n    const loopsBtn = document.getElementById('tab-loops-btn');\n\n    if (tab === 'loops') {\n        overview.classList.add('hidden');\n        loops.classList.remove('hidden');\n        overviewBtn.classList.replace('bg-gray-800', 'bg-gray-900');\n        overviewBtn.classList.replace('text-gray-200', 'text-gray-400');\n        loopsBtn.classList.replace('bg-gray-900', 'bg-gray-800');\n        loopsBtn.classList.replace('text-gray-400', 'text-gray-200');\n        window.location.hash = 'loops';\n        return;\n    }\n\n    loops.classList.add('hidden');\n    overview.classList.remove('hidden');\n    loopsBtn.classList.replace('bg-gray-800', 'bg-gray-900');\n    loopsBtn.classList.replace('text-gray-200', 'text-gray-400');\n    overviewBtn.classList.replace('bg-gray-900', 'bg-gray-800');\n    overviewBtn.classList.replace('text-gray-400', 'text-gray-200');\n    window.location.hash = 'overview';\n}\n\nif (window.location.hash === '#loops') {\n    showProjectTab('loops');\n} else {\n    showProjectTab('overview');\n}\n\n// --- Dynamic model loading ---\n\nlet _modelFetchId = 0;  // Guards against stale responses overwriting newer ones\n\nfunction renderModels(models) {\n    const select = document.getElementById('model-select');\n    if (!select) return;\n    select.innerHTML = '';\n    models.forEach((model) => {\n        const opt = document.createElement('option');\n        opt.value = model;\n        opt.textContent = model;\n        select.appendChild(opt);\n    });\n}\n\nfunction setStartEnabled(enabled) {\n    const btn = document.querySelector('#start-loop-form button[type=\"submit\"]');\n    if (btn) btn.disabled = !enabled;\n}\n\nfunction setModelLoading() {\n    const select = document.getElementById('model-select');\n    if (!select) return;\n    select.innerHTML = '<option disabled selected>Loading models...</option>';\n    setStartEnabled(false);\n}\n\nasync function fetchModels(providerName) {\n    const thisId = ++_modelFetchId;\n    setModelLoading();\n    try {\n        const resp = await fetch(`/api/providers/${providerName}/models`);\n        if (thisId !== _modelFetchId) return;  // Stale response, user switched provider\n        if (!resp.ok) throw new Error('Failed to fetch models');\n        const data = await resp.json();\n        if (thisId !== _modelFetchId) return;\n        if (data.error) {\n            // Server returned models but with an error (e.g. timeout)\n            const select = document.getElementById('model-select');\n            if (select) select.innerHTML = '<option disabled selected>Timed out - click retry</option>';\n            setStartEnabled(false);\n            return;\n        }\n        renderModels(data.models);\n        setStartEnabled(data.models.length > 0);\n    } catch (err) {\n        if (thisId !== _modelFetchId) return;\n        const select = document.getElementById('model-select');\n        if (select) select.innerHTML = '<option disabled selected>Failed to load - click retry</option>';\n        setStartEnabled(false);\n    }\n}\n\nfunction getSelectedProvider() {\n    const sel = document.getElementById('provider-select');\n    return sel ? sel.value : 'claude';\n}\n\nfunction onProviderChange() {\n    fetchModels(getSelectedProvider());\n}\n\nif (document.getElementById('start-loop-form') && PROVIDERS.length > 0) {\n    fetchModels(PROVIDERS[0].name);\n}\n\n// --- Form submission ---\n\ndocument.getElementById('start-loop-form')?.addEventListener('submit', async function(e) {\n    e.preventDefault();\n    const errorEl = document.getElementById('loop-error');\n    errorEl.classList.add('hidden');\n\n    const body = {\n        feature_name: document.getElementById('feature-select').value,\n        mode: document.querySelector('input[name=\"mode\"]:checked').value,\n        model: document.getElementById('model-select').value,\n        provider: getSelectedProvider(),\n        max_iterations: parseInt(document.getElementById('max-iterations').value) || 0,\n    };\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/loop/start`, {\n            method: 'POST',\n            headers: {'Content-Type': 'application/json'},\n            body: JSON.stringify(body)\n        });\n        if (!resp.ok) {\n            const data = await resp.json();\n            throw new Error(data.detail || 'Failed to start loop');\n        }\n        window.location.reload();\n    } catch(err) {\n        errorEl.textContent = err.message;\n        errorEl.classList.remove('hidden');\n    }\n});\n\nasync function stopLoop() {\n    // Close SSE first to prevent reconnection attempts during stop\n    if (currentEventSource) {\n        currentEventSource.close();\n        currentEventSource = null;\n    }\n    await fetch(`/api/projects/${PROJECT_ID}/loop/stop`, {method: 'POST'});\n    window.location.reload();\n}\n\nasync function removeProject(projectId, projectName, loopStatus) {\n    if (loopStatus === 'running' || loopStatus === 'starting') {\n        if (!confirm(`\"${projectName}\" has a running loop. Stop loop and remove from project list?\\n\\nFiles on disk will NOT be deleted.`)) return;\n        await stopLoop();\n        return;\n    }\n\n    if (!confirm(`Remove \"${projectName}\" from project list?\\n\\nFiles on disk will NOT be deleted.`)) return;\n    const resp = await fetch(`/api/projects/${projectId}`, {method: 'DELETE'});\n    if (!resp.ok) {\n        const data = await resp.json().catch(() => ({}));\n        alert(data.detail || 'Failed to remove project');\n        return;\n    }\n    window.location.href = '/';\n}\n\n// =========================================================================\n// Export Modal\n// =========================================================================\n\nlet exportFeatures = [];\n\nasync function openExportModal() {\n    const modal = document.getElementById('export-modal');\n    const tree = document.getElementById('export-tree');\n    modal.classList.remove('hidden');\n    tree.innerHTML = '<div class=\"text-gray-500 text-center py-8\">Loading features...</div>';\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/export/features`);\n        if (!resp.ok) throw new Error('Failed to load features');\n        exportFeatures = await resp.json();\n\n        if (exportFeatures.length === 0) {\n            tree.innerHTML = '<div class=\"text-gray-500 text-center py-8\">No exportable features found</div>';\n            return;\n        }\n        renderExportTree();\n    } catch (err) {\n        tree.innerHTML = `<div class=\"text-red-400 text-center py-8\">${escapeHtmlExport(err.message)}</div>`;\n    }\n}\n\nfunction closeExportModal() {\n    document.getElementById('export-modal').classList.add('hidden');\n}\n\nfunction renderExportTree() {\n    const tree = document.getElementById('export-tree');\n    tree.innerHTML = exportFeatures.map((feature, fi) => {\n        const diagrams = feature.diagrams || [];\n        return `\n            <div class=\"mb-3\">\n                <div class=\"flex items-center gap-2 mb-1\">\n                    <button onclick=\"toggleFeatureExpand(${fi})\"\n                            class=\"text-gray-400 hover:text-gray-200 text-xs w-5 text-center\"\n                            id=\"expand-btn-${fi}\">\\u25B6</button>\n                    <label class=\"flex items-center gap-2 cursor-pointer flex-1\">\n                        <input type=\"checkbox\" class=\"feature-cb\" data-fi=\"${fi}\"\n                               onchange=\"onFeatureToggle(${fi})\" checked>\n                        <span class=\"text-sm font-medium\">${escapeHtmlExport(feature.name)}</span>\n                        <span class=\"text-xs text-gray-500\">${diagrams.length} diagram${diagrams.length !== 1 ? 's' : ''}</span>\n                        ${feature.has_requirements ? '<span class=\"text-xs text-green-600\">+ requirements</span>' : ''}\n                    </label>\n                </div>\n                <div id=\"diagrams-${fi}\" class=\"ml-7 hidden space-y-1\">\n                    ${diagrams.map((d, di) => `\n                        <label class=\"flex items-center gap-2 cursor-pointer py-0.5\">\n                            <input type=\"checkbox\" class=\"diagram-cb\" data-fi=\"${fi}\" data-di=\"${di}\" checked\n                                   onchange=\"onDiagramToggle(${fi})\">\n                            <span class=\"text-xs text-gray-300\">${escapeHtmlExport(d.name)}</span>\n                            <span class=\"text-xs text-gray-600 truncate\">${escapeHtmlExport(d.description || '')}</span>\n                        </label>\n                    `).join('')}\n                </div>\n            </div>\n        `;\n    }).join('');\n    updateDownloadButton();\n}\n\nfunction toggleFeatureExpand(fi) {\n    const el = document.getElementById(`diagrams-${fi}`);\n    const btn = document.getElementById(`expand-btn-${fi}`);\n    if (el.classList.contains('hidden')) {\n        el.classList.remove('hidden');\n        btn.textContent = '\\u25BC';\n    } else {\n        el.classList.add('hidden');\n        btn.textContent = '\\u25B6';\n    }\n}\n\nfunction onFeatureToggle(fi) {\n    const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n    const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]`);\n    diagramCbs.forEach(cb => cb.checked = featureCb.checked);\n    updateDownloadButton();\n}\n\nfunction onDiagramToggle(fi) {\n    const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n    const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]`);\n    const checked = [...diagramCbs].filter(cb => cb.checked).length;\n    featureCb.checked = checked > 0;\n    featureCb.indeterminate = checked > 0 && checked < diagramCbs.length;\n    updateDownloadButton();\n}\n\nfunction selectAllExport(select) {\n    document.querySelectorAll('.feature-cb, .diagram-cb').forEach(cb => {\n        cb.checked = select;\n        cb.indeterminate = false;\n    });\n    updateDownloadButton();\n}\n\nfunction updateDownloadButton() {\n    const anySelected = document.querySelectorAll('.feature-cb:checked').length > 0;\n    document.getElementById('export-download-btn').disabled = !anySelected;\n}\n\nfunction collectSelectedFeatures() {\n    return exportFeatures.map((feature, fi) => {\n        const featureCb = document.querySelector(`.feature-cb[data-fi=\"${fi}\"]`);\n        if (!featureCb.checked && !featureCb.indeterminate) return null;\n\n        const diagramCbs = document.querySelectorAll(`.diagram-cb[data-fi=\"${fi}\"]:checked`);\n        const selectedDiagrams = [...diagramCbs].map(cb => {\n            const di = parseInt(cb.dataset.di);\n            return feature.diagrams[di].file;\n        });\n\n        return { name: feature.name, diagrams: selectedDiagrams };\n    }).filter(Boolean);\n}\n\nasync function startExport() {\n    const btn = document.getElementById('export-download-btn');\n    const origText = btn.textContent;\n    btn.disabled = true;\n    btn.textContent = 'Generating...';\n\n    const selected = collectSelectedFeatures();\n\n    try {\n        const resp = await fetch(`/api/projects/${PROJECT_ID}/export`, {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ features: selected }),\n        });\n\n        if (!resp.ok) throw new Error('Export failed');\n\n        const blob = await resp.blob();\n        const url = URL.createObjectURL(blob);\n        const a = document.createElement('a');\n        a.href = url;\n        a.download = resp.headers.get('Content-Disposition')\n            ?.match(/filename=\"(.+?)\"/)?.[1] || 'export.html';\n        document.body.appendChild(a);\n        a.click();\n        a.remove();\n        URL.revokeObjectURL(url);\n\n        closeExportModal();\n    } catch (err) {\n        alert('Export failed: ' + err.message);\n    } finally {\n        btn.disabled = false;\n        btn.textContent = origText;\n    }\n}\n\nfunction escapeHtmlExport(str) {\n    if (!str) return '';\n    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n}\n</script>\n{% endblock %}\n","numLines":573,"startLine":1,"totalLines":573}}}
