{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q22e4WiBhf1CnMdFtfGERi","type":"tool_result","content":"     1→\"\"\"Server configuration. All paths computed relative to plugin root.\"\"\"\n     2→\n     3→import json\n     4→import os\n     5→import platform\n     6→from pathlib import Path\n     7→\n     8→# Directory structure\n     9→PLUGIN_ROOT = Path(__file__).resolve().parent.parent  # plugin_1/\n    10→SERVER_DIR = Path(__file__).resolve().parent  # plugin_1/server/\n    11→PORTABLE_DIR = PLUGIN_ROOT / \"portable\"\n    12→TEMPLATES_DIR = PORTABLE_DIR / \"templates\"\n    13→DATA_DIR = Path.home() / \".vista\" / \"data\"\n    14→PROJECTS_FILE = DATA_DIR / \"projects.json\"\n    15→_LEGACY_DATA_DIR = SERVER_DIR / \"data\"  # pre-1.3.12: inside plugin install dir\n    16→VIEWS_DIR = SERVER_DIR / \"views\"\n    17→STATIC_DIR = VIEWS_DIR / \"static\"\n    18→\n    19→# Settings file\n    20→LEGACY_SETTINGS_FILE = PLUGIN_ROOT / \"settings.json\"\n    21→\n    22→\n    23→def _resolve_settings_file() -> Path:\n    24→    \"\"\"Return persistent settings path outside app install directory.\n    25→\n    26→    Users can override via ``VISTA_SETTINGS_FILE`` for advanced setups.\n    27→    \"\"\"\n    28→    override = os.environ.get(\"VISTA_SETTINGS_FILE\", \"\").strip()\n    29→    if override:\n    30→        return Path(override).expanduser().resolve()\n    31→\n    32→    return Path.home() / \".vista\" / \"settings.json\"\n    33→\n    34→\n    35→_DEFAULT_SETTINGS_FILE = _resolve_settings_file()\n    36→SETTINGS_FILE = _DEFAULT_SETTINGS_FILE\n    37→\n    38→_SERVER_DEFAULTS = {\n    39→    \"auto_start\": True,\n    40→    \"auto_open_browser\": True,\n    41→    \"host\": \"127.0.0.1\",\n    42→    \"port\": 3456,\n    43→}\n    44→\n    45→_RALPH_DEFAULTS = {\n    46→    \"defaults\": {\n    47→        \"provider\": \"claude\",\n    48→        \"model\": \"sonnet\",\n    49→        \"iterations\": 3,\n    50→    },\n    51→    \"summarizer\": {\n    52→        \"provider\": \"claude\",\n    53→        \"model\": \"haiku\",\n    54→    },\n    55→    \"providers\": {},\n    56→}\n    57→\n    58→_SANDBOX_DEFAULTS = {\n    59→    \"enabled\": False,\n    60→    \"image\": \"vista-ralph:latest\",\n    61→    \"network_enabled\": True,\n    62→    \"ttl_seconds\": 7200,\n    63→    \"credential_mounts\": {\n    64→        \"claude_auth\": {\"enabled\": True},\n    65→        \"git_ssh\": {\"enabled\": True},\n    66→        \"git_config\": {\"enabled\": True},\n    67→        \"gh_cli\": {\"enabled\": True},\n    68→        \"opencode\": {\"enabled\": True},\n    69→    },\n    70→}\n    71→\n    72→_TOOLS_DEFAULTS = {\n    73→    \"teams\": {\n    74→        \"claude_binary\": None,\n    75→        \"opencode_url\": None,\n    76→        \"opencode_auto_start\": True,\n    77→        \"opencode_port\": 4200,\n    78→    },\n    79→    \"ralph\": {},\n    80→}\n    81→\n    82→\n    83→def get_tools_settings() -> dict:\n    84→    \"\"\"Return merged tools settings with defaults applied.\"\"\"\n    85→    raw = load_settings().get(\"tools\", {})\n    86→    if not isinstance(raw, dict):\n    87→        raw = {}\n    88→    return _merge_dicts(_TOOLS_DEFAULTS, raw)\n    89→\n    90→\n    91→_CHAT_DEFAULTS = {\n    92→    \"companion_port\": 3457,\n    93→    \"opencode_port\": 4096,\n    94→}\n    95→\n    96→\n    97→def get_chat_settings() -> dict:\n    98→    \"\"\"Return chat backend service configuration.\"\"\"\n    99→    raw = load_settings().get(\"chat\", {})\n   100→    if not isinstance(raw, dict):\n   101→        raw = {}\n   102→    return _merge_dicts(_CHAT_DEFAULTS, raw)\n   103→\n   104→\n   105→def load_settings() -> dict:\n   106→    \"\"\"Load settings.json from PLUGIN_ROOT, returning {} on failure.\"\"\"\n   107→    _migrate_legacy_settings_if_needed()\n   108→    if SETTINGS_FILE.exists():\n   109→        try:\n   110→            return json.loads(SETTINGS_FILE.read_text(encoding=\"utf-8\"))\n   111→        except (json.JSONDecodeError, OSError):\n   112→            pass\n   113→    return {}\n   114→\n   115→\n   116→def _migrate_legacy_settings_if_needed() -> None:\n   117→    \"\"\"Migrate settings from legacy plugin-local file to persistent location.\n   118→\n   119→    Migration runs only for the default persistent path, so tests and custom\n   120→    overrides that patch ``SETTINGS_FILE`` are unaffected.\n   121→    \"\"\"\n   122→    if SETTINGS_FILE != _DEFAULT_SETTINGS_FILE:\n   123→        return\n   124→    if SETTINGS_FILE == LEGACY_SETTINGS_FILE:\n   125→        return\n   126→    if SETTINGS_FILE.exists() or not LEGACY_SETTINGS_FILE.exists():\n   127→        return\n   128→\n   129→    try:\n   130→        SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n   131→        SETTINGS_FILE.write_text(\n   132→            LEGACY_SETTINGS_FILE.read_text(encoding=\"utf-8\"), encoding=\"utf-8\"\n   133→        )\n   134→    except OSError:\n   135→        # Non-fatal: app can still proceed with defaults.\n   136→        return\n   137→\n   138→\n   139→def _merge_dicts(base: dict, overlay: dict) -> dict:\n   140→    merged = dict(base)\n   141→    for key, value in overlay.items():\n   142→        if isinstance(value, dict) and isinstance(merged.get(key), dict):\n   143→            merged[key] = _merge_dicts(merged[key], value)\n   144→        else:\n   145→            merged[key] = value\n   146→    return merged\n   147→\n   148→\n   149→def get_ralph_settings() -> dict:\n   150→    \"\"\"Return merged ralph settings with defaults applied.\"\"\"\n   151→    raw = load_settings().get(\"ralph\", {})\n   152→    if not isinstance(raw, dict):\n   153→        raw = {}\n   154→    return _merge_dicts(_RALPH_DEFAULTS, raw)\n   155→\n   156→\n   157→def get_ralph_defaults() -> dict:\n   158→    \"\"\"Return default provider/model/iterations for ralph_start.\"\"\"\n   159→    settings = get_ralph_settings().get(\"defaults\", {})\n   160→    defaults = dict(_RALPH_DEFAULTS[\"defaults\"])\n   161→    defaults.update({k: v for k, v in settings.items() if v is not None})\n   162→    iterations = defaults.get(\"iterations\")\n   163→    if not isinstance(iterations, int) or iterations <= 0:\n   164→        defaults[\"iterations\"] = _RALPH_DEFAULTS[\"defaults\"][\"iterations\"]\n   165→    return defaults\n   166→\n   167→\n   168→def get_summarizer_config() -> dict:\n   169→    \"\"\"Return summarizer provider/model configuration.\"\"\"\n   170→    settings = get_ralph_settings().get(\"summarizer\", {})\n   171→    config = dict(_RALPH_DEFAULTS[\"summarizer\"])\n   172→    config.update({k: v for k, v in settings.items() if v})\n   173→    return config\n   174→\n   175→\n   176→def save_ralph_settings(ralph_config: dict) -> None:\n   177→    \"\"\"Write the ralph section back to settings.json, preserving other sections.\"\"\"\n   178→    _migrate_legacy_settings_if_needed()\n   179→    settings = load_settings()\n   180→    settings[\"ralph\"] = ralph_config\n   181→    SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n   182→    tmp_file = SETTINGS_FILE.with_suffix(\".json.tmp\")\n   183→    tmp_file.write_text(json.dumps(settings, indent=2), encoding=\"utf-8\")\n   184→    tmp_file.replace(SETTINGS_FILE)\n   185→\n   186→\n   187→def get_sandbox_settings() -> dict:\n   188→    \"\"\"Return merged sandbox settings with defaults applied.\"\"\"\n   189→    raw = get_ralph_settings().get(\"sandbox\", {})\n   190→    if not isinstance(raw, dict):\n   191→        raw = {}\n   192→    return _merge_dicts(_SANDBOX_DEFAULTS, raw)\n   193→\n   194→\n   195→def is_sandbox_enabled() -> bool:\n   196→    \"\"\"Check whether sandbox mode is enabled.\"\"\"\n   197→    return bool(get_sandbox_settings().get(\"enabled\", False))\n   198→\n   199→\n   200→def get_sandbox_credential_mounts() -> dict:\n   201→    \"\"\"Return the credential_mounts section of sandbox settings.\"\"\"\n   202→    return get_sandbox_settings().get(\"credential_mounts\", {})\n   203→\n   204→\n   205→def save_sandbox_settings(sandbox_config: dict) -> None:\n   206→    \"\"\"Write sandbox section under ralph settings, preserving other sections.\"\"\"\n   207→    ralph = get_ralph_settings()\n   208→    ralph[\"sandbox\"] = sandbox_config\n   209→    save_ralph_settings(ralph)\n   210→\n   211→\n   212→def validate_sandbox_settings(config_dict: dict) -> list[str]:\n   213→    \"\"\"Validate sandbox settings. Returns list of error strings (empty = valid).\"\"\"\n   214→    errors: list[str] = []\n   215→\n   216→    if \"enabled\" in config_dict and not isinstance(config_dict[\"enabled\"], bool):\n   217→        errors.append(\"'enabled' must be a boolean\")\n   218→\n   219→    if \"image\" in config_dict:\n   220→        if (\n   221→            not isinstance(config_dict[\"image\"], str)\n   222→            or not config_dict[\"image\"].strip()\n   223→        ):\n   224→            errors.append(\"'image' must be a non-empty string\")\n   225→\n   226→    if \"network_enabled\" in config_dict and not isinstance(\n   227→        config_dict[\"network_enabled\"], bool\n   228→    ):\n   229→        errors.append(\"'network_enabled' must be a boolean\")\n   230→\n   231→    if \"ttl_seconds\" in config_dict:\n   232→        ttl = config_dict[\"ttl_seconds\"]\n   233→        if not isinstance(ttl, int) or ttl <= 0:\n   234→            errors.append(\"'ttl_seconds' must be a positive integer\")\n   235→\n   236→    if \"credential_mounts\" in config_dict:\n   237→        creds = config_dict[\"credential_mounts\"]\n   238→        if not isinstance(creds, dict):\n   239→            errors.append(\"'credential_mounts' must be a dict\")\n   240→        else:\n   241→            for name, entry in creds.items():\n   242→                if not isinstance(entry, dict):\n   243→                    errors.append(f\"credential_mounts.{name} must be a dict\")\n   244→                elif \"enabled\" in entry and not isinstance(entry[\"enabled\"], bool):\n   245→                    errors.append(f\"credential_mounts.{name}.enabled must be a boolean\")\n   246→\n   247→    return errors\n   248→\n   249→\n   250→def get_server_settings() -> dict:\n   251→    \"\"\"Return merged server settings.  Priority: env vars > settings.json > defaults.\"\"\"\n   252→    settings = load_settings().get(\"server\", {})\n   253→    merged = {**_SERVER_DEFAULTS, **settings}\n   254→\n   255→    # Env var overrides (match existing RALPH_SERVER_* convention)\n   256→    pytest_test = os.environ.get(\"PYTEST_CURRENT_TEST\")\n   257→    allow_env_overrides = True\n   258→    if pytest_test and \"env_var\" not in pytest_test:\n   259→        allow_env_overrides = False\n   260→    if allow_env_overrides:\n   261→        if \"RALPH_SERVER_HOST\" in os.environ:\n   262→            merged[\"host\"] = os.environ[\"RALPH_SERVER_HOST\"]\n   263→        if \"RALPH_SERVER_PORT\" in os.environ:\n   264→            merged[\"port\"] = int(os.environ[\"RALPH_SERVER_PORT\"])\n   265→        if \"RALPH_SERVER_AUTO_START\" in os.environ:\n   266→            merged[\"auto_start\"] = os.environ[\"RALPH_SERVER_AUTO_START\"].lower() in (\n   267→                \"1\",\n   268→                \"true\",\n   269→                \"yes\",\n   270→            )\n   271→        if \"RALPH_SERVER_AUTO_OPEN\" in os.environ:\n   272→            merged[\"auto_open_browser\"] = os.environ[\n   273→                \"RALPH_SERVER_AUTO_OPEN\"\n   274→            ].lower() in (\n   275→                \"1\",\n   276→                \"true\",\n   277→                \"yes\",\n   278→            )\n   279→    if (\n   280→        \"PYTEST_CURRENT_TEST\" in os.environ\n   281→        and \"RALPH_SERVER_AUTO_OPEN\" not in os.environ\n   282→        and \"PYTEST_DISABLE_AUTO_OPEN\" in os.environ\n   283→        and \"env_var\" not in os.environ.get(\"PYTEST_CURRENT_TEST\", \"\")\n   284→    ):\n   285→        merged[\"auto_open_browser\"] = _SERVER_DEFAULTS[\"auto_open_browser\"]\n   286→\n   287→    return merged\n   288→\n   289→\n   290→def ensure_full_path() -> None:\n   291→    \"\"\"On Windows, merge the full system+user PATH from the registry.\n   292→\n   293→    Some launch contexts (e.g. git-bash, certain IDE sandboxes) have a\n   294→    stripped-down PATH missing entries like nodejs/ and npm/. The Windows\n   295→    registry holds the authoritative PATH. Merging it ensures subprocesses\n   296→    like ``claude`` and ``opencode`` can find their dependencies.\n   297→\n   298→    Safe to call multiple times; subsequent calls are no-ops.\n   299→    \"\"\"\n   300→    if platform.system() != \"Windows\":\n   301→        return\n   302→    try:\n   303→        import winreg\n   304→    except ImportError:\n   305→        return\n   306→\n   307→    registry_dirs: list[str] = []\n   308→    for hive, subkey in [\n   309→        (\n   310→            winreg.HKEY_LOCAL_MACHINE,\n   311→            r\"SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\",\n   312→        ),\n   313→        (winreg.HKEY_CURRENT_USER, r\"Environment\"),\n   314→    ]:\n   315→        try:\n   316→            key = winreg.OpenKey(hive, subkey)\n   317→            raw = winreg.QueryValueEx(key, \"Path\")[0]\n   318→            winreg.CloseKey(key)\n   319→            registry_dirs.extend(\n   320→                os.path.expandvars(d) for d in raw.split(\";\") if d.strip()\n   321→            )\n   322→        except OSError:\n   323→            continue\n   324→\n   325→    current = set(os.environ.get(\"PATH\", \"\").split(\";\"))\n   326→    new_dirs = [d for d in registry_dirs if d not in current and os.path.isdir(d)]\n   327→    if new_dirs:\n   328→        os.environ[\"PATH\"] = os.environ.get(\"PATH\", \"\") + \";\" + \";\".join(new_dirs)\n   329→\n   330→\n   331→# Module-level HOST / PORT for backward compatibility\n   332→_server = get_server_settings()\n   333→HOST = _server[\"host\"]\n   334→PORT = _server[\"port\"]\n   335→"}]},"parent_tool_use_id":null,"session_id":"c06c8987-38bb-4a43-9247-2ef00a647fd1","uuid":"b9cbd135-27e2-4c13-98db-21466747a8ce","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Grove\\OneDrive\\Documents\\PYTHON\\claude_plugins\\vista\\vista\\server\\config.py","content":"\"\"\"Server configuration. All paths computed relative to plugin root.\"\"\"\n\nimport json\nimport os\nimport platform\nfrom pathlib import Path\n\n# Directory structure\nPLUGIN_ROOT = Path(__file__).resolve().parent.parent  # plugin_1/\nSERVER_DIR = Path(__file__).resolve().parent  # plugin_1/server/\nPORTABLE_DIR = PLUGIN_ROOT / \"portable\"\nTEMPLATES_DIR = PORTABLE_DIR / \"templates\"\nDATA_DIR = Path.home() / \".vista\" / \"data\"\nPROJECTS_FILE = DATA_DIR / \"projects.json\"\n_LEGACY_DATA_DIR = SERVER_DIR / \"data\"  # pre-1.3.12: inside plugin install dir\nVIEWS_DIR = SERVER_DIR / \"views\"\nSTATIC_DIR = VIEWS_DIR / \"static\"\n\n# Settings file\nLEGACY_SETTINGS_FILE = PLUGIN_ROOT / \"settings.json\"\n\n\ndef _resolve_settings_file() -> Path:\n    \"\"\"Return persistent settings path outside app install directory.\n\n    Users can override via ``VISTA_SETTINGS_FILE`` for advanced setups.\n    \"\"\"\n    override = os.environ.get(\"VISTA_SETTINGS_FILE\", \"\").strip()\n    if override:\n        return Path(override).expanduser().resolve()\n\n    return Path.home() / \".vista\" / \"settings.json\"\n\n\n_DEFAULT_SETTINGS_FILE = _resolve_settings_file()\nSETTINGS_FILE = _DEFAULT_SETTINGS_FILE\n\n_SERVER_DEFAULTS = {\n    \"auto_start\": True,\n    \"auto_open_browser\": True,\n    \"host\": \"127.0.0.1\",\n    \"port\": 3456,\n}\n\n_RALPH_DEFAULTS = {\n    \"defaults\": {\n        \"provider\": \"claude\",\n        \"model\": \"sonnet\",\n        \"iterations\": 3,\n    },\n    \"summarizer\": {\n        \"provider\": \"claude\",\n        \"model\": \"haiku\",\n    },\n    \"providers\": {},\n}\n\n_SANDBOX_DEFAULTS = {\n    \"enabled\": False,\n    \"image\": \"vista-ralph:latest\",\n    \"network_enabled\": True,\n    \"ttl_seconds\": 7200,\n    \"credential_mounts\": {\n        \"claude_auth\": {\"enabled\": True},\n        \"git_ssh\": {\"enabled\": True},\n        \"git_config\": {\"enabled\": True},\n        \"gh_cli\": {\"enabled\": True},\n        \"opencode\": {\"enabled\": True},\n    },\n}\n\n_TOOLS_DEFAULTS = {\n    \"teams\": {\n        \"claude_binary\": None,\n        \"opencode_url\": None,\n        \"opencode_auto_start\": True,\n        \"opencode_port\": 4200,\n    },\n    \"ralph\": {},\n}\n\n\ndef get_tools_settings() -> dict:\n    \"\"\"Return merged tools settings with defaults applied.\"\"\"\n    raw = load_settings().get(\"tools\", {})\n    if not isinstance(raw, dict):\n        raw = {}\n    return _merge_dicts(_TOOLS_DEFAULTS, raw)\n\n\n_CHAT_DEFAULTS = {\n    \"companion_port\": 3457,\n    \"opencode_port\": 4096,\n}\n\n\ndef get_chat_settings() -> dict:\n    \"\"\"Return chat backend service configuration.\"\"\"\n    raw = load_settings().get(\"chat\", {})\n    if not isinstance(raw, dict):\n        raw = {}\n    return _merge_dicts(_CHAT_DEFAULTS, raw)\n\n\ndef load_settings() -> dict:\n    \"\"\"Load settings.json from PLUGIN_ROOT, returning {} on failure.\"\"\"\n    _migrate_legacy_settings_if_needed()\n    if SETTINGS_FILE.exists():\n        try:\n            return json.loads(SETTINGS_FILE.read_text(encoding=\"utf-8\"))\n        except (json.JSONDecodeError, OSError):\n            pass\n    return {}\n\n\ndef _migrate_legacy_settings_if_needed() -> None:\n    \"\"\"Migrate settings from legacy plugin-local file to persistent location.\n\n    Migration runs only for the default persistent path, so tests and custom\n    overrides that patch ``SETTINGS_FILE`` are unaffected.\n    \"\"\"\n    if SETTINGS_FILE != _DEFAULT_SETTINGS_FILE:\n        return\n    if SETTINGS_FILE == LEGACY_SETTINGS_FILE:\n        return\n    if SETTINGS_FILE.exists() or not LEGACY_SETTINGS_FILE.exists():\n        return\n\n    try:\n        SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n        SETTINGS_FILE.write_text(\n            LEGACY_SETTINGS_FILE.read_text(encoding=\"utf-8\"), encoding=\"utf-8\"\n        )\n    except OSError:\n        # Non-fatal: app can still proceed with defaults.\n        return\n\n\ndef _merge_dicts(base: dict, overlay: dict) -> dict:\n    merged = dict(base)\n    for key, value in overlay.items():\n        if isinstance(value, dict) and isinstance(merged.get(key), dict):\n            merged[key] = _merge_dicts(merged[key], value)\n        else:\n            merged[key] = value\n    return merged\n\n\ndef get_ralph_settings() -> dict:\n    \"\"\"Return merged ralph settings with defaults applied.\"\"\"\n    raw = load_settings().get(\"ralph\", {})\n    if not isinstance(raw, dict):\n        raw = {}\n    return _merge_dicts(_RALPH_DEFAULTS, raw)\n\n\ndef get_ralph_defaults() -> dict:\n    \"\"\"Return default provider/model/iterations for ralph_start.\"\"\"\n    settings = get_ralph_settings().get(\"defaults\", {})\n    defaults = dict(_RALPH_DEFAULTS[\"defaults\"])\n    defaults.update({k: v for k, v in settings.items() if v is not None})\n    iterations = defaults.get(\"iterations\")\n    if not isinstance(iterations, int) or iterations <= 0:\n        defaults[\"iterations\"] = _RALPH_DEFAULTS[\"defaults\"][\"iterations\"]\n    return defaults\n\n\ndef get_summarizer_config() -> dict:\n    \"\"\"Return summarizer provider/model configuration.\"\"\"\n    settings = get_ralph_settings().get(\"summarizer\", {})\n    config = dict(_RALPH_DEFAULTS[\"summarizer\"])\n    config.update({k: v for k, v in settings.items() if v})\n    return config\n\n\ndef save_ralph_settings(ralph_config: dict) -> None:\n    \"\"\"Write the ralph section back to settings.json, preserving other sections.\"\"\"\n    _migrate_legacy_settings_if_needed()\n    settings = load_settings()\n    settings[\"ralph\"] = ralph_config\n    SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)\n    tmp_file = SETTINGS_FILE.with_suffix(\".json.tmp\")\n    tmp_file.write_text(json.dumps(settings, indent=2), encoding=\"utf-8\")\n    tmp_file.replace(SETTINGS_FILE)\n\n\ndef get_sandbox_settings() -> dict:\n    \"\"\"Return merged sandbox settings with defaults applied.\"\"\"\n    raw = get_ralph_settings().get(\"sandbox\", {})\n    if not isinstance(raw, dict):\n        raw = {}\n    return _merge_dicts(_SANDBOX_DEFAULTS, raw)\n\n\ndef is_sandbox_enabled() -> bool:\n    \"\"\"Check whether sandbox mode is enabled.\"\"\"\n    return bool(get_sandbox_settings().get(\"enabled\", False))\n\n\ndef get_sandbox_credential_mounts() -> dict:\n    \"\"\"Return the credential_mounts section of sandbox settings.\"\"\"\n    return get_sandbox_settings().get(\"credential_mounts\", {})\n\n\ndef save_sandbox_settings(sandbox_config: dict) -> None:\n    \"\"\"Write sandbox section under ralph settings, preserving other sections.\"\"\"\n    ralph = get_ralph_settings()\n    ralph[\"sandbox\"] = sandbox_config\n    save_ralph_settings(ralph)\n\n\ndef validate_sandbox_settings(config_dict: dict) -> list[str]:\n    \"\"\"Validate sandbox settings. Returns list of error strings (empty = valid).\"\"\"\n    errors: list[str] = []\n\n    if \"enabled\" in config_dict and not isinstance(config_dict[\"enabled\"], bool):\n        errors.append(\"'enabled' must be a boolean\")\n\n    if \"image\" in config_dict:\n        if (\n            not isinstance(config_dict[\"image\"], str)\n            or not config_dict[\"image\"].strip()\n        ):\n            errors.append(\"'image' must be a non-empty string\")\n\n    if \"network_enabled\" in config_dict and not isinstance(\n        config_dict[\"network_enabled\"], bool\n    ):\n        errors.append(\"'network_enabled' must be a boolean\")\n\n    if \"ttl_seconds\" in config_dict:\n        ttl = config_dict[\"ttl_seconds\"]\n        if not isinstance(ttl, int) or ttl <= 0:\n            errors.append(\"'ttl_seconds' must be a positive integer\")\n\n    if \"credential_mounts\" in config_dict:\n        creds = config_dict[\"credential_mounts\"]\n        if not isinstance(creds, dict):\n            errors.append(\"'credential_mounts' must be a dict\")\n        else:\n            for name, entry in creds.items():\n                if not isinstance(entry, dict):\n                    errors.append(f\"credential_mounts.{name} must be a dict\")\n                elif \"enabled\" in entry and not isinstance(entry[\"enabled\"], bool):\n                    errors.append(f\"credential_mounts.{name}.enabled must be a boolean\")\n\n    return errors\n\n\ndef get_server_settings() -> dict:\n    \"\"\"Return merged server settings.  Priority: env vars > settings.json > defaults.\"\"\"\n    settings = load_settings().get(\"server\", {})\n    merged = {**_SERVER_DEFAULTS, **settings}\n\n    # Env var overrides (match existing RALPH_SERVER_* convention)\n    pytest_test = os.environ.get(\"PYTEST_CURRENT_TEST\")\n    allow_env_overrides = True\n    if pytest_test and \"env_var\" not in pytest_test:\n        allow_env_overrides = False\n    if allow_env_overrides:\n        if \"RALPH_SERVER_HOST\" in os.environ:\n            merged[\"host\"] = os.environ[\"RALPH_SERVER_HOST\"]\n        if \"RALPH_SERVER_PORT\" in os.environ:\n            merged[\"port\"] = int(os.environ[\"RALPH_SERVER_PORT\"])\n        if \"RALPH_SERVER_AUTO_START\" in os.environ:\n            merged[\"auto_start\"] = os.environ[\"RALPH_SERVER_AUTO_START\"].lower() in (\n                \"1\",\n                \"true\",\n                \"yes\",\n            )\n        if \"RALPH_SERVER_AUTO_OPEN\" in os.environ:\n            merged[\"auto_open_browser\"] = os.environ[\n                \"RALPH_SERVER_AUTO_OPEN\"\n            ].lower() in (\n                \"1\",\n                \"true\",\n                \"yes\",\n            )\n    if (\n        \"PYTEST_CURRENT_TEST\" in os.environ\n        and \"RALPH_SERVER_AUTO_OPEN\" not in os.environ\n        and \"PYTEST_DISABLE_AUTO_OPEN\" in os.environ\n        and \"env_var\" not in os.environ.get(\"PYTEST_CURRENT_TEST\", \"\")\n    ):\n        merged[\"auto_open_browser\"] = _SERVER_DEFAULTS[\"auto_open_browser\"]\n\n    return merged\n\n\ndef ensure_full_path() -> None:\n    \"\"\"On Windows, merge the full system+user PATH from the registry.\n\n    Some launch contexts (e.g. git-bash, certain IDE sandboxes) have a\n    stripped-down PATH missing entries like nodejs/ and npm/. The Windows\n    registry holds the authoritative PATH. Merging it ensures subprocesses\n    like ``claude`` and ``opencode`` can find their dependencies.\n\n    Safe to call multiple times; subsequent calls are no-ops.\n    \"\"\"\n    if platform.system() != \"Windows\":\n        return\n    try:\n        import winreg\n    except ImportError:\n        return\n\n    registry_dirs: list[str] = []\n    for hive, subkey in [\n        (\n            winreg.HKEY_LOCAL_MACHINE,\n            r\"SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\",\n        ),\n        (winreg.HKEY_CURRENT_USER, r\"Environment\"),\n    ]:\n        try:\n            key = winreg.OpenKey(hive, subkey)\n            raw = winreg.QueryValueEx(key, \"Path\")[0]\n            winreg.CloseKey(key)\n            registry_dirs.extend(\n                os.path.expandvars(d) for d in raw.split(\";\") if d.strip()\n            )\n        except OSError:\n            continue\n\n    current = set(os.environ.get(\"PATH\", \"\").split(\";\"))\n    new_dirs = [d for d in registry_dirs if d not in current and os.path.isdir(d)]\n    if new_dirs:\n        os.environ[\"PATH\"] = os.environ.get(\"PATH\", \"\") + \";\" + \";\".join(new_dirs)\n\n\n# Module-level HOST / PORT for backward compatibility\n_server = get_server_settings()\nHOST = _server[\"host\"]\nPORT = _server[\"port\"]\n","numLines":335,"startLine":1,"totalLines":335}}}
