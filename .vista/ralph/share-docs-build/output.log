       {% if diagram.description %}\n                            <span class=\"text-gray-500 text-xs truncate hidden sm:inline\">\n                                {{ diagram.description }}\n                            </span>\n                            {% endif %}\n                        </div>\n                        <button onclick=\"expandDiagram(this)\" class=\"diagram-expand-btn\" title=\"Expand\">&#x26F6;</button>\n                    </div>\n                    <div class=\"diagram-body\">\n                        <div class=\"diagram-viewport\" id=\"viewport-{{ did }}\">\n                            <div class=\"mermaid-placeholder\" id=\"mermaid-{{ did }}\">\n                                Loading...\n                            </div>\n                        </div>\n                        <div class=\"diagram-zoom-controls\">\n                            <button onclick=\"zoomDiagram('{{ did }}', -0.2)\">&minus;</button>\n                            <button onclick=\"resetZoom('{{ did }}')\">1:1</button>\n                            <button onclick=\"zoomDiagram('{{ did }}', 0.2)\">+</button>\n                        </div>\n                    </div>\n                </div>\n                {% endfor %}\n            </div>\n            {% endif %}","originalFile":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>{{ project_name }} - Documentation Export</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/marked@15/marked.min.js\"></script>\n    <style>\n        .diagram-card {\n            background: #1e293b;\n            border: 2px solid #334155;\n            border-radius: 8px;\n            overflow: hidden;\n            transition: border-color 0.2s, box-shadow 0.2s;\n        }\n        .diagram-card:hover {\n            border-color: #475569;\n            box-shadow: 0 0 0 1px #475569;\n        }\n        .diagram-header {\n            padding: 10px 16px;\n            border-bottom: 1px solid #334155;\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 8px;\n        }\n        .diagram-body {\n            position: relative;\n            overflow: hidden;\n            background: #0f172a;\n            min-height: 200px;\n            max-height: 500px;\n        }\n        .diagram-viewport {\n            width: 100%;\n            height: 100%;\n            cursor: grab;\n            transform-origin: 0 0;\n            padding: 16px;\n        }\n        .diagram-viewport:active {\n            cursor: grabbing;\n        }\n        .diagram-viewport .mermaid svg {\n            max-width: none;\n        }\n        .diagram-viewport .mermaid svg .flowchart-link,\n        .diagram-viewport .mermaid svg .edge-pattern-dotted,\n        .diagram-viewport .mermaid svg path.path,\n        .diagram-viewport .mermaid svg path[class*=\"edge\"],\n        .diagram-viewport .mermaid svg line {\n            stroke-width: 2.5px !important;\n        }\n        .diagram-viewport .mermaid svg .edgeLabel,\n        .diagram-viewport .mermaid svg .nodeLabel,\n        .diagram-viewport .mermaid svg .label {\n            font-size: 14px !important;\n        }\n        .diagram-viewport .mermaid svg .edgeLabel {\n            font-size: 12px !important;\n        }\n        .diagram-viewport .mermaid svg marker path {\n            stroke-width: 1.5px !important;\n        }\n        .diagram-zoom-controls {\n            position: absolute;\n            bottom: 8px;\n            right: 8px;\n            display: flex;\n            gap: 4px;\n            z-index: 5;\n        }\n        .diagram-zoom-controls button {\n            width: 28px;\n            height: 28px;\n            border-radius: 4px;\n            background: #334155;\n            color: #e2e8f0;\n            border: 1px solid #475569;\n            cursor: pointer;\n            font-size: 0.875rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            opacity: 0.7;\n            transition: opacity 0.2s;\n        }\n        .diagram-zoom-controls button:hover {\n            opacity: 1;\n            background: #475569;\n        }\n        .badge {\n            font-size: 0.65rem;\n            padding: 2px 8px;\n            border-radius: 10px;\n            font-weight: 600;\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n        }\n        .badge-arch {\n            background: #1e3a5f;\n            color: #60a5fa;\n        }\n        .badge-tdd {\n            background: #422006;\n            color: #fbbf24;\n        }\n        .diagram-expand-btn {\n            width: 28px;\n            height: 28px;\n            border-radius: 4px;\n            background: transparent;\n            color: #94a3b8;\n            border: 1px solid transparent;\n            cursor: pointer;\n            font-size: 1rem;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: all 0.15s;\n            flex-shrink: 0;\n        }\n        .diagram-expand-btn:hover {\n            background: #334155;\n            color: #e2e8f0;\n            border-color: #475569;\n        }\n        /* Requirements prose styling */\n        .requirements-content h1,\n        .requirements-content h2,\n        .requirements-content h3,\n        .requirements-content h4 {\n            color: #e2e8f0;\n            margin-top: 1.2em;\n            margin-bottom: 0.5em;\n            font-weight: 600;\n        }\n        .requirements-content h1 { font-size: 1.5rem; }\n        .requirements-content h2 { font-size: 1.25rem; }\n        .requirements-content h3 { font-size: 1.1rem; }\n        .requirements-content p {\n            color: #cbd5e1;\n            margin-bottom: 0.75em;\n            line-height: 1.6;\n        }\n        .requirements-content ul,\n        .requirements-content ol {\n            color: #cbd5e1;\n            margin-bottom: 0.75em;\n            padding-left: 1.5em;\n        }\n        .requirements-content li {\n            margin-bottom: 0.25em;\n        }\n        .requirements-content code {\n            background: #1e293b;\n            padding: 0.15em 0.4em;\n            border-radius: 4px;\n            font-size: 0.875em;\n            color: #f472b6;\n        }\n        .requirements-content pre {\n            background: #0f172a;\n            padding: 1em;\n            border-radius: 6px;\n            overflow-x: auto;\n            margin-bottom: 0.75em;\n        }\n        .requirements-content pre code {\n            background: transparent;\n            padding: 0;\n            color: #e2e8f0;\n        }\n        .requirements-content table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 0.75em;\n        }\n        .requirements-content th,\n        .requirements-content td {\n            border: 1px solid #334155;\n            padding: 0.5em 0.75em;\n            text-align: left;\n            color: #cbd5e1;\n        }\n        .requirements-content th {\n            background: #1e293b;\n            color: #e2e8f0;\n            font-weight: 600;\n        }\n        .requirements-content strong {\n            color: #e2e8f0;\n        }\n        .requirements-content a {\n            color: #60a5fa;\n        }\n        .requirements-content blockquote {\n            border-left: 3px solid #475569;\n            padding-left: 1em;\n            color: #94a3b8;\n            margin-bottom: 0.75em;\n        }\n    </style>\n</head>\n<body class=\"bg-gray-900 text-gray-100 min-h-screen\">\n    <!-- Header -->\n    <header class=\"bg-gray-800 border-b border-gray-700 px-6 py-4\">\n        <div class=\"max-w-7xl mx-auto flex items-center justify-between\">\n            <div class=\"flex items-center gap-3\">\n                <span class=\"text-green-400 font-semibold text-lg\">Vista Dashboard</span>\n                <span class=\"text-gray-600\">&middot;</span>\n                <span class=\"text-xl font-bold\">{{ project_name }}</span>\n            </div>\n            <span class=\"text-gray-400 text-sm\">Exported {{ export_date }}</span>\n        </div>\n    </header>\n\n    {% if features|length > 1 %}\n    <nav class=\"bg-gray-800/50 border-b border-gray-700 px-6 py-2\">\n        <div class=\"max-w-7xl mx-auto flex gap-4\">\n            {% for feature in features %}\n            <a href=\"#feature-{{ feature.name }}\"\n               class=\"text-sm text-gray-400 hover:text-gray-200 transition-colors capitalize\">\n                {{ feature.name | replace('_', ' ') }}\n            </a>\n            {% endfor %}\n        </div>\n    </nav>\n    {% endif %}\n\n    <main class=\"max-w-7xl mx-auto px-6 py-8\">\n        {% for feature in features %}\n        <section id=\"feature-{{ feature.name }}\" class=\"mb-12\">\n            <h2 class=\"text-2xl font-bold mb-6 capitalize\">\n                {{ feature.name | replace('_', ' ') }}\n            </h2>\n\n            {% if feature.diagrams %}\n            <div class=\"space-y-6 mb-8\">\n                {% for diagram in feature.diagrams %}\n                <div class=\"diagram-card\" data-idx=\"{{ loop.index0 }}\">\n                    <div class=\"diagram-header\">\n                        <div class=\"flex items-center gap-2 flex-1 min-w-0\">\n                            <span class=\"font-semibold text-sm\">{{ diagram.name }}</span>\n                            <span class=\"badge {{ 'badge-tdd' if diagram.category == 'tdd' else 'badge-arch' }}\">\n                                {{ diagram.category or 'architecture' }}\n                            </span>\n                            {% if diagram.description %}\n                            <span class=\"text-gray-500 text-xs truncate hidden sm:inline\">\n                                {{ diagram.description }}\n                            </span>\n                            {% endif %}\n                        </div>\n                        <button onclick=\"expandDiagram(this)\" class=\"diagram-expand-btn\" title=\"Expand\">&#x26F6;</button>\n                    </div>\n                    <div class=\"diagram-body\">\n                        <div class=\"diagram-viewport\" id=\"viewport-{{ loop.parent.loop.index0 }}-{{ loop.index0 }}\">\n                            <div class=\"mermaid-placeholder\" id=\"mermaid-{{ loop.parent.loop.index0 }}-{{ loop.index0 }}\">\n                                Loading...\n                            </div>\n                        </div>\n                        <div class=\"diagram-zoom-controls\">\n                            <button onclick=\"zoomDiagram('{{ loop.parent.loop.index0 }}-{{ loop.index0 }}', -0.2)\">&minus;</button>\n                            <button onclick=\"resetZoom('{{ loop.parent.loop.index0 }}-{{ loop.index0 }}')\">1:1</button>\n                            <button onclick=\"zoomDiagram('{{ loop.parent.loop.index0 }}-{{ loop.index0 }}', 0.2)\">+</button>\n                        </div>\n                    </div>\n                </div>\n                {% endfor %}\n            </div>\n            {% endif %}\n\n            {% if feature.requirements_md %}\n            <div class=\"bg-gray-800 rounded-lg border border-gray-700 p-6\">\n                <h3 class=\"text-lg font-semibold mb-4\">Domain Requirements</h3>\n                <div class=\"requirements-content\"\n                     id=\"requirements-{{ feature.name }}\">\n                </div>\n            </div>\n            {% endif %}\n        </section>\n        {% endfor %}\n    </main>\n\n    <!-- Modal Overlay -->\n    <div id=\"diagram-modal\" class=\"fixed inset-0 bg-black/80 z-50 hidden items-center justify-center\"\n         onclick=\"closeModal(event)\" style=\"display:none;\">\n        <div class=\"bg-gray-900 rounded-lg border border-gray-700 w-[95vw] h-[90vh] flex flex-col\"\n             onclick=\"event.stopPropagation()\">\n            <div class=\"flex items-center justify-between px-4 py-3 border-b border-gray-700\">\n                <span id=\"modal-title\" class=\"font-semibold\"></span>\n                <button onclick=\"closeModal()\" class=\"text-gray-400 hover:text-white text-xl\">&times;</button>\n            </div>\n            <div class=\"flex-1 overflow-auto p-4\" id=\"modal-content\"></div>\n        </div>\n    </div>\n\n    <!-- Data: embed diagram sources and requirements as JSON -->\n    <script id=\"export-data\" type=\"application/json\">\n        {{ export_data | tojson }}\n    </script>\n\n    <script>\n        // Parse embedded data\n        const EXPORT_DATA = JSON.parse(\n            document.getElementById('export-data').textContent\n        );\n\n        // --- Mermaid Init ---\n        mermaid.initialize({\n            startOnLoad: false,\n            theme: 'dark',\n            themeVariables: {\n                darkMode: true,\n                background: '#0f172a',\n                primaryColor: '#1e3a5f',\n                primaryTextColor: '#e2e8f0',\n                primaryBorderColor: '#475569',\n                lineColor: '#94a3b8',\n                secondaryColor: '#1a2332',\n                tertiaryColor: '#0f172a',\n                fontSize: '14px',\n            }\n        });\n\n        // --- Marked config ---\n        marked.setOptions({ breaks: true, gfm: true });\n\n        // --- Render all diagrams ---\n        let mermaidCounter = 0;\n\n        async function renderAllDiagrams() {\n            for (const item of EXPORT_DATA.diagrams) {\n                const el = document.getElementById(`mermaid-${item.id}`);\n                if (!el) continue;\n                try {\n                    const renderId = `mermaid-svg-export-${++mermaidCounter}`;\n                    const { svg } = await mermaid.render(renderId, item.content);\n                    el.innerHTML = svg;\n                    initViewport(item.id);\n                } catch (e) {\n                    el.innerHTML = `<pre class=\"text-yellow-400 text-xs whitespace-pre-wrap\">Mermaid parse error:\\n${e.message || e}\\n\\n${escapeHtml(item.content)}</pre>`;\n                    initViewport(item.id);\n                }\n            }\n        }\n\n        // --- Render all requirements ---\n        function renderAllRequirements() {\n            for (const [featureName, markdown] of Object.entries(EXPORT_DATA.requirements)) {\n                if (!markdown) continue;\n                const el = document.getElementById(`requirements-${featureName}`);\n                if (!el) continue;\n                el.innerHTML = marked.parse(markdown);\n            }\n        }\n\n        // --- Pan/zoom ---\n        const viewportState = {};\n\n        function initViewport(idx) {\n            const vp = document.getElementById(`viewport-${idx}`);\n            if (!vp) return;\n            viewportState[idx] = { scale: 1, panX: 0, panY: 0, dragging: false, startX: 0, startY: 0 };\n            vp.addEventListener('wheel', (e) => {\n                e.preventDefault();\n                const delta = e.deltaY > 0 ? -0.1 : 0.1;\n                zoomDiagram(idx, delta);\n            }, { passive: false });\n            vp.addEventListener('mousedown', (e) => {\n                if (e.button !== 0) return;\n                const st = viewportState[idx];\n                st.dragging = true;\n                st.startX = e.clientX - st.panX;\n                st.startY = e.clientY - st.panY;\n                vp.style.cursor = 'grabbing';\n            });\n            vp.addEventListener('mousemove', (e) => {\n                const st = viewportState[idx];\n                if (!st.dragging) return;\n                st.panX = e.clientX - st.startX;\n                st.panY = e.clientY - st.startY;\n                applyTransform(idx);\n            });\n            const stopDrag = () => {\n                const st = viewportState[idx];\n                if (st) st.dragging = false;\n                vp.style.cursor = 'grab';\n            };\n            vp.addEventListener('mouseup', stopDrag);\n            vp.addEventListener('mouseleave', stopDrag);\n        }\n\n        function applyTransform(idx) {\n            const vp = document.getElementById(`viewport-${idx}`);\n            const st = viewportState[idx];\n            if (!vp || !st) return;\n            vp.style.transform = `translate(${st.panX}px, ${st.panY}px) scale(${st.scale})`;\n        }\n\n        function zoomDiagram(idx, delta) {\n            const st = viewportState[idx];\n            if (!st) return;\n            st.scale = Math.max(0.3, Math.min(3, st.scale + delta));\n            applyTransform(idx);\n        }\n\n        function resetZoom(idx) {\n            const st = viewportState[idx];\n            if (!st) return;\n            st.scale = 1; st.panX = 0; st.panY = 0;\n            applyTransform(idx);\n        }\n\n        // --- Modal expand/close ---\n        function expandDiagram(btn) {\n            const card = btn.closest('.diagram-card');\n            const viewport = card.querySelector('.diagram-viewport');\n            const title = card.querySelector('.diagram-header .font-semibold');\n            const modal = document.getElementById('diagram-modal');\n            const modalTitle = document.getElementById('modal-title');\n            const modalContent = document.getElementById('modal-content');\n\n            modalTitle.textContent = title ? title.textContent : 'Diagram';\n            modalContent.innerHTML = viewport.innerHTML;\n            modal.style.display = 'flex';\n        }\n\n        function closeModal(event) {\n            if (event && event.target !== event.currentTarget) return;\n            const modal = document.getElementById('diagram-modal');\n            modal.style.display = 'none';\n        }\n\n        // Close modal on Escape\n        document.addEventListener('keydown', (e) => {\n            if (e.key === 'Escape') closeModal();\n        });\n\n        function escapeHtml(str) {\n            if (!str) return '';\n            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n        }\n\n        // --- Feature nav smooth scroll ---\n        document.querySelectorAll('nav a[href^=\"#\"]').forEach(a => {\n            a.addEventListener('click', (e) => {\n                e.preventDefault();\n                const target = document.querySelector(a.getAttribute('href'));\n                if (target) target.scrollIntoView({ behavior: 'smooth' });\n            });\n        });\n\n        // --- Init ---\n        renderAllDiagrams();\n        renderAllRequirements();\n    </script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":233,"oldLines":6,"newStart":233,"newLines":7,"lines":[" ","     <main class=\"max-w-7xl mx-auto px-6 py-8\">","         {% for feature in features %}","+        {% set fi = loop.index0 %}","         <section id=\"feature-{{ feature.name }}\" class=\"mb-12\">","             <h2 class=\"text-2xl font-bold mb-6 capitalize\">","                 {{ feature.name | replace('_', ' ') }}"]},{"oldStart":241,"oldLines":7,"newStart":242,"newLines":8,"lines":["             {% if feature.diagrams %}","             <div class=\"space-y-6 mb-8\">","                 {% for diagram in feature.diagrams %}","-                <div class=\"diagram-card\" data-idx=\"{{ loop.index0 }}\">","+                {% set did = fi ~ '-' ~ loop.index0 %}","+                <div class=\"diagram-card\" data-idx=\"{{ did }}\">","                     <div class=\"diagram-header\">","                         <div class=\"flex items-center gap-2 flex-1 min-w-0\">","                             <span clas