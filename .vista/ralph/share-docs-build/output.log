   vp.addEventListener('mouseleave', stopDrag);\n  1388→}\n  1389→\n  1390→function applyTransform(idx) {\n  1391→    const vp = document.getElementById(`viewport-${idx}`);\n  1392→    const st = viewportState[idx];\n  1393→    if (!vp || !st) return;\n  1394→    vp.style.transform = `translate(${st.panX}px, ${st.panY}px) scale(${st.scale})`;\n  1395→}\n  1396→\n  1397→function zoomDiagram(idx, delta) {\n  1398→    const st = viewportState[idx];\n  1399→    if (!st) return;\n  1400→    st.scale = Math.max(0.3, Math.min(3, st.scale + delta));\n  1401→    applyTransform(idx);\n  1402→}\n  1403→\n  1404→function resetZoom(idx) {\n  1405→    const st = viewportState[idx];\n  1406→    if (!st) return;\n  1407→    st.scale = 1; st.panX = 0; st.panY = 0;\n  1408→    applyTransform(idx);\n  1409→}\n  1410→\n  1411→// =========================================================================\n  1412→// Chat panel toggle\n  1413→// =========================================================================\n  1414→\n  1415→function toggleChat() {\n  1416→    const panel = document.getElementById('chat-panel');\n  1417→    const fab = document.getElementById('chat-fab');\n  1418→    panel.classList.toggle('open');\n  1419→    const isOpen = panel.classList.contains('open');\n  1420→    fab.classList.toggle('hidden-fab', isOpen);\n  1421→    if (isOpen && !currentSessionId) {\n  1422→        loadSessions();\n  1423→    }"}]},"parent_tool_use_id":null,"session_id":"c06c8987-38bb-4a43-9247-2ef00a647fd1","uuid":"de936633-89de-4ae4-a592-8802b2ee996a","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Grove\\OneDrive\\Documents\\PYTHON\\claude_plugins\\vista\\vista\\server\\views\\architecture.html","content":"let isStreaming = false;\nlet streamingMsgEl = null;\nlet streamingText = '';\nlet mermaidCounter = DIAGRAMS.length + 100; // for dynamic re-renders\n\n// --- Mermaid init ---\nmermaid.initialize({\n    startOnLoad: false,\n    theme: 'dark',\n    themeVariables: {\n        darkMode: true,\n        background: '#0f172a',\n        primaryColor: '#1e3a5f',\n        primaryTextColor: '#e2e8f0',\n        primaryBorderColor: '#475569',\n        lineColor: '#94a3b8',\n        secondaryColor: '#1a2332',\n        tertiaryColor: '#0f172a',\n        fontSize: '14px',\n    }\n});\n\nconst lightThemeVariables = {\n    background: '#ffffff',\n    primaryColor: '#dbeafe',\n    primaryTextColor: '#1e293b',\n    primaryBorderColor: '#94a3b8',\n    lineColor: '#475569',\n    secondaryColor: '#f8fafc',\n    tertiaryColor: '#f1f5f9',\n    fontSize: '14px',\n};\n\nconst darkThemeVariables = {\n    darkMode: true,\n    background: '#0f172a',\n    primaryColor: '#1e3a5f',\n    primaryTextColor: '#e2e8f0',\n    primaryBorderColor: '#475569',\n    lineColor: '#94a3b8',\n    secondaryColor: '#1a2332',\n    tertiaryColor: '#0f172a',\n    fontSize: '14px',\n};\n\n// --- Marked config for assistant messages ---\nmarked.setOptions({ breaks: true, gfm: true });\n\n// =========================================================================\n// Diagram loading & rendering\n// =========================================================================\n\nasync function loadDiagrams() {\n    for (let i = 0; i < DIAGRAMS.length; i++) {\n        const diagram = DIAGRAMS[i];\n        const el = document.getElementById(`mermaid-${i + 1}`);\n        if (!el) continue;\n        try {\n            const resp = await fetch(`/api/projects/${PROJECT_ID}/features/${FEATURE_NAME}/arch/${diagram.file}`);\n            if (!resp.ok) throw new Error('Failed to load');\n            const content = await resp.text();\n            diagramContents[diagram.file] = content;\n            await renderDiagramContent(el, diagram.file, content, i + 1);\n            initViewport(i + 1);\n        } catch (err) {\n            el.innerHTML = `<span class=\"text-red-400 text-sm\">Failed to load ${diagram.file}</span>`;\n        }\n    }\n}\n\nasync function renderDiagramContent(el, filename, content, idx) {\n    if (filename.endsWith('.mmd')) {\n        try {\n            const id = `mermaid-svg-${idx}-${++mermaidCounter}`;\n            const { svg } = await mermaid.render(id, content);\n            el.innerHTML = svg;\n            // Add click handlers on nodes for element selection\n            el.querySelectorAll('.node').forEach(node => {\n                node.style.cursor = 'pointer';\n                node.addEventListener('click', (e) => {\n                    e.stopPropagation();\n                    const nodeId = extractNodeId(node.id, node);\n                    if (nodeId) toggleElementSelection(filename, nodeId, node);\n                });\n            });\n            // Re-apply any existing selections\n            reapplySelections(el, filename);\n        } catch (e) {\n            el.innerHTML = `<pre class=\"text-yellow-400 text-xs whitespace-pre-wrap\">Mermaid parse error:\\n${e.message || e}\\n\\n${content}</pre>`;\n        }\n    } else if (filename.endsWith('.puml') || filename.endsWith('.d2')) {\n        // Server-side rendered formats\n        try {\n            const resp = await fetch(`/api/projects/${PROJECT_ID}/features/${FEATURE_NAME}/arch/${filename}/render`);\n            const result = await resp.json();\n            if (result.svg) {\n                el.innerHTML = result.svg;\n            } else {\n                el.innerHTML = `<div class=\"text-yellow-400 text-xs mb-2\">${escapeHtml(result.error || 'Render failed')}</div><pre class=\"text-gray-400 text-xs whitespace-pre-wrap\">${escapeHtml(result.raw_source || content)}</pre>`;\n            }\n        } catch (e) {\n            el.innerHTML = `<pre class=\"text-gray-400 text-xs whitespace-pre-wrap\">${escapeHtml(content)}</pre>`;\n        }\n    } else if (filename.endsWith('.excalidraw')) {\n        // Excalidraw JSON — render as readable summary or load component\n        try {\n            const data = JSON.parse(content);\n            const labels = (data.elements || [])\n                .filter(e => e.type === 'text' || (e.type !== 'arrow' && e.type !== 'line'))\n                .map(e => e.text || e.type)\n                .filter(Boolean);\n            el.innerHTML = `<div class=\"text-gray-400 text-xs mb-2\">Excalidraw diagram (${(data.elements || []).length} elements)</div><pre class=\"text-gray-300 text-xs whitespace-pre-wrap\">${escapeHtml(labels.join('\\n') || 'No text labels found')}</pre>`;\n        } catch (e) {\n            el.innerHTML = `<pre class=\"text-gray-400 text-xs whitespace-pre-wrap\">${escapeHtml(content)}</pre>`;\n        }\n    } else if (filename.endsWith('.txt')) {\n        // ASCII art — monospace pre block\n        el.innerHTML = `<pre class=\"text-gray-200 text-xs whitespace-pre\" style=\"font-family:'Cascadia Code','Fira Code','JetBrains Mono',monospace;line-height:1.4\">${escapeHtml(content)}</pre>`;\n    } else {\n        el.innerHTML = `<pre class=\"text-gray-400 text-xs whitespace-pre-wrap\">${escapeHtml(content)}</pre>`;\n    }\n}\n\nfunction escapeHtml(str) {\n    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n}\n\nloadDiagrams();\n\n// =========================================================================\n// Pan & Zoom\n// =========================================================================\n\nfunction initViewport(idx) {\n    const vp = document.getElementById(`viewport-${idx}`);\n    if (!vp) return;\n    viewportState[idx] = { scale: 1, panX: 0, panY: 0, dragging: false, startX: 0, startY: 0 };\n    vp.addEventListener('wheel', (e) => {\n        e.preventDefault();\n        const delta = e.deltaY > 0 ? -0.1 : 0.1;\n        zoomDiagram(idx, delta);\n    }, { passive: false });\n    vp.addEventListener('mousedown', (e) => {\n        if (e.button !== 0) return;\n        const st = viewportState[idx];\n        st.dragging = true;\n        st.startX = e.clientX - st.panX;\n        st.startY = e.clientY - st.panY;\n        vp.style.cursor = 'grabbing';\n    });\n    vp.addEventListener('mousemove', (e) => {\n        const st = viewportState[idx];\n        if (!st.dragging) return;\n        st.panX = e.clientX - st.startX;\n        st.panY = e.clientY - st.startY;\n        applyTransform(idx);\n    });\n    const stopDrag = () => {\n        const st = viewportState[idx];\n        if (st) st.dragging = false;\n        vp.style.cursor = 'grab';\n    };\n    vp.addEventListener('mouseup', stopDrag);\n    vp.addEventListener('mouseleave', stopDrag);\n}\n\nfunction applyTransform(idx) {\n    const vp = document.getElementById(`viewport-${idx}`);\n    const st = viewportState[idx];\n    if (!vp || !st) return;\n    vp.style.transform = `translate(${st.panX}px, ${st.panY}px) scale(${st.scale})`;\n}\n\nfunction zoomDiagram(idx, delta) {\n    const st = viewportState[idx];\n    if (!st) return;\n    st.scale = Math.max(0.3, Math.min(3, st.scale + delta));\n    applyTransform(idx);\n}\n\nfunction resetZoom(idx) {\n    const st = viewportState[idx];\n    if (!st) return;\n    st.scale = 1; st.panX = 0; st.panY = 0;\n    applyTransform(idx);\n}\n\n// =========================================================================\n// Chat panel toggle\n// =========================================================================\n\nfunction toggleChat() {\n    const panel = document.getElementById('chat-panel');\n    const fab = document.getElementById('chat-fab');\n    panel.classList.toggle('open');\n    const isOpen = panel.classList.contains('open');\n    fab.classList.toggle('hidden-fab', isOpen);\n    if (isOpen && !currentSessionId) {\n        loadSessions();\n    }","numLines":200,"startLine":1224,"totalLines":2465}}}
