i = 0; i < DIAGRAMS.length; i++) {\n  1278→        const diagram = DIAGRAMS[i];\n  1279→        const el = document.getElementById(`mermaid-${i + 1}`);\n  1280→        if (!el) continue;\n  1281→        try {\n  1282→            const resp = await fetch(`/api/projects/${PROJECT_ID}/features/${FEATURE_NAME}/arch/${diagram.file}`);\n  1283→            if (!resp.ok) throw new Error('Failed to load');\n  1284→            const content = await resp.text();\n  1285→            diagramContents[diagram.file] = content;\n  1286→            await renderDiagramContent(el, diagram.file, content, i + 1);\n  1287→            initViewport(i + 1);\n  1288→        } catch (err) {\n  1289→            el.innerHTML = `<span class=\"text-red-400 text-sm\">Failed to load ${diagram.file}</span>`;\n  1290→        }\n  1291→    }\n  1292→}\n  1293→\n  1294→async function renderDiagramContent(el, filename, content, idx) {\n  1295→    if (filename.endsWith('.mmd')) {\n  1296→        try {\n  1297→            const id = `mermaid-svg-${idx}-${++mermaidCounter}`;\n  1298→            const { svg } = await mermaid.render(id, content);\n  1299→            el.innerHTML = svg;\n  1300→            // Add click handlers on nodes for element selection\n  1301→            el.querySelectorAll('.node').forEach(node => {\n  1302→                node.style.cursor = 'pointer';\n  1303→                node.addEventListener('click', (e) => {\n  1304→                    e.stopPropagation();\n  1305→                    const nodeId = extractNodeId(node.id, node);\n  1306→                    if (nodeId) toggleElementSelection(filename, nodeId, node);\n  1307→                });\n  1308→            });\n  1309→            // Re-apply any existing selections\n  1310→            reapplySelections(el, filename);\n  1311→        } catch (e) {\n  1312→            el.innerHTML = `<pre class=\"text-yellow-400 text-xs whitespace-pre-wrap\">Mermaid parse error:\\n${e.message || e}\\n\\n${content}</pre>`;\n  1313→        }\n  1314→    } else if (filename.endsWith('.puml') || filename.endsWith('.d2')) {\n  1315→        // Server-side rendered formats\n  1316→        try {\n  1317→            const resp = await fetch(`/api/projects/${PROJECT_ID}/features/${FEATURE_NAME}/arch/${filename}/render`);\n  1318→            const result = await resp.json();\n  1319→            if (result.svg) {\n  1320→                el.innerHTML = result.svg;\n  1321→            } else {\n  1322→                el.innerHTML = `<div class=\"text-yellow-400 text-xs mb-2\">${escapeHtml(result.error || 'Render failed')}</div><pre class=\"text-gray-400 text-xs whitespace-pre-wrap\">${escapeHtml(result.raw_source || content)}</pre>`;\n  1323→            }\n  1324→        } catch (e) {\n  1325→            el.innerHTML = `<pre class=\"text-gray-400 text-xs whitespace-pre-wrap\">${escapeHtml(content)}</pre>`;\n  1326→        }\n  1327→    } else if (filename.endsWith('.excalidraw')) {\n  1328→        // Excalidraw JSON — render as readable summary or load component\n  1329→        try {\n  1330→            const data = JSON.parse(content);\n  1331→            const labels = (data.elements || [])\n  1332→                .filter(e => e.type === 'text' || (e.type !== 'arrow' && e.type !== 'line'))\n  1333→                .map(e => e.text || e.type)\n  1334→                .filter(Boolean);\n  1335→            el.innerHTML = `<div class=\"text-gray-400 text-xs mb-2\">Excalidraw diagram (${(data.elements || []).length} elements)</div><pre class=\"text-gray-300 text-xs whitespace-pre-wrap\">${escapeHtml(labels.join('\\n') || 'No text labels found')}</pre>`;\n  1336→        } catch (e) {\n  1337→            el.innerHTML = `<pre class=\"text-gray-400 text-xs whitespace-pre-wrap\">${escapeHtml(content)}</pre>`;\n  1338→        }\n  1339→    } else if (filename.endsWith('.txt')) {\n  1340→        // ASCII art — monospace pre block\n  1341→        el.innerHTML = `<pre class=\"text-gray-200 text-xs whitespace-pre\" style=\"font-fa