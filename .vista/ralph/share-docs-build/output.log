{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BnLSGVmwvCduxnJ1psUR2n","type":"tool_result","content":"     1→\"\"\"FastAPI web server entry point - Vista Dashboard.\"\"\"\n     2→\n     3→import json\n     4→from contextlib import asynccontextmanager\n     5→from pathlib import Path\n     6→\n     7→from fastapi import FastAPI, Request\n     8→from fastapi.staticfiles import StaticFiles\n     9→from fastapi.templating import Jinja2Templates\n    10→\n    11→from server import config\n    12→from server.services.project_service import ProjectService\n    13→from server.services.loop_service import loop_service\n    14→from server.services.diagram_watcher import diagram_watcher\n    15→from server.services.provider_service import get_enabled_providers\n    16→from server.services.output_parser import parse_stream_json_activity\n    17→from server.services.ralph_service import ralph_service\n    18→from server.services.service_lifecycle import (\n    19→    service_lifecycle,\n    20→    companion_config,\n    21→    opencode_config,\n    22→)\n    23→from server.services.provider_router import provider_router\n    24→\n    25→\n    26→@asynccontextmanager\n    27→async def lifespan(app: FastAPI):\n    28→    \"\"\"Startup and shutdown lifecycle.\"\"\"\n    29→    config.ensure_full_path()\n    30→    config.DATA_DIR.mkdir(parents=True, exist_ok=True)\n    31→    (config.DATA_DIR / \"sessions\").mkdir(exist_ok=True)\n    32→\n    33→    # Register and start backend services\n    34→    service_lifecycle.register(companion_config())\n    35→    service_lifecycle.register(opencode_config())\n    36→    await service_lifecycle.start_all()\n    37→\n    38→    yield\n    39→\n    40→    # Shutdown\n    41→    await provider_router.cleanup_all()\n    42→    await service_lifecycle.stop_all()\n    43→    await loop_service.stop_all()\n    44→    await diagram_watcher.stop()\n    45→\n    46→\n    47→app = FastAPI(title=\"Ralph Loop Dashboard\", version=\"1.4.1\", lifespan=lifespan)\n    48→\n    49→# Mount static files\n    50→config.STATIC_DIR.mkdir(parents=True, exist_ok=True)\n    51→app.mount(\"/static\", StaticFiles(directory=str(config.STATIC_DIR)), name=\"static\")\n    52→\n    53→# Templates\n    54→templates = Jinja2Templates(directory=str(config.VIEWS_DIR))\n    55→\n    56→# Include routers\n    57→from server.routes import (\n    58→    projects,\n    59→    loops,\n    60→    stream,\n    61→    plans,\n    62→    providers,\n    63→    shutdown,\n    64→    architecture,\n    65→    chat_sessions,\n    66→    ralph,\n    67→    ralph_settings,\n    68→    sandbox,\n    69→    service_status,\n    70→)\n    71→\n    72→app.include_router(projects.router)\n    73→app.include_router(loops.router)\n    74→app.include_router(stream.router)\n    75→app.include_router(plans.router)\n    76→app.include_router(providers.router)\n    77→app.include_router(shutdown.router)\n    78→app.include_router(architecture.router)\n    79→app.include_router(chat_sessions.router)\n    80→app.include_router(ralph.router)\n    81→app.include_router(ralph_settings.router)\n    82→app.include_router(sandbox.router)\n    83→app.include_router(service_status.router)\n    84→\n    85→\n    86→@app.get(\"/api/health\")\n    87→async def health_check():\n    88→    \"\"\"Health check endpoint for monitoring and hooks.\"\"\"\n    89→    running_loops = {\n    90→        pid: state.to_dict()\n    91→        for pid, state in loop_service.get_all_states().items()\n    92→        if state.status in (\"running\", \"starting\")\n    93→    }\n    94→    return {\n    95→        \"status\": \"ok\",\n    96→        \"version\": app.version,\n    97→        \"running_loops\": len(running_loops),\n    98→    }\n    99→\n   100→\n   101→@app.get(\"/api/loops/running\")\n   102→async def running_loops_summary():\n   103→    \"\"\"Return compact summary of active loops for global app-bar status UI.\"\"\"\n   104→    project_map = {p.id: p for p in ProjectService.get_all()}\n   105→    summaries = []\n   106→    for project_id, state in loop_service.get_all_states().items():\n   107→        if state.status not in (\"running\", \"starting\"):\n   108→            continue\n   109→\n   110→        max_iters = state.max_iterations or 0\n   111→        progress = None\n   112→        if max_iters > 0:\n   113→            progress = min(100, int((state.iteration / max_iters) * 100))\n   114→\n   115→        project = project_map.get(project_id)\n   116→        recent_actions = list(state.recent_actions)[-3:]\n   117→        summaries.append(\n   118→            {\n   119→                \"kind\": \"project_loop\",\n   120→                \"project_id\": project_id,\n   121→                \"project_name\": project.name if project else project_id,\n   122→                \"status\": state.status,\n   123→                \"feature_name\": state.feature_name,\n   124→                \"mode\": state.mode,\n   125→                \"provider\": state.provider,\n   126→                \"provider_display_name\": state.provider_display_name,\n   127→                \"model\": state.model,\n   128→                \"iteration\": state.iteration,\n   129→                \"max_iterations\": max_iters,\n   130→                \"progress_percent\": progress,\n   131→                \"start_time\": state.start_time,\n   132→                \"recent_actions\": recent_actions,\n   133→            }\n   134→        )\n   135→\n   136→    # Also include running Ralph jobs started via ralph_start\n   137→    for project in project_map.values():\n   138→        project_root = Path(project.path)\n   139→        for job in ralph_service.list_jobs(project_root):\n   140→            if job.get(\"status\") != \"running\":\n   141→                continue\n   142→\n   143→            # Refresh status to avoid stale \"running\" jobs with dead PID\n   144→            refreshed = ralph_service.get_job_status(project_root, job.get(\"job_id\", \"\"))\n   145→            if not refreshed or refreshed.get(\"status\") != \"running\":\n   146→                continue\n   147→\n   148→            progress_tail = refreshed.get(\"progress_tail\") or []\n   149→            recent_actions = [\n   150→                {\n   151→                    \"time\": refreshed.get(\"completed_at\")\n   152→                    or refreshed.get(\"started_at\")\n   153→                    or refreshed.get(\"created_at\"),\n   154→                    \"type\": \"progress\",\n   155→                    \"message\": line,\n   156→                }\n   157→                for line in progress_tail[-3:]\n   158→            ]\n   159→\n   160→            max_iters = refreshed.get(\"iterations\") or 0\n   161→            current_iter = refreshed.get(\"current_iteration\") or 0\n   162→            progress = None\n   163→            if max_iters > 0:\n   164→                progress = min(100, int((current_iter / max_iters) * 100))\n   165→\n   166→            summaries.append(\n   167→                {\n   168→                    \"kind\": \"ralph_job\",\n   169→                    \"job_id\": refreshed.get(\"job_id\"),\n   170→                    \"project_id\": project.id,\n   171→                    \"project_name\": project.name,\n   172→                    \"status\": refreshed.get(\"status\"),\n   173→                    \"feature_name\": refreshed.get(\"slug\") or refreshed.get(\"job_id\"),\n   174→                    \"mode\": refreshed.get(\"mode\"),\n   175→                    \"provider\": refreshed.get(\"provider\"),\n   176→                    \"provider_display_name\": refreshed.get(\"provider\"),\n   177→                    \"model\": refreshed.get(\"model\"),\n   178→                    \"iteration\": current_iter,\n   179→                    \"max_iterations\": max_iters,\n   180→                    \"progress_percent\": progress,\n   181→                    \"start_time\": refreshed.get(\"started_at\") or refreshed.get(\"created_at\"),\n   182→                    \"recent_actions\": recent_actions,\n   183→                }\n   184→            )\n   185→\n   186→    summaries.sort(key=lambda item: item.get(\"start_time\") or \"\", reverse=True)\n   187→    return {\"count\": len(summaries), \"loops\": summaries}\n   188→\n   189→\n   190→@app.get(\"/\")\n   191→async def dashboard(request: Request):\n   192→    \"\"\"Main dashboard showing all registered projects.\"\"\"\n   193→    all_projects = ProjectService.get_all()\n   194→    states = loop_service.get_all_states()\n   195→\n   196→    # Enrich projects with loop state\n   197→    project_data = []\n   198→    for p in all_projects:\n   199→        state = states.get(p.id)\n   200→        project_data.append(\n   201→            {\n   202→                **p.to_dict(),\n   203→                \"loop_status\": state.status if state else \"idle\",\n   204→                \"loop_iteration\": state.iteration if state else 0,\n   205→                \"loop_feature\": state.feature_name if state else None,\n   206→                \"loop_mode\": state.mode if state else None,\n   207→            }\n   208→        )\n   209→\n   210→    return templates.TemplateResponse(\n   211→        request,\n   212→        \"dashboard.html\",\n   213→        {\n   214→            \"projects\": project_data,\n   215→        },\n   216→    )\n   217→\n   218→\n   219→@app.get(\"/project/{project_id}\")\n   220→async def project_detail(request: Request, project_id: str):\n   221→    \"\"\"Single project detail page with loop controls.\"\"\"\n   222→    project = ProjectService.get_by_id(project_id)\n   223→    if not project:\n   224→        return templates.TemplateResponse(\n   225→            request,\n   226→            \"dashboard.html\",\n   227→            {\n   228→                \"projects\": [],\n   229→                \"error\": \"Project not found\",\n   230→            },\n   231→        )\n   232→\n   233→    features = ProjectService.scan_features_detailed(project.path)\n   234→    state = loop_service.get_state(project_id)\n   235→    providers = [p.to_summary_dict() for p in get_enabled_providers()]\n   236→\n   237→    return templates.TemplateResponse(\n   238→        request,\n   239→        \"project.html\",\n   240→        {\n   241→            \"project\": project.to_dict(),\n   242→            \"features\": features,\n   243→            \"loop_state\": state.to_dict() if state else {\"status\": \"idle\"},\n   244→            \"providers\": providers,\n   245→        },\n   246→    )\n   247→\n   248→\n   249→@app.get(\"/ralph/jobs\")\n   250→async def ralph_jobs_page(request: Request):\n   251→    \"\"\"Ralph jobs list page.\"\"\"\n   252→    all_jobs = []\n   253→    for project in ProjectService.get_all():\n   254→        project_root = Path(project.path)\n   255→        jobs = ralph_service.list_jobs(project_root)\n   256→        for job in jobs:\n   257→            job[\"project_name\"] = project.name\n   258→            job[\"project_id\"] = project.id\n   259→        all_jobs.extend(jobs)\n   260→    all_jobs.sort(key=lambda j: j.get(\"created_at\", \"\"), reverse=True)\n   261→    has_running = any(j.get(\"status\") == \"running\" for j in all_jobs)\n   262→\n   263→    return templates.TemplateResponse(\n   264→        request,\n   265→        \"ralph_jobs.html\",\n   266→        {\"jobs\": all_jobs, \"has_running\": has_running},\n   267→    )\n   268→\n   269→\n   270→@app.get(\"/ralph/jobs/{job_id}\")\n   271→async def ralph_job_detail_page(request: Request, job_id: str):\n   272→    \"\"\"Ralph job detail page.\"\"\"\n   273→    job = None\n   274→    job_dir = None\n   275→    for project in ProjectService.get_all():\n   276→        project_root = Path(project.path)\n   277→        result = ralph_service.get_job_status(project_root, job_id)\n   278→        if result:\n   279→            job = result\n   280→            job[\"project_name\"] = project.name\n   281→            job[\"project_id\"] = project.id\n   282→            # Find job dir for artifacts\n   283→            ralph_dir = project_root / \".vista\" / \"ralph\"\n   284→            if ralph_dir.exists():\n   285→                for slug_dir in ralph_dir.iterdir():\n   286→                    if slug_dir.is_dir():\n   287→                        jf = slug_dir / \"job.json\"\n   288→                        if jf.exists():\n   289→                            try:\n   290→                                data = json.loads(jf.read_text(encoding=\"utf-8\"))\n   291→                                if data.get(\"job_id\") == job_id:\n   292→                                    job_dir = slug_dir\n   293→                                    break\n   294→                            except (json.JSONDecodeError, OSError):\n   295→                                continue\n   296→            break\n   297→\n   298→    if not job:\n   299→        return templates.TemplateResponse(\n   300→            request,\n   301→            \"ralph_jobs.html\",\n   302→            {\"jobs\": [], \"has_running\": False, \"error\": \"Job not found\"},\n   303→        )\n   304→\n   305→    # Read progress lines — prefer progress.txt, fall back to output.log parsing\n   306→    progress_lines = []\n   307→    if job_dir:\n   308→        progress_file = job_dir / \"progress.txt\"\n   309→        if progress_file.exists():\n   310→            lines = progress_file.read_text(encoding=\"utf-8\").splitlines()\n   311→            progress_lines = lines[-50:]\n   312→        else:\n   313→            output_file = job_dir / \"output.log\"\n   314→            if output_file.exists():\n   315→                try:\n   316→                    raw = output_file.read_text(\n   317→                        encoding=\"utf-8\", errors=\"replace\"\n   318→                    ).splitlines()\n   319→                    progress_lines, _iter = parse_stream_json_activity(raw[-500:])\n   320→                    progress_lines = progress_lines[-50:]\n   321→                except OSError:\n   322→                    pass\n   323→\n   324→    # List artifacts\n   325→    artifacts = []\n   326→    if job_dir:\n   327→        exclude = {\"job.json\", \"output.log\"}\n   328→        for f in sorted(job_dir.iterdir()):\n   329→            if f.is_file() and f.name not in exclude:\n   330→                artifacts.append({\"name\": f.name, \"size\": f.stat().st_size})\n   331→\n   332→    return templates.TemplateResponse(\n   333→        request,\n   334→        \"ralph_job_detail.html\",\n   335→        {\n   336→            \"job\": job,\n   337→            \"progress_lines\": progress_lines,\n   338→            \"artifacts\": artifacts,\n   339→        },\n   340→    )\n   341→\n   342→\n   343→@app.get(\"/ralph/settings\")\n   344→async def ralph_settings_page(request: Request):\n   345→    \"\"\"Ralph settings page.\"\"\"\n   346→    return templates.TemplateResponse(request, \"ralph_settings.html\", {})\n   347→"}]},"parent_tool_use_id":null,"session_id":"c06c8987-38bb-4a43-9247-2ef00a647fd1","uuid":"a49d1c87-54db-4573-8ec8-9a6dd3c58d7c","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\Grove\\OneDrive\\Documents\\PYTHON\\claude_plugins\\vista\\vista\\server\\app.py","content":"\"\"\"FastAPI web server entry point - Vista Dashboard.\"\"\"\n\nimport json\nfrom contextlib import asynccontextmanager\nfrom pathlib import Path\n\nfrom fastapi import FastAPI, Request\nfrom fastapi.staticfiles import StaticFiles\nfrom fastapi.templating import Jinja2Templates\n\nfrom server import config\nfrom server.services.project_service import ProjectService\nfrom server.services.loop_service import loop_service\nfrom server.services.diagram_watcher import diagram_watcher\nfrom server.services.provider_service import get_enabled_providers\nfrom server.services.output_parser import parse_stream_json_activity\nfrom server.services.ralph_service import ralph_service\nfrom server.services.service_lifecycle import (\n    service_lifecycle,\n    companion_config,\n    opencode_config,\n)\nfrom server.services.provider_router import provider_router\n\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    \"\"\"Startup and shutdown lifecycle.\"\"\"\n    config.ensure_full_path()\n    config.DATA_DIR.mkdir(parents=True, exist_ok=True)\n    (config.DATA_DIR / \"sessions\").mkdir(exist_ok=True)\n\n    # Register and start backend services\n    service_lifecycle.register(companion_config())\n    service_lifecycle.register(opencode_config())\n    await service_lifecycle.start_all()\n\n    yield\n\n    # Shutdown\n    await provider_router.cleanup_all()\n    await service_lifecycle.stop_all()\n    await loop_service.stop_all()\n    await diagram_watcher.stop()\n\n\napp = FastAPI(title=\"Ralph Loop Dashboard\", version=\"1.4.1\", lifespan=lifespan)\n\n# Mount static files\nconfig.STATIC_DIR.mkdir(parents=True, exist_ok=True)\napp.mount(\"/static\", StaticFiles(directory=str(config.STATIC_DIR)), name=\"static\")\n\n# Templates\ntemplates = Jinja2Templates(directory=str(config.VIEWS_DIR))\n\n# Include routers\nfrom server.routes import (\n    projects,\n    loops,\n    stream,\n    plans,\n    providers,\n    shutdown,\n    architecture,\n    chat_sessions,\n    ralph,\n    ralph_settings,\n    sandbox,\n    service_status,\n)\n\napp.include_router(projects.router)\napp.include_router(loops.router)\napp.include_router(stream.router)\napp.include_router(plans.router)\napp.include_router(providers.router)\napp.include_router(shutdown.router)\napp.include_router(architecture.router)\napp.include_router(chat_sessions.router)\napp.include_router(ralph.router)\napp.include_router(ralph_settings.router)\napp.include_router(sandbox.router)\napp.include_router(service_status.router)\n\n\n@app.get(\"/api/health\")\nasync def health_check():\n    \"\"\"Health check endpoint for monitoring and hooks.\"\"\"\n    running_loops = {\n        pid: state.to_dict()\n        for pid, state in loop_service.get_all_states().items()\n        if state.status in (\"running\", \"starting\")\n    }\n    return {\n        \"status\": \"ok\",\n        \"version\": app.version,\n        \"running_loops\": len(running_loops),\n    }\n\n\n@app.get(\"/api/loops/running\")\nasync def running_loops_summary():\n    \"\"\"Return compact summary of active loops for global app-bar status UI.\"\"\"\n    project_map = {p.id: p for p in ProjectService.get_all()}\n    summaries = []\n    for project_id, state in loop_service.get_all_states().items():\n        if state.status not in (\"running\", \"starting\"):\n            continue\n\n        max_iters = state.max_iterations or 0\n        progress = None\n        if max_iters > 0:\n            progress = min(100, int((state.iteration / max_iters) * 100))\n\n        project = project_map.get(project_id)\n        recent_actions = list(state.recent_actions)[-3:]\n        summaries.append(\n            {\n                \"kind\": \"project_loop\",\n                \"project_id\": project_id,\n                \"project_name\": project.name if project else project_id,\n                \"status\": state.status,\n                \"feature_name\": state.feature_name,\n                \"mode\": state.mode,\n                \"provider\": state.provider,\n                \"provider_display_name\": state.provider_display_name,\n                \"model\": state.model,\n                \"iteration\": state.iteration,\n                \"max_iterations\": max_iters,\n                \"progress_percent\": progress,\n                \"start_time\": state.start_time,\n                \"recent_actions\": recent_actions,\n            }\n        )\n\n    # Also include running Ralph jobs started via ralph_start\n    for project in project_map.values():\n        project_root = Path(project.path)\n        for job in ralph_service.list_jobs(project_root):\n            if job.get(\"status\") != \"running\":\n                continue\n\n            # Refresh status to avoid stale \"running\" jobs with dead PID\n            refreshed = ralph_service.get_job_status(project_root, job.get(\"job_id\", \"\"))\n            if not refreshed or refreshed.get(\"status\") != \"running\":\n                continue\n\n            progress_tail = refreshed.get(\"progress_tail\") or []\n            recent_actions = [\n                {\n                    \"time\": refreshed.get(\"completed_at\")\n                    or refreshed.get(\"started_at\")\n                    or refreshed.get(\"created_at\"),\n                    \"type\": \"progress\",\n                    \"message\": line,\n                }\n                for line in progress_tail[-3:]\n            ]\n\n            max_iters = refreshed.get(\"iterations\") or 0\n            current_iter = refreshed.get(\"current_iteration\") or 0\n            progress = None\n            if max_iters > 0:\n                progress = min(100, int((current_iter / max_iters) * 100))\n\n            summaries.append(\n                {\n                    \"kind\": \"ralph_job\",\n                    \"job_id\": refreshed.get(\"job_id\"),\n                    \"project_id\": project.id,\n                    \"project_name\": project.name,\n                    \"status\": refreshed.get(\"status\"),\n                    \"feature_name\": refreshed.get(\"slug\") or refreshed.get(\"job_id\"),\n                    \"mode\": refreshed.get(\"mode\"),\n                    \"provider\": refreshed.get(\"provider\"),\n                    \"provider_display_name\": refreshed.get(\"provider\"),\n                    \"model\": refreshed.get(\"model\"),\n                    \"iteration\": current_iter,\n                    \"max_iterations\": max_iters,\n                    \"progress_percent\": progress,\n                    \"start_time\": refreshed.get(\"started_at\") or refreshed.get(\"created_at\"),\n                    \"recent_actions\": recent_actions,\n                }\n            )\n\n    summaries.sort(key=lambda item: item.get(\"start_time\") or \"\", reverse=True)\n    return {\"count\": len(summaries), \"loops\": summaries}\n\n\n@app.get(\"/\")\nasync def dashboard(request: Request):\n    \"\"\"Main dashboard showing all registered projects.\"\"\"\n    all_projects = ProjectService.get_all()\n    states = loop_service.get_all_states()\n\n    # Enrich projects with loop state\n    project_data = []\n    for p in all_projects:\n        state = states.get(p.id)\n        project_data.append(\n            {\n                **p.to_dict(),\n                \"loop_status\": state.status if state else \"idle\",\n                \"loop_iteration\": state.iteration if state else 0,\n                \"loop_feature\": state.feature_name if state else None,\n                \"loop_mode\": state.mode if state else None,\n            }\n        )\n\n    return templates.TemplateResponse(\n        request,\n        \"dashboard.html\",\n        {\n            \"projects\": project_data,\n        },\n    )\n\n\n@app.get(\"/project/{project_id}\")\nasync def project_detail(request: Request, project_id: str):\n    \"\"\"Single project detail page with loop controls.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        return templates.TemplateResponse(\n            request,\n            \"dashboard.html\",\n            {\n                \"projects\": [],\n                \"error\": \"Project not found\",\n            },\n        )\n\n    features = ProjectService.scan_features_detailed(project.path)\n    state = loop_service.get_state(project_id)\n    providers = [p.to_summary_dict() for p in get_enabled_providers()]\n\n    return templates.TemplateResponse(\n        request,\n        \"project.html\",\n        {\n            \"project\": project.to_dict(),\n            \"features\": features,\n            \"loop_state\": state.to_dict() if state else {\"status\": \"idle\"},\n            \"providers\": providers,\n        },\n    )\n\n\n@app.get(\"/ralph/jobs\")\nasync def ralph_jobs_page(request: Request):\n    \"\"\"Ralph jobs list page.\"\"\"\n    all_jobs = []\n    for project in ProjectService.get_all():\n        project_root = Path(project.path)\n        jobs = ralph_service.list_jobs(project_root)\n        for job in jobs:\n            job[\"project_name\"] = project.name\n            job[\"project_id\"] = project.id\n        all_jobs.extend(jobs)\n    all_jobs.sort(key=lambda j: j.get(\"created_at\", \"\"), reverse=True)\n    has_running = any(j.get(\"status\") == \"running\" for j in all_jobs)\n\n    return templates.TemplateResponse(\n        request,\n        \"ralph_jobs.html\",\n        {\"jobs\": all_jobs, \"has_running\": has_running},\n    )\n\n\n@app.get(\"/ralph/jobs/{job_id}\")\nasync def ralph_job_detail_page(request: Request, job_id: str):\n    \"\"\"Ralph job detail page.\"\"\"\n    job = None\n    job_dir = None\n    for project in ProjectService.get_all():\n        project_root = Path(project.path)\n        result = ralph_service.get_job_status(project_root, job_id)\n        if result:\n            job = result\n            job[\"project_name\"] = project.name\n            job[\"project_id\"] = project.id\n            # Find job dir for artifacts\n            ralph_dir = project_root / \".vista\" / \"ralph\"\n            if ralph_dir.exists():\n                for slug_dir in ralph_dir.iterdir():\n                    if slug_dir.is_dir():\n                        jf = slug_dir / \"job.json\"\n                        if jf.exists():\n                            try:\n                                data = json.loads(jf.read_text(encoding=\"utf-8\"))\n                                if data.get(\"job_id\") == job_id:\n                                    job_dir = slug_dir\n                                    break\n                            except (json.JSONDecodeError, OSError):\n                                continue\n            break\n\n    if not job:\n        return templates.TemplateResponse(\n            request,\n            \"ralph_jobs.html\",\n            {\"jobs\": [], \"has_running\": False, \"error\": \"Job not found\"},\n        )\n\n    # Read progress lines — prefer progress.txt, fall back to output.log parsing\n    progress_lines = []\n    if job_dir:\n        progress_file = job_dir / \"progress.txt\"\n        if progress_file.exists():\n            lines = progress_file.read_text(encoding=\"utf-8\").splitlines()\n            progress_lines = lines[-50:]\n        else:\n            output_file = job_dir / \"output.log\"\n            if output_file.exists():\n                try:\n                    raw = output_file.read_text(\n                        encoding=\"utf-8\", errors=\"replace\"\n                    ).splitlines()\n                    progress_lines, _iter = parse_stream_json_activity(raw[-500:])\n                    progress_lines = progress_lines[-50:]\n                except OSError:\n                    pass\n\n    # List artifacts\n    artifacts = []\n    if job_dir:\n        exclude = {\"job.json\", \"output.log\"}\n        for f in sorted(job_dir.iterdir()):\n            if f.is_file() and f.name not in exclude:\n                artifacts.append({\"name\": f.name, \"size\": f.stat().st_size})\n\n    return templates.TemplateResponse(\n        request,\n        \"ralph_job_detail.html\",\n        {\n            \"job\": job,\n            \"progress_lines\": progress_lines,\n            \"artifacts\": artifacts,\n        },\n    )\n\n\n@app.get(\"/ralph/settings\")\nasync def ralph_settings_page(request: Request):\n    \"\"\"Ralph settings page.\"\"\"\n    return templates.TemplateResponse(request, \"ralph_settings.html\", {})\n","numLines":347,"startLine":1,"totalLines":347}}}
