{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016opKLARc7ghsCZEEsvMHM9","type":"tool_result","content":"     1→\"\"\"Chat API routes for AI diagram review.\n     2→\n     3→Provides endpoint for sending chat messages to AI providers with diagram context.\n     4→\"\"\"\n     5→\n     6→import asyncio\n     7→\n     8→from fastapi import APIRouter, HTTPException\n     9→from pydantic import BaseModel, Field\n    10→from typing import Optional\n    11→\n    12→from server.services.project_service import ProjectService\n    13→from server.services.chat_service import chat_service\n    14→\n    15→router = APIRouter(tags=[\"chat\"])\n    16→\n    17→\n    18→class ChatMessage(BaseModel):\n    19→    \"\"\"A single message in the chat history.\"\"\"\n    20→\n    21→    role: str = Field(..., description=\"Message role: user, assistant, or system\")\n    22→    content: str = Field(..., description=\"Message content\")\n    23→\n    24→\n    25→class ChatRequest(BaseModel):\n    26→    \"\"\"Request body for chat endpoint.\"\"\"\n    27→\n    28→    message: str = Field(..., description=\"User's message to send\")\n    29→    context: Optional[str] = Field(\n    30→        None, description=\"Optional pre-assembled diagram context\"\n    31→    )\n    32→    provider: str = Field(..., description=\"Provider name (e.g., 'claude', 'opencode')\")\n    33→    model: str = Field(..., description=\"Model identifier (e.g., 'sonnet', 'opus')\")\n    34→    history: list[ChatMessage] = Field(\n    35→        default_factory=list, description=\"Previous messages in the conversation\"\n    36→    )\n    37→\n    38→\n    39→class ChatResponse(BaseModel):\n    40→    \"\"\"Response body from chat endpoint.\"\"\"\n    41→\n    42→    response: str = Field(..., description=\"AI assistant's response\")\n    43→\n    44→\n    45→@router.post(\"/api/projects/{project_id}/chat\")\n    46→async def post_chat(project_id: str, request: ChatRequest) -> ChatResponse:\n    47→    \"\"\"Send a chat message to an AI provider with optional diagram context.\"\"\"\n    48→    project = ProjectService.get_by_id(project_id)\n    49→    if not project:\n    50→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    51→\n    52→    if not request.message or not request.message.strip():\n    53→        raise HTTPException(status_code=400, detail=\"Message is required\")\n    54→\n    55→    if not request.provider or not request.provider.strip():\n    56→        raise HTTPException(status_code=400, detail=\"Provider is required\")\n    57→\n    58→    if not request.model or not request.model.strip():\n    59→        raise HTTPException(status_code=400, detail=\"Model is required\")\n    60→\n    61→    history_dicts = (\n    62→        [{\"role\": msg.role, \"content\": msg.content} for msg in request.history]\n    63→        if request.history\n    64→        else None\n    65→    )\n    66→\n    67→    prompt = chat_service.build_prompt(\n    68→        message=request.message,\n    69→        context=request.context,\n    70→        history=history_dicts,\n    71→    )\n    72→\n    73→    # Run blocking subprocess in a thread so the event loop stays responsive\n    74→    try:\n    75→        success, response = await asyncio.wait_for(\n    76→            asyncio.to_thread(\n    77→                chat_service.invoke_provider,\n    78→                provider_name=request.provider,\n    79→                model=request.model,\n    80→                prompt=prompt,\n    81→            ),\n    82→            timeout=100.0,\n    83→        )\n    84→    except asyncio.TimeoutError:\n    85→        chat_service.cancel()\n    86→        raise HTTPException(status_code=504, detail=\"Chat request timed out\")\n    87→    except asyncio.CancelledError:\n    88→        chat_service.cancel()\n    89→        raise HTTPException(status_code=499, detail=\"Request cancelled\")\n    90→\n    91→    if not success:\n    92→        raise HTTPException(status_code=500, detail=response)\n    93→\n    94→    return ChatResponse(response=response)\n    95→\n    96→\n    97→@router.post(\"/api/chat/cancel\")\n    98→async def cancel_chat():\n    99→    \"\"\"Cancel the currently running chat request.\"\"\"\n   100→    cancelled = chat_service.cancel()\n   101→    return {\"cancelled\": cancelled}\n   102→"}]},"parent_tool_use_id":null,"session_id":"41eb5763-1813-40b4-994f-a8833bfca10e","uuid":"87bdb68f-d904-440c-98ac-5dddd3459a74","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/routes/chat.py","content":"\"\"\"Chat API routes for AI diagram review.\n\nProvides endpoint for sending chat messages to AI providers with diagram context.\n\"\"\"\n\nimport asyncio\n\nfrom fastapi import APIRouter, HTTPException\nfrom pydantic import BaseModel, Field\nfrom typing import Optional\n\nfrom server.services.project_service import ProjectService\nfrom server.services.chat_service import chat_service\n\nrouter = APIRouter(tags=[\"chat\"])\n\n\nclass ChatMessage(BaseModel):\n    \"\"\"A single message in the chat history.\"\"\"\n\n    role: str = Field(..., description=\"Message role: user, assistant, or system\")\n    content: str = Field(..., description=\"Message content\")\n\n\nclass ChatRequest(BaseModel):\n    \"\"\"Request body for chat endpoint.\"\"\"\n\n    message: str = Field(..., description=\"User's message to send\")\n    context: Optional[str] = Field(\n        None, description=\"Optional pre-assembled diagram context\"\n    )\n    provider: str = Field(..., description=\"Provider name (e.g., 'claude', 'opencode')\")\n    model: str = Field(..., description=\"Model identifier (e.g., 'sonnet', 'opus')\")\n    history: list[ChatMessage] = Field(\n        default_factory=list, description=\"Previous messages in the conversation\"\n    )\n\n\nclass ChatResponse(BaseModel):\n    \"\"\"Response body from chat endpoint.\"\"\"\n\n    response: str = Field(..., description=\"AI assistant's response\")\n\n\n@router.post(\"/api/projects/{project_id}/chat\")\nasync def post_chat(project_id: str, request: ChatRequest) -> ChatResponse:\n    \"\"\"Send a chat message to an AI provider with optional diagram context.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    if not request.message or not request.message.strip():\n        raise HTTPException(status_code=400, detail=\"Message is required\")\n\n    if not request.provider or not request.provider.strip():\n        raise HTTPException(status_code=400, detail=\"Provider is required\")\n\n    if not request.model or not request.model.strip():\n        raise HTTPException(status_code=400, detail=\"Model is required\")\n\n    history_dicts = (\n        [{\"role\": msg.role, \"content\": msg.content} for msg in request.history]\n        if request.history\n        else None\n    )\n\n    prompt = chat_service.build_prompt(\n        message=request.message,\n        context=request.context,\n        history=history_dicts,\n    )\n\n    # Run blocking subprocess in a thread so the event loop stays responsive\n    try:\n        success, response = await asyncio.wait_for(\n            asyncio.to_thread(\n                chat_service.invoke_provider,\n                provider_name=request.provider,\n                model=request.model,\n                prompt=prompt,\n            ),\n            timeout=100.0,\n        )\n    except asyncio.TimeoutError:\n        chat_service.cancel()\n        raise HTTPException(status_code=504, detail=\"Chat request timed out\")\n    except asyncio.CancelledError:\n        chat_service.cancel()\n        raise HTTPException(status_code=499, detail=\"Request cancelled\")\n\n    if not success:\n        raise HTTPException(status_code=500, detail=response)\n\n    return ChatResponse(response=response)\n\n\n@router.post(\"/api/chat/cancel\")\nasync def cancel_chat():\n    \"\"\"Cancel the currently running chat request.\"\"\"\n    cancelled = chat_service.cancel()\n    return {\"cancelled\": cancelled}\n","numLines":102,"startLine":1,"totalLines":102}}}
