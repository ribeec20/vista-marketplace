{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uv5bzYG7Cqh66s6vJZazFQ","type":"tool_result","content":"     1→\"\"\"WebSocket client for Companion's browser-side WebSocket bridge.\n     2→\n     3→Connects to Companion's /ws/browser/{session_id} endpoint to relay\n     4→messages between Vista and the Claude CLI agent spawned by Companion.\n     5→\n     6→Protocol verified from companion/web/server/session-types.ts:\n     7→- Browser sends: {type: \"user_message\", content: \"...\"}\n     8→- Browser receives: stream_event, assistant, result, permission_request, error, cli_disconnected\n     9→- Permission response: {type: \"permission_response\", request_id, behavior: \"allow\", updated_input}\n    10→\"\"\"\n    11→\n    12→import json\n    13→import logging\n    14→from collections.abc import AsyncGenerator\n    15→from typing import Optional\n    16→\n    17→import httpx\n    18→import websockets\n    19→\n    20→log = logging.getLogger(__name__)\n    21→\n    22→\n    23→class ClaudeWSClient:\n    24→    \"\"\"WebSocket client connecting to Companion's /ws/browser/{session_id} endpoint.\"\"\"\n    25→\n    26→    def __init__(self, companion_base_url: str):\n    27→        self.base_url = companion_base_url  # \"http://127.0.0.1:3457\"\n    28→        self._ws: Optional[websockets.WebSocketClientProtocol] = None\n    29→        self._session_id: Optional[str] = None\n    30→\n    31→    async def create_session(self, model: str, cwd: str) -> str:\n    32→        \"\"\"POST /api/sessions/create -> returns Companion session ID.\"\"\"\n    33→        async with httpx.AsyncClient() as client:\n    34→            resp = await client.post(\n    35→                f\"{self.base_url}/api/sessions/create\",\n    36→                json={\n    37→                    \"model\": model,\n    38→                    \"permissionMode\": \"dangerously-skip-permissions\",\n    39→                    \"cwd\": cwd,\n    40→                    \"backend\": \"claude\",\n    41→                },\n    42→                timeout=30.0,\n    43→            )\n    44→            resp.raise_for_status()\n    45→            data = resp.json()\n    46→            session_id = data.get(\"sessionId\") or data.get(\"session_id\", \"\")\n    47→            log.info(\"Created Companion session: %s\", session_id)\n    48→            return session_id\n    49→\n    50→    async def connect(self, session_id: str) -> None:\n    51→        \"\"\"Connect to ws://{host}:{port}/ws/browser/{session_id}.\"\"\"\n    52→        ws_url = self.base_url.replace(\"http://\", \"ws://\").replace(\"https://\", \"wss://\")\n    53→        self._ws = await websockets.connect(\n    54→            f\"{ws_url}/ws/browser/{session_id}\",\n    55→            max_size=10 * 1024 * 1024,  # 10MB for large responses\n    56→        )\n    57→        self._session_id = session_id\n    58→\n    59→        # Wait for initial message (session_init or message_history)\n    60→        try:\n    61→            init_raw = await self._ws.recv()\n    62→            init_msg = json.loads(init_raw)\n    63→            log.debug(\"Initial WS message type: %s\", init_msg.get(\"type\"))\n    64→        except Exception as e:\n    65→            log.warning(\"Error receiving initial WS message: %s\", e)\n    66→\n    67→    async def send_message(self, text: str) -> AsyncGenerator[dict, None]:\n    68→        \"\"\"Send user message and yield streaming events.\n    69→\n    70→        Send: {type: \"user_message\", content: text}\n    71→        Receive and translate:\n    72→        - stream_event with content_block_delta -> {type: \"token\", text: ...}\n    73→        - result -> {type: \"result\", ...} + {type: \"done\", content: ...}\n    74→        - permission_request -> auto-approve immediately\n    75→        - error -> {type: \"error\", detail: ...}\n    76→        - cli_disconnected -> {type: \"error\", detail: ...}\n    77→        \"\"\"\n    78→        if not self._ws:\n    79→            yield {\"type\": \"error\", \"detail\": \"WebSocket not connected\"}\n    80→            return\n    81→\n    82→        await self._ws.send(json.dumps({\n    83→            \"type\": \"user_message\",\n    84→            \"content\": text,\n    85→        }))\n    86→\n    87→        full_text: list[str] = []\n    88→        async for raw in self._ws:\n    89→            msg = json.loads(raw)\n    90→            msg_type = msg.get(\"type\")\n    91→\n    92→            if msg_type == \"stream_event\":\n    93→                event = msg.get(\"event\", {})\n    94→                if event.get(\"type\") == \"content_block_delta\":\n    95→                    delta = event.get(\"delta\", {})\n    96→                    if delta.get(\"type\") == \"text_delta\":\n    97→                        text_chunk = delta.get(\"text\", \"\")\n    98→                        if text_chunk:\n    99→                            full_text.append(text_chunk)\n   100→                            yield {\"type\": \"token\", \"text\": text_chunk}\n   101→\n   102→            elif msg_type == \"assistant\":\n   103→                # Complete assistant message - text already streamed above\n   104→                pass\n   105→\n   106→            elif msg_type == \"result\":\n   107→                yield {\n   108→                    \"type\": \"result\",\n   109→                    \"content\": \"\".join(full_text),\n   110→                    \"cost\": msg.get(\"data\", {}).get(\"total_cost_usd\"),\n   111→                    \"duration_ms\": msg.get(\"data\", {}).get(\"duration_ms\"),\n   112→                }\n   113→                yield {\"type\": \"done\", \"content\": \"\".join(full_text)}\n   114→                return\n   115→\n   116→            elif msg_type == \"permission_request\":\n   117→                # Auto-approve all tool calls\n   118→                request = msg.get(\"request\", {})\n   119→                await self._ws.send(json.dumps({\n   120→                    \"type\": \"permission_response\",\n   121→                    \"request_id\": request.get(\"request_id\", \"\"),\n   122→                    \"behavior\": \"allow\",\n   123→                    \"updated_input\": request.get(\"input\", {}),\n   124→                }))\n   125→\n   126→            elif msg_type == \"error\":\n   127→                yield {\"type\": \"error\", \"detail\": msg.get(\"message\", \"Unknown error\")}\n   128→                return\n   129→\n   130→            elif msg_type == \"cli_disconnected\":\n   131→                yield {\"type\": \"error\", \"detail\": \"Claude CLI disconnected\"}\n   132→                return\n   133→\n   134→    async def disconnect(self) -> None:\n   135→        \"\"\"Close the WebSocket connection.\"\"\"\n   136→        if self._ws:\n   137→            try:\n   138→                await self._ws.close()\n   139→            except Exception:\n   140→                pass\n   141→            self._ws = None\n   142→\n   143→    async def delete_session(self, session_id: str) -> None:\n   144→        \"\"\"DELETE /api/sessions/{session_id}.\"\"\"\n   145→        try:\n   146→            async with httpx.AsyncClient() as client:\n   147→                await client.delete(\n   148→                    f\"{self.base_url}/api/sessions/{session_id}\",\n   149→                    timeout=10.0,\n   150→                )\n   151→        except Exception as e:\n   152→            log.warning(\"Failed to delete Companion session %s: %s\", session_id, e)\n   153→"}]},"parent_tool_use_id":null,"session_id":"41eb5763-1813-40b4-994f-a8833bfca10e","uuid":"0d6fdb89-461b-4e35-bf8a-d9779b9a25df","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/services/claude_ws_client.py","content":"\"\"\"WebSocket client for Companion's browser-side WebSocket bridge.\n\nConnects to Companion's /ws/browser/{session_id} endpoint to relay\nmessages between Vista and the Claude CLI agent spawned by Companion.\n\nProtocol verified from companion/web/server/session-types.ts:\n- Browser sends: {type: \"user_message\", content: \"...\"}\n- Browser receives: stream_event, assistant, result, permission_request, error, cli_disconnected\n- Permission response: {type: \"permission_response\", request_id, behavior: \"allow\", updated_input}\n\"\"\"\n\nimport json\nimport logging\nfrom collections.abc import AsyncGenerator\nfrom typing import Optional\n\nimport httpx\nimport websockets\n\nlog = logging.getLogger(__name__)\n\n\nclass ClaudeWSClient:\n    \"\"\"WebSocket client connecting to Companion's /ws/browser/{session_id} endpoint.\"\"\"\n\n    def __init__(self, companion_base_url: str):\n        self.base_url = companion_base_url  # \"http://127.0.0.1:3457\"\n        self._ws: Optional[websockets.WebSocketClientProtocol] = None\n        self._session_id: Optional[str] = None\n\n    async def create_session(self, model: str, cwd: str) -> str:\n        \"\"\"POST /api/sessions/create -> returns Companion session ID.\"\"\"\n        async with httpx.AsyncClient() as client:\n            resp = await client.post(\n                f\"{self.base_url}/api/sessions/create\",\n                json={\n                    \"model\": model,\n                    \"permissionMode\": \"dangerously-skip-permissions\",\n                    \"cwd\": cwd,\n                    \"backend\": \"claude\",\n                },\n                timeout=30.0,\n            )\n            resp.raise_for_status()\n            data = resp.json()\n            session_id = data.get(\"sessionId\") or data.get(\"session_id\", \"\")\n            log.info(\"Created Companion session: %s\", session_id)\n            return session_id\n\n    async def connect(self, session_id: str) -> None:\n        \"\"\"Connect to ws://{host}:{port}/ws/browser/{session_id}.\"\"\"\n        ws_url = self.base_url.replace(\"http://\", \"ws://\").replace(\"https://\", \"wss://\")\n        self._ws = await websockets.connect(\n            f\"{ws_url}/ws/browser/{session_id}\",\n            max_size=10 * 1024 * 1024,  # 10MB for large responses\n        )\n        self._session_id = session_id\n\n        # Wait for initial message (session_init or message_history)\n        try:\n            init_raw = await self._ws.recv()\n            init_msg = json.loads(init_raw)\n            log.debug(\"Initial WS message type: %s\", init_msg.get(\"type\"))\n        except Exception as e:\n            log.warning(\"Error receiving initial WS message: %s\", e)\n\n    async def send_message(self, text: str) -> AsyncGenerator[dict, None]:\n        \"\"\"Send user message and yield streaming events.\n\n        Send: {type: \"user_message\", content: text}\n        Receive and translate:\n        - stream_event with content_block_delta -> {type: \"token\", text: ...}\n        - result -> {type: \"result\", ...} + {type: \"done\", content: ...}\n        - permission_request -> auto-approve immediately\n        - error -> {type: \"error\", detail: ...}\n        - cli_disconnected -> {type: \"error\", detail: ...}\n        \"\"\"\n        if not self._ws:\n            yield {\"type\": \"error\", \"detail\": \"WebSocket not connected\"}\n            return\n\n        await self._ws.send(json.dumps({\n            \"type\": \"user_message\",\n            \"content\": text,\n        }))\n\n        full_text: list[str] = []\n        async for raw in self._ws:\n            msg = json.loads(raw)\n            msg_type = msg.get(\"type\")\n\n            if msg_type == \"stream_event\":\n                event = msg.get(\"event\", {})\n                if event.get(\"type\") == \"content_block_delta\":\n                    delta = event.get(\"delta\", {})\n                    if delta.get(\"type\") == \"text_delta\":\n                        text_chunk = delta.get(\"text\", \"\")\n                        if text_chunk:\n                            full_text.append(text_chunk)\n                            yield {\"type\": \"token\", \"text\": text_chunk}\n\n            elif msg_type == \"assistant\":\n                # Complete assistant message - text already streamed above\n                pass\n\n            elif msg_type == \"result\":\n                yield {\n                    \"type\": \"result\",\n                    \"content\": \"\".join(full_text),\n                    \"cost\": msg.get(\"data\", {}).get(\"total_cost_usd\"),\n                    \"duration_ms\": msg.get(\"data\", {}).get(\"duration_ms\"),\n                }\n                yield {\"type\": \"done\", \"content\": \"\".join(full_text)}\n                return\n\n            elif msg_type == \"permission_request\":\n                # Auto-approve all tool calls\n                request = msg.get(\"request\", {})\n                await self._ws.send(json.dumps({\n                    \"type\": \"permission_response\",\n                    \"request_id\": request.get(\"request_id\", \"\"),\n                    \"behavior\": \"allow\",\n                    \"updated_input\": request.get(\"input\", {}),\n                }))\n\n            elif msg_type == \"error\":\n                yield {\"type\": \"error\", \"detail\": msg.get(\"message\", \"Unknown error\")}\n                return\n\n            elif msg_type == \"cli_disconnected\":\n                yield {\"type\": \"error\", \"detail\": \"Claude CLI disconnected\"}\n                return\n\n    async def disconnect(self) -> None:\n        \"\"\"Close the WebSocket connection.\"\"\"\n        if self._ws:\n            try:\n                await self._ws.close()\n            except Exception:\n                pass\n            self._ws = None\n\n    async def delete_session(self, session_id: str) -> None:\n        \"\"\"DELETE /api/sessions/{session_id}.\"\"\"\n        try:\n            async with httpx.AsyncClient() as client:\n                await client.delete(\n                    f\"{self.base_url}/api/sessions/{session_id}\",\n                    timeout=10.0,\n                )\n        except Exception as e:\n            log.warning(\"Failed to delete Companion session %s: %s\", session_id, e)\n","numLines":153,"startLine":1,"totalLines":153}}}
