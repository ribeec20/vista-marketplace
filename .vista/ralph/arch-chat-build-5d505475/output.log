ins\\vista\\vista\\tests\\test_container_manager.py\nC:\\Users\\Grove\\OneDrive\\Documents\\PYTHON\\claude_plugins\\vista\\vista\\tests\\test_credential_mounter.py\nC:\\Users\\Grove\\OneDrive\\Documents\\PYTHON\\claude_plugins\\vista\\vista\\tests\\test_bash_loop_generator.py\nC:\\Users\\Grove\\OneDrive\\Documents\\PYTHON\\claude_plugins\\vista\\vista\\tests\\integration\\test_docker_sandbox.py\nC:\\Users\\Grove\\OneDrive\\Documents\\PYTHON\\claude_plugins\\vista\\vista\\tests\\test_sandbox_integration.py"}]},"parent_tool_use_id":"toolu_01UWjZvNU1MyBFPkJ6FSAJK4","session_id":"fe920b97-a686-4daa-9f39-67e009025eb9","uuid":"d1567a98-6ead-49f7-805d-7551c1ddc14e"}
