ncio.Queue = asyncio.Queue(maxsize=200)\n    45→        self._subscribers[key].append(queue)\n    46→\n    47→        # Ensure polling task is running\n    48→        if self._poll_task is None or self._poll_task.done():\n    49→            self._poll_task = asyncio.create_task(self._poll_loop())\n    50→\n    51→        return queue\n    52→\n    53→    def unsubscribe(\n    54→        self, project_id: str, feature_name: str, queue: asyncio.Queue\n    55→    ) -> None:\n    56→        key = self._key(project_id, feature_name)\n    57→        if key in self._subscribers:\n    58→            self._subscribers[key] = [\n    59→                q for q in self._subscribers[key] if q is not queue\n    60→            ]\n    61→            # Clean up if no more subscribers for this key\n    62→            if not self._subscribers[key]:\n    63→                del self._subscribers[key]\n    64→                self._file_states.pop(key, None)\n    65→                self._watch_dirs.pop(key, None)\n    66→\n    67→    def _scan_files(self, arch_dir: Path) -> dict[str, float]:\n    68→        \"\"\"Scan directory and return {filename: mtime} for watched file types.\"\"\"\n    69→        states: dict[str, float] = {}\n    70→        if not arch_dir.is_dir():\n    71→            return states\n    72→        for f in arch_dir.iterdir():\n    73→            if f.is_file() and f.suffix in self.WATCH_EXTENSIONS:\n    74→                try:\n    75→                    states[f.name] = f.stat().st_mtime\n    76→                except OSError:\n    77→                    pass\n    78→        return states\n    79→\n    80→    async def _poll_loop(self) -> None:\n    81→        \"\"\"Background loop that polls all watched directories.\"\"\"\n    82→        try:\n    83→            while self._subscribers:\n    84→                for key in list(self._subscribers.keys()):\n    85→                    if key not in self._watch_dirs:\n    86→                        continue\n    87→                    arch_dir = self._watch_dirs[key]\n    88→                    old_states = self._file_states.get(key, {})\n    89→                    new_states = self._scan_files(arch_dir)\n    90→\n    91→                    events = []\n    92→\n    93→                    # Check for changed and new files\n    94→                    for filename, mtime in new_states.items():\n    95→                        if filename not in old_states:\n    96→                            content = self._read_file(arch_dir / filename)\n    97→                            events.append({\n    98→                                \"event\": \"diagram_added\",\n    99→                                \"data\": {\"file\": filename, \"content\": content},\n   100→                            })\n   101→                        elif mtime != old_states[filename]:\n   102→                            content = self._read_file(arch_dir / filename)\n   103→                            events.append({\n   104→                                \"event\": \"diagram_changed\",\n   105→                                \"data\": {\"file\": filename, \"content\": content},\n   106→                            })\n   107→\n   108→                    # Check for removed files\n   109→                    for filename in old_states:\n   110→                        if filename not in new_states:\n   111→                            events.append({\n   112→                                \"event\": \"diagram_removed\",\n   113→                                \"data\": {\"file\": filename},\n   114→                            })\n   115→\n   116→                    self._file_states[key] = new_states\n   117→\n   118→                    # Broadcast events to subscribers\n   119→                    for event in events:\n   120→                        await self._broadcast(key, event)\n   121→\n   122→                await asyncio.sleep(self.POLL_INTERVAL)\n   123→        except asyncio.CancelledError:\n   124→            pass\n   125→\n   126→    async def _broadcast(self, key: str, message: dict) -> None:\n   127→        if key not in self._subscribers:\n   128→            return\n   129→        dead_queues = []\n   130→        for queue in self._subscribers[key]:\n   131→            try:\n   132→                queue.put_nowait(message)\n   133→            except asyncio.QueueFull:\n   134→                dead_queues.append(queue)\n   135→        for q in dead_queues:\n   136→            if key in self._subscribers:\n   137→                self._subscribers[key].remove(q)\n   138→\n   139→    @staticmethod\n   140→    def _read_file(path: Path) -> str:\n   141→        try:\n   142→            return path.read_text(encoding=\"utf-8\")\n   143→        except Exception:\n   144→            return \"\"\n   145→\n   146→    async def stop(self) -> None:\n   147→        \"\"\"Cancel the polling task and clear all state.\"\"\"\n   148→        if self._poll_task and not self._poll_task.done():\n   149→            self._poll_task.cancel()\n   150→            try:\n   151→                await self._poll_task\n   152→            except asyncio.CancelledError:\n   153→                pass\n   154→        self._subscribers.clear()\n   155→        self._file_states.clear()\n   156→        self._watch_dirs.clear()\n   157→\n   158→\n   159→# Singleton instance\n   160→diagram_watcher = DiagramWatcher()\n   161→"}]},"parent_tool_use_id":null,"session_id":"41eb5763-1813-40b4-994f-a8833bfca10e","uuid":"a9d8e21a-26d0-40ca-bd23-70edb5c571ed","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/services/diagram_watcher.py","content":"\"\"\"Diagram file watcher using polling.\n\nTracks mtime of files in a feature's arch/ directory and broadcasts\nchange events via async queues (same pub-sub pattern as loop_service).\n\"\"\"\n\nimport asyncio\nfrom pathlib import Path\nfrom typing import Optional\n\n\nclass DiagramWatcher:\n    \"\"\"Polls an arch/ directory for file changes and notifies subscribers.\"\"\"\n\n    POLL_INTERVAL = 2.0  # seconds\n    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\n\n    def __init__(self):\n        # Key: \"{project_id}:{feature_name}\" → list of subscriber queues\n        self._subscribers: dict[str, list[asyncio.Queue]] = {}\n        # Key: same → dict[filename, mtime]\n        self._file_states: dict[str, dict[str, float]] = {}\n        # Key: same → arch dir Path\n        self._watch_dirs: dict[str, Path] = {}\n        # Background polling task\n        self._poll_task: Optional[asyncio.Task] = None\n\n    @staticmethod\n    def _key(project_id: str, feature_name: str) -> str:\n        return f\"{project_id}:{feature_name}\"\n\n    def subscribe(\n        self, project_id: str, feature_name: str, arch_dir: Path\n    ) -> asyncio.Queue:\n        \"\"\"Register a subscriber for diagram changes. Starts polling if not running.\"\"\"\n        key = self._key(project_id, feature_name)\n\n        if key not in self._subscribers:\n            self._subscribers[key] = []\n            self._watch_dirs[key] = arch_dir\n            # Snapshot current file states\n            self._file_states[key] = self._scan_files(arch_dir)\n\n        queue: asyncio.Queue = asyncio.Queue(maxsize=200)\n        self._subscribers[key].append(queue)\n\n        # Ensure polling task is running\n        if self._poll_task is None or self._poll_task.done():\n            self._poll_task = asyncio.create_task(self._poll_loop())\n\n        return queue\n\n    def unsubscribe(\n        self, project_id: str, feature_name: str, queue: asyncio.Queue\n    ) -> None:\n        key = self._key(project_id, feature_name)\n        if key in self._subscribers:\n            self._subscribers[key] = [\n                q for q in self._subscribers[key] if q is not queue\n            ]\n            # Clean up if no more subscribers for this key\n            if not self._subscribers[key]:\n                del self._subscribers[key]\n                self._file_states.pop(key, None)\n                self._watch_dirs.pop(key, None)\n\n    def _scan_files(self, arch_dir: Path) -> dict[str, float]:\n        \"\"\"Scan directory and return {filename: mtime} for watched file types.\"\"\"\n        states: dict[str, float] = {}\n        if not arch_dir.is_dir():\n            return states\n        for f in arch_dir.iterdir():\n            if f.is_file() and f.suffix in self.WATCH_EXTENSIONS:\n                try:\n                    states[f.name] = f.stat().st_mtime\n                except OSError:\n                    pass\n        return states\n\n    async def _poll_loop(self) -> None:\n        \"\"\"Background loop that polls all watched directories.\"\"\"\n        try:\n            while self._subscribers:\n                for key in list(self._subscribers.keys()):\n                    if key not in self._watch_dirs:\n                        continue\n                    arch_dir = self._watch_dirs[key]\n                    old_states = self._file_states.get(key, {})\n                    new_states = self._scan_files(arch_dir)\n\n                    events = []\n\n                    # Check for changed and new files\n                    for filename, mtime in new_states.items():\n                        if filename not in old_states:\n                            content = self._read_file(arch_dir / filename)\n                            events.append({\n                                \"event\": \"diagram_added\",\n                                \"data\": {\"file\": filename, \"content\": content},\n                            })\n                        elif mtime != old_states[filename]:\n                            content = self._read_file(arch_dir / filename)\n                            events.append({\n                                \"event\": \"diagram_changed\",\n                                \"data\": {\"file\": filename, \"content\": content},\n                            })\n\n                    # Check for removed files\n                    for filename in old_states:\n                        if filename not in new_states:\n                            events.append({\n                                \"event\": \"diagram_removed\",\n                                \"data\": {\"file\": filename},\n                            })\n\n                    self._file_states[key] = new_states\n\n                    # Broadcast events to subscribers\n                    for event in events:\n                        await self._broadcast(key, event)\n\n                await asyncio.sleep(self.POLL_INTERVAL)\n        except asyncio.CancelledError:\n            pass\n\n    async def _broadcast(self, key: str, message: dict) -> None:\n        if key not in self._subscribers:\n            return\n        dead_queues = []\n        for queue in self._subscribers[key]:\n            try:\n                queue.put_nowait(message)\n            except asyncio.QueueFull:\n                dead_queues.append(queue)\n        for q in dead_queues:\n            if key in self._subscribers:\n                self._subscribers[key].remove(q)\n\n    @staticmethod\n    def _read_file(path: Path) -> str:\n        try:\n            return path.read_text(encoding=\"utf-8\")\n        except Exception:\n            return \"\"\n\n    async def stop(self) -> None:\n        \"\"\"Cancel the polling task and clear all state.\"\"\"\n        if self._poll_task and not self._poll_task.done():\n            self._poll_task.cancel()\n            try:\n                await self._poll_task\n            except asyncio.CancelledError:\n                pass\n        self._subscribers.clear()\n        self._file_states.clear()\n        self._watch_dirs.clear()\n\n\n# Singleton instance\ndiagram_watcher = DiagramWatcher()\n","numLines":161,"startLine":1,"totalLines":161}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01Y2qTgP86VtedBw8ugv4znp","type":"message","role":"assistant","content":[{"type":"text","text":"Now let me rewrite diagram_watcher.py to use watchdog with the Observer pattern, keeping the same public API (subscribe, unsubscribe, stop)."}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2163,"cache_read_input_tokens":117690,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2163},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"41eb5763-1813-40b4-994f-a8833bfca10e","uuid":"bf6b9ecd-2f0e-45f2-91b1-66041d30bae8"}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01Y2qTgP86VtedBw8ugv4znp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PeP7TWAkXwKzEb5w8D45RH","name":"Write","input":{"file_path":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/services/diagram_watcher.py","content":"\"\"\"Diagram file watcher using watchdog filesystem events.\n\nUses watchdog's Observer for instant filesystem event detection on Windows\n(ReadDirectoryChangesW) with 100ms debounce to coalesce rapid file saves.\nBroadcasts change events via async queues (same pub-sub pattern as loop_service).\n\nAuto-updates the _arch.json manifest when diagrams are added or removed.\n\"\"\"\n\nimport asyncio\nimport json\nimport logging\nimport threading\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom watchdog.events import FileSystemEvent, FileSystemEventHandler\nfrom watchdog.observers import Observer\n\nlog = logging.getLogger(__name__)\n\n\nclass _DiagramEventHandler(FileSystemEventHandler):\n    \"\"\"Handles filesystem events for .mmd/.drawio files.\"\"\"\n\n    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\n\n    def __init__(self, key: str, arch_dir: Path, watcher: \"DiagramWatcher\"):\n        super().__init__()\n        self.key = key\n        self.arch_dir = arch_dir\n        self.watcher = watcher\n        self._lock = threading.Lock()\n        self._pending: dict[str, tuple[str, str]] = {}  # path -> (event_type, filename)\n        self._timer: Optional[threading.Timer] = None\n\n    def _is_diagram(self, path: str) -> bool:\n        return Path(path).suffix in self.WATCH_EXTENSIONS\n\n    def on_created(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_added\")\n\n    def on_modified(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_changed\")\n\n    def on_deleted(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_removed\")\n\n    def _debounced_notify(self, path: str, event_type: str, delay: float = 0.1):\n        \"\"\"Debounce rapid events (100ms) to coalesce file saves.\"\"\"\n        filename = Path(path).name\n        with self._lock:\n            self._pending[path] = (event_type, filename)\n            if self._timer is not None:\n                self._timer.cancel()\n            self._timer = threading.Timer(delay, self._flush)\n            self._timer.start()\n\n    def _flush(self) -> None:\n        \"\"\"Flush all pending events.\"\"\"\n        with self._lock:\n            pending = dict(self._pending)\n            self._pending.clear()\n            self._timer = None\n\n        manifest_changed = False\n        for path, (event_type, filename) in pending.items():\n            if event_type == \"diagram_removed\":\n                data = {\"file\": filename}\n                manifest_changed = True\n            else:\n                content = _read_file(Path(path))\n                data = {\"file\": filename, \"content\": content}\n                if event_type == \"diagram_added\":\n                    manifest_changed = True\n\n            self.watcher._schedule_broadcast(\n                self.key, {\"event\": event_type, \"data\": data}\n            )\n\n        if manifest_changed:\n            self.watcher._schedule_manifest_update(self.key, self.arch_dir)\n\n    def cancel_timer(self) -> None:\n        \"\"\"Cancel any pending debounce timer.\"\"\"\n        with self._lock:\n            if self._timer is not None:\n                self._timer.cancel()\n                self._timer = None\n\n\ndef _read_file(path: Path) -> str:\n    try:\n        return path.read_text(encoding=\"utf-8\")\n    except Exception:\n        return \"\"\n\n\ndef _detect_diagram_type(path: Path) -> str:\n    \"\"\"Detect Mermaid diagram type from file content.\"\"\"\n    try:\n        content = path.read_text(encoding=\"utf-8\").strip()\n        first_line = content.split(\"\\n\")[0].strip().lower() if content else \"\"\n        for dtype in (\n            \"graph\", \"flowchart\", \"sequencediagram\", \"sequence\",\n            \"classdiagram\", \"class\", \"statediagram\", \"state\",\n            \"erdiagram\", \"er\", \"gantt\", \"pie\", \"gitgraph\",\n            \"c4context\", \"c4container\", \"c4component\", \"c4deployment\",\n            \"mindmap\", \"timeline\",\n        ):\n            if dtype in first_line.replace(\" \", \"\").replace(\"-\", \"\"):\n                return dtype\n        return \"flowchart\"\n    except Exception:\n        return \"flowchart\"\n\n\nclass DiagramWatcher:\n    \"\"\"Watches arch/ directories for file changes using watchdog and notifies subscribers.\"\"\"\n\n    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\n\n    def __init__(self):\n        # Key: \"{project_id}:{feature_name}\" -> list of subscriber queues\n        self._subscribers: dict[str, list[asyncio.Queue]] = {}\n        # Key: same -> Observer instance\n        self._observers: dict[str, Observer] = {}\n        # Key: same -> event handler\n        self._handlers: dict[str, _DiagramEventHandler] = {}\n        # Key: same -> arch dir Path\n        self._watch_dirs: dict[str, Path] = {}\n        # Event loop reference for cross-thread scheduling\n        self._loop: Optional[asyncio.AbstractEventLoop] = None\n\n    @staticmethod\n    def _key(project_id: str, feature_name: str) -> str:\n        return f\"{project_id}:{feature_name}\"\n\n    def subscribe(\n        self, project_id: str, feature_name: str, arch_dir: Path\n    ) -> asyncio.Queue:\n        \"\"\"Register a subscriber for diagram changes. Starts watching if not already.\"\"\"\n        key = self._key(project_id, feature_name)\n\n        # Capture the event loop for cross-thread scheduling\n        try:\n            self._loop = asyncio.get_running_loop()\n        except RuntimeError:\n            pass\n\n        if key not in self._subscribers:\n            self._subscribers[key] = []\n            self._watch_dirs[key] = arch_dir\n            self._start_observer(key, arch_dir)\n\n        queue: asyncio.Queue = asyncio.Queue(maxsize=200)\n        self._subscribers[key].append(queue)\n        return queue\n\n    def unsubscribe(\n        self, project_id: str, feature_name: str, queue: asyncio.Queue\n    ) -> None:\n        key = self._key(project_id, feature_name)\n        if key in self._subscribers:\n            self._subscribers[key] = [\n                q for q in self._subscribers[key] if q is not queue\n            ]\n            if not self._subscribers[key]:\n                del self._subscribers[key]\n                self._watch_dirs.pop(key, None)\n                self._stop_observer(key)\n\n    def _start_observer(self, key: str, arch_dir: Path) -> None:\n        \"\"\"Start a watchdog Observer for the given arch directory.\"\"\"\n        if not arch_dir.is_dir():\n            log.warning(\"Diagram watch dir does not exist: %s\", arch_dir)\n            return\n\n        handler = _DiagramEventHandler(key, arch_dir, self)\n        observer = Observer()\n        observer.schedule(handler, str(arch_dir), recursive=False)\n        observer.daemon = True\n        observer.start()\n\n        self._observers[key] = observer\n        self._handlers[key] = handler\n        log.info(\"Started watching diagrams: %s\", arch_dir)\n\n    def _stop_observer(self, key: str) -> None:\n        \"\"\"Stop the watchdog Observer for the given key.\"\"\"\n        handler = self._handlers.pop(key, None)\n        if handler:\n            handler.cancel_timer()\n\n        observer = self._observers.pop(key, None)\n        if observer:\n            observer.stop()\n            observer.join(timeout=2)\n            log.info(\"Stopped watching diagrams for key: %s\", key)\n\n    def _schedule_broadcast(self, key: str, message: dict) -> None:\n        \"\"\"Thread-safe: schedule a broadcast onto the asyncio event loop.\"\"\"\n        if self._loop and not self._loop.is_closed():\n            self._loop.call_soon_threadsafe(\n                asyncio.ensure_future,\n                self._broadcast(key, message),\n            )\n\n    def _schedule_manifest_update(self, key: str, arch_dir: Path) -> None:\n        \"\"\"Thread-safe: schedule a manifest update onto the asyncio event loop.\"\"\"\n        if self._loop and not self._loop.is_closed():\n            self._loop.call_soon_threadsafe(\n                self._update_manifest_sync, arch_dir,\n            )\n\n    async def _broadcast(self, key: str, message: dict) -> None:\n        if key not in self._subscribers:\n            return\n        dead_queues = []\n        for queue in self._subscribers[key]:\n            try:\n                queue.put_nowait(message)\n            except asyncio.QueueFull:\n                dead_queues.append(queue)\n        for q in dead_queues:\n            if key in self._subscribers:\n                self._subscribers[key].remove(q)\n\n    @staticmethod\n    def _update_manifest_sync(arch_dir: Path) -> None:\n        \"\"\"Scan arch dir for diagram files and regenerate _arch.json manifest.\"\"\"\n        if not arch_dir.is_dir():\n            return\n        entries = []\n        for f in sorted(arch_dir.iterdir()):\n            if f.is_file() and f.suffix in DiagramWatcher.WATCH_EXTENSIONS:\n                name = f.stem.replace(\"-\", \" \").replace(\"_\", \" \").title()\n                diagram_type = _detect_diagram_type(f) if f.suffix == \".mmd\" else \"drawio\"\n                entries.append({\n                    \"name\": name,\n                    \"file\": f.name,\n                    \"type\": \"mermaid\" if f.suffix == \".mmd\" else \"drawio\",\n                    \"diagramType\": diagram_type,\n                })\n        manifest_path = arch_dir / \"_arch.json\"\n        try:\n            manifest_path.write_text(\n                json.dumps(entries, indent=2), encoding=\"utf-8\"\n            )\n        except OSError as e:\n            log.warning(\"Failed to update manifest: %s\", e)\n\n    async def stop(self) -> None:\n        \"\"\"Stop all observers and clear all state.\"\"\"\n        for key in list(self._observers.keys()):\n            self._stop_observer(key)\n        self._subscribers.clear()\n        self._watch_dirs.clear()\n\n\n# Singleton instance\ndiagram_watcher = DiagramWatcher()\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2163,"cache_read_input_tokens":117690,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2163},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"41eb5763-1813-40b4-994f-a8833bfca10e","uuid":"70562cca-3431-444e-ad52-907d57d81cd5"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PeP7TWAkXwKzEb5w8D45RH","type":"tool_result","content":"The file C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/services/diagram_watcher.py has been overwritten successfully."}]},"parent_tool_use_id":null,"session_id":"41eb5763-1813-40b4-994f-a8833bfca10e","uuid":"22e5f6bb-0a4a-4021-bc8d-2152f9b88d99","tool_use_result":{"type":"update","filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/services/diagram_watcher.py","content":"\"\"\"Diagram file watcher using watchdog filesystem events.\n\nUses watchdog's Observer for instant filesystem event detection on Windows\n(ReadDirectoryChangesW) with 100ms debounce to coalesce rapid file saves.\nBroadcasts change events via async queues (same pub-sub pattern as loop_service).\n\nAuto-updates the _arch.json manifest when diagrams are added or removed.\n\"\"\"\n\nimport asyncio\nimport json\nimport logging\nimport threading\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom watchdog.events import FileSystemEvent, FileSystemEventHandler\nfrom watchdog.observers import Observer\n\nlog = logging.getLogger(__name__)\n\n\nclass _DiagramEventHandler(FileSystemEventHandler):\n    \"\"\"Handles filesystem events for .mmd/.drawio files.\"\"\"\n\n    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\n\n    def __init__(self, key: str, arch_dir: Path, watcher: \"DiagramWatcher\"):\n        super().__init__()\n        self.key = key\n        self.arch_dir = arch_dir\n        self.watcher = watcher\n        self._lock = threading.Lock()\n        self._pending: dict[str, tuple[str, str]] = {}  # path -> (event_type, filename)\n        self._timer: Optional[threading.Timer] = None\n\n    def _is_diagram(self, path: str) -> bool:\n        return Path(path).suffix in self.WATCH_EXTENSIONS\n\n    def on_created(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_added\")\n\n    def on_modified(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_changed\")\n\n    def on_deleted(self, event: FileSystemEvent) -> None:\n        if not event.is_directory and self._is_diagram(event.src_path):\n            self._debounced_notify(event.src_path, \"diagram_removed\")\n\n    def _debounced_notify(self, path: str, event_type: str, delay: float = 0.1):\n        \"\"\"Debounce rapid events (100ms) to coalesce file saves.\"\"\"\n        filename = Path(path).name\n        with self._lock:\n            self._pending[path] = (event_type, filename)\n            if self._timer is not None:\n                self._timer.cancel()\n            self._timer = threading.Timer(delay, self._flush)\n            self._timer.start()\n\n    def _flush(self) -> None:\n        \"\"\"Flush all pending events.\"\"\"\n        with self._lock:\n            pending = dict(self._pending)\n            self._pending.clear()\n            self._timer = None\n\n        manifest_changed = False\n        for path, (event_type, filename) in pending.items():\n            if event_type == \"diagram_removed\":\n                data = {\"file\": filename}\n                manifest_changed = True\n            else:\n                content = _read_file(Path(path))\n                data = {\"file\": filename, \"content\": content}\n                if event_type == \"diagram_added\":\n                    manifest_changed = True\n\n            self.watcher._schedule_broadcast(\n                self.key, {\"event\": event_type, \"data\": data}\n            )\n\n        if manifest_changed:\n            self.watcher._schedule_manifest_update(self.key, self.arch_dir)\n\n    def cancel_timer(self) -> None:\n        \"\"\"Cancel any pending debounce timer.\"\"\"\n        with self._lock:\n            if self._timer is not None:\n                self._timer.cancel()\n                self._timer = None\n\n\ndef _read_file(path: Path) -> str:\n    try:\n        return path.read_text(encoding=\"utf-8\")\n    except Exception:\n        return \"\"\n\n\ndef _detect_diagram_type(path: Path) -> str:\n    \"\"\"Detect Mermaid diagram type from file content.\"\"\"\n    try:\n        content = path.read_text(encoding=\"utf-8\").strip()\n        first_line = content.split(\"\\n\")[0].strip().lower() if content else \"\"\n        for dtype in (\n            \"graph\", \"flowchart\", \"sequencediagram\", \"sequence\",\n            \"classdiagram\", \"class\", \"statediagram\", \"state\",\n            \"erdiagram\", \"er\", \"gantt\", \"pie\", \"gitgraph\",\n            \"c4context\", \"c4container\", \"c4component\", \"c4deployment\",\n            \"mindmap\", \"timeline\",\n        ):\n            if dtype in first_line.replace(\" \", \"\").replace(\"-\", \"\"):\n                return dtype\n        return \"flowchart\"\n    except Exception:\n        return \"flowchart\"\n\n\nclass DiagramWatcher:\n    \"\"\"Watches arch/ directories for file changes using watchdog and notifies subscribers.\"\"\"\n\n    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\n\n    def __init__(self):\n        # Key: \"{project_id}:{feature_name}\" -> list of subscriber queues\n        self._subscribers: dict[str, list[asyncio.Queue]] = {}\n        # Key: same -> Observer instance\n        self._observers: dict[str, Observer] = {}\n        # Key: same -> event handler\n        self._handlers: dict[str, _DiagramEventHandler] = {}\n        # Key: same -> arch dir Path\n        self._watch_dirs: dict[str, Path] = {}\n        # Event loop reference for cross-thread scheduling\n        self._loop: Optional[asyncio.AbstractEventLoop] = None\n\n    @staticmethod\n    def _key(project_id: str, feature_name: str) -> str:\n        return f\"{project_id}:{feature_name}\"\n\n    def subscribe(\n        self, project_id: str, feature_name: str, arch_dir: Path\n    ) -> asyncio.Queue:\n        \"\"\"Register a subscriber for diagram changes. Starts watching if not already.\"\"\"\n        key = self._key(project_id, feature_name)\n\n        # Capture the event loop for cross-thread scheduling\n        try:\n            self._loop = asyncio.get_running_loop()\n        except RuntimeError:\n            pass\n\n        if key not in self._subscribers:\n            self._subscribers[key] = []\n            self._watch_dirs[key] = arch_dir\n            self._start_observer(key, arch_dir)\n\n        queue: asyncio.Queue = asyncio.Queue(maxsize=200)\n        self._subscribers[key].append(queue)\n        return queue\n\n    def unsubscribe(\n        self, project_id: str, feature_name: str, queue: asyncio.Queue\n    ) -> None:\n        key = self._key(project_id, feature_name)\n        if key in self._subscribers:\n            self._subscribers[key] = [\n                q for q in self._subscribers[key] if q is not queue\n            ]\n            if not self._subscribers[key]:\n                del self._subscribers[key]\n                self._watch_dirs.pop(key, None)\n                self._stop_observer(key)\n\n    def _start_observer(self, key: str, arch_dir: Path) -> None:\n        \"\"\"Start a watchdog Observer for the given arch directory.\"\"\"\n        if not arch_dir.is_dir():\n            log.warning(\"Diagram watch dir does not exist: %s\", arch_dir)\n            return\n\n        handler = _DiagramEventHandler(key, arch_dir, self)\n        observer = Observer()\n        observer.schedule(handler, str(arch_dir), recursive=False)\n        observer.daemon = True\n        observer.start()\n\n        self._observers[key] = observer\n        self._handlers[key] = handler\n        log.info(\"Started watching diagrams: %s\", arch_dir)\n\n    def _stop_observer(self, key: str) -> None:\n        \"\"\"Stop the watchdog Observer for the given key.\"\"\"\n        handler = self._handlers.pop(key, None)\n        if handler:\n            handler.cancel_timer()\n\n        observer = self._observers.pop(key, None)\n        if observer:\n            observer.stop()\n            observer.join(timeout=2)\n            log.info(\"Stopped watching diagrams for key: %s\", key)\n\n    def _schedule_broadcast(self, key: str, message: dict) -> None:\n        \"\"\"Thread-safe: schedule a broadcast onto the asyncio event loop.\"\"\"\n        if self._loop and not self._loop.is_closed():\n            self._loop.call_soon_threadsafe(\n                asyncio.ensure_future,\n                self._broadcast(key, message),\n            )\n\n    def _schedule_manifest_update(self, key: str, arch_dir: Path) -> None:\n        \"\"\"Thread-safe: schedule a manifest update onto the asyncio event loop.\"\"\"\n        if self._loop and not self._loop.is_closed():\n            self._loop.call_soon_threadsafe(\n                self._update_manifest_sync, arch_dir,\n            )\n\n    async def _broadcast(self, key: str, message: dict) -> None:\n        if key not in self._subscribers:\n            return\n        dead_queues = []\n        for queue in self._subscribers[key]:\n            try:\n                queue.put_nowait(message)\n            except asyncio.QueueFull:\n                dead_queues.append(queue)\n        for q in dead_queues:\n            if key in self._subscribers:\n                self._subscribers[key].remove(q)\n\n    @staticmethod\n    def _update_manifest_sync(arch_dir: Path) -> None:\n        \"\"\"Scan arch dir for diagram files and regenerate _arch.json manifest.\"\"\"\n        if not arch_dir.is_dir():\n            return\n        entries = []\n        for f in sorted(arch_dir.iterdir()):\n            if f.is_file() and f.suffix in DiagramWatcher.WATCH_EXTENSIONS:\n                name = f.stem.replace(\"-\", \" \").replace(\"_\", \" \").title()\n                diagram_type = _detect_diagram_type(f) if f.suffix == \".mmd\" else \"drawio\"\n                entries.append({\n                    \"name\": name,\n                    \"file\": f.name,\n                    \"type\": \"mermaid\" if f.suffix == \".mmd\" else \"drawio\",\n                    \"diagramType\": diagram_type,\n                })\n        manifest_path = arch_dir / \"_arch.json\"\n        try:\n            manifest_path.write_text(\n                json.dumps(entries, indent=2), encoding=\"utf-8\"\n            )\n        except OSError as e:\n            log.warning(\"Failed to update manifest: %s\", e)\n\n    async def stop(self) -> None:\n        \"\"\"Stop all observers and clear all state.\"\"\"\n        for key in list(self._observers.keys()):\n            self._stop_observer(key)\n        self._subscribers.clear()\n        self._watch_dirs.clear()\n\n\n# Singleton instance\ndiagram_watcher = DiagramWatcher()\n","structuredPatch":[{"oldStart":1,"oldLines":160,"newStart":1,"newLines":265,"lines":["-\"\"\"Diagram file watcher using polling.\r","-\r","-Tracks mtime of files in a feature's arch/ directory and broadcasts\r","-change events via async queues (same pub-sub pattern as loop_service).\r","-\"\"\"\r","-\r","-import asyncio\r","-from pathlib import Path\r","-from typing import Optional\r","-\r","-\r","-class DiagramWatcher:\r","-    \"\"\"Polls an arch/ directory for file changes and notifies subscribers.\"\"\"\r","-\r","-    POLL_INTERVAL = 2.0  # seconds\r","-    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\r","-\r","-    def __init__(self):\r","-        # Key: \"{project_id}:{feature_name}\" → list of subscriber queues\r","-        self._subscribers: dict[str, list[asyncio.Queue]] = {}\r","-        # Key: same → dict[filename, mtime]\r","-        self._file_states: dict[str, dict[str, float]] = {}\r","-        # Key: same → arch dir Path\r","-        self._watch_dirs: dict[str, Path] = {}\r","-        # Background polling task\r","-        self._poll_task: Optional[asyncio.Task] = None\r","-\r","-    @staticmethod\r","-    def _key(project_id: str, feature_name: str) -> str:\r","-        return f\"{project_id}:{feature_name}\"\r","-\r","-    def subscribe(\r","-        self, project_id: str, feature_name: str, arch_dir: Path\r","-    ) -> asyncio.Queue:\r","-        \"\"\"Register a subscriber for diagram changes. Starts polling if not running.\"\"\"\r","-        key = self._key(project_id, feature_name)\r","-\r","-        if key not in self._subscribers:\r","-            self._subscribers[key] = []\r","-            self._watch_dirs[key] = arch_dir\r","-            # Snapshot current file states\r","-            self._file_states[key] = self._scan_files(arch_dir)\r","-\r","-        queue: asyncio.Queue = asyncio.Queue(maxsize=200)\r","-        self._subscribers[key].append(queue)\r","-\r","-        # Ensure polling task is running\r","-        if self._poll_task is None or self._poll_task.done():\r","-            self._poll_task = asyncio.create_task(self._poll_loop())\r","-\r","-        return queue\r","-\r","-    def unsubscribe(\r","-        self, project_id: str, feature_name: str, queue: asyncio.Queue\r","-    ) -> None:\r","-        key = self._key(project_id, feature_name)\r","-        if key in self._subscribers:\r","-            self._subscribers[key] = [\r","-                q for q in self._subscribers[key] if q is not queue\r","-            ]\r","-            # Clean up if no more subscribers for this key\r","-            if not self._subscribers[key]:\r","-                del self._subscribers[key]\r","-                self._file_states.pop(key, None)\r","-                self._watch_dirs.pop(key, None)\r","-\r","-    def _scan_files(self, arch_dir: Path) -> dict[str, float]:\r","-        \"\"\"Scan directory and return {filename: mtime} for watched file types.\"\"\"\r","-        states: dict[str, float] = {}\r","-        if not arch_dir.is_dir():\r","-            return states\r","-        for f in arch_dir.iterdir():\r","-            if f.is_file() and f.suffix in self.WATCH_EXTENSIONS:\r","-                try:\r","-                    states[f.name] = f.stat().st_mtime\r","-                except OSError:\r","-                    pass\r","-        return states\r","-\r","-    async def _poll_loop(self) -> None:\r","-        \"\"\"Background loop that polls all watched directories.\"\"\"\r","-        try:\r","-            while self._subscribers:\r","-                for key in list(self._subscribers.keys()):\r","-                    if key not in self._watch_dirs:\r","-                        continue\r","-                    arch_dir = self._watch_dirs[key]\r","-                    old_states = self._file_states.get(key, {})\r","-                    new_states = self._scan_files(arch_dir)\r","-\r","-                    events = []\r","-\r","-                    # Check for changed and new files\r","-                    for filename, mtime in new_states.items():\r","-                        if filename not in old_states:\r","-                            content = self._read_file(arch_dir / filename)\r","-                            events.append({\r","-                                \"event\": \"diagram_added\",\r","-                                \"data\": {\"file\": filename, \"content\": content},\r","-                            })\r","-                        elif mtime != old_states[filename]:\r","-                            content = self._read_file(arch_dir / filename)\r","-                            events.append({\r","-                                \"event\": \"diagram_changed\",\r","-                                \"data\": {\"file\": filename, \"content\": content},\r","-                            })\r","-\r","-                    # Check for removed files\r","-                    for filename in old_states:\r","-                        if filename not in new_states:\r","-                            events.append({\r","-                                \"event\": \"diagram_removed\",\r","-                                \"data\": {\"file\": filename},\r","-                            })\r","-\r","-                    self._file_states[key] = new_states\r","-\r","-                    # Broadcast events to subscribers\r","-                    for event in events:\r","-                        await self._broadcast(key, event)\r","-\r","-                await asyncio.sleep(self.POLL_INTERVAL)\r","-        except asyncio.CancelledError:\r","-            pass\r","-\r","-    async def _broadcast(self, key: str, message: dict) -> None:\r","-        if key not in self._subscribers:\r","-            return\r","-        dead_queues = []\r","-        for queue in self._subscribers[key]:\r","-            try:\r","-                queue.put_nowait(message)\r","-            except asyncio.QueueFull:\r","-                dead_queues.append(queue)\r","-        for q in dead_queues:\r","-            if key in self._subscribers:\r","-                self._subscribers[key].remove(q)\r","-\r","-    @staticmethod\r","-    def _read_file(path: Path) -> str:\r","-        try:\r","-            return path.read_text(encoding=\"utf-8\")\r","-        except Exception:\r","-            return \"\"\r","-\r","-    async def stop(self) -> None:\r","-        \"\"\"Cancel the polling task and clear all state.\"\"\"\r","-        if self._poll_task and not self._poll_task.done():\r","-            self._poll_task.cancel()\r","-            try:\r","-                await self._poll_task\r","-            except asyncio.CancelledError:\r","-                pass\r","-        self._subscribers.clear()\r","-        self._file_states.clear()\r","-        self._watch_dirs.clear()\r","-\r","-\r","-# Singleton instance\r","-diagram_watcher = DiagramWatcher()\r","+\"\"\"Diagram file watcher using watchdog filesystem events.","+","+Uses watchdog's Observer for instant filesystem event detection on Windows","+(ReadDirectoryChangesW) with 100ms debounce to coalesce rapid file saves.","+Broadcasts change events via async queues (same pub-sub pattern as loop_service).","+","+Auto-updates the _arch.json manifest when diagrams are added or removed.","+\"\"\"","+","+import asyncio","+import json","+import logging","+import threading","+from pathlib import Path","+from typing import Optional","+","+from watchdog.events import FileSystemEvent, FileSystemEventHandler","+from watchdog.observers import Observer","+","+log = logging.getLogger(__name__)","+","+","+class _DiagramEventHandler(FileSystemEventHandler):","+    \"\"\"Handles filesystem events for .mmd/.drawio files.\"\"\"","+","+    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}","+","+    def __init__(self, key: str, arch_dir: Path, watcher: \"DiagramWatcher\"):","+        super().__init__()","+        self.key = key","+        self.arch_dir = arch_dir","+        self.watcher = watcher","+        self._lock = threading.Lock()","+        self._pending: dict[str, tuple[str, str]] = {}  # path -> (event_type, filename)","+        self._timer: Optional[threading.Timer] = None","+","+    def _is_diagram(self, path: str) -> bool:","+        return Path(path).suffix in self.WATCH_EXTENSIONS","+","+    def on_created(self, event: FileSystemEvent) -> None:","+        if not event.is_directory and self._is_diagram(event.src_path):","+            self._debounced_notify(event.src_path, \"diagram_added\")","+","+    def on_modified(self, event: FileSystemEvent) -> None:","+        if not event.is_directory and self._is_diagram(event.src_path):","+            self._debounced_notify(event.src_path, \"diagram_changed\")","+","+    def on_deleted(self, event: FileSystemEvent) -> None:","+        if not event.is_directory and self._is_diagram(event.src_path):","+            self._debounced_notify(event.src_path, \"diagram_removed\")","+","+    def _debounced_notify(self, path: str, event_type: str, delay: float = 0.1):","+        \"\"\"Debounce rapid events (100ms) to coalesce file saves.\"\"\"","+        filename = Path(path).name","+        with self._lock:","+            self._pending[path] = (event_type, filename)","+            if self._timer is not None:","+                self._timer.cancel()","+            self._timer = threading.Timer(delay, self._flush)","+            self._timer.start()","+","+    def _flush(self) -> None:","+        \"\"\"Flush all pending events.\"\"\"","+        with self._lock:","+            pending = dict(self._pending)","+            self._pending.clear()","+            self._timer = None","+","+        manifest_changed = False","+        for path, (event_type, filename) in pending.items():","+            if event_type == \"diagram_removed\":","+                data = {\"file\": filename}","+                manifest_changed = True","+            else:","+                content = _read_file(Path(path))","+                data = {\"file\": filename, \"content\": content}","+                if event_type == \"diagram_added\":","+                    manifest_changed = True","+","+            self.watcher._schedule_broadcast(","+                self.key, {\"event\": event_type, \"data\": data}","+            )","+","+        if manifest_changed:","+            self.watcher._schedule_manifest_update(self.key, self.arch_dir)","+","+    def cancel_timer(self) -> None:","+        \"\"\"Cancel any pending debounce timer.\"\"\"","+        with self._lock:","+            if self._timer is not None:","+                self._timer.cancel()","+                self._timer = None","+","+","+def _read_file(path: Path) -> str:","+    try:","+        return path.read_text(encoding=\"utf-8\")","+    except Exception:","+        return \"\"","+","+","+def _detect_diagram_type(path: Path) -> str:","+    \"\"\"Detect Mermaid diagram type from file content.\"\"\"","+    try:","+        content = path.read_text(encoding=\"utf-8\").strip()","+        first_line = content.split(\"\\n\")[0].strip().lower() if content else \"\"","+        for dtype in (","+            \"graph\", \"flowchart\", \"sequencediagram\", \"sequence\",","+            \"classdiagram\", \"class\", \"statediagram\", \"state\",","+            \"erdiagram\", \"er\", \"gantt\", \"pie\", \"gitgraph\",","+            \"c4context\", \"c4container\", \"c4component\", \"c4deployment\",","+            \"mindmap\", \"timeline\",","+        ):","+            if dtype in first_line.replace(\" \", \"\").replace(\"-\", \"\"):","+                return dtype","+        return \"flowchart\"","+    except Exception:","+        return \"flowchart\"","+","+","+class DiagramWatcher:","+    \"\"\"Watches arch/ directories for file changes using watchdog and notifies subscribers.\"\"\"","+","+    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}","+","+    def __init__(self):","+        # Key: \"{project_id}:{feature_name}\" -> list of subscriber queues","+        self._subscribers: dict[str, list[asyncio.Queue]] = {}","+        # Key: same -> Observer instance","+        self._observers: dict[str, Observer] = {}","+        # Key: same -> event handler","+        self._handlers: dict[str, _DiagramEventHandler] = {}","+        # Key: same -> arch dir Path","+        self._watch_dirs: dict[str, Path] = {}","+        # Event loop reference for cross-thread scheduling","+        self._loop: Optional[asyncio.AbstractEventLoop] = None","+","+    @staticmethod","+    def _key(project_id: str, feature_name: str) -> str:","+        return f\"{project_id}:{feature_name}\"","+","+    def subscribe(","+        self, project_id: str, feature_name: str, arch_dir: Path","+    ) -> asyncio.Queue:","+        \"\"\"Register a subscriber for diagram changes. Starts watching if not already.\"\"\"","+        key = self._key(project_id, feature_name)","+","+        # Capture the event loop for cross-thread scheduling","+        try:","+            self._loop = asyncio.get_running_loop()","+        except RuntimeError:","+            pass","+","+        if key not in self._subscribers:","+            self._subscribers[key] = []","+            self._watch_dirs[key] = arch_dir","+            self._start_observer(key, arch_dir)","+","+        queue: asyncio.Queue = asyncio.Queue(maxsize=200)","+        self._subscribers[key].append(queue)","+        return queue","+","+    def unsubscribe(","+        self, project_id: str, feature_name: str, queue: asyncio.Queue","+    ) -> None:","+        key = self._key(project_id, feature_name)","+        if key in self._subscribers:","+            self._subscribers[key] = [","+                q for q in self._subscribers[key] if q is not queue","+            ]","+            if not self._subscribers[key]:","+                del self._subscribers[key]","+                self._watch_dirs.pop(key, None)","+                self._stop_observer(key)","+","+    def _start_observer(self, key: str, arch_dir: Path) -> None:","+        \"\"\"Start a watchdog Observer for the given arch directory.\"\"\"","+        if not arch_dir.is_dir():","+            log.warning(\"Diagram watch dir does not exist: %s\", arch_dir)","+            return","+","+        handler = _DiagramEventHandler(key, arch_dir, self)","+        observer = Observer()","+        observer.schedule(handler, str(arch_dir), recursive=False)","+        observer.daemon = True","+        observer.start()","+","+        self._observers[key] = observer","+        self._handlers[key] = handler","+        log.info(\"Started watching diagrams: %s\", arch_dir)","+","+    def _stop_observer(self, key: str) -> None:","+        \"\"\"Stop the watchdog Observer for the given key.\"\"\"","+        handler = self._handlers.pop(key, None)","+        if handler:","+            handler.cancel_timer()","+","+        observer = self._observers.pop(key, None)","+        if observer:","+            observer.stop()","+            observer.join(timeout=2)","+            log.info(\"Stopped watching diagrams for key: %s\", key)","+","+    def _schedule_broadcast(self, key: str, message: dict) -> None:","+        \"\"\"Thread-safe: schedule a broadcast onto the asyncio event loop.\"\"\"","+        if self._loop and not self._loop.is_closed():","+            self._loop.call_soon_threadsafe(","+                asyncio.ensure_future,","+                self._broadcast(key, message),","+            )","+","+    def _schedule_manifest_update(self, key: str, arch_dir: Path) -> None:","+        \"\"\"Thread-safe: schedule a manifest update onto the asyncio event loop.\"\"\"","+        if self._loop and not self._loop.is_closed():","+            self._loop.call_soon_threadsafe(","+                self._update_manifest_sync, arch_dir,","+            )","+","+    async def _broadcast(self, key: str, message: dict) -> None:","+        if key not in self._subscribers:","+            return","+        dead_queues = []","+        for queue in self._subscribers[key]:","+            try:","+                queue.put_nowait(message)","+            except asyncio.QueueFull:","+                dead_queues.append(queue)","+        for q in dead_queues:","+            if key in self._subscribers:","+                self._subscribers[key].remove(q)","+","+    @staticmethod","+    def _update_manifest_sync(arch_dir: Path) -> None:","+        \"\"\"Scan arch dir for diagram files and regenerate _arch.json manifest.\"\"\"","+        if not arch_dir.is_dir():","+            return","+        entries = []","+        for f in sorted(arch_dir.iterdir()):","+            if f.is_file() and f.suffix in DiagramWatcher.WATCH_EXTENSIONS:","+                name = f.stem.replace(\"-\", \" \").replace(\"_\", \" \").title()","+                diagram_type = _detect_diagram_type(f) if f.suffix == \".mmd\" else \"drawio\"","+                entries.append({","+                    \"name\": name,","+                    \"file\": f.name,","+                    \"type\": \"mermaid\" if f.suffix == \".mmd\" else \"drawio\",","+                    \"diagramType\": diagram_type,","+                })","+        manifest_path = arch_dir / \"_arch.json\"","+        try:","+            manifest_path.write_text(","+                json.dumps(entries, indent=2), encoding=\"utf-8\"","+            )","+        except OSError as e:","+            log.warning(\"Failed to update manifest: %s\", e)","+","+    async def stop(self) -> None:","+        \"\"\"Stop all observers and clear all state.\"\"\"","+        for key in list(self._observers.keys()):","+            self._stop_observer(key)","+        self._subscribers.clear()","+        self._watch_dirs.clear()","+","+","+# Singleton instance","+diagram_watcher = DiagramWatcher()"]}],"originalFile":"\"\"\"Diagram file watcher using polling.\r\n\r\nTracks mtime of files in a feature's arch/ directory and broadcasts\r\nchange events via async queues (same pub-sub pattern as loop_service).\r\n\"\"\"\r\n\r\nimport asyncio\r\nfrom pathlib import Path\r\nfrom typing import Optional\r\n\r\n\r\nclass DiagramWatcher:\r\n    \"\"\"Polls an arch/ directory for file changes and notifies subscribers.\"\"\"\r\n\r\n    POLL_INTERVAL = 2.0  # seconds\r\n    WATCH_EXTENSIONS = {\".mmd\", \".drawio\"}\r\n\r\n    def __init__(self):\r\n        # Key: \"{project_id}:{feature_name}\" → list of subscriber queues\r\n        self._subscribers: dict[str, list[asyncio.Queue]] = {}\r\n        # Key: same → dict[filename, mtime]\r\n        self._file_states: dict[str, dict[str, float]] = {}\r\n        # Key: same → arch dir Path\r\n        self._watch_dirs: dict[str, Path] = {}\r\n        # Background polling task\r\n        self._poll_task: Optional[asyncio.Task] = None\r\n\r\n    @staticmethod\r\n    def _key(project_id: str, feature_name: str) -> str:\r\n        return f\"{project_id}:{feature_name}\"\r\n\r\n    def subscribe(\r\n        self, project_id: str, feature_name: str, arch_dir: Path\r\n    ) -> asyncio.Queue:\r\n        \"\"\"Register a subscriber for diagram changes. Starts polling if not running.\"\"\"\r\n        key = self._key(project_id, feature_name)\r\n\r\n        if key not in self._subscribers:\r\n            self._subscribers[key] = []\r\n            self._watch_dirs[key] = arch_dir\r\n            # Snapshot current file states\r\n            self._file_states[key] = self._scan_files(arch_dir)\r\n\r\n        queue: asyncio.Queue = asyncio.Queue(maxsize=200)\r\n        self._subscribers[key].append(queue)\r\n\r\n        # Ensure polling task is running\r\n        if self._poll_task is None or self._poll_task.done():\r\n            self._poll_task = asyncio.create_task(self._poll_loop())\r\n\r\n        return queue\r\n\r\n    def unsubscribe(\r\n        self, project_id: str, feature_name: str, queue: asyncio.Queue\r\n    ) -> None:\r\n        key = self._key(project_id, feature_name)\r\n        if key in self._subscribers:\r\n            self._subscribers[key] = [\r\n                q for q in self._subscribers[key] if q is not queue\r\n            ]\r\n            # Clean up if no more subscribers for this key\r\n            if not self._subscribers[key]:\r\n                del self._subscribers[key]\r\n                self._file_states.pop(key, None)\r\n                self._watch_dirs.pop(key, None)\r\n\r\n    def _scan_files(self, arch_dir: Path) -> dict[str, float]:\r\n        \"\"\"Scan directory and return {filename: mtime} for watched file types.\"\"\"\r\n        states: dict[str, float] = {}\r\n        if not arch_dir.is_dir():\r\n            return states\r\n        for f in arch_dir.iterdir():\r\n            if f.is_file() and f.suffix in self.WATCH_EXTENSIONS:\r\n                try:\r\n                    states[f.name] = f.stat().st_mtime\r\n                except OSError:\r\n                    pass\r\n        return states\r\n\r\n    async def _poll_loop(self) -> None:\r\n        \"\"\"Background loop that polls all watched directories.\"\"\"\r\n        try:\r\n            while self._subscribers:\r\n                for key in list(self._subscribers.keys()):\r\n                    if key not in self._watch_dirs:\r\n                        continue\r\n                    arch_dir = self._watch_dirs[key]\r\n                    old_states = self._file_states.get(key, {})\r\n                    new_states = self._scan_files(arch_dir)\r\n\r\n                    events = []\r\n\r\n                    # Check for changed and new files\r\n                    for filename, mtime in new_states.items():\r\n                        if filename not in old_states:\r\n                            content = self._read_file(arch_dir / filename)\r\n                            events.append({\r\n                                \"event\": \"diagram_added\",\r\n                                \"data\": {\"file\": filename, \"content\": content},\r\n                            })\r\n                        elif mtime != old_states[filename]:\r\n                            content = self._read_file(arch_dir / filename)\r\n                            events.append({\r\n                                \"event\": \"diagram_changed\",\r\n                                \"data\": {\"file\": filename, \"content\": content},\r\n                            })\r\n\r\n                    # Check for removed files\r\n                    for filename in old_states:\r\n                        if filename not in new_states:\r\n                            events.append({\r\n                                \"event\": \"diagram_removed\",\r\n                                \"data\": {\"file\": filename},\r\n                            })\r\n\r\n                    self._file_states[key] = new_states\r\n\r\n                    # Broadcast events to subscribers\r\n                    for event in events:\r\n                        await self._broadcast(key, event)\r\n\r\n                await asyncio.sleep(self.POLL_INTERVAL)\r\n        except asyncio.CancelledError:\r\n            pass\r\n\r\n    async def _broadcast(self, key: str, message: dict) -> None:\r\n        if key not in self._subscribers:\r\n            return\r\n        dead_queues = []\r\n        for queue in self._subscribers[key]:\r\n            try:\r\n                queue.put_nowait(message)\r\n            except asyncio.QueueFull:\r\n                dead_queues.append(queue)\r\n        for q in dead_queues:\r\n            if key in self._subscribers:\r\n                self._subscribers[key].remove(q)\r\n\r\n    @staticmethod\r\n    def _read_file(path: Path) -> str:\r\n        try:\r\n            return path.read_text(encoding=\"utf-8\")\r\n        except Exception:\r\n            return \"\"\r\n\r\n    async def stop(self) -> None:\r\n        \"\"\"Cancel the polling task and clear all state.\"\"\"\r\n        if self._poll_task and not self._poll_task.done():\r\n            self._poll_task.cancel()\r\n            try:\r\n                await self._poll_task\r\n            except asyncio.CancelledError:\r\n                pass\r\n        self._subscribers.clear()\r\n        self._file_states.clear()\r\n        self._watch_dirs.clear()\r\n\r\n\r\n# Singleton instance\r\ndiagram_watcher = DiagramWatcher()\r\n"}}
