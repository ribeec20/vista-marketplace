\r","-            all_msgs = [{\"role\": m.role, \"content\": m.content} for m in session.messages]\r","-            history = all_msgs[:-1] if len(all_msgs) > 1 else None\r","-            system_prompt = chat_service.build_prompt(\r","-                message=body.message,\r","-                context=body.context,\r","-                history=history,\r","-                arch_dir=arch_dir,\r","-                project_root=project.path,\r","-            )\r","-            try:\r","-                team_name = keepalive_manager.start(\r","-                    session_id=session_id,\r","-                    provider=provider_name,\r","-                    model=model_name,\r","-                    system_prompt=system_prompt,\r","-                    cwd=project.path,\r","-                )\r","-                session.team_name = team_name\r","-                ChatSessionService.save(session)\r","-            except Exception as e:\r","-                await _broadcast(session_id, {\r","-                    \"event\": \"chat_error\",\r","-                    \"data\": {\"detail\": f\"Failed to start agent: {e}\"},\r","-                })\r","-                return {\"status\": \"error\", \"session_id\": session_id, \"mode\": body.mode}\r","-        else:\r","-            # Agent is alive — send just the user message (agent has context)\r","-            keepalive_manager.send_message(session_id, body.message, context=body.context)\r","-\r","-        asyncio.create_task(\r","-            _stream_response_keepalive(project_id, session_id)\r","-        )\r","-    else:\r","-        # One-shot mode: full history replay each time\r","-        all_msgs = [{\"role\": m.role, \"content\": m.content} for m in session.messages]\r","-        history = all_msgs[:-1] if len(all_msgs) > 1 else None\r","-        prompt = chat_service.build_prompt(\r","-            message=body.message,\r","-            context=body.context,\r","-            history=history,\r","-            arch