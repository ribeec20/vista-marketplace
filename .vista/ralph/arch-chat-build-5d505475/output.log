{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NyZwLp7pQGwA5Ak2AZKWcX","type":"tool_result","content":"     1→\"\"\"Provider router for architecture chat.\n     2→\n     3→Routes chat messages to the correct backend (Claude WebSocket or OpenCode SSE)\n     4→based on the provider type. Manages session mapping between Vista and backend\n     5→session IDs.\n     6→\"\"\"\n     7→\n     8→import logging\n     9→from collections.abc import AsyncGenerator\n    10→from typing import Optional\n    11→\n    12→from server.services.service_lifecycle import service_lifecycle\n    13→from server.services.claude_ws_client import ClaudeWSClient\n    14→from server.services.opencode_client import OpenCodeClient\n    15→\n    16→log = logging.getLogger(__name__)\n    17→\n    18→\n    19→class ProviderRouter:\n    20→    \"\"\"Routes chat messages to the correct backend based on provider type.\"\"\"\n    21→\n    22→    def __init__(self):\n    23→        self._claude_clients: dict[str, ClaudeWSClient] = {}  # session_id -> client\n    24→        self._opencode_clients: dict[str, OpenCodeClient] = {}  # session_id -> client\n    25→        # Vista session_id -> {provider, backend_session_id, model, cwd}\n    26→        self._session_map: dict[str, dict] = {}\n    27→\n    28→    async def create_backend_session(\n    29→        self, provider: str, model: str, session_id: str, cwd: str\n    30→    ) -> str:\n    31→        \"\"\"Create a backend session and return the backend session ID.\"\"\"\n    32→        if provider == \"claude\":\n    33→            return await self._create_claude_session(model, session_id, cwd)\n    34→        elif provider == \"opencode\":\n    35→            return await self._create_opencode_session(model, session_id, cwd)\n    36→        else:\n    37→            raise ValueError(f\"Unknown provider: {provider}\")\n    38→\n    39→    async def send_message(\n    40→        self, provider: str, model: str, prompt: str,\n    41→        session_id: str, cwd: str,\n    42→    ) -> AsyncGenerator[dict, None]:\n    43→        \"\"\"Yield streaming events: {type: \"token\"|\"done\"|\"error\", ...}.\"\"\"\n    44→        # Ensure backend session exists\n    45→        if session_id not in self._session_map:\n    46→            try:\n    47→                await self.create_backend_session(provider, model, session_id, cwd)\n    48→            except Exception as e:\n    49→                yield {\"type\": \"error\", \"detail\": f\"Failed to create backend session: {e}\"}\n    50→                return\n    51→\n    52→        mapping = self._session_map[session_id]\n    53→\n    54→        if mapping[\"provider\"] == \"claude\":\n    55→            async for event in self._send_claude(session_id, prompt):\n    56→                yield event\n    57→        elif mapping[\"provider\"] == \"opencode\":\n    58→            async for event in self._send_opencode(session_id, prompt, model):\n    59→                yield event\n    60→        else:\n    61→            yield {\"type\": \"error\", \"detail\": f\"Unknown provider: {mapping['provider']}\"}\n    62→\n    63→    async def cleanup_session(self, session_id: str) -> None:\n    64→        \"\"\"Clean up backend session when Vista session is deleted.\"\"\"\n    65→        mapping = self._session_map.pop(session_id, None)\n    66→        if not mapping:\n    67→            return\n    68→\n    69→        backend_id = mapping[\"backend_session_id\"]\n    70→        provider = mapping[\"provider\"]\n    71→\n    72→        if provider == \"claude\":\n    73→            client = self._claude_clients.pop(session_id, None)\n    74→            if client:\n    75→                await client.disconnect()\n    76→                await client.delete_session(backend_id)\n    77→        elif provider == \"opencode\":\n    78→            client = self._opencode_clients.pop(session_id, None)\n    79→            if client:\n    80→                await client.abort_session(backend_id)\n    81→                await client.delete_session(backend_id)\n    82→\n    83→    async def cleanup_all(self) -> None:\n    84→        \"\"\"Clean up all backend sessions on shutdown.\"\"\"\n    85→        for session_id in list(self._session_map.keys()):\n    86→            await self.cleanup_session(session_id)\n    87→\n    88→    # --- Claude WebSocket ---\n    89→\n    90→    async def _create_claude_session(self, model: str, session_id: str, cwd: str) -> str:\n    91→        \"\"\"Create a Claude session via Companion's HTTP API + WebSocket.\"\"\"\n    92→        if not service_lifecycle.is_available(\"companion\"):\n    93→            raise RuntimeError(\"Companion service is not available\")\n    94→\n    95→        status = service_lifecycle.get_status(\"companion\")\n    96→        port = status.get(\"port\", 3457)\n    97→        base_url = f\"http://127.0.0.1:{port}\"\n    98→\n    99→        client = ClaudeWSClient(base_url)\n   100→        backend_id = await client.create_session(model, cwd)\n   101→        await client.connect(backend_id)\n   102→\n   103→        self._claude_clients[session_id] = client\n   104→        self._session_map[session_id] = {\n   105→            \"provider\": \"claude\",\n   106→            \"backend_session_id\": backend_id,\n   107→            \"model\": model,\n   108→            \"cwd\": cwd,\n   109→        }\n   110→        return backend_id\n   111→\n   112→    async def _send_claude(self, session_id: str, prompt: str) -> AsyncGenerator[dict, None]:\n   113→        \"\"\"Send message via Claude WebSocket and yield events.\"\"\"\n   114→        client = self._claude_clients.get(session_id)\n   115→        if not client:\n   116→            yield {\"type\": \"error\", \"detail\": \"No Claude WebSocket client for session\"}\n   117→            return\n   118→\n   119→        try:\n   120→            async for event in client.send_message(prompt):\n   121→                yield event\n   122→        except Exception as e:\n   123→            log.error(\"Claude WebSocket error: %s\", e)\n   124→            yield {\"type\": \"error\", \"detail\": f\"Claude WebSocket error: {e}\"}\n   125→\n   126→    # --- OpenCode SSE ---\n   127→\n   128→    async def _create_opencode_session(self, model: str, session_id: str, cwd: str) -> str:\n   129→        \"\"\"Create an OpenCode session via REST API.\"\"\"\n   130→        if not service_lifecycle.is_available(\"opencode\"):\n   131→            raise RuntimeError(\"OpenCode service is not available\")\n   132→\n   133→        status = service_lifecycle.get_status(\"opencode\")\n   134→        port = status.get(\"port\", 4096)\n   135→        base_url = f\"http://127.0.0.1:{port}\"\n   136→\n   137→        client = OpenCodeClient.from_env(base_url)\n   138→        backend_id = await client.create_session(f\"Vista Chat {session_id}\")\n   139→\n   140→        self._opencode_clients[session_id] = client\n   141→        self._session_map[session_id] = {\n   142→            \"provider\": \"opencode\",\n   143→            \"backend_session_id\": backend_id,\n   144→            \"model\": model,\n   145→            \"cwd\": cwd,\n   146→        }\n   147→        return backend_id\n   148→\n   149→    async def _send_opencode(\n   150→        self, session_id: str, prompt: str, model: Optional[str] = None\n   151→    ) -> AsyncGenerator[dict, None]:\n   152→        \"\"\"Send message via OpenCode SSE and yield events.\"\"\"\n   153→        client = self._opencode_clients.get(session_id)\n   154→        mapping = self._session_map.get(session_id)\n   155→        if not client or not mapping:\n   156→            yield {\"type\": \"error\", \"detail\": \"No OpenCode client for session\"}\n   157→            return\n   158→\n   159→        backend_id = mapping[\"backend_session_id\"]\n   160→        try:\n   161→            async for event in client.send_message_streaming(backend_id, prompt):\n   162→                yield event\n   163→        except Exception as e:\n   164→            log.error(\"OpenCode SSE error: %s\", e)\n   165→            yield {\"type\": \"error\", \"detail\": f\"OpenCode SSE error: {e}\"}\n   166→\n   167→\n   168→# Singleton instance\n   169→provider_router = ProviderRouter()\n   170→"}]},"parent_tool_use_id":null,"session_id":"41eb5763-1813-40b4-994f-a8833bfca10e","uuid":"63e253eb-5e32-44f2-80f4-ea49ac5ff5e3","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/services/provider_router.py","content":"\"\"\"Provider router for architecture chat.\n\nRoutes chat messages to the correct backend (Claude WebSocket or OpenCode SSE)\nbased on the provider type. Manages session mapping between Vista and backend\nsession IDs.\n\"\"\"\n\nimport logging\nfrom collections.abc import AsyncGenerator\nfrom typing import Optional\n\nfrom server.services.service_lifecycle import service_lifecycle\nfrom server.services.claude_ws_client import ClaudeWSClient\nfrom server.services.opencode_client import OpenCodeClient\n\nlog = logging.getLogger(__name__)\n\n\nclass ProviderRouter:\n    \"\"\"Routes chat messages to the correct backend based on provider type.\"\"\"\n\n    def __init__(self):\n        self._claude_clients: dict[str, ClaudeWSClient] = {}  # session_id -> client\n        self._opencode_clients: dict[str, OpenCodeClient] = {}  # session_id -> client\n        # Vista session_id -> {provider, backend_session_id, model, cwd}\n        self._session_map: dict[str, dict] = {}\n\n    async def create_backend_session(\n        self, provider: str, model: str, session_id: str, cwd: str\n    ) -> str:\n        \"\"\"Create a backend session and return the backend session ID.\"\"\"\n        if provider == \"claude\":\n            return await self._create_claude_session(model, session_id, cwd)\n        elif provider == \"opencode\":\n            return await self._create_opencode_session(model, session_id, cwd)\n        else:\n            raise ValueError(f\"Unknown provider: {provider}\")\n\n    async def send_message(\n        self, provider: str, model: str, prompt: str,\n        session_id: str, cwd: str,\n    ) -> AsyncGenerator[dict, None]:\n        \"\"\"Yield streaming events: {type: \"token\"|\"done\"|\"error\", ...}.\"\"\"\n        # Ensure backend session exists\n        if session_id not in self._session_map:\n            try:\n                await self.create_backend_session(provider, model, session_id, cwd)\n            except Exception as e:\n                yield {\"type\": \"error\", \"detail\": f\"Failed to create backend session: {e}\"}\n                return\n\n        mapping = self._session_map[session_id]\n\n        if mapping[\"provider\"] == \"claude\":\n            async for event in self._send_claude(session_id, prompt):\n                yield event\n        elif mapping[\"provider\"] == \"opencode\":\n            async for event in self._send_opencode(session_id, prompt, model):\n                yield event\n        else:\n            yield {\"type\": \"error\", \"detail\": f\"Unknown provider: {mapping['provider']}\"}\n\n    async def cleanup_session(self, session_id: str) -> None:\n        \"\"\"Clean up backend session when Vista session is deleted.\"\"\"\n        mapping = self._session_map.pop(session_id, None)\n        if not mapping:\n            return\n\n        backend_id = mapping[\"backend_session_id\"]\n        provider = mapping[\"provider\"]\n\n        if provider == \"claude\":\n            client = self._claude_clients.pop(session_id, None)\n            if client:\n                await client.disconnect()\n                await client.delete_session(backend_id)\n        elif provider == \"opencode\":\n            client = self._opencode_clients.pop(session_id, None)\n            if client:\n                await client.abort_session(backend_id)\n                await client.delete_session(backend_id)\n\n    async def cleanup_all(self) -> None:\n        \"\"\"Clean up all backend sessions on shutdown.\"\"\"\n        for session_id in list(self._session_map.keys()):\n            await self.cleanup_session(session_id)\n\n    # --- Claude WebSocket ---\n\n    async def _create_claude_session(self, model: str, session_id: str, cwd: str) -> str:\n        \"\"\"Create a Claude session via Companion's HTTP API + WebSocket.\"\"\"\n        if not service_lifecycle.is_available(\"companion\"):\n            raise RuntimeError(\"Companion service is not available\")\n\n        status = service_lifecycle.get_status(\"companion\")\n        port = status.get(\"port\", 3457)\n        base_url = f\"http://127.0.0.1:{port}\"\n\n        client = ClaudeWSClient(base_url)\n        backend_id = await client.create_session(model, cwd)\n        await client.connect(backend_id)\n\n        self._claude_clients[session_id] = client\n        self._session_map[session_id] = {\n            \"provider\": \"claude\",\n            \"backend_session_id\": backend_id,\n            \"model\": model,\n            \"cwd\": cwd,\n        }\n        return backend_id\n\n    async def _send_claude(self, session_id: str, prompt: str) -> AsyncGenerator[dict, None]:\n        \"\"\"Send message via Claude WebSocket and yield events.\"\"\"\n        client = self._claude_clients.get(session_id)\n        if not client:\n            yield {\"type\": \"error\", \"detail\": \"No Claude WebSocket client for session\"}\n            return\n\n        try:\n            async for event in client.send_message(prompt):\n                yield event\n        except Exception as e:\n            log.error(\"Claude WebSocket error: %s\", e)\n            yield {\"type\": \"error\", \"detail\": f\"Claude WebSocket error: {e}\"}\n\n    # --- OpenCode SSE ---\n\n    async def _create_opencode_session(self, model: str, session_id: str, cwd: str) -> str:\n        \"\"\"Create an OpenCode session via REST API.\"\"\"\n        if not service_lifecycle.is_available(\"opencode\"):\n            raise RuntimeError(\"OpenCode service is not available\")\n\n        status = service_lifecycle.get_status(\"opencode\")\n        port = status.get(\"port\", 4096)\n        base_url = f\"http://127.0.0.1:{port}\"\n\n        client = OpenCodeClient.from_env(base_url)\n        backend_id = await client.create_session(f\"Vista Chat {session_id}\")\n\n        self._opencode_clients[session_id] = client\n        self._session_map[session_id] = {\n            \"provider\": \"opencode\",\n            \"backend_session_id\": backend_id,\n            \"model\": model,\n            \"cwd\": cwd,\n        }\n        return backend_id\n\n    async def _send_opencode(\n        self, session_id: str, prompt: str, model: Optional[str] = None\n    ) -> AsyncGenerator[dict, None]:\n        \"\"\"Send message via OpenCode SSE and yield events.\"\"\"\n        client = self._opencode_clients.get(session_id)\n        mapping = self._session_map.get(session_id)\n        if not client or not mapping:\n            yield {\"type\": \"error\", \"detail\": \"No OpenCode client for session\"}\n            return\n\n        backend_id = mapping[\"backend_session_id\"]\n        try:\n            async for event in client.send_message_streaming(backend_id, prompt):\n                yield event\n        except Exception as e:\n            log.error(\"OpenCode SSE error: %s\", e)\n            yield {\"type\": \"error\", \"detail\": f\"OpenCode SSE error: {e}\"}\n\n\n# Singleton instance\nprovider_router = ProviderRouter()\n","numLines":170,"startLine":1,"totalLines":170}}}
