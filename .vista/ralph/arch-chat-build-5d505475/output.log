{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013YcHM9m6zXZj44mKgPqwqd","type":"tool_result","content":"     1→\"\"\"Chat service for AI diagram review via CLI providers.\n     2→\n     3→Provides both blocking and streaming invocation of CLI providers,\n     4→delegating command construction and output parsing to the Provider interface.\n     5→\"\"\"\n     6→\n     7→import asyncio\n     8→import subprocess\n     9→import threading\n    10→from collections.abc import AsyncGenerator\n    11→from typing import Optional\n    12→\n    13→from server.services.provider_service import (\n    14→    get_provider_by_name,\n    15→    _find_command,\n    16→    _IS_WINDOWS,\n    17→    Provider,\n    18→)\n    19→\n    20→\n    21→def _kill_proc(proc: subprocess.Popen) -> None:\n    22→    \"\"\"Kill a subprocess and its tree (Windows-safe).\"\"\"\n    23→    try:\n    24→        if _IS_WINDOWS:\n    25→            subprocess.run(\n    26→                [\"taskkill\", \"/T\", \"/F\", \"/PID\", str(proc.pid)],\n    27→                capture_output=True,\n    28→                timeout=5,\n    29→            )\n    30→        else:\n    31→            proc.kill()\n    32→        proc.wait(timeout=5)\n    33→    except Exception:\n    34→        pass\n    35→\n    36→\n    37→class ChatService:\n    38→    \"\"\"Service for handling chat interactions with AI providers.\"\"\"\n    39→\n    40→    def __init__(self):\n    41→        self._active_proc: subprocess.Popen | None = None\n    42→        self._lock = threading.Lock()\n    43→\n    44→    def cancel(self) -> bool:\n    45→        \"\"\"Cancel the currently running chat subprocess, if any.\"\"\"\n    46→        with self._lock:\n    47→            proc = self._active_proc\n    48→            if proc is None:\n    49→                return False\n    50→            _kill_proc(proc)\n    51→            self._active_proc = None\n    52→            return True\n    53→\n    54→    @staticmethod\n    55→    def build_prompt(\n    56→        message: str,\n    57→        context: Optional[str] = None,\n    58→        history: Optional[list[dict]] = None,\n    59→        arch_dir: Optional[str] = None,\n    60→        project_root: Optional[str] = None,\n    61→    ) -> str:\n    62→        \"\"\"Build a complete prompt from context, history, and user message.\"\"\"\n    63→        parts = []\n    64→\n    65→        if arch_dir and project_root:\n    66→            parts.append(\n    67→                \"You are an architecture documentation assistant.\\n\"\n    68→                f\"You can read files anywhere in the project for context: {project_root}\\n\"\n    69→                f\"You ONLY edit .mmd diagram files in the arch directory: {arch_dir}\\n\"\n    70→                \"Do NOT edit source code or any files outside the arch directory.\\n\"\n    71→                \"When asked to modify diagrams, edit the .mmd files directly.\\n\"\n    72→                \"Provide clear, concise feedback on the provided diagrams.\\n\"\n    73→                \"When discussing diagrams, be specific and reference node names and connections.\"\n    74→            )\n    75→        else:\n    76→            parts.append(\n    77→                \"You are an expert software architect reviewing architecture diagrams. \"\n    78→                \"Provide clear, concise feedback on the provided diagrams. \"\n    79→                \"When discussing code or diagrams, be specific and reference relevant parts.\"\n    80→            )\n    81→        parts.append(\"\")\n    82→\n    83→        if context:\n    84→            parts.append(\"--- DIAGRAM CONTEXT ---\")\n    85→            parts.append(context)\n    86→            parts.append(\"--- END CONTEXT ---\")\n    87→            parts.append(\"\")\n    88→\n    89→        if history:\n    90→            parts.append(\"--- CONVERSATION HISTORY ---\")\n    91→            for msg in history:\n    92→                role = msg.get(\"role\", \"user\")\n    93→                content = msg.get(\"content\", \"\")\n    94→                parts.append(f\"{role.upper()}: {content}\")\n    95→            parts.append(\"--- END HISTORY ---\")\n    96→            parts.append(\"\")\n    97→\n    98→        parts.append(f\"USER: {message}\")\n    99→        parts.append(\"\")\n   100→        parts.append(\"ASSISTANT:\")\n   101→\n   102→        return \"\\n\".join(parts)\n   103→\n   104→    def invoke_provider(\n   105→        self,\n   106→        provider_name: str,\n   107→        model: str,\n   108→        prompt: str,\n   109→        timeout: int = 90,\n   110→    ) -> tuple[bool, str]:\n   111→        \"\"\"Invoke a CLI provider with the given prompt (blocking).\n   112→\n   113→        This method is blocking and should be called via asyncio.to_thread().\n   114→        \"\"\"\n   115→        provider = get_provider_by_name(provider_name)\n   116→        if provider is None:\n   117→            return False, f\"Provider '{provider_name}' not found or not enabled\"\n   118→\n   119→        cmd = provider.get_chat_cmd(model, streaming=False, permissions=True)\n   120→        if cmd is None:\n   121→            cmd_path = _find_command(provider_name)\n   122→            if cmd_path is None:\n   123→                return False, f\"CLI command '{provider_name}' not found in PATH\"\n   124→            if provider_name == \"claude\":\n   125→                cmd = [cmd_path, \"-p\", \"--model\", model]\n   126→            elif provider_name == \"opencode\":\n   127→                cmd = [cmd_path, \"run\", \"--model\", model, prompt]\n   128→            else:\n   129→                return False, f\"Unknown provider: {provider_name}\"\n   130→\n   131→        kwargs: dict = dict(\n   132→            stdout=subprocess.PIPE,\n   133→            stderr=subprocess.PIPE,\n   134→            text=True,\n   135→            encoding=\"utf-8\",\n   136→            errors=\"replace\",\n   137→        )\n   138→\n   139→        if provider.stdin_pipe:\n   140→            kwargs[\"stdin\"] = subprocess.PIPE\n   141→        else:\n   142→            cmd = list(cmd) + [prompt]\n   143→            kwargs[\"stdin\"] = subprocess.DEVNULL\n   144→\n   145→        if _IS_WINDOWS:\n   146→            kwargs[\"creationflags\"] = subprocess.CREATE_NO_WINDOW\n   147→            if cmd[0].endswith((\".cmd\", \".bat\")):\n   148→                cmd = [\"cmd.exe\", \"/c\"] + cmd\n   149→\n   150→        proc = subprocess.Popen(cmd, **kwargs)\n   151→        with self._lock:\n   152→            self._active_proc = proc\n   153→\n   154→        try:\n   155→            if provider.stdin_pipe:\n   156→                stdout, stderr = proc.communicate(input=prompt, timeout=timeout)\n   157→            else:\n   158→                stdout, stderr = proc.communicate(timeout=timeout)\n   159→        except subprocess.TimeoutExpired:\n   160→            _kill_proc(proc)\n   161→            return False, f\"Request timed out after {timeout} seconds\"\n   162→        finally:\n   163→            with self._lock:\n   164→                self._active_proc = None\n   165→\n   166→        if proc.returncode != 0:\n   167→            error_msg = stderr.strip() if stderr else \"Unknown error\"\n   168→            if proc.returncode in (-9, 1) and not error_msg:\n   169→                return False, \"Request was cancelled\"\n   170→            return False, f\"CLI error (code {proc.returncode}): {error_msg}\"\n   171→\n   172→        return True, (stdout or \"\").strip()\n   173→\n   174→    async def invoke_provider_streaming(\n   175→        self,\n   176→        provider_name: str,\n   177→        model: str,\n   178→        prompt: str,\n   179→        cwd: Optional[str] = None,\n   180→    ) -> AsyncGenerator[dict, None]:\n   181→        \"\"\"Invoke a CLI provider and yield streaming events.\n   182→\n   183→        Yields dicts with \"type\" key: \"token\", \"done\", \"result\", or \"error\".\n   184→        For non-streaming providers, yields one \"token\" + \"done\" after completion.\n   185→        \"\"\"\n   186→        provider = get_provider_by_name(provider_name)\n   187→        if provider is None:\n   188→            yield {\"type\": \"error\", \"detail\": f\"Provider '{provider_name}' not found or not enabled\"}\n   189→            return\n   190→\n   191→        use_streaming = provider.supports_streaming\n   192→\n   193→        cmd = provider.get_chat_cmd(\n   194→            model,\n   195→            streaming=use_streaming,\n   196→            permissions=True,\n   197→        )\n   198→        if cmd is None:\n   199→            yield {\"type\": \"error\", \"detail\": f\"CLI command for '{provider_name}' not found in PATH\"}\n   200→            return\n   201→\n   202→        # Build subprocess kwargs\n   203→        kwargs: dict = dict(\n   204→            text=True,\n   205→            encoding=\"utf-8\",\n   206→            errors=\"replace\",\n   207→            bufsize=1,  # Line-buffered for streaming\n   208→        )\n   209→\n   210→        if provider.stdin_pipe:\n   211→            kwargs[\"stdin\"] = subprocess.PIPE\n   212→        else:\n   213→            cmd = list(cmd) + [prompt]\n   214→            kwargs[\"stdin\"] = subprocess.DEVNULL\n   215→\n   216→        if use_streaming:\n   217→            # Merge stderr into stdout so verbose output doesn't deadlock the pipe.\n   218→            # Non-JSON lines (verbose/error) are collected separately.\n   219→            kwargs[\"stdout\"] = subprocess.PIPE\n   220→            kwargs[\"stderr\"] = subprocess.STDOUT\n   221→        else:\n   222→            kwargs[\"stdout\"] = subprocess.PIPE\n   223→            kwargs[\"stderr\"] = subprocess.PIPE\n   224→\n   225→        if cwd:\n   226→            kwargs[\"cwd\"] = cwd\n   227→        if _IS_WINDOWS:\n   228→            kwargs[\"creationflags\"] = subprocess.CREATE_NO_WINDOW\n   229→            if cmd[0].endswith((\".cmd\", \".bat\")):\n   230→                cmd = [\"cmd.exe\", \"/c\"] + cmd\n   231→\n   232→        proc = subprocess.Popen(cmd, **kwargs)\n   233→\n   234→        # Write prompt to stdin and close it\n   235→        if provider.stdin_pipe:\n   236→            try:\n   237→                proc.stdin.write(prompt)\n   238→                proc.stdin.flush()\n   239→                proc.stdin.close()\n   240→            except Exception as e:\n   241→                yield {\"type\": \"error\", \"detail\": f\"Failed to write prompt to stdin: {e}\"}\n   242→                return\n   243→\n   244→        with self._lock:\n   245→            self._active_proc = proc\n   246→\n   247→        try:\n   248→            if use_streaming:\n   249→                loop = asyncio.get_running_loop()\n   250→                full_text: list[str] = []\n   251→                non_json_lines: list[str] = []\n   252→\n   253→                while True:\n   254→                    line = await loop.run_in_executor(None, proc.stdout.readline)\n   255→                    if not line:\n   256→                        break\n   257→                    line = line.rstrip(\"\\n\\r\")\n   258→                    if not line:\n   259→                        continue\n   260→\n   261→                    event = provider.parse_stream_event(line)\n   262→                    if event is not None:\n   263→                        if event[\"type\"] == \"token\":\n   264→                            full_text.append(event[\"text\"])\n   265→                        yield event\n   266→                    else:\n   267→                        # Non-JSON line (verbose output, errors, etc.)\n   268→                        non_json_lines.append(line)\n   269→\n   270→                await loop.run_in_executor(None, proc.wait)\n   271→\n   272→                if proc.returncode != 0:\n   273→                    context = \"\\n\".join(non_json_lines[-10:]) if non_json_lines else \"(no output)\"\n   274→                    yield {\"type\": \"error\", \"detail\": f\"CLI error (code {proc.returncode}):\\n{context}\"}\n   275→                else:\n   276→                    yield {\"type\": \"done\", \"content\": \"\".join(full_text)}\n   277→            else:\n   278→                # Non-streaming fallback: collect all output then yield at once\n   279→                loop = asyncio.get_running_loop()\n   280→                if provider.stdin_pipe:\n   281→                    stdout, stderr = await loop.run_in_executor(None, proc.communicate)\n   282→                else:\n   283→                    stdout, stderr = await loop.run_in_executor(None, proc.communicate)\n   284→\n   285→                if proc.returncode != 0:\n   286→                    error_msg = (stderr or \"\").strip() if stderr else \"(no stderr)\"\n   287→                    yield {\"type\": \"error\", \"detail\": f\"CLI error (code {proc.returncode}): {error_msg}\"}\n   288→                    return\n   289→\n   290→                response = (stdout or \"\").strip()\n   291→                yield {\"type\": \"token\", \"text\": response}\n   292→                yield {\"type\": \"done\", \"content\": response}\n   293→\n   294→        except asyncio.CancelledError:\n   295→            self.cancel()\n   296→        except Exception as e:\n   297→            yield {\"type\": \"error\", \"detail\": f\"Failed to invoke provider: {e}\"}\n   298→        finally:\n   299→            with self._lock:\n   300→                self._active_proc = None\n   301→\n   302→\n   303→# Singleton instance\n   304→chat_service = ChatService()\n   305→"}]},"parent_tool_use_id":null,"session_id":"fe920b97-a686-4daa-9f39-67e009025eb9","uuid":"464f750c-3ea8-4488-82de-03aa653518a8","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/services/chat_service.py","content":"\"\"\"Chat service for AI diagram review via CLI providers.\n\nProvides both blocking and streaming invocation of CLI providers,\ndelegating command construction and output parsing to the Provider interface.\n\"\"\"\n\nimport asyncio\nimport subprocess\nimport threading\nfrom collections.abc import AsyncGenerator\nfrom typing import Optional\n\nfrom server.services.provider_service import (\n    get_provider_by_name,\n    _find_command,\n    _IS_WINDOWS,\n    Provider,\n)\n\n\ndef _kill_proc(proc: subprocess.Popen) -> None:\n    \"\"\"Kill a subprocess and its tree (Windows-safe).\"\"\"\n    try:\n        if _IS_WINDOWS:\n            subprocess.run(\n                [\"taskkill\", \"/T\", \"/F\", \"/PID\", str(proc.pid)],\n                capture_output=True,\n                timeout=5,\n            )\n        else:\n            proc.kill()\n        proc.wait(timeout=5)\n    except Exception:\n        pass\n\n\nclass ChatService:\n    \"\"\"Service for handling chat interactions with AI providers.\"\"\"\n\n    def __init__(self):\n        self._active_proc: subprocess.Popen | None = None\n        self._lock = threading.Lock()\n\n    def cancel(self) -> bool:\n        \"\"\"Cancel the currently running chat subprocess, if any.\"\"\"\n        with self._lock:\n            proc = self._active_proc\n            if proc is None:\n                return False\n            _kill_proc(proc)\n            self._active_proc = None\n            return True\n\n    @staticmethod\n    def build_prompt(\n        message: str,\n        context: Optional[str] = None,\n        history: Optional[list[dict]] = None,\n        arch_dir: Optional[str] = None,\n        project_root: Optional[str] = None,\n    ) -> str:\n        \"\"\"Build a complete prompt from context, history, and user message.\"\"\"\n        parts = []\n\n        if arch_dir and project_root:\n            parts.append(\n                \"You are an architecture documentation assistant.\\n\"\n                f\"You can read files anywhere in the project for context: {project_root}\\n\"\n                f\"You ONLY edit .mmd diagram files in the arch directory: {arch_dir}\\n\"\n                \"Do NOT edit source code or any files outside the arch directory.\\n\"\n                \"When asked to modify diagrams, edit the .mmd files directly.\\n\"\n                \"Provide clear, concise feedback on the provided diagrams.\\n\"\n                \"When discussing diagrams, be specific and reference node names and connections.\"\n            )\n        else:\n            parts.append(\n                \"You are an expert software architect reviewing architecture diagrams. \"\n                \"Provide clear, concise feedback on the provided diagrams. \"\n                \"When discussing code or diagrams, be specific and reference relevant parts.\"\n            )\n        parts.append(\"\")\n\n        if context:\n            parts.append(\"--- DIAGRAM CONTEXT ---\")\n            parts.append(context)\n            parts.append(\"--- END CONTEXT ---\")\n            parts.append(\"\")\n\n        if history:\n            parts.append(\"--- CONVERSATION HISTORY ---\")\n            for msg in history:\n                role = msg.get(\"role\", \"user\")\n                content = msg.get(\"content\", \"\")\n                parts.append(f\"{role.upper()}: {content}\")\n            parts.append(\"--- END HISTORY ---\")\n            parts.append(\"\")\n\n        parts.append(f\"USER: {message}\")\n        parts.append(\"\")\n        parts.append(\"ASSISTANT:\")\n\n        return \"\\n\".join(parts)\n\n    def invoke_provider(\n        self,\n        provider_name: str,\n        model: str,\n        prompt: str,\n        timeout: int = 90,\n    ) -> tuple[bool, str]:\n        \"\"\"Invoke a CLI provider with the given prompt (blocking).\n\n        This method is blocking and should be called via asyncio.to_thread().\n        \"\"\"\n        provider = get_provider_by_name(provider_name)\n        if provider is None:\n            return False, f\"Provider '{provider_name}' not found or not enabled\"\n\n        cmd = provider.get_chat_cmd(model, streaming=False, permissions=True)\n        if cmd is None:\n            cmd_path = _find_command(provider_name)\n            if cmd_path is None:\n                return False, f\"CLI command '{provider_name}' not found in PATH\"\n            if provider_name == \"claude\":\n                cmd = [cmd_path, \"-p\", \"--model\", model]\n            elif provider_name == \"opencode\":\n                cmd = [cmd_path, \"run\", \"--model\", model, prompt]\n            else:\n                return False, f\"Unknown provider: {provider_name}\"\n\n        kwargs: dict = dict(\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            text=True,\n            encoding=\"utf-8\",\n            errors=\"replace\",\n        )\n\n        if provider.stdin_pipe:\n            kwargs[\"stdin\"] = subprocess.PIPE\n        else:\n            cmd = list(cmd) + [prompt]\n            kwargs[\"stdin\"] = subprocess.DEVNULL\n\n        if _IS_WINDOWS:\n            kwargs[\"creationflags\"] = subprocess.CREATE_NO_WINDOW\n            if cmd[0].endswith((\".cmd\", \".bat\")):\n                cmd = [\"cmd.exe\", \"/c\"] + cmd\n\n        proc = subprocess.Popen(cmd, **kwargs)\n        with self._lock:\n            self._active_proc = proc\n\n        try:\n            if provider.stdin_pipe:\n                stdout, stderr = proc.communicate(input=prompt, timeout=timeout)\n            else:\n                stdout, stderr = proc.communicate(timeout=timeout)\n        except subprocess.TimeoutExpired:\n            _kill_proc(proc)\n            return False, f\"Request timed out after {timeout} seconds\"\n        finally:\n            with self._lock:\n                self._active_proc = None\n\n        if proc.returncode != 0:\n            error_msg = stderr.strip() if stderr else \"Unknown error\"\n            if proc.returncode in (-9, 1) and not error_msg:\n                return False, \"Request was cancelled\"\n            return False, f\"CLI error (code {proc.returncode}): {error_msg}\"\n\n        return True, (stdout or \"\").strip()\n\n    async def invoke_provider_streaming(\n        self,\n        provider_name: str,\n        model: str,\n        prompt: str,\n        cwd: Optional[str] = None,\n    ) -> AsyncGenerator[dict, None]:\n        \"\"\"Invoke a CLI provider and yield streaming events.\n\n        Yields dicts with \"type\" key: \"token\", \"done\", \"result\", or \"error\".\n        For non-streaming providers, yields one \"token\" + \"done\" after completion.\n        \"\"\"\n        provider = get_provider_by_name(provider_name)\n        if provider is None:\n            yield {\"type\": \"error\", \"detail\": f\"Provider '{provider_name}' not found or not enabled\"}\n            return\n\n        use_streaming = provider.supports_streaming\n\n        cmd = provider.get_chat_cmd(\n            model,\n            streaming=use_streaming,\n            permissions=True,\n        )\n        if cmd is None:\n            yield {\"type\": \"error\", \"detail\": f\"CLI command for '{provider_name}' not found in PATH\"}\n            return\n\n        # Build subprocess kwargs\n        kwargs: dict = dict(\n            text=True,\n            encoding=\"utf-8\",\n            errors=\"replace\",\n            bufsize=1,  # Line-buffered for streaming\n        )\n\n        if provider.stdin_pipe:\n            kwargs[\"stdin\"] = subprocess.PIPE\n        else:\n            cmd = list(cmd) + [prompt]\n            kwargs[\"stdin\"] = subprocess.DEVNULL\n\n        if use_streaming:\n            # Merge stderr into stdout so verbose output doesn't deadlock the pipe.\n            # Non-JSON lines (verbose/error) are collected separately.\n            kwargs[\"stdout\"] = subprocess.PIPE\n            kwargs[\"stderr\"] = subprocess.STDOUT\n        else:\n            kwargs[\"stdout\"] = subprocess.PIPE\n            kwargs[\"stderr\"] = subprocess.PIPE\n\n        if cwd:\n            kwargs[\"cwd\"] = cwd\n        if _IS_WINDOWS:\n            kwargs[\"creationflags\"] = subprocess.CREATE_NO_WINDOW\n            if cmd[0].endswith((\".cmd\", \".bat\")):\n                cmd = [\"cmd.exe\", \"/c\"] + cmd\n\n        proc = subprocess.Popen(cmd, **kwargs)\n\n        # Write prompt to stdin and close it\n        if provider.stdin_pipe:\n            try:\n                proc.stdin.write(prompt)\n                proc.stdin.flush()\n                proc.stdin.close()\n            except Exception as e:\n                yield {\"type\": \"error\", \"detail\": f\"Failed to write prompt to stdin: {e}\"}\n                return\n\n        with self._lock:\n            self._active_proc = proc\n\n        try:\n            if use_streaming:\n                loop = asyncio.get_running_loop()\n                full_text: list[str] = []\n                non_json_lines: list[str] = []\n\n                while True:\n                    line = await loop.run_in_executor(None, proc.stdout.readline)\n                    if not line:\n                        break\n                    line = line.rstrip(\"\\n\\r\")\n                    if not line:\n                        continue\n\n                    event = provider.parse_stream_event(line)\n                    if event is not None:\n                        if event[\"type\"] == \"token\":\n                            full_text.append(event[\"text\"])\n                        yield event\n                    else:\n                        # Non-JSON line (verbose output, errors, etc.)\n                        non_json_lines.append(line)\n\n                await loop.run_in_executor(None, proc.wait)\n\n                if proc.returncode != 0:\n                    context = \"\\n\".join(non_json_lines[-10:]) if non_json_lines else \"(no output)\"\n                    yield {\"type\": \"error\", \"detail\": f\"CLI error (code {proc.returncode}):\\n{context}\"}\n                else:\n                    yield {\"type\": \"done\", \"content\": \"\".join(full_text)}\n            else:\n                # Non-streaming fallback: collect all output then yield at once\n                loop = asyncio.get_running_loop()\n                if provider.stdin_pipe:\n                    stdout, stderr = await loop.run_in_executor(None, proc.communicate)\n                else:\n                    stdout, stderr = await loop.run_in_executor(None, proc.communicate)\n\n                if proc.returncode != 0:\n                    error_msg = (stderr or \"\").strip() if stderr else \"(no stderr)\"\n                    yield {\"type\": \"error\", \"detail\": f\"CLI error (code {proc.returncode}): {error_msg}\"}\n                    return\n\n                response = (stdout or \"\").strip()\n                yield {\"type\": \"token\", \"text\": response}\n                yield {\"type\": \"done\", \"content\": response}\n\n        except asyncio.CancelledError:\n            self.cancel()\n        except Exception as e:\n            yield {\"type\": \"error\", \"detail\": f\"Failed to invoke provider: {e}\"}\n        finally:\n            with self._lock:\n                self._active_proc = None\n\n\n# Singleton instance\nchat_service = ChatService()\n","numLines":305,"startLine":1,"totalLines":305}}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_019NYJqLxm55SYcRMmYNLppz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018JuBx13J375qhV7buqoY9d","name":"Read","input":{"file_path":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/routes/chat_sessions.py"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":9605,"cache_read_input_tokens":70877,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9605},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"fe920b97-a686-4daa-9f39-67e009025eb9","uuid":"b2d889cf-d7c7-4285-acbe-371641de8cf3"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018JuBx13J375qhV7buqoY9d","type":"tool_result","content":"     1→\"\"\"Chat session API routes with SSE streaming and live diagram updates.\"\"\"\n     2→\n     3→import asyncio\n     4→import json\n     5→import logging\n     6→from pathlib import Path\n     7→from typing import Optional\n     8→\n     9→from fastapi import APIRouter, HTTPException, Request\n    10→from pydantic import BaseModel, Field\n    11→from sse_starlette.sse import EventSourceResponse\n    12→\n    13→from server.services.project_service import ProjectService\n    14→from server.services.chat_session_service import ChatSessionService\n    15→from server.services.chat_service import chat_service\n    16→from server.services.keepalive_manager import keepalive_manager\n    17→from server.services.diagram_watcher import diagram_watcher\n    18→\n    19→log = logging.getLogger(__name__)\n    20→router = APIRouter(tags=[\"chat_sessions\"])\n    21→\n    22→# Per-session SSE subscriber queues\n    23→_session_subscribers: dict[str, list[asyncio.Queue]] = {}\n    24→\n    25→\n    26→def _subscribe(session_id: str) -> asyncio.Queue:\n    27→    if session_id not in _session_subscribers:\n    28→        _session_subscribers[session_id] = []\n    29→    queue: asyncio.Queue = asyncio.Queue(maxsize=500)\n    30→    _session_subscribers[session_id].append(queue)\n    31→    return queue\n    32→\n    33→\n    34→def _unsubscribe(session_id: str, queue: asyncio.Queue) -> None:\n    35→    if session_id in _session_subscribers:\n    36→        _session_subscribers[session_id] = [\n    37→            q for q in _session_subscribers[session_id] if q is not queue\n    38→        ]\n    39→        if not _session_subscribers[session_id]:\n    40→            del _session_subscribers[session_id]\n    41→\n    42→\n    43→async def _broadcast(session_id: str, message: dict) -> None:\n    44→    if session_id not in _session_subscribers:\n    45→        return\n    46→    dead = []\n    47→    for queue in _session_subscribers[session_id]:\n    48→        try:\n    49→            queue.put_nowait(message)\n    50→        except asyncio.QueueFull:\n    51→            dead.append(queue)\n    52→    for q in dead:\n    53→        if session_id in _session_subscribers:\n    54→            _session_subscribers[session_id].remove(q)\n    55→\n    56→\n    57→# ---------------------------------------------------------------------------\n    58→# Request / response models\n    59→# ---------------------------------------------------------------------------\n    60→\n    61→class CreateSessionRequest(BaseModel):\n    62→    feature_name: str\n    63→    provider: str\n    64→    model: str\n    65→    name: str = \"\"\n    66→    mode: str = Field(\"oneshot\", description=\"'oneshot' or 'persistent'\")\n    67→\n    68→\n    69→class SendMessageRequest(BaseModel):\n    70→    message: str\n    71→    context: Optional[str] = Field(None, description=\"Pre-assembled diagram context\")\n    72→    provider: Optional[str] = Field(None, description=\"Provider to use (overrides session default)\")\n    73→    model: Optional[str] = Field(None, description=\"Model to use (overrides session default)\")\n    74→    mode: str = Field(\"oneshot\", description=\"'oneshot' or 'persistent'\")\n    75→\n    76→\n    77→class RenameSessionRequest(BaseModel):\n    78→    name: str\n    79→\n    80→\n    81→# ---------------------------------------------------------------------------\n    82→# Session CRUD\n    83→# ---------------------------------------------------------------------------\n    84→\n    85→@router.get(\"/api/projects/{project_id}/chat/sessions\")\n    86→async def list_sessions(project_id: str, feature: Optional[str] = None):\n    87→    project = ProjectService.get_by_id(project_id)\n    88→    if not project:\n    89→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    90→    return ChatSessionService.list_sessions(project_id, feature)\n    91→\n    92→\n    93→@router.post(\"/api/projects/{project_id}/chat/sessions\")\n    94→async def create_session(project_id: str, body: CreateSessionRequest):\n    95→    project = ProjectService.get_by_id(project_id)\n    96→    if not project:\n    97→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    98→\n    99→    session = ChatSessionService.create(\n   100→        project_id=project_id,\n   101→        feature_name=body.feature_name,\n   102→        provider=body.provider,\n   103→        model=body.model,\n   104→        name=body.name,\n   105→    )\n   106→\n   107→    # For persistent mode, spawn the agent immediately\n   108→    if body.mode == \"persistent\":\n   109→        arch_dir = str(\n   110→            Path(project.path) / \".vista\" / \"features\" / body.feature_name / \"arch\"\n   111→        )\n   112→        system_prompt = chat_service.build_prompt(\n   113→            message=\"(session started — awaiting first message)\",\n   114→            context=None,\n   115→            history=None,\n   116→            arch_dir=arch_dir,\n   117→            project_root=project.path,\n   118→        )\n   119→        try:\n   120→            team_name = keepalive_manager.start(\n   121→                session_id=session.id,\n   122→                provider=body.provider,\n   123→                model=body.model,\n   124→                system_prompt=system_prompt,\n   125→                cwd=project.path,\n   126→            )\n   127→            session.team_name = team_name\n   128→            ChatSessionService.save(session)\n   129→        except Exception as e:\n   130→            log.error(\"Failed to start keep-alive agent: %s\", e, exc_info=True)\n   131→            # Session is still usable in oneshot mode\n   132→\n   133→    return session.to_dict()\n   134→\n   135→\n   136→@router.get(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\n   137→async def get_session(project_id: str, session_id: str):\n   138→    session = ChatSessionService.get(project_id, session_id)\n   139→    if not session:\n   140→        raise HTTPException(status_code=404, detail=\"Session not found\")\n   141→    return session.to_dict()\n   142→\n   143→\n   144→@router.delete(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\n   145→async def delete_session(project_id: str, session_id: str):\n   146→    session = ChatSessionService.get(project_id, session_id)\n   147→    if session and session.team_name:\n   148→        keepalive_manager.stop()\n   149→    deleted = ChatSessionService.delete(project_id, session_id)\n   150→    if not deleted:\n   151→        raise HTTPException(status_code=404, detail=\"Session not found\")\n   152→    return {\"deleted\": True}\n   153→\n   154→\n   155→@router.patch(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\n   156→async def rename_session(project_id: str, session_id: str, body: RenameSessionRequest):\n   157→    session = ChatSessionService.update_name(project_id, session_id, body.name)\n   158→    if not session:\n   159→        raise HTTPException(status_code=404, detail=\"Session not found\")\n   160→    return session.to_summary_dict()\n   161→\n   162→\n   163→# ---------------------------------------------------------------------------\n   164→# Send message (triggers streaming via SSE)\n   165→# ---------------------------------------------------------------------------\n   166→\n   167→@router.post(\"/api/projects/{project_id}/chat/sessions/{session_id}/messages\")\n   168→async def send_message(project_id: str, session_id: str, body: SendMessageRequest):\n   169→    \"\"\"Send a user message. Streams the response via the session's SSE endpoint.\"\"\"\n   170→    project = ProjectService.get_by_id(project_id)\n   171→    if not project:\n   172→        raise HTTPException(status_code=404, detail=\"Project not found\")\n   173→\n   174→    session = ChatSessionService.get(project_id, session_id)\n   175→    if not session:\n   176→        raise HTTPException(status_code=404, detail=\"Session not found\")\n   177→\n   178→    if not body.message.strip():\n   179→        raise HTTPException(status_code=400, detail=\"Message is required\")\n   180→\n   181→    # Use provider/model from request, fall back to session defaults\n   182→    provider_name = body.provider or session.provider\n   183→    model_name = body.model or session.model\n   184→\n   185→    # Update session defaults if the user changed provider/model\n   186→    if provider_name != session.provider or model_name != session.model:\n   187→        session.provider = provider_name\n   188→        session.model = model_name\n   189→        ChatSessionService.save(session)\n   190→\n   191→    # Save user message\n   192→    session = ChatSessionService.add_message(project_id, session_id, \"user\", body.message)\n   193→\n   194→    arch_dir = str(\n   195→        Path(project.path) / \".vista\" / \"features\" / session.feature_name / \"arch\"\n   196→    )\n   197→\n   198→    use_persistent = body.mode == \"persistent\"\n   199→\n   200→    if use_persistent:\n   201→        # Persistent mode via keepalive_manager (tmux + inbox messaging)\n   202→        agent_alive = keepalive_manager.is_alive(session_id)\n   203→\n   204→        # Try to resume if we have a team_name but manager doesn't know about it\n   205→        if not agent_alive and session.team_name:\n   206→            agent_alive = keepalive_manager.resume(session_id, session.team_name)\n   207→\n   208→        if not agent_alive:\n   209→            # Cold start — spawn a new agent with full history\n   210→            all_msgs = [{\"role\": m.role, \"content\": m.content} for m in session.messages]\n   211→            history = all_msgs[:-1] if len(all_msgs) > 1 else None\n   212→            system_prompt = chat_service.build_prompt(\n   213→                message=body.message,\n   214→                context=body.context,\n   215→                history=history,\n   216→                arch_dir=arch_dir,\n   217→                project_root=project.path,\n   218→            )\n   219→            try:\n   220→                team_name = keepalive_manager.start(\n   221→                    session_id=session_id,\n   222→                    provider=provider_name,\n   223→                    model=model_name,\n   224→                    system_prompt=system_prompt,\n   225→                    cwd=project.path,\n   226→                )\n   227→                session.team_name = team_name\n   228→                ChatSessionService.save(session)\n   229→            except Exception as e:\n   230→                await _broadcast(session_id, {\n   231→                    \"event\": \"chat_error\",\n   232→                    \"data\": {\"detail\": f\"Failed to start agent: {e}\"},\n   233→                })\n   234→                return {\"status\": \"error\", \"session_id\": session_id, \"mode\": body.mode}\n   235→        else:\n   236→            # Agent is alive — send just the user message (agent has context)\n   237→            keepalive_manager.send_message(session_id, body.message, context=body.context)\n   238→\n   239→        asyncio.create_task(\n   240→            _stream_response_keepalive(project_id, session_id)\n   241→        )\n   242→    else:\n   243→        # One-shot mode: full history replay each time\n   244→        all_msgs = [{\"role\": m.role, \"content\": m.content} for m in session.messages]\n   245→        history = all_msgs[:-1] if len(all_msgs) > 1 else None\n   246→        prompt = chat_service.build_prompt(\n   247→            message=body.message,\n   248→            context=body.context,\n   249→            history=history,\n   250→            arch_dir=arch_dir,\n   251→            project_root=project.path,\n   252→        )\n   253→        asyncio.create_task(\n   254→            _stream_response(project_id, session_id, provider_name, model_name, prompt, project.path)\n   255→        )\n   256→\n   257→    return {\"status\": \"streaming\", \"session_id\": session_id, \"mode\": body.mode}\n   258→\n   259→\n   260→async def _stream_response(\n   261→    project_id: str,\n   262→    session_id: str,\n   263→    provider_name: str,\n   264→    model: str,\n   265→    prompt: str,\n   266→    project_path: str,\n   267→) -> None:\n   268→    \"\"\"Background task that streams CLI response and pushes events to SSE subscribers.\"\"\"\n   269→    full_text: list[str] = []\n   270→\n   271→    try:\n   272→        async for event in chat_service.invoke_provider_streaming(\n   273→            provider_name=provider_name,\n   274→            model=model,\n   275→            prompt=prompt,\n   276→            cwd=project_path,\n   277→        ):\n   278→            if event[\"type\"] == \"token\":\n   279→                full_text.append(event[\"text\"])\n   280→                await _broadcast(session_id, {\n   281→                    \"event\": \"token\",\n   282→                    \"data\": {\"text\": event[\"text\"]},\n   283→                })\n   284→            elif event[\"type\"] == \"done\":\n   285→                content = event.get(\"content\", \"\".join(full_text))\n   286→                ChatSessionService.add_message(project_id, session_id, \"assistant\", content)\n   287→                await _broadcast(session_id, {\n   288→                    \"event\": \"message_done\",\n   289→                    \"data\": {\"role\": \"assistant\", \"content\": content},\n   290→                })\n   291→            elif event[\"type\"] == \"result\":\n   292→                await _broadcast(session_id, {\n   293→                    \"event\": \"result\",\n   294→                    \"data\": event,\n   295→                })\n   296→            elif event[\"type\"] == \"error\":\n   297→                await _broadcast(session_id, {\n   298→                    \"event\": \"chat_error\",\n   299→                    \"data\": {\"detail\": event[\"detail\"]},\n   300→                })\n   301→    except Exception as e:\n   302→        await _broadcast(session_id, {\n   303→            \"event\": \"chat_error\",\n   304→            \"data\": {\"detail\": str(e)},\n   305→        })\n   306→\n   307→\n   308→async def _stream_response_keepalive(\n   309→    project_id: str,\n   310→    session_id: str,\n   311→) -> None:\n   312→    \"\"\"Background task: poll keepalive agent inbox and push events to SSE.\"\"\"\n   313→    try:\n   314→        async for event in keepalive_manager.poll_response(session_id):\n   315→            if event[\"type\"] == \"token\":\n   316→                await _broadcast(session_id, {\n   317→                    \"event\": \"token\",\n   318→                    \"data\": {\"text\": event[\"text\"]},\n   319→                })\n   320→            elif event[\"type\"] == \"done\":\n   321→                content = event.get(\"content\", \"\")\n   322→                ChatSessionService.add_message(project_id, session_id, \"assistant\", content)\n   323→                await _broadcast(session_id, {\n   324→                    \"event\": \"message_done\",\n   325→                    \"data\": {\"role\": \"assistant\", \"content\": content},\n   326→                })\n   327→            elif event[\"type\"] == \"error\":\n   328→                await _broadcast(session_id, {\n   329→                    \"event\": \"chat_error\",\n   330→                    \"data\": {\"detail\": event[\"detail\"]},\n   331→                })\n   332→    except Exception as e:\n   333→        await _broadcast(session_id, {\n   334→            \"event\": \"chat_error\",\n   335→            \"data\": {\"detail\": str(e)},\n   336→        })\n   337→\n   338→\n   339→# ---------------------------------------------------------------------------\n   340→# Cancel\n   341→# ---------------------------------------------------------------------------\n   342→\n   343→@router.post(\"/api/projects/{project_id}/chat/sessions/{session_id}/cancel\")\n   344→async def cancel_session_chat(project_id: str, session_id: str):\n   345→    # Try one-shot cancel first\n   346→    cancelled = chat_service.cancel()\n   347→    if not cancelled:\n   348→        # For persistent sessions, kill the agent\n   349→        if keepalive_manager.is_alive(session_id):\n   350→            keepalive_manager.stop()\n   351→            cancelled = True\n   352→    return {\"cancelled\": cancelled}\n   353→\n   354→\n   355→# ---------------------------------------------------------------------------\n   356→# SSE streaming endpoint\n   357→# ---------------------------------------------------------------------------\n   358→\n   359→async def _forward_queue(source: asyncio.Queue, dest: asyncio.Queue) -> None:\n   360→    \"\"\"Forward items from source queue to dest queue until cancelled.\"\"\"\n   361→    try:\n   362→        while True:\n   363→            item = await source.get()\n   364→            await dest.put(item)\n   365→    except asyncio.CancelledError:\n   366→        pass\n   367→\n   368→\n   369→@router.get(\"/api/projects/{project_id}/chat/sessions/{session_id}/stream\")\n   370→async def stream_session(project_id: str, session_id: str, request: Request):\n   371→    \"\"\"SSE endpoint delivering chat tokens and diagram change events.\"\"\"\n   372→    project = ProjectService.get_by_id(project_id)\n   373→    if not project:\n   374→        raise HTTPException(status_code=404, detail=\"Project not found\")\n   375→\n   376→    session = ChatSessionService.get(project_id, session_id)\n   377→    if not session:\n   378→        raise HTTPException(status_code=404, detail=\"Session not found\")\n   379→\n   380→    # Cancel any pending disconnect cleanup (SSE reconnected)\n   381→    keepalive_manager.cancel_disconnect_cleanup(session_id)\n   382→\n   383→    # Subscribe to chat events\n   384→    chat_queue = _subscribe(session_id)\n   385→\n   386→    # Subscribe to diagram watcher\n   387→    arch_dir = Path(project.path) / \".vista\" / \"features\" / session.feature_name / \"arch\"\n   388→    diagram_queue = diagram_watcher.subscribe(project_id, session.feature_name, arch_dir)\n   389→\n   390→    # Merge both queues into one so the generator reads from a single source\n   391→    merged: asyncio.Queue = asyncio.Queue(maxsize=500)\n   392→\n   393→    async def event_generator():\n   394→        fwd_chat = asyncio.create_task(_forward_queue(chat_queue, merged))\n   395→        fwd_diagram = asyncio.create_task(_forward_queue(diagram_queue, merged))\n   396→        try:\n   397→            while True:\n   398→                if await request.is_disconnected():\n   399→                    break\n   400→                try:\n   401→                    event = await asyncio.wait_for(merged.get(), timeout=30.0)\n   402→                    yield {\n   403→                        \"event\": event.get(\"event\", \"message\"),\n   404→                        \"data\": json.dumps(event.get(\"data\", {})),\n   405→                    }\n   406→                except asyncio.TimeoutError:\n   407→                    yield {\"event\": \"ping\", \"data\": \"\"}\n   408→        except asyncio.CancelledError:\n   409→            pass\n   410→        finally:\n   411→            fwd_chat.cancel()\n   412→            fwd_diagram.cancel()\n   413→            _unsubscribe(session_id, chat_queue)\n   414→            diagram_watcher.unsubscribe(project_id, session.feature_name, diagram_queue)\n   415→            # Start disconnect grace period for persistent sessions\n   416→            if session.team_name:\n   417→                keepalive_manager.schedule_disconnect_cleanup(session_id, grace_seconds=10)\n   418→\n   419→    return EventSourceResponse(event_generator())\n   420→"}]},"parent_tool_use_id":null,"session_id":"fe920b97-a686-4daa-9f39-67e009025eb9","uuid":"3cff280c-0166-445e-aed5-7a4b96cc1d32","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/routes/chat_sessions.py","content":"\"\"\"Chat session API routes with SSE streaming and live diagram updates.\"\"\"\n\nimport asyncio\nimport json\nimport logging\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom fastapi import APIRouter, HTTPException, Request\nfrom pydantic import BaseModel, Field\nfrom sse_starlette.sse import EventSourceResponse\n\nfrom server.services.project_service import ProjectService\nfrom server.services.chat_session_service import ChatSessionService\nfrom server.services.chat_service import chat_service\nfrom server.services.keepalive_manager import keepalive_manager\nfrom server.services.diagram_watcher import diagram_watcher\n\nlog = logging.getLogger(__name__)\nrouter = APIRouter(tags=[\"chat_sessions\"])\n\n# Per-session SSE subscriber queues\n_session_subscribers: dict[str, list[asyncio.Queue]] = {}\n\n\ndef _subscribe(session_id: str) -> asyncio.Queue:\n    if session_id not in _session_subscribers:\n        _session_subscribers[session_id] = []\n    queue: asyncio.Queue = asyncio.Queue(maxsize=500)\n    _session_subscribers[session_id].append(queue)\n    return queue\n\n\ndef _unsubscribe(session_id: str, queue: asyncio.Queue) -> None:\n    if session_id in _session_subscribers:\n        _session_subscribers[session_id] = [\n            q for q in _session_subscribers[session_id] if q is not queue\n        ]\n        if not _session_subscribers[session_id]:\n            del _session_subscribers[session_id]\n\n\nasync def _broadcast(session_id: str, message: dict) -> None:\n    if session_id not in _session_subscribers:\n        return\n    dead = []\n    for queue in _session_subscribers[session_id]:\n        try:\n            queue.put_nowait(message)\n        except asyncio.QueueFull:\n            dead.append(queue)\n    for q in dead:\n        if session_id in _session_subscribers:\n            _session_subscribers[session_id].remove(q)\n\n\n# ---------------------------------------------------------------------------\n# Request / response models\n# ---------------------------------------------------------------------------\n\nclass CreateSessionRequest(BaseModel):\n    feature_name: str\n    provider: str\n    model: str\n    name: str = \"\"\n    mode: str = Field(\"oneshot\", description=\"'oneshot' or 'persistent'\")\n\n\nclass SendMessageRequest(BaseModel):\n    message: str\n    context: Optional[str] = Field(None, description=\"Pre-assembled diagram context\")\n    provider: Optional[str] = Field(None, description=\"Provider to use (overrides session default)\")\n    model: Optional[str] = Field(None, description=\"Model to use (overrides session default)\")\n    mode: str = Field(\"oneshot\", description=\"'oneshot' or 'persistent'\")\n\n\nclass RenameSessionRequest(BaseModel):\n    name: str\n\n\n# ---------------------------------------------------------------------------\n# Session CRUD\n# ---------------------------------------------------------------------------\n\n@router.get(\"/api/projects/{project_id}/chat/sessions\")\nasync def list_sessions(project_id: str, feature: Optional[str] = None):\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n    return ChatSessionService.list_sessions(project_id, feature)\n\n\n@router.post(\"/api/projects/{project_id}/chat/sessions\")\nasync def create_session(project_id: str, body: CreateSessionRequest):\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    session = ChatSessionService.create(\n        project_id=project_id,\n        feature_name=body.feature_name,\n        provider=body.provider,\n        model=body.model,\n        name=body.name,\n    )\n\n    # For persistent mode, spawn the agent immediately\n    if body.mode == \"persistent\":\n        arch_dir = str(\n            Path(project.path) / \".vista\" / \"features\" / body.feature_name / \"arch\"\n        )\n        system_prompt = chat_service.build_prompt(\n            message=\"(session started — awaiting first message)\",\n            context=None,\n            history=None,\n            arch_dir=arch_dir,\n            project_root=project.path,\n        )\n        try:\n            team_name = keepalive_manager.start(\n                session_id=session.id,\n                provider=body.provider,\n                model=body.model,\n                system_prompt=system_prompt,\n                cwd=project.path,\n            )\n            session.team_name = team_name\n            ChatSessionService.save(session)\n        except Exception as e:\n            log.error(\"Failed to start keep-alive agent: %s\", e, exc_info=True)\n            # Session is still usable in oneshot mode\n\n    return session.to_dict()\n\n\n@router.get(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\nasync def get_session(project_id: str, session_id: str):\n    session = ChatSessionService.get(project_id, session_id)\n    if not session:\n        raise HTTPException(status_code=404, detail=\"Session not found\")\n    return session.to_dict()\n\n\n@router.delete(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\nasync def delete_session(project_id: str, session_id: str):\n    session = ChatSessionService.get(project_id, session_id)\n    if session and session.team_name:\n        keepalive_manager.stop()\n    deleted = ChatSessionService.delete(project_id, session_id)\n    if not deleted:\n        raise HTTPException(status_code=404, detail=\"Session not found\")\n    return {\"deleted\": True}\n\n\n@router.patch(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\nasync def rename_session(project_id: str, session_id: str, body: RenameSessionRequest):\n    session = ChatSessionService.update_name(project_id, session_id, body.name)\n    if not session:\n        raise HTTPException(status_code=404, detail=\"Session not found\")\n    return session.to_summary_dict()\n\n\n# ---------------------------------------------------------------------------\n# Send message (triggers streaming via SSE)\n# ---------------------------------------------------------------------------\n\n@router.post(\"/api/projects/{project_id}/chat/sessions/{session_id}/messages\")\nasync def send_message(project_id: str, session_id: str, body: SendMessageRequest):\n    \"\"\"Send a user message. Streams the response via the session's SSE endpoint.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    session = ChatSessionService.get(project_id, session_id)\n    if not session:\n        raise HTTPException(status_code=404, detail=\"Session not found\")\n\n    if not body.message.strip():\n        raise HTTPException(status_code=400, detail=\"Message is required\")\n\n    # Use provider/model from request, fall back to session defaults\n    provider_name = body.provider or session.provider\n    model_name = body.model or session.model\n\n    # Update session defaults if the user changed provider/model\n    if provider_name != session.provider or model_name != session.model:\n        session.provider = provider_name\n        session.model = model_name\n        ChatSessionService.save(session)\n\n    # Save user message\n    session = ChatSessionService.add_message(project_id, session_id, \"user\", body.message)\n\n    arch_dir = str(\n        Path(project.path) / \".vista\" / \"features\" / session.feature_name / \"arch\"\n    )\n\n    use_persistent = body.mode == \"persistent\"\n\n    if use_persistent:\n        # Persistent mode via keepalive_manager (tmux + inbox messaging)\n        agent_alive = keepalive_manager.is_alive(session_id)\n\n        # Try to resume if we have a team_name but manager doesn't know about it\n        if not agent_alive and session.team_name:\n            agent_alive = keepalive_manager.resume(session_id, session.team_name)\n\n        if not agent_alive:\n            # Cold start — spawn a new agent with full history\n            all_msgs = [{\"role\": m.role, \"content\": m.content} for m in session.messages]\n            history = all_msgs[:-1] if len(all_msgs) > 1 else None\n            system_prompt = chat_service.build_prompt(\n                message=body.message,\n                context=body.context,\n                history=history,\n                arch_dir=arch_dir,\n                project_root=project.path,\n            )\n            try:\n                team_name = keepalive_manager.start(\n                    session_id=session_id,\n                    provider=provider_name,\n                    model=model_name,\n                    system_prompt=system_prompt,\n                    cwd=project.path,\n                )\n                session.team_name = team_name\n                ChatSessionService.save(session)\n            except Exception as e:\n                await _broadcast(session_id, {\n                    \"event\": \"chat_error\",\n                    \"data\": {\"detail\": f\"Failed to start agent: {e}\"},\n                })\n                return {\"status\": \"error\", \"session_id\": session_id, \"mode\": body.mode}\n        else:\n            # Agent is alive — send just the user message (agent has context)\n            keepalive_manager.send_message(session_id, body.message, context=body.context)\n\n        asyncio.create_task(\n            _stream_response_keepalive(project_id, session_id)\n        )\n    else:\n        # One-shot mode: full history replay each time\n        all_msgs = [{\"role\": m.role, \"content\": m.content} for m in session.messages]\n        history = all_msgs[:-1] if len(all_msgs) > 1 else None\n        prompt = chat_service.build_prompt(\n            message=body.message,\n            context=body.context,\n            history=history,\n            arch_dir=arch_dir,\n            project_root=project.path,\n        )\n        asyncio.create_task(\n            _stream_response(project_id, session_id, provider_name, model_name, prompt, project.path)\n        )\n\n    return {\"status\": \"streaming\", \"session_id\": session_id, \"mode\": body.mode}\n\n\nasync def _stream_response(\n    project_id: str,\n    session_id: str,\n    provider_name: str,\n    model: str,\n    prompt: str,\n    project_path: str,\n) -> None:\n    \"\"\"Background task that streams CLI response and pushes events to SSE subscribers.\"\"\"\n    full_text: list[str] = []\n\n    try:\n        async for event in chat_service.invoke_provider_streaming(\n            provider_name=provider_name,\n            model=model,\n            prompt=prompt,\n            cwd=project_path,\n        ):\n            if event[\"type\"] == \"token\":\n                full_text.append(event[\"text\"])\n                await _broadcast(session_id, {\n                    \"event\": \"token\",\n                    \"data\": {\"text\": event[\"text\"]},\n                })\n            elif event[\"type\"] == \"done\":\n                content = event.get(\"content\", \"\".join(full_text))\n                ChatSessionService.add_message(project_id, session_id, \"assistant\", content)\n                await _broadcast(session_id, {\n                    \"event\": \"message_done\",\n                    \"data\": {\"role\": \"assistant\", \"content\": content},\n                })\n            elif event[\"type\"] == \"result\":\n                await _broadcast(session_id, {\n                    \"event\": \"result\",\n                    \"data\": event,\n                })\n            elif event[\"type\"] == \"error\":\n                await _broadcast(session_id, {\n                    \"event\": \"chat_error\",\n                    \"data\": {\"detail\": event[\"detail\"]},\n                })\n    except Exception as e:\n        await _broadcast(session_id, {\n            \"event\": \"chat_error\",\n            \"data\": {\"detail\": str(e)},\n        })\n\n\nasync def _stream_response_keepalive(\n    project_id: str,\n    session_id: str,\n) -> None:\n    \"\"\"Background task: poll keepalive agent inbox and push events to SSE.\"\"\"\n    try:\n        async for event in keepalive_manager.poll_response(session_id):\n            if event[\"type\"] == \"token\":\n                await _broadcast(session_id, {\n                    \"event\": \"token\",\n                    \"data\": {\"text\": event[\"text\"]},\n                })\n            elif event[\"type\"] == \"done\":\n                content = event.get(\"content\", \"\")\n                ChatSessionService.add_message(project_id, session_id, \"assistant\", content)\n                await _broadcast(session_id, {\n                    \"event\": \"message_done\",\n                    \"data\": {\"role\": \"assistant\", \"content\": content},\n                })\n            elif event[\"type\"] == \"error\":\n                await _broadcast(session_id, {\n                    \"event\": \"chat_error\",\n                    \"data\": {\"detail\": event[\"detail\"]},\n                })\n    except Exception as e:\n        await _broadcast(session_id, {\n            \"event\": \"chat_error\",\n            \"data\": {\"detail\": str(e)},\n        })\n\n\n# ---------------------------------------------------------------------------\n# Cancel\n# ---------------------------------------------------------------------------\n\n@router.post(\"/api/projects/{project_id}/chat/sessions/{session_id}/cancel\")\nasync def cancel_session_chat(project_id: str, session_id: str):\n    # Try one-shot cancel first\n    cancelled = chat_service.cancel()\n    if not cancelled:\n        # For persistent sessions, kill the agent\n        if keepalive_manager.is_alive(session_id):\n            keepalive_manager.stop()\n            cancelled = True\n    return {\"cancelled\": cancelled}\n\n\n# ---------------------------------------------------------------------------\n# SSE streaming endpoint\n# ---------------------------------------------------------------------------\n\nasync def _forward_queue(source: asyncio.Queue, dest: asyncio.Queue) -> None:\n    \"\"\"Forward items from source queue to dest queue until cancelled.\"\"\"\n    try:\n        while True:\n            item = await source.get()\n            await dest.put(item)\n    except asyncio.CancelledError:\n        pass\n\n\n@router.get(\"/api/projects/{project_id}/chat/sessions/{session_id}/stream\")\nasync def stream_session(project_id: str, session_id: str, request: Request):\n    \"\"\"SSE endpoint delivering chat tokens and diagram change events.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    session = ChatSessionService.get(project_id, session_id)\n    if not session:\n        raise HTTPException(status_code=404, detail=\"Session not found\")\n\n    # Cancel any pending disconnect cleanup (SSE reconnected)\n    keepalive_manager.cancel_disconnect_cleanup(session_id)\n\n    # Subscribe to chat events\n    chat_queue = _subscribe(session_id)\n\n    # Subscribe to diagram watcher\n    arch_dir = Path(project.path) / \".vista\" / \"features\" / session.feature_name / \"arch\"\n    diagram_queue = diagram_watcher.subscribe(project_id, session.feature_name, arch_dir)\n\n    # Merge both queues into one so the generator reads from a single source\n    merged: asyncio.Queue = asyncio.Queue(maxsize=500)\n\n    async def event_generator():\n        fwd_chat = asyncio.create_task(_forward_queue(chat_queue, merged))\n        fwd_diagram = asyncio.create_task(_forward_queue(diagram_queue, merged))\n        try:\n            while True:\n                if await request.is_disconnected():\n                    break\n                try:\n                    event = await asyncio.wait_for(merged.get(), timeout=30.0)\n                    yield {\n                        \"event\": event.get(\"event\", \"message\"),\n                        \"data\": json.dumps(event.get(\"data\", {})),\n                    }\n                except asyncio.TimeoutError:\n                    yield {\"event\": \"ping\", \"data\": \"\"}\n        except asyncio.CancelledError:\n            pass\n        finally:\n            fwd_chat.cancel()\n            fwd_diagram.cancel()\n            _unsubscribe(session_id, chat_queue)\n            diagram_watcher.unsubscribe(project_id, session.feature_name, diagram_queue)\n            # Start disconnect grace period for persistent sessions\n            if session.team_name:\n                keepalive_manager.schedule_disconnect_cleanup(session_id, grace_seconds=10)\n\n    return EventSourceResponse(event_generator())\n","numLines":420,"startLine":1,"totalLines":420}}}
