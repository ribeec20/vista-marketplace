{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LHeno8Z1dHU64UMQhTghta","type":"tool_result","content":"     1→\"\"\"FastAPI web server entry point - Vista Dashboard.\"\"\"\n     2→\n     3→import json\n     4→from contextlib import asynccontextmanager\n     5→from pathlib import Path\n     6→\n     7→from fastapi import FastAPI, Request\n     8→from fastapi.staticfiles import StaticFiles\n     9→from fastapi.templating import Jinja2Templates\n    10→\n    11→from server import config\n    12→from server.services.project_service import ProjectService\n    13→from server.services.loop_service import loop_service\n    14→from server.services.diagram_watcher import diagram_watcher\n    15→from server.services.chat_service import chat_service\n    16→from server.services.keepalive_manager import keepalive_manager\n    17→from server.services.provider_service import get_enabled_providers\n    18→from server.services.output_parser import parse_stream_json_activity\n    19→from server.services.ralph_service import ralph_service\n    20→from server.services.service_lifecycle import (\n    21→    service_lifecycle,\n    22→    companion_config,\n    23→    opencode_config,\n    24→)\n    25→from server.services.provider_router import provider_router\n    26→\n    27→\n    28→@asynccontextmanager\n    29→async def lifespan(app: FastAPI):\n    30→    \"\"\"Startup and shutdown lifecycle.\"\"\"\n    31→    config.ensure_full_path()\n    32→    config.DATA_DIR.mkdir(parents=True, exist_ok=True)\n    33→    (config.DATA_DIR / \"sessions\").mkdir(exist_ok=True)\n    34→\n    35→    # Register and start backend services\n    36→    service_lifecycle.register(companion_config())\n    37→    service_lifecycle.register(opencode_config())\n    38→    await service_lifecycle.start_all()\n    39→\n    40→    yield\n    41→\n    42→    # Shutdown\n    43→    await provider_router.cleanup_all()\n    44→    await service_lifecycle.stop_all()\n    45→    await loop_service.stop_all()\n    46→    await diagram_watcher.stop()\n    47→    keepalive_manager.stop_all()\n    48→\n    49→\n    50→app = FastAPI(title=\"Ralph Loop Dashboard\", version=\"1.3.6\", lifespan=lifespan)\n    51→\n    52→# Mount static files\n    53→config.STATIC_DIR.mkdir(parents=True, exist_ok=True)\n    54→app.mount(\"/static\", StaticFiles(directory=str(config.STATIC_DIR)), name=\"static\")\n    55→\n    56→# Templates\n    57→templates = Jinja2Templates(directory=str(config.VIEWS_DIR))\n    58→\n    59→# Include routers\n    60→from server.routes import (\n    61→    projects,\n    62→    loops,\n    63→    stream,\n    64→    plans,\n    65→    providers,\n    66→    shutdown,\n    67→    architecture,\n    68→    chat,\n    69→    chat_sessions,\n    70→    ralph,\n    71→    ralph_settings,\n    72→    sandbox,\n    73→    service_status,\n    74→)\n    75→\n    76→app.include_router(projects.router)\n    77→app.include_router(loops.router)\n    78→app.include_router(stream.router)\n    79→app.include_router(plans.router)\n    80→app.include_router(providers.router)\n    81→app.include_router(shutdown.router)\n    82→app.include_router(architecture.router)\n    83→app.include_router(chat.router)\n    84→app.include_router(chat_sessions.router)\n    85→app.include_router(ralph.router)\n    86→app.include_router(ralph_settings.router)\n    87→app.include_router(sandbox.router)\n    88→app.include_router(service_status.router)\n    89→\n    90→\n    91→@app.get(\"/api/health\")\n    92→async def health_check():\n    93→    \"\"\"Health check endpoint for monitoring and hooks.\"\"\"\n    94→    running_loops = {\n    95→        pid: state.to_dict()\n    96→        for pid, state in loop_service.get_all_states().items()\n    97→        if state.status in (\"running\", \"starting\")\n    98→    }\n    99→    return {\n   100→        \"status\": \"ok\",\n   101→        \"version\": app.version,\n   102→        \"running_loops\": len(running_loops),\n   103→    }\n   104→\n   105→\n   106→@app.get(\"/api/loops/running\")\n   107→async def running_loops_summary():\n   108→    \"\"\"Return compact summary of active loops for global app-bar status UI.\"\"\"\n   109→    project_map = {p.id: p for p in ProjectService.get_all()}\n   110→    summaries = []\n   111→    for project_id, state in loop_service.get_all_states().items():\n   112→        if state.status not in (\"running\", \"starting\"):\n   113→            continue\n   114→\n   115→        max_iters = state.max_iterations or 0\n   116→        progress = None\n   117→        if max_iters > 0:\n   118→            progress = min(100, int((state.iteration / max_iters) * 100))\n   119→\n   120→        project = project_map.get(project_id)\n   121→        recent_actions = list(state.recent_actions)[-3:]\n   122→        summaries.append(\n   123→            {\n   124→                \"kind\": \"project_loop\",\n   125→                \"project_id\": project_id,\n   126→                \"project_name\": project.name if project else project_id,\n   127→                \"status\": state.status,\n   128→                \"feature_name\": state.feature_name,\n   129→                \"mode\": state.mode,\n   130→                \"provider\": state.provider,\n   131→                \"provider_display_name\": state.provider_display_name,\n   132→                \"model\": state.model,\n   133→                \"iteration\": state.iteration,\n   134→                \"max_iterations\": max_iters,\n   135→                \"progress_percent\": progress,\n   136→                \"start_time\": state.start_time,\n   137→                \"recent_actions\": recent_actions,\n   138→            }\n   139→        )\n   140→\n   141→    # Also include running Ralph jobs started via ralph_start\n   142→    for project in project_map.values():\n   143→        project_root = Path(project.path)\n   144→        for job in ralph_service.list_jobs(project_root):\n   145→            if job.get(\"status\") != \"running\":\n   146→                continue\n   147→\n   148→            # Refresh status to avoid stale \"running\" jobs with dead PID\n   149→            refreshed = ralph_service.get_job_status(project_root, job.get(\"job_id\", \"\"))\n   150→            if not refreshed or refreshed.get(\"status\") != \"running\":\n   151→                continue\n   152→\n   153→            progress_tail = refreshed.get(\"progress_tail\") or []\n   154→            recent_actions = [\n   155→                {\n   156→                    \"time\": refreshed.get(\"completed_at\")\n   157→                    or refreshed.get(\"started_at\")\n   158→                    or refreshed.get(\"created_at\"),\n   159→                    \"type\": \"progress\",\n   160→                    \"message\": line,\n   161→                }\n   162→                for line in progress_tail[-3:]\n   163→            ]\n   164→\n   165→            max_iters = refreshed.get(\"iterations\") or 0\n   166→            current_iter = refreshed.get(\"current_iteration\") or 0\n   167→            progress = None\n   168→            if max_iters > 0:\n   169→                progress = min(100, int((current_iter / max_iters) * 100))\n   170→\n   171→            summaries.append(\n   172→                {\n   173→                    \"kind\": \"ralph_job\",\n   174→                    \"job_id\": refreshed.get(\"job_id\"),\n   175→                    \"project_id\": project.id,\n   176→                    \"project_name\": project.name,\n   177→                    \"status\": refreshed.get(\"status\"),\n   178→                    \"feature_name\": refreshed.get(\"slug\") or refreshed.get(\"job_id\"),\n   179→                    \"mode\": refreshed.get(\"mode\"),\n   180→                    \"provider\": refreshed.get(\"provider\"),\n   181→                    \"provider_display_name\": refreshed.get(\"provider\"),\n   182→                    \"model\": refreshed.get(\"model\"),\n   183→                    \"iteration\": current_iter,\n   184→                    \"max_iterations\": max_iters,\n   185→                    \"progress_percent\": progress,\n   186→                    \"start_time\": refreshed.get(\"started_at\") or refreshed.get(\"created_at\"),\n   187→                    \"recent_actions\": recent_actions,\n   188→                }\n   189→            )\n   190→\n   191→    summaries.sort(key=lambda item: item.get(\"start_time\") or \"\", reverse=True)\n   192→    return {\"count\": len(summaries), \"loops\": summaries}\n   193→\n   194→\n   195→@app.get(\"/\")\n   196→async def dashboard(request: Request):\n   197→    \"\"\"Main dashboard showing all registered projects.\"\"\"\n   198→    all_projects = ProjectService.get_all()\n   199→    states = loop_service.get_all_states()\n   200→\n   201→    # Enrich projects with loop state\n   202→    project_data = []\n   203→    for p in all_projects:\n   204→        state = states.get(p.id)\n   205→        project_data.append(\n   206→            {\n   207→                **p.to_dict(),\n   208→                \"loop_status\": state.status if state else \"idle\",\n   209→                \"loop_iteration\": state.iteration if state else 0,\n   210→                \"loop_feature\": state.feature_name if state else None,\n   211→                \"loop_mode\": state.mode if state else None,\n   212→            }\n   213→        )\n   214→\n   215→    return templates.TemplateResponse(\n   216→        request,\n   217→        \"dashboard.html\",\n   218→        {\n   219→            \"projects\": project_data,\n   220→        },\n   221→    )\n   222→\n   223→\n   224→@app.get(\"/project/{project_id}\")\n   225→async def project_detail(request: Request, project_id: str):\n   226→    \"\"\"Single project detail page with loop controls.\"\"\"\n   227→    project = ProjectService.get_by_id(project_id)\n   228→    if not project:\n   229→        return templates.TemplateResponse(\n   230→            request,\n   231→            \"dashboard.html\",\n   232→            {\n   233→                \"projects\": [],\n   234→                \"error\": \"Project not found\",\n   235→            },\n   236→        )\n   237→\n   238→    features = ProjectService.scan_features_detailed(project.path)\n   239→    state = loop_service.get_state(project_id)\n   240→    providers = [p.to_summary_dict() for p in get_enabled_providers()]\n   241→\n   242→    return templates.TemplateResponse(\n   243→        request,\n   244→        \"project.html\",\n   245→        {\n   246→            \"project\": project.to_dict(),\n   247→            \"features\": features,\n   248→            \"loop_state\": state.to_dict() if state else {\"status\": \"idle\"},\n   249→            \"providers\": providers,\n   250→        },\n   251→    )\n   252→\n   253→\n   254→@app.get(\"/ralph/jobs\")\n   255→async def ralph_jobs_page(request: Request):\n   256→    \"\"\"Ralph jobs list page.\"\"\"\n   257→    all_jobs = []\n   258→    for project in ProjectService.get_all():\n   259→        project_root = Path(project.path)\n   260→        jobs = ralph_service.list_jobs(project_root)\n   261→        for job in jobs:\n   262→            job[\"project_name\"] = project.name\n   263→            job[\"project_id\"] = project.id\n   264→        all_jobs.extend(jobs)\n   265→    all_jobs.sort(key=lambda j: j.get(\"created_at\", \"\"), reverse=True)\n   266→    has_running = any(j.get(\"status\") == \"running\" for j in all_jobs)\n   267→\n   268→    return templates.TemplateResponse(\n   269→        request,\n   270→        \"ralph_jobs.html\",\n   271→        {\"jobs\": all_jobs, \"has_running\": has_running},\n   272→    )\n   273→\n   274→\n   275→@app.get(\"/ralph/jobs/{job_id}\")\n   276→async def ralph_job_detail_page(request: Request, job_id: str):\n   277→    \"\"\"Ralph job detail page.\"\"\"\n   278→    job = None\n   279→    job_dir = None\n   280→    for project in ProjectService.get_all():\n   281→        project_root = Path(project.path)\n   282→        result = ralph_service.get_job_status(project_root, job_id)\n   283→        if result:\n   284→            job = result\n   285→            job[\"project_name\"] = project.name\n   286→            job[\"project_id\"] = project.id\n   287→            # Find job dir for artifacts\n   288→            ralph_dir = project_root / \".vista\" / \"ralph\"\n   289→            if ralph_dir.exists():\n   290→                for slug_dir in ralph_dir.iterdir():\n   291→                    if slug_dir.is_dir():\n   292→                        jf = slug_dir / \"job.json\"\n   293→                        if jf.exists():\n   294→                            try:\n   295→                                data = json.loads(jf.read_text(encoding=\"utf-8\"))\n   296→                                if data.get(\"job_id\") == job_id:\n   297→                                    job_dir = slug_dir\n   298→                                    break\n   299→                            except (json.JSONDecodeError, OSError):\n   300→                                continue\n   301→            break\n   302→\n   303→    if not job:\n   304→        return templates.TemplateResponse(\n   305→            request,\n   306→            \"ralph_jobs.html\",\n   307→            {\"jobs\": [], \"has_running\": False, \"error\": \"Job not found\"},\n   308→        )\n   309→\n   310→    # Read progress lines — prefer progress.txt, fall back to output.log parsing\n   311→    progress_lines = []\n   312→    if job_dir:\n   313→        progress_file = job_dir / \"progress.txt\"\n   314→        if progress_file.exists():\n   315→            lines = progress_file.read_text(encoding=\"utf-8\").splitlines()\n   316→            progress_lines = lines[-50:]\n   317→        else:\n   318→            output_file = job_dir / \"output.log\"\n   319→            if output_file.exists():\n   320→                try:\n   321→                    raw = output_file.read_text(\n   322→                        encoding=\"utf-8\", errors=\"replace\"\n   323→                    ).splitlines()\n   324→                    progress_lines, _iter = parse_stream_json_activity(raw[-500:])\n   325→                    progress_lines = progress_lines[-50:]\n   326→                except OSError:\n   327→                    pass\n   328→\n   329→    # List artifacts\n   330→    artifacts = []\n   331→    if job_dir:\n   332→        exclude = {\"job.json\", \"output.log\"}\n   333→        for f in sorted(job_dir.iterdir()):\n   334→            if f.is_file() and f.name not in exclude:\n   335→                artifacts.append({\"name\": f.name, \"size\": f.stat().st_size})\n   336→\n   337→    return templates.TemplateResponse(\n   338→        request,\n   339→        \"ralph_job_detail.html\",\n   340→        {\n   341→            \"job\": job,\n   342→            \"progress_lines\": progress_lines,\n   343→            \"artifacts\": artifacts,\n   344→        },\n   345→    )\n   346→\n   347→\n   348→@app.get(\"/ralph/settings\")\n   349→async def ralph_settings_page(request: Request):\n   350→    \"\"\"Ralph settings page.\"\"\"\n   351→    return templates.TemplateResponse(request, \"ralph_settings.html\", {})\n   352→"}]},"parent_tool_use_id":null,"session_id":"41eb5763-1813-40b4-994f-a8833bfca10e","uuid":"789db197-427c-481a-8941-98ef0a3a0ab2","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/app.py","content":"\"\"\"FastAPI web server entry point - Vista Dashboard.\"\"\"\n\nimport json\nfrom contextlib import asynccontextmanager\nfrom pathlib import Path\n\nfrom fastapi import FastAPI, Request\nfrom fastapi.staticfiles import StaticFiles\nfrom fastapi.templating import Jinja2Templates\n\nfrom server import config\nfrom server.services.project_service import ProjectService\nfrom server.services.loop_service import loop_service\nfrom server.services.diagram_watcher import diagram_watcher\nfrom server.services.chat_service import chat_service\nfrom server.services.keepalive_manager import keepalive_manager\nfrom server.services.provider_service import get_enabled_providers\nfrom server.services.output_parser import parse_stream_json_activity\nfrom server.services.ralph_service import ralph_service\nfrom server.services.service_lifecycle import (\n    service_lifecycle,\n    companion_config,\n    opencode_config,\n)\nfrom server.services.provider_router import provider_router\n\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    \"\"\"Startup and shutdown lifecycle.\"\"\"\n    config.ensure_full_path()\n    config.DATA_DIR.mkdir(parents=True, exist_ok=True)\n    (config.DATA_DIR / \"sessions\").mkdir(exist_ok=True)\n\n    # Register and start backend services\n    service_lifecycle.register(companion_config())\n    service_lifecycle.register(opencode_config())\n    await service_lifecycle.start_all()\n\n    yield\n\n    # Shutdown\n    await provider_router.cleanup_all()\n    await service_lifecycle.stop_all()\n    await loop_service.stop_all()\n    await diagram_watcher.stop()\n    keepalive_manager.stop_all()\n\n\napp = FastAPI(title=\"Ralph Loop Dashboard\", version=\"1.3.6\", lifespan=lifespan)\n\n# Mount static files\nconfig.STATIC_DIR.mkdir(parents=True, exist_ok=True)\napp.mount(\"/static\", StaticFiles(directory=str(config.STATIC_DIR)), name=\"static\")\n\n# Templates\ntemplates = Jinja2Templates(directory=str(config.VIEWS_DIR))\n\n# Include routers\nfrom server.routes import (\n    projects,\n    loops,\n    stream,\n    plans,\n    providers,\n    shutdown,\n    architecture,\n    chat,\n    chat_sessions,\n    ralph,\n    ralph_settings,\n    sandbox,\n    service_status,\n)\n\napp.include_router(projects.router)\napp.include_router(loops.router)\napp.include_router(stream.router)\napp.include_router(plans.router)\napp.include_router(providers.router)\napp.include_router(shutdown.router)\napp.include_router(architecture.router)\napp.include_router(chat.router)\napp.include_router(chat_sessions.router)\napp.include_router(ralph.router)\napp.include_router(ralph_settings.router)\napp.include_router(sandbox.router)\napp.include_router(service_status.router)\n\n\n@app.get(\"/api/health\")\nasync def health_check():\n    \"\"\"Health check endpoint for monitoring and hooks.\"\"\"\n    running_loops = {\n        pid: state.to_dict()\n        for pid, state in loop_service.get_all_states().items()\n        if state.status in (\"running\", \"starting\")\n    }\n    return {\n        \"status\": \"ok\",\n        \"version\": app.version,\n        \"running_loops\": len(running_loops),\n    }\n\n\n@app.get(\"/api/loops/running\")\nasync def running_loops_summary():\n    \"\"\"Return compact summary of active loops for global app-bar status UI.\"\"\"\n    project_map = {p.id: p for p in ProjectService.get_all()}\n    summaries = []\n    for project_id, state in loop_service.get_all_states().items():\n        if state.status not in (\"running\", \"starting\"):\n            continue\n\n        max_iters = state.max_iterations or 0\n        progress = None\n        if max_iters > 0:\n            progress = min(100, int((state.iteration / max_iters) * 100))\n\n        project = project_map.get(project_id)\n        recent_actions = list(state.recent_actions)[-3:]\n        summaries.append(\n            {\n                \"kind\": \"project_loop\",\n                \"project_id\": project_id,\n                \"project_name\": project.name if project else project_id,\n                \"status\": state.status,\n                \"feature_name\": state.feature_name,\n                \"mode\": state.mode,\n                \"provider\": state.provider,\n                \"provider_display_name\": state.provider_display_name,\n                \"model\": state.model,\n                \"iteration\": state.iteration,\n                \"max_iterations\": max_iters,\n                \"progress_percent\": progress,\n                \"start_time\": state.start_time,\n                \"recent_actions\": recent_actions,\n            }\n        )\n\n    # Also include running Ralph jobs started via ralph_start\n    for project in project_map.values():\n        project_root = Path(project.path)\n        for job in ralph_service.list_jobs(project_root):\n            if job.get(\"status\") != \"running\":\n                continue\n\n            # Refresh status to avoid stale \"running\" jobs with dead PID\n            refreshed = ralph_service.get_job_status(project_root, job.get(\"job_id\", \"\"))\n            if not refreshed or refreshed.get(\"status\") != \"running\":\n                continue\n\n            progress_tail = refreshed.get(\"progress_tail\") or []\n            recent_actions = [\n                {\n                    \"time\": refreshed.get(\"completed_at\")\n                    or refreshed.get(\"started_at\")\n                    or refreshed.get(\"created_at\"),\n                    \"type\": \"progress\",\n                    \"message\": line,\n                }\n                for line in progress_tail[-3:]\n            ]\n\n            max_iters = refreshed.get(\"iterations\") or 0\n            current_iter = refreshed.get(\"current_iteration\") or 0\n            progress = None\n            if max_iters > 0:\n                progress = min(100, int((current_iter / max_iters) * 100))\n\n            summaries.append(\n                {\n                    \"kind\": \"ralph_job\",\n                    \"job_id\": refreshed.get(\"job_id\"),\n                    \"project_id\": project.id,\n                    \"project_name\": project.name,\n                    \"status\": refreshed.get(\"status\"),\n                    \"feature_name\": refreshed.get(\"slug\") or refreshed.get(\"job_id\"),\n                    \"mode\": refreshed.get(\"mode\"),\n                    \"provider\": refreshed.get(\"provider\"),\n                    \"provider_display_name\": refreshed.get(\"provider\"),\n                    \"model\": refreshed.get(\"model\"),\n                    \"iteration\": current_iter,\n                    \"max_iterations\": max_iters,\n                    \"progress_percent\": progress,\n                    \"start_time\": refreshed.get(\"started_at\") or refreshed.get(\"created_at\"),\n                    \"recent_actions\": recent_actions,\n                }\n            )\n\n    summaries.sort(key=lambda item: item.get(\"start_time\") or \"\", reverse=True)\n    return {\"count\": len(summaries), \"loops\": summaries}\n\n\n@app.get(\"/\")\nasync def dashboard(request: Request):\n    \"\"\"Main dashboard showing all registered projects.\"\"\"\n    all_projects = ProjectService.get_all()\n    states = loop_service.get_all_states()\n\n    # Enrich projects with loop state\n    project_data = []\n    for p in all_projects:\n        state = states.get(p.id)\n        project_data.append(\n            {\n                **p.to_dict(),\n                \"loop_status\": state.status if state else \"idle\",\n                \"loop_iteration\": state.iteration if state else 0,\n                \"loop_feature\": state.feature_name if state else None,\n                \"loop_mode\": state.mode if state else None,\n            }\n        )\n\n    return templates.TemplateResponse(\n        request,\n        \"dashboard.html\",\n        {\n            \"projects\": project_data,\n        },\n    )\n\n\n@app.get(\"/project/{project_id}\")\nasync def project_detail(request: Request, project_id: str):\n    \"\"\"Single project detail page with loop controls.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        return templates.TemplateResponse(\n            request,\n            \"dashboard.html\",\n            {\n                \"projects\": [],\n                \"error\": \"Project not found\",\n            },\n        )\n\n    features = ProjectService.scan_features_detailed(project.path)\n    state = loop_service.get_state(project_id)\n    providers = [p.to_summary_dict() for p in get_enabled_providers()]\n\n    return templates.TemplateResponse(\n        request,\n        \"project.html\",\n        {\n            \"project\": project.to_dict(),\n            \"features\": features,\n            \"loop_state\": state.to_dict() if state else {\"status\": \"idle\"},\n            \"providers\": providers,\n        },\n    )\n\n\n@app.get(\"/ralph/jobs\")\nasync def ralph_jobs_page(request: Request):\n    \"\"\"Ralph jobs list page.\"\"\"\n    all_jobs = []\n    for project in ProjectService.get_all():\n        project_root = Path(project.path)\n        jobs = ralph_service.list_jobs(project_root)\n        for job in jobs:\n            job[\"project_name\"] = project.name\n            job[\"project_id\"] = project.id\n        all_jobs.extend(jobs)\n    all_jobs.sort(key=lambda j: j.get(\"created_at\", \"\"), reverse=True)\n    has_running = any(j.get(\"status\") == \"running\" for j in all_jobs)\n\n    return templates.TemplateResponse(\n        request,\n        \"ralph_jobs.html\",\n        {\"jobs\": all_jobs, \"has_running\": has_running},\n    )\n\n\n@app.get(\"/ralph/jobs/{job_id}\")\nasync def ralph_job_detail_page(request: Request, job_id: str):\n    \"\"\"Ralph job detail page.\"\"\"\n    job = None\n    job_dir = None\n    for project in ProjectService.get_all():\n        project_root = Path(project.path)\n        result = ralph_service.get_job_status(project_root, job_id)\n        if result:\n            job = result\n            job[\"project_name\"] = project.name\n            job[\"project_id\"] = project.id\n            # Find job dir for artifacts\n            ralph_dir = project_root / \".vista\" / \"ralph\"\n            if ralph_dir.exists():\n                for slug_dir in ralph_dir.iterdir():\n                    if slug_dir.is_dir():\n                        jf = slug_dir / \"job.json\"\n                        if jf.exists():\n                            try:\n                                data = json.loads(jf.read_text(encoding=\"utf-8\"))\n                                if data.get(\"job_id\") == job_id:\n                                    job_dir = slug_dir\n                                    break\n                            except (json.JSONDecodeError, OSError):\n                                continue\n            break\n\n    if not job:\n        return templates.TemplateResponse(\n            request,\n            \"ralph_jobs.html\",\n            {\"jobs\": [], \"has_running\": False, \"error\": \"Job not found\"},\n        )\n\n    # Read progress lines — prefer progress.txt, fall back to output.log parsing\n    progress_lines = []\n    if job_dir:\n        progress_file = job_dir / \"progress.txt\"\n        if progress_file.exists():\n            lines = progress_file.read_text(encoding=\"utf-8\").splitlines()\n            progress_lines = lines[-50:]\n        else:\n            output_file = job_dir / \"output.log\"\n            if output_file.exists():\n                try:\n                    raw = output_file.read_text(\n                        encoding=\"utf-8\", errors=\"replace\"\n                    ).splitlines()\n                    progress_lines, _iter = parse_stream_json_activity(raw[-500:])\n                    progress_lines = progress_lines[-50:]\n                except OSError:\n                    pass\n\n    # List artifacts\n    artifacts = []\n    if job_dir:\n        exclude = {\"job.json\", \"output.log\"}\n        for f in sorted(job_dir.iterdir()):\n            if f.is_file() and f.name not in exclude:\n                artifacts.append({\"name\": f.name, \"size\": f.stat().st_size})\n\n    return templates.TemplateResponse(\n        request,\n        \"ralph_job_detail.html\",\n        {\n            \"job\": job,\n            \"progress_lines\": progress_lines,\n            \"artifacts\": artifacts,\n        },\n    )\n\n\n@app.get(\"/ralph/settings\")\nasync def ralph_settings_page(request: Request):\n    \"\"\"Ralph settings page.\"\"\"\n    return templates.TemplateResponse(request, \"ralph_settings.html\", {})\n","numLines":352,"startLine":1,"totalLines":352}}}
