{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XrYkc4WFKNFzTHuX5vXR5z","type":"tool_result","content":"     1→\"\"\"Vista MCP Server - launches the FastAPI dashboard as a daemon thread.\n     2→\n     3→Claude Code starts this process via .mcp.json (stdio transport).\n     4→The web dashboard runs as a daemon thread inside the same process,\n     5→modeled on Serena's dashboard.py:run_in_thread() pattern.\n     6→\n     7→Uses fastmcp 3.x (same as claude-code-teams-mcp) for proper Context\n     8→injection, ToolError handling, and middleware support.\n     9→\"\"\"\n    10→\n    11→import asyncio\n    12→import json\n    13→import logging\n    14→import os\n    15→import socket\n    16→import subprocess\n    17→import sys\n    18→import threading\n    19→import time\n    20→import uuid\n    21→from datetime import datetime, timezone\n    22→from pathlib import Path\n    23→from types import SimpleNamespace\n    24→from typing import Any, Literal\n    25→\n    26→# Ensure vista/ is on sys.path so `from server.*` imports resolve\n    27→PLUGIN_ROOT = Path(__file__).resolve().parent\n    28→sys.path.insert(0, str(PLUGIN_ROOT))\n    29→sys.path.insert(0, str(PLUGIN_ROOT / \"vendor\"))\n    30→\n    31→from server.config import ensure_full_path, get_server_settings  # noqa: E402\n    32→\n    33→ensure_full_path()\n    34→\n    35→from fastmcp import Context, FastMCP  # noqa: E402\n    36→from fastmcp.exceptions import ToolError  # noqa: E402\n    37→from fastmcp.server.lifespan import lifespan  # noqa: E402\n    38→from fastmcp.server.middleware import Middleware  # noqa: E402\n    39→\n    40→from claude_teams import messaging, opencode_client, tasks, teams  # noqa: E402\n    41→from claude_teams.models import (  # noqa: E402\n    42→    SendMessageResult,\n    43→    ShutdownApproved,\n    44→    SpawnResult,\n    45→    TeammateMember,\n    46→)\n    47→from claude_teams.opencode_client import OpenCodeAPIError  # noqa: E402\n    48→from claude_teams.spawner import (  # noqa: E402\n    49→    discover_harness_binary,\n    50→    discover_opencode_models,\n    51→    kill_tmux_pane,\n    52→    spawn_teammate,\n    53→    use_tmux_windows,\n    54→)\n    55→\n    56→logger = logging.getLogger(__name__)\n    57→\n    58→# ---------------------------------------------------------------------------\n    59→# Harness / client detection (mirrors claude-code-teams-mcp)\n    60→# ---------------------------------------------------------------------------\n    61→KNOWN_CLIENTS: dict[str, str] = {\n    62→    \"claude-code\": \"claude\",\n    63→    \"claude\": \"claude\",\n    64→    \"opencode\": \"opencode\",\n    65→}\n    66→\n    67→_VALID_BACKENDS = frozenset(KNOWN_CLIENTS.values())\n    68→\n    69→# NOTE: Mutated by both app_lifespan and HarnessDetectionMiddleware.\n    70→# Safe under stdio (single session).\n    71→_lifespan_state: dict[str, Any] = {}\n    72→\n    73→# Reference to the spawn_teammate tool for dynamic description updates\n    74→_spawn_tool: Any = None\n    75→\n    76→\n    77→# ---------------------------------------------------------------------------\n    78→# Dashboard thread\n    79→# ---------------------------------------------------------------------------\n    80→def _find_free_port(preferred: int, host: str) -> int:\n    81→    port = preferred\n    82→    while port <= 65535:\n    83→        try:\n    84→            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:\n    85→                sock.bind((host, port))\n    86→                return port\n    87→        except OSError:\n    88→            port += 1\n    89→    raise RuntimeError(f\"No free ports found starting from {preferred}\")\n    90→\n    91→\n    92→def _run_uvicorn_in_thread(host: str, port: int) -> threading.Thread:\n    93→    import uvicorn\n    94→\n    95→    from server.app import app\n    96→\n    97→    config = uvicorn.Config(app, host=host, port=port, log_level=\"warning\")\n    98→    server = uvicorn.Server(config)\n    99→    thread = threading.Thread(target=server.run, daemon=True)\n   100→    thread.start()\n   101→    return thread\n   102→\n   103→\n   104→# ---------------------------------------------------------------------------\n   105→# Backend helpers\n   106→# ---------------------------------------------------------------------------\n   107→def _parse_backends_env(raw: str) -> list[str]:\n   108→    if not raw:\n   109→        return []\n   110→    return list(dict.fromkeys(\n   111→        b.strip() for b in raw.split(\",\")\n   112→        if b.strip() and b.strip() in _VALID_BACKENDS\n   113→    ))\n   114→\n   115→\n   116→def _start_opencode_serve(\n   117→    opencode_binary: str, preferred_port: int\n   118→) -> tuple[subprocess.Popen, str]:\n   119→    import urllib.request\n   120→\n   121→    port = _find_free_port(preferred_port, \"127.0.0.1\")\n   122→    proc = subprocess.Popen(\n   123→        [opencode_binary, \"serve\", \"--port\", str(port)],\n   124→        stdin=subprocess.DEVNULL,\n   125→        stdout=subprocess.DEVNULL,\n   126→        stderr=subprocess.DEVNULL,\n   127→    )\n   128→    url = f\"http://127.0.0.1:{port}\"\n   129→\n   130→    for _ in range(50):\n   131→        if proc.poll() is not None:\n   132→            raise RuntimeError(\n   133→                f\"opencode serve exited with code {proc.returncode}\"\n   134→            )\n   135→        try:\n   136→            urllib.request.urlopen(f\"{url}/agent\", timeout=1)\n   137→            return proc, url\n   138→        except Exception:\n   139→            time.sleep(0.2)\n   140→\n   141→    proc.terminate()\n   142→    raise RuntimeError(\n   143→        f\"opencode serve failed to respond on port {port} within 10s\"\n   144→    )\n   145→\n   146→\n   147→# ---------------------------------------------------------------------------\n   148→# Spawn tool description builder (mirrors reference)\n   149→# ---------------------------------------------------------------------------\n   150→_SPAWN_TOOL_BASE_DESCRIPTION = (\n   151→    \"Spawn a new teammate in a tmux {target}. The teammate receives its initial \"\n   152→    \"prompt via inbox and begins working autonomously. Names must be unique \"\n   153→    \"within the team.\"\n   154→)\n   155→\n   156→\n   157→def _build_spawn_description(\n   158→    claude_binary: str | None,\n   159→    opencode_binary: str | None,\n   160→    opencode_models: list[str],\n   161→    opencode_server_url: str | None = None,\n   162→    opencode_agents: list[dict] | None = None,\n   163→    enabled_backends: list[str] | None = None,\n   164→) -> str:\n   165→    tmux_target = \"window\" if use_tmux_windows() else \"pane\"\n   166→    parts = [_SPAWN_TOOL_BASE_DESCRIPTION.format(target=tmux_target)]\n   167→    backends = []\n   168→    show_claude = claude_binary is not None\n   169→    show_opencode = (\n   170→        opencode_binary is not None and opencode_server_url is not None\n   171→    )\n   172→    if enabled_backends is not None:\n   173→        show_claude = show_claude and \"claude\" in enabled_backends\n   174→        show_opencode = show_opencode and \"opencode\" in enabled_backends\n   175→    if show_claude:\n   176→        backends.append(\"'claude' (default, models: sonnet, opus, haiku)\")\n   177→    if show_opencode:\n   178→        model_list = (\n   179→            \", \".join(opencode_models) if opencode_models else \"none discovered\"\n   180→        )\n   181→        backends.append(f\"'opencode' (models: {model_list})\")\n   182→    if backends:\n   183→        parts.append(f\"Available backends: {'; '.join(backends)}.\")\n   184→    if show_opencode and opencode_agents:\n   185→        agent_lines = [\n   186→            f\"  - {a['name']}: {a['description']}\" for a in opencode_agents\n   187→        ]\n   188→        parts.append(\n   189→            \"Available opencode agents (pass as subagent_type when \"\n   190→            \"backend_type='opencode'):\\n\" + \"\\n\".join(agent_lines)\n   191→        )\n   192→    return \" \".join(parts)\n   193→\n   194→\n   195→def _update_spawn_tool(\n   196→    tool: Any, enabled: list[str], state: dict[str, Any]\n   197→) -> None:\n   198→    tool.parameters[\"properties\"][\"backend_type\"][\"enum\"] = list(enabled)\n   199→    if enabled:\n   200→        tool.parameters[\"properties\"][\"backend_type\"][\"default\"] = enabled[0]"}]},"parent_tool_use_id":"toolu_01UWjZvNU1MyBFPkJ6FSAJK4","session_id":"fe920b97-a686-4daa-9f39-67e009025eb9","uuid":"a91f7b20-beb9-4bc4-a69a-bd0c1092037d"}
{"type":"assistant","message":{"model":"claude-sonnet-4-5-20250929","id":"msg_01Gid2mavSurrZie8NbEqVLq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BsBavcfsjuuxbzWQCmx285","name":"Read","input":{"file_path":"C:\\Users\\Grove\\OneDrive\\Documents\\PYTHON\\claude_plugins\\vista\\vista\\server\\services\\provider_service.py"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":7,"cache_creation_input_tokens":1199,"cache_read_input_tokens":38327,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1199},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"toolu_01UWjZvNU1MyBFPkJ6FSAJK4","session_id":"fe920b97-a686-4daa-9f39-67e009025eb9","uuid":"6ff4c364-2456-4cf7-9a7e-7789970cab4b"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BsBavcfsjuuxbzWQCmx285","type":"tool_result","content":"     1→\"\"\"Provider abstraction for multi-CLI support (Claude, OpenCode, etc.).\n     2→\n     3→Single source of truth for Provider classes — portable/ralph.py imports from here.\n     4→Reads configuration from PROJECT_ROOT/settings.json.\n     5→\"\"\"\n     6→\n     7→import json\n     8→import platform\n     9→import re\n    10→import subprocess\n    11→from pathlib import Path\n    12→from typing import Optional\n    13→\n    14→_IS_WINDOWS = platform.system() == \"Windows\"\n    15→\n    16→import os\n    17→import shutil\n    18→\n    19→from server import config\n    20→\n    21→\n    22→def _find_command(name: str) -> Optional[str]:\n    23→    \"\"\"Find a CLI command, checking PATH and common install locations.\"\"\"\n    24→    found = shutil.which(name)\n    25→    if found:\n    26→        return found\n    27→    # Check common install locations not always on PATH\n    28→    if _IS_WINDOWS:\n    29→        candidates = [\n    30→            os.path.join(os.environ.get(\"APPDATA\", \"\"), \"npm\", f\"{name}.cmd\"),\n    31→            os.path.join(\n    32→                os.environ.get(\"LOCALAPPDATA\", \"\"), \"Programs\", name, f\"{name}.exe\"\n    33→            ),\n    34→        ]\n    35→    else:\n    36→        candidates = [\n    37→            os.path.expanduser(f\"~/.local/bin/{name}\"),\n    38→            os.path.expanduser(f\"~/go/bin/{name}\"),\n    39→            f\"/usr/local/bin/{name}\",\n    40→        ]\n    41→    for path in candidates:\n    42→        if path and os.path.isfile(path):\n    43→            return path\n    44→    return None\n    45→\n    46→\n    47→def _run_cli_with_timeout(cmd: list[str], timeout: int = 10) -> Optional[str]:\n    48→    \"\"\"Run a CLI command with proper timeout + process-tree cleanup on Windows.\n    49→\n    50→    Returns combined stdout+stderr on success, None on failure/timeout.\n    51→    \"\"\"\n    52→    kwargs = {\n    53→        \"stdout\": subprocess.PIPE,\n    54→        \"stderr\": subprocess.PIPE,\n    55→        \"stdin\": subprocess.DEVNULL,\n    56→        \"text\": True,\n    57→    }\n    58→    if _IS_WINDOWS:\n    59→        # CREATE_NO_WINDOW prevents console allocation hang in daemon/MCP context\n    60→        kwargs[\"creationflags\"] = subprocess.CREATE_NO_WINDOW\n    61→        # Use explicit cmd.exe /c for .cmd/.bat wrappers instead of shell=True\n    62→        if cmd[0].endswith((\".cmd\", \".bat\")):\n    63→            cmd = [\"cmd.exe\", \"/c\"] + cmd\n    64→\n    65→    proc = subprocess.Popen(cmd, **kwargs)  # type: ignore[arg-type]\n    66→    try:\n    67→        stdout, stderr = proc.communicate(timeout=timeout)\n    68→    except subprocess.TimeoutExpired:\n    69→        if _IS_WINDOWS:\n    70→            # Kill entire process tree; plain proc.kill() only kills cmd.exe\n    71→            subprocess.run(\n    72→                [\"taskkill\", \"/T\", \"/F\", \"/PID\", str(proc.pid)],\n    73→                capture_output=True,\n    74→                timeout=5,\n    75→            )\n    76→        else:\n    77→            proc.kill()\n    78→        try:\n    79→            proc.wait(timeout=5)\n    80→        except subprocess.TimeoutExpired:\n    81→            pass\n    82→        return None\n    83→    if proc.returncode != 0:\n    84→        return None\n    85→    return (stdout or \"\") + (stderr or \"\")\n    86→\n    87→\n    88→# ---------------------------------------------------------------------------\n    89→# Provider base + implementations\n    90→# ---------------------------------------------------------------------------\n    91→\n    92→\n    93→class Provider:\n    94→    \"\"\"Base class for CLI agent providers.\"\"\"\n    95→\n    96→    name: str = \"\"\n    97→    display_name: str = \"\"\n    98→\n    99→    def get_models(self) -> list[str]:\n   100→        raise NotImplementedError\n   101→\n   102→    def get_invocation(self, shell: str = \"ps1\") -> str:\n   103→        \"\"\"Return shell snippet for invoking the CLI.\n   104→\n   105→        shell: \"ps1\" for PowerShell, \"sh\" for Bash.\n   106→        PowerShell has $PromptContent and $Model available.\n   107→        Bash has $PROMPT_CONTENT and $MODEL available.\n   108→        \"\"\"\n   109→        raise NotImplementedError\n   110→\n   111→    def get_summarizer_command(self, model: str) -> list[str]:\n   112→        \"\"\"Return CLI command list for summarizer invocation.\"\"\"\n   113→        raise NotImplementedError\n   114→\n   115→    # --- Chat streaming interface ---\n   116→\n   117→    @property\n   118→    def supports_streaming(self) -> bool:\n   119→        \"\"\"Whether this provider supports streaming output.\"\"\"\n   120→        return False\n   121→\n   122→    @property\n   123→    def stdin_pipe(self) -> bool:\n   124→        \"\"\"Whether the prompt should be piped via stdin (True) or passed as CLI arg (False).\"\"\"\n   125→        return True\n   126→\n   127→    def get_chat_cmd(\n   128→        self, model: str, *, streaming: bool = False, permissions: bool = False\n   129→    ) -> Optional[list[str]]:\n   130→        \"\"\"Return CLI command list for chat invocation.\n   131→\n   132→        Returns None if the CLI command cannot be found.\n   133→        \"\"\"\n   134→        return None\n   135→\n   136→    def get_persistent_cmd(\n   137→        self, model: str, *, permissions: bool = False\n   138→    ) -> Optional[list[str]]:\n   139→        \"\"\"Return CLI command for a persistent interactive chat process.\n   140→\n   141→        Returns None if the provider doesn't support interactive mode.\n   142→        The process stays alive reading messages from stdin (one per line),\n   143→        responding via stdout, then waiting for the next message.\n   144→        \"\"\"\n   145→        return None\n   146→\n   147→    def parse_stream_event(self, line: str) -> Optional[dict]:\n   148→        \"\"\"Parse one line of streaming output into an event dict.\n   149→\n   150→        Returns {\"type\": \"token\", \"text\": \"...\"} for content tokens,\n   151→                {\"type\": \"result\", ...} for completion,\n   152→                None for lines to skip.\n   153→        \"\"\"\n   154→        return None\n   155→\n   156→    # --- Serialization ---\n   157→\n   158→    def to_dict(self) -> dict:\n   159→        \"\"\"Full dict including models (calls get_models() which may run CLI).\"\"\"\n   160→        return {\n   161→            \"name\": self.name,\n   162→            \"display_name\": self.display_name,\n   163→            \"models\": self.get_models(),\n   164→        }\n   165→\n   166→    def to_summary_dict(self) -> dict:\n   167→        \"\"\"Lightweight dict without models — safe for page-load use.\"\"\"\n   168→        return {\n   169→            \"name\": self.name,\n   170→            \"display_name\": self.display_name,\n   171→        }\n   172→\n   173→\n   174→class ClaudeProvider(Provider):\n   175→    name = \"claude\"\n   176→    display_name = \"Claude Code\"\n   177→\n   178→    def get_models(self) -> list[str]:\n   179→        return [\"opus\", \"sonnet\", \"haiku\"]\n   180→\n   181→    def get_invocation(self, shell: str = \"ps1\") -> str:\n   182→        if shell == \"sh\":\n   183→            return (\n   184→                'printf \"%s\" \"$PROMPT_CONTENT\" | claude -p \\\\\\n'\n   185→                \"        --dangerously-skip-permissions \\\\\\n\"\n   186→                \"        --output-format=stream-json \\\\\\n\"\n   187→                '        --model \"$MODEL\" \\\\\\n'\n   188→                \"        --verbose\"\n   189→            )\n   190→        return (\n   191→            \"$PromptContent | claude -p `\\n\"\n   192→            \"        --dangerously-skip-permissions `\\n\"\n   193→            \"        --output-format=stream-json `\\n\"\n   194→            \"        --model $Model `\\n\"\n   195→            \"        --verbose\"\n   196→        )\n   197→\n   198→    def get_summarizer_command(self, model: str) -> list[str]:\n   199→        cmd_path = _find_command(\"claude\")\n   200→        if cmd_path is None:\n   201→            return []\n   202→        return [cmd_path, \"-p\", \"--model\", model, \"--output-format\", \"text\"]\n   203→\n   204→    def get_chat_cmd(\n   205→        self, model: str, *, streaming: bool = False, permissions: bool = False\n   206→    ) -> Optional[list[str]]:\n   207→        cmd_path = _find_command(\"claude\")\n   208→        if cmd_path is None:\n   209→            return None\n   210→        cmd = [cmd_path, \"-p\", \"--model\", model]\n   211→        if permissions:\n   212→            cmd.append(\"--dangerously-skip-permissions\")\n   213→        if streaming:\n   214→            cmd.extend([\"--output-format\", \"stream-json\", \"--verbose\"])\n   215→        return cmd\n   216→\n   217→    def get_persistent_cmd(\n   218→        self, model: str, *, permissions: bool = False\n   219→    ) -> Optional[list[str]]:\n   220→        cmd_path = _find_command(\"claude\")\n   221→        if cmd_path is None:\n   222→            return None\n   223→        # Interactive mode (no -p): stays alive, reads messages from stdin\n   224→        cmd = [cmd_path, \"--output-format\", \"stream-json\", \"--verbose\", \"--model\", model]\n   225→        if permissions:\n   226→            cmd.append(\"--dangerously-skip-permissions\")\n   227→        return cmd\n   228→\n   229→    def parse_stream_event(self, line: str) -> Optional[dict]:\n   230→        try:\n   231→            data = json.loads(line)\n   232→        except (json.JSONDecodeError, ValueError):\n   233→            return None\n   234→        msg_type = data.get(\"type\")\n   235→        if msg_type == \"assistant\":\n   236→            text = data.get(\"text\", \"\")\n   237→            if text:\n   238→                return {\"type\": \"token\", \"text\": text}\n   239→        elif msg_type == \"result\":\n   240→            return {\n   241→                \"type\": \"result\",\n   242→                \"session_id\": data.get(\"session_id\", \"\"),\n   243→                \"cost\": data.get(\"cost_usd\"),\n   244→                \"duration_ms\": data.get(\"duration_ms\"),\n   245→            }\n   246→        return None\n   247→\n   248→\n   249→class OpenCodeProvider(Provider):\n   250→    name = \"opencode\"\n   251→    display_name = \"OpenCode\"\n   252→\n   253→    def get_models(self) -> list[str]:\n   254→        \"\"\"Discover models via `opencode models` CLI. No filtering applied.\"\"\"\n   255→        try:\n   256→            cmd = _find_command(\"opencode\")\n   257→            if cmd is None:\n   258→                return []\n   259→            output = _run_cli_with_timeout([cmd, \"models\"], timeout=10)\n   260→            if output is None:\n   261→                return []\n   262→            models = []\n   263→            for line in output.splitlines():\n   264→                line = line.strip()\n   265→                if not line:\n   266→                    continue\n   267→                # Only skip log noise lines\n   268→                if re.match(\n   269→                    r\"^(INFO|DEBUG|WARN|ERROR|FATAL|CRITICAL)\\b\",\n   270→                    line,\n   271→                ):\n   272→                    continue\n   273→                models.append(line)\n   274→            if models:\n   275→                return models\n   276→        except (FileNotFoundError, OSError):\n   277→            pass\n   278→        return []\n   279→\n   280→    def get_invocation(self, shell: str = \"ps1\") -> str:\n   281→        if shell == \"sh\":\n   282→            return 'opencode run --model \"$MODEL\" \"$PROMPT_CONTENT\"'\n   283→        return \"opencode run --model $Model $PromptContent\"\n   284→\n   285→    def get_chat_cmd(\n   286→        self, model: str, *, streaming: bool = False, permissions: bool = False\n   287→    ) -> Optional[list[str]]:\n   288→        cmd_path = _find_command(\"opencode\")\n   289→        if cmd_path is None:\n   290→            return None\n   291→        return [cmd_path, \"run\", \"--model\", model]\n   292→\n   293→    def get_summarizer_command(self, model: str) -> list[str]:\n   294→        cmd_path = _find_command(\"opencode\")\n   295→        if cmd_path is None:\n   296→            return []\n   297→        return [cmd_path, \"run\", \"--model\", model]\n   298→\n   299→\n   300→# ---------------------------------------------------------------------------\n   301→# Registry & settings\n   302→# ---------------------------------------------------------------------------\n   303→\n   304→_PROVIDER_REGISTRY: dict[str, type[Provider]] = {\n   305→    \"claude\": ClaudeProvider,\n   306→    \"opencode\": OpenCodeProvider,\n   307→}\n   308→\n   309→_DEFAULT_SETTINGS = {\n   310→    \"providers\": {\n   311→        \"claude\": {\"enabled\": True, \"display_name\": \"Claude Code\"},\n   312→    }\n   313→}\n   314→\n   315→\n   316→def get_enabled_providers(settings: Optional[dict] = None) -> list[Provider]:\n   317→    \"\"\"Instantiate enabled providers from settings.\"\"\"\n   318→    if settings is None:\n   319→        raw = config.load_settings()\n   320→        settings = {**_DEFAULT_SETTINGS, **raw}\n   321→    providers_cfg = settings.get(\"providers\", {})\n   322→    enabled: list[Provider] = []\n   323→    for key, cfg in providers_cfg.items():\n   324→        if not cfg.get(\"enabled\", False):\n   325→            continue\n   326→        cls = _PROVIDER_REGISTRY.get(key)\n   327→        if cls is None:\n   328→            continue\n   329→        provider = cls()\n   330→        if \"display_name\" in cfg:\n   331→            provider.display_name = cfg[\"display_name\"]\n   332→        enabled.append(provider)\n   333→    return enabled\n   334→\n   335→\n   336→def get_provider_by_name(name: str) -> Optional[Provider]:\n   337→    \"\"\"Get a specific enabled provider by name, or None.\"\"\"\n   338→    for p in get_enabled_providers():\n   339→        if p.name == name:\n   340→            return p\n   341→    return None\n   342→\n   343→\n   344→def _apply_model_filters(\n   345→    models: list[str], allowlist: list[str], blocklist: list[str]\n   346→) -> list[str]:\n   347→    if allowlist:\n   348→        allowed = set(allowlist)\n   349→        return [m for m in models if m in allowed]\n   350→    if blocklist:\n   351→        blocked = set(blocklist)\n   352→        return [m for m in models if m not in blocked]\n   353→    return list(models)\n   354→\n   355→\n   356→def get_ralph_providers() -> list[dict]:\n   357→    \"\"\"Return enabled providers with filtered model lists and metadata for ralph MCP tools.\"\"\"\n   358→    settings = config.load_settings()\n   359→    ralph_cfg = config.get_ralph_settings()\n   360→    ralph_providers = ralph_cfg.get(\"providers\", {})\n   361→\n   362→    enabled = []\n   363→    top_level_enabled = {p.name: p for p in get_enabled_providers(settings)}\n   364→    if ralph_providers:\n   365→        provider_names = [\n   366→            name for name, cfg in ralph_providers.items() if cfg.get(\"enabled\")\n   367→        ]\n   368→    else:\n   369→        provider_names = list(top_level_enabled.keys())\n   370→\n   371→    for name in provider_names:\n   372→        provider = top_level_enabled.get(name)\n   373→        if provider is None:\n   374→            continue\n   375→        cfg = ralph_providers.get(name, {})\n   376→        live_models = provider.get_models()\n   377→        allowlist = cfg.get(\"models_allowed\", []) or []\n   378→        blocklist = cfg.get(\"models_blocked\", []) or []\n   379→        filtered = _apply_model_filters(live_models, allowlist, blocklist)\n   380→        metadata = cfg.get(\"model_metadata\", {}) or {}\n   381→        models = []\n   382→        for model in filtered:\n   383→            entry = metadata.get(model, {}) or {}\n   384→            models.append(\n   385→                {\n   386→                    \"id\": model,\n   387→                    \"cost_tier\": entry.get(\"cost_tier\"),\n   388→                    \"best_for_tags\": entry.get(\"best_for_tags\", []) or [],\n   389→                    \"best_for_notes\": entry.get(\"best_for_notes\", \"\") or \"\",\n   390→                }\n   391→            )\n   392→        enabled.append(\n   393→            {\n   394→                \"name\": provider.name,\n   395→                \"display_name\": provider.display_name,\n   396→                \"models\": models,\n   397→                \"favorites\": (cfg.get(\"favorites\") or [])[:3],\n   398→            }\n   399→        )\n   400→    return enabled\n   401→\n   402→\n   403→def get_ralph_defaults() -> dict:\n   404→    \"\"\"Return default provider/model/iterations for ralph_start.\"\"\"\n   405→    return config.get_ralph_defaults()\n   406→\n   407→\n   408→def get_summarizer_config() -> dict:\n   409→    \"\"\"Return summarizer provider/model configuration.\"\"\"\n   410→    return config.get_summarizer_config()\n   411→"}]},"parent_tool_use_id":"toolu_01UWjZvNU1MyBFPkJ6FSAJK4","session_id":"fe920b97-a686-4daa-9f39-67e009025eb9","uuid":"ccb965de-dde2-4094-a3e0-f3f279e9e49f"}
