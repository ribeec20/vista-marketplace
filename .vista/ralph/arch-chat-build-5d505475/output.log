{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018UjRC8BxnS4jj2FAXZ8wnA","type":"tool_result","content":"     1→\"\"\"Chat session API routes with SSE streaming and live diagram updates.\n     2→\n     3→Uses ProviderRouter for protocol-native streaming (Claude WebSocket, OpenCode SSE)\n     4→with fallback to CLI-based one-shot mode via ChatService.\n     5→\"\"\"\n     6→\n     7→import asyncio\n     8→import json\n     9→import logging\n    10→from pathlib import Path\n    11→from typing import Optional\n    12→\n    13→from fastapi import APIRouter, HTTPException, Request\n    14→from pydantic import BaseModel, Field\n    15→from sse_starlette.sse import EventSourceResponse\n    16→\n    17→from server.services.project_service import ProjectService\n    18→from server.services.chat_session_service import ChatSessionService\n    19→from server.services.chat_service import chat_service\n    20→from server.services.context_assembler import ContextAssembler\n    21→from server.services.keepalive_manager import keepalive_manager\n    22→from server.services.diagram_watcher import diagram_watcher\n    23→from server.services.provider_router import provider_router\n    24→from server.services.service_lifecycle import service_lifecycle\n    25→\n    26→log = logging.getLogger(__name__)\n    27→router = APIRouter(tags=[\"chat_sessions\"])\n    28→\n    29→# Per-session SSE subscriber queues\n    30→_session_subscribers: dict[str, list[asyncio.Queue]] = {}\n    31→\n    32→\n    33→def _subscribe(session_id: str) -> asyncio.Queue:\n    34→    if session_id not in _session_subscribers:\n    35→        _session_subscribers[session_id] = []\n    36→    queue: asyncio.Queue = asyncio.Queue(maxsize=500)\n    37→    _session_subscribers[session_id].append(queue)\n    38→    return queue\n    39→\n    40→\n    41→def _unsubscribe(session_id: str, queue: asyncio.Queue) -> None:\n    42→    if session_id in _session_subscribers:\n    43→        _session_subscribers[session_id] = [\n    44→            q for q in _session_subscribers[session_id] if q is not queue\n    45→        ]\n    46→        if not _session_subscribers[session_id]:\n    47→            del _session_subscribers[session_id]\n    48→\n    49→\n    50→async def _broadcast(session_id: str, message: dict) -> None:\n    51→    if session_id not in _session_subscribers:\n    52→        return\n    53→    dead = []\n    54→    for queue in _session_subscribers[session_id]:\n    55→        try:\n    56→            queue.put_nowait(message)\n    57→        except asyncio.QueueFull:\n    58→            dead.append(queue)\n    59→    for q in dead:\n    60→        if session_id in _session_subscribers:\n    61→            _session_subscribers[session_id].remove(q)\n    62→\n    63→\n    64→# ---------------------------------------------------------------------------\n    65→# Request / response models\n    66→# ---------------------------------------------------------------------------\n    67→\n    68→class CreateSessionRequest(BaseModel):\n    69→    feature_name: str\n    70→    provider: str\n    71→    model: str\n    72→    name: str = \"\"\n    73→    mode: str = Field(\"oneshot\", description=\"'oneshot' or 'persistent'\")\n    74→\n    75→\n    76→class SendMessageRequest(BaseModel):\n    77→    message: str\n    78→    context: Optional[str] = Field(None, description=\"Pre-assembled diagram context\")\n    79→    provider: Optional[str] = Field(None, description=\"Provider to use (overrides session default)\")\n    80→    model: Optional[str] = Field(None, description=\"Model to use (overrides session default)\")\n    81→    mode: str = Field(\"oneshot\", description=\"'oneshot' or 'persistent'\")\n    82→\n    83→\n    84→class RenameSessionRequest(BaseModel):\n    85→    name: str\n    86→\n    87→\n    88→# ---------------------------------------------------------------------------\n    89→# Session CRUD\n    90→# ---------------------------------------------------------------------------\n    91→\n    92→@router.get(\"/api/projects/{project_id}/chat/sessions\")\n    93→async def list_sessions(project_id: str, feature: Optional[str] = None):\n    94→    project = ProjectService.get_by_id(project_id)\n    95→    if not project:\n    96→        raise HTTPException(status_code=404, detail=\"Project not found\")\n    97→    return ChatSessionService.list_sessions(project_id, feature)\n    98→\n    99→\n   100→@router.post(\"/api/projects/{project_id}/chat/sessions\")\n   101→async def create_session(project_id: str, body: CreateSessionRequest):\n   102→    project = ProjectService.get_by_id(project_id)\n   103→    if not project:\n   104→        raise HTTPException(status_code=404, detail=\"Project not found\")\n   105→\n   106→    session = ChatSessionService.create(\n   107→        project_id=project_id,\n   108→        feature_name=body.feature_name,\n   109→        provider=body.provider,\n   110→        model=body.model,\n   111→        name=body.name,\n   112→    )\n   113→\n   114→    # For persistent mode, spawn the agent immediately (legacy tmux path)\n   115→    if body.mode == \"persistent\":\n   116→        arch_dir = str(\n   117→            Path(project.path) / \".vista\" / \"features\" / body.feature_name / \"arch\"\n   118→        )\n   119→        system_prompt = chat_service.build_prompt(\n   120→            message=\"(session started — awaiting first message)\",\n   121→            context=None,\n   122→            history=None,\n   123→            arch_dir=arch_dir,\n   124→            project_root=project.path,\n   125→        )\n   126→        try:\n   127→            team_name = keepalive_manager.start(\n   128→                session_id=session.id,\n   129→                provider=body.provider,\n   130→                model=body.model,\n   131→                system_prompt=system_prompt,\n   132→                cwd=project.path,\n   133→            )\n   134→            session.team_name = team_name\n   135→            ChatSessionService.save(session)\n   136→        except Exception as e:\n   137→            log.error(\"Failed to start keep-alive agent: %s\", e, exc_info=True)\n   138→            # Session is still usable in oneshot mode\n   139→\n   140→    return session.to_dict()\n   141→\n   142→\n   143→@router.get(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\n   144→async def get_session(project_id: str, session_id: str):\n   145→    session = ChatSessionService.get(project_id, session_id)\n   146→    if not session:\n   147→        raise HTTPException(status_code=404, detail=\"Session not found\")\n   148→    return session.to_dict()\n   149→\n   150→\n   151→@router.delete(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\n   152→async def delete_session(project_id: str, session_id: str):\n   153→    session = ChatSessionService.get(project_id, session_id)\n   154→    if session:\n   155→        if session.team_name:\n   156→            keepalive_manager.stop()\n   157→        if session.backend_session_id:\n   158→            await provider_router.cleanup_session(session_id)\n   159→    deleted = ChatSessionService.delete(project_id, session_id)\n   160→    if not deleted:\n   161→        raise HTTPException(status_code=404, detail=\"Session not found\")\n   162→    return {\"deleted\": True}\n   163→\n   164→\n   165→@router.patch(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\n   166→async def rename_session(project_id: str, session_id: str, body: RenameSessionRequest):\n   167→    session = ChatSessionService.update_name(project_id, session_id, body.name)\n   168→    if not session:\n   169→        raise HTTPException(status_code=404, detail=\"Session not found\")\n   170→    return session.to_summary_dict()\n   171→\n   172→\n   173→# ---------------------------------------------------------------------------\n   174→# Send message (triggers streaming via SSE)\n   175→# ---------------------------------------------------------------------------\n   176→\n   177→def _provider_has_backend(provider_name: str) -> bool:\n   178→    \"\"\"Check if a provider has a running backend service for protocol-native chat.\"\"\"\n   179→    if provider_name == \"claude\":\n   180→        return service_lifecycle.is_available(\"companion\")\n   181→    elif provider_name == \"opencode\":\n   182→        return service_lifecycle.is_available(\"opencode\")\n   183→    return False\n   184→\n   185→\n   186→@router.post(\"/api/projects/{project_id}/chat/sessions/{session_id}/messages\")\n   187→async def send_message(project_id: str, session_id: str, body: SendMessageRequest):\n   188→    \"\"\"Send a user message. Streams the response via the session's SSE endpoint.\"\"\"\n   189→    project = ProjectService.get_by_id(project_id)\n   190→    if not project:\n   191→        raise HTTPException(status_code=404, detail=\"Project not found\")\n   192→\n   193→    session = ChatSessionService.get(project_id, session_id)\n   194→    if not session:\n   195→        raise HTTPException(status_code=404, detail=\"Session not found\")\n   196→\n   197→    if not body.message.strip():\n   198→        raise HTTPException(status_code=400, detail=\"Message is required\")\n   199→\n   200→    # Use provider/model from request, fall back to session defaults\n   201→    provider_name = body.provider or session.provider\n   202→    model_name = body.model or session.model\n   203→\n   204→    # Update session defaults if the user changed provider/model\n   205→    if provider_name != session.provider or model_name != session.model:\n   206→        session.provider = provider_name\n   207→        session.model = model_name\n   208→        ChatSessionService.save(session)\n   209→\n   210→    # Save user message\n   211→    session = ChatSessionService.add_message(project_id, session_id, \"user\", body.message)\n   212→\n   213→    arch_dir = str(\n   214→        Path(project.path) / \".vista\" / \"features\" / session.feature_name / \"arch\"\n   215→    )\n   216→    specs_dir = str(\n   217→        Path(project.path) / \".vista\" / \"features\" / session.feature_name / \"specs\"\n   218→    )\n   219→\n   220→    # Build prompt using ContextAssembler\n   221→    system_prompt = ContextAssembler.build_system_prompt(arch_dir, specs_dir, project.path)\n   222→    all_msgs = [{\"role\": m.role, \"content\": m.content} for m in session.messages]\n   223→    history = all_msgs[:-1] if len(all_msgs) > 1 else None\n   224→    prompt = ContextAssembler.build_full_prompt(\n   225→        message=body.message,\n   226→        context=body.context,\n   227→        history=history,\n   228→        system_prompt=system_prompt,\n   229→    )\n   230→\n   231→    use_persistent = body.mode == \"persistent\"\n   232→\n   233→    # Decide routing: protocol-native (ProviderRouter) vs CLI fallback\n   234→    if _provider_has_backend(provider_name) and not use_persistent:\n   235→        # Protocol-native path via ProviderRouter\n   236→        # Ensure backend session exists\n   237→        if not session.backend_session_id:\n   238→            try:\n   239→                backend_id = await provider_router.create_backend_session(\n   240→                    provider=provider_name,\n   241→                    model=model_name,\n   242→                    session_id=session_id,\n   243→                    cwd=project.path,\n   244→                )\n   245→                session.backend_session_id = backend_id\n   246→                ChatSessionService.save(session)\n   247→            except Exception as e:\n   248→                log.error(\"Failed to create backend session: %s\", e)\n   249→                # Fall through to CLI fallback below\n   250→\n   251→        if session.backend_session_id:\n   252→            asyncio.create_task(\n   253→                _stream_response_router(\n   254→                    project_id, session_id, provider_name,\n   255→                    model_name, prompt, project.path,\n   256→                )\n   257→            )\n   258→            return {\"status\": \"streaming\", \"session_id\": session_id, \"mode\": \"router\"}\n   259→\n   260→    if use_persistent:\n   261→        # Persistent mode via keepalive_manager (legacy tmux + inbox messaging)\n   262→        agent_alive = keepalive_manager.is_alive(session_id)\n   263→\n   264→        if not agent_alive and session.team_name:\n   265→            agent_alive = keepalive_manager.resume(session_id, session.team_name)\n   266→\n   267→        if not agent_alive:\n   268→            # Cold start with full history\n   269→            try:\n   270→                team_name = keepalive_manager.start(\n   271→                    session_id=session_id,\n   272→                    provider=provider_name,\n   273→                    model=model_name,\n   274→                    system_prompt=prompt,\n   275→                    cwd=project.path,\n   276→                )\n   277→                session.team_name = team_name\n   278→                ChatSessionService.save(session)\n   279→            except Exception as e:\n   280→                await _broadcast(session_id, {\n   281→                    \"event\": \"chat_error\",\n   282→                    \"data\": {\"detail\": f\"Failed to start agent: {e}\"},\n   283→                })\n   284→                return {\"status\": \"error\", \"session_id\": session_id, \"mode\": body.mode}\n   285→        else:\n   286→            keepalive_manager.send_message(session_id, body.message, context=body.context)\n   287→\n   288→        asyncio.create_task(\n   289→            _stream_response_keepalive(project_id, session_id)\n   290→        )\n   291→    else:\n   292→        # CLI one-shot fallback (no backend service available)\n   293→        asyncio.create_task(\n   294→            _stream_response(project_id, session_id, provider_name, model_name, prompt, project.path)\n   295→        )\n   296→\n   297→    return {\"status\": \"streaming\", \"session_id\": session_id, \"mode\": body.mode}\n   298→\n   299→\n   300→# ---------------------------------------------------------------------------\n   301→# Streaming response handlers\n   302→# ---------------------------------------------------------------------------\n   303→\n   304→async def _stream_response_router(\n   305→    project_id: str,\n   306→    session_id: str,\n   307→    provider_name: str,\n   308→    model: str,\n   309→    prompt: str,\n   310→    project_path: str,\n   311→) -> None:\n   312→    \"\"\"Background task: stream via ProviderRouter (protocol-native).\"\"\"\n   313→    full_text: list[str] = []\n   314→\n   315→    try:\n   316→        async for event in provider_router.send_message(\n   317→            provider=provider_name,\n   318→            model=model,\n   319→            prompt=prompt,\n   320→            session_id=session_id,\n   321→            cwd=project_path,\n   322→        ):\n   323→            if event[\"type\"] == \"token\":\n   324→                full_text.append(event[\"text\"])\n   325→                await _broadcast(session_id, {\n   326→                    \"event\": \"token\",\n   327→                    \"data\": {\"text\": event[\"text\"]},\n   328→                })\n   329→            elif event[\"type\"] == \"done\":\n   330→                content = event.get(\"content\", \"\".join(full_text))\n   331→                ChatSessionService.add_message(project_id, session_id, \"assistant\", content)\n   332→                await _broadcast(session_id, {\n   333→                    \"event\": \"message_done\",\n   334→                    \"data\": {\"role\": \"assistant\", \"content\": content},\n   335→                })\n   336→            elif event[\"type\"] == \"result\":\n   337→                await _broadcast(session_id, {\n   338→                    \"event\": \"result\",\n   339→                    \"data\": event,\n   340→                })\n   341→            elif event[\"type\"] == \"error\":\n   342→                await _broadcast(session_id, {\n   343→                    \"event\": \"chat_error\",\n   344→                    \"data\": {\"detail\": event[\"detail\"]},\n   345→                })\n   346→    except Exception as e:\n   347→        await _broadcast(session_id, {\n   348→            \"event\": \"chat_error\",\n   349→            \"data\": {\"detail\": str(e)},\n   350→        })\n   351→\n   352→\n   353→async def _stream_response(\n   354→    project_id: str,\n   355→    session_id: str,\n   356→    provider_name: str,\n   357→    model: str,\n   358→    prompt: str,\n   359→    project_path: str,\n   360→) -> None:\n   361→    \"\"\"Background task: stream CLI response (fallback path).\"\"\"\n   362→    full_text: list[str] = []\n   363→\n   364→    try:\n   365→        async for event in chat_service.invoke_provider_streaming(\n   366→            provider_name=provider_name,\n   367→            model=model,\n   368→            prompt=prompt,\n   369→            cwd=project_path,\n   370→        ):\n   371→            if event[\"type\"] == \"token\":\n   372→                full_text.append(event[\"text\"])\n   373→                await _broadcast(session_id, {\n   374→                    \"event\": \"token\",\n   375→                    \"data\": {\"text\": event[\"text\"]},\n   376→                })\n   377→            elif event[\"type\"] == \"done\":\n   378→                content = event.get(\"content\", \"\".join(full_text))\n   379→                ChatSessionService.add_message(project_id, session_id, \"assistant\", content)\n   380→                await _broadcast(session_id, {\n   381→                    \"event\": \"message_done\",\n   382→                    \"data\": {\"role\": \"assistant\", \"content\": content},\n   383→                })\n   384→            elif event[\"type\"] == \"result\":\n   385→                await _broadcast(session_id, {\n   386→                    \"event\": \"result\",\n   387→                    \"data\": event,\n   388→                })\n   389→            elif event[\"type\"] == \"error\":\n   390→                await _broadcast(session_id, {\n   391→                    \"event\": \"chat_error\",\n   392→                    \"data\": {\"detail\": event[\"detail\"]},\n   393→                })\n   394→    except Exception as e:\n   395→        await _broadcast(session_id, {\n   396→            \"event\": \"chat_error\",\n   397→            \"data\": {\"detail\": str(e)},\n   398→        })\n   399→\n   400→\n   401→async def _stream_response_keepalive(\n   402→    project_id: str,\n   403→    session_id: str,\n   404→) -> None:\n   405→    \"\"\"Background task: poll keepalive agent inbox and push events to SSE.\"\"\"\n   406→    try:\n   407→        async for event in keepalive_manager.poll_response(session_id):\n   408→            if event[\"type\"] == \"token\":\n   409→                await _broadcast(session_id, {\n   410→                    \"event\": \"token\",\n   411→                    \"data\": {\"text\": event[\"text\"]},\n   412→                })\n   413→            elif event[\"type\"] == \"done\":\n   414→                content = event.get(\"content\", \"\")\n   415→                ChatSessionService.add_message(project_id, session_id, \"assistant\", content)\n   416→                await _broadcast(session_id, {\n   417→                    \"event\": \"message_done\",\n   418→                    \"data\": {\"role\": \"assistant\", \"content\": content},\n   419→                })\n   420→            elif event[\"type\"] == \"error\":\n   421→                await _broadcast(session_id, {\n   422→                    \"event\": \"chat_error\",\n   423→                    \"data\": {\"detail\": event[\"detail\"]},\n   424→                })\n   425→    except Exception as e:\n   426→        await _broadcast(session_id, {\n   427→            \"event\": \"chat_error\",\n   428→            \"data\": {\"detail\": str(e)},\n   429→        })\n   430→\n   431→\n   432→# ---------------------------------------------------------------------------\n   433→# Cancel\n   434→# ---------------------------------------------------------------------------\n   435→\n   436→@router.post(\"/api/projects/{project_id}/chat/sessions/{session_id}/cancel\")\n   437→async def cancel_session_chat(project_id: str, session_id: str):\n   438→    # Try one-shot cancel first\n   439→    cancelled = chat_service.cancel()\n   440→    if not cancelled:\n   441→        # For persistent sessions, kill the agent\n   442→        if keepalive_manager.is_alive(session_id):\n   443→            keepalive_manager.stop()\n   444→            cancelled = True\n   445→    return {\"cancelled\": cancelled}\n   446→\n   447→\n   448→# ---------------------------------------------------------------------------\n   449→# SSE streaming endpoint\n   450→# ---------------------------------------------------------------------------\n   451→\n   452→async def _forward_queue(source: asyncio.Queue, dest: asyncio.Queue) -> None:\n   453→    \"\"\"Forward items from source queue to dest queue until cancelled.\"\"\"\n   454→    try:\n   455→        while True:\n   456→            item = await source.get()\n   457→            await dest.put(item)\n   458→    except asyncio.CancelledError:\n   459→        pass\n   460→\n   461→\n   462→@router.get(\"/api/projects/{project_id}/chat/sessions/{session_id}/stream\")\n   463→async def stream_session(project_id: str, session_id: str, request: Request):\n   464→    \"\"\"SSE endpoint delivering chat tokens and diagram change events.\"\"\"\n   465→    project = ProjectService.get_by_id(project_id)\n   466→    if not project:\n   467→        raise HTTPException(status_code=404, detail=\"Project not found\")\n   468→\n   469→    session = ChatSessionService.get(project_id, session_id)\n   470→    if not session:\n   471→        raise HTTPException(status_code=404, detail=\"Session not found\")\n   472→\n   473→    # Cancel any pending disconnect cleanup (SSE reconnected)\n   474→    keepalive_manager.cancel_disconnect_cleanup(session_id)\n   475→\n   476→    # Subscribe to chat events\n   477→    chat_queue = _subscribe(session_id)\n   478→\n   479→    # Subscribe to diagram watcher\n   480→    arch_dir = Path(project.path) / \".vista\" / \"features\" / session.feature_name / \"arch\"\n   481→    diagram_queue = diagram_watcher.subscribe(project_id, session.feature_name, arch_dir)\n   482→\n   483→    # Merge both queues into one so the generator reads from a single source\n   484→    merged: asyncio.Queue = asyncio.Queue(maxsize=500)\n   485→\n   486→    async def event_generator():\n   487→        fwd_chat = asyncio.create_task(_forward_queue(chat_queue, merged))\n   488→        fwd_diagram = asyncio.create_task(_forward_queue(diagram_queue, merged))\n   489→        try:\n   490→            while True:\n   491→                if await request.is_disconnected():\n   492→                    break\n   493→                try:\n   494→                    event = await asyncio.wait_for(merged.get(), timeout=30.0)\n   495→                    yield {\n   496→                        \"event\": event.get(\"event\", \"message\"),\n   497→                        \"data\": json.dumps(event.get(\"data\", {})),\n   498→                    }\n   499→                except asyncio.TimeoutError:\n   500→                    yield {\"event\": \"ping\", \"data\": \"\"}\n   501→        except asyncio.CancelledError:\n   502→            pass\n   503→        finally:\n   504→            fwd_chat.cancel()\n   505→            fwd_diagram.cancel()\n   506→            _unsubscribe(session_id, chat_queue)\n   507→            diagram_watcher.unsubscribe(project_id, session.feature_name, diagram_queue)\n   508→            # Start disconnect grace period for persistent sessions\n   509→            if session.team_name:\n   510→                keepalive_manager.schedule_disconnect_cleanup(session_id, grace_seconds=10)\n   511→\n   512→    return EventSourceResponse(event_generator())\n   513→"}]},"parent_tool_use_id":null,"session_id":"41eb5763-1813-40b4-994f-a8833bfca10e","uuid":"b8586c68-2e11-43e3-b13e-1813985e5831","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/routes/chat_sessions.py","content":"\"\"\"Chat session API routes with SSE streaming and live diagram updates.\n\nUses ProviderRouter for protocol-native streaming (Claude WebSocket, OpenCode SSE)\nwith fallback to CLI-based one-shot mode via ChatService.\n\"\"\"\n\nimport asyncio\nimport json\nimport logging\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom fastapi import APIRouter, HTTPException, Request\nfrom pydantic import BaseModel, Field\nfrom sse_starlette.sse import EventSourceResponse\n\nfrom server.services.project_service import ProjectService\nfrom server.services.chat_session_service import ChatSessionService\nfrom server.services.chat_service import chat_service\nfrom server.services.context_assembler import ContextAssembler\nfrom server.services.keepalive_manager import keepalive_manager\nfrom server.services.diagram_watcher import diagram_watcher\nfrom server.services.provider_router import provider_router\nfrom server.services.service_lifecycle import service_lifecycle\n\nlog = logging.getLogger(__name__)\nrouter = APIRouter(tags=[\"chat_sessions\"])\n\n# Per-session SSE subscriber queues\n_session_subscribers: dict[str, list[asyncio.Queue]] = {}\n\n\ndef _subscribe(session_id: str) -> asyncio.Queue:\n    if session_id not in _session_subscribers:\n        _session_subscribers[session_id] = []\n    queue: asyncio.Queue = asyncio.Queue(maxsize=500)\n    _session_subscribers[session_id].append(queue)\n    return queue\n\n\ndef _unsubscribe(session_id: str, queue: asyncio.Queue) -> None:\n    if session_id in _session_subscribers:\n        _session_subscribers[session_id] = [\n            q for q in _session_subscribers[session_id] if q is not queue\n        ]\n        if not _session_subscribers[session_id]:\n            del _session_subscribers[session_id]\n\n\nasync def _broadcast(session_id: str, message: dict) -> None:\n    if session_id not in _session_subscribers:\n        return\n    dead = []\n    for queue in _session_subscribers[session_id]:\n        try:\n            queue.put_nowait(message)\n        except asyncio.QueueFull:\n            dead.append(queue)\n    for q in dead:\n        if session_id in _session_subscribers:\n            _session_subscribers[session_id].remove(q)\n\n\n# ---------------------------------------------------------------------------\n# Request / response models\n# ---------------------------------------------------------------------------\n\nclass CreateSessionRequest(BaseModel):\n    feature_name: str\n    provider: str\n    model: str\n    name: str = \"\"\n    mode: str = Field(\"oneshot\", description=\"'oneshot' or 'persistent'\")\n\n\nclass SendMessageRequest(BaseModel):\n    message: str\n    context: Optional[str] = Field(None, description=\"Pre-assembled diagram context\")\n    provider: Optional[str] = Field(None, description=\"Provider to use (overrides session default)\")\n    model: Optional[str] = Field(None, description=\"Model to use (overrides session default)\")\n    mode: str = Field(\"oneshot\", description=\"'oneshot' or 'persistent'\")\n\n\nclass RenameSessionRequest(BaseModel):\n    name: str\n\n\n# ---------------------------------------------------------------------------\n# Session CRUD\n# ---------------------------------------------------------------------------\n\n@router.get(\"/api/projects/{project_id}/chat/sessions\")\nasync def list_sessions(project_id: str, feature: Optional[str] = None):\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n    return ChatSessionService.list_sessions(project_id, feature)\n\n\n@router.post(\"/api/projects/{project_id}/chat/sessions\")\nasync def create_session(project_id: str, body: CreateSessionRequest):\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    session = ChatSessionService.create(\n        project_id=project_id,\n        feature_name=body.feature_name,\n        provider=body.provider,\n        model=body.model,\n        name=body.name,\n    )\n\n    # For persistent mode, spawn the agent immediately (legacy tmux path)\n    if body.mode == \"persistent\":\n        arch_dir = str(\n            Path(project.path) / \".vista\" / \"features\" / body.feature_name / \"arch\"\n        )\n        system_prompt = chat_service.build_prompt(\n            message=\"(session started — awaiting first message)\",\n            context=None,\n            history=None,\n            arch_dir=arch_dir,\n            project_root=project.path,\n        )\n        try:\n            team_name = keepalive_manager.start(\n                session_id=session.id,\n                provider=body.provider,\n                model=body.model,\n                system_prompt=system_prompt,\n                cwd=project.path,\n            )\n            session.team_name = team_name\n            ChatSessionService.save(session)\n        except Exception as e:\n            log.error(\"Failed to start keep-alive agent: %s\", e, exc_info=True)\n            # Session is still usable in oneshot mode\n\n    return session.to_dict()\n\n\n@router.get(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\nasync def get_session(project_id: str, session_id: str):\n    session = ChatSessionService.get(project_id, session_id)\n    if not session:\n        raise HTTPException(status_code=404, detail=\"Session not found\")\n    return session.to_dict()\n\n\n@router.delete(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\nasync def delete_session(project_id: str, session_id: str):\n    session = ChatSessionService.get(project_id, session_id)\n    if session:\n        if session.team_name:\n            keepalive_manager.stop()\n        if session.backend_session_id:\n            await provider_router.cleanup_session(session_id)\n    deleted = ChatSessionService.delete(project_id, session_id)\n    if not deleted:\n        raise HTTPException(status_code=404, detail=\"Session not found\")\n    return {\"deleted\": True}\n\n\n@router.patch(\"/api/projects/{project_id}/chat/sessions/{session_id}\")\nasync def rename_session(project_id: str, session_id: str, body: RenameSessionRequest):\n    session = ChatSessionService.update_name(project_id, session_id, body.name)\n    if not session:\n        raise HTTPException(status_code=404, detail=\"Session not found\")\n    return session.to_summary_dict()\n\n\n# ---------------------------------------------------------------------------\n# Send message (triggers streaming via SSE)\n# ---------------------------------------------------------------------------\n\ndef _provider_has_backend(provider_name: str) -> bool:\n    \"\"\"Check if a provider has a running backend service for protocol-native chat.\"\"\"\n    if provider_name == \"claude\":\n        return service_lifecycle.is_available(\"companion\")\n    elif provider_name == \"opencode\":\n        return service_lifecycle.is_available(\"opencode\")\n    return False\n\n\n@router.post(\"/api/projects/{project_id}/chat/sessions/{session_id}/messages\")\nasync def send_message(project_id: str, session_id: str, body: SendMessageRequest):\n    \"\"\"Send a user message. Streams the response via the session's SSE endpoint.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    session = ChatSessionService.get(project_id, session_id)\n    if not session:\n        raise HTTPException(status_code=404, detail=\"Session not found\")\n\n    if not body.message.strip():\n        raise HTTPException(status_code=400, detail=\"Message is required\")\n\n    # Use provider/model from request, fall back to session defaults\n    provider_name = body.provider or session.provider\n    model_name = body.model or session.model\n\n    # Update session defaults if the user changed provider/model\n    if provider_name != session.provider or model_name != session.model:\n        session.provider = provider_name\n        session.model = model_name\n        ChatSessionService.save(session)\n\n    # Save user message\n    session = ChatSessionService.add_message(project_id, session_id, \"user\", body.message)\n\n    arch_dir = str(\n        Path(project.path) / \".vista\" / \"features\" / session.feature_name / \"arch\"\n    )\n    specs_dir = str(\n        Path(project.path) / \".vista\" / \"features\" / session.feature_name / \"specs\"\n    )\n\n    # Build prompt using ContextAssembler\n    system_prompt = ContextAssembler.build_system_prompt(arch_dir, specs_dir, project.path)\n    all_msgs = [{\"role\": m.role, \"content\": m.content} for m in session.messages]\n    history = all_msgs[:-1] if len(all_msgs) > 1 else None\n    prompt = ContextAssembler.build_full_prompt(\n        message=body.message,\n        context=body.context,\n        history=history,\n        system_prompt=system_prompt,\n    )\n\n    use_persistent = body.mode == \"persistent\"\n\n    # Decide routing: protocol-native (ProviderRouter) vs CLI fallback\n    if _provider_has_backend(provider_name) and not use_persistent:\n        # Protocol-native path via ProviderRouter\n        # Ensure backend session exists\n        if not session.backend_session_id:\n            try:\n                backend_id = await provider_router.create_backend_session(\n                    provider=provider_name,\n                    model=model_name,\n                    session_id=session_id,\n                    cwd=project.path,\n                )\n                session.backend_session_id = backend_id\n                ChatSessionService.save(session)\n            except Exception as e:\n                log.error(\"Failed to create backend session: %s\", e)\n                # Fall through to CLI fallback below\n\n        if session.backend_session_id:\n            asyncio.create_task(\n                _stream_response_router(\n                    project_id, session_id, provider_name,\n                    model_name, prompt, project.path,\n                )\n            )\n            return {\"status\": \"streaming\", \"session_id\": session_id, \"mode\": \"router\"}\n\n    if use_persistent:\n        # Persistent mode via keepalive_manager (legacy tmux + inbox messaging)\n        agent_alive = keepalive_manager.is_alive(session_id)\n\n        if not agent_alive and session.team_name:\n            agent_alive = keepalive_manager.resume(session_id, session.team_name)\n\n        if not agent_alive:\n            # Cold start with full history\n            try:\n                team_name = keepalive_manager.start(\n                    session_id=session_id,\n                    provider=provider_name,\n                    model=model_name,\n                    system_prompt=prompt,\n                    cwd=project.path,\n                )\n                session.team_name = team_name\n                ChatSessionService.save(session)\n            except Exception as e:\n                await _broadcast(session_id, {\n                    \"event\": \"chat_error\",\n                    \"data\": {\"detail\": f\"Failed to start agent: {e}\"},\n                })\n                return {\"status\": \"error\", \"session_id\": session_id, \"mode\": body.mode}\n        else:\n            keepalive_manager.send_message(session_id, body.message, context=body.context)\n\n        asyncio.create_task(\n            _stream_response_keepalive(project_id, session_id)\n        )\n    else:\n        # CLI one-shot fallback (no backend service available)\n        asyncio.create_task(\n            _stream_response(project_id, session_id, provider_name, model_name, prompt, project.path)\n        )\n\n    return {\"status\": \"streaming\", \"session_id\": session_id, \"mode\": body.mode}\n\n\n# ---------------------------------------------------------------------------\n# Streaming response handlers\n# ---------------------------------------------------------------------------\n\nasync def _stream_response_router(\n    project_id: str,\n    session_id: str,\n    provider_name: str,\n    model: str,\n    prompt: str,\n    project_path: str,\n) -> None:\n    \"\"\"Background task: stream via ProviderRouter (protocol-native).\"\"\"\n    full_text: list[str] = []\n\n    try:\n        async for event in provider_router.send_message(\n            provider=provider_name,\n            model=model,\n            prompt=prompt,\n            session_id=session_id,\n            cwd=project_path,\n        ):\n            if event[\"type\"] == \"token\":\n                full_text.append(event[\"text\"])\n                await _broadcast(session_id, {\n                    \"event\": \"token\",\n                    \"data\": {\"text\": event[\"text\"]},\n                })\n            elif event[\"type\"] == \"done\":\n                content = event.get(\"content\", \"\".join(full_text))\n                ChatSessionService.add_message(project_id, session_id, \"assistant\", content)\n                await _broadcast(session_id, {\n                    \"event\": \"message_done\",\n                    \"data\": {\"role\": \"assistant\", \"content\": content},\n                })\n            elif event[\"type\"] == \"result\":\n                await _broadcast(session_id, {\n                    \"event\": \"result\",\n                    \"data\": event,\n                })\n            elif event[\"type\"] == \"error\":\n                await _broadcast(session_id, {\n                    \"event\": \"chat_error\",\n                    \"data\": {\"detail\": event[\"detail\"]},\n                })\n    except Exception as e:\n        await _broadcast(session_id, {\n            \"event\": \"chat_error\",\n            \"data\": {\"detail\": str(e)},\n        })\n\n\nasync def _stream_response(\n    project_id: str,\n    session_id: str,\n    provider_name: str,\n    model: str,\n    prompt: str,\n    project_path: str,\n) -> None:\n    \"\"\"Background task: stream CLI response (fallback path).\"\"\"\n    full_text: list[str] = []\n\n    try:\n        async for event in chat_service.invoke_provider_streaming(\n            provider_name=provider_name,\n            model=model,\n            prompt=prompt,\n            cwd=project_path,\n        ):\n            if event[\"type\"] == \"token\":\n                full_text.append(event[\"text\"])\n                await _broadcast(session_id, {\n                    \"event\": \"token\",\n                    \"data\": {\"text\": event[\"text\"]},\n                })\n            elif event[\"type\"] == \"done\":\n                content = event.get(\"content\", \"\".join(full_text))\n                ChatSessionService.add_message(project_id, session_id, \"assistant\", content)\n                await _broadcast(session_id, {\n                    \"event\": \"message_done\",\n                    \"data\": {\"role\": \"assistant\", \"content\": content},\n                })\n            elif event[\"type\"] == \"result\":\n                await _broadcast(session_id, {\n                    \"event\": \"result\",\n                    \"data\": event,\n                })\n            elif event[\"type\"] == \"error\":\n                await _broadcast(session_id, {\n                    \"event\": \"chat_error\",\n                    \"data\": {\"detail\": event[\"detail\"]},\n                })\n    except Exception as e:\n        await _broadcast(session_id, {\n            \"event\": \"chat_error\",\n            \"data\": {\"detail\": str(e)},\n        })\n\n\nasync def _stream_response_keepalive(\n    project_id: str,\n    session_id: str,\n) -> None:\n    \"\"\"Background task: poll keepalive agent inbox and push events to SSE.\"\"\"\n    try:\n        async for event in keepalive_manager.poll_response(session_id):\n            if event[\"type\"] == \"token\":\n                await _broadcast(session_id, {\n                    \"event\": \"token\",\n                    \"data\": {\"text\": event[\"text\"]},\n                })\n            elif event[\"type\"] == \"done\":\n                content = event.get(\"content\", \"\")\n                ChatSessionService.add_message(project_id, session_id, \"assistant\", content)\n                await _broadcast(session_id, {\n                    \"event\": \"message_done\",\n                    \"data\": {\"role\": \"assistant\", \"content\": content},\n                })\n            elif event[\"type\"] == \"error\":\n                await _broadcast(session_id, {\n                    \"event\": \"chat_error\",\n                    \"data\": {\"detail\": event[\"detail\"]},\n                })\n    except Exception as e:\n        await _broadcast(session_id, {\n            \"event\": \"chat_error\",\n            \"data\": {\"detail\": str(e)},\n        })\n\n\n# ---------------------------------------------------------------------------\n# Cancel\n# ---------------------------------------------------------------------------\n\n@router.post(\"/api/projects/{project_id}/chat/sessions/{session_id}/cancel\")\nasync def cancel_session_chat(project_id: str, session_id: str):\n    # Try one-shot cancel first\n    cancelled = chat_service.cancel()\n    if not cancelled:\n        # For persistent sessions, kill the agent\n        if keepalive_manager.is_alive(session_id):\n            keepalive_manager.stop()\n            cancelled = True\n    return {\"cancelled\": cancelled}\n\n\n# ---------------------------------------------------------------------------\n# SSE streaming endpoint\n# ---------------------------------------------------------------------------\n\nasync def _forward_queue(source: asyncio.Queue, dest: asyncio.Queue) -> None:\n    \"\"\"Forward items from source queue to dest queue until cancelled.\"\"\"\n    try:\n        while True:\n            item = await source.get()\n            await dest.put(item)\n    except asyncio.CancelledError:\n        pass\n\n\n@router.get(\"/api/projects/{project_id}/chat/sessions/{session_id}/stream\")\nasync def stream_session(project_id: str, session_id: str, request: Request):\n    \"\"\"SSE endpoint delivering chat tokens and diagram change events.\"\"\"\n    project = ProjectService.get_by_id(project_id)\n    if not project:\n        raise HTTPException(status_code=404, detail=\"Project not found\")\n\n    session = ChatSessionService.get(project_id, session_id)\n    if not session:\n        raise HTTPException(status_code=404, detail=\"Session not found\")\n\n    # Cancel any pending disconnect cleanup (SSE reconnected)\n    keepalive_manager.cancel_disconnect_cleanup(session_id)\n\n    # Subscribe to chat events\n    chat_queue = _subscribe(session_id)\n\n    # Subscribe to diagram watcher\n    arch_dir = Path(project.path) / \".vista\" / \"features\" / session.feature_name / \"arch\"\n    diagram_queue = diagram_watcher.subscribe(project_id, session.feature_name, arch_dir)\n\n    # Merge both queues into one so the generator reads from a single source\n    merged: asyncio.Queue = asyncio.Queue(maxsize=500)\n\n    async def event_generator():\n        fwd_chat = asyncio.create_task(_forward_queue(chat_queue, merged))\n        fwd_diagram = asyncio.create_task(_forward_queue(diagram_queue, merged))\n        try:\n            while True:\n                if await request.is_disconnected():\n                    break\n                try:\n                    event = await asyncio.wait_for(merged.get(), timeout=30.0)\n                    yield {\n                        \"event\": event.get(\"event\", \"message\"),\n                        \"data\": json.dumps(event.get(\"data\", {})),\n                    }\n                except asyncio.TimeoutError:\n                    yield {\"event\": \"ping\", \"data\": \"\"}\n        except asyncio.CancelledError:\n            pass\n        finally:\n            fwd_chat.cancel()\n            fwd_diagram.cancel()\n            _unsubscribe(session_id, chat_queue)\n            diagram_watcher.unsubscribe(project_id, session.feature_name, diagram_queue)\n            # Start disconnect grace period for persistent sessions\n            if session.team_name:\n                keepalive_manager.schedule_disconnect_cleanup(session_id, grace_seconds=10)\n\n    return EventSourceResponse(event_generator())\n","numLines":513,"startLine":1,"totalLines":513}}}
