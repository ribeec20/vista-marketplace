{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N2LsArHQjvN7u3awBaTeNd","type":"tool_result","content":"     1→\"\"\"Data models for persistent chat sessions.\"\"\"\n     2→\n     3→from dataclasses import dataclass, field\n     4→from datetime import datetime, timezone\n     5→from typing import Optional\n     6→import uuid\n     7→\n     8→\n     9→@dataclass\n    10→class ChatMessage:\n    11→    \"\"\"A single message in a chat session.\"\"\"\n    12→\n    13→    role: str  # \"user\" | \"assistant\"\n    14→    content: str\n    15→    timestamp: str = \"\"\n    16→\n    17→    def __post_init__(self):\n    18→        if not self.timestamp:\n    19→            self.timestamp = datetime.now(timezone.utc).isoformat()\n    20→\n    21→    def to_dict(self) -> dict:\n    22→        return {\"role\": self.role, \"content\": self.content, \"timestamp\": self.timestamp}\n    23→\n    24→    @classmethod\n    25→    def from_dict(cls, d: dict) -> \"ChatMessage\":\n    26→        return cls(role=d[\"role\"], content=d[\"content\"], timestamp=d.get(\"timestamp\", \"\"))\n    27→\n    28→\n    29→@dataclass\n    30→class ChatSession:\n    31→    \"\"\"A persistent chat session tied to a project feature.\"\"\"\n    32→\n    33→    id: str\n    34→    project_id: str\n    35→    feature_name: str\n    36→    name: str\n    37→    provider: str\n    38→    model: str\n    39→    messages: list[ChatMessage] = field(default_factory=list)\n    40→    created_at: str = \"\"\n    41→    updated_at: str = \"\"\n    42→    team_name: Optional[str] = None\n    43→\n    44→    def __post_init__(self):\n    45→        now = datetime.now(timezone.utc).isoformat()\n    46→        if not self.created_at:\n    47→            self.created_at = now\n    48→        if not self.updated_at:\n    49→            self.updated_at = now\n    50→\n    51→    def to_dict(self) -> dict:\n    52→        return {\n    53→            \"id\": self.id,\n    54→            \"project_id\": self.project_id,\n    55→            \"feature_name\": self.feature_name,\n    56→            \"name\": self.name,\n    57→            \"provider\": self.provider,\n    58→            \"model\": self.model,\n    59→            \"messages\": [m.to_dict() for m in self.messages],\n    60→            \"created_at\": self.created_at,\n    61→            \"updated_at\": self.updated_at,\n    62→            \"team_name\": self.team_name,\n    63→        }\n    64→\n    65→    def to_summary_dict(self) -> dict:\n    66→        \"\"\"Lightweight dict without message bodies for session listing.\"\"\"\n    67→        return {\n    68→            \"id\": self.id,\n    69→            \"project_id\": self.project_id,\n    70→            \"feature_name\": self.feature_name,\n    71→            \"name\": self.name,\n    72→            \"provider\": self.provider,\n    73→            \"model\": self.model,\n    74→            \"message_count\": len(self.messages),\n    75→            \"created_at\": self.created_at,\n    76→            \"updated_at\": self.updated_at,\n    77→            \"team_name\": self.team_name,\n    78→        }\n    79→\n    80→    @classmethod\n    81→    def from_dict(cls, d: dict) -> \"ChatSession\":\n    82→        messages = [ChatMessage.from_dict(m) for m in d.get(\"messages\", [])]\n    83→        return cls(\n    84→            id=d[\"id\"],\n    85→            project_id=d[\"project_id\"],\n    86→            feature_name=d[\"feature_name\"],\n    87→            name=d[\"name\"],\n    88→            provider=d[\"provider\"],\n    89→            model=d[\"model\"],\n    90→            messages=messages,\n    91→            created_at=d.get(\"created_at\", \"\"),\n    92→            updated_at=d.get(\"updated_at\", \"\"),\n    93→            team_name=d.get(\"team_name\"),\n    94→        )\n    95→\n    96→    @staticmethod\n    97→    def generate_id() -> str:\n    98→        return uuid.uuid4().hex[:8]\n    99→\n   100→    @staticmethod\n   101→    def auto_name(first_message: str) -> str:\n   102→        \"\"\"Generate a session name from the first user message.\"\"\"\n   103→        name = first_message.strip().replace(\"\\n\", \" \")\n   104→        if len(name) > 50:\n   105→            name = name[:47] + \"...\"\n   106→        return name or \"New Chat\"\n   107→"}]},"parent_tool_use_id":null,"session_id":"fe920b97-a686-4daa-9f39-67e009025eb9","uuid":"8d56d483-aa84-4b28-82d8-9bb3c517a7a7","tool_use_result":{"type":"text","file":{"filePath":"C:/Users/Grove/OneDrive/Documents/PYTHON/claude_plugins/vista/vista/server/models/chat_session.py","content":"\"\"\"Data models for persistent chat sessions.\"\"\"\n\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timezone\nfrom typing import Optional\nimport uuid\n\n\n@dataclass\nclass ChatMessage:\n    \"\"\"A single message in a chat session.\"\"\"\n\n    role: str  # \"user\" | \"assistant\"\n    content: str\n    timestamp: str = \"\"\n\n    def __post_init__(self):\n        if not self.timestamp:\n            self.timestamp = datetime.now(timezone.utc).isoformat()\n\n    def to_dict(self) -> dict:\n        return {\"role\": self.role, \"content\": self.content, \"timestamp\": self.timestamp}\n\n    @classmethod\n    def from_dict(cls, d: dict) -> \"ChatMessage\":\n        return cls(role=d[\"role\"], content=d[\"content\"], timestamp=d.get(\"timestamp\", \"\"))\n\n\n@dataclass\nclass ChatSession:\n    \"\"\"A persistent chat session tied to a project feature.\"\"\"\n\n    id: str\n    project_id: str\n    feature_name: str\n    name: str\n    provider: str\n    model: str\n    messages: list[ChatMessage] = field(default_factory=list)\n    created_at: str = \"\"\n    updated_at: str = \"\"\n    team_name: Optional[str] = None\n\n    def __post_init__(self):\n        now = datetime.now(timezone.utc).isoformat()\n        if not self.created_at:\n            self.created_at = now\n        if not self.updated_at:\n            self.updated_at = now\n\n    def to_dict(self) -> dict:\n        return {\n            \"id\": self.id,\n            \"project_id\": self.project_id,\n            \"feature_name\": self.feature_name,\n            \"name\": self.name,\n            \"provider\": self.provider,\n            \"model\": self.model,\n            \"messages\": [m.to_dict() for m in self.messages],\n            \"created_at\": self.created_at,\n            \"updated_at\": self.updated_at,\n            \"team_name\": self.team_name,\n        }\n\n    def to_summary_dict(self) -> dict:\n        \"\"\"Lightweight dict without message bodies for session listing.\"\"\"\n        return {\n            \"id\": self.id,\n            \"project_id\": self.project_id,\n            \"feature_name\": self.feature_name,\n            \"name\": self.name,\n            \"provider\": self.provider,\n            \"model\": self.model,\n            \"message_count\": len(self.messages),\n            \"created_at\": self.created_at,\n            \"updated_at\": self.updated_at,\n            \"team_name\": self.team_name,\n        }\n\n    @classmethod\n    def from_dict(cls, d: dict) -> \"ChatSession\":\n        messages = [ChatMessage.from_dict(m) for m in d.get(\"messages\", [])]\n        return cls(\n            id=d[\"id\"],\n            project_id=d[\"project_id\"],\n            feature_name=d[\"feature_name\"],\n            name=d[\"name\"],\n            provider=d[\"provider\"],\n            model=d[\"model\"],\n            messages=messages,\n            created_at=d.get(\"created_at\", \"\"),\n            updated_at=d.get(\"updated_at\", \"\"),\n            team_name=d.get(\"team_name\"),\n        )\n\n    @staticmethod\n    def generate_id() -> str:\n        return uuid.uuid4().hex[:8]\n\n    @staticmethod\n    def auto_name(first_message: str) -> str:\n        \"\"\"Generate a session name from the first user message.\"\"\"\n        name = first_message.strip().replace(\"\\n\", \" \")\n        if len(name) > 50:\n            name = name[:47] + \"...\"\n        return name or \"New Chat\"\n","numLines":107,"startLine":1,"totalLines":107}}}
